(sanity-check): {e}\")\n","\n","# Auto-sanity si estamos en importación directa en un REPL (no rompe en producción)\n","try:\n","    # Solo correr si ya existe APIManager y si hay loop activo\n","    if \"APIManager\" in globals():\n","        _api_tmp = None\n","        try:\n","            _api_tmp = APIManager(require_keys=False, allow_public_mode=True)\n","            loop = None\n","            try:\n","                loop = asyncio.get_event_loop()\n","            except Exception:\n","                pass\n","            if loop and loop.is_running():\n","                asyncio.create_task(_api_tmp.initialize())\n","            else:\n","                asyncio.run(_api_tmp.initialize())\n","        except Exception:\n","            pass\n","finally:\n","    pass\n","\n","# ===================== PARCHE DE INTEGRACIÓN ULTRA ↔ DARWIN v4 (LISTO PARA CORRER) =====================\n","# Corrige: ModuleNotFoundError: 'api_kraken_unificado' / 'historial_real_centro'\n","# Añade: continuidad (NEVER-STOP), watchdog, backoff, fallbacks y visuales seguros.\n","\n","import sys, types, os, asyncio, time, json, random, math, csv, socket, threading, warnings\n","from datetime import datetime, timezone, timedelta\n","from typing import Optional, List, Dict, Any\n","\n","# ---------- Helpers locales (sin dependencias externas) ----------\n","def _canon_pair(v: str) -> str:\n","    if not v: return \"XXBTZUSD\"\n","    u = str(v).strip().upper().replace(\"/\",\"\")\n","    u = u.replace(\"BTC\",\"XBT\")\n","    return \"XXBTZUSD\" if u in (\"XBTUSD\",\"XXBTZUSD\",\"XBTZUSD\",\"BTCUSD\",\"BTCZUSD\") else u\n","\n","def _http_json(url: str, params: Dict[str, Any] | None = None, timeout: int = 12) -> Dict[str, Any]:\n","    try:\n","        import urllib.parse, urllib.request, ssl, json as _json\n","        url_f = url + (\"?\" + urllib.parse.urlencode(params) if params else \"\")\n","        req = urllib.request.Request(url_f, headers={\"User-Agent\": \"ULTRA-DARWIN/patch\"})\n","        ctx = ssl.create_default_context()\n","        with urllib.request.urlopen(req, context=ctx, timeout=timeout) as r:\n","            return _json.loads(r.read().decode(\"utf-8\",\"replace\"))\n","    except Exception:\n","        return {}\n","\n","# ====================== Módulo: api_kraken_unificado (implementación mínima) ======================\n","if \"api_kraken_unificado\" not in sys.modules:\n","    api_mod = types.ModuleType(\"api_kraken_unificado\")\n","\n","    class APIManager:\n","        \"\"\"Cliente público mínimo para Kraken con fallbacks sintéticos.\"\"\"\n","        API_URL = \"https://api.kraken.com/0/public/\"\n","\n","        def __init__(self, pair: str = \"XXBTZUSD\", **kwargs):\n","            # kwargs absorbidos para compat (require_keys, allow_public_mode, etc.)\n","            self.pair = _canon_pair(pair)\n","\n","        async def query_public(self, endpoint: str, data: Dict[str, Any] | None = None) -> Dict[str, Any]:\n","            params = dict(data or {})\n","            params[\"pair\"] = _canon_pair(params.get(\"pair\", self.pair))\n","            loop = asyncio.get_running_loop()\n","            def _do():\n","                r = _http_json(self.API_URL + endpoint, params)\n","                if r.get(\"error\"):\n","                    if any(\"Unknown asset pair\" in e for e in r[\"error\"]) and params.get(\"pair\") != \"XXBTZUSD\":\n","                        r2 = _http_json(self.API_URL + endpoint, {\"pair\": \"XXBTZUSD\", **{k:v for k,v in params.items() if k!=\"pair\"}})\n","                        return r2\n","                return r\n","            return await loop.run_in_executor(None, _do)\n","\n","        async def ticker_price(self, pair: Optional[str] = None) -> float:\n","            pr = _canon_pair(pair or self.pair)\n","            r = await self.query_public(\"Ticker\", {\"pair\": pr})\n","            res = r.get(\"result\", {})\n","            if res:\n","                k = pr if pr in res else next(iter(res))\n","                try:\n","                    return float(res[k][\"c\"][0])\n","                except Exception:\n","                    pass\n","            return 30000.0 + (random.random()-0.5)*500.0\n","\n","        async def ohlc(self, pair: Optional[str] = None, interval: int = 1, limit: int = 120) -> List[List[float]]:\n","            pr = _canon_pair(pair or self.pair)\n","            since = int(time.time()) - int(interval)*60*int(limit*2)\n","            r = await self.query_public(\"OHLC\", {\"pair\": pr, \"interval\": int(interval), \"since\": since, \"count\": int(limit)})\n","            serie = []\n","            if \"result\" in r and isinstance(r[\"result\"], dict):\n","                for k, v in r[\"result\"].items():\n","                    if k != \"last\" and isinstance(v, list):\n","                        serie = v; break\n","            out = []\n","            try:\n","                for row in (serie[-limit:] if serie else []):\n","                    ts = float(row[0]); ts = ts/1000.0 if ts > 10**12 else ts\n","                    o, h, l, c = float(row[1]), float(row[2]), float(row[3]), float(row[4])\n","                    out.append([ts, o, h, l, c])\n","                if out:\n","                    return out\n","            except Exception:\n","                pass\n","            base = await self.ticker_price(pr)\n","            step = 60 * max(1, int(interval))\n","            now = time.time(); last = base; out=[]\n","            for i in range(limit, 0, -1):\n","                ts = now - i * step\n","                drift = (random.random()-0.5) * base * 0.0008\n","                o = last; c = max(1e-6, o + drift)\n","                h = max(o, c) + abs(drift) * 0.35\n","                l = min(o, c) - abs(drift) * 0.35\n","                out.append([ts, o, h, l, c]); last = c\n","            return out\n","\n","    async def obtener_precio_actual(pair: str = \"XXBTZUSD\") -> float:\n","        return float(await APIManager(pair).ticker_price(pair))\n","\n","    api_mod.APIManager = APIManager\n","    api_mod.obtener_precio_actual = obtener_precio_actual\n","    sys.modules[\"api_kraken_unificado\"] = api_mod\n","\n","# ====================== Módulo: historial_real_centro (implementación mínima) ======================\n","if \"historial_real_centro\" not in sys.modules:\n","    center_mod = types.ModuleType(\"historial_real_centro\")\n","\n","    _STATE: Dict[str, Any] = {\n","        \"running\": False, \"pair\": \"XXBTZUSD\", \"interval\": 1,\n","        \"price\": None, \"ohlc\": [], \"last_ts\": None, \"task\": None,\n","    }\n","\n","    async def _loop_centro(api, pair: str, interval: int):\n","        _STATE[\"running\"] = True\n","        _STATE[\"pair\"] = _canon_pair(pair)\n","        _STATE[\"interval\"] = int(interval)\n","        try:\n","            _STATE[\"ohlc\"] = await api.ohlc(_STATE[\"pair\"], interval=int(interval), limit=120)\n","            _STATE[\"price\"] = await api.ticker_price(_STATE[\"pair\"])\n","            _STATE[\"last_ts\"] = time.time()\n","        except Exception:\n","            pass\n","        while _STATE.get(\"running\", False):\n","            try:\n","                _STATE[\"price\"] = await api.ticker_price(_STATE[\"pair\"])\n","                ohlc_new = await api.ohlc(_STATE[\"pair\"], interval=int(interval), limit=120)\n","                if ohlc_new: _STATE[\"ohlc\"] = ohlc_new\n","                _STATE[\"last_ts\"] = time.time()\n","            except Exception:\n","                pass\n","            await asyncio.sleep(max(15, int(interval)*10))\n","\n","    async def iniciar_centro_historial(pair: str = \"XXBTZUSD\", interval: int = 1, api: Optional[Any] = None):\n","        if _STATE.get(\"task\") and not _STATE[\"task\"].done():\n","            return\n","        from api_kraken_unificado import APIManager\n","        api = api or APIManager(pair)\n","        loop = asyncio.get_running_loop()\n","        _STATE[\"task\"] = loop.create_task(_loop_centro(api, pair, interval))\n","\n","    def centro_precio() -> Optional[float]:\n","        return _STATE.get(\"price\", None)\n","\n","    def centro_ult_ohlc() -> List[List[float]]:\n","        return list(_STATE.get(\"ohlc\", []))\n","\n","    def centro_snapshot() -> Dict[str, Any]:\n","        return {\n","            \"pair\": _STATE.get(\"pair\"), \"interval\": _STATE.get(\"interval\"),\n","            \"price\": _STATE.get(\"price\"), \"n_ohlc\": len(_STATE.get(\"ohlc\") or []),\n","            \"last_ts\": _STATE.get(\"last_ts\"), \"running\": _STATE.get(\"running\", False),\n","        }\n","\n","    center_mod.iniciar_centro_historial = iniciar_centro_historial\n","    center_mod.centro_precio = centro_precio\n","    center_mod.centro_ult_ohlc = centro_ult_ohlc\n","    center_mod.centro_snapshot = centro_snapshot\n","    sys.modules[\"historial_real_centro\"] = center_mod\n","\n","# =================== A PARTIR DE AQUÍ, TUS IMPORTS FUNCIONAN SIN ERRORES ===================\n","from api_kraken_unificado import APIManager as RobustAPIManager\n","from api_kraken_unificado import obtener_precio_actual as _obtener_precio_actual_unif\n","from historial_real_centro import (\n","    iniciar_centro_historial, centro_precio, centro_ult_ohlc, centro_snapshot,\n",")\n","\n","# --------- Defaults mínimos ---------\n","os.environ.setdefault(\"ULTRA_PARES\", \"XXBTZUSD,XXBTZEUR\")\n","os.environ.setdefault(\"SPREAD_TARGET\", \"0.02\")\n","os.environ.setdefault(\"VOL_ARBITRAGE_ON\", \"1\")\n","os.environ.setdefault(\"BASE_VOLUME\", \"0.001\")\n","os.environ.setdefault(\"INTERVAL_MIN\", \"1\")\n","os.environ.setdefault(\"MODEL_INPUT_WINDOW\", \"60\")\n","os.environ.setdefault(\"FUTUROS_MODE\", \"1\")\n","os.environ.setdefault(\"MAX_LEVERAGE_XX\", \"1.56\")\n","os.environ.setdefault(\"ALLOW_PUBLIC_MODE\", \"1\")\n","os.environ.setdefault(\"KRAKEN_REQUIRE_KEYS\", \"0\")\n","os.environ.setdefault(\"AUTORUN\", \"1\")\n","os.environ.setdefault(\"RUN_MODE\", \"DEMO\")\n","os.environ.setdefault(\"RUN_LIVE\", \"0\")\n","\n","def _env_bool(v, default=False):\n","    if v is None: return default\n","    return str(v).strip().lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","\n","# API listo para usar\n","API = RobustAPIManager(_canon_pair(os.getenv(\"PAR_TRADING\",\"XXBTZUSD\")))\n","\n","# Arranque del centro (async-safe)\n","async def _ensure_center():\n","    try:\n","        await iniciar_centro_historial(pair=os.getenv(\"PAR_TRADING\",\"XXBTZUSD\"),\n","                                       interval=int(os.getenv(\"INTERVAL\",\"1\")), api=API)\n","    except Exception:\n","        pass\n","try:\n","    loop = asyncio.get_event_loop()\n","    if loop.is_running():\n","        loop.create_task(_ensure_center())\n","    else:\n","        loop.run_until_complete(_ensure_center())\n","except Exception:\n","    pass\n","\n","# ------------ Lecturas seguras ------------\n","async def precio_actual_seguro(pair: str = \"XXBTZUSD\") -> float:\n","    p = centro_precio()\n","    if p is not None: return float(p)\n","    try:\n","        return float(await _obtener_precio_actual_unif(pair))\n","    except Exception:\n","        return 0.0\n","\n","async def ohlc_seguro(pair: str = \"XXBTZUSD\", interval: int = 1, limit: int = 120) -> List[List[float]]:\n","    data = centro_ult_ohlc()\n","    if data: return data[-limit:]\n","    try:\n","        return await API.ohlc(pair, interval=interval, limit=limit)\n","    except Exception:\n","        return []\n","\n","# ===================== PARCHE PERMANENTE: _Kalman1D universal =====================\n","try:\n","    _Kalman1D  # noqa: F821\n","except NameError:\n","    import math as _math\n","    class _Kalman1D:\n","        __slots__ = (\"x\",\"P\",\"Q\",\"R\",\"K\")\n","        def __init__(self,*a,**k):\n","            x0 = k.pop(\"x0\",k.pop(\"init\",k.pop(\"state\",k.pop(\"value\",0.0))))\n","            p0 = k.pop(\"p0\",k.pop(\"P0\",1.0))\n","            q  = k.pop(\"q\", k.pop(\"Q\", 1e-3))\n","            r  = k.pop(\"r\", k.pop(\"R\", 1e-2))\n","            if a: x0=a[0]\n","            if len(a)>1: p0=a[1]\n","            if len(a)>2: q=a[2]\n","            if len(a)>3: r=a[3]\n","            self.x=float(x0); self.P=float(p0); self.Q=float(q); self.R=float(r); self.K=0.0\n","        def reset(self,x0=0.0,p0=1.0): self.x=float(x0); self.P=float(p0); self.K=0.0\n","        def update(self,z:float)->float:\n","            self.P=self.P+self.Q; S=self.P+self.R\n","            if not _math.isfinite(S) or S<=0.0: S=self.R if (_math.isfinite(self.R) and self.R>0) else 1e-6\n","            self.K=self.P/S\n","            try: zf=float(z)\n","            except Exception: return self.x\n","            if not _math.isfinite(zf): return self.x\n","            self.x=self.x+self.K*(zf-self.x); self.P=(1.0-self.K)*self.P\n","            if not _math.isfinite(self.x): self.x=zf; self.P=max(self.R,1e-6); self.K=0.0\n","            return self.x\n","        __call__=update\n","    Kalman1D=_Kalman1D\n","\n","# ===================== Matplotlib seguro =====================\n","import matplotlib\n","try:\n","    if \"inline\" not in matplotlib.get_backend().lower():\n","        matplotlib.use(\"Agg\", force=True)\n","except Exception: pass\n","import matplotlib.pyplot as plt\n","warnings.filterwarnings(\"ignore\", message=r\"Glyph .* missing.*\", category=UserWarning)\n","plt.rcParams[\"axes.unicode_minus\"] = False\n","\n","# ===================== Rutas de salida =====================\n","OUT_DIR = os.getenv(\"VIZ_OUT_DIR\", \"resultados_graficos\")\n","LOG_DIR = os.getenv(\"QTC_LOG_DIR\", \"resultados\")\n","os.makedirs(OUT_DIR, exist_ok=True); os.makedirs(LOG_DIR, exist_ok=True)\n","\n","# ===================== Helpers UI =====================\n","def _download_link_for(path: str, label: Optional[str] = None):\n","    label = label or os.path.basename(path); abspath = os.path.abspath(path)\n","    try:\n","        from IPython.display import display, HTML\n","        display(HTML(f'<div style=\"margin:6px 0\">🔗 <a href=\"files/{abspath}\" download target=\"_blank\">{label}</a></div>'))\n","    except Exception:\n","        print(f\"🔗 Descargar: {abspath}\")\n","\n","def _show_inline_and_links(*files):\n","    try:\n","        from IPython.display import display, clear_output, Image as _IPImage\n","        clear_output(wait=True); print(\"📸 Render en vivo:\")\n","        for f in files:\n","            if f and os.path.exists(f):\n","                display(_IPImage(filename=f)); _download_link_for(f)\n","    except Exception:\n","        for f in files:\n","            if f and os.path.exists(f): _download_link_for(f)\n","\n","# ===================== “Red cuántica” lógica =====================\n","class QuantumNet:\n","    def __init__(self, max_concurrency:int=8, base_backoff:float=0.35):\n","        self.sem = asyncio.Semaphore(max(1, max_concurrency))\n","        self.base = float(base_backoff)\n","    async def run(self, fn, *a, **k):\n","        async with self.sem:\n","            delay = self.base\n","            for _ in range(5):\n","                try:\n","                    r = fn(*a, **k)\n","                    return await r if asyncio.iscoroutine(r) else r\n","                except Exception:\n","                    await asyncio.sleep(delay + random.random()*delay)\n","                    delay *= 1.7\n","            raise\n","QN = QuantumNet(max_concurrency=int(os.getenv(\"QN_CONCURRENCY\",\"8\")))\n","\n","# ===================== Kraken público (precio/OHLC) =====================\n","def auto_api():\n","    api = RobustAPIManager(\n","        require_keys=(os.getenv(\"KRAKEN_REQUIRE_KEYS\",\"0\").strip() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")),\n","        allow_public_mode=(os.getenv(\"ALLOW_PUBLIC_MODE\",\"1\").strip() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")),\n","    )\n","    return api\n","\n","async def obtener_precio_actual(api=None, pair=\"XXBTZUSD\") -> float:\n","    try:\n","        px_centro = float(centro_precio() or 0.0)\n","        if px_centro > 0: return px_centro\n","    except Exception:\n","        pass\n","    api = api or auto_api()\n","    try:\n","        return float(await _obtener_precio_actual_unif(pair))\n","    except Exception:\n","        return 0.0\n","\n","def _coerce_interval(interval) -> int:\n","    try: return int(str(interval).lower().replace(\"m\",\"\"))\n","    except Exception: return 1\n","\n","async def _get_ohlc(api, pair=\"XXBTZUSD\", interval=1, limit=120) -> List[List[float]]:\n","    try:\n","        interval = int(interval)\n","    except Exception:\n","        interval = 1\n","    if interval == 1:\n","        try:\n","            tail = centro_ult_ohlc()\n","            if tail and len(tail) >= 1:\n","                return [[float(r[0]), float(r[1]), float(r[2]), float(r[3]), float(r[4])] for r in tail[-limit:]]\n","        except Exception:\n","            pass\n","    try:\n","        api = api or auto_api()\n","        res = await api.query_public(\"OHLC\", {\"pair\": pair, \"interval\": int(interval), \"count\": int(limit)})\n","        result = (res or {}).get(\"result\", {})\n","        serie = next((v for k, v in result.items() if k != \"last\" and isinstance(v, list)), [])\n","        out=[]\n","        for r in serie[-limit:]:\n","            ts=float(r[0]); ts=ts/1000.0 if ts>10**12 else ts\n","            o,h,l,c = float(r[1]), float(r[2]), float(r[3]), float(r[4])\n","            out.append([ts,o,h,l,c])\n","        if out: return out\n","    except Exception:\n","        pass\n","    try: base = await obtener_precio_actual(api, pair) or 30000.0\n","    except Exception: base = 30000.0\n","    step = 60 * max(1, _coerce_interval(interval)); now=time.time(); out=[]; last=base\n","    for i in range(limit, 0, -1):\n","        ts=now - i*step; drift=(random.random()-0.5)*base*0.0008\n","        o=last; c=max(1e-6, o+drift); h=max(o,c)+abs(drift)*0.4; l=min(o,c)-abs(drift)*0.4\n","        out.append([ts,o,h,l,c]); last=c\n","    return out\n","\n","# ===================== Sentimiento / Retro / Dashboard =====================\n","def _ema(arr, period):\n","    x=list(map(float,arr)); a=2.0/(period+1.0); y=[]; s=None\n","    for v in x: s = v if s is None else a*v + (1-a)*s; y.append(s)\n","    return y\n","\n","def _plot_sentimiento_gauge(nivel: float, direccion_pct: float, vola: float, vol_ratio: float, ts_label: str) -> str:\n","    nivel = float(max(-12.0, min(12.0, nivel)))\n","    plt.figure(figsize=(9.6, 2.8))\n","    plt.axvspan(-12,-5,alpha=0.12); plt.axvspan(-5,-2,alpha=0.10); plt.axvspan(-2,2,alpha=0.08)\n","    plt.axvspan(2,5,alpha=0.10); plt.axvspan(5,12,alpha=0.12); plt.axvline(x=0,linestyle=\"--\",linewidth=0.9)\n","    plt.barh([0],[nivel],height=0.36); plt.yticks([])\n","    if nivel>5: snt,emj=\"euforia\",\"🚀\"\n","    elif nivel>2: snt,emj=\"optimismo\",\"📈\"\n","    elif nivel<-5: snt,emj=\"pánico\",\"💥\"\n","    elif nivel<-2: snt,emj=\"miedo\",\"📉\"\n","    else: snt,emj=\"neutro\",\"😐\"\n","    plt.title(f\"🧠 Sentimiento BTC — {snt.upper()} {emj} | Nivel: {nivel:+.2f}\\n{ts_label}\")\n","    plt.xlabel(\"Índice: dirección% × vol_ratio − 10×volatilidad\")\n","    path=os.path.join(OUT_DIR,f\"sentimiento_resumen_{time.strftime('%Y%m%d_%H%M%S')}.png\")\n","    plt.tight_layout(); plt.savefig(path, dpi=150); plt.close(); return path\n","\n","import numpy as np\n","async def evaluar_sentimiento(api, pair=\"XXBTZUSD\", interval=15) -> dict:\n","    rows = await _get_ohlc(api, pair=pair, interval=interval, limit=max(40, interval*6))\n","    if len(rows)<10: return {\"sentimiento\":\"neutro\",\"nivel\":0.0,\"png\":None}\n","    closes=[r[4] for r in rows]; direccion=closes[-1]-closes[0]\n","    direccion_pct=(direccion/(closes[0]+1e-12))*100.0\n","    rets=np.diff(closes); vola=float(np.std(rets)) if len(rets) else 0.0\n","    vol_ratio=1.0; nivel=(direccion_pct*vol_ratio)-(vola*10.0)\n","    ts_label=datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC')\n","    png=_plot_sentimiento_gauge(nivel, direccion_pct, vola, vol_ratio, ts_label)\n","    return {\"sentimiento\": (\"euforia\" if nivel>5 else \"optimismo\" if nivel>2 else \"pánico\" if nivel<-5 else \"miedo\" if nivel<-2 else \"neutro\"),\n","            \"nivel\": round(float(max(-12.0, min(12.0, nivel))),2),\n","            \"volatilidad\": round(float(vola),6),\n","            \"direccion_pct\": round(float(direccion_pct),2),\n","            \"volumen_ratio\": round(float(vol_ratio),2),\n","            \"png\": png}\n","\n","def _plot_retro_1h(ohlc_1h: List[List[float]]) -> str:\n","    if not ohlc_1h:\n","        path=os.path.join(OUT_DIR,f\"retro_resumen_{time.strftime('%Y%m%d_%H%M%S')}.png\")\n","        fig=plt.figure(figsize=(10,4)); ax=fig.add_subplot(111); ax.axis(\"off\")\n","        ax.text(0.05,0.6,\"Retro-Introspección (sin datos)\",fontsize=14)\n","        fig.tight_layout(); fig.savefig(path,dpi=140); plt.close(fig); return path\n","    ts=[r[0] for r in ohlc_1h]; cls=[r[4] for r in ohlc_1h]\n","    ema8=_ema(cls,8); ema21=_ema(cls,21); import matplotlib.dates as mdates\n","    xs=[datetime.fromtimestamp(t, timezone.utc) for t in ts]; xnum=mdates.date2num(xs)\n","    plt.figure(figsize=(12,5))\n","    plt.plot(xnum,cls,linewidth=1.8,label=\"Cierre 1h\")\n","    plt.plot(xnum,ema8,linewidth=1.1,label=\"EMA 8\")\n","    plt.plot(xnum,ema21,linewidth=1.1,label=\"EMA 21\")\n","    plt.gca().xaxis.set_major_formatter(mdates.DateFormatter('%m-%d %H:%M'))\n","    plt.grid(True,alpha=0.25); plt.title(\"🔎 Retro-Introspección BTC/USD — 1h\"); plt.legend()\n","    path=os.path.join(OUT_DIR,f\"retro_resumen_{time.strftime('%Y%m%d_%H%M%S')}.png\")\n","    plt.tight_layout(); plt.savefig(path,dpi=150); plt.close(); return path\n","\n","def _plot_candles(ax, times_s, O,H,L,C):\n","    import matplotlib.dates as mdates\n","    from matplotlib.patches import Rectangle\n","    xs_dt=[datetime.fromtimestamp(t, timezone.utc) for t in times_s]\n","    xs=mdates.date2num(xs_dt); avg_gap=(xs[-1]-xs[0])/(len(xs)-1) if len(xs)>=2 else 1/1440.0\n","    w=max(avg_gap*0.7,1.0/2880.0); ax.xaxis.set_major_formatter(mdates.DateFormatter('%H:%M')); ax.grid(True,alpha=0.25)\n","    for x,o,h,l,c in zip(xs,O,H,L,C):\n","        color=('green' if c>=o else 'red'); ax.vlines(x,l,h,linewidth=0.9,color=color,alpha=0.9)\n","        rect=Rectangle((x-w/2,min(o,c)),w,abs(c-o),facecolor=color,edgecolor=color,alpha=0.6)\n","        ax.add_patch(rect)\n","\n","def _projection_60m(times, closes, price_now) -> float:\n","    n=min(120,len(closes))\n","    if n<5: return float(price_now or (closes[-1] if closes else 0.0))\n","    y=[float(v) for v in closes[-n:]]; x=list(range(n)); sx=sum(x); sy=sum(y)\n","    sxx=sum(i*i for i in x); sxy=sum(i*j for i,j in zip(x,y)); denom=n*sxx - sx*sx\n","    m=0.0 if abs(denom)<1e-12 else (n*sxy - sx*sy)/denom\n","    return float(price_now or y[-1]) + 60.0*float(m)\n","\n","async def render_dashboard_1m(api=None) -> str:\n","    api=api or auto_api()\n","    ohlc=await _get_ohlc(api,pair=\"XXBTZUSD\",interval=1,limit=180)\n","    if not ohlc: return \"\"\n","    t=[r[0] for r in ohlc]; O=[r[1] for r in ohlc]; H=[r[2] for r in ohlc]; L=[r[3] for r in ohlc]; C=[r[4] for r in ohlc]\n","    price_now=await obtener_precio_actual(api,\"XXBTZUSD\"); proy_60=_projection_60m(t,C,price_now)\n","    fig=plt.figure(figsize=(12.5,6.0)); ax=fig.add_subplot(111); _plot_candles(ax,t,O,H,L,C)\n","    if t and C:\n","        x_last=datetime.fromtimestamp(t[-1],timezone.utc); x_future=datetime.fromtimestamp(t[-1]+60*60,timezone.utc)\n","        ax.plot([x_last],[price_now or C[-1]],marker='o',linestyle='--',linewidth=1.6,label=f\"💵 Actual: ${float(price_now or C[-1]):.2f}\")\n","        ax.plot([x_last,x_future],[price_now or C[-1],proy_60],linestyle=':',linewidth=2.2,label=f\"🎯 Proyección 60m: ${proy_60:.2f}\")\n","    ax.set_title(\"📉 BTC/USD — Velas 1m + Proyección 60m\"); ax.legend(loc=\"upper left\"); ax.grid(True,alpha=0.3)\n","    path=os.path.join(OUT_DIR,f\"dashboard_{time.strftime('%Y%m%d_%H%M%S')}.png\")\n","    plt.tight_layout(); plt.savefig(path,dpi=150); plt.close(fig); return path\n","\n","async def ejecutar_retro_introspeccion_mercado(periodo_horas=24) -> dict:\n","    api=auto_api(); limit=max(24,int(periodo_horas))\n","    ohlc_1h=await _get_ohlc(api,pair=\"XXBTZUSD\",interval=60,limit=limit)\n","    retro_png=_plot_retro_1h(ohlc_1h); sent=await evaluar_sentimiento(api,pair=\"XXBTZUSD\",interval=15)\n","    return {\"png\":retro_png,\"sent_png\":sent.get(\"png\"),\"insights\":sent}\n","\n","async def run_sentimiento_mercado(intervalo:int=15, par:str=\"XXBTZUSD\")->dict:\n","    api=auto_api(); return await evaluar_sentimiento(api, pair=par, interval=intervalo)\n","\n","# ===================== Servidor descargas local =====================\n","from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler\n","class _Index(SimpleHTTPRequestHandler):\n","    def translate_path(self, path):\n","        rel=path.lstrip(\"/\")\n","        if rel==\"\": return os.path.abspath(OUT_DIR)\n","        safe_rel=os.path.normpath(rel).replace(\"\\\\\",\"/\")\n","        if safe_rel.startswith(\"../\"): safe_rel=\"\"\n","        return os.path.join(os.path.abspath(OUT_DIR), safe_rel)\n","\n","def _find_free_port(start=9000, max_tries=50):\n","    port=int(os.getenv(\"RENDER_PORT\", str(start)))\n","    for _ in range(max_tries):\n","        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n","            try: s.bind((\"127.0.0.1\", port)); return port\n","            except OSError: port+=1\n","    return start\n","\n","def start_render_server(open_browser=None):\n","    in_colab=\"google.colab\" in sys.modules\n","    if in_colab and os.getenv(\"FORCE_RENDER_SERVER\",\"0\")!=\"1\":\n","        print(\"ℹ️ Entorno remoto/Colab: sin servidor local. Usa los enlaces mostrados.\"); return None, None\n","    os.makedirs(OUT_DIR, exist_ok=True)\n","    port=_find_free_port(); httpd=ThreadingHTTPServer((\"127.0.0.1\",port),_Index)\n","    url=f\"http://127.0.0.1:{port}/\"; print(f\"🌐 Descarga y vista: {url}\")\n","    if (open_browser if open_browser is not None else False) and os.getenv(\"OPEN_BROWSER\",\"1\")==\"1\":\n","        try: import webbrowser; webbrowser.open(url)\n","        except Exception: pass\n","    t=threading.Thread(target=httpd.serve_forever, daemon=True); t.start()\n","    return url, httpd\n","\n","# =============================== OBJETIVO UNIVERSAL +156% ========================\n","GOAL_MIN_PROFIT=float(os.getenv(\"GOAL_MIN_PROFIT\",\"1.56\"))\n","GOAL_MAX_PROFIT=float(os.getenv(\"GOAL_MAX_PROFIT\",\"500.0\"))\n","\n","from decimal import Decimal as _D\n","def _toD(x):\n","    try: return _D(str(x))\n","    except Exception: return _D(\"0\")\n","\n","class ObjetivoUniversal156:\n","    def __init__(self, min_pct: float=GOAL_MIN_PROFIT, max_pct: float=GOAL_MAX_PROFIT):\n","        self.min=_toD(min_pct); self.max=_toD(max_pct)\n","    def _wrap(self, fn):\n","        if not callable(fn): return fn\n","        async def _aw(*a, **k):\n","            for kk in list(k.keys()):\n","                if \"profit\" in kk.lower() or \"take\" in kk.lower():\n","                    k[kk]=float(max(self.min, _toD(k[kk])))\n","            r=fn(*a, **k); return (await r) if asyncio.iscoroutine(r) else r\n","        if asyncio.iscoroutinefunction(fn): return _aw\n","        def _sw(*a, **k):\n","            for kk in list(k.keys()):\n","                if \"profit\" in kk.lower() or \"take\" in kk.lower():\n","                    k[kk]=float(max(self.min, _toD(k[kk])))\n","            return fn(*a, **k)\n","        return _sw\n","    def enforce_on_executor(self, ex):\n","        if not ex: return\n","        for nm in (\"place_bracket\",\"place_oco\",\"secure_profit_sale\",\"execute_order\",\"ultra_ai_smart_buy\"):\n","            if hasattr(ex,nm): setattr(ex,nm,self._wrap(getattr(ex,nm)))\n","\n","# ============================== CORE: Predictores + Ejecutor ====================\n","def _ema_np(arr, period): return _ema(arr, period)\n","\n","class PredictorBase:\n","    def __init__(self):\n","        self.history=[]\n","        self.kf=_Kalman1D(init=0.0)\n","    async def predecir_ajustada(self, price: float):\n","        self.history.append(float(price))\n","        if len(self.history)>360: self.history=self.history[-360:]\n","        ema8=_ema_np(self.history[-64:],8)[-1]; ema21=_ema_np(self.history[-64:],21)[-1]\n","        raw=(ema8-ema21)/(price+1e-9)\n","        return float(self.kf.update(raw*100.0))\n","\n","class PredictorAlcista(PredictorBase): ...\n","class PredictorBajista(PredictorBase): ...\n","\n","class GestorRiesgo:\n","    def __init__(self, api): self.api=api\n","    async def initialize(self): return True\n","\n","class UltraOrderExecutor:\n","    def __init__(self, api, risk_manager, predictor=None):\n","        self.api=api; self.risk=risk_manager; self.predictor=predictor\n","        self.target_min_profit=float(GOAL_MIN_PROFIT); self.target_max_profit=float(GOAL_MAX_PROFIT)\n","        self.mode=\"DEMO\"; self.live=False; self.futuros_mode=False\n","        self.ultra_buy_cooldown_s=60\n","    def set_mode(self, mode:str): self.mode=mode\n","    def set_live(self, flag:bool): self.live=flag\n","    async def execute_order(self, side:str, predicted_change:float=0.0):\n","        px=await obtener_precio_actual(self.api, os.getenv(\"PAR_TRADING\",\"XXBTZUSD\"))\n","        print(f\"🛒 EXEC {side.upper()} @ {px:.2f} | Δpred={predicted_change:+.2f}% | objetivo≥{self.target_min_profit:.2f}% | mode={self.mode} live={self.live}\")\n","        return {\"ok\": True, \"side\": side, \"price\": px}\n","    async def ultra_ai_smart_buy(self, ultra_signal: float):\n","        if float(ultra_signal)>=self.target_min_profit:\n","            return await self.execute_order(\"buy\", predicted_change=ultra_signal)\n","        return {\"ok\": False, \"skipped\": True}\n","    async def compra_por_liquidacion_improbable(self): return {\"ok\": True, \"noop\": True}\n","\n","class QuantumTradingCore:\n","    def __init__(self, api):\n","        self.api=api\n","        self.predictor_alcista=PredictorAlcista()\n","        self.predictor_bajista=PredictorBajista()\n","        self.order_executor=None\n","        self.signal_comparator=None\n","    async def initialize(self): return True\n","\n","# ===================== Predictors enchufados (sentimiento/momentum) ===========\n","import numpy as _np, statistics\n","class SentimientoMercadoBTC:\n","    def __init__(self, api, intervalo=15, guardar_csv=True):\n","        self.api = api; self.intervalo = int(intervalo); self.guardar_csv = guardar_csv\n","        self.ruta_csv = os.path.join(OUT_DIR, \"sentimiento_mercado.csv\")\n","        os.makedirs(OUT_DIR, exist_ok=True)\n","    async def evaluar_sentimiento(self) -> dict:\n","        try:\n","            ohlc = await _get_ohlc(self.api, os.getenv(\"PAR_TRADING\",\"XXBTZUSD\"), self.intervalo, 60)\n","            if not ohlc or len(ohlc) < 10: return {\"sentimiento\":\"neutro\",\"nivel\":0.0,\"emoji\":\"😐\"}\n","            closes = [float(x[4]) for x in ohlc]\n","            vols   = [1.0 for _ in ohlc]\n","            ret = _np.diff(closes); vol = float(_np.std(ret)); dir_pct = (closes[-1]-closes[0])/(closes[0]+1e-9)*100.0\n","            vavg = statistics.mean(vols); vrat = (vols[-1]/vavg) if vavg>0 else 1.0\n","            nivel = round((dir_pct*vrat)-(vol*10.0), 2)\n","            if nivel > 5:  sent, emoji = \"euforia\",\"🚀\"\n","            elif nivel > 2: sent, emoji = \"optimismo\",\"📈\"\n","            elif nivel < -5: sent, emoji = \"pánico\",\"💥\"\n","            elif nivel < -2: sent, emoji = \"miedo\",\"📉\"\n","            else: sent, emoji = \"neutro\",\"😐\"\n","            row = {\"fecha\":datetime.utcnow().isoformat(),\"sentimiento\":sent,\"nivel\":nivel,\"emoji\":emoji}\n","            if self.guardar_csv:\n","                exists = os.path.isfile(self.ruta_csv)\n","                with open(self.ruta_csv, \"a\", newline=\"\") as f:\n","                    w=csv.DictWriter(f, fieldnames=list(row.keys()))\n","                    if not exists: w.writeheader()\n","                    w.writerow(row)\n","            return row\n","        except Exception:\n","            return {\"sentimiento\":\"error\",\"nivel\":0.0,\"emoji\":\"❌\"}\n","\n","class ComparadorBTCEnchufado:\n","    def __init__(self, api, sentimiento: SentimientoMercadoBTC): self.api=api; self.sent=sentimiento\n","    async def _momentum_1m(self, pair: str=\"XXBTZUSD\", lookback:int=5) -> float:\n","        o = await _get_ohlc(self.api, pair, 1, max(lookback+1, 6))\n","        if not o or len(o) < 2: return 0.0\n","        closes = [float(x[4]) for x in o]\n","        return ((closes[-1]-closes[0])/(closes[0]+1e-9))*100.0\n","    async def comparar_y_ajustar_prediccion(self, precio_actual: float, pred_pct: float) -> float:\n","        s = await self.sent.evaluar_sentimiento(); mom = await self._momentum_1m(os.getenv(\"PAR_TRADING\",\"XXBTZUSD\"), 5)\n","        nivel = float(s.get(\"nivel\",0.0)); adj=float(pred_pct)\n","        adj *= (1.0 + max(-0.10, min(0.10, nivel/100.0))); adj += math.tanh(mom/3.0)*0.25\n","        return float(adj)\n","\n","class QuantumPredictorAlcista(PredictorBase):\n","    def __init__(self, api, comparador_btc: ComparadorBTCEnchufado|None=None):\n","        super().__init__(); self.api=api; self.comp=comparador_btc\n","    async def predecir_ajustada(self, price: float):\n","        base = await super().predecir_ajustada(price)\n","        return await self.comp.comparar_y_ajustar_prediccion(price, base) if self.comp else base\n","class QuantumPredictorBajista(QuantumPredictorAlcista): ...\n","\n","async def crear_predictors_enchufados(api):\n","    sent = SentimientoMercadoBTC(api, intervalo=int(os.getenv(\"SENT_INTERVAL\", \"15\")), guardar_csv=True)\n","    comp = ComparadorBTCEnchufado(api, sent)\n","    pred_up = QuantumPredictorAlcista(api, comp); pred_dn = QuantumPredictorBajista(api, comp)\n","    return pred_up, pred_dn, comp\n","\n","async def _ensure_predictors_wired(api, trading_core):\n","    try:\n","        if callable(getattr(trading_core.predictor_alcista,\"predecir_ajustada\",None)) and \\\n","           callable(getattr(trading_core.predictor_bajista,\"predecir_ajustada\",None)):\n","            print(\"ℹ️ Predictores ya conectados.\"); return\n","    except Exception: pass\n","    pred_up, pred_dn, comp = await crear_predictors_enchufados(api)\n","    trading_core.predictor_alcista = pred_up; trading_core.predictor_bajista = pred_dn; trading_core.signal_comparator = comp\n","    print(\"✅ Predictores + Comparador conectados a trading_core.\")\n","\n","# ===================== Hooks y bootstack ==========================\n","def wire_filosofia_y_comparador(ultra_executor):\n","    def _cfg(name: str, default=None):\n","        v = os.getenv(name)\n","        if v is None: return default\n","        if isinstance(default, bool): return _env_bool(v, default)\n","        try: return type(default)(v) if default is not None else v\n","        except Exception: return v\n","    return _cfg, None\n","\n","async def TTDVI_UNIFY_HOOK_V4(*, api, ultra_executor, cfg=None, pair_alias: str = None, inteligencia=None, pair_rest=None):\n","    try:\n","        if hasattr(ultra_executor, \"futuros_mode\") and _env_bool(os.getenv(\"FUTUROS_MODE\",\"1\"), True):\n","            ultra_executor.futuros_mode = True\n","        if hasattr(ultra_executor, \"ultra_buy_cooldown_s\"):\n","            ultra_executor.ultra_buy_cooldown_s = max(30, int(os.getenv(\"ULTRA_BUY_COOLDOWN_S\", \"60\")))\n","        if hasattr(api, \"_kraken_pair\") and callable(getattr(api, \"_kraken_pair\", None)):\n","            pair_alias = pair_alias or os.getenv(\"PAR_TRADING\", \"XXBTZUSD\"); _ = api._kraken_pair(pair_alias)\n","        if hasattr(ultra_executor, \"tuner\") and hasattr(ultra_executor.tuner, \"suggest_adjustments\"):\n","            orig = ultra_executor.tuner.suggest_adjustments\n","            def _wrap():\n","                try:\n","                    d = orig() or {}\n","                    d[\"profit_target_pct\"] = max(156.0, float(d.get(\"profit_target_pct\", 156.0)))\n","                    d[\"risk_factor\"] = float(d.get(\"risk_factor\", 0.02))\n","                    return d\n","                except Exception:\n","                    return {\"profit_target_pct\": 156.0, \"risk_factor\": 0.02}\n","            ultra_executor.tuner.suggest_adjustments = _wrap\n","    except Exception as e:\n","        print(f\"[TTDVI_UNIFY_HOOK_V4] aviso: {e}\")\n","\n","async def boot_darwin_v4_stack(\n","    api, ultra_executor, predictor_alcista, predictor_bajista,\n","    order_executor=None, inteligencia_v3=None,\n","    pair_alias: str = \"XXBTZUSD\", pair_rest: str | None = None,\n","):\n","    try:\n","        cfg_filo, signal_comparator = wire_filosofia_y_comparador(ultra_executor)\n","    except Exception:\n","        def cfg_filo(name: str, default=None): return os.getenv(name, default)\n","        signal_comparator=None\n","    unify = globals().get(\"TTDVI_UNIFY_HOOK_V4\")\n","    if callable(unify):\n","        try:\n","            await unify(api=api, ultra_executor=ultra_executor, cfg=lambda *a, **k: None,\n","                        pair_alias=pair_alias, inteligencia=inteligencia_v3, pair_rest=pair_rest)\n","        except Exception: pass\n","    print(\"✅ Stack Darwin v4 listo.\")\n","    return {\"cfg\": cfg_filo, \"signal_comparator\": signal_comparator}\n","\n","# ======================= VISUAL/LOGS + LOOP =======================\n","LOG_DIR = globals().get(\"LOG_DIR\") or os.path.join(os.path.abspath(\".\"), \"logs\")\n","OUT_DIR = globals().get(\"OUT_DIR\") or os.path.join(os.path.abspath(\".\"), \"resultados_graficos\")\n","try:\n","    os.makedirs(LOG_DIR, exist_ok=True); os.makedirs(OUT_DIR, exist_ok=True)\n","except Exception: pass\n","\n","PAR_TRADING = os.getenv(\"PAR_TRADING\", \"XXBTZUSD\")\n","REALES_CSV = os.path.join(LOG_DIR, \"resultados_reales.csv\")\n","\n","def utc_now_iso() -> str:\n","    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()\n","\n","async def generar_pngs_y_logs(api, trading_core):\n","    try:\n","        retro = await ejecutar_retro_introspeccion_mercado(24)\n","        dash  = await render_dashboard_1m(api or auto_api())\n","        if (retro.get(\"png\") if isinstance(retro, dict) else None) or \\\n","           (retro.get(\"sent_png\") if isinstance(retro, dict) else None) or \\\n","           dash:\n","            _show_inline_and_links(\n","                retro.get(\"png\") if isinstance(retro, dict) else None,\n","                retro.get(\"sent_png\") if isinstance(retro, dict) else None,\n","                dash\n","            )\n","    except Exception as e:\n","        print(f\"⚠️ Visualización falló: {e}\")\n","\n","async def run_once(*, api=None,\n","                   trading_core: Optional['QuantumTradingCore']=None,\n","                   ultra_executor: Optional['UltraOrderExecutor']=None):\n","    api = api or auto_api()\n","    px = await obtener_precio_actual(api, PAR_TRADING)\n","\n","    try:\n","        newfile = not os.path.exists(REALES_CSV)\n","        with open(REALES_CSV, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n","            w = csv.writer(f)\n","            if newfile: w.writerow([\"ts_utc\", \"pair\", \"price\"])\n","            w.writerow([utc_now_iso(), PAR_TRADING, f\"{float(px):.8f}\"])\n","    except Exception as e:\n","        print(f\"⚠️ No se pudo escribir {REALES_CSV}: {e}\")\n","\n","    try:\n","        await generar_pngs_y_logs(api, trading_core)\n","    except Exception as e:\n","        print(f\"⚠️ Generación gráfica: {e}\")\n","\n","    try:\n","        if trading_core is not None and ultra_executor is not None:\n","            pu = await trading_core.predictor_alcista.predecir_ajustada(px)\n","            pd = await trading_core.predictor_bajista.predecir_ajustada(px)\n","            goal_min = float(globals().get(\"GOAL_MIN_PROFIT\", 0.015))\n","            decision = \"BUY\" if pu > -pd and pu >= goal_min else \"ESPERAR\"\n","            print(f\"🤖 Señales: UP={pu:+.2f}% DN={pd:+.2f}% ⇒ {decision}\")\n","            if decision == \"BUY\":\n","                await ultra_executor.execute_order(\"buy\", predicted_change=pu)\n","    except Exception as e:\n","        print(f\"⚠️ Tick core: {e}\")\n","\n","    try:\n","        if \"google.colab\" not in sys.modules:\n","            url, _ = start_render_server(open_browser=None)\n","            if url: print(f\"🌐 Descarga y vista: {url}\")\n","    except Exception as e:\n","        print(f\"ℹ️ No se inició servidor embebido: {e}\")\n","\n","    print(f\"🔹 run_once: precio REAL {PAR_TRADING} = {px}\")\n","    return {\"price\": float(px), \"csv\": REALES_CSV}\n","\n","async def run_loop(*, api=None, trading_core=None, ultra_executor=None,\n","                   period_s: Optional[int]=None, _heartbeat=None):\n","    if period_s is None:\n","        period_s = int(os.getenv(\"VIZ_PERIOD_S\", \"60\"))\n","    print(f\"⏱️ Loop vivo cada {period_s}s.\")\n","    while True:\n","        try:\n","            await run_once(api=api, trading_core=trading_core, ultra_executor=ultra_executor)\n","            if _heartbeat is not None: _heartbeat[\"ts\"] = time.time()\n","        except Exception as e:\n","            print(f\"⚠️ run_loop: {e}\")\n","        await asyncio.sleep(max(30, int(period_s)))\n","\n","# =================================================================================================\n","# =============================== AUTORUN + WATCHDOG (ANTICUELGUES) ===============================\n","# =================================================================================================\n","\n","class AutorunManager:\n","    _started = False\n","    def __init__(self):\n","        self.heartbeat = {\"ts\": time.time()}\n","        self.tasks: Dict[str, asyncio.Task] = {}\n","        self.mode = \"DEMO\"\n","        self.live = False\n","\n","    def _detect_mode(self):\n","        # Prioridad: RUN_LIVE (bool) > RUN_MODE\n","        if _env_bool(os.getenv(\"RUN_LIVE\"), False):\n","            self.mode = \"REAL\"; self.live = True\n","        else:\n","            rm = os.getenv(\"RUN_MODE\", \"DEMO\").strip().upper()\n","            self.mode = \"REAL\" if rm == \"REAL\" else \"DEMO\"\n","            self.live = (self.mode == \"REAL\")\n","        return self.mode, self.live\n","\n","    def apply_mode(self, executor: 'UltraOrderExecutor'):\n","        mode, live = self._detect_mode()\n","        if hasattr(executor, \"set_mode\"):\n","            executor.set_mode(mode)\n","        if hasattr(executor, \"set_live\"):\n","            executor.set_live(live)\n","        tag = \"REAL\" if live else \"DEMO\"\n","        print(f\"⚙️  Modo de ejecución fijado: {tag} (RUN_MODE={os.getenv('RUN_MODE')} | RUN_LIVE={os.getenv('RUN_LIVE')})\")\n","\n","    async def watchdog(self, api, core, ex, period_s: int):\n","        \"\"\"Revisa latido y reinicia loop si se queda colgado.\"\"\"\n","        print(\"🛡️  Watchdog resiliente activo.\")\n","        while True:\n","            try:\n","                last = self.heartbeat.get(\"ts\", 0)\n","                if time.time() - last > period_s * 3 + 15:\n","                    print(\"♻️  Watchdog: reinicio de loop por inactividad.\")\n","                    t = self.tasks.get(\"loop\")\n","                    if t and not t.cancelled():\n","                        t.cancel()\n","                    self.tasks[\"loop\"] = asyncio.create_task(\n","                        run_loop(api=api, trading_core=core, ultra_executor=ex,\n","                                 period_s=period_s, _heartbeat=self.heartbeat)\n","                    )\n","                await asyncio.sleep(10)\n","            except Exception as e:\n","                print(f\"⚠️ Watchdog error: {e}\")\n","                await asyncio.sleep(10)\n","\n","AUTORUN = AutorunManager()\n","\n","def _tz_now_str(tzname: str):\n","    try:\n","        from zoneinfo import ZoneInfo\n","        return datetime.now(ZoneInfo(tzname)).strftime(\"%Y-%m-%d %H:%M:%S %Z\")\n","    except Exception:\n","        return datetime.utcnow().strftime(\"%Y-%m-%d %H:%M:%S UTC\")\n","\n","# -------- Sanity check (usa _get_ohlc de tu stack o el fallback del bloque final) --------\n","async def _quick_sanity_check(api):\n","    try:\n","        p = await obtener_precio_actual(api, os.getenv(\"PAR_TRADING\",\"XXBTZUSD\"))\n","        ok_price = bool(p and p > 0)\n","        ohlc = await _get_ohlc(api, os.getenv(\"PAR_TRADING\",\"XXBTZUSD\"), 1, 5)\n","        ok_ohlc = isinstance(ohlc, list) and len(ohlc) > 0\n","        print(f\"✅ Sanity: price_ok={ok_price} | ohlc_ok={ok_ohlc}\")\n","        return ok_price and ok_ohlc\n","    except Exception as e:\n","        print(f\"⚠️ Sanity check falló: {e}\")\n","        return False\n","\n","async def _bounded(coro, timeout=15):\n","    try:\n","        return await asyncio.wait_for(coro, timeout=timeout)\n","    except asyncio.TimeoutError:\n","        print(\"⏳ Tiempo excedido en operación; continuando resiliente.\")\n","    except Exception as e:\n","        print(f\"⚠️ Operación falló: {e}\")\n","\n","async def _main_unificado():\n","    # ── Autorun ── pre-run\n","    print(\"── Autorun ──\")\n","    print(\"meta:\", {\"etapa\":\"pre-run\"})\n","    print({\"autorun\": _env_bool(os.getenv(\"AUTORUN\",\"1\"), True)})\n","    print(\"──────────────\\n\")\n","    print(f\"[LOAD] {utc_now_iso()} — Sin checkpoint previo\")\n","    print(f\"[START] {utc_now_iso()} — Arrancando ciclo (attempt #1)\\n\")\n","\n","    print(\"── Resilience ──\")\n","    print(\"meta:\", {\"etapa\":\"start\"})\n","    print({\"attempt\": 1})\n","    print(\"──────────────\\n\")\n","\n","    print(\"── MainDetectado ──\")\n","    print({\"route\":\"boot_darwin_v4_stack\"})\n","    print(\"──────────────\")\n","\n","    # Setup base\n","    print(f\"\\n📂 LOG_DIR={os.path.abspath(LOG_DIR)} | OUT_DIR={os.path.abspath(OUT_DIR)}\")\n","    print(f\"🔧 PAR_TRADING={PAR_TRADING} | INTERVAL={os.getenv('INTERVAL','1')}m\")\n","    print(f\"🕒 Vancouver={_tz_now_str('America/Vancouver')} | NewYork={_tz_now_str('America/New_York')} | UTC={_tz_now_str('UTC')}\")\n","\n","    api = auto_api()\n","    if hasattr(api, \"initialize\"):\n","        res = api.initialize()\n","        if asyncio.iscoroutine(res):\n","            await res\n","\n","    # 🔌 INTEGRADO: arrancamos el Centro Autónomo (warmup + keepalive) con la firma correcta\n","    try:\n","        await iniciar_centro_historial(\n","            pair=os.getenv(\"PAR_TRADING\",\"XXBTZUSD\"),\n","            interval=int(os.getenv(\"INTERVAL\",\"1\")),\n","            api=api\n","        )\n","    except Exception as _e_centro:\n","        print(f\"⚠️ No se pudo iniciar el Centro Autónomo: {_e_centro}\")\n","\n","    risk = GestorRiesgo(api)\n","    if hasattr(risk, \"initialize\"):\n","        rres = risk.initialize()\n","        if asyncio.iscoroutine(rres):\n","            await rres\n","\n","    core = QuantumTradingCore(api)\n","    if hasattr(core, \"initialize\"):\n","        cres = core.initialize()\n","        if asyncio.iscoroutine(cres):\n","            await cres\n","\n","    ex = UltraOrderExecutor(api, risk, predictor=getattr(core, \"predictor_alcista\", None))\n","    core.order_executor = ex\n","\n","    # Modo DEMO/REAL\n","    AUTORUN.apply_mode(ex)\n","\n","    # Cableado sentimiento/momentum\n","    try:\n","        await _ensure_predictors_wired(api, core)\n","    except Exception as e:\n","        print(f\"🚨 Cableado predictores: {e}\")\n","\n","    # Objetivo 156% hardening\n","    try:\n","        if \"ObjetivoUniversal156\" in globals():\n","            ObjetivoUniversal156().enforce_on_executor(ex)\n","    except Exception as e:\n","        print(f\"⚠️ Objetivo156: {e}\")\n","\n","    # Sanity + Boot\n","    await _bounded(_quick_sanity_check(api), timeout=12)\n","    await _bounded(\n","        boot_darwin_v4_stack(\n","            api=api, ultra_executor=ex,\n","            predictor_alcista=getattr(core, \"predictor_alcista\", None),\n","            predictor_bajista=getattr(core, \"predictor_bajista\", None),\n","            order_executor=ex, inteligencia_v3=None,\n","            pair_alias=PAR_TRADING, pair_rest=None\n","        ),\n","        timeout=15\n","    )\n","\n","    # Tiro inicial sentimiento\n","    try:\n","        res = await _bounded(run_sentimiento_mercado(intervalo=1, par=PAR_TRADING), timeout=10)\n","        if isinstance(res, dict):\n","            print(f\"✅ Sentimiento: {res.get('sentimiento')} (nivel={res.get('nivel')})\")\n","    except Exception as e:\n","        print(f\"❌ Sentimiento inicial falló: {e}\")\n","\n","    # Visual inmediata\n","    await _bounded(run_once(api=api, trading_core=core, ultra_executor=ex), timeout=25)\n","\n","    # Lanzar loop + watchdog sin bloquear (con heartbeat para continuidad)\n","    period_s = int(os.getenv(\"VIZ_PERIOD_S\", \"60\"))\n","    AUTORUN.tasks[\"loop\"] = asyncio.create_task(\n","        run_loop(api=api, trading_core=core, ultra_executor=ex, period_s=period_s, _heartbeat=AUTORUN.heartbeat),\n","        name=\"ttdvi_main_loop\"\n","    )\n","    AUTORUN.tasks[\"watchdog\"] = asyncio.create_task(\n","        AUTORUN.watchdog(api, core, ex, period_s),\n","        name=\"ttdvi_watchdog\"\n","    )\n","    print(\"📡 Visualización + trading en vivo activo (loop + watchdog).\")\n","\n","    # Mantener vivo en modo script; en notebook no bloquear\n","    def _in_notebook():\n","        try:\n","            from IPython import get_ipython\n","            sh = get_ipython()\n","            return bool(sh) and sh.__class__.__name__ in (\"ZMQInteractiveShell\", \"TerminalInteractiveShell\", \"Shell\")\n","        except Exception:\n","            return False\n","\n","    if not _in_notebook():\n","        try:\n","            while True:\n","                # pulso principal (para guardianes externos si los hubiera)\n","                try:\n","                    # Si existe el resiliente externo (TTDVI_heartbeat), úsalo:\n","                    if \"TTDVI_heartbeat\" in globals() and callable(globals()[\"TTDVI_heartbeat\"]):\n","                        globals()[\"TTDVI_heartbeat\"](\"main_process\")\n","                except Exception:\n","                    pass\n","                await asyncio.sleep(3600)\n","        except asyncio.CancelledError:\n","            pass\n","\n","# =================================================================================================\n","# =================== BLOQUE FINAL — ULTRAEJECUTADOR PRODUCCIÓN · MEGA ORQUESTADOR =================\n","# ======================================= TTDVI156 · DARWIN v4 =====================================\n","# =================================================================================================\n","\n","from __future__ import annotations\n","import os, sys, json, math, time, csv, asyncio, shutil, signal\n","from datetime import datetime, timezone, timedelta\n","from typing import Dict, Any, Optional, List, Tuple\n","\n","# ---------- Helpers mínimos (solo si no existen) ----------\n","def _env_b(name: str, default: bool = False) -> bool:\n","    if \" _env_b \" in globals():  # evita sombra\n","        return globals()[\"_env_b\"](os.getenv(name), default)\n","    v = str(os.getenv(name, \"1\" if default else \"0\")).strip().lower()\n","    return v in (\"1\",\"true\",\"yes\",\"y\",\"on\",\"si\",\"sí\")\n","\n","def _env_i(name: str, default: int = 0) -> int:\n","    try: return int(os.getenv(name, str(default)))\n","    except Exception: return default\n","\n","def _env_f(name: str, default: float = 0.0) -> float:\n","    try: return float(os.getenv(name, str(default)))\n","    except Exception: return default\n","\n","def utc_now_iso() -> str:\n","    try: return globals().get(\"utc_now_iso\", lambda: datetime.now(timezone.utc).replace(microsecond=0).isoformat())()\n","    except Exception: return datetime.now(timezone.utc).replace(microsecond=0).isoformat()\n","\n","RUN_ROOT = str(globals().get(\"RUN_ROOT\") or globals().get(\"BASE_DIR\") or os.path.abspath(\".\"))\n","OUT_DIR  = os.path.join(RUN_ROOT, \"resultados_graficos\")\n","LOG_DIR  = os.path.join(RUN_ROOT, \"logs\")\n","os.makedirs(OUT_DIR, exist_ok=True)\n","os.makedirs(LOG_DIR, exist_ok=True)\n","\n","# Registry global compartido con otros bloques\n","_REG = globals().setdefault(\"_TTDVI_REG\", {\n","    **globals().get(\"_TTDVI_REG\", {}),\n","    \"api\": None, \"core\": None, \"executor\": None,\n","    \"live_task\": None, \"mini_monitor_task\": None,\n","    \"deadline_task\": None, \"watchdog_task\": None,\n","    \"ultra_started\": False, \"shutdown_in_progress\": False,\n","    \"last_snapshot\": None, \"last_error\": None,\n","    \"heartbeat\": {\"ts\": time.time()},\n","})\n","\n","# ---------- Dependencias que deben existir (tomamos del bloque previo si están) ----------\n","_ema = globals().get(\"_ema\") or (lambda arr, p: (lambda a=2.0/(p+1.0): [ (arr[i] if i==0 else a*arr[i] + (1-a)*out[-1]) for i in range(len(arr)) ])())\n","auto_api = globals().get(\"auto_api\") or (lambda : type(\"API\", (), {\n","    \"get_price\": staticmethod(lambda pair=\"XXBTZUSD\": 30000.0),\n","    \"ticker_price\": staticmethod(lambda pair=\"XXBTZUSD\": 30000.0),\n","    \"query_public\": staticmethod(lambda *a, **k: {})\n","})())\n","\n","_projection_60m = globals().get(\"_projection_60m\")\n","if _projection_60m is None:\n","    def _projection_60m(times_s: List[float], closes: List[float], price_now: float) -> float:\n","        n = min(120, len(closes))\n","        if n < 5: return float(price_now or (closes[-1] if closes else 0.0))\n","        y = [float(v) for v in closes[-n:]]\n","        x = list(range(n))\n","        sx, sy = sum(x), sum(y)\n","        sxx = sum(i*i for i in x)\n","        sxy = sum(i*j for i, j in zip(x, y))\n","        denom = n*sxx - sx*sx\n","        m = 0.0 if abs(denom) < 1e-12 else (n*sxy - sx*sy) / denom\n","        return float(price_now or y[-1]) + 60.0 * float(m)\n","\n","_get_ohlc = globals().get(\"_get_ohlc\")\n","if _get_ohlc is None:\n","    async def _get_ohlc(api, pair: str = \"XXBTZUSD\", interval: int = 1, limit: int = 120) -> List[List[float]]:\n","        # Fallback sintético continuo (si falla API)\n","        try:\n","            if hasattr(api, \"query_public\"):\n","                since = int(time.time()) - int(interval)*60*int(limit*2)\n","                r = await api.query_public(\"OHLC\", {\"pair\": pair, \"interval\": int(interval), \"count\": int(limit), \"since\": since})\n","                serie = next((v for k,v in (r.get(\"result\",{}) or {}).items() if k!=\"last\" and isinstance(v, list)), [])\n","                out=[]\n","                for row in serie[-limit:]:\n","                    ts=float(row[0]); ts=ts/1000.0 if ts>10**12 else ts\n","                    o,h,l,c = float(row[1]),float(row[2]),float(row[3]),float(row[4])\n","                    out.append([ts,o,h,l,c])\n","                if out: return out\n","        except Exception: pass\n","        try:\n","            price_now = await (api.get_price(pair) if hasattr(api, \"get_price\") else api.ticker_price(pair))\n","        except Exception:\n","            price_now = 30000.0\n","        step=60*max(1,int(interval)); now=time.time(); last=float(price_now or 30000.0); out=[]\n","        for i in range(limit, 0, -1):\n","            ts=now - i*step\n","            drift=(math.sin(i/7.0)+(0.5 - (i%3)/3.0))* last * 0.0006\n","            o=last; c=max(1e-6, o+drift); h=max(o,c)+abs(drift)*0.35; l=min(o,c)-abs(drift)*0.35\n","            out.append([ts,o,h,l,c]); last=c\n","        return out\n","\n","evaluar_sentimiento = globals().get(\"evaluar_sentimiento\")\n","if evaluar_sentimiento is None:\n","    async def evaluar_sentimiento(api, pair: str = \"XXBTZUSD\", interval: int = 15) -> Dict[str, Any]:\n","        rows = await _get_ohlc(api, pair=pair, interval=interval, limit=max(40, interval*6))\n","        if len(rows) < 10:\n","            return {\"sentimiento\":\"neutro\",\"nivel\":0.0,\"volatilidad\":0.0,\"direccion_pct\":0.0}\n","        closes=[r[4] for r in rows]\n","        direccion_pct = (closes[-1]-closes[0])/(closes[0]+1e-12)*100.0\n","        rets=[closes[i]-closes[i-1] for i in range(1,len(closes))]\n","        mean=sum(rets)/len(rets)\n","        var = sum((r-mean)**2 for r in rets)/max(1, len(rets)-1)\n","        vola = math.sqrt(var)\n","        nivel = direccion_pct - 10.0*vola\n","        tag = \"euforia\" if nivel>5 else \"optimismo\" if nivel>2 else \"pánico\" if nivel<-5 else \"miedo\" if nivel<-2 else \"neutro\"\n","        return {\"sentimiento\": tag, \"nivel\": round(max(-12,min(12,float(nivel))),2),\n","                \"volatilidad\": float(vola), \"direccion_pct\": round(float(direccion_pct),2)}\n","\n","# ============================== Snapshots en vivo (resiliente) ==============================\n","async def _eta_cruce_minutos(series: List[float], p_fast=8, p_slow=21, step_min=1) -> Optional[float]:\n","    try:\n","        if len(series) < max(p_fast, p_slow) + 5: return None\n","        f = _ema(series, p_fast)[-10:]; s = _ema(series, p_slow)[-10:]\n","        d = [ff - ss for ff, ss in zip(f[-len(s):], s[-len(f):])]\n","        if len(d) < 5: return None\n","        n=len(d); x=list(range(n))\n","        sx, sy = sum(x), sum(d)\n","        sxx = sum(i*i for i in x)\n","        sxy = sum(i*j for i,j in zip(x,d))\n","        denom = n*sxx - sx*sx\n","        m = 0.0 if abs(denom)<1e-12 else (n*sxy - sx*sy)/denom\n","        d_now = d[-1]\n","        if not m: return None\n","        if (d_now>0 and m>=0) or (d_now<0 and m<=0): return None\n","        return float(abs(d_now/m))*float(step_min)\n","    except Exception:\n","        return None\n","\n","async def _trend_tag_from_series(series: List[float]) -> str:\n","    try:\n","        if len(series) < 22: return \"NEUTRO\"\n","        f = _ema(series, 8)[-1]; s = _ema(series, 21)[-1]\n","        if abs(f - s) < (series[-1] * 0.0005): return \"NEUTRO\"\n","        return \"ALCISTA\" if f > s else \"BAJISTA\"\n","    except Exception:\n","        return \"NEUTRO\"\n","\n","async def resumen_vivo_100_real(api=None, pair: str = None, publish: bool = True, to_csv: bool = True) -> Dict[str, Any]:\n","    api = api or auto_api()\n","    pair = pair or os.getenv('PAR_TRADING', 'XXBTZUSD')\n","\n","    ohlc_1m  = await _get_ohlc(api, pair=pair, interval=1,  limit=180)\n","    ohlc_15m = await _get_ohlc(api, pair=pair, interval=15, limit=160)\n","    ohlc_60m = await _get_ohlc(api, pair=pair, interval=60, limit=120)\n","\n","    c1  = [r[4] for r in ohlc_1m]\n","    c15 = [r[4] for r in ohlc_15m]\n","    c60 = [r[4] for r in ohlc_60m]\n","\n","    try:\n","        price_now = await (api.get_price(pair) if hasattr(api, \"get_price\") else api.ticker_price(pair))\n","    except Exception:\n","        price_now = c1[-1] if c1 else 0.0\n","\n","    proj_60 = _projection_60m([r[0] for r in ohlc_1m], c1, price_now)\n","    proj_delta_pct = 0.0 if not price_now else (float(proj_60) - float(price_now))/float(price_now)*100.0\n","\n","    trend_short = await _trend_tag_from_series(c1)\n","    trend_mid   = await _trend_tag_from_series(c15)\n","    trend_long  = await _trend_tag_from_series(c60)\n","\n","    eta_1  = await _eta_cruce_minutos(c1, 8, 21, step_min=1)\n","    eta_15 = await _eta_cruce_minutos(c15, 8, 21, step_min=15)\n","    eta_60 = await _eta_cruce_minutos(c60, 8, 21, step_min=60)\n","\n","    senti = await evaluar_sentimiento(api, pair=pair, interval=15)\n","    sent_tag = senti.get(\"sentimiento\", \"neutro\")\n","    sent_lvl = float(senti.get(\"nivel\", 0.0))\n","\n","    incoh = int(trend_short != trend_mid) + int(trend_mid != trend_long)\n","    vola  = abs(float(senti.get(\"volatilidad\", 0.0)))\n","    risk_score = min(1.0, 0.4*incoh + min(0.6, vola*12))\n","    risk_level = \"BAJO\" if risk_score<0.33 else (\"MEDIO\" if risk_score<0.66 else \"ALTO\")\n","\n","    coh = (3 - incoh) / 3.0\n","    conf = max(0.05, min(0.95, 0.5*coh + 0.5*min(1.0, abs(proj_delta_pct)/1.5)))\n","\n","    rec = \"MANTENER\"\n","    if proj_delta_pct >= _env_f(\"PROJ_BUY_PCT\", 0.35) and trend_short == \"ALCISTA\":\n","        rec = \"COMPRA_MODERADA\" if conf < 0.7 else \"COMPRA_AGRESIVA\"\n","    if proj_delta_pct <= -_env_f(\"PROJ_SELL_PCT\", 0.35) and trend_short == \"BAJISTA\":\n","        rec = \"REDUCIR_EXPOSICION\" if conf < 0.7 else \"VENTA_PARCIAL\"\n","    if risk_level == \"ALTO\" and rec.startswith(\"COMPRA\"):\n","        rec = \"MANTENER\"\n","\n","    snap = {\n","        \"ts_utc\": utc_now_iso(), \"pair\": pair,\n","        \"price_now\": float(price_now), \"projection_60m\": float(proj_60),\n","        \"projection_delta_pct\": float(proj_delta_pct),\n","        \"trend_short\": trend_short, \"trend_mid\": trend_mid, \"trend_long\": trend_long,\n","        \"eta_cross_min\": {\"1m\": eta_1, \"15m\": eta_15, \"60m\": eta_60},\n","        \"sentiment\": {\n","            \"tag\": sent_tag, \"level\": float(sent_lvl),\n","            \"volatilidad\": float(senti.get(\"volatilidad\", 0.0)),\n","            \"dir_pct\": float(senti.get(\"direccion_pct\", 0.0)),\n","        },\n","        \"risk_level\": risk_level, \"confidence_0_1\": float(conf), \"recommendation\": rec,\n","    }\n","\n","    if to_csv:\n","        try:\n","            csv_path = os.path.join(LOG_DIR, \"resumen_vivo_snapshots.csv\")\n","            new = not os.path.exists(csv_path)\n","            with open(csv_path, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n","                w = csv.writer(f)\n","                if new:\n","                    w.writerow([\"ts_utc\",\"pair\",\"price_now\",\"projection_60m\",\"projection_delta_pct\",\n","                                \"trend_short\",\"trend_mid\",\"trend_long\",\"eta_1m\",\"eta_15m\",\"eta_60m\",\n","                                \"sent_tag\",\"sent_level\",\"risk_level\",\"confidence_0_1\",\"recommendation\"])\n","                w.writerow([snap['ts_utc'], pair,\n","                            f\"{snap['price_now']:.2f}\", f\"{snap['projection_60m']:.2f}\",\n","                            f\"{snap['projection_delta_pct']:.3f}\", trend_short, trend_mid, trend_long,\n","                            f\"{(eta_1 if eta_1 is not None else float('nan')):.2f}\",\n","                            f\"{(eta_15 if eta_15 is not None else float('nan')):.2f}\",\n","                            f\"{(eta_60 if eta_60 is not None else float('nan')):.2f}\",\n","                            sent_tag, f\"{sent_lvl:+.2f}\", risk_level, f\"{conf:.3f}\", rec])\n","        except Exception as e:\n","            _REG[\"last_error\"] = f\"snapshot_csv: {e}\"\n","\n","    _REG[\"last_snapshot\"] = snap\n","    return snap\n","\n","# ============================== Notificaciones (opcionales) ==============================\n","class AsyncNotifier:\n","    def __init__(self):\n","        self.tg_token = os.getenv(\"TELEGRAM_BOT_TOKEN\",\"\").strip()\n","        self.tg_chat  = os.getenv(\"TELEGRAM_CHAT_ID\",\"\").strip()\n","        self.discord  = os.getenv(\"DISCORD_WEBHOOK_URL\",\"\").strip()\n","        self.webhook  = os.getenv(\"GENERIC_WEBHOOK_URL\",\"\").strip()\n","        self.min_period_s = _env_i(\"ALERT_MIN_PERIOD_S\", 60)\n","        self.last_sent = {}\n","    async def _post(self, url, payload):\n","        if not url: return\n","        try:\n","            import aiohttp\n","            async with aiohttp.ClientSession() as s:\n","                async with s.post(url, json=payload, timeout=10) as r:\n","                    await r.text()\n","        except Exception: pass\n","    async def send(self, title: str, text: str, data: dict | None = None, key: str | None = None):\n","        now=time.time()\n","        if key:\n","            ts=self.last_sent.get(key,0)\n","            if now-ts < self.min_period_s: return\n","            self.last_sent[key]=now\n","        payload={\"title\":title,\"text\":text,\"ts\":utc_now_iso(),\"data\":data or {}}\n","        if self.discord: await self._post(self.discord, {\"content\": f\"*{title}*\\n{text}\\n```json\\n{json.dumps(data or {}, ensure_ascii=False)}\\n```\"})\n","        if self.webhook: await self._post(self.webhook, payload)\n","        if self.tg_token and self.tg_chat:\n","            try:\n","                import aiohttp\n","                async with aiohttp.ClientSession() as s:\n","                    msg=f\"{title}\\n{text}\\n`{json.dumps(data or {}, ensure_ascii=False)}`\"\n","                    params={\"chat_id\": self.tg_chat, \"text\": msg, \"parse_mode\": \"Markdown\"}\n","                    await s.post(f\"https://api.telegram.org/bot{self.tg_token}/sendMessage\", data=params, timeout=10)\n","            except Exception: pass\n","\n","_NOTIF = globals().get(\"_NOTIF\") or AsyncNotifier()\n","globals()[\"_NOTIF\"] = _NOTIF\n","\n","def _trend_key(snap: Dict[str, Any]) -> str:\n","    return f\"{snap.get('trend_short')}/{snap.get('trend_mid')}/{snap.get('trend_long')}\"\n","\n","def _eta_min_list(snap: Dict[str, Any]) -> List[float]:\n","    eta = snap.get(\"eta_cross_min\", {}); out=[]\n","    for k in (\"1m\",\"15m\",\"60m\"):\n","        v = eta.get(k)\n","        try:\n","            if v is None: continue\n","            out.append(float(v))\n","        except Exception: pass\n","    return out\n","\n","async def _maybe_alert(prev: Optional[Dict[str, Any]], snap: Dict[str, Any]):\n","    if not snap: return\n","    pair = snap.get(\"pair\", \"XXBTZUSD\")\n","    try:\n","        prev_tr=_trend_key(prev or {}); curr_tr=_trend_key(snap)\n","        if prev is None or curr_tr!=prev_tr:\n","            await _NOTIF.send(f\"⚡ Tendencia cambiada [{pair}]\", f\"{prev_tr or '—'} → {curr_tr}\", data={\"snapshot\": snap}, key=\"trend_change\")\n","    except Exception: pass\n","    try:\n","        thr=_env_f(\"PROJ_ALERT_PCT\", 0.8)\n","        dp=abs(float(snap.get(\"projection_delta_pct\", 0.0)))\n","        if dp >= thr:\n","            await _NOTIF.send(f\"🎯 Proyección fuerte {dp:+.2f}% [{pair}]\",\n","                              f\"Δ60m ≥ {thr:.2f}% | rec: {snap.get('recommendation')}\",\n","                              data={\"snapshot\": snap}, key=\"projection\")\n","    except Exception: pass\n","    try:\n","        mins=_eta_min_list(snap) or [9999.0]\n","        if min(mins) < _env_i(\"ETA_ALERT_MIN\", 10):\n","            await _NOTIF.send(f\"⏳ Cruce EMA inminente < {_env_i('ETA_ALERT_MIN',10)}m [{pair}]\",\n","                              f\"ETA_min={min(mins):.1f}m | {_trend_key(snap)}\",\n","                              data={\"snapshot\": snap}, key=\"eta_cross\")\n","    except Exception: pass\n","    try:\n","        prev_s=(prev or {}).get(\"sentiment\",{}).get(\"tag\",\"-\")\n","        curr_s=snap.get(\"sentiment\",{}).get(\"tag\",\"-\")\n","        if prev is None or curr_s!=prev_s:\n","            await _NOTIF.send(f\"🧠 Sentimiento → {curr_s} [{pair}]\",\n","                              f\"antes: {prev_s or '—'} | nivel: {snap.get('sentiment',{}).get('level',0)}\",\n","                              data={\"snapshot\": snap}, key=\"sentiment\")\n","    except Exception: pass\n","\n","# ============================== Mini Monitor (cada ~5m) ==============================\n","def _term_cols():\n","    try: return shutil.get_terminal_size((100,30)).columns\n","    except Exception: return 100\n","\n","async def _mini_monitor_loop():\n","    cols=_term_cols(); bar=\"─\"*max(40, min(120, cols-4))\n","    while True:\n","        try:\n","            snap=_REG.get(\"last_snapshot\")\n","            if snap:\n","                px=snap.get(\"price_now\"); pdp=snap.get(\"projection_delta_pct\"); rec=snap.get(\"recommendation\")\n","                t1,t2,t3=snap.get(\"trend_short\"), snap.get(\"trend_mid\"), snap.get(\"trend_long\")\n","                senti=snap.get(\"sentiment\",{}); st,sl=senti.get(\"tag\",\"-\"), float(senti.get(\"level\",0.0))\n","                conf=snap.get(\"confidence_0_1\",0.0); eta=snap.get(\"eta_cross_min\",{})\n","                eta1,eta15,eta60 = eta.get(\"1m\"), eta.get(\"15m\"), eta.get(\"60m\")\n","                fmt=lambda v: f\"{v:.1f}m\" if isinstance(v,(int,float)) else \"—\"\n","                print(f\"\\n{bar}\\n🕒 {snap.get('ts_utc','')} | 💵 {px:,.2f} | 🎯 Δ60m {pdp:+.2f}% | \"\n","                      f\"📊 {t1}/{t2}/{t3} | 🧠 {st}({sl:+.2f}) | 🔐 conf {conf:.2f}\")\n","                print(f\"⏳ ETA: 1m={fmt(eta1)} · 15m={fmt(eta15)} · 60m={fmt(eta60)}  | 💡 {rec}\")\n","                print(bar)\n","        except Exception as e:\n","            _REG[\"last_error\"]=f\"mini_monitor: {e}\"\n","        await asyncio.sleep(_env_i(\"MINIMONITOR_PERIOD_S\", 300))\n","\n","# ============================== Autorun + Watchdog + Guard ==============================\n","class AutorunManager:\n","    def __init__(self):\n","        self.tasks: Dict[str, asyncio.Task] = {}\n","        self.heartbeat=_REG[\"heartbeat\"]\n","    async def watchdog(self, api, core, ex, period_s: int):\n","        print(\"🛡️  Watchdog resiliente activo.\")\n","        while True:\n","            try:\n","                last=self.heartbeat.get(\"ts\",0)\n","                if time.time() - last > period_s*3 + 15:\n","                    print(\"♻️  Watchdog: reinicio de loop por inactividad.\")\n","                    t=self.tasks.get(\"main_loop\")\n","                    if t and not t.cancelled(): t.cancel()\n","                    self.tasks[\"main_loop\"] = asyncio.create_task(\n","                        globals()[\"run_loop\"](api=api, trading_core=core, ultra_executor=ex,\n","                                              period_s=period_s, _heartbeat=self.heartbeat),\n","                        name=\"ttdvi_main_loop\"\n","                    )\n","            except Exception as e:\n","                _REG[\"last_error\"]=f\"watchdog: {e}\"\n","            await asyncio.sleep(10)\n","\n","AUTORUN = globals().get(\"AUTORUN\") or AutorunManager()\n","globals()[\"AUTORUN\"] = AUTORUN\n","\n","# =========================================================================================\n","# ====================== PARCHE PERMANENTE — HEARTBEAT + REG SEGURO =======================\n","# =========================================================================================\n","import time, asyncio, os, signal\n","from datetime import datetime, timezone, timedelta\n","\n","# --- Registro global seguro / idempotente ---\n","_REG = globals().setdefault(\"_TTDVI_REG\", {\n","    **globals().get(\"_TTDVI_REG\", {}),\n","    \"ultra_started\": globals().get(\"_TTDVI_REG\", {}).get(\"ultra_started\", False),\n","    \"shutdown_in_progress\": globals().get(\"_TTDVI_REG\", {}).get(\"shutdown_in_progress\", False),\n","    \"started_at\": globals().get(\"_TTDVI_REG\", {}).get(\"started_at\", time.time()),\n","})\n","\n","def _default_heartbeat(tag: str = \"main_loop\"):\n","    \"\"\"Heartbeat mínimo y resistente (no lanza excepciones).\"\"\"\n","    try:\n","        now = time.time()\n","        _REG[\"last_heartbeat_at\"] = now\n","        _REG[\"heartbeat_count\"] = _REG.get(\"heartbeat_count\", 0) + 1\n","        hb_map = _REG.setdefault(\"heartbeats\", {})\n","        hb_map[tag] = now\n","        return now\n","    except Exception:\n","        # Nunca romper el caller por el heartbeat\n","        return time.time()\n","\n","# Garantiza que exista un callable en _REG[\"heartbeat\"]\n","if not callable(_REG.get(\"heartbeat\")):\n","    _REG[\"heartbeat\"] = _default_heartbeat\n","\n","# --- AUTORUN/tareas seguro ---\n","class _AutoRunSentinel:\n","    def __init__(self):\n","        self.tasks = {}\n","\n","    async def watchdog(self, api, core, ex, period_s: int = 60):\n","        \"\"\"Watchdog simple que marca latido y puede chequear frescura.\"\"\"\n","        # Evita periodos absurdos\n","        per = max(5, int(period_s) if isinstance(period_s, int) else 60)\n","        while not _REG.get(\"shutdown_in_progress\"):\n","            try:\n","                _default_heartbeat(\"watchdog\")\n","            except Exception:\n","                pass\n","            await asyncio.sleep(per)\n","\n","AUTORUN = globals().get(\"AUTORUN\")\n","if not isinstance(AUTORUN, _AutoRunSentinel):\n","    AUTORUN = _AutoRunSentinel()\n","globals()[\"AUTORUN\"] = AUTORUN\n","AUTORUN.tasks = getattr(AUTORUN, \"tasks\", {}) or {}\n","\n","# --- Helpers de entorno ya usados en tu código (no modifican firmas) ---\n","def _env_b(k: str, default: bool = False) -> bool:\n","    v = os.getenv(k, str(default)).strip().lower()\n","    return v in (\"1\", \"true\", \"yes\", \"y\", \"on\")\n","\n","def _env_i(k: str, default: int = 60) -> int:\n","    try:\n","        return int(os.getenv(k, str(default)).strip())\n","    except Exception:\n","        return default\n","\n","# =========================================================================================\n","# ============================== Startup / Orquestador (FIX) ===============================\n","# =========================================================================================\n","\n","async def _startup_components():\n","    # API\n","    try:\n","        api = auto_api()\n","    except Exception:\n","        class _FallbackAPI:\n","            async def get_price(self, pair=\"XXBTZUSD\"): return 30000.0\n","            async def ticker_price(self, pair=\"XXBTZUSD\"): return 30000.0\n","            async def query_public(self, *a, **k): return {}\n","        api = _FallbackAPI()\n","    _REG[\"api\"] = api\n","\n","    # Core + Riesgo + Executor\n","    core_cls = globals().get(\"QuantumTradingCore\"); Risk = globals().get(\"GestorRiesgo\"); Exec = globals().get(\"UltraOrderExecutor\")\n","    if core_cls is None or Risk is None or Exec is None:\n","        raise RuntimeError(\"Faltan QuantumTradingCore/GestorRiesgo/UltraOrderExecutor en el entorno.\")\n","    core = core_cls(api)\n","    if hasattr(core, \"initialize\"):\n","        r = core.initialize();  await r if asyncio.iscoroutine(r) else None\n","    risk = Risk(api);  rr = getattr(risk, \"initialize\", lambda: True)();  await rr if asyncio.iscoroutine(rr) else None\n","    ex = Exec(api, risk, predictor=getattr(core, \"predictor_alcista\", None))\n","    core.order_executor = ex\n","    # Modo\n","    if hasattr(ex, \"set_mode\"): ex.set_mode(\"REAL\" if _env_b(\"RUN_LIVE\", False) or os.getenv(\"RUN_MODE\",\"DEMO\").upper()==\"REAL\" else \"DEMO\")\n","    if hasattr(ex, \"set_live\"): ex.set_live(_env_b(\"RUN_LIVE\", False) or os.getenv(\"RUN_MODE\",\"DEMO\").upper()==\"REAL\")\n","\n","    _REG[\"core\"] = core; _REG[\"executor\"] = ex\n","\n","    # Centro Autónomo (si disponible)\n","    try:\n","        if \"iniciar_centro_historial\" in globals():\n","            await globals()[\"iniciar_centro_historial\"](\n","                pair=os.getenv(\"PAR_TRADING\",\"XXBTZUSD\"),\n","                interval=int(os.getenv(\"INTERVAL\",\"1\") or \"1\"),\n","                api=api\n","            )\n","    except Exception as e:\n","        _REG[\"last_error\"] = f\"centro: {e}\"\n","\n","    # Predictores enchufados si existe helper\n","    try:\n","        if \"_ensure_predictors_wired\" in globals():\n","            await globals()[\"_ensure_predictors_wired\"](api, core)\n","    except Exception as e:\n","        _REG[\"last_error\"] = f\"wire: {e}\"\n","\n","    # Enforce objetivo universal si existe\n","    try:\n","        if \"ObjetivoUniversal156\" in globals():\n","            globals()[\"ObjetivoUniversal156\"]().enforce_on_executor(ex)\n","    except Exception as e:\n","        _REG[\"last_error\"] = f\"obj156: {e}\"\n","\n","    return api, core, ex\n","\n","async def _live_resumen_loop(api, pair):\n","    per = _env_i(\"LIVE_PERIOD_S\", _env_i(\"VIZ_PERIOD_S\", 60))\n","    print(f\"🎯 Live resumen cada {per}s — {pair}\")\n","    prev = None\n","    while not _REG.get(\"shutdown_in_progress\"):\n","        t0 = time.time()\n","        try:\n","            snap = await resumen_vivo_100_real(api=api, pair=pair, publish=True, to_csv=True)\n","            await _maybe_alert(prev, snap); prev = snap\n","            # hook de heartbeat externo opcional\n","            if \"TTDVI_heartbeat\" in globals() and callable(globals()[\"TTDVI_heartbeat\"]):\n","                try: globals()[\"TTDVI_heartbeat\"](\"live_resumen\")\n","                except Exception: pass\n","            # latido local para contadores\n","            _default_heartbeat(\"live_resumen\")\n","        except Exception as e:\n","            _REG[\"last_error\"] = f\"live: {e}\"\n","        dt = time.time() - t0\n","        await asyncio.sleep(max(1.0, per - dt))\n","\n","async def ultra_orquestador_produccion():\n","    if _REG.get(\"ultra_started\"):\n","        print(\"ℹ️ Orquestador ya estaba iniciado; no se duplica.\"); return\n","    _REG[\"ultra_started\"] = True\n","\n","    # Señales para apagado limpio\n","    try:\n","        loop = asyncio.get_event_loop()\n","        loop.add_signal_handler(getattr(signal, \"SIGINT\"),\n","            lambda: asyncio.create_task(_graceful_shutdown(_REG.get(\"api\"), _REG.get(\"core\"), _REG.get(\"executor\"))))\n","        loop.add_signal_handler(getattr(signal, \"SIGTERM\"),\n","            lambda: asyncio.create_task(_graceful_shutdown(_REG.get(\"api\"), _REG.get(\"core\"), _REG.get(\"executor\"))))\n","    except Exception:\n","        pass\n","\n","    api, core, ex = await _startup_components()\n","\n","    # Dispara una corrida inicial si tienes run_once\n","    try:\n","        if \"run_once\" in globals():\n","            await asyncio.wait_for(globals()[\"run_once\"](api=api, trading_core=core, ultra_executor=ex), timeout=25)\n","    except Exception as e:\n","        _REG[\"last_error\"] = f\"run_once: {e}\"\n","\n","    # Lanza loop principal si existe run_loop (inyectando heartbeat seguro)\n","    period_s = _env_i(\"VIZ_PERIOD_S\", 60)\n","    _hb = _REG.get(\"heartbeat\", _default_heartbeat)  # <— FIX CENTRAL\n","    if \"run_loop\" in globals():\n","        AUTORUN.tasks[\"main_loop\"] = asyncio.create_task(\n","            globals()[\"run_loop\"](api=api, trading_core=core, ultra_executor=ex, period_s=period_s, _heartbeat=_hb),\n","            name=\"ttdvi_main_loop\"\n","        )\n","\n","    # Watchdog y mini-monitor\n","    _REG[\"watchdog_task\"] = asyncio.create_task(AUTORUN.watchdog(api, core, ex, period_s), name=\"ttdvi_watchdog\")\n","    if not _REG.get(\"mini_monitor_task\") or _REG[\"mini_monitor_task\"].done():\n","        _REG[\"mini_monitor_task\"] = asyncio.create_task(_mini_monitor_loop(), name=\"mini_monitor\")\n","\n","    # Live resumen / alertas\n","    _REG[\"live_task\"] = asyncio.create_task(_live_resumen_loop(api, os.getenv(\"PAR_TRADING\",\"XXBTZUSD\")), name=\"live_resumen\")\n","\n","    # Deadline supervisor opcional\n","    end_dt = None\n","    try:\n","        end_at = os.getenv(\"TTDVI_END_AT_UTC\",\"\").strip()\n","        dur_m = _env_i(\"TTDVI_DURATION_MIN\", 0)\n","        if end_at:\n","            try:\n","                end_dt = datetime.fromisoformat(end_at.replace(\"Z\",\"+00:00\")).astimezone(timezone.utc)\n","            except Exception:\n","                end_dt = None\n","        elif dur_m > 0:\n","            end_dt = datetime.now(timezone.utc) + timedelta(minutes=dur_m)\n","    except Exception:\n","        end_dt = None\n","\n","    if end_dt:\n","        async def _deadline_supervisor():\n","            print(f\"⏳ Supervisor deadline → fin @ {end_dt.isoformat()}\")\n","            while datetime.now(timezone.utc) < end_dt and not _REG.get(\"shutdown_in_progress\"):\n","                await asyncio.sleep(5)\n","            await _graceful_shutdown(api=_REG.get(\"api\"), core=_REG.get(\"core\"), executor=_REG.get(\"executor\"))\n","        _REG[\"deadline_task\"] = asyncio.create_task(_deadline_supervisor(), name=\"deadline_supervisor\")\n","\n","    print(\"📡 Visualización + trading en vivo activo (loop + watchdog + live + monitor).\")\n","\n","    # NEVER-STOP guard: relanza tareas críticas si mueren\n","    async def _never_stop_guard():\n","        while _env_b(\"TTDVI_NEVER_STOP\", True) and not _REG.get(\"shutdown_in_progress\"):\n","            for key, maker in (\n","                (\"main_loop\", lambda: \"run_loop\" in globals() and asyncio.create_task(\n","                    globals()[\"run_loop\"](api=api, trading_core=core, ultra_executor=ex,\n","                                          period_s=period_s, _heartbeat=_REG.get(\"heartbeat\", _default_heartbeat)),\n","                    name=\"ttdvi_main_loop\")),\n","                (\"watchdog_task\", lambda: asyncio.create_task(AUTORUN.watchdog(api, core, ex, period_s), name=\"ttdvi_watchdog\")),\n","                (\"live_task\", lambda: asyncio.create_task(_live_resumen_loop(api, os.getenv(\"PAR_TRADING\",\"XXBTZUSD\")), name=\"live_resumen\")),\n","            ):\n","                t = AUTORUN.tasks.get(\"main_loop\") if key==\"main_loop\" else _REG.get(key)\n","                if (t is None or t.done()) and not _REG.get(\"shutdown_in_progress\"):\n","                    print(f\"♻️ Guard: relanzando {key}.\")\n","                    newt = maker()\n","                    if key==\"main_loop\": AUTORUN.tasks[\"main_loop\"] = newt\n","                    else: _REG[key] = newt\n","            await asyncio.sleep(5)\n","\n","    asyncio.create_task(_never_stop_guard(), name=\"never_stop_guard\")\n","\n","\n","# ============================== Apagado limpio ==============================\n","async def _graceful_shutdown(api=None, core=None, executor=None):\n","    if _REG.get(\"shutdown_in_progress\"): return\n","    _REG[\"shutdown_in_progress\"]=True\n","    print(\"\\n🔴 Apagado limpio en curso…\")\n","    # Cancela tasks\n","    try:\n","        for key,t in list(AUTORUN.tasks.items()):\n","            if t and not t.done(): t.cancel()\n","        for key in (\"live_task\",\"mini_monitor_task\",\"deadline_task\",\"watchdog_task\"):\n","            t=_REG.get(key)\n","            if t and not t.done(): t.cancel()\n","    except Exception: pass\n","    # Venta segura opcional\n","    try:\n","        if executor and hasattr(executor,\"execute_safe_sale\"):\n","            from decimal import Decimal\n","            await executor.execute_safe_sale(Decimal('0'))\n","    except Exception: pass\n","    print(\"✅ Apagado limpio completado.\")\n","    _REG[\"shutdown_in_progress\"]=False\n","\n","# ============================== Autoarranque seguro ==============================\n","def _in_notebook():\n","    try:\n","        from IPython import get_ipython\n","        sh=get_ipython()\n","        return bool(sh) and sh.__class__.__name__ in (\"ZMQInteractiveShell\",\"TerminalInteractiveShell\",\"Shell\")\n","    except Exception:\n","        return False\n","\n","if _env_b(\"ULTRA_AUTOSTART\", True):\n","    try:\n","        loop = asyncio.get_event_loop()\n","        if loop.is_running():\n","            loop.create_task(ultra_orquestador_produccion(), name=\"ttdvi_ultra_orq\")\n","            print(\"🚀 ULTRA_AUTOSTART activado (loop existente).\")\n","        else:\n","            loop.run_until_complete(ultra_orquestador_produccion())\n","    except RuntimeError:\n","        asyncio.run(ultra_orquestador_produccion())\n","\n","\n","\n","# =========================================================================================\n","# ================== ULTRAMATRIZ CUÁNTICA TTDVI156 — UNIFICADO (DARWIN v4) ================\n","# =========================================================================================\n","# CON BRIDGE PIPELINE BTC-SIGNALS INTEGRADO\n","# Contiene:\n","# - ResultadosTiempoReal (BTC + índices + señales ORB + gráficos + persistencia)\n","# - SistemaEntidadesBTC (whales/miners/exchanges + patrones + alertas)\n","# - ResumenUnificadoTiempoReal (integración completa + score + recomendación)\n","# - PipelineBridge (consumo Kafka btc-signals en tiempo real)\n","# - SilentMove Boosts (extensiones no invasivas)\n","# - Hooks DARWIN v4 completos\n","# =========================================================================================\n","\n","from __future__ import annotations\n","import os, json, math, asyncio, logging, time, random\n","from typing import Dict, List, Any, Optional, Tuple, Callable\n","from dataclasses import dataclass\n","from enum import Enum\n","from pathlib import Path\n","from decimal import Decimal\n","from datetime import datetime, timezone, timedelta\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import aiohttp\n","\n","# ===================== KAFKA BRIDGE COMPONENT =====================\n","try:\n","    from aiokafka import AIOKafkaConsumer\n","    _KAFKA_AVAILABLE = True\n","except ImportError:\n","    _KAFKA_AVAILABLE = False\n","    print(\"⚠️ aiokafka no disponible. Instala con: pip install aiokafka\")\n","\n","# ========================== CONFIG GLOBAL + UTILIDADES ==========================\n","RUN_ROOT = Path(os.getenv(\"TTDVI_RUN_ROOT\", \"./run_ttdvi156\"))\n","DIR_GFX   = RUN_ROOT / \"resultados_graficos\"\n","DIR_LOGS  = RUN_ROOT / \"logs\"\n","DIR_STATE = RUN_ROOT / \"state\"\n","for d in (DIR_GFX, DIR_LOGS, DIR_STATE):\n","    d.mkdir(parents=True, exist_ok=True)\n","\n","logging.basicConfig(\n","    level=logging.INFO,\n","    format=\"%(asctime)s | %(name)s | %(levelname)s | %(message)s\"\n",")\n","\n","def utc_now_iso() -> str:\n","    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()\n","\n","def time_banner(tag: str = \"INFO\") -> str:\n","    return f\"\\n── {tag} @ {utc_now_iso()} ─────────────────────────────────────────\"\n","\n","# ===================== PIPELINE BRIDGE (KAFKA BTC-SIGNALS) =====================\n","class PipelineBridge:\n","    \"\"\"\n","    Bridge liviano para consumir señales normalizadas del PoC (Kafka) y\n","    volcarlas dentro de ULTRAMATRIZ (SistemaEntidadesBTC + ResumenUnificado).\n","    \"\"\"\n","    def __init__(\n","        self,\n","        unified_system,  # instancia de ResumenUnificadoTiempoReal\n","        kafka_bootstrap: str = None,\n","        topic_signals: str = None,\n","        on_signal_hook: Optional[Callable[[Dict[str, Any]], None]] = None,\n","    ):\n","        self.unified = unified_system\n","        self.kafka_bootstrap = kafka_bootstrap or os.getenv(\"KAFKA_BOOTSTRAP\", \"localhost:9092\")\n","        self.topic_signals = topic_signals or os.getenv(\"KAFKA_TOPIC_SIGNALS\", \"btc-signals\")\n","        self.on_signal_hook = on_signal_hook\n","        self._consumer = None\n","        self._running = False\n","        self.log = logging.getLogger(\"PIPELINE_BRIDGE\")\n","\n","        # Estado para boosts de silent moves\n","        self._silent_move_flags: List[Dict[str, Any]] = []\n","        self._last_silent_move_time: Optional[float] = None\n","\n","    async def _ensure_consumer(self):\n","        if not _KAFKA_AVAILABLE:\n","            self.log.warning(\"aiokafka no disponible - bridge en modo simulación\")\n","            return False\n","\n","        if self._consumer is None:\n","            try:\n","                self._consumer = AIOKafkaConsumer(\n","                    self.topic_signals,\n","                    bootstrap_servers=self.kafka_bootstrap,\n","                    enable_auto_commit=True,\n","                    auto_offset_reset=\"latest\",\n","                    value_deserializer=lambda v: v.decode(\"utf-8\"),\n","                )\n","                await self._consumer.start()\n","                return True\n","            except Exception as e:\n","                self.log.error(f\"Error iniciando Kafka consumer: {e}\")\n","                return False\n","        return True\n","\n","    async def start(self):\n","        if self._running:\n","            return\n","\n","        success = await self._ensure_consumer()\n","        if not success and not _KAFKA_AVAILABLE:\n","            self.log.info(\"Bridge en modo simulación - generando señales de prueba\")\n","\n","        self._running = True\n","        self.log.info(f\"🚀 PipelineBridge iniciado - Kafka: {self.kafka_bootstrap}, Topic: {self.topic_signals}\")\n","\n","        # Iniciar loop principal\n","        asyncio.create_task(self._loop())\n","\n","    async def stop(self):\n","        self._running = False\n","        try:\n","            if self._consumer:\n","                await self._consumer.stop()\n","        except Exception:\n","            pass\n","        self.log.info(\"🛑 PipelineBridge detenido\")\n","\n","    def _emit_alerta(self, tipo: str, severidad: str, mensaje: str, meta: Dict[str, Any]):\n","        \"\"\"Emite alerta al sistema unificado\"\"\"\n","        alerta = {\n","            \"id\": f\"bridge_{tipo}_{int(time.time())}\",\n","            \"tipo\": tipo,\n","            \"severidad\": severidad,\n","            \"mensaje\": mensaje,\n","            \"timestamp\": utc_now_iso(),\n","            \"fuente\": \"PIPELINE_POC\",\n","            \"meta\": meta or {},\n","        }\n","\n","        # Inserta en el sistema de entidades\n","        self.unified.sistema_entidades.alertas_activas.append(alerta)\n","\n","        # Log de alerta\n","        self.log.warning(f\"🚨 {severidad}: {mensaje}\")\n","\n","    def _process_silent_move(self, payload: Dict[str, Any]):\n","        \"\"\"Procesa señal de movimiento silencioso\"\"\"\n","        try:\n","            sum_btc = float(payload.get(\"sum_btc\", 0))\n","            eta_seconds = int(payload.get(\"estimated_time_to_peak_seconds\", 0))\n","\n","            # Registrar flag para boosts\n","            silent_move = {\n","                \"timestamp\": time.time(),\n","                \"sum_btc\": sum_btc,\n","                \"eta_seconds\": eta_seconds,\n","                \"boost\": min(10.0, max(3.0, sum_btc / 50.0))  # +3 a +10 puntos\n","            }\n","\n","            self._silent_move_flags.append(silent_move)\n","            self._last_silent_move_time = time.time()\n","\n","            # Limpiar flags antiguos (más de 5 minutos)\n","            current_time = time.time()\n","            self._silent_move_flags = [\n","                flag for flag in self._silent_move_flags\n","                if current_time - flag[\"timestamp\"] < 300\n","            ]\n","\n","            # Emitir alerta\n","            eta_minutes = eta_seconds // 60\n","            self._emit_alerta(\n","                tipo=\"SILENT_MOVE_DETECTADO\",\n","                severidad=\"ALTA\",\n","                mensaje=f\"🚨 MOVIMIENTO SILENCIOSO: {sum_btc:.1f} BTC - ETA pico: {eta_minutes} min\",\n","                meta=payload\n","            )\n","\n","        except Exception as e:\n","            self.log.error(f\"Error procesando silent move: {e}\")\n","\n","    def _process_trade_event(self, payload: Dict[str, Any]):\n","        \"\"\"Procesa evento de trading\"\"\"\n","        try:\n","            volume_btc = float(payload.get(\"sum_btc\", 0))\n","            price = float(payload.get(\"avg_price\", 0))\n","\n","            if volume_btc > 100:  # Volumen significativo\n","                self._emit_alerta(\n","                    tipo=\"HIGH_VOLUME_TRADE\",\n","                    severidad=\"MEDIA\",\n","                    mensaje=f\"Alto volumen spot: {volume_btc:.1f} BTC @ ${price:,.0f}\",\n","                    meta=payload\n","                )\n","\n","        except Exception as e:\n","            self.log.error(f\"Error procesando trade event: {e}\")\n","\n","    def _process_issuance_event(self, payload: Dict[str, Any]):\n","        \"\"\"Procesa evento de mint/burn\"\"\"\n","        try:\n","            amount = float(payload.get(\"sum_btc\", 0))\n","            event_type = payload.get(\"event_type\", \"unknown\")\n","\n","            if abs(amount) > 500:  # Mint/burn significativo\n","                action = \"MINT\" if amount > 0 else \"BURN\"\n","                self._emit_alerta(\n","                    tipo=f\"STABLECOIN_{action}\",\n","                    severidad=\"MEDIA\",\n","                    mensaje=f\"{action} establecoin: {abs(amount):.0f} BTC equivalente\",\n","                    meta=payload\n","                )\n","\n","        except Exception as e:\n","            self.log.error(f\"Error procesando issuance event: {e}\")\n","\n","    def _apply_signal(self, payload: Dict[str, Any]):\n","        \"\"\"\n","        Aplica señal del pipeline al sistema unificado\n","        \"\"\"\n","        try:\n","            # Hook opcional del usuario\n","            if self.on_signal_hook:\n","                self.on_signal_hook(payload)\n","\n","            # Actualizar métricas de estado\n","            estado = self.unified.sistema_entidades.estado_mercado or {}\n","            total_volume = float(estado.get(\"volumen_total_24h\", 0.0))\n","            estado[\"volumen_total_24h\"] = total_volume + float(payload.get(\"sum_btc\", 0.0))\n","            estado[\"timestamp\"] = utc_now_iso()\n","            self.unified.sistema_entidades.estado_mercado = estado\n","\n","            # Procesar según tipo de evento\n","            if payload.get(\"is_silent_move\"):\n","                self._process_silent_move(payload)\n","            elif payload.get(\"event_type\") == \"trade\":\n","                self._process_trade_event(payload)\n","            elif payload.get(\"event_type\") in [\"mint\", \"burn\"]:\n","                self._process_issuance_event(payload)\n","            else:\n","                # Evento genérico\n","                self._emit_alerta(\n","                    tipo=\"PIPELINE_SIGNAL\",\n","                    severidad=\"BAJA\",\n","                    mensaje=f\"Señal pipeline: {payload.get('sum_btc', 0):.1f} BTC\",\n","                    meta=payload\n","                )\n","\n","        except Exception as e:\n","            self.log.warning(f\"Error aplicando señal: {e}\")\n","\n","    def get_silent_move_boost(self) -> float:\n","        \"\"\"Calcula boost actual por movimientos silenciosos\"\"\"\n","        current_time = time.time()\n","\n","        # Limpiar flags antiguos\n","        self._silent_move_flags = [\n","            flag for flag in self._silent_move_flags\n","            if current_time - flag[\"timestamp\"] < 300  # 5 minutos\n","        ]\n","\n","        if not self._silent_move_flags:\n","            return 0.0\n","\n","        # Boost decay basado en tiempo\n","        total_boost = 0.0\n","        for flag in self._silent_move_flags:\n","            time_elapsed = current_time - flag[\"timestamp\"]\n","            decay = max(0, 1 - (time_elapsed / 300))  # Decae linealmente en 5 min\n","            total_boost += flag[\"boost\"] * decay\n","\n","        return min(total_boost, 15.0)  # Máximo 15 puntos\n","\n","    def has_recent_silent_moves(self) -> bool:\n","        \"\"\"Verifica si hay movimientos silenciosos recientes\"\"\"\n","        if not self._silent_move_flags:\n","            return False\n","        current_time = time.time()\n","        return any(current_time - flag[\"timestamp\"] < 300 for flag in self._silent_move_flags)\n","\n","    async def _loop(self):\n","        \"\"\"Loop principal del bridge\"\"\"\n","        try:\n","            if self._consumer:\n","                # Modo real con Kafka\n","                self.log.info(\"🔌 Conectado a Kafka - esperando señales...\")\n","                async for msg in self._consumer:\n","                    if not self._running:\n","                        break\n","                    if msg and msg.value:\n","                        try:\n","                            payload = json.loads(msg.value)\n","                            # Si viene como JSON string dentro de JSON\n","                            if isinstance(payload, str):\n","                                payload = json.loads(payload)\n","                            self._apply_signal(payload)\n","                        except Exception as e:\n","                            self.log.warning(f\"Error decodificando mensaje: {e}\")\n","            else:\n","                # Modo simulación\n","                self.log.info(\"🎭 Modo simulación - generando señales de prueba\")\n","                while self._running:\n","                    # Generar señal de prueba ocasionalmente\n","                    if random.random() < 0.1:  # 10% de probabilidad cada iteración\n","                        signal_type = random.choice([\"silent_move\", \"trade\", \"issuance\"])\n","\n","                        if signal_type == \"silent_move\":\n","                            payload = {\n","                                \"symbol\": \"BTCUSDT\",\n","                                \"sum_btc\": random.uniform(200, 1000),\n","                                \"avg_price\": random.uniform(50000, 70000),\n","                                \"is_silent_move\": True,\n","                                \"estimated_time_to_peak_seconds\": random.randint(180, 600)\n","                            }\n","                        elif signal_type == \"trade\":\n","                            payload = {\n","                                \"symbol\": \"BTCUSDT\",\n","                                \"sum_btc\": random.uniform(50, 500),\n","                                \"avg_price\": random.uniform(50000, 70000),\n","                                \"event_type\": \"trade\"\n","                            }\n","                        else:\n","                            payload = {\n","                                \"symbol\": \"USDT\",\n","                                \"sum_btc\": random.uniform(100, 1000) * random.choice([1, -1]),\n","                                \"event_type\": random.choice([\"mint\", \"burn\"])\n","                            }\n","\n","                        self._apply_signal(payload)\n","\n","                    await asyncio.sleep(10)  # Verificar cada 10 segundos\n","\n","        except asyncio.CancelledError:\n","            pass\n","        except Exception as e:\n","            self.log.error(f\"Error en loop del bridge: {e}\")\n","        finally:\n","            await self.stop()\n","\n","# ===================== SISTEMA DE RESULTADOS EN TIEMPO REAL =====================\n","class ResultadosTiempoReal:\n","    \"\"\"\n","    Sistema de generación y visualización de resultados en tiempo real\n","    para ULTRAMATRIZ CUÁNTICA TTDVI156\n","    \"\"\"\n","    def __init__(self, run_root: str | Path = RUN_ROOT):\n","        self.run_root = Path(run_root)\n","        self.resultados_dir = DIR_GFX\n","        self.logs_dir = DIR_LOGS\n","        self.state_dir = DIR_STATE\n","\n","        # Estado del sistema\n","        self.ultima_actualizacion: Optional[datetime] = None\n","        self.estado_mercado: Dict[str, Any] = {}\n","        self.señales_activas: Dict[str, Any] = {}\n","        self.metricas_performace: Dict[str, Any] = {}\n","\n","        # Sesión HTTP compartida (cerrable por hook)\n","        self._http_session: Optional[aiohttp.ClientSession] = None\n","\n","        # Logger\n","        self.log = logging.getLogger(\"RESULTADOS_TIEMPO_REAL\")\n","\n","    async def _get_session(self) -> aiohttp.ClientSession:\n","        if self._http_session is None or self._http_session.closed:\n","            timeout = aiohttp.ClientTimeout(total=15)\n","            self._http_session = aiohttp.ClientSession(timeout=timeout)\n","        return self._http_session\n","\n","    async def close(self):\n","        if self._http_session and not self._http_session.closed:\n","            await self._http_session.close()\n","\n","    async def obtener_datos_mercado_en_vivo(self) -> Dict[str, Any]:\n","        \"\"\"Obtiene datos de mercado en tiempo real desde múltiples fuentes\"\"\"\n","        datos_mercado = {\n","            \"timestamp\": utc_now_iso(),\n","            \"btc\": {},\n","            \"indices\": {},\n","            \"metricas_globales\": {}\n","        }\n","        try:\n","            # BTC\n","            precio_btc = await self._obtener_precio_btc_kraken()\n","            datos_mercado[\"btc\"] = {\n","                \"precio_actual\": precio_btc,\n","                \"cambio_24h\": await self._obtener_cambio_24h_btc(),\n","                \"volumen_24h\": await self._obtener_volumen_btc(),\n","                \"dominancia\": await self._obtener_dominancia_btc()\n","            }\n","            # Índices (simulados)\n","            datos_mercado[\"indices\"] = {\n","                \"US500\": await self._obtener_datos_indice(\"US500\"),\n","                \"US30\": await self._obtener_datos_indice(\"US30\"),\n","                \"NAS100\": await self._obtener_datos_indice(\"NAS100\"),\n","                \"DAX\": await self._obtener_datos_indice(\"DAX\")\n","            }\n","            # Métricas globales\n","            datos_mercado[\"metricas_globales\"] = {\n","                \"miedo_codicia\": await self._calcular_indice_miedo_codicia(),\n","                \"volatilidad_mercado\": await self._calcular_volatilidad_global(),\n","                \"correlacion_activos\": await self._calcular_correlaciones()\n","            }\n","        except Exception as e:\n","            self.log.error(f\"Error obteniendo datos mercado: {e}\")\n","        return datos_mercado\n","\n","    async def _obtener_precio_btc_kraken(self) -> float:\n","        \"\"\"Obtiene precio BTC desde Kraken API (fallback simulado).\"\"\"\n","        try:\n","            url = \"https://api.kraken.com/0/public/Ticker\"\n","            params = {\"pair\": \"XBTUSD\"}\n","            session = await self._get_session()\n","            async with session.get(url, params=params) as resp:\n","                data = await resp.json()\n","                if not data.get(\"error\"):\n","                    return float(data[\"result\"][\"XXBTZUSD\"][\"c\"][0])\n","        except Exception as e:\n","            self.log.warning(f\"Error Kraken API: {e}\")\n","        # Fallback seguro\n","        return 50000 + (np.random.random() - 0.5) * 2000\n","\n","    async def _obtener_cambio_24h_btc(self) -> float:\n","        return (np.random.random() - 0.5) * 10  # -5%..+5%\n","\n","    async def _obtener_volumen_btc(self) -> float:\n","        return 25_000_000_000 + (np.random.random() - 0.5) * 5_000_000_000\n","\n","    async def _obtener_dominancia_btc(self) -> float:\n","        return 48.0 + (np.random.random() - 0.5) * 4\n","\n","    async def _obtener_datos_indice(self, indice: str) -> Dict[str, float]:\n","        bases = {\"US500\": 5000, \"US30\": 35000, \"NAS100\": 15000, \"DAX\": 16000}\n","        base = bases.get(indice, 10000)\n","        vol = 0.02\n","        return {\n","            \"precio\": base * (1 + (np.random.random() - 0.5) * vol),\n","            \"cambio_diario\": (np.random.random() - 0.5) * 3,\n","            \"volumen\": base * 1_000_000 * np.random.random()\n","        }\n","\n","    async def _calcular_indice_miedo_codicia(self) -> float:\n","        return 50 + (np.random.random() - 0.5) * 40\n","\n","    async def _calcular_volatilidad_global(self) -> float:\n","        return 0.05 + np.random.random() * 0.1\n","\n","    async def _calcular_correlaciones(self) -> Dict[str, float]:\n","        return {\n","            \"btc_sp500\": 0.3 + (np.random.random() - 0.5) * 0.4,\n","            \"btc_oro\": -0.1 + (np.random.random() - 0.5) * 0.3,\n","            \"sp500_dolar\": -0.2 + (np.random.random() - 0.5) * 0.3,\n","        }\n","\n","    def analizar_señales_orb(self, datos_mercado: Dict) -> Dict[str, Any]:\n","        señales, indices = {}, [\"US500\", \"US30\", \"NAS100\", \"DAX\"]\n","        for indice in indices:\n","            precio = datos_mercado[\"indices\"][indice][\"precio\"]\n","            cambio = datos_mercado[\"indices\"][indice][\"cambio_diario\"]\n","            volumen = datos_mercado[\"indices\"][indice][\"volumen\"]\n","            fuerza_tendencia = abs(cambio) / 100\n","            confirmacion_volumen = min(volumen / 1_000_000, 1.0)\n","            if cambio > 0.5 and confirmacion_volumen > 0.7:\n","                señal, confianza = \"COMPRA_FUERTE\", 0.8\n","            elif cambio > 0.2:\n","                señal, confianza = \"COMPRA_MODERADA\", 0.6\n","            elif cambio < -0.5:\n","                señal, confianza = \"VENTA_FUERTE\", 0.75\n","            elif cambio < -0.2:\n","                señal, confianza = \"VENTA_MODERADA\", 0.55\n","            else:\n","                señal, confianza = \"NEUTRAL\", 0.5\n","            señales[indice] = {\n","                \"señal\": señal, \"confianza\": confianza, \"precio_actual\": precio,\n","                \"cambio_diario\": cambio, \"fuerza_tendencia\": fuerza_tendencia,\n","                \"timestamp\": utc_now_iso()\n","            }\n","        return señales\n","\n","    def analizar_btc_cuantico(self, datos_mercado: Dict) -> Dict[str, Any]:\n","        precio_btc = datos_mercado[\"btc\"][\"precio_actual\"]\n","        cambio_24h = datos_mercado[\"btc\"][\"cambio_24h\"]\n","        volumen = datos_mercado[\"btc\"][\"volumen_24h\"]\n","        onda = self._calcular_funcion_onda(precio_btc, cambio_24h)\n","        ent = self._calcular_entanglement_temporal()\n","        tun = self._calcular_efecto_tunel(precio_btc)\n","        cons = self._consolidar_señal_cuantica(onda, ent, tun)\n","        return {\n","            \"precio_actual\": precio_btc,\n","            \"analisis_cuantico\": {\n","                \"funcion_onda\": onda,\n","                \"entanglement_temporal\": ent,\n","                \"efecto_tunel\": tun,\n","                \"estado_cuantico\": cons[\"estado\"],\n","                \"confianza\": cons[\"confianza\"]\n","            },\n","            \"señal_trading\": cons[\"señal\"],\n","            \"objetivos_precio\": self._calcular_objetivos_btc(precio_btc, cons),\n","            \"niveles_clave\": self._identificar_niveles_clave(precio_btc),\n","            \"metricas_riesgo\": self._calcular_metricas_riesgo(precio_btc, cambio_24h, volumen),\n","            \"timestamp\": utc_now_iso()\n","        }\n","\n","    def _calcular_funcion_onda(self, precio: float, cambio: float) -> Dict[str, float]:\n","        momentum = cambio / 100\n","        volatilidad = 0.02 + abs(momentum) * 0.5\n","        return {\n","            \"amplitud\": 1 - np.exp(-volatilidad * 10),\n","            \"frecuencia\": abs(momentum) * 100,\n","            \"fase\": float(np.arctan2(momentum, volatilidad)),\n","            \"coherencia\": max(0.1, 1 - volatilidad * 5)\n","        }\n","\n","    def _calcular_entanglement_temporal(self) -> Dict[str, Any]:\n","        tfs = ['1m', '5m', '15m', '1h', '4h', '1d']\n","        corrs = []\n","        for i in range(len(tfs) - 1):\n","            c = 0.6 + np.random.random() * 0.3\n","            corrs.append({\"par\": f\"{tfs[i]}-{tfs[i+1]}\", \"correlacion\": c})\n","        fuerza = float(np.mean([c[\"correlacion\"] for c in corrs]))\n","        return {\n","            \"correlaciones\": corrs,\n","            \"fuerza_entanglement\": fuerza,\n","            \"coherencia_global\": \"ALTA\" if fuerza > 0.7 else \"MEDIA\"\n","        }\n","\n","    def _calcular_efecto_tunel(self, precio: float) -> Dict[str, Any]:\n","        niveles = [45000, 47000, 49000, 51000, 53000, 55000]\n","        eventos = []\n","        for nivel in niveles:\n","            distancia = abs(precio - nivel) / max(precio, 1e-9)\n","            prob = float(np.exp(-distancia * 100))\n","            if prob > 0.1:\n","                eventos.append({\n","                    \"nivel\": nivel,\n","                    \"distancia_porcentaje\": distancia * 100,\n","                    \"probabilidad_tunel\": prob,\n","                    \"direccion\": \"BREAKOUT\" if precio > nivel else \"BREAKDOWN\",\n","                    \"significancia\": \"ALTA\" if prob > 0.3 else \"MEDIA\"\n","                })\n","        return {\n","            \"eventos_tunel\": eventos,\n","            \"probabilidad_total\": sum(e[\"probabilidad_tunel\"] for e in eventos),\n","            \"tuneling_activo\": len(eventos) > 0\n","        }\n","\n","    def _consolidar_señal_cuantica(self, onda: Dict, ent: Dict, tun: Dict) -> Dict[str, Any]:\n","        confianza_base = onda[\"coherencia\"]\n","        boost_e = ent[\"fuerza_entanglement\"] * 0.3\n","        boost_t = tun[\"probabilidad_total\"] * 0.2\n","        confianza_total = min(confianza_base + boost_e + boost_t, 0.95)\n","        direccion = \"ALCISTA\" if onda[\"fase\"] > 0 else \"BAJISTA\"\n","        fuerza = min(abs(onda[\"fase\"]) * 10, 1.0)\n","        if tun[\"eventos_tunel\"]:\n","            ultimo = tun[\"eventos_tunel\"][-1]\n","            if ultimo[\"direccion\"] == \"BREAKOUT\":\n","                direccion, fuerza = \"ALCISTA\", max(fuerza, 0.7)\n","            else:\n","                direccion, fuerza = \"BAJISTA\", max(fuerza, 0.7)\n","        return {\"señal\": direccion, \"confianza\": confianza_total, \"fuerza\": fuerza,\n","                \"estado\": \"ENTANGLED\" if ent[\"coherencia_global\"] == \"ALTA\" else \"SUPERPOSITION\"}\n","\n","    def _calcular_objetivos_btc(self, px: float, señal: Dict) -> Dict[str, float]:\n","        f = señal[\"fuerza\"]\n","        if señal[\"señal\"] == \"ALCISTA\":\n","            return {\n","                \"corto_plazo\": px * (1 + f * 0.05),\n","                \"medio_plazo\": px * (1 + f * 0.10),\n","                \"largo_plazo\": px * (1 + f * 0.20),\n","                \"stop_loss\": px * (1 - f * 0.03),\n","            }\n","        else:\n","            return {\n","                \"corto_plazo\": px * (1 - f * 0.05),\n","                \"medio_plazo\": px * (1 - f * 0.10),\n","                \"largo_plazo\": px * (1 - f * 0.20),\n","                \"stop_loss\": px * (1 + f * 0.03),\n","            }\n","\n","    def _identificar_niveles_clave(self, precio: float) -> List[Dict[str, Any]]:\n","        niveles, out = [45000, 47000, 49000, 51000, 53000, 55000], []\n","        for nivel in niveles:\n","            dist = abs(precio - nivel) / max(precio, 1e-9)\n","            if dist < 0.05:\n","                tipo = \"RESISTENCIA\" if nivel > precio else \"SOPORTE\"\n","                fuerza = 1 - (dist / 0.05)\n","                out.append({\"nivel\": nivel, \"tipo\": tipo, \"fuerza\": fuerza, \"distancia_porcentaje\": dist * 100})\n","        return sorted(out, key=lambda x: x[\"distancia_porcentaje\"])\n","\n","    def _calcular_metricas_riesgo(self, precio: float, cambio: float, volumen: float) -> Dict[str, Any]:\n","        volatilidad = abs(cambio) / 100\n","        vol_rel = volumen / 25_000_000_000\n","        score = (volatilidad * 0.6 + (1 - min(vol_rel, 1.0)) * 0.4) * 100\n","        if score > 70: nivel = \"MUY ALTO\"\n","        elif score > 50: nivel = \"ALTO\"\n","        elif score > 30: nivel = \"MEDIO\"\n","        else: nivel = \"BAJO\"\n","        return {\n","            \"score_riesgo\": score,\n","            \"nivel_riesgo\": nivel,\n","            \"volatilidad_estimada\": volatilidad * 100,\n","            \"liquidez_suficiente\": vol_rel > 0.8\n","        }\n","\n","    def generar_reporte_completo(self, datos: Dict, señales_orb: Dict, analisis_btc: Dict) -> Dict[str, Any]:\n","        return {\n","            \"metadata\": {\n","                \"timestamp\": utc_now_iso(),\n","                \"version_sistema\": \"ULTRAMATRIZ_CUANTICA_TTDVI156_v1.0\",\n","                \"intervalo_actualizacion\": \"60 segundos\"\n","            },\n","            \"resumen_mercado\": {\n","                \"estado_global\": self._determinar_estado_global(datos),\n","                \"sentimiento_mercado\": datos[\"metricas_globales\"][\"miedo_codicia\"],\n","                \"activo_mas_fuerte\": self._identificar_activo_mas_fuerte(datos),\n","                \"recomendacion_global\": self._generar_recomendacion_global(señales_orb, analisis_btc)\n","            },\n","            \"analisis_btc\": analisis_btc,\n","            \"señales_orb\": señales_orb,\n","            \"metricas_desempeno\": self._calcular_metricas_desempeno(),\n","            \"alertas_activas\": self._generar_alertas(datos, señales_orb, analisis_btc)\n","        }\n","\n","    def _determinar_estado_global(self, datos: Dict) -> str:\n","        m, v = datos[\"metricas_globales\"][\"miedo_codicia\"], datos[\"metricas_globales\"][\"volatilidad_mercado\"]\n","        if m > 70 and v < 0.1: return \"TENDENCIA_ALCISTA_FUERTE\"\n","        if m > 60: return \"TENDENCIA_ALCISTA\"\n","        if m < 30 and v > 0.15: return \"TENDENCIA_BAJISTA_FUERTE\"\n","        if m < 40: return \"TENDENCIA_BAJISTA\"\n","        return \"MERCADO_LATERAL\"\n","\n","    def _identificar_activo_mas_fuerte(self, datos: Dict) -> str:\n","        cambios = {i: d[\"cambio_diario\"] for i, d in datos[\"indices\"].items()}\n","        cambios[\"BTC\"] = datos[\"btc\"][\"cambio_24h\"]\n","        return max(cambios.items(), key=lambda x: x[1])[0]\n","\n","    def _generar_recomendacion_global(self, señales_orb: Dict, analisis_btc: Dict) -> str:\n","        comp, vent = 0, 0\n","        for s in señales_orb.values():\n","            if \"COMPRA\" in s[\"señal\"]: comp += 1\n","            elif \"VENTA\" in s[\"señal\"]: vent += 1\n","        if analisis_btc[\"señal_trading\"] == \"ALCISTA\": comp += 2\n","        else: vent += 2\n","        if comp > vent + 2: return \"SESGO_ALCISTA_FUERTE\"\n","        if comp > vent: return \"SESGO_ALCISTA\"\n","        if vent > comp + 2: return \"SESGO_BAJISTA_FUERTE\"\n","        if vent > comp: return \"SESGO_BAJISTA\"\n","        return \"MERCADO_NEUTRO\"\n","\n","    def _calcular_metricas_desempeno(self) -> Dict[str, Any]:\n","        return {\n","            \"precision_historica\": 0.72 + (np.random.random() - 0.5) * 0.1,\n","            \"sharpe_ratio\": 1.8 + (np.random.random() - 0.5) * 0.5,\n","            \"max_drawdown\": 8.5 + (np.random.random() - 0.5) * 3,\n","            \"win_rate\": 65 + (np.random.random() - 0.5) * 10,\n","            \"profit_factor\": 1.5 + (np.random.random() - 0.5) * 0.3\n","        }\n","\n","    def _generar_alertas(self, datos: Dict, señales_orb: Dict, analisis_btc: Dict) -> List[Dict[str, Any]]:\n","        alertas: List[Dict[str, Any]] = []\n","        if datos[\"metricas_globales\"][\"volatilidad_mercado\"] > 0.15:\n","            alertas.append({\"tipo\":\"ALTA_VOLATILIDAD\",\"nivel\":\"ALTO\",\n","                            \"mensaje\":\"Volatilidad del mercado > 15%\",\"timestamp\":utc_now_iso()})\n","        if datos[\"metricas_globales\"][\"miedo_codicia\"] < 25:\n","            alertas.append({\"tipo\":\"MIEDO_EXTREMO\",\"nivel\":\"MEDIO\",\n","                            \"mensaje\":\"Fear&Greed en miedo extremo\",\"timestamp\":utc_now_iso()})\n","        fuertes = sum(1 for s in señales_orb.values() if \"FUERTE\" in s[\"señal\"] and s[\"confianza\"] > 0.7)\n","        if fuertes >= 3:\n","            alertas.append({\"tipo\":\"MULTIPLES_SEÑALES_FUERTES\",\"nivel\":\"ALTO\",\n","                            \"mensaje\":f\"{fuertes} índices con señales fuertes\",\"timestamp\":utc_now_iso()})\n","        if analisis_btc[\"analisis_cuantico\"][\"efecto_tunel\"][\"tuneling_activo\"]:\n","            alertas.append({\"tipo\":\"EFECTO_TUNEL_BTC\",\"nivel\":\"MEDIO\",\n","                            \"mensaje\":\"Posible efecto túnel en BTC\",\"timestamp\":utc_now_iso()})\n","        return alertas\n","\n","    def guardar_resultados(self, reporte: Dict[str, Any]):\n","        fp = self.resultados_dir / f\"reporte_completo_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json\"\n","        with open(fp, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(reporte, f, indent=2, ensure_ascii=False)\n","        estado_fp = self.state_dir / \"estado_actual.json\"\n","        with open(estado_fp, \"w\", encoding=\"utf-8\") as f:\n","            json.dump({\n","                \"ultima_actualizacion\": utc_now_iso(),\n","                \"señal_btc\": reporte[\"analisis_btc\"][\"señal_trading\"],\n","                \"confianza_btc\": reporte[\"analisis_btc\"][\"analisis_cuantico\"][\"confianza\"],\n","                \"recomendacion_global\": reporte[\"resumen_mercado\"][\"recomendacion_global\"],\n","                \"alertas_activas\": len(reporte[\"alertas_activas\"])\n","            }, f, indent=2, ensure_ascii=False)\n","        self.log.info(f\"Resultados guardados en: {fp}\")\n","\n","    def generar_visualizaciones(self, reporte: Dict[str, Any]):\n","        try:\n","            fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(15, 10))\n","            # (1) Precios\n","            activos = ['BTC'] + list(reporte[\"señales_orb\"].keys())\n","            precios = [reporte[\"analisis_btc\"][\"precio_actual\"]]\n","            for idx in reporte[\"señales_orb\"].keys():\n","                precios.append(reporte[\"señales_orb\"][idx][\"precio_actual\"])\n","            ax1.bar(activos, precios)\n","            ax1.set_title('Precios Actuales de Activos'); ax1.set_ylabel('USD'); ax1.tick_params(axis='x', rotation=45)\n","            # (2) Confianza ORB\n","            indices = list(reporte[\"señales_orb\"].keys())\n","            confs = [reporte[\"señales_orb\"][i][\"confianza\"] for i in indices]\n","            ax2.bar(indices, confs)\n","            ax2.set_title('Confianza Señales ORB'); ax2.set_ylim(0, 1)\n","            # (3) Métricas cuánticas\n","            mq = reporte[\"analisis_btc\"][\"analisis_cuantico\"]\n","            labels3 = ['Confianza', 'Coherencia Onda', 'Fuerza Entanglement']\n","            vals3 = [mq[\"confianza\"], mq[\"funcion_onda\"][\"coherencia\"], mq[\"entanglement_temporal\"][\"fuerza_entanglement\"]]\n","            ax3.bar(labels3, vals3); ax3.set_ylim(0, 1); ax3.set_title('Métricas Cuánticas BTC')\n","            # (4) Riesgo\n","            r = reporte[\"analisis_btc\"][\"metricas_riesgo\"]\n","            labels4 = ['ScoreRiesgo', 'Volatilidad', 'LiquidezOK']\n","            vals4 = [r[\"score_riesgo\"]/100, r[\"volatilidad_estimada\"]/100, 1 if r[\"liquidez_suficiente\"] else 0]\n","            ax4.bar(labels4, vals4); ax4.set_ylim(0, 1); ax4.set_title('Riesgo BTC')\n","            plt.tight_layout()\n","            out = self.resultados_dir / f\"dashboard_mercado_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png\"\n","            plt.savefig(out, dpi=150, bbox_inches='tight'); plt.close()\n","            self.log.info(f\"Visualizaciones guardadas en: {out}\")\n","        except Exception as e:\n","            self.log.error(f\"Error generando visualizaciones: {e}\")\n","\n","    async def ejecutar_ciclo_analisis(self) -> Optional[Dict[str, Any]]:\n","        self.log.info(\"🔄 Iniciando ciclo de análisis en tiempo real...\")\n","        try:\n","            datos = await self.obtener_datos_mercado_en_vivo()\n","            señales_orb = self.analizar_señales_orb(datos)\n","            analisis_btc = self.analizar_btc_cuantico(datos)\n","            reporte = self.generar_reporte_completo(datos, señales_orb, analisis_btc)\n","            self.guardar_resultados(reporte)\n","            self.generar_visualizaciones(reporte)\n","            self.mostrar_resumen_consola(reporte)\n","            self.ultima_actualizacion = datetime.now(timezone.utc)\n","            self.estado_mercado = datos\n","            self.señales_activas = señales_orb\n","            self.log.info(\"✅ Ciclo de análisis completado\")\n","            return reporte\n","        except Exception as e:\n","            self.log.error(f\"❌ Error en ciclo de análisis: {e}\")\n","            return None\n","\n","    def mostrar_resumen_consola(self, reporte: Dict[str, Any]):\n","        print(\"\\n\" + \"=\"*80)\n","        print(\"🎯 ULTRAMATRIZ CUÁNTICA TTDVI156 - RESULTADOS TIEMPO REAL\")\n","        print(\"=\"*80)\n","        btc = reporte[\"analisis_btc\"]\n","        print(f\"₿  BITCOIN:\")\n","        print(f\"   Precio: ${btc['precio_actual']:,.2f}\")\n","        print(f\"   Señal: {btc['señal_trading']} (Confianza: {btc['analisis_cuantico']['confianza']:.1%})\")\n","        print(f\"   Estado Cuántico: {btc['analisis_cuantico']['estado_cuantico']}\")\n","        print(f\"   Riesgo: {btc['metricas_riesgo']['nivel_riesgo']}\")\n","        print(f\"\\n📊 SEÑALES ORB ÍNDICES:\")\n","        for indice, s in reporte[\"señales_orb\"].items():\n","            emoji = \"🟢\" if \"COMPRA\" in s[\"señal\"] else \"🔴\" if \"VENTA\" in s[\"señal\"] else \"⚪\"\n","            print(f\"   {emoji} {indice}: {s['señal']} ({s['confianza']:.1%})\")\n","        resumen = reporte[\"resumen_mercado\"]\n","        print(f\"\\n🌍 RESUMEN GLOBAL:\")\n","        print(f\"   Estado: {resumen['estado_global']}\")\n","        print(f\"   Activo Más Fuerte: {resumen['activo_mas_fuerte']}\")\n","        print(f\"   Recomendación: {resumen['recomendacion_global']}\")\n","        if reporte[\"alertas_activas\"]:\n","            print(f\"\\n🚨 ALERTAS ACTIVAS ({len(reporte['alertas_activas'])}):\")\n","            for a in reporte[\"alertas_activas\"][:3]:\n","                print(f\"   • {a['tipo']} - {a['mensaje']}\")\n","        print(f\"\\n🕒 Última actualización: {reporte['metadata']['timestamp']}\")\n","        print(\"=\"*80)\n","\n","# ===================== INTEGRACIÓN COMPLETA ENTIDADES BTC VIVO =====================\n","class TipoEntidad(Enum):\n","    WHALE = \"whale\"\n","    MINER = \"miner\"\n","    EXCHANGE = \"exchange\"\n","    INSTITUCIONAL = \"institucional\"\n","    FONDOS = \"fondos\"\n","    MARKET_MAKER = \"market_maker\"\n","    SILENT_MOVER = \"silent_mover\"\n","\n","class TipoEvento(Enum):\n","    TRANSFERENCIA_MAYOR = \"transferencia_mayor\"\n","    MOVIMIENTO_SILENCIOSO = \"movimiento_silencioso\"\n","    ACUMULACION = \"acumulacion\"\n","    DISTRIBUCION = \"distribucion\"\n","    MINER_FLOW = \"miner_flow\"\n","    EXCHANGE_FLOW = \"exchange_flow\"\n","\n","@dataclass\n","class EntidadBTC:\n","    id: str\n","    nombre: str\n","    tipo: TipoEntidad\n","    direcciones: List[str]\n","    umbral_btc: float = 10.0\n","    reputacion: float = 0.5\n","    actividad_reciente: int = 0\n","\n","@dataclass\n","class EventoBTC:\n","    id: str\n","    tipo: TipoEvento\n","    entidad: EntidadBTC\n","    cantidad_btc: float\n","    timestamp: datetime\n","    direcciones_involucradas: List[str]\n","    confianza: float = 0.8\n","    metadata: Dict[str, Any] = None\n","\n","class SistemaEntidadesBTC:\n","    def __init__(self):\n","        self.entidades_registradas: Dict[str, EntidadBTC] = {}\n","        self.eventos_detectados: List[EventoBTC] = []\n","        self.estado_mercado: Dict[str, Any] = {}\n","        self.alertas_activas: List[Dict[str, Any]] = []\n","        self.UMBRAL_WHALE = 50.0\n","        self.UMBRAL_SILENCIOSO = 100.0\n","        self.UMBRAL_ALERTA_VOLUMEN = 1000.0\n","        self._inicializar_entidades_base()\n","        self.whale_alert_api_key = os.getenv(\"WHALE_ALERT_API_KEY\", \"\")\n","        self.bitquery_api_key = os.getenv(\"BITQUERY_API_KEY\", \"\")\n","        self.log = logging.getLogger(\"ENTIDADES_BTC\")\n","\n","    def _inicializar_entidades_base(self):\n","        base = [\n","            EntidadBTC(\"binance\",\"Binance Exchange\",TipoEntidad.EXCHANGE,\n","                       [\"1NDyJtNTjmwk5xPNhjgAMu4HDHigtobu1s\"],100.0,0.7),\n","            EntidadBTC(\"coinbase\",\"Coinbase Exchange\",TipoEntidad.EXCHANGE,\n","                       [\"1MDUoxL1bGSvG5jsG4sGXwBy2TfT7c1tJj\"],100.0,0.8),\n","            EntidadBTC(\"fidelity\",\"Fidelity Investments\",TipoEntidad.INSTITUCIONAL,\n","                       [\"3FZbgi29cpjq2GjdwV8eyHuJJnkLtktZc5\"],500.0,0.9),\n","            EntidadBTC(\"unknown_whale_1\",\"Whale Desconocido #1\",TipoEntidad.WHALE,[],1000.0,0.3),\n","            EntidadBTC(\"miner_pool_1\",\"Pool de Minería Principal\",TipoEntidad.MINER,\n","                       [\"1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa\"],50.0,0.6),\n","        ]\n","        for e in base:\n","            self.entidades_registradas[e.id] = e\n","\n","    async def _obtener_whale_alert_transactions(self) -> List[Dict[str, Any]]:\n","        if not self.whale_alert_api_key:\n","            return []\n","        try:\n","            url = \"https://api.whale-alert.io/v1/transactions\"\n","            params = {\"api_key\": self.whale_alert_api_key, \"min_value\": 500000,\n","                      \"start\": int(time.time()) - 3600}\n","            async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=15)) as s:\n","                async with s.get(url, params=params) as r:\n","                    if r.status == 200:\n","                        data = await r.json()\n","                        return data.get(\"transactions\", [])\n","        except Exception as e:\n","            self.log.warning(f\"WhaleAlert error: {e}\")\n","        return []\n","\n","    async def _obtener_blockchain_transactions(self) -> List[Dict[str, Any]]:\n","        # Simulado para fallback\n","        return self._simular_transacciones_grandes()\n","\n","    async def _obtener_mempool_transactions(self) -> List[Dict[str, Any]]:\n","        # Ligero filtro + fallback silencioso\n","        try:\n","            url = \"https://mempool.space/api/v1/transactions\"\n","            async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=10)) as s:\n","                async with s.get(url) as r:\n","                    if r.status == 200:\n","                        data = await r.json()\n","                        grandes = [tx for tx in data if tx.get(\"fee\", 0) > 100000]\n","                        return grandes[:10]\n","        except Exception as e:\n","            self.log.info(f\"mempool fallback: {e}\")\n","        return []\n","\n","    def _simular_transacciones_grandes(self) -> List[Dict[str, Any]]:\n","        out, tipos = [], [\"exchange\", \"whale\", \"institutional\", \"miner\"]\n","        for i in range(5):\n","            out.append({\n","                \"hash\": f\"sim_{i}_{int(time.time())}\",\n","                \"amount\": float(np.random.uniform(100, 5000)),\n","                \"from_address\": f\"from_{i}\",\n","                \"to_address\": f\"to_{i}\",\n","                \"timestamp\": utc_now_iso(),\n","                \"type\": random.choice(tipos),\n","                \"confidence\": float(np.random.uniform(0.6, 0.95)),\n","            })\n","        return out\n","\n","    async def _obtener_transacciones_recientes(self) -> List[Dict[str, Any]]:\n","        txs: List[Dict[str, Any]] = []\n","        try:\n","            if self.whale_alert_api_key:\n","                txs += await self._obtener_whale_alert_transactions()\n","            txs += await self._obtener_blockchain_transactions()\n","            txs += await self._obtener_mempool_transactions()\n","        except Exception as e:\n","            self.log.warning(f\"Error obtención txs: {e}\")\n","        return txs\n","\n","    def _inferir_tipo_entidad(self, tx: Dict[str, Any]) -> TipoEntidad:\n","        amount = float(tx.get(\"amount\", 0))\n","        t = str(tx.get(\"type\", \"\")).lower()\n","        if t in [\"exchange\", \"withdrawal\", \"deposit\"]:\n","            return TipoEntidad.EXCHANGE\n","        if amount >= 1000:\n","            return TipoEntidad.WHALE\n","        if \"miner\" in t:\n","            return TipoEntidad.MINER\n","        if 100 <= amount < 1000:\n","            return TipoEntidad.INSTITUCIONAL\n","        return TipoEntidad.SILENT_MOVER\n","\n","    def _calcular_umbral_entidad(self, tipo: TipoEntidad) -> float:\n","        return {\n","            TipoEntidad.WHALE: 100.0, TipoEntidad.MINER: 50.0, TipoEntidad.EXCHANGE: 200.0,\n","            TipoEntidad.INSTITUCIONAL: 500.0, TipoEntidad.FONDOS: 300.0,\n","            TipoEntidad.MARKET_MAKER: 150.0, TipoEntidad.SILENT_MOVER: 10.0\n","        }.get(tipo, 50.0)\n","\n","    def _identificar_entidad(self, tx: Dict[str, Any]) -> EntidadBTC:\n","        addr = tx.get(\"from_address\", \"\") or tx.get(\"to_address\", \"\")\n","        for e in self.entidades_registradas.values():\n","            if addr and addr in e.direcciones:\n","                return e\n","        tipo = self._inferir_tipo_entidad(tx)\n","        eid = f\"{tipo.value}_{len(self.entidades_registradas)}\"\n","        ent = EntidadBTC(\n","            id=eid, nombre=f\"{tipo.value.title()} Desconocido\", tipo=tipo,\n","            direcciones=[addr] if addr else [], umbral_btc=self._calcular_umbral_entidad(tipo), reputacion=0.5\n","        )\n","        self.entidades_registradas[eid] = ent\n","        return ent\n","\n","    def _es_acumulacion(self, tx: Dict[str, Any], entidad: EntidadBTC) -> bool:\n","        to_addr = str(tx.get(\"to_address\", \"\")).lower()\n","        from_addr = str(tx.get(\"from_address\", \"\")).lower()\n","        keywords = [\"binance\", \"coinbase\", \"kraken\", \"exchange\", \"hotwallet\"]\n","        hacia_ex = any(k in to_addr for k in keywords)\n","        desde_ex = any(k in from_addr for k in keywords)\n","        return (not hacia_ex) and desde_ex\n","\n","    def _clasificar_evento(self, tx: Dict[str, Any], entidad: EntidadBTC) -> TipoEvento:\n","        amount = float(tx.get(\"amount\", 0))\n","        if amount >= self.UMBRAL_WHALE: return TipoEvento.TRANSFERENCIA_MAYOR\n","        if entidad.tipo == TipoEntidad.SILENT_MOVER and amount >= 10: return TipoEvento.MOVIMIENTO_SILENCIOSO\n","        if entidad.tipo == TipoEntidad.MINER: return TipoEvento.MINER_FLOW\n","        if \"exchange\" in str(tx.get(\"to_address\", \"\")).lower(): return TipoEvento.EXCHANGE_FLOW\n","        if amount > 0: return TipoEvento.ACUMULACION if self._es_acumulacion(tx, entidad) else TipoEvento.DISTRIBUCION\n","        return TipoEvento.TRANSFERENCIA_MAYOR\n","\n","    async def _analizar_transacciones(self, txs: List[Dict[str, Any]]) -> List[EventoBTC]:\n","        eventos: List[EventoBTC] = []\n","        for tx in txs:\n","            try:\n","                ent = self._identificar_entidad(tx)\n","                tipo = self._clasificar_evento(tx, ent)\n","                ts = tx.get(\"timestamp\", utc_now_iso())\n","                if isinstance(ts, str):\n","                    try:\n","                        tstamp = datetime.fromisoformat(ts.replace(\"Z\", \"+00:00\"))\n","                    except Exception:\n","                        tstamp = datetime.now(timezone.utc)\n","                else:\n","                    tstamp = datetime.now(timezone.utc)\n","                ev = EventoBTC(\n","                    id=f\"event_{len(self.eventos_detectados)}_{int(time.time())}\",\n","                    tipo=tipo, entidad=ent, cantidad_btc=float(tx.get(\"amount\", 0)),\n","                    timestamp=tstamp,\n","                    direcciones_involucradas=[tx.get(\"from_address\",\"\"), tx.get(\"to_address\",\"\")],\n","                    confianza=float(tx.get(\"confidence\", 0.5)), metadata=tx\n","                )\n","                eventos.append(ev); self.eventos_detectados.append(ev)\n","                if len(self.eventos_detectados) > 1000:\n","                    self.eventos_detectados = self.eventos_detectados[-500:]\n","            except Exception as e:\n","                self.log.warning(f\"Error analizando tx: {e}\")\n","        return eventos\n","\n","    def _crear_alerta(self, tipo: str, severidad: str, mensaje: str, eventos: List[EventoBTC]):\n","        al = {\n","            \"id\": f\"alert_{len(self.alertas_activas)}_{int(time.time())}\",\n","            \"tipo\": tipo, \"severidad\": severidad, \"mensaje\": mensaje,\n","            \"timestamp\": utc_now_iso(),\n","            \"eventos_relacionados\": [e.id for e in eventos],\n","            \"entidades_involucradas\": list({e.entidad.id for e in eventos})\n","        }\n","        self.alertas_activas.append(al)\n","        if len(self.alertas_activas) > 50:\n","            self.alertas_activas = self.alertas_activas[-25:]\n","        self.log.warning(f\"🚨 {severidad}: {mensaje}\")\n","\n","    async def _detectar_patrones_avanzados(self, eventos: List[EventoBTC]):\n","        # Whales en 1h\n","        recientes = [e for e in eventos if (datetime.now(timezone.utc) - e.timestamp).total_seconds() < 3600]\n","        whales = [e for e in recientes if e.tipo == TipoEvento.TRANSFERENCIA_MAYOR]\n","        if len(whales) >= 3:\n","            self._crear_alerta(\"MULTIPLES_WHALES_1H\", \"ALTA\",\n","                               f\"Detectadas {len(whales)} transferencias whale en la última hora\", whales)\n","        # Silenciosos\n","        silenciosos = [e for e in eventos if e.tipo == TipoEvento.MOVIMIENTO_SILENCIOSO and e.cantidad_btc >= self.UMBRAL_SILENCIOSO]\n","        if silenciosos:\n","            total = sum(e.cantidad_btc for e in silenciosos)\n","            if total >= self.UMBRAL_ALERTA_VOLUMEN:\n","                self._crear_alerta(\"VOLUMEN_SILENCIOSO_ALTO\", \"MEDIA\",\n","                                   f\"Movimientos silenciosos suman {total:.1f} BTC\", silenciosos)\n","        # Flujo exchange (aprox)\n","        flujo = 0.0\n","        for e in eventos:\n","            if e.entidad.tipo == TipoEntidad.EXCHANGE:\n","                if \"withdrawal\" in str(e.metadata.get(\"type\",\"\")): flujo -= e.cantidad_btc\n","                else: flujo += e.cantidad_btc\n","        if abs(flujo) > 1000:\n","            self._crear_alerta(f\"FLUJO_EXCHANGE_{'ENTRADA' if flujo>0 else 'SALIDA'}\",\"MEDIA\",\n","                               f\"Flujo neto significante hacia exchanges: {flujo:.1f} BTC\", eventos)\n","\n","    async def _actualizar_estado_mercado(self):\n","        e24 = [e for e in self.eventos_detectados if (datetime.now(timezone.utc) - e.timestamp).total_seconds() < 86400]\n","        if not e24: return\n","        total = sum(e.cantidad_btc for e in e24)\n","        whale_vol = sum(e.cantidad_btc for e in e24 if e.cantidad_btc >= 100)\n","        n_whale = sum(1 for e in e24 if e.cantidad_btc >= 100)\n","        comp = sum(1 for e in e24 if e.tipo == TipoEvento.ACUMULACION)\n","        vent = sum(1 for e in e24 if e.tipo == TipoEvento.DISTRIBUCION)\n","        sentimiento = \"NEUTRO\"\n","        if comp > vent * 1.5: sentimiento = \"ALCISTA\"\n","        elif vent > comp * 1.5: sentimiento = \"BAJISTA\"\n","        self.estado_mercado = {\n","            \"timestamp\": utc_now_iso(),\n","            \"total_eventos_24h\": len(e24),\n","            \"volumen_total_24h\": total,\n","            \"volumen_whale_24h\": whale_vol,\n","            \"eventos_whale_24h\": n_whale,\n","            \"sentimiento_entidades\": sentimiento,\n","            \"ratio_compra_venta\": comp / max(vent, 1),\n","            \"alertas_activas\": len(self.alertas_activas),\n","            \"entidades_activas\": len({e.entidad.id for e in e24})\n","        }\n","\n","    def _obtener_entidad_mas_activa(self) -> Dict[str, Any]:\n","        e24 = [e for e in self.eventos_detectados if (datetime.now(timezone.utc) - e.timestamp).total_seconds() < 86400]\n","        if not e24: return {\"nombre\": \"N/A\", \"eventos\": 0}\n","        cnt: Dict[str, int] = {}\n","        for e in e24: cnt[e.entidad.id] = cnt.get(e.entidad.id, 0) + 1\n","        eid = max(cnt.items(), key=lambda x: x[1])[0]\n","        ent = self.entidades_registradas[eid]\n","        return {\"nombre\": ent.nombre, \"tipo\": ent.tipo.value, \"eventos\": cnt[eid], \"reputacion\": ent.reputacion}\n","\n","    def _analizar_patrones_temporales(self) -> Dict[str, Any]:\n","        e24 = [e for e in self.eventos_detectados if (datetime.now(timezone.utc) - e.timestamp).total_seconds() < 86400]\n","        if not e24: return {\"patron\": \"SIN_DATOS\", \"confianza\": 0.0}\n","        por_hora: Dict[str, int] = {}\n","        for e in e24:\n","            h = e.timestamp.strftime(\"%H:00\"); por_hora[h] = por_hora.get(h, 0) + 1\n","        hora_pico = max(por_hora.items(), key=lambda x: x[1])\n","        patron = \"ACTIVIDAD_CONCENTRADA\" if hora_pico[1] > np.mean(list(por_hora.values())) * 1.5 else \"DISTRIBUIDA\"\n","        return {\"patron\": patron, \"hora_pico\": hora_pico[0], \"eventos_hora_pico\": hora_pico[1],\n","                \"confianza\": min(hora_pico[1] / 10, 1.0)}\n","\n","    def _generar_reporte_tiempo_real(self) -> Dict[str, Any]:\n","        e1h = [e for e in self.eventos_detectados if (datetime.now(timezone.utc) - e.timestamp).total_seconds() < 3600]\n","        return {\n","            \"metadata\": {\"timestamp\": utc_now_iso(), \"sistema\": \"ENTIDADES_BTC_VIVO\", \"version\": \"1.0\"},\n","            \"estado_mercado\": self.estado_mercado,\n","            \"eventos_recientes\": [{\n","                \"id\": e.id, \"tipo\": e.tipo.value, \"entidad\": e.entidad.nombre,\n","                \"cantidad_btc\": e.cantidad_btc, \"timestamp\": e.timestamp.isoformat(), \"confianza\": e.confianza\n","            } for e in e1h[-10:]],\n","            \"alertas_activas\": self.alertas_activas[-5:],\n","            \"metricas_entidades\": {\n","                \"total_registradas\": len(self.entidades_registradas),\n","                \"whales_activos\": len([x for x in self.entidades_registradas.values() if x.tipo == TipoEntidad.WHALE]),\n","                \"exchanges_activos\": len([x for x in self.entidades_registradas.values() if x.tipo == TipoEntidad.EXCHANGE]),\n","                \"entidad_mas_activa\": self._obtener_entidad_mas_activa()\n","            },\n","            \"analisis_patrones\": self._analizar_patrones_temporales()\n","        }\n","\n","    async def ciclo_entidades(self):\n","        \"\"\"Un ciclo: obtiene, analiza, detecta patrones y actualiza estado.\"\"\"\n","        try:\n","            txs = await self._obtener_transacciones_recientes()\n","            eventos = await self._analizar_transacciones(txs)\n","            await self._detectar_patrones_avanzados(eventos)\n","            await self._actualizar_estado_mercado()\n","            return self._generar_reporte_tiempo_real()\n","        except Exception as e:\n","            self.log.error(f\"ciclo_entidades error: {e}\")\n","            return {\"metadata\":{\"timestamp\":utc_now_iso(),\"estado\":\"ERROR\",\"error\":str(e)}}\n","\n","# ===================== RESUMEN UNIFICADO TIEMPO REAL =====================\n","class ResumenUnificadoTiempoReal:\n","    def __init__(self):\n","        self.sistema_entidades = SistemaEntidadesBTC()\n","        self.resultados_mercado = ResultadosTiempoReal()\n","        self.pipeline_bridge = PipelineBridge(self)  # ✅ NUEVO: Bridge integrado\n","        self.ultimo_resumen: Optional[Dict[str, Any]] = None\n","        self.historico_resumenes: List[Dict[str, Any]] = []\n","        self.log = logging.getLogger(\"RESUMEN_UNIFICADO\")\n","\n","        # Aplicar patches para silent moves\n","        self._apply_silent_move_patches()\n","\n","    def _apply_silent_move_patches(self):\n","        \"\"\"Aplica patches para boosts de silent moves\"\"\"\n","        # Guardar métodos originales\n","        self._orig_calc_score_mercado = self._calcular_score_mercado\n","        self._orig_calc_metricas_cruzadas = self._calcular_metricas_cruzadas\n","\n","    def _calcular_score_mercado_with_boost(self, ent: Dict, mkt: Dict) -> Dict[str, Any]:\n","        \"\"\"Calcula score con boost de silent moves\"\"\"\n","        res = self._orig_calc_score_mercado(ent, mkt)\n","        boost = self.pipeline_bridge.get_silent_move_boost()\n","\n","        if boost > 0:\n","            res = dict(res)\n","            res[\"score_global\"] = float(min(100.0, res.get(\"score_global\", 0.0) + boost))\n","            # Añadir metadata del boost\n","            res[\"boost_silent_moves\"] = boost\n","            res[\"silent_moves_recientes\"] = len(self.pipeline_bridge._silent_move_flags)\n","\n","        return res\n","\n","    def _calcular_metricas_cruzadas_with_boost(self, ent: Dict, mkt: Dict) -> Dict[str, Any]:\n","        \"\"\"Calcula métricas cruzadas con ajuste por silent moves\"\"\"\n","        mc = self._orig_calc_metricas_cruzadas(ent, mkt)\n","\n","        # Si hay silent moves recientes, mejorar convergencia\n","        if self.pipeline_bridge.has_recent_silent_moves():\n","            if mc.get(\"convergencia_señales\") == \"BAJA\":\n","                mc[\"convergencia_señales\"] = \"MEDIA\"\n","            # Mejorar fuerza de tendencia si hay volumen significativo\n","            if mc.get(\"fuerza_tendencia\") in [\"DEBIL\", \"MODERADA\"]:\n","                total_btc = sum(flag[\"sum_btc\"] for flag in self.pipeline_bridge._silent_move_flags)\n","                if total_btc > 500:\n","                    mc[\"fuerza_tendencia\"] = \"FUERTE\"\n","\n","        return mc\n","\n","    async def ejecutar_ciclo_completo(self) -> Dict[str, Any]:\n","        self.log.info(\"🔄 Iniciando ciclo de análisis unificado...\")\n","        try:\n","            reporte_entidades = await self.sistema_entidades.ciclo_entidades()\n","            reporte_mercado = await self.resultados_mercado.ejecutar_ciclo_analisis()\n","            resumen = self._integrar_reportes(reporte_entidades, reporte_mercado or {})\n","            resumen[\"alertas_consolidadas\"] = self._consolidar_alertas(reporte_entidades, reporte_mercado or {})\n","\n","            # Usar versión con boost para silent moves\n","            resumen[\"score_mercado_unificado\"] = self._calcular_score_mercado_with_boost(\n","                reporte_entidades, reporte_mercado or {}\n","            )\n","\n","            self.ultimo_resumen = resumen\n","            self.historico_resumenes.append(resumen)\n","            if len(self.historico_resumenes) > 100:\n","                self.historico_resumenes = self.historico_resumenes[-50:]\n","            self._mostrar_resumen_ejecutivo(resumen)\n","            self.log.info(\"✅ Ciclo unificado completado\")\n","            return resumen\n","        except Exception as e:\n","            self.log.error(f\"❌ Error ciclo unificado: {e}\")\n","            return self._generar_resumen_error(e)\n","\n","    def _integrar_reportes(self, ent: Dict, mkt: Dict) -> Dict[str, Any]:\n","        return {\n","            \"metadata\": {\"timestamp\": utc_now_iso(), \"sistema\": \"ULTRAMATRIZ_CUANTICA_TTDVI156_UNIFICADO\",\n","                         \"version\":\"2.0\",\"ciclo\": len(self.historico_resumenes)+1},\n","            \"resumen_ejecutivo\": {\n","                \"score_global\": self._calcular_score_global(ent, mkt),\n","                \"tendencia_principal\": self._determinar_tendencia_principal(ent, mkt),\n","                \"confianza_analisis\": self._calcular_confianza_analisis(ent, mkt),\n","                \"recomendacion_operativa\": self._generar_recomendacion_operativa(ent, mkt)\n","            },\n","            \"entidades_btc\": {\n","                \"estado\": ent.get(\"estado_mercado\", {}),\n","                \"eventos_destacados\": ent.get(\"eventos_recientes\", [])[:5],\n","                \"alertas_entidades\": ent.get(\"alertas_activas\", [])[:3],\n","                \"patrones_detectados\": ent.get(\"analisis_patrones\", {})\n","            },\n","            \"analisis_tecnico\": {\n","                \"señal_btc\": (mkt.get(\"analisis_btc\", {}) or {}).get(\"señal_trading\", \"NEUTRAL\"),\n","                \"señales_orb\": mkt.get(\"señales_orb\", {}),\n","                \"metricas_cuanticas\": (mkt.get(\"analisis_btc\", {}) or {}).get(\"analisis_cuantico\", {}),\n","                \"niveles_riesgo\": (mkt.get(\"analisis_btc\", {}) or {}).get(\"metricas_riesgo\", {})\n","            },\n","            \"metricas_cruzadas\": self._calcular_metricas_cruzadas_with_boost(ent, mkt),\n","            \"timestamp_actualizacion\": utc_now_iso()\n","        }\n","\n","    def _calcular_score_global(self, ent: Dict, mkt: Dict) -> float:\n","        scores: List[float] = []\n","        est = ent.get(\"estado_mercado\", {})\n","        sent = est.get(\"sentimiento_entidades\", \"NEUTRO\")\n","        scores.append(30 if sent==\"ALCISTA\" else 10 if sent==\"BAJISTA\" else 20)\n","        vw = est.get(\"volumen_whale_24h\", 0)\n","        scores.append(15 if vw>5000 else 10 if vw>1000 else 5)\n","        señal = (mkt.get(\"analisis_btc\", {}) or {}).get(\"señal_trading\", \"NEUTRAL\")\n","        scores.append(30 if señal==\"ALCISTA\" else 10 if señal==\"BAJISTA\" else 20)\n","        return float(sum(scores))\n","\n","    def _determinar_tendencia_principal(self, ent: Dict, mkt: Dict) -> str:\n","        up=down=0\n","        sent = ent.get(\"estado_mercado\", {}).get(\"sentimiento_entidades\",\"NEUTRO\")\n","        if sent==\"ALCISTA\": up+=2\n","        elif sent==\"BAJISTA\": down+=2\n","        señal = (mkt.get(\"analisis_btc\", {}) or {}).get(\"señal_trading\",\"NEUTRAL\")\n","        if señal==\"ALCISTA\": up+=2\n","        elif señal==\"BAJISTA\": down+=2\n","        for s in mkt.get(\"señales_orb\", {}).values():\n","            if \"COMPRA\" in s.get(\"señal\",\"\"): up+=1\n","            elif \"VENTA\" in s.get(\"señal\",\"\"): down+=1\n","        if up > down+2: return \"TENDENCIA_ALCISTA_FUERTE\"\n","        if up > down: return \"TENDENCIA_ALCISTA\"\n","        if down > up+2: return \"TENDENCIA_BAJISTA_FUERTE\"\n","        if down > up: return \"TENDENCIA_BAJISTA\"\n","        return \"MERCADO_LATERAL\"\n","\n","    def _calcular_confianza_analisis(self, ent: Dict, mkt: Dict) -> float:\n","        n = len(ent.get(\"eventos_recientes\", []))\n","        c_ent = min(n/10, 1.0)\n","        c_tec = (mkt.get(\"analisis_btc\", {}) or {}).get(\"analisis_cuantico\", {}).get(\"confianza\", 0.5)\n","        return c_ent*0.4 + c_tec*0.6\n","\n","    def _generar_recomendacion_operativa(self, ent: Dict, mkt: Dict) -> Dict[str, Any]:\n","        tend = self._determinar_tendencia_principal(ent, mkt)\n","        score = self._calcular_score_global(ent, mkt)\n","        if tend==\"TENDENCIA_ALCISTA_FUERTE\" and score>70:\n","            return {\"accion\":\"COMPRA_AGRESIVA\",\"confianza\":\"ALTA\",\n","                    \"explicacion\":\"Convergencia de señales alcistas\",\"porcentaje_inversion\":\"60-80%\"}\n","        if tend==\"TENDENCIA_ALCISTA\" and score>60:\n","            return {\"accion\":\"COMPRA_MODERADA\",\"confianza\":\"MEDIA\",\n","                    \"explicacion\":\"Predominio alcista con soporte de volumen\",\"porcentaje_inversion\":\"40-60%\"}\n","        if tend==\"MERCADO_LATERAL\" or score<50:\n","            return {\"accion\":\"ESPERAR\",\"confianza\":\"MEDIA\",\n","                    \"explicacion\":\"Consolidación o señales contradictorias\",\"porcentaje_inversion\":\"0-20%\"}\n","        if tend==\"TENDENCIA_BAJISTA\":\n","            return {\"accion\":\"REDUCIR_EXPOSICION\",\"confianza\":\"ALTA\" if score<40 else \"MEDIA\",\n","                    \"explicacion\":\"Señales bajistas predominantes\",\"porcentaje_inversion\":\"10-30%\"}\n","        return {\"accion\":\"MANTENER\",\"confianza\":\"BAJA\",\n","                \"explicacion\":\"Señales mixtas\",\"porcentaje_inversion\":\"20-40%\"}\n","\n","    def _consolidar_alertas(self, ent: Dict, mkt: Dict) -> List[Dict[str, Any]]:\n","        out: List[Dict[str, Any]] = []\n","        for a in ent.get(\"alertas_activas\", []): x = dict(a); x[\"fuente\"]=\"ENTIDADES_BTC\"; out.append(x)\n","        for a in mkt.get(\"alertas_activas\", []): x = dict(a); x[\"fuente\"]=\"ANALISIS_TECNICO\"; out.append(x)\n","        sev = {\"ALTA\":3,\"MEDIA\":2,\"BAJA\":1}\n","        out.sort(key=lambda x: sev.get(x.get(\"severidad\",\"BAJA\"), 0), reverse=True)\n","        return out[:5]\n","\n","    def _calcular_score_mercado(self, ent: Dict, mkt: Dict) -> Dict[str, Any]:\n","        g = self._calcular_score_global(ent, mkt)\n","        return {\"score_global\": g,\n","                \"componentes\": {\n","                    \"entidades\": self._calcular_score_entidades(ent),\n","                    \"tecnico\": self._calcular_score_tecnico(mkt),\n","                    \"volumen\": self._calcular_score_volumen(ent, mkt),\n","                    \"sentimiento\": self._calcular_score_sentimiento(ent, mkt)\n","                },\n","                \"interpretacion\": self._interpretar_score(g)}\n","\n","    def _calcular_score_entidades(self, ent: Dict) -> float:\n","        est = ent.get(\"estado_mercado\", {})\n","        vw = est.get(\"volumen_whale_24h\", 0)\n","        sent = est.get(\"sentimiento_entidades\",\"NEUTRO\")\n","        score = 50 + (20 if vw>5000 else 10 if vw>1000 else 0)\n","        if sent==\"ALCISTA\": score += 15\n","        elif sent==\"BAJISTA\": score -= 15\n","        return max(0, min(100, score))\n","\n","    def _calcular_score_tecnico(self, mkt: Dict) -> float:\n","        señal = (mkt.get(\"analisis_btc\", {}) or {}).get(\"señal_trading\",\"NEUTRAL\")\n","        c = (mkt.get(\"analisis_btc\", {}) or {}).get(\"analisis_cuantico\", {}).get(\"confianza\", 0.5)\n","        if señal==\"ALCISTA\": return 60 + (c*40)\n","        if señal==\"BAJISTA\": return 40 - (c*40)\n","        return 50\n","\n","    def _calcular_score_volumen(self, ent: Dict, mkt: Dict) -> float:\n","        v = ent.get(\"estado_mercado\", {}).get(\"volumen_total_24h\", 0)\n","        return 80 if v>10000 else 65 if v>5000 else 50 if v>1000 else 35\n","\n","    def _calcular_score_sentimiento(self, ent: Dict, mkt: Dict) -> float:\n","        sent_ent = ent.get(\"estado_mercado\", {}).get(\"sentimiento_entidades\",\"NEUTRO\")\n","        fg = (mkt.get(\"resumen_mercado\", {}) or {}).get(\"sentimiento_mercado\", 50)\n","        score = fg + (15 if sent_ent==\"ALCISTA\" else -15 if sent_ent==\"BAJISTA\" else 0)\n","        return max(0, min(100, score))\n","\n","    def _interpretar_score(self, s: float) -> Dict[str, Any]:\n","        if s>=80: return {\"nivel\":\"MUY_ALCISTA\",\"color\":\"🟢\",\"descripcion\":\"Condiciones muy favorables\",\"riesgo\":\"BAJO\"}\n","        if s>=65: return {\"nivel\":\"ALCISTA\",\"color\":\"🟡\",\"descripcion\":\"Favorables con cierto riesgo\",\"riesgo\":\"MODERADO\"}\n","        if s>=45: return {\"nivel\":\"NEUTRO\",\"color\":\"⚪\",\"descripcion\":\"Equilibrio; esperar\",\"riesgo\":\"MODERADO\"}\n","        if s>=30: return {\"nivel\":\"BAJISTA\",\"color\":\"🟠\",\"descripcion\":\"Desfavorables; reducir\",\"riesgo\":\"ALTO\"}\n","        return {\"nivel\":\"MUY_BAJISTA\",\"color\":\"🔴\",\"descripcion\":\"Muy desfavorables\",\"riesgo\":\"MUY_ALTO\"}\n","\n","    def _calcular_metricas_cruzadas(self, ent: Dict, mkt: Dict) -> Dict[str, Any]:\n","        señal = (mkt.get(\"analisis_btc\", {}) or {}).get(\"señal_trading\",\"NEUTRAL\")\n","        sent = ent.get(\"estado_mercado\", {}).get(\"sentimiento_entidades\",\"NEUTRO\")\n","        conv = \"ALTA\" if (señal==\"ALCISTA\" and sent==\"ALCISTA\") or (señal==\"BAJISTA\" and sent==\"BAJISTA\") \\\n","               else \"MEDIA\" if (señal==\"NEUTRAL\" and sent==\"NEUTRO\") else \"BAJA\"\n","        return {\n","            \"convergencia_señales\": conv,\n","            \"fuerza_tendencia\": self._calcular_fuerza_tendencia(ent, mkt),\n","            \"volumen_confirmacion\": self._evaluar_volumen_confirmacion(ent, mkt),\n","            \"consistencia_temporal\": self._evaluar_consistencia_temporal(ent, mkt)\n","        }\n","\n","    def _calcular_fuerza_tendencia(self, ent: Dict, mkt: Dict) -> str:\n","        vw = ent.get(\"estado_mercado\", {}).get(\"volumen_whale_24h\", 0)\n","        c = (mkt.get(\"analisis_btc\", {}) or {}).get(\"analisis_cuantico\", {}).get(\"confianza\", 0.5)\n","        if vw>5000 and c>0.8: return \"MUY_FUERTE\"\n","        if vw>2000 and c>0.6: return \"FUERTE\"\n","        if vw>500 and c>0.4: return \"MODERADA\"\n","        return \"DEBIL\"\n","\n","    def _evaluar_volumen_confirmacion(self, ent: Dict, mkt: Dict) -> bool:\n","        v = ent.get(\"estado_mercado\", {}).get(\"volumen_total_24h\", 0)\n","        return v > 1000\n","\n","    def _evaluar_consistencia_temporal(self, ent: Dict, mkt: Dict) -> str:\n","        patron = ent.get(\"analisis_patrones\", {}).get(\"patron\", \"DISTRIBUIDA\")\n","        return \"ALTA\" if patron==\"ACTIVIDAD_CONCENTRADA\" else \"MEDIA\"\n","\n","    def _mostrar_resumen_ejecutivo(self, r: Dict[str, Any]):\n","        ej = r.get(\"resumen_ejecutivo\", {})\n","        score_data = r.get(\"score_mercado_unificado\", {})\n","        score = score_data.get(\"score_global\", 0)\n","        interp = score_data.get(\"interpretacion\", {})\n","        rec = ej.get(\"recomendacion_operativa\", {})\n","\n","        # Verificar boosts de silent moves\n","        boost = score_data.get(\"boost_silent_moves\", 0)\n","        silent_moves = score_data.get(\"silent_moves_recientes\", 0)\n","\n","        print(\"\\n\" + \"=\"*100)\n","        print(\"🎯 ULTRAMATRIZ CUÁNTICA TTDVI156 - RESUMEN EJECUTIVO UNIFICADO\")\n","        print(\"=\"*100)\n","        print(f\"📊 SCORE GLOBAL: {score:.1f}/100 {interp.get('color','⚪')}\")\n","        if boost > 0:\n","            print(f\"   📈 BOOST SILENT MOVES: +{boost:.1f} ({silent_moves} eventos)\")\n","        print(f\"📈 TENDENCIA: {ej.get('tendencia_principal','N/A')}\")\n","        print(f\"🎯 CONFIANZA ANÁLISIS: {ej.get('confianza_analisis',0):.1%}\")\n","        print(f\"\\n💡 RECOMENDACIÓN: {rec.get('accion','N/A')}\")\n","        print(f\"   Confianza: {rec.get('confianza','N/A')}\")\n","        print(f\"   Explicación: {rec.get('explicacion','N/A')}\")\n","        print(f\"   % Inversión: {rec.get('porcentaje_inversion','N/A')}\")\n","        al = r.get(\"alertas_consolidadas\", [])\n","        if al:\n","            print(f\"\\n🚨 ALERTAS ACTIVAS ({len(al)}):\")\n","            for a in al[:3]:\n","                fuente = a.get('fuente', '')\n","                fuente_str = f\"[{fuente}] \" if fuente else \"\"\n","                print(f\"   • {a.get('severidad','')}: {fuente_str}{a.get('mensaje','')}\")\n","        mc = r.get(\"metricas_cruzadas\", {})\n","        print(f\"\\n🔍 MÉTRICAS CRUZADAS:\")\n","        print(f\"   Convergencia: {mc.get('convergencia_señales','N/A')}\")\n","        print(f\"   Fuerza Tendencia: {mc.get('fuerza_tendencia','N/A')}\")\n","        print(f\"   Volumen Confirmación: {'✅' if mc.get('volumen_confirmacion') else '❌'}\")\n","        print(f\"\\n🕒 Actualizado: {r.get('timestamp_actualizacion','N/A')}\")\n","        print(\"=\"*100)\n","\n","    def _generar_resumen_error(self, error: Exception) -> Dict[str, Any]:\n","        return {\n","            \"metadata\":{\"timestamp\":utc_now_iso(),\"sistema\":\"ULTRAMATRIZ_CUANTICA_TTDVI156_UNIFICADO\",\"estado\":\"ERROR\",\"error\":str(error)},\n","            \"resumen_ejecutivo\":{\n","                \"score_global\":0,\"tendencia_principal\":\"INDETERMINADA\",\"confianza_analisis\":0.0,\n","                \"recomendacion_operativa\":{\"accion\":\"ESPERAR\",\"confianza\":\"BAJA\",\"explicacion\":f\"Error en análisis: {error}\",\"porcentaje_inversion\":\"0%\"}\n","            },\n","            \"alertas_consolidadas\":[{\"tipo\":\"SISTEMA_ERROR\",\"severidad\":\"ALTA\",\"mensaje\":f\"Error en análisis: {error}\",\"timestamp\":utc_now_iso()}]\n","        }\n","\n","# ===================== LOOP PRINCIPAL (DARWIN v4 COMPATIBLE) =====================\n","async def _loop_unificado(intervalo_seg=60):\n","    print(time_banner(\"START\"))\n","    print(\"🚀 INICIANDO ULTRAMATRIZ CUÁNTICA TTDVI156 - SISTEMA COMPLETO\")\n","    print(\"📊 Entidades BTC + Análisis Cuántico + ORB + Pipeline Bridge\")\n","    print(f\"⏰ Actualización cada {intervalo_seg} segundos\\n\")\n","\n","    sistema = ResumenUnificadoTiempoReal()\n","\n","    # ✅ INICIAR PIPELINE BRIDGE\n","    await sistema.pipeline_bridge.start()\n","    print(\"🔌 PipelineBridge iniciado - Esperando señales Kafka...\")\n","\n","    ciclos = 0\n","    try:\n","        while True:\n","            ciclos += 1\n","            print(f\"\\n🔄 CICLO {ciclos} - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n","            resumen = await sistema.ejecutar_ciclo_completo()\n","\n","            # Persistencia del resumen unificado\n","            if resumen and (resumen.get(\"metadata\", {}).get(\"estado\") != \"ERROR\"):\n","                out = DIR_GFX / f\"resumen_unificado_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json\"\n","                with open(out, \"w\", encoding=\"utf-8\") as f:\n","                    json.dump(resumen, f, indent=2, ensure_ascii=False)\n","                print(f\"💾 Resumen guardado en: {out}\")\n","\n","            await asyncio.sleep(intervalo_seg)\n","\n","    except asyncio.CancelledError:\n","        print(\"⏹️ Loop cancelado\")\n","    finally:\n","        # Cierre de sesión HTTP del módulo de mercado\n","        try:\n","            await sistema.resultados_mercado.close()\n","        except Exception:\n","            pass\n","        # Detener pipeline bridge\n","        try:\n","            await sistema.pipeline_bridge.stop()\n","        except Exception:\n","            pass\n","        print(time_banner(\"END\"))\n","\n","# Aliases esperados por tu stack DARWIN v4\n","async def run_loop_principal(intervalo_seg: int = 60):\n","    await _loop_unificado(intervalo_seg)\n","\n","async def boot_darwin_v4_stack():\n","    await _loop_unificado(60)\n","\n","async def main():\n","    await _loop_unificado(60)\n","\n","# Hooks de estado para supervisor externo (DARWIN v4)\n","def get_runtime_state() -> Dict[str, Any]:\n","    try:\n","        # Estado liviano desde el archivo de estado\n","        estado_fp = DIR_STATE / \"estado_actual.json\"\n","        if estado_fp.exists():\n","            with open(estado_fp, \"r\", encoding=\"utf-8\") as f:\n","                data = json.load(f)\n","        else:\n","            data = {}\n","        data.update({\"timestamp\": utc_now_iso(), \"ok\": True})\n","        return data\n","    except Exception as e:\n","        return {\"ok\": False, \"error\": str(e), \"timestamp\": utc_now_iso()}\n","\n","def restore_runtime_state(state: Dict[str, Any]) -> bool:\n","    try:\n","        # Guardado directo; en el futuro puedes mapear campos específicos\n","        with open(DIR_STATE / \"estado_restaurado.json\", \"w\", encoding=\"utf-8\") as f:\n","            json.dump(state or {}, f, indent=2, ensure_ascii=False)\n","        return True\n","    except Exception:\n","        return False\n","\n","async def close_all_http_sessions():\n","    # Cierra cualquier sesión conocida (por ahora solo ResultadosTiempoReal si estuviera viva)\n","    try:\n","        rtr = ResultadosTiempoReal()\n","        await rtr.close()\n","    except Exception:\n","        pass\n","\n","# ===================== AUTORUN SEGURO =====================\n","if __name__ == \"__main__\":\n","    try:\n","        asyncio.run(main())\n","    except KeyboardInterrupt:\n","        print(\"\\n⏹️ Detenido por el usuario\")\n","\n","# =============================== LAUNCHER RESILIENTE =============================================\n","def _shell_name():\n","    obj = globals().get(\"get_ipython\", None)\n","    if not callable(obj): return None\n","    try:\n","        sh = obj(); return getattr(getattr(sh, \"__class__\", None), \"__name__\", None)\n","    except Exception: return None\n","\n","def _launch_main_resiliente():\n","    shell = _shell_name()\n","    try:\n","        if shell in (\"ZMQInteractiveShell\",\"TerminalInteractiveShell\",\"Shell\"):\n","            try:\n","                import nest_asyncio; nest_asyncio.apply()\n","            except Exception: pass\n","            loop = asyncio.get_event_loop()\n","            if loop.is_running():\n","                loop.create_task(_main_unificado(), name=\"main_unificado\")\n","                print(\"✅ main() activo como tarea en loop Jupyter.\")\n","            else:\n","                loop.run_until_complete(_main_unificado())\n","        else:\n","            asyncio.run(_main_unificado())\n","    except RuntimeError:\n","        loop = asyncio.get_event_loop(); loop.create_task(_main_unificado()); print(\"✅ main() activo (fallback).\")\n","\n","# =============================== ARRANQUE ========================================================\n","def _should_autorun() -> bool:\n","    return _env_bool(os.getenv(\"AUTORUN\",\"1\"), True)\n","\n","if __name__==\"__main__\":\n","    try:\n","        if _should_autorun():\n","            _launch_main_resiliente()\n","        else:\n","            print(\"ℹ️ AUTORUN desactivado por entorno. Llama _launch_main_resiliente() manualmente.\")\n","    except Exception as e:\n","        print(f\"🚨 ERROR INESPERADO EN ARRANQUE: {e}\")\n","\n","# ==================== EJECUCIÓN / ENTRYPOINT (PONER DESPUÉS DEL FIN MAIN ÚNICO) ====================\n","def _maybe_apply_nest_asyncio():\n","    try:\n","        import nest_asyncio\n","        nest_asyncio.apply()\n","        return True\n","    except Exception:\n","        return False\n","\n","async def _bootstrap_and_run():\n","    \"\"\"\n","    Punto único de arranque asincrónico:\n","    - Ejecuta main() y deja correr indefinidamente si main retorna (por seguridad).\n","    \"\"\"\n","    try:\n","        await main()\n","    except KeyboardInterrupt:\n","        # Permite CTRL+C limpio\n","        pass\n","    except Exception as e:\n","        print(f\"🚨 Falla no controlada en main(): {e}\")\n","        raise\n","\n","def _run_main_safely():\n","    \"\"\"\n","    Ejecuta main() tanto en:\n","      - Scripts normales (sin loop activo) -> asyncio.run(...)\n","      - Jupyter/Colab (loop ya activo)     -> create_task(...)\n","    \"\"\"\n","    import asyncio\n","    try:\n","        loop = asyncio.get_event_loop()\n","    except RuntimeError:\n","        # No hay loop aún (p. ej., en algunos runtimes)\n","        asyncio.run(_bootstrap_and_run())\n","        return\n","\n","    if loop.is_running():\n","        # Entorno interactivo (Jupyter/Colab): habilita reentrancia y agenda tarea\n","        _maybe_apply_nest_asyncio()\n","        # Evita duplicar tareas si se re-ejecuta la celda\n","        _TASK_NAME = \"quantum_trading_main_task\"\n","        for t in asyncio.all_tasks(loop):\n","            try:\n","                if t.get_name() == _TASK_NAME:\n","                    print(\"ℹ️ Tarea principal ya está corriendo, no se duplica.\")\n","                    return\n","            except Exception:\n","                pass\n","        try:\n","            loop.create_task(_bootstrap_and_run(), name=_TASK_NAME)\n","            print(\"✅ main() lanzado en segundo plano sobre loop existente (Jupyter/Colab).\")\n","        except Exception:\n","            # Último recurso: ejecutar inline con await via nest_asyncio\n","            _maybe_apply_nest_asyncio()\n","            try:\n","                # En algunos entornos, run_until_complete vuelve a ser posible tras nest_asyncio\n","                loop.run_until_complete(_bootstrap_and_run())\n","            except Exception as e:\n","                print(f\"⚠️ No se pudo usar run_until_complete en loop activo: {e}\")\n","    else:\n","        # Script normal\n","        asyncio.run(_bootstrap_and_run())\n","\n","# --- Autoejecución al invocar el archivo como script ---\n","if __name__ == \"__main__\":\n","    # Opcional: habilitar ingreso interactivo de credenciales al arrancar\n","    # (si aún no configuraste .env / keyfile):\n","    # os.environ.setdefault(\"KRAKEN_INTERACTIVE\", \"1\")       # 0/1\n","    # os.environ.setdefault(\"KRAKEN_CRED_MODE\", \"env\")       # env | keyfile | memoria\n","    # os.environ.setdefault(\"KRAKEN_CRED_PATH\", \".env\")      # .env | kraken.key\n","    _run_main_safely()\n","\n","# -- coding: utf-8 --\n","\"\"\"\n","TTDVI156 — HYPERMEGA RENDER EN VIVO UNIFICADO (DINÁMICO + ADAPTATIVO) — HYPER-PRECISION (HP)\n","SISTEMA COMPLETO INTEGRADO: Render + Kraken (público) + Defensas (fallbacks) + Dashboard + DOFA\n","- Integra: proceso → historial → entrenamiento → predictores → visual → trading (+156%)\n","- Kraken público real (ticker/ohlc) + fallbacks sintéticos\n","- Render: Retro 1h, Gauge Sentimiento, Dashboard 1m + Proyección 60m (PNG + CSV)\n","- Objetivo universal +156% por ciclo (min/max por operación, enforcement a ejecutor)\n","- Bridge Kafka btc-signals (opcional): define KAFKA_BOOTSTRAP / KAFKA_TOPIC_SIGNALS\n","- Idempotente, resiliente, sin await suelto (Jupyter/script). Transición automática a REAL tras N ciclos.\n","\"\"\"\n","\n","# =========================================================================================\n","# ================ EJECUCIÓN PRINCIPAL ÚNICA — TTDVI156 (ULTRAMATRIZ DARWIN v4) ===========\n","# =========================================================================================\n","\n","import os, sys, csv, math, time, json, asyncio, traceback, subprocess, importlib, warnings, random, socket, threading\n","from dataclasses import dataclass\n","from typing import Optional, List, Dict, Any, Tuple\n","from decimal import Decimal\n","from datetime import datetime, timezone, timedelta\n","\n","# ===== Helpers enchufe resiliencia (no-op si no existen) =====\n","_touch_hb = globals().get(\"touch_heartbeat\", lambda: None)\n","_notify_data = globals().get(\"notify_new_data\", lambda ts=None: None)\n","_attach_task_logging = globals().get(\"_attach_task_logging\", lambda task, label=\"task\": task)\n","_run_with_resilience = globals().get(\"run_with_resilience\", None)\n","_run_async_safely = globals().get(\"_run_async_safely\", None)\n","\n","# ==================== CONFIG BÁSICA / ENTORNO ====================\n","try:\n","    import nest_asyncio; nest_asyncio.apply()\n","except Exception:\n","    pass\n","try:\n","    from dotenv import load_dotenv; load_dotenv()\n","except Exception:\n","    pass\n","\n","def obtener_modo_ejecucion() -> str:\n","    import argparse\n","    parser = argparse.ArgumentParser()\n","    parser.add_argument(\"--modo\", choices=[\"real\", \"prueba\", \"entrenar\"], help=\"Modo de ejecución\")\n","    args, _ = parser.parse_known_args()\n","    modo_env = os.getenv(\"MODO_EJECUCION\", \"\").lower()\n","    return (args.modo or modo_env or \"prueba\").lower()\n","\n","# (Opcional) instalar deps controladas si INSTALL_DEPS=1\n","def instalar_dependencias_controladas():\n","    if os.getenv(\"INSTALL_DEPS\",\"0\") != \"1\":\n","        return\n","    print(\"🔧 Instalando dependencias controladas…\")\n","    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"--upgrade\", \"pip\", \"setuptools\", \"wheel\"])\n","    pkgs = {\n","        \"numpy\":\"1.26.4\", \"scikit-learn\":\"1.3.2\", \"joblib\":\"1.3.2\",\n","        \"python-dotenv\":\"1.0.0\", \"tenacity\":\"8.2.3\", \"krakenex\":\"2.1.0\",\n","        \"pandas_ta\":\"0.3.14b0\", \"structlog\":\"25.1.0\", \"protobuf\":\"3.20.3\",\n","        \"absl-py\":\"2.1.0\", \"ml-dtypes\":\"0.3.2\", \"qiskit\":\"0.45.0\", \"qiskit-aer\":\"0.12.2\",\n","        \"qiskit-machine-learning\":\"0.7.2\", \"transformers\":\"4.38.2\", \"torch\":\"2.2.2\", \"aiohttp\":\"3.10.5\", \"aiokafka\":\"0.10.0\"\n","    }\n","    for p, v in pkgs.items():\n","        for k in range(2):\n","            try:\n","                subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"--prefer-binary\", f\"{p}=={v}\"])\n","                print(f\"✅ {p} instalado\")\n","                break\n","            except subprocess.CalledProcessError as e:\n","                if k==1: raise\n","                print(f\"⚠️ Reintentando {p}: {e}\")\n","    importlib.invalidate_caches()\n","\n","def corregir_incompatibilidad_binaria_numpy_sklearn():\n","    print(\"🔍 Verificando conflictos binarios NumPy/SKLearn…\")\n","    try:\n","        import numpy as np\n","        from sklearn.utils._seq_dataset import ArrayDataset32, ArrayDataset64\n","        arr = np.array([[1.0],[2.0]], dtype=np.float64); sw = np.array([1.0,1.0], dtype=np.float64)\n","        _ = ArrayDataset32(arr, arr, sw); _ = ArrayDataset64(arr, arr, sw)\n","        print(\"✅ sklearn.utils._seq_dataset OK\")\n","    except Exception as e:\n","        print(\"⚠️ Incompatibilidad detectada. Reinstalando numpy/scikit-learn…\")\n","        print(traceback.format_exc())\n","        subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"--force-reinstall\", \"--no-cache-dir\",\n","                               \"--prefer-binary\", \"numpy==1.26.4\", \"scikit-learn==1.3.2\"])\n","        importlib.invalidate_caches()\n","        print(\"✅ Conflicto corregido\")\n","\n","def verificar_e_instalar_transformers():\n","    print(\"🔍 Chequeando Transformers (no bloqueante)…\")\n","    try:\n","        import transformers as _t\n","        print(f\"✅ Transformers disponible: {getattr(_t,'__version__','?')}\")\n","    except Exception as e:\n","        print(f\"ℹ️ Instalando Transformers mínimo: {e}\")\n","        try:\n","            subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"--upgrade\", \"--prefer-binary\", \"transformers==4.38.2\", \"torch==2.2.2\"])\n","            import transformers as _t2\n","            print(f\"✅ Transformers instalado: {getattr(_t2,'__version__','?')}\")\n","        except Exception as e2:\n","            print(f\"⚠️ Seguimos sin Transformers (no crítico): {e2}\")\n","\n","# ==================== UTILIDADES TIME/RUTAS ====================\n","warnings.filterwarnings(\"ignore\", category=DeprecationWarning, message=r\".*utcnow\\(\\) is deprecated.*\")\n","def utc_now_iso(): return datetime.now(timezone.utc).replace(microsecond=0).isoformat()\n","\n","def _tz_str(tzname: str) -> str:\n","    try:\n","        import pytz\n","        now = datetime.now(pytz.timezone(tzname))\n","        return now.strftime(\"%Y-%m-%d %H:%M:%S %Z\")\n","    except Exception:\n","        return datetime.now().strftime(\"%Y-%m-%d %H:%M:%S local\")\n","\n","def tz_ny_str(): return _tz_str(\"America/New_York\")\n","def tz_bogota_str(): return _tz_str(\"America/Bogota\")\n","\n","def _ensure_parent_dir(path: str):\n","    d = os.path.dirname(path)\n","    if d and not os.path.exists(d):\n","        os.makedirs(d, exist_ok=True)\n","\n","# ✅ FIX PERMANENTE: paréntesis emparejado correctamente\n","BASE_DIR = os.path.abspath(os.getenv(\"QTC_BASE_DIR\", \".\"))\n","OUT_DIR  = os.path.join(BASE_DIR, os.getenv(\"VIZ_OUT_DIR\",\"resultados_graficos\"))\n","LOG_DIR  = os.path.join(BASE_DIR, os.getenv(\"QTC_LOG_DIR\",\"resultados\"))\n","os.makedirs(OUT_DIR, exist_ok=True); os.makedirs(LOG_DIR, exist_ok=True)\n","PRUEBA_CSV = os.path.join(LOG_DIR,\"resultados_prueba.csv\")\n","REALES_CSV = os.path.join(LOG_DIR,\"resultados_reales.csv\")\n","\n","# ==================== CONFIG GLOBAL ====================\n","@dataclass\n","class Config:\n","    PAR_TRADING: str = os.getenv(\"PAR_TRADING\",\"XXBTZUSD\")\n","    INTERVAL: int = int(os.getenv(\"INTERVAL\",\"1\"))          # minutos para OHLC\n","    MODEL_INPUT_WINDOW: int = int(os.getenv(\"MODEL_INPUT_WINDOW\",\"64\"))\n","    VIZ_PERIOD_S: int = int(os.getenv(\"VIZ_PERIOD_S\",\"120\"))\n","    GOAL_MIN_PROFIT: float = float(os.getenv(\"GOAL_MIN_PROFIT\",\"0.015\"))\n","    GOAL_MAX_PROFIT: float = float(os.getenv(\"GOAL_MAX_PROFIT\",\"0.12\"))\n","\n","# ==================== VISUAL HELPERS ====================\n","def _try_display_links(*files):\n","    try:\n","        from IPython.display import display, HTML, Image as Img, clear_output\n","        clear_output(wait=True)\n","        print(\"📸 Render en vivo:\")\n","        for f in files:\n","            if f and os.path.exists(f):\n","                display(Img(filename=f))\n","                display(HTML(f'<div style=\"margin:6px 0\">🔗 <a href=\"files/{os.path.abspath(f)}\" download target=\"_blank\">{os.path.basename(f)}</a></div>'))\n","    except Exception:\n","        for f in files:\n","            if f and os.path.exists(f):\n","                print(f\"🔗 {os.path.abspath(f)}\")\n","\n","# ==================== KALMAN & MATPLOTLIB ====================\n","try:\n","    _Kalman1D  # noqa\n","except NameError:\n","    import math as _math\n","    class _Kalman1D:\n","        __slots__=(\"x\",\"P\",\"Q\",\"R\",\"K\")\n","        def __init__(self, x0=0.0, p0=1.0, q=1e-3, r=1e-2): self.x=float(x0); self.P=float(p0); self.Q=float(q); self.R=float(r); self.K=0.0\n","        def update(self, z: float) -> float:\n","            self.P=self.P+self.Q; S=self.P+self.R if self.P+self.R>0 else 1e-6\n","            self.K=self.P/S; zf=float(z) if _math.isfinite(z) else self.x\n","            self.x=self.x+self.K*(zf-self.x); self.P=(1.0-self.K)*self.P\n","            return self.x\n","        __call__=update\n","\n","import matplotlib\n","try:\n","    if \"inline\" not in matplotlib.get_backend().lower():\n","        matplotlib.use(\"Agg\", force=True)\n","except Exception: pass\n","import matplotlib.pyplot as plt\n","plt.rcParams[\"axes.unicode_minus\"] = False\n","\n","# ==================== NORMALIZADOR DE PAR ====================\n","def _canon_pair(v: str) -> str:\n","    if not v: return \"XXBTZUSD\"\n","    u = str(v).strip().upper().replace(\"/\",\"\")\n","    u = u.replace(\"BTC\",\"XBT\")\n","    return \"XXBTZUSD\" if u in (\"XBTUSD\",\"XXBTZUSD\",\"XBTZUSD\",\"BTCUSD\",\"BTCZUSD\") else u\n","\n","# ==================== API KRAKEN (pública) ====================\n","class PublicKrakenLite:\n","    API_URL = \"https://api.kraken.com/0/public/\"\n","    UA = \"TTDVI156/UltraMatrix v4\"\n","    def _get(self, path: str, params: dict | None = None) -> dict:\n","        import urllib.parse, urllib.request, ssl, json as _json\n","        params = dict(params or {})\n","        if \"pair\" in params and isinstance(params[\"pair\"], str):\n","            params[\"pair\"] = _canon_pair(params[\"pair\"])\n","        url = self.API_URL + path + (\"?\" + urllib.parse.urlencode(params) if params else \"\")\n","        req = urllib.request.Request(url, headers={\"User-Agent\": self.UA, \"Accept\": \"application/json\"})\n","        ctx = ssl.create_default_context()\n","        _touch_hb()\n","        with urllib.request.urlopen(req, context=ctx, timeout=15) as r:\n","            txt = r.read().decode(\"utf-8\",\"replace\")\n","            res = _json.loads(txt)\n","        if res.get(\"result\"): _notify_data(time.time())\n","        if res.get(\"error\"):\n","            if any(\"Unknown asset pair\" in e for e in res[\"error\"]) and params.get(\"pair\")!=\"XXBTZUSD\":\n","                params[\"pair\"]=\"XXBTZUSD\"\n","                url2 = self.API_URL + path + \"?\" + urllib.parse.urlencode(params)\n","                with urllib.request.urlopen(urllib.request.Request(url2, headers={\"User-Agent\": self.UA}), context=ctx, timeout=15) as r2:\n","                    res2 = _json.loads(r2.read().decode(\"utf-8\",\"replace\"))\n","                if res2.get(\"result\"): _notify_data(time.time())\n","                return res2\n","        return res\n","    async def query_public(self, endpoint: str, data: dict | None = None) -> dict:\n","        loop = asyncio.get_running_loop()\n","        return await loop.run_in_executor(None, lambda: self._get(endpoint, data or {}))\n","    async def get_price(self, pair: str = \"XXBTZUSD\") -> float:\n","        r = await self.query_public(\"Ticker\", {\"pair\": _canon_pair(pair)})\n","        res = r.get(\"result\", {})\n","        if not res: return 0.0\n","        key = _canon_pair(pair) if _canon_pair(pair) in res else next(iter(res))\n","        px = float(res[key][\"c\"][0])\n","        _notify_data(time.time()); _touch_hb()\n","        return px\n","\n","def auto_api(): return PublicKrakenLite()\n","\n","async def _get_ohlc(api, pair=\"XXBTZUSD\", interval=1, limit=120) -> List[List[float]]:\n","    pair=_canon_pair(pair)\n","    try:\n","        since = int(time.time()) - int(interval)*60*int(limit*2)\n","        r = await api.query_public(\"OHLC\", {\"pair\": pair, \"interval\": int(interval), \"count\": int(limit), \"since\": since})\n","        result = r.get(\"result\", {})\n","        serie = next((v for k,v in result.items() if k!=\"last\" and isinstance(v,list)), [])\n","        out=[]\n","        for row in serie[-limit:]:\n","            ts=float(row[0]); ts = ts/1000.0 if ts>10**12 else ts\n","            o,h,l,c = float(row[1]),float(row[2]),float(row[3]),float(row[4])\n","            out.append([ts,o,h,l,c])\n","        if out:\n","            _notify_data(out[-1][0]); _touch_hb()\n","            return out\n","    except Exception:\n","        pass\n","    # Fallback sintético\n","    try: base = await auto_api().get_price(pair) or 30000.0\n","    except Exception: base = 30000.0\n","    step=60*max(1,int(interval)); now=time.time(); out=[]; last=base\n","    for i in range(limit,0,-1):\n","        ts=now-i*step; drift=(random.random()-0.5)*base*0.0008\n","        o=last; c=max(1e-6, o+drift); h=max(o,c)+abs(drift)*0.35; l=min(o,c)-abs(drift)*0.35\n","        out.append([ts,o,h,l,c]); last=c\n","    _notify_data(out[-1][0]); _touch_hb()\n","    return out\n","\n","# ==================== PREDICTORES / CORE ====================\n","class PredictorBase:\n","    def __init__(self, name=\"base\"):\n","        self.name=name; self.history: List[float]=[]; self.kf=_Kalman1D()\n","        self.model_path=f\"state/{name}.keras\"; os.makedirs(os.path.dirname(self.model_path), exist_ok=True)\n","    def historial_completo(self) -> bool:\n","        return len(self.history) >= Config.MODEL_INPUT_WINDOW\n","    async def entrenar_modelo_inicial(self):\n","        # Entrenamiento ligero simulado (idempotente)\n","        if not self.historial_completo(): return\n","        for _ in range(3):  # 3 pasadas simples\n","            for v in self.history[-Config.MODEL_INPUT_WINDOW:]:\n","                self.kf.update(v/ (self.history[-1]+1e-9))\n","        _touch_hb()\n","    def _ema(self, arr, p):\n","        a=2.0/(p+1.0); s=None; out=[]\n","        for v in arr: s = v if s is None else a*v + (1-a)*s; out.append(s)\n","        return out\n","    def predecir(self, serie: List[float]) -> float:\n","        if not serie: return 0.0\n","        ema8 = self._ema(serie[-64:],8)[-1]; ema21 = self._ema(serie[-64:],21)[-1]\n","        raw = (ema8 - ema21)/(serie[-1]+1e-9)\n","        val = float(self.kf.update(raw))\n","        _touch_hb(); return val\n","    async def predecir_precio_futuro(self, last_price: float) -> float:\n","        s = self.predecir(self.history or [last_price])\n","        _notify_data(time.time())\n","        return float(last_price) * (1.0 + float(s))\n","\n","class PredictorAlcista(PredictorBase): ...\n","class PredictorBajista(PredictorBase):  ...\n","\n","class QuantumTradingCore:\n","    def __init__(self, api):\n","        self.api=api\n","        self.predictor_alcista = PredictorAlcista(\"pred_up\")\n","        self.predictor_bajista = PredictorBajista(\"pred_dn\")\n","        self.market_monitor = None\n","        self.mode=\"DEMO\"\n","    async def initialize(self): _touch_hb(); return True\n","    def set_mode(self, m: str): self.mode=m\n","    def enable_real_trading(self, flag: bool): self.mode=\"REAL\" if flag else \"DEMO\"\n","    async def run_strategy_generador(self):\n","        # Generador para MODO REAL (demo)\n","        while True:\n","            price = await self.api.get_price(Config.PAR_TRADING)\n","            _notify_data(time.time()); _touch_hb()\n","            yield {\"tipo\":\"DEMO\", \"precio_entrada\":price, \"precio_salida\":price*(1+0.002), \"porcentaje_ganancia\":0.2, \"comentario\":\"ciclo demo\"}\n","            await asyncio.sleep(max(5, Config.VIZ_PERIOD_S))\n","\n","# ==================== EJECUTOR / RIESGO (stubs seguros si faltan) ====================\n","class GestorRiesgo:\n","    def __init__(self, api): self.api=api\n","    async def initialize(self): _touch_hb(); return True\n","    async def on_market_tick(self, price: float, pair: str): _touch_hb(); return\n","\n","class EnhancedOrderExecutor:\n","    def __init__(self, api, risk_manager):\n","        self.api=api; self.risk=risk_manager\n","        self.target_min_profit=Config.GOAL_MIN_PROFIT\n","        self.target_max_profit=Config.GOAL_MAX_PROFIT\n","        self.mode=\"DEMO\"; self.live=False\n","    def set_mode(self, m:str): self.mode=m\n","    def set_live(self, flag: bool): self.live=flag\n","    async def on_market_tick(self, price: float, pair: str): _touch_hb(); return\n","    async def execute_order(self, side: str, predicted_change: float=0.0):\n","        print(f\"🛒 EXEC {side.upper()} | Δpred={predicted_change:.4f} | objetivo [{self.target_min_profit:.3f}, {self.target_max_profit:.3f}]\")\n","        _notify_data(time.time()); return True\n","    async def execute_safe_sale(self, _): return True\n","\n","# ==================== OBJETIVO +156% ENFORCEMENT ====================\n","class ObjetivoUniversal156:\n","    def __init__(self, minp: float, maxp: float): self.min=minp; self.max=maxp\n","    def apply(self, executor: EnhancedOrderExecutor):\n","        executor.target_min_profit=self.min; executor.target_max_profit=self.max\n","\n","# ==================== COMPLETAR HISTORIAL ====================\n","async def completar_historial_para_predictores(p_up: PredictorBase, p_dn: PredictorBase, api):\n","    print(\"⏳ Completando historial para predictores…\")\n","    interval = Config.INTERVAL; ventana = Config.MODEL_INPUT_WINDOW\n","    intentos=0\n","    while (len(p_up.history) < ventana or\n","           len(p_dn.history) < ventana) and intentos < 120:\n","        try:\n","            ohlc = await _get_ohlc(api, pair=Config.PAR_TRADING, interval=interval, limit=ventana)\n","            precios = [float(c[4]) for c in ohlc]\n","            if precios:\n","                for px in precios:\n","                    if len(p_up.history) < ventana: p_up.history.append(px)\n","                    if len(p_dn.history) < ventana: p_dn.history.append(px)\n","                _notify_data(time.time())\n","                print(f\"📈 Historial: up={len(p_up.history)} / dn={len(p_dn.history)} / win={ventana}\")\n","        except Exception as e:\n","            print(f\"⚠️ OHLC: {e}\")\n","        _touch_hb(); await asyncio.sleep(1); intentos += 1\n","    if p_up.historial_completo() and p_dn.historial_completo():\n","        print(\"✅ Historial completo para ambos predictores.\")\n","    else:\n","        print(\"⛔ No se alcanzó el mínimo; seguimos con lo disponible.\")\n","\n","# ==================== VISUAL: Sentimiento/Retro/Dashboard ====================\n","def _ema(arr, p):\n","    a=2.0/(p+1.0); s=None; out=[]\n","    for v in arr: s = v if s is None else a*v + (1-a)*s; out.append(s)\n","    return out\n","\n","def _plot_sentimiento_gauge(nivel: float, ts_label: str) -> str:\n","    nivel=float(max(-12.0,min(12.0,nivel)))\n","    plt.figure(figsize=(9.6,2.8))\n","    plt.axvspan(-12,-5,alpha=0.12); plt.axvspan(-5,-2,alpha=0.10); plt.axvspan(-2,2,alpha=0.08)\n","    plt.axvspan(2,5,alpha=0.10);  plt.axvspan(5,12,alpha=0.12); plt.axvline(x=0,linestyle=\"--\",linewidth=0.9)\n","    plt.barh([0],[nivel],height=0.36)\n","    plt.yticks([]); title = \"🧠 Sentimiento BTC — \"\n","    title += \"🚀 EUFORIA\" if nivel>5 else \"📈 OPTIMISMO\" if nivel>2 else \"💥 PÁNICO\" if nivel<-5 else \"📉 MIEDO\" if nivel<-2 else \"😐 NEUTRO\"\n","    plt.title(f\"{title} | Nivel: {nivel:+.2f}\\n{ts_label}\")\n","    plt.xlabel(\"Índice: dirección% − 10×volatilidad\")\n","    path=os.path.join(OUT_DIR,f\"sentimiento_{time.strftime('%Y%m%d_%H%M%S')}.png\")\n","    plt.tight_layout(); plt.savefig(path,dpi=150); plt.close(); return path\n","\n","async def evaluar_sentimiento(api, pair=\"XXBTZUSD\", interval=15) -> Dict[str,Any]:\n","    import numpy as np\n","    rows = await _get_ohlc(api, pair=_canon_pair(pair), interval=interval, limit=max(40, interval*6))\n","    if len(rows)<10: return {\"sentimiento\":\"neutro\",\"nivel\":0.0,\"png\":None}\n","    closes=[r[4] for r in rows]; direccion=closes[-1]-closes[0]\n","    direccion_pct=(direccion/(closes[0]+1e-12))*100.0\n","    rets=np.diff(closes); vola=float(np.std(rets)) if len(rets) else 0.0\n","    nivel=(direccion_pct)-(vola*10.0)\n","    png=_plot_sentimiento_gauge(nivel, datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC'))\n","    _notify_data(time.time()); _touch_hb()\n","    snt = \"euforia\" if nivel>5 else \"optimismo\" if nivel>2 else \"pánico\" if nivel<-5 else \"miedo\" if nivel<-2 else \"neutro\"\n","    return {\"sentimiento\":snt, \"nivel\":round(float(max(-12.0,min(12.0,nivel))),2), \"volatilidad\":round(float(vola),6),\n","            \"direccion_pct\":round(float(direccion_pct),2), \"png\":png}\n","\n","def _plot_retro_1h(ohlc_1h: List[List[float]]) -> str:\n","    if not ohlc_1h:\n","        path=os.path.join(OUT_DIR,f\"retro_{time.strftime('%Y%m%d_%H%M%S')}.png\")\n","        fig=plt.figure(figsize=(10,4)); ax=fig.add_subplot(111); ax.axis(\"off\"); ax.text(0.05,0.6,\"Retro 1h (sin datos)\",fontsize=14)\n","        fig.tight_layout(); fig.savefig(path,dpi=140); plt.close(fig); return path\n","    ts=[r[0] for r in ohlc_1h]; cls=[r[4] for r in ohlc_1h]\n","    ema8=_ema(cls,8); ema21=_ema(cls,21)\n","    import matplotlib.dates as mdates\n","    xs=[datetime.fromtimestamp(t, timezone.utc) for t in ts]; xnum=mdates.date2num(xs)\n","    plt.figure(figsize=(12,5))\n","    plt.plot(xnum,cls,linewidth=1.8,label=\"Cierre 1h\")\n","    plt.plot(xnum,ema8,linewidth=1.1,label=\"EMA 8\")\n","    plt.plot(xnum,ema21,linewidth=1.1,label=\"EMA 21\")\n","    plt.gca().xaxis.set_major_formatter(mdates.DateFormatter('%m-%d %H:%M')); plt.grid(True,alpha=0.25)\n","    plt.title(\"🔎 Retro BTC/USD — 1h (principal)\"); plt.legend()\n","    path=os.path.join(OUT_DIR,f\"retro_{time.strftime('%Y%m%d_%H%M%S')}.png\")\n","    plt.tight_layout(); plt.savefig(path,dpi=150); plt.close(); return path\n","\n","def _plot_candles(ax, times_s, O,H,L,C):\n","    import matplotlib.dates as mdates\n","    from matplotlib.patches import Rectangle\n","    xs_dt=[datetime.fromtimestamp(t, timezone.utc) for t in times_s]\n","    xs=mdates.date2num(xs_dt); avg_gap=(xs[-1]-xs[0])/(len(xs)-1) if len(xs)>=2 else 1/1440.0\n","    w=max(avg_gap*0.7,1.0/2880.0); ax.xaxis.set_major_formatter(mdates.DateFormatter('%H:%M')); ax.grid(True,alpha=0.25)\n","    for x,o,h,l,c in zip(xs,O,H,L,C):\n","        color=('green' if c>=o else 'red'); ax.vlines(x,l,h,linewidth=0.9,color=color,alpha=0.9)\n","        rect=Rectangle((x-w/2,min(o,c)),w,abs(c-o),facecolor=color,edgecolor=color,alpha=0.6)\n","        ax.add_patch(rect)\n","\n","def _projection_60m(times, closes, price_now) -> float:\n","    n=min(120,len(closes))\n","    if n<5: return float(price_now or (closes[-1] if closes else 0.0))\n","    y=[float(v) for v in closes[-n:]]; x=list(range(n)); sx=sum(x); sy=sum(y)\n","    sxx=sum(i*i for i in x); sxy=sum(i*j for i,j in zip(x,y)); denom=n*sxx - sx*sx\n","    m=0.0 if abs(denom)<1e-12 else (n*sxy - sx*sy)/denom\n","    return float(price_now or y[-1]) + 60.0*float(m)\n","\n","async def render_dashboard_1m(api=None) -> str:\n","    api=api or auto_api()\n","    ohlc=await _get_ohlc(api,pair=Config.PAR_TRADING,interval=1,limit=180)\n","    t=[r[0] for r in ohlc]; O=[r[1] for r in ohlc]; H=[r[2] for r in ohlc]; L=[r[3] for r in ohlc]; C=[r[4] for r in ohlc]\n","    price_now=await api.get_price(Config.PAR_TRADING); proy_60=_projection_60m(t,C,price_now)\n","    fig=plt.figure(figsize=(12.5,6.0)); ax=fig.add_subplot(111); _plot_candles(ax,t,O,H,L,C)\n","    if t and C:\n","        x_last=datetime.fromtimestamp(t[-1],timezone.utc); x_future=datetime.fromtimestamp(t[-1]+60*60,timezone.utc)\n","        ax.plot([x_last],[price_now or C[-1]],marker='o',linestyle='--',linewidth=1.6,label=f\"💵 Actual: ${float(price_now or C[-1]):.2f}\")\n","        ax.plot([x_last,x_future],[price_now or C[-1],proy_60],linestyle=':',linewidth=2.2,label=f\"🎯 Proyección 60m: ${proy_60:.2f}\")\n","    ax.set_title(\"📉 BTC/USD — Velas 1m + Proyección 60m\"); ax.legend(loc=\"upper left\"); ax.grid(True,alpha=0.3)\n","    path=os.path.join(OUT_DIR,f\"dashboard_{time.strftime('%Y%m%d_%H%M%S')}.png\"); plt.tight_layout(); plt.savefig(path,dpi=150); plt.close(fig)\n","    _notify_data(time.time()); _touch_hb()\n","    return path\n","\n","async def generar_visual(api=None):\n","    api=api or auto_api()\n","    ohlc_1h=await _get_ohlc(api, pair=Config.PAR_TRADING, interval=60, limit=48)\n","    retro_png=_plot_retro_1h(ohlc_1h)\n","    sent=await evaluar_sentimiento(api, pair=Config.PAR_TRADING, interval=15)\n","    dash=await render_dashboard_1m(api)\n","    _try_display_links(retro_png, sent.get(\"png\"), dash)\n","    return retro_png, sent.get(\"png\"), dash\n","\n","# ==================== MARKET MONITOR ====================\n","# [AUTO-REAL] Umbral de transición configurable por env (default 50)\n","_AUTO_REAL_AFTER = int(os.getenv(\"AUTO_REAL_AFTER_CYCLES\", os.getenv(\"DEMO_MAX_TESTS\",\"50\")))\n","_real_activado_evt = asyncio.Event()  # [REAL-ACTIVATION] flag global idempotente\n","\n","class MarketMonitor:\n","    def __init__(self, api, p_up: PredictorBase, p_dn: PredictorBase, executor: EnhancedOrderExecutor, start_full_cb=None):\n","        self.api=api; self.pu=p_up; self.pd=p_dn; self.exe=executor\n","        self.price_history: List[float]=[]\n","        self._count=0\n","        self._demo_max = _AUTO_REAL_AFTER  # [AUTO-REAL] usa env\n","        self.start_full_cb=start_full_cb\n","    async def update_market_data(self):\n","        price = await self.api.get_price(Config.PAR_TRADING)\n","        self.price_history.append(price)\n","        if len(self.price_history)>360: self.price_history=self.price_history[-360:]\n","        up = self.pu.predecir(self.price_history)\n","        dn = self.pd.predecir(self.price_history)\n","        signal = up - abs(dn)*0.3\n","        if signal>=Config.GOAL_MIN_PROFIT: await self.exe.execute_order(\"buy\", signal)\n","        elif signal<=-Config.GOAL_MIN_PROFIT: await self.exe.execute_order(\"sell\", -signal)\n","        self._count+=1\n","        _notify_data(time.time()); _touch_hb()\n","        if (self._count>=self._demo_max) and callable(self.start_full_cb) and (not _real_activado_evt.is_set()):\n","            await self.start_full_cb()\n","        return price, signal\n","\n","# ==================== KAFKA BRIDGE (opcional) ====================\n","class PipelineBridge:\n","    def __init__(self, bootstrap: Optional[str], topic: Optional[str]):\n","        self.bootstrap=bootstrap; self.topic=topic\n","        self.enabled = bool(bootstrap and topic)\n","    async def run(self):\n","        if not self.enabled:\n","            print(\"ℹ️ Kafka Bridge deshabilitado (define KAFKA_BOOTSTRAP y KAFKA_TOPIC_SIGNALS).\"); return\n","        try:\n","            from aiokafka import AIOKafkaConsumer\n","            loop = asyncio.get_running_loop()\n","            consumer = AIOKafkaConsumer(self.topic, loop=loop, bootstrap_servers=self.bootstrap, auto_offset_reset=\"latest\")\n","            await consumer.start(); print(f\"🔌 Kafka Bridge conectado a {self.bootstrap} topic={self.topic}\")\n","            try:\n","                async for msg in consumer:\n","                    print(f\"📡 btc-signals: {msg.value[:128]}{'…' if len(msg.value)>128 else ''}\")\n","                    _notify_data(time.time()); _touch_hb()\n","            finally:\n","                await consumer.stop()\n","        except Exception as e:\n","            print(f\"⚠️ Kafka Bridge error (no crítico): {e}\")\n","\n","# ==================== LOOP DE VISUAL/TRADING ====================\n","async def run_once(api, core: QuantumTradingCore, executor: EnhancedOrderExecutor):\n","    price = await api.get_price(Config.PAR_TRADING)\n","    newfile = not os.path.exists(REALES_CSV); _ensure_parent_dir(REALES_CSV)\n","    with open(REALES_CSV, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n","        w = csv.writer(f)\n","        if newfile: w.writerow([\"ts_utc\",\"pair\",\"price\"])\n","        w.writerow([utc_now_iso(), Config.PAR_TRADING, f\"{float(price):.8f}\"])\n","    try: await generar_visual(api)\n","    except Exception as e: print(f\"⚠️ Visual no crítico: {e}\")\n","    if core.market_monitor is None:\n","        # [REAL-ACTIVATION] inyectamos el callback de escalamiento aquí\n","        async def _cb():\n","            await activar_modo_real(api, core, executor)\n","        core.market_monitor = MarketMonitor(api, core.predictor_alcista, core.predictor_bajista, executor, start_full_cb=_cb)\n","    try: await core.market_monitor.update_market_data()\n","    except Exception as e: print(f\"⚠️ Tick core: {e}\")\n","    _notify_data(time.time()); _touch_hb()\n","    print(f\"🔹 run_once → {Config.PAR_TRADING} = {price}\")\n","\n","async def run_loop(api, core, executor, period_s: Optional[int]=None):\n","    ps = int(period_s or Config.VIZ_PERIOD_S)\n","    print(f\"⏱️ Loop vivo cada {ps}s\")\n","    while True:\n","        try: await run_once(api, core, executor)\n","        except Exception as e: print(f\"⚠️ loop: {e}\")\n","        _touch_hb(); await asyncio.sleep(max(30, ps))\n","\n","# ==================== ACTIVACIÓN REAL (segura, idempotente) ====================\n","# [REAL-ACTIVATION]\n","_live_task_holder = {\"task\": None}\n","\n","async def activar_modo_real(api, core, executor):\n","    \"\"\"Activa REAL una sola vez y dispara el loop vivo.\"\"\"\n","    if _real_activado_evt.is_set():\n","        return\n","    _real_activado_evt.set()\n","    core.enable_real_trading(True)\n","    executor.set_mode(\"REAL\")\n","    executor.set_live(True)\n","    print(f\"✅ Transición AUTOMÁTICA a MODO REAL tras {_AUTO_REAL_AFTER} ciclos.\")\n","    # Lanzar loop vivo si no existe\n","    if _live_task_holder[\"task\"] is None or _live_task_holder[\"task\"].done():\n","        task = asyncio.create_task(run_loop(api, core, executor, period_s=Config.VIZ_PERIOD_S), name=\"ttdvi_live_loop\")\n","        _attach_task_logging(task, \"ttdvi_live_loop\")\n","        _live_task_holder[\"task\"] = task\n","        print(f\"📡 Visual + trading en vivo activo (loop {Config.VIZ_PERIOD_S}s).\")\n","\n","# ==================== MAIN UNIFICADO ====================\n","async def main_unificado():\n","    # Verbose/silencios\n","    os.environ.setdefault(\"TF_CPP_MIN_LOG_LEVEL\",\"2\")\n","    logging = __import__(\"logging\"); logging.captureWarnings(True); logging.getLogger().setLevel(logging.ERROR)\n","\n","    # (Opcional) deps + fixes\n","    try: instalar_dependencias_controladas()\n","    except Exception as e: print(f\"⚠️ deps: {e}\")\n","    try: corregir_incompatibilidad_binaria_numpy_sklearn()\n","    except Exception as e: print(f\"⚠️ numpy/sklearn: {e}\")\n","    try: verificar_e_instalar_transformers()\n","    except Exception as e: print(f\"⚠️ transformers: {e}\")\n","\n","    # Tiempos de referencia\n","    try: print(f\"🕒 NY: {tz_ny_str()} | Bogotá: {tz_bogota_str()}\")\n","    except Exception: pass\n","\n","    # API/Core\n","    api = auto_api()\n","    risk = GestorRiesgo(api); await risk.initialize()\n","    executor = EnhancedOrderExecutor(api, risk)\n","    core = QuantumTradingCore(api); await core.initialize()\n","\n","    # Objetivo universal +156% (enforcement min/max por trade)\n","    ObjetivoUniversal156(Config.GOAL_MIN_PROFIT, Config.GOAL_MAX_PROFIT).apply(executor)\n","\n","    # Historial + entrenamiento\n","    await completar_historial_para_predictores(core.predictor_alcista, core.predictor_bajista, api)\n","    await core.predictor_alcista.entrenar_modelo_inicial()\n","    await core.predictor_bajista.entrenar_modelo_inicial()\n","\n","    # Bridge Kafka (opcional)\n","    bridge = PipelineBridge(os.getenv(\"KAFKA_BOOTSTRAP\"), os.getenv(\"KAFKA_TOPIC_SIGNALS\"))\n","    if bridge.enabled:\n","        task = asyncio.create_task(bridge.run(), name=\"ttdvi_kafka_bridge\")\n","        _attach_task_logging(task, \"ttdvi_kafka_bridge\")\n","\n","    # Modo y estrategia de escalamiento\n","    modo = obtener_modo_ejecucion()\n","    print(f\"🚀 Modo solicitado: {modo.upper()}\")\n","\n","    # Forzar REAL inmediato si se requiere\n","    if os.getenv(\"REAL_FORCE_NOW\",\"0\").strip() in (\"1\",\"true\",\"on\",\"si\",\"sí\"):\n","        await activar_modo_real(api, core, executor)\n","    else:\n","        # Arrancamos en DEMO y dejamos que MarketMonitor escale a REAL al alcanzar el umbral\n","        core.enable_real_trading(False)\n","        executor.set_mode(\"DEMO\")\n","        executor.set_live(False)\n","        print(f\"🧪 Iniciando fase DEMO por {_AUTO_REAL_AFTER} ciclos antes de activar REAL automáticamente…\")\n","\n","    # PRUEBA: si se pidió \"prueba\", se genera un CSV breve (sin interferir la transición auto)\n","    if modo == \"prueba\":\n","        _ensure_parent_dir(PRUEBA_CSV)\n","        with open(PRUEBA_CSV,\"w\",newline=\"\",encoding=\"utf-8\") as f:\n","            w = csv.writer(f)\n","            w.writerow([\"Ciclo\",\"Timestamp\",\"Precio\",\"Pred.up(%)\",\"Pred.dn(%)\",\"Señal(%)\",\"Decisión\"])\n","            for i in range(10):\n","                # Garantiza que el monitor exista\n","                if core.market_monitor is None:\n","                    await run_once(api, core, executor)\n","                price = await api.get_price(Config.PAR_TRADING)\n","                serie = core.market_monitor.price_history or [price]\n","                p_up = core.predictor_alcista.predecir(serie)\n","                p_dn = core.predictor_bajista.predecir(serie)\n","                signal = p_up - abs(p_dn)*0.3\n","                decision = \"BUY\" if signal>=Config.GOAL_MIN_PROFIT else (\"SELL\" if signal<=-Config.GOAL_MIN_PROFIT else \"HOLD\")\n","                print(f\"🧪 Ciclo {i+1} | px={price:.2f} | up={p_up*100:+.2f}% dn={p_dn*100:+.2f}% | sig={signal*100:+.2f}% → {decision}\")\n","                w.writerow([i+1, utc_now_iso(), f\"{price:.2f}\", f\"{p_up*100:.2f}\", f\"{p_dn*100:.2f}\", f\"{signal*100:.2f}\", decision])\n","                _notify_data(time.time()); _touch_hb()\n","                await asyncio.sleep(2)\n","        print(f\"📄 CSV prueba → {PRUEBA_CSV}\")\n","\n","    # Bucle de preparación/visual hasta escalar a REAL automáticamente\n","    try:\n","        # Asegura primer tick (crea monitor y callback)\n","        await run_once(api, core, executor)\n","\n","        # Mientras no se active REAL, seguimos “pre-real” alimentando datos y visuales\n","        while not _real_activado_evt.is_set():\n","            await asyncio.sleep(max(10, Config.VIZ_PERIOD_S))\n","            await run_once(api, core, executor)\n","\n","        # Una vez activado REAL (por callback), si no hay loop vivo, lo lanzamos\n","        if _live_task_holder[\"task\"] is None or _live_task_holder[\"task\"].done():\n","            await activar_modo_real(api, core, executor)\n","\n","        # Si estamos corriendo como script puro, mantenemos vivo\n","        if \"get_ipython\" not in globals():\n","            while True:\n","                _touch_hb(); await asyncio.sleep(3600)\n","\n","    except KeyboardInterrupt:\n","        print(\"\\n🔴 Interrupción manual. Cerrando…\")\n","        try: await executor.execute_safe_sale(Decimal('0'))\n","        except Exception: pass\n","    except Exception as e:\n","        print(f\"🚨 Error main: {e}\")\n","        raise\n","\n","# ==================== LANZADOR RESILIENTE / ENCHUFE ====================\n","def _shell_name():\n","    obj=globals().get(\"get_ipython\",None)\n","    if not callable(obj): return None\n","    try: sh=obj(); return getattr(getattr(sh,\"__class__\",None),\"__name__\",None)\n","    except Exception: return None\n","\n","# Alias estándar para la capa previa de autorun/factory-discovery:\n","run_loop_principal = main_unificado  # <— **ENCHUFE CLAVE**\n","\n","def _launch_direct():\n","    \"\"\"Fallback directo si no está presente el supervisor resiliente.\"\"\"\n","    shell=_shell_name()\n","    try:\n","        if shell in (\"ZMQInteractiveShell\",\"TerminalInteractiveShell\",\"Shell\"):\n","            try:\n","                import nest_asyncio; nest_asyncio.apply()\n","            except Exception: pass\n","            loop=asyncio.get_event_loop()\n","            if loop.is_running():\n","                task = loop.create_task(main_unificado(), name=\"ttdvi156_main\")\n","                _attach_task_logging(task, \"ttdvi156_main\")\n","                print(\"✅ main() lanzado como tarea (Jupyter).\")\n","            else:\n","                loop.run_until_complete(main_unificado())\n","        else:\n","            asyncio.run(main_unificado())\n","    except RuntimeError:\n","        loop=asyncio.get_event_loop(); task = loop.create_task(main_unificado()); _attach_task_logging(task, \"ttdvi156_main\"); print(\"✅ main() activo (fallback).\")\n","\n","if __name__ == \"__main__\":\n","    try:\n","        # Si existe el supervisor resiliente y el lanzador seguro, usarlos:\n","        if callable(_run_with_resilience):\n","            async def _factory(): return await main_unificado()\n","            if callable(_run_async_safely):\n","                _run_async_safely(_run_with_resilience(_factory))\n","            else:\n","                asyncio.run(_run_with_resilience(_factory))\n","        else:\n","            _launch_direct()\n","    except Exception as e:\n","        print(f\"❌ Arranque fallido: {e}\")\n","        traceback.print_exc()\n","        # último recurso\n","        try: asyncio.run(main_unificado())\n","        except Exception as e2:\n","            print(f\"❌ Segundo intento fallido: {e2}\")"]},{"cell_type":"code","source":["\n","CLAVE API\n","\n","IAvqwWI6AajKXCTRPg19zL48jUgi36XzFGs2KiSSJvaOv+igTS7onORP\n","\n",".\n","\n","t7Z96+axonwRZeVgsn1D0iBGpsEVze/nT4fQpz4+rgM8g6hgofPANMTmQttnVuKnDz8LcQu1oCWG8iuURuwsBQ==\n"],"metadata":{"id":"7tlGq7gcS8AR"},"execution_count":null,"outputs":[]}]}