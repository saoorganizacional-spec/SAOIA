tr(self, \"_task\", None)\n","            cls.stop = stop\n","        cls._start_monitoring_compat_patched = True\n","\n","# Si la clase ya está definida arriba, injerta; si no, se injertará cuando exista.\n","try:\n","    _install_marketmonitor_start_shim()\n","except Exception:\n","    pass\n","# =========================================================================================================\n","\n","\n","import os\n","import json\n","from datetime import datetime\n","from decimal import Decimal\n","import numpy as np\n","import asyncio\n","import matplotlib.pyplot as plt\n","from pytz import timezone\n","\n","# ----------------- Helpers internos para normalizar par Kraken y claves de Ticker -----------------\n","def _kraken_pair_fix(p: str) -> str:\n","    p = (p or \"XBT/USD\")\n","    p = p.replace(\"/\", \"\").upper().replace(\"BTC\", \"XBT\")\n","    return \"XXBTZUSD\" if p in (\"XBTUSD\", \"XXBTZUSD\") else p\n","\n","def _extract_ticker_last(res: dict) -> Decimal:\n","    \"\"\"\n","    Extrae el 'last' del dict de Kraken de forma robusta (toma la primera clave si no coincide).\n","    \"\"\"\n","    if not res or \"result\" not in res or not res[\"result\"]:\n","        raise RuntimeError(\"Respuesta Ticker inválida\")\n","    k = None\n","    if \"result\" in res:\n","        # Prioriza la clave normalizada; si no existe, toma la primera\n","        keys = list(res[\"result\"].keys())\n","        k = keys[0]\n","        # Si existe la clave exacta, úsala\n","        par = _kraken_pair_fix(getattr(Config, \"PAR_TRADING\", \"XBT/USD\"))\n","        if par in res[\"result\"]:\n","            k = par\n","    last = res[\"result\"][k][\"c\"][0]\n","    return Decimal(str(last))\n","\n","# ====================================== QuantumTradingCore ======================================\n","class QuantumTradingCore:\n","    def __init__(self, api):\n","        self.api = api\n","        self.predictor_alcista = QuantumPredictorAlcista(api)\n","        s