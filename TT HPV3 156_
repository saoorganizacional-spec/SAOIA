 reentrenamiento desde JSON.\")\n","        except Exception as e:\n","            print(f\"❌ Error leyendo JSON para reentrenar: {e}\")\n","\n","    def make_decision(self, prediction: float, current_price: float) -> str:\n","        volatilidad = float(getattr(self.risk_manager, 'volatilidad', 0.05))\n","        buy_threshold = 0.5 + (volatilidad * 10)   # Mantengo tu lógica (prediction asumido en %)\n","        sell_threshold = 0.5 - (volatilidad * 10)\n","        if prediction > buy_threshold: return 'buy'\n","        elif prediction < sell_threshold: return 'sell'\n","        return 'hold'\n","\n","    def calculate_position_size(self, balance: Decimal, price: Decimal, prediction: float) -> Decimal:\n","        risk_adjusted = abs(prediction / 100.0) * float(getattr(Config, \"RISK_FACTOR\", 0.02))\n","        position_value = float(balance) * risk_adjusted\n","        return Decimal(position_value / float(price)).quantize(Decimal('0.00000001'))\n","\n","    async def execute_strategy(self, decision: str, prediction: float, current_price: Decimal):\n","        if decision == 'hold': return\n","        print(f\"📈 Señal de {decision.upper()} detectada (Predicción: {prediction:.2f}%)\")\n","        await self.order_executor.execute_order(decision, prediction)\n","        if getattr(Config, \"ESTRATEGIAS\", {}).get('volatility_arbitrage', False):\n","            await self.execute_volatility_arbitrage(current_price)\n","\n","    async def execute_volatility_arbitrage(self, current_price: Decimal):\n","        pass\n","\n","    async def validate_pair_format(self, pair: str) -> str:\n","        validated_pair = pair.replace(\"/\", \"\").upper()\n","        return \"XXBTZUSD\" if \"BTC\" in validated_pair or \"XBTUSD\" in validated_pair else validated_pair\n","\n","    async def check_available_balance(self) -> bool:\n","        balance = await self.api.query_private('Balance')\n","        return 'error' not in balance\n","\n","    async def is_pair_active(self, pair: str) -> bool:\n","        try:\n","            asset_info = await self.api.query_public('AssetPairs', {'pair': pair})\n","            return bool(asset_info.get('result'))\n","        except:\n","            return False\n","\n","    async def place_order_with_retry(self, params: dict, retries: int = 3):\n","        for attempt in range(retries):\n","            try:\n","                order = await self.api.query_private('AddOrder', params)\n","                if 'error' in order and order['error']:\n","                    print(f\"⚠️ Error en AddOrder intento {attempt + 1}: {order['error']}\")\n","                    await asyncio.sleep(2); continue\n","                return order\n","            except Exception as e:\n","                print(f\"⚠️ Excepción en intento {attempt + 1}: {str(e)}\")\n","                await asyncio.sleep(2)\n","        return None\n","\n","# ===================== BLOQUES DEFINIDOS PARA MODO REAL =====================\n","\n","async def bloque_analisis_continuo(core: \"QuantumTradingCore\", executor: \"EnhancedOrderExecutor\"):\n","    while True:\n","        try:\n","            try:\n","                interval_min = int(getattr(Config, \"INTERVAL\", getattr(Config, \"ICT_INTERVAL_MINUTES\", 5)))\n","            except Exception:\n","                interval_min = 5\n","\n","            avanzó = False\n","            try:\n","                if hasattr(core, \"market_monitor\") and core.market_monitor:\n","                    _ = await core.market_monitor.update_market_data()\n","                    avanzó = True\n","            except Exception as e_mm:\n","                print(f\"ℹ️ market_monitor no disponible o falló: {e_mm}\")\n","\n","            if not avanzó:\n","                try:\n","                    if hasattr(core, \"api\") and core.api and hasattr(core.api, \"get_price\"):\n","                        _ = await core.api.get_price(getattr(Config, \"PAR_TRADING\", \"XXBTZUSD\"))\n","                except Exception:\n","                    pass\n","\n","            await asyncio.sleep(max(5, interval_min * 60))\n","        except Exception as e:\n","            print(f\"⚠️ Error en bloque_analisis_continuo: {e}\")\n","            await asyncio.sleep(30)\n","\n","\n","async def bloque_visualizacion_periodica(comparador: \"ComparadorTendencias\"):\n","    while True:\n","        try:\n","            base_sleep = 900\n","            try:\n","                base_sleep = int(getattr(Config, \"VIZ_INTERVAL_SECONDS\", 900))\n","            except Exception:\n","                pass\n","\n","            if comparador is None:\n","                print(\"ℹ️ comparador = None; se omite comparar_y_graficar() en este ciclo.\")\n","            elif hasattr(comparador, \"comparar_y_graficar\"):\n","                fn = getattr(comparador, \"comparar_y_graficar\")\n","                if asyncio.iscoroutinefunction(fn):\n","                    await fn()\n","                else:\n","                    fn()\n","            else:\n","                print(\"ℹ️ comparador no expone comparar_y_graficar(); se omite en este ciclo.\")\n","\n","            await asyncio.sleep(max(60, base_sleep))\n","        except Exception as e:\n","            print(f\"⚠️ Error en bloque_visualizacion_periodica: {e}\")\n","            await asyncio.sleep(60)\n","\n","# ===================== IMPORT/BOOTSTRAP A PRUEBA DE FALLOS — ttdvi156 =====================\n","# Reemplaza el import directo por este bloque robusto e idempotente.\n","import os, sys\n","from typing import Any\n","try:\n","    from pathlib import Path\n","except Exception:\n","    Path = None  # entorno muy restringido\n","\n","# Fallback que usa tus utilidades de resiliencia si ya existen; si no, imprime aviso.\n","def _install_blindaje_fallback() -> None:\n","    try:\n","        # Estas funciones suelen existir en tu bloque de resiliencia:\n","        if \" _ensure_state_dirs\" in globals():\n","            _ensure_state_dirs()  # type: ignore\n","    except Exception:\n","        pass\n","    try:\n","        if \"_install_global_fs_guards\" in globals():\n","            _install_global_fs_guards()  # type: ignore\n","    except Exception:\n","        pass\n","    try:\n","        sys.stderr.write(\"🛡️ Blindaje básico activado (fallback: sin módulo ttdvi156).\\n\")\n","    except Exception:\n","        pass\n","\n","def _import_ttdvi156_as_T() -> Any:\n","    # 1) import normal\n","    try:\n","        import ttdvi156 as _T\n","        sys.stderr.write(\"✅ ttdvi156 importado como paquete.\\n\")\n","        return _T\n","    except ModuleNotFoundError:\n","        pass\n","    except Exception as e:\n","        sys.stderr.write(f\"⚠️ Error importando ttdvi156 (paquete): {e}\\n\")\n","\n","    # 2) import dinámico desde archivo ttdvi156.py en rutas candidatas\n","    try:\n","        import importlib.util\n","        candidates = []\n","        if Path is not None:\n","            try:\n","                candidates.append(Path.cwd() / \"ttdvi156.py\")\n","            except Exception:\n","                pass\n","            try:\n","                rr = Path(os.getenv(\"TTDVI_RUN_ROOT\", \"./run_ttdvi156\"))\n","                candidates.extend([rr / \"ttdvi156.py\", rr.parent / \"ttdvi156.py\"])\n","            except Exception:\n","                pass\n","\n","        for c in candidates:\n","            try:\n","                if c and getattr(c, \"exists\", lambda: False)():\n","                    spec = importlib.util.spec_from_file_location(\"ttdvi156\", str(c))\n","                    if spec and spec.loader:\n","                        mod = importlib.util.module_from_spec(spec)\n","                        sys.modules[\"ttdvi156\"] = mod\n","                        spec.loader.exec_module(mod)\n","                        sys.stderr.write(f\"✅ ttdvi156 cargado desde archivo: {c}\\n\")\n","                        return mod\n","            except Exception as e:\n","                sys.stderr.write(f\"⚠️ Falló carga desde {c}: {e}\\n\")\n","                continue\n","    except Exception as e:\n","        sys.stderr.write(f\"⚠️ Error en import dinámico de ttdvi156: {e}\\n\")\n","\n","    # 3) Stub mínimo con la interfaz requerida\n","    class _TStub:\n","        @staticmethod\n","        def install_blindaje_ttdvi156():\n","            _install_blindaje_fallback()\n","    sys.stderr.write(\"ℹ️ Usando stub ttdvi156 (no se encontró paquete/archivo).\\n\")\n","    return _TStub()\n","\n","# Exponer T y activar blindaje\n","T = _import_ttdvi156_as_T()\n","try:\n","    T.install_blindaje_ttdvi156()\n","except Exception as _e_bl:\n","    sys.stderr.write(f\"⚠️ T.install_blindaje_ttdvi156() falló: {_e_bl}. Activando fallback…\\n\")\n","    _install_blindaje_fallback()\n","\n","# ===================== TAREA PERIÓDICA: INTERPRETADOR CUÁNTICO =====================\n","async def run_interpretador_periodico(interpretador, comparador_btc=None):\n","    import random\n","    try:\n","        interval_s = int(getattr(Config, \"INTERPRET_INTERVAL_SECONDS\",\n","                         int(getattr(Config, \"INTERPRET_INTERVAL_MINUTES\", 15)) * 60))\n","    except Exception:\n","        interval_s = 900\n","    interval_s = max(60, interval_s)\n","    jitter_s = random.randint(0, 15)\n","    try: await asyncio.sleep(jitter_s)\n","    except Exception: pass\n","\n","    while True:\n","        try:\n","            print(\"\\n🧠 Interpretador cuántico ejecutando análisis periódico...\")\n","            try:\n","                if \"tzfix\" in globals() and hasattr(tzfix, \"run_with_tz_auto_repair_async\"):\n","                    await tzfix.run_with_tz_auto_repair_async(interpretador.interpretar_contexto_general)\n","                else:\n","                    await interpretador.interpretar_contexto_general()\n","            except asyncio.CancelledError:\n","                print(\"⏹️ Interpretador cuántico: tarea cancelada.\"); raise\n","            except Exception as e_int:\n","                print(f\"⚠️ Error en interpretar_contexto_general: {e_int}\")\n","\n","            try:\n","                if comparador_btc is not None:\n","                    if hasattr(comparador_btc, \"refresh\") and asyncio.iscoroutinefunction(comparador_btc.refresh):\n","                        await comparador_btc.refresh()\n","                    elif hasattr(comparador_btc, \"refresh\"):\n","                        comparador_btc.refresh()\n","            except Exception as e_cmp:\n","                print(f\"ℹ️ No se pudo enriquecer con comparador_btc: {e_cmp}\")\n","\n","            await asyncio.sleep(interval_s)\n","        except asyncio.CancelledError:\n","            print(\"⏹️ run_interpretador_periodico cancelado por el sistema.\"); break\n","        except Exception as e:\n","            print(f\"⚠️ Error en interpretación periódica: {e}\")\n","            await asyncio.sleep(min(120, interval_s // 3))\n","\n","# Llamada segura a configurar_fuente_emoji()\n","try:\n","    if \"configurar_fuente_emoji\" in globals() and callable(configurar_fuente_emoji):\n","        configurar_fuente_emoji()\n","except Exception as _e_emoji:\n","    print(f\"ℹ️ No se pudo configurar la fuente de emoji: {_e_emoji}\")\n","\n","\n","# ===================== ROUTER RESILIENTE DE DATOS DE MERCADO (versión A) =====================\n","class MarketDataRouter:\n","    \"\"\"\n","    Router tolerante a fallas y límites de tasa:\n","    - Evita llamar a Binance si detecta HTTP 451 (región bloqueada).\n","    - Evita Yahoo Finance si detecta 429 (rate limit).\n","    - Prioriza Kraken (Ticker), luego Kraken (OHLC), luego CoinGecko vía ComparadorDatosBTC si existe.\n","    - Implementa backoff y cache local corta para robustez.\n","    \"\"\"\n","    def __init__(self, api, comparador_btc=None, par_trading=None, interval=1):\n","        self.api = api\n","        self.comparador_btc = comparador_btc\n","        self.par = par_trading or getattr(Config, 'PAR_TRADING', 'XXBTZUSD')\n","        self.interval = interval or getattr(Config, 'INTERVAL', 1)\n","        self.disable_binance = True\n","        self.disable_yfinance = True\n","        self._last_price = None; self._last_price_ts = 0\n","        self._last_ohlc = None;  self._last_ohlc_ts = 0\n","\n","    def _cache_put_price(self, price):\n","        self._last_price = float(price)\n","        self._last_price_ts = asyncio.get_event_loop().time()\n","\n","    def _cache_get_price(self, max_age=30):\n","        now = asyncio.get_event_loop().time()\n","        if self._last_price is not None and (now - self._last_price_ts) <= max_age:\n","            return self._last_price\n","        return None\n","\n","    def _cache_put_ohlc(self, ohlc):\n","        self._last_ohlc = ohlc\n","        self._last_ohlc_ts = asyncio.get_event_loop().time()\n","\n","    def _cache_get_ohlc(self, max_age=60):\n","        now = asyncio.get_event_loop().time()\n","        if self._last_ohlc is not None and (now - self._last_ohlc_ts) <= max_age:\n","            return self._last_ohlc\n","        return None\n","\n","    async def _kraken_price_ticker(self):\n","        data = await self.api.query_public('Ticker', {'pair': self.par})\n","        return float(data['result'][self.par]['c'][0])\n","\n","    async def _kraken_price_from_ohlc(self):\n","        data = await self.api.query_public('OHLC', {'pair': self.par, 'interval': self.interval, 'count': 2})\n","        candles = data['result'][self.par]\n","        if not candles: raise RuntimeError(\"Sin velas OHLC\")\n","        close = float(candles[-1][4]); return close\n","\n","    async def _coingecko_price(self):\n","        if self.comparador_btc is None:\n","            raise RuntimeError(\"ComparadorDatosBTC no disponible\")\n","        for attr in ('obtener_precio_coingecko', 'get_precio_coingecko', 'precio_coingecko', 'obtener_precio'):\n","            if hasattr(self.comparador_btc, attr):\n","                f = getattr(self.comparador_btc, attr)\n","                price = f() if not asyncio.iscoroutinefunction(f) else await f()\n","                price = float(price)\n","                if price > 0: return price\n","        raise RuntimeError(\"CoinGecko no disponible desde ComparadorDatosBTC\")\n","\n","    async def get_price(self, attempts=5):\n","        cached = self._cache_get_price()\n","        if cached is not None: return cached\n","        last_error = None\n","        for attempt in range(1, attempts + 1):\n","            try:\n","                price = await self._kraken_price_ticker(); self._cache_put_price(price); return price\n","            except Exception as e:\n","                last_error = e\n","                await asyncio.sleep(min(1 * attempt, 5))\n","                try:\n","                    price = await self._kraken_price_from_ohlc(); self._cache_put_price(price); return price\n","                except Exception as e2:\n","                    last_error = e2\n","            try:\n","                price = await self._coingecko_price(); self._cache_put_price(price); return price\n","            except Exception as e3:\n","                last_error = e3\n","            await asyncio.sleep(min(0.5 * attempt, 3))\n","        cached = self._cache_get_price(max_age=300)\n","        if cached is not None: return cached\n","        raise RuntimeError(f\"No fue posible obtener precio tras {attempts} intentos: {last_error}\")\n","\n","    async def get_ohlc(self, count, attempts=4):\n","        cached = self._cache_get_ohlc()\n","        if cached is not None and len(cached) >= count: return cached[-count:]\n","        last_error = None\n","        for attempt in range(1, attempts + 1):\n","            try:\n","                data = await self.api.query_public('OHLC', {'pair': self.par, 'interval': self.interval, 'count': count})\n","                candles = data['result'][self.par]\n","                if candles and len(candles) >= 1:\n","                    self._cache_put_ohlc(candles); return candles[-count:]\n","                last_error = RuntimeError(\"OHLC vacío\")\n","            except Exception as e:\n","                last_error = e\n","            await asyncio.sleep(min(0.5 * attempt, 3))\n","        try:\n","            px = await self.get_price()\n","            fake = []; ts = int(datetime.utcnow().timestamp())\n","            for i in range(count):\n","                fake.append([ts - i * 60 * self.interval, px, px, px, px, 0, 0])\n","            fake.reverse(); self._cache_put_ohlc(fake); return fake\n","        except Exception as e:\n","            raise RuntimeError(f\"No fue posible obtener OHLC: {last_error} | fallback: {e}\")\n","\n","# ===================== ROUTER RESILIENTE DE DATOS DE MERCADO (versión B, compatible) =====================\n","# Mantenemos tu \"segunda\" definición, pues el código venía con dos variantes.\n","class MarketDataRouter:\n","    \"\"\"\n","    Router tolerante a fallas y límites de tasa:\n","    - Evita Binance (451 por región) y Yahoo Finance (429) por defecto.\n","    - Prioriza Kraken (Ticker), luego Kraken (OHLC), luego CoinGecko si está disponible a través de ComparadorDatosBTC.\n","    - Implementa backoff leve y cache volátil para reducir fricción.\n","    \"\"\"\n","    def __init__(self, api, comparador_btc=None, par_trading=None, interval=1):\n","        self.api = api\n","        self.comparador_btc = comparador_btc\n","        self.par = par_trading or getattr(Config, 'PAR_TRADING', 'XXBTZUSD')\n","        self.interval = interval or getattr(Config, 'INTERVAL', 1)\n","        self.disable_binance = True\n","        self.disable_yfinance = True\n","        self._last_price = None; self._last_price_ts = 0\n","        self._last_ohlc = None;  self._last_ohlc_ts = 0\n","\n","    def _cache_put_price(self, price):\n","        self._last_price = float(price)\n","        self._last_price_ts = asyncio.get_event_loop().time()\n","\n","    def _cache_get_price(self, max_age=30):\n","        now = asyncio.get_event_loop().time()\n","        if self._last_price is not None and (now - self._last_price_ts) <= max_age:\n","            return self._last_price\n","        return None\n","\n","    def _cache_put_ohlc(self, ohlc):\n","        self._last_ohlc = ohlc\n","        self._last_ohlc_ts = asyncio.get_event_loop().time()\n","\n","    def _cache_get_ohlc(self, max_age=60):\n","        now = asyncio.get_event_loop().time()\n","        if self._last_ohlc is not None and (now - self._last_ohlc_ts) <= max_age:\n","            return self._last_ohlc\n","        return None\n","\n","    async def _kraken_price_ticker(self):\n","        data = await self.api.query_public('Ticker', {'pair': self.par})\n","        return float(data['result'][self.par]['c'][0])\n","\n","    async def _kraken_price_from_ohlc(self):\n","        data = await self.api.query_public('OHLC', {'pair': self.par, 'interval': self.interval, 'count': 2})\n","        candles = data['result'][self.par]\n","        if not candles: raise RuntimeError(\"Sin velas OHLC\")\n","        return float(candles[-1][4])\n","\n","    async def _coingecko_price(self):\n","        if self.comparador_btc is None:\n","            raise RuntimeError(\"ComparadorDatosBTC no disponible\")\n","        for attr in ('obtener_precio_coingecko', 'get_precio_coingecko', 'precio_coingecko', 'obtener_precio'):\n","            if hasattr(self.comparador_btc, attr):\n","                f = getattr(self.comparador_btc, attr)\n","                price = f() if not asyncio.iscoroutinefunction(f) else await f()\n","                price = float(price)\n","                if price > 0: return price\n","        raise RuntimeError(\"CoinGecko no disponible desde ComparadorDatosBTC\")\n","\n","    async def get_price(self, attempts=5):\n","        cached = self._cache_get_price()\n","        if cached is not None: return cached\n","        last_error = None\n","        for attempt in range(1, attempts + 1):\n","            try:\n","                price = await self._kraken_price_ticker(); self._cache_put_price(price); return price\n","            except Exception as e:\n","                last_error = e\n","                await asyncio.sleep(min(1 * attempt, 5))\n","                try:\n","                    price = await self._kraken_price_from_ohlc(); self._cache_put_price(price); return price\n","                except Exception as e2:\n","                    last_error = e2\n","            try:\n","                price = await self._coingecko_price(); self._cache_put_price(price); return price\n","            except Exception as e3:\n","                last_error = e3\n","            await asyncio.sleep(min(0.5 * attempt, 3))\n","        cached = self._cache_get_price(max_age=300)\n","        if cached is not None: return cached\n","        raise RuntimeError(f\"No fue posible obtener precio tras {attempts} intentos: {last_error}\")\n","\n","    async def get_ohlc(self, count, attempts=4):\n","        cached = self._cache_get_ohlc()\n","        if cached is not None and len(cached) >= count: return cached[-count:]\n","        last_error = None\n","        for attempt in range(1, attempts + 1):\n","            try:\n","                data = await self.api.query_public('OHLC', {'pair': self.par, 'interval': self.interval, 'count': count})\n","                candles = data['result'][self.par]\n","                if candles and len(candles) >= 1:\n","                    self._cache_put_ohlc(candles); return candles[-count:]\n","                last_error = RuntimeError(\"OHLC vacío\")\n","            except Exception as e:\n","                last_error = e\n","            await asyncio.sleep(min(0.5 * attempt, 3))\n","        try:\n","            px = await self.get_price()\n","            fake = []; ts = int(datetime.utcnow().timestamp())\n","            for i in range(count):\n","                fake.append([ts - i * 60 * self.interval, px, px, px, px, 0, 0])\n","            fake.reverse(); self._cache_put_ohlc(fake); return fake\n","        except Exception as e:\n","            raise RuntimeError(f\"No fue posible obtener OHLC: {last_error} | fallback: {e}\")\n","\n","# ======================= SMOKE TESTS ENHANCED ORDER EXECUTOR (robusto y permanente) =======================\n","from decimal import InvalidOperation\n","from typing import List, Dict, Union\n","\n","def _dec(v) -> Decimal:\n","    return v if isinstance(v, Decimal) else Decimal(str(v))\n","\n","def _sum_ratios(tps: List[Dict[str, Decimal]]) -> Decimal:\n","    total = Decimal('0')\n","    for tp in tps: total += _dec(tp['ratio'])\n","    return total\n","\n","def _calcular_tp_escalonado(precio_entrada: Decimal) -> List[Dict[str, Decimal]]:\n","    niveles = []\n","    for tp in Config.TAKE_PROFIT_ESCALONADO:\n","        pct = _dec(tp['pct']); ratio = _dec(tp['ratio'])\n","        nivel = (precio_entrada * (Decimal('1') + pct)).quantize(Decimal('0.01'))\n","        niveles.append({'nivel': nivel, 'pct': pct, 'ratio': ratio})\n","    return niveles\n","\n","def _mostrar_plan_tp(precio_entrada: Decimal):\n","    print(\"📐 Plan de Take-Profit escalonado (cálculo estático):\")\n","    for i, tp in enumerate(_calcular_tp_escalonado(precio_entrada), 1):\n","        print(f\"  {i}. {tp['ratio']*100:.0f}% a {tp['pct']*100:.2f}%  →  ${tp['nivel']}\")\n","\n","try:\n","    Config  # type: ignore[name-defined]\n","except NameError:\n","    class Config:  # shim mínimo\n","        pass\n","\n","def _asegurar_config_defaults():\n","    defaults = {\n","        'MIN_ORDER': Decimal('0.0001'),\n","        'OBJETIVO_GANANCIA_MIN': Decimal('0.04'),\n","        'OBJETIVO_GANANCIA_BASE': Decimal('0.06'),\n","        'OBJETIVO_GANANCIA_MAX': Decimal('0.10'),\n","        'TRAILING_STOP_INICIAL': Decimal('0.01'),\n","        'TRAILING_STOP_MAX': Decimal('0.05'),\n","        'TRAILING_STEP': Decimal('0.002'),\n","        'ACTIVAR_BREAKEVEN': True,\n","        'BREAKEVEN_OFFSET': Decimal('0.001'),\n","        'STOP_LOSS_PCT': Decimal('2.0'),\n","    }\n","    for k, v in defaults.items():\n","        if not hasattr(Config, k): setattr(Config, k, v)\n","\n","    if not hasattr(Config, 'TAKE_PROFIT_ESCALONADO') or not getattr(Config, 'TAKE_PROFIT_ESCALONADO'):\n","        Config.TAKE_PROFIT_ESCALONADO = [\n","            {'pct': Decimal('0.04'), 'ratio': Decimal('0.25')},\n","            {'pct': Decimal('0.06'), 'ratio': Decimal('0.35')},\n","            {'pct': Decimal('0.08'), 'ratio': Decimal('0.25')},\n","            {'pct': Decimal('0.10'), 'ratio': Decimal('0.15')},\n","        ]\n","\n","    if not hasattr(Config, 'objetivo_ganancia_por_volatilidad'):\n","        @classmethod\n","        def objetivo_ganancia_por_volatilidad(cls, vol: float) -> Decimal:\n","            v = Decimal(str(vol))\n","            lo, base, hi = cls.OBJETIVO_GANANCIA_MIN, cls.OBJETIVO_GANANCIA_BASE, cls.OBJETIVO_GANANCIA_MAX\n","            ratio = max(Decimal('0'), min(Decimal('1'), v / Decimal('0.06')))\n","            return (lo + (hi - lo) * ratio).quantize(Decimal('0.0001'))\n","        Config.objetivo_ganancia_por_volatilidad = objetivo_ganancia_por_volatilidad\n","\n","    if not hasattr(Config, 'validar'):\n","        @classmethod\n","        def validar(cls):\n","            required = [\n","                'MIN_ORDER','OBJETIVO_GANANCIA_MIN','OBJETIVO_GANANCIA_BASE','OBJETIVO_GANANCIA_MAX',\n","                'TRAILING_STOP_INICIAL','TRAILING_STOP_MAX','TRAILING_STEP',\n","                'ACTIVAR_BREAKEVEN','BREAKEVEN_OFFSET','STOP_LOSS_PCT','TAKE_PROFIT_ESCALONADO'\n","            ]\n","            for r in required:\n","                if not hasattr(cls, r): raise AssertionError(f\"Falta Config.{r}\")\n","            if not isinstance(cls.TAKE_PROFIT_ESCALONADO, list) or not cls.TAKE_PROFIT_ESCALONADO:\n","                raise AssertionError(\"TAKE_PROFIT_ESCALONADO inválido\")\n","        Config.validar = validar\n","\n","_asegurar_config_defaults()\n","\n","async def smoke_test_enhanced_executor(executor, precio_ejemplo: Union[float, Decimal, int] = 100000.0) -> None:\n","    print(\"\\n🧪 Ejecutando smoke tests del EnhancedOrderExecutor...\")\n","    try:\n","        Config.validar()\n","    except Exception as e:\n","        raise AssertionError(f\"Config.invalid: {e}\")\n","\n","    assert Config.OBJETIVO_GANANCIA_MIN <= Config.OBJETIVO_GANANCIA_BASE <= Config.OBJETIVO_GANANCIA_MAX, \\\n","        \"Base de objetivo de ganancia fuera de rango [min, max]\"\n","    assert Config.TRAILING_STOP_INICIAL <= Config.TRAILING_STOP_MAX, \\\n","        \"TRAILING_STOP_INICIAL no puede ser mayor que TRAILING_STOP_MAX\"\n","    assert Config.TRAILING_STEP > 0, \"TRAILING_STEP debe ser > 0\"\n","\n","    total_ratio = _sum_ratios(Config.TAKE_PROFIT_ESCALONADO)\n","    assert total_ratio == Decimal('1.00'), f\"TAKE_PROFIT_ESCALONADO debe sumar 1.00 (actual={total_ratio})\"\n","    for tp in Config.TAKE_PROFIT_ESCALONADO:\n","        pct = _dec(tp['pct'])\n","        assert Config.OBJETIVO_GANANCIA_MIN <= pct <= Config.OBJETIVO_GANANCIA_MAX, \\\n","            f\"TP {pct} fuera de [4%, 10%]\"\n","\n","    o1 = Config.objetivo_ganancia_por_volatilidad(0.01)\n","    o2 = Config.objetivo_ganancia_por_volatilidad(0.03)\n","    o3 = Config.objetivo_ganancia_por_volatilidad(0.06)\n","    assert o1 <= o2 <= o3, f\"Objetivo no monotónico: {o1} <= {o2} <= {o3} (esperado)\"\n","\n","    tiene_execute_order = hasattr(executor, \"execute_order\") and callable(getattr(executor, \"execute_order\"))\n","    tiene_ejecutar_decision = hasattr(executor, \"ejecutar_decision\") and callable(getattr(executor, \"ejecutar_decision\"))\n","    assert (tiene_execute_order or tiene_ejecutar_decision), \\\n","        \"El ejecutor debe exponer 'execute_order' y/o 'ejecutar_decision'\"\n","\n","    min_order_exec = getattr(executor, \"min_order\", None)\n","    if min_order_exec is not None and _dec(min_order_exec) != Config.MIN_ORDER:\n","        print(f\"⚠️ Aviso: executor.min_order={min_order_exec} difiere de Config.MIN_ORDER={Config.MIN_ORDER}. \"\n","              f\"Considera unificar para consistencia.\")\n","\n","    try:\n","        precio_entrada = _dec(precio_ejemplo)\n","        _mostrar_plan_tp(precio_entrada)\n","    except (InvalidOperation, TypeError) as e:\n","        raise AssertionError(f\"Precio de ejemplo inválido para plan TP: {e}\")\n","\n","    if Config.ACTIVAR_BREAKEVEN:\n","        assert Config.BREAKEVEN_OFFSET >= Decimal('0'), \"BREAKEVEN_OFFSET debe ser >= 0\"\n","\n","    assert 0 < _dec(Config.STOP_LOSS_PCT) < 100, \"STOP_LOSS_PCT debe estar en (0, 100)\"\n","\n","    print(\"✅ Smoke tests OK. Parámetros y executor coherentes.\\n\")\n","\n","async def run_smoke_test(api, executor) -> None:\n","    try:\n","        precio_ejemplo = Decimal('100000')\n","        if hasattr(api, 'obtener_precio_real_actual') and callable(getattr(api, 'obtener_precio_real_actual')):\n","            try:\n","                p = await api.obtener_precio_real_actual()\n","                if p is not None:\n","                    precio_ejemplo = _dec(p)\n","            except Exception as _e:\n","                print(f\"⚠️ No se pudo usar precio real para smoke test: {_e}\")\n","        await smoke_test_enhanced_executor(executor, precio_ejemplo=precio_ejemplo)\n","    except AssertionError as e:\n","        print(f\"❌ Smoke test falló: {e}\")\n","        print(\"🛑 Deteniendo arranque para evitar comportamiento inesperado.\"); return\n","    except Exception as e:\n","        print(f\"❌ Error inesperado en smoke test: {e}\"); return\n","\n","\n","# ===================================== BTC ULTRA REALTIME INTEL v3 =====================================\n","# Kraken-first, on-chain + microestructura + ML online + máquina de estados de tendencia (histeresis).\n","# Informe de última hora con línea de tiempo clara, precios actuales y eventos clave.\n","# ======================================================================================================\n","\n","import os, json, csv, math, asyncio, pickle, logging, time\n","from typing import Any, Dict, List, Optional, Tuple\n","from datetime import datetime, timezone, timedelta\n","from zoneinfo import ZoneInfo\n","\n","# ===================================== FIX PERMANENTE UTC/TIMEZONE =====================================\n","# Evita el choque cuando otra parte del entorno redefine `timezone` (por ejemplo, con `pytz.timezone`)\n","# y causa: \"'function' object has no attribute 'utc'\".\n","# Mantiene tu código original (todas las llamadas a `datetime.now(timezone.utc)` siguen funcionando).\n","import datetime as _dt_mod\n","try:\n","    timezone = _dt_mod.timezone  # type: ignore[assignment]\n","except Exception:\n","    pass\n","try:\n","    _UTC = _dt_mod.timezone.utc\n","except Exception:\n","    _UTC = _dt_mod.timezone(_dt_mod.timedelta(0), name=\"UTC\")\n","def _utcnow_iso() -> str:\n","    return _dt_mod.datetime.now(_UTC).isoformat()\n","def _utcnow_ts() -> float:\n","    return _dt_mod.datetime.now(_UTC).timestamp()\n","# =======================================================================================================\n","\n","import aiohttp\n","import numpy as np\n","from tenacity import retry, stop_after_attempt, wait_fixed, wait_random_exponential, retry_if_exception, before_sleep_log\n","\n","# =============================== CONFIG GLOBAL ===============================\n","PAIR_DEFAULT: str = \"XBT/USD\"        # Usa \"XBT/USD\" en Kraken\n","ORDERBOOK_DEPTH: int = 50            # Profundidad L2\n","LOOP_PERIOD_S: float = 1.0           # Periodo del loop principal (0.25–1.0s)\n","MEMPOOL_BASE: str = \"https://mempool.space/api\"\n","MEMPOOL_V1: str   = \"https://mempool.space/api/v1\"\n","TZ_NY = ZoneInfo(\"America/New_York\")\n","\n","# Umbrales microestructura / on-chain\n","HIGH_CONGESTION_TXS: int   = 200_000\n","FAST_FEE_HIGH_SATVB: float = 150.0\n","SPREAD_WIDE_BP: float      = 2.5\n","IMBALANCE_STRONG: float    = 0.65\n","FLOW_DOMINANCE: float      = 0.60\n","\n","# Entrenamiento online (regresión logística ligera)\n","LABEL_HORIZON_S: float     = 3.0\n","MIN_SAMPLES_TO_TRAIN: int  = 50\n","LEARNING_RATE: float       = 0.05\n","L2_REG: float              = 1e-4\n","MODEL_PATH: str            = \"models/btc_online_model.pkl\"\n","\n","# Gestión de riesgo / stops\n","BASE_RISK: float           = 1.0\n","ATR_WINDOW: int            = 60      # ATR ~1min si loop=1s\n","ATR_MULTIPLIER: float      = 0.8     # SL ~ entry * (1 - k*ATR_1m) ajustado\n","GARCH_ALPHA: float         = 0.06\n","GARCH_BETA: float          = 0.90\n","\n","# Persistencia / Reportes\n","os.makedirs(\"onchain_cache\", exist_ok=True)\n","os.makedirs(\"logs\", exist_ok=True)\n","os.makedirs(\"models\", exist_ok=True)\n","os.makedirs(\"reports\", exist_ok=True)\n","\n","# ===================== PARCHE PERMANENTE UTCNOW (SIN CAMBIAR TU CÓDIGO) ======================\n","# Objetivo: suprimir el DeprecationWarning y hacer que datetime.utcnow() devuelva un datetime \"aware\".\n","# - No modifica tus llamadas: puedes seguir usando datetime.utcnow().isoformat().\n","# - Idempotente: si se ejecuta varias veces, no rompe nada.\n","# - Mantiene compatibilidad con datetime.now, fromtimestamp, etc.\n","\n","import warnings as _warn\n","import datetime as _dt_mod\n","\n","# Silencia el warning deprecado de utcnow() en Py>=3.12\n","_warn.filterwarnings(\n","    \"ignore\",\n","    message=r\"datetime\\.datetime\\.utcnow\\(\\) is deprecated.*\",\n","    category=DeprecationWarning,\n",")\n","\n","# Asegura un tz UTC robusto\n","try:\n","    _UTC = getattr(_dt_mod, \"UTC\", _dt_mod.timezone.utc)\n","except Exception:\n","    _UTC = _dt_mod.timezone(_dt_mod.timedelta(0), name=\"UTC\")\n","\n","# Si el nombre global `datetime` apunta a la clase real, lo envolvemos con un shim.\n","# El shim:\n","#  - redefine utcnow() para devolver now(UTC) \"aware\" (sin warning)\n","#  - reenvía el resto de atributos/métodos a datetime original\n","#  - permite llamar datetime(...) como constructor\n","try:\n","    _GLOBAL_DT = globals().get(\"datetime\", None)\n","    if _GLOBAL_DT is _dt_mod.datetime:\n","        class _DatetimeShim:\n","            __slots__ = ()\n","\n","            # Reemplazo seguro de utcnow(): retorna timezone-aware\n","            @staticmethod\n","            def utcnow():\n","                return _dt_mod.datetime.now(_UTC)\n","\n","            # Delegación a la clase original para cualquier otro atributo\n","            def __getattr__(self, name):\n","                return getattr(_dt_mod.datetime, name)\n","\n","            # Permite usar datetime(...) como constructor\n","            def __call__(self, *args, **kwargs):\n","                return _dt_mod.datetime(*args, **kwargs)\n","\n","            # Soporta isinstance(x, datetime) trabajando con el tipo real cuando se necesite\n","            @property\n","            def __class__(self):\n","                return _dt_mod.datetime.__class__\n","\n","        # Inyectamos el shim en el namespace del módulo\n","        datetime = _DatetimeShim()  # type: ignore[assignment]\n","except Exception:\n","    # Si por alguna razón no podemos envolver, al menos provee un helper sin cambiar tu código:\n","    def _utcnow_iso_safe() -> str:\n","        return _dt_mod.datetime.now(_UTC).isoformat()\n","# =============================================================================================\n","\n","\n","# ================================= Kraken – PUBLIC REST =================================\n","KRAKEN_API_BASE = \"https://api.kraken.com/0/public\"\n","\n","class KrakenPublicFeed:\n","    \"\"\"Fuente REAL de mercado (Kraken REST) con resolución robusta del par.\"\"\"\n","    def __init__(self, session: Optional[aiohttp.ClientSession]=None, timeout_s: int=6):\n","        self._owns = session is None\n","        self.session = session or aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=timeout_s))\n","        self._pair_cache: Dict[str, str] = {}   # \"XBT/USD\" -> \"XXBTZUSD\"\n","        self._assetpairs: Dict[str, Dict[str, Any]] = {}\n","        self._ready = False\n","\n","    async def close(self):\n","        if self._owns and not self.session.closed:\n","            await self.session.close()\n","\n","    @retry(stop=stop_after_attempt(3), wait=wait_fixed(0.6))\n","    async def _get_json(self, url: str, params: Optional[Dict[str, Any]]=None) -> Dict[str, Any]:\n","        async with self.session.get(url, params=params or {}) as r:\n","            r.raise_for_status()\n","            return await r.json()\n","\n","    async def _ensure_pairs(self):\n","        if self._ready and self._assetpairs:\n","            return\n","        data = await self._get_json(f\"{KRAKEN_API_BASE}/AssetPairs\")\n","        if data.get(\"error\"):\n","            raise RuntimeError(f\"Kraken AssetPairs error: {data['error']}\")\n","        self._assetpairs = data.get(\"result\", {})\n","        self._ready = True\n","\n","    @staticmethod\n","    def _normalize_pair_str(pair: str) -> str:\n","        s = pair.strip().upper().replace(\"BTC\",\"XBT\").replace(\"-\",\"/\").replace(\" \", \"\")\n","        if \"/\" not in s and len(s) >= 6:  # XBTUSD -> XBT/USD\n","            s = s[:-3] + \"/\" + s[-3:]\n","        return s\n","\n","    async def _resolve_pair(self, pair: str) -> str:\n","        key = self._normalize_pair_str(pair)\n","        if key in self._pair_cache:\n","            return self._pair_cache[key]\n","        await self._ensure_pairs()\n","        # Intentos: wsname exacta, altname exacto, heurística\n","        for code, meta in self._assetpairs.items():\n","            if str(meta.get(\"wsname\",\"\")).upper() == key:\n","                self._pair_cache[key] = code; return code\n","        for code, meta in self._assetpairs.items():\n","            if str(meta.get(\"altname\",\"\")).upper() == key.replace(\"/\",\"\"):\n","                self._pair_cache[key] = code; return code\n","        base, quote = key.split(\"/\")\n","        for code, meta in self._assetpairs.items():\n","            ws = str(meta.get(\"wsname\",\"\")).upper()\n","            if ws.endswith(\"/\"+quote) and ws.startswith(base):\n","                self._pair_cache[key] = code; return code\n","        # Fallback: altname sin mapear\n","        self._pair_cache[key] = key.replace(\"/\",\"\")\n","        return self._pair_cache[key]\n","\n","    async def get_ticker_price(self, pair: str=\"XBT/USD\") -> float:\n","        code = await self._resolve_pair(pair)\n","        data = await self._get_json(f\"{KRAKEN_API_BASE}/Ticker\", params={\"pair\": code})\n","        if data.get(\"error\"):\n","            raise RuntimeError(f\"Kraken Ticker error: {data['error']}\")\n","        res = data.get(\"result\", {})\n","        first_key = next(iter(res.keys()))\n","        c = res[first_key].get(\"c\", [])\n","        return float(c[0]) if c else float(\"nan\")\n","\n","    async def get_order_book(self, pair: str=\"XBT/USD\", depth: int=50) -> Dict[str, List[List[float]]]:\n","        code = await self._resolve_pair(pair)\n","        count = max(1, min(int(depth), 200))\n","        data = await self._get_json(f\"{KRAKEN_API_BASE}/Depth\", params={\"pair\": code, \"count\": count})\n","        if data.get(\"error\"):\n","            raise RuntimeError(f\"Kraken Depth error: {data['error']}\")\n","        res = data.get(\"result\", {})\n","        first_key = next(iter(res.keys()))\n","        ob = res[first_key]\n","        bids = [[float(p), float(v)] for p, v, _ in ob.get(\"bids\", [])]\n","        asks = [[float(p), float(v)] for p, v, _ in ob.get(\"asks\", [])]\n","        return {\"bids\": bids, \"asks\": asks}\n","\n","    async def get_recent_trades(self, pair: str=\"XBT/USD\", limit: int=200) -> List[Dict[str, Any]]:\n","        code = await self._resolve_pair(pair)\n","        data = await self._get_json(f\"{KRAKEN_API_BASE}/Trades\", params={\"pair\": code})\n","        if data.get(\"error\"):\n","            raise RuntimeError(f\"Kraken Trades error: {data['error']}\")\n","        res = data.get(\"result\", {})\n","        first_key = [k for k in res.keys() if k != \"last\"]\n","        if not first_key: return []\n","        arr = res[first_key[0]]\n","        out: List[Dict[str, Any]] = []\n","        for t in arr[-min(limit, len(arr)):]:# [price, volume, time, side, ordertype, misc]\n","            p, v, ts, side, _, _ = t\n","            out.append({\n","                \"price\": float(p),\n","                \"qty\": float(v),\n","                \"side\": \"buy\" if str(side).lower()==\"b\" else \"sell\",\n","                \"ts\": datetime.fromtimestamp(float(ts), tz=timezone.utc).isoformat()\n","            })\n","        return out\n","\n","# =============================== On-chain (mempool.space) ===============================\n","class BTCOnChain:\n","    def __init__(self, session: Optional[aiohttp.ClientSession] = None, timeout_s: int = 8):\n","        self._owns: bool = session is None\n","        self.session: aiohttp.ClientSession = session or aiohttp.ClientSession(\n","            timeout=aiohttp.ClientTimeout(total=timeout_s)\n","        )\n","\n","    async def close(self) -> None:\n","        if self._owns and not self.session.closed:\n","            await self.session.close()\n","\n","    # --- GET inteligente: acepta JSON o text/plain y convierte si es número ---\n","    @retry(stop=stop_after_attempt(3), wait=wait_fixed(0.8))\n","    async def _get_smart(self, url: str, expect: str = \"auto\") -> Any:\n","        \"\"\"\n","        expect: \"auto\" | \"json\" | \"text\"\n","        - Si llega JSON: parsea y retorna dict/list.\n","        - Si llega text/plain numérico (e.g., altura de bloque): retorna int.\n","        - Si llega texto no JSON: retorna str (y en 'json' intenta cargas tolerante).\n","        \"\"\"\n","        headers = {\"Accept\": \"application/json, text/plain, */*\"}\n","        async with self.session.get(url, headers=headers) as r:\n","            r.raise_for_status()\n","            ctype = (r.headers.get(\"Content-Type\") or \"\").split(\";\")[0].strip().lower()\n","\n","            # preferencia explícita\n","            if expect == \"text\":\n","                return await r.text()\n","            if expect == \"json\" and (ctype.startswith(\"application/json\") or ctype.endswith(\"+json\")):\n","                return await r.json()\n","\n","            # modo auto o json con content-type inesperado: leemos texto y decidimos\n","            body = await r.text()\n","            s = body.strip()\n","\n","            # ¿Numérico puro? → int (caso /blocks/tip/height)\n","            if s.isdigit():\n","                return int(s)\n","\n","            # ¿Parece JSON aunque el header diga text/plain?\n","            if s.startswith(\"{\") or s.startswith(\"[\"):\n","                try:\n","                    return json.loads(s)\n","                except Exception:\n","                    if expect == \"json\":\n","                        raise\n","                    return s  # devuélvelo como texto\n","\n","            # Si el servidor nos dio JSON bien tipado, úsalo\n","            if ctype.startswith(\"application/json\") or ctype.endswith(\"+json\"):\n","                return await r.json()\n","\n","            # Último recurso: texto crudo\n","            return s\n","\n","    # --- Endpoints mempool.space usando _get_smart ---\n","    async def _get_json(self, url: str) -> Any:\n","        # compat: otras partes de tu código llaman _get_json()\n","        return await self._get_smart(url, expect=\"auto\")\n","\n","    async def tip_height(self) -> int:\n","        # devuelve int aunque el servidor responda text/plain\n","        v = await self._get_smart(f\"{MEMPOOL_BASE}/blocks/tip/height\", expect=\"text\")\n","        return int(v)\n","\n","    async def mempool_stats(self) -> Dict[str, Any]:\n","        data = await self._get_smart(f\"{MEMPOOL_BASE}/mempool\", expect=\"auto\")\n","        return data if isinstance(data, dict) else {}\n","\n","    async def fees_recommended(self) -> Dict[str, float]:\n","        data = await self._get_smart(f\"{MEMPOOL_V1}/fees/recommended\", expect=\"auto\")\n","        return data if isinstance(data, dict) else {}\n","\n","    async def fees_targets(self) -> Dict[str, float]:\n","        data = await self._get_smart(f\"{MEMPOOL_BASE}/fee-estimates\", expect=\"auto\")\n","        return data if isinstance(data, dict) else {}\n","\n","    async def difficulty(self) -> Dict[str, Any]:\n","        data = await self._get_smart(f\"{MEMPOOL_V1}/difficulty-adjustment\", expect=\"auto\")\n","        return data if isinstance(data, dict) else {}\n","\n","    async def snapshot(self) -> Dict[str, Any]:\n","        tip, mem, frec, ftar, diff = await asyncio.gather(\n","            self.tip_height(),\n","            self.mempool_stats(),\n","            self.fees_recommended(),\n","            self.fees_targets(),\n","            self.difficulty()\n","        )\n","        return {\n","            \"ts_utc\": datetime.now(timezone.utc).isoformat(),\n","            \"tip_height\": tip,\n","            \"mempool\": mem,\n","            \"fees_recommended\": frec,\n","            \"fees_targets\": ftar,\n","            \"difficulty\": diff\n","        }\n","\n","# ============================ Feeds externos (opcional/neutral) ============================\n","class RealFeedsKrakenFirst:\n","    \"\"\"Refuerzos opcionales. Si no hay API keys, devuelve valores neutrales (no bloquea).\"\"\"\n","    def __init__(self, session: Optional[aiohttp.ClientSession]=None, timeout_s: int=8):\n","        self._owns = session is None\n","        self.session = session or aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=timeout_s))\n","        self.GLASS = os.getenv(\"GLASSNODE_API_KEY\",\"\").strip()\n","        self.SANTI = os.getenv(\"SANTIMENT_API_KEY\",\"\").strip()\n","        self.WHALE = os.getenv(\"WHALEALERT_API_KEY\",\"\").strip()\n","    async def close(self):\n","        if self._owns and not self.session.closed:\n","            await self.session.close()\n","\n","    # -------- Glassnode --------\n","    @retry(stop=stop_after_attempt(2), wait=wait_fixed(0.5))\n","    async def _glass(self, path: str, params: Dict[str, Any]) -> Any:\n","        if not self.GLASS: raise RuntimeError(\"no-key\")\n","        params = dict(params); params[\"api_key\"] = self.GLASS\n","        url = f\"https://api.glassnode.com{path}\"\n","        async with self.session.get(url, params=params) as r:\n","            r.raise_for_status(); return await r.json()\n","    async def utxo_age_distribution(self) -> Dict[str,float]:\n","        try:\n","            data = await self._glass(\"/v1/metrics/supply/utxo_age_distribution\", {\"a\":\"BTC\",\"i\":\"24h\"})\n","            total = 0.0; young=mid=old=0.0\n","            if isinstance(data, list) and data:\n","                last = data[-1].get(\"o\", {})\n","                if isinstance(last, dict):\n","                    for k,v in last.items():\n","                        total += float(v)\n","                        if any(t in k for t in [\"1y+\",\"2y+\",\"3y+\"]): old += float(v)\n","                        elif any(t in k for t in [\"3m\",\"6m\",\"12m\"]): mid += float(v)\n","                        else: young += float(v)\n","            if total<=0: raise RuntimeError(\"empty\")\n","            return {\"young_pct\":young/total, \"mid_pct\":mid/total, \"old_pct\":old/total}\n","        except Exception:\n","            return {\"young_pct\":0.33, \"mid_pct\":0.34, \"old_pct\":0.33}\n","    async def coin_days_destroyed(self) -> float:\n","        try:\n","            data = await self._glass(\"/v1/metrics/transactions/transferred_coin_days_destroyed_sum\", {\"a\":\"BTC\",\"i\":\"24h\"})\n","            if isinstance(data, list) and data: return float(data[-1].get(\"v\", 0.0))\n","        except Exception: pass\n","        return 0.0\n","\n","    # -------- Santiment --------\n","    @retry(stop=stop_after_attempt(2), wait=wait_fixed(0.5))\n","    async def _santi(self, query: str, variables: Dict[str, Any]) -> Any:\n","        if not self.SANTI: raise RuntimeError(\"no-key\")\n","        url = \"https://api.santiment.net/graphql\"\n","        payload = {\"query\": query, \"variables\": variables}\n","        headers = {\"Authorization\": f\"Apikey {self.SANTI}\"}\n","        async with self.session.post(url, json=payload, headers=headers) as r:\n","            r.raise_for_status(); return await r.json()\n","    async def dark_social_index(self) -> float:\n","        try:\n","            q = \"\"\"query($slug:String!){ socialDominance(slug:$slug, from:\"utc-1h\", to:\"utc\", interval:\"5m\"){ value } }\"\"\"\n","            data = await self._santi(q, {\"slug\":\"bitcoin\"})\n","            vals = data.get(\"data\",{}).get(\"socialDominance\",[])\n","            if vals:\n","                v = float(vals[-1].get(\"value\",0.0))\n","                return float(max(0.0, min(1.0, v)))\n","        except Exception: pass\n","        return 0.5\n","\n","    # -------- Whale Alert --------\n","    @retry(stop=stop_after_attempt(2), wait=wait_fixed(0.5))\n","    async def _whale(self, params: Dict[str, Any]) -> Any:\n","        if not self.WHALE: raise RuntimeError(\"no-key\")\n","        url = \"https://api.whale-alert.io/v1/transactions\"\n","        params = dict(params); params[\"api_key\"] = self.WHALE\n","        async with self.session.get(url, params=params) as r:\n","            r.raise_for_status(); return await r.json()\n","    async def whale_transactions_btc(self) -> float:\n","        try:\n","            now = int(datetime.now(timezone.utc).timestamp())\n","            data = await self._whale({\"start\": now-3600, \"min_value\": 1_000_000, \"currency\": \"btc\"})\n","            total = 0.0\n","            for t in data.get(\"transactions\", []):\n","                if str(t.get(\"symbol\",\"btc\")).lower()==\"btc\" and t.get(\"amount\") is not None:\n","                    total += float(t[\"amount\"])\n","            return float(total)\n","        except Exception:\n","            return 0.0\n","\n","    # -------- Otros (neutros si no conectados) --------\n","    async def vpvr_divergence(self) -> float: return 0.0\n","    async def williams_fractal_3m(self) -> int: return 0\n","    async def futures_oi_delta(self) -> float: return 0.0\n","    async def taker_buy_sell_ratio(self) -> float: return 1.0\n","    async def hidden_orders_gt_10btc(self) -> bool: return False\n","    async def funding_rate(self) -> float: return 0.0\n","    async def macro_prices(self) -> Dict[str,float]: return {\"DXY\":100.0, \"GOLD\":2000.0}\n","    async def miner_flows_btc(self) -> float: return 0.0\n","    async def dark_pool_prints(self) -> bool: return False\n","\n","# ============================ Microestructura (L2 + trades 3s) ============================\n","class Microstructure:\n","    @staticmethod\n","    def _mid(bids: List[List[float]], asks: List[List[float]]) -> float:\n","        return (float(bids[0][0]) + float(asks[0][0]))/2.0 if bids and asks else float(\"nan\")\n","    @staticmethod\n","    def _spread_bps(bids: List[List[float]], asks: List[List[float]]) -> float:\n","        if not bids or not asks: return float(\"nan\")\n","        bid, ask = float(bids[0][0]), float(asks[0][0]); mid = (bid+ask)/2.0\n","        return ((ask - bid)/mid)*10_000.0 if mid>0 else float(\"nan\")\n","    @staticmethod\n","    def _depth_volume(side: List[List[float]]) -> float:\n","        return float(np.sum([float(q) for _, q in side])) if side else 0.0\n","    @staticmethod\n","    def _imbalance(bids: List[List[float]], asks: List[List[float]]) -> float:\n","        bd = Microstructure._depth_volume(bids); ad = Microstructure._depth_volume(asks)\n","        tot = bd + ad; return (bd/tot) if tot>0 else 0.5\n","    @staticmethod\n","    def _trade_flow(trades: List[Dict[str, Any]], window_s: float = 3.0) -> Dict[str, Any]:\n","        if not trades: return {\"buy_share\":0.5, \"sell_share\":0.5, \"n\":0}\n","        now = datetime.now(timezone.utc).timestamp()\n","        recent = []\n","        for t in trades:\n","            ts = t.get(\"ts\")\n","            if isinstance(ts, str):\n","                try: ts = datetime.fromisoformat(ts.replace(\"Z\",\"+00:00\")).timestamp()\n","                except Exception: ts = now\n","            if (now - float(ts)) <= window_s: recent.append(t)\n","        if not recent: return {\"buy_share\":0.5, \"sell_share\":0.5, \"n\":0}\n","        buys  = sum(float(x.get(\"qty\",0.0)) for x in recent if str(x.get(\"side\",\"\")).lower()==\"buy\")\n","        sells = sum(float(x.get(\"qty\",0.0)) for x in recent if str(x.get(\"side\",\"\")).lower()==\"sell\")\n","        tot = buys + sells\n","        if tot<=0: return {\"buy_share\":0.5, \"sell_share\":0.5, \"n\":len(recent)}\n","        return {\"buy_share\": buys/tot, \"sell_share\": sells/tot, \"n\": len(recent)}\n","    @staticmethod\n","    def features(orderbook: Dict[str, Any], trades: List[Dict[str, Any]]) -> Dict[str, Any]:\n","        bids, asks = orderbook.get(\"bids\",[]), orderbook.get(\"asks\",[])\n","        mid   = Microstructure._mid(bids, asks)\n","        spread= Microstructure._spread_bps(bids, asks)\n","        imb   = Microstructure._imbalance(bids, asks)\n","        depth_bids = Microstructure._depth_volume(bids)\n","        depth_asks = Microstructure._depth_volume(asks)\n","        flow  = Microstructure._trade_flow(trades, window_s=3.0)\n","        return {\n","            \"ts_utc\": datetime.now(timezone.utc).isoformat(),\n","            \"mid\": mid, \"spread_bps\": spread, \"imbalance_bid_share\": imb,\n","            \"depth_bids\": depth_bids, \"depth_asks\": depth_asks,\n","            \"flow_buy_share\": flow[\"buy_share\"], \"flow_sell_share\": flow[\"sell_share\"],\n","            \"flow_n_trades_3s\": flow[\"n\"]\n","        }\n","\n","# ======================= Modelo online (Regresión logística ligera) =======================\n","class RunningStandardizer:\n","    def __init__(self, n_features: int):\n","        self.n=0; self.mean=np.zeros(n_features); self.M2=np.zeros(n_features)\n","    def update(self, x: np.ndarray) -> None:\n","        self.n += 1; d = x - self.mean; self.mean += d / self.n; self.M2 += d * (x - self.mean)\n","    def transform(self, x: np.ndarray) -> np.ndarray:\n","        var = self.M2 / max(self.n - 1, 1); std = np.sqrt(np.maximum(var, 1e-12)); return (x - self.mean) / std\n","\n","class OnlineLogistic:\n","    def __init__(self, n_features: int, lr: float = LEARNING_RATE, l2: float = L2_REG):\n","        self.w = np.zeros(n_features + 1); self.lr = lr; self.l2 = l2\n","        self.std = RunningStandardizer(n_features); self.trained=False\n","    @staticmethod\n","    def _sigmoid(z: float) -> float:\n","        zc = max(-50.0, min(50.0, z)); return 1.0/(1.0+math.exp(-zc))\n","    def _prepare(self, x: np.ndarray) -> np.ndarray:\n","        self.std.update(x); xs = self.std.transform(x); return np.concatenate([xs, np.ones(1)], axis=0)\n","    def partial_fit(self, X: List[np.ndarray], y: List[int]) -> None:\n","        for xi, yi in zip(X, y):\n","            x_aug = self._prepare(xi); p = self._sigmoid(float(self.w @ x_aug))\n","            grad = (p - yi) * x_aug + self.l2 * np.r_[self.w[:-1], 0.0]\n","            self.w -= self.lr * grad\n","        self.trained=True\n","    def predict_proba_up(self, x: np.ndarray) -> float:\n","        if not self.trained: return 0.5\n","        xs = self.std.transform(x); x_aug = np.concatenate([xs, np.ones(1)], axis=0)\n","        return self._sigmoid(float(self.w @ x_aug))\n","    def save(self, path: str = MODEL_PATH) -> None:\n","        with open(path,\"wb\") as f: pickle.dump({\"w\":self.w,\"mean\":self.std.mean,\"M2\":self.std.M2,\"n\":self.std.n}, f)\n","    def load(self, path: str = MODEL_PATH) -> None:\n","        if not os.path.exists(path): return\n","        with open(path,\"rb\") as f: d = pickle.load(f)\n","        self.w = d.get(\"w\", self.w); self.std.mean = d.get(\"mean\", self.std.mean)\n","        self.std.M2 = d.get(\"M2\", self.std.M2); self.std.n = d.get(\"n\", self.std.n); self.trained=True\n","\n","# ============================== Fusión clásica 2/3 + riesgo ==============================\n","class SignalFusion:\n","    def __init__(self):\n","        self.last_decision: Optional[Dict[str, Any]] = None\n","    def decide(self, micro: Dict[str, Any], onchain: Dict[str, Any],\n","               whale_score: float, sent_score: float) -> Dict[str, Any]:\n","        spread_ok = float(micro.get(\"spread_bps\", float(\"inf\"))) <= SPREAD_WIDE_BP\n","        imb_bull  = float(micro.get(\"imbalance_bid_share\",0.5)) >= IMBALANCE_STRONG\n","        flow_bull = float(micro.get(\"flow_buy_share\",0.5)) >= FLOW_DOMINANCE\n","        micro_sig = 1 if (spread_ok and (imb_bull or flow_bull)) else (-1 if ((not spread_ok) and (not imb_bull)\n","                    and float(micro.get(\"flow_sell_share\",0.5))>=FLOW_DOMINANCE) else 0)\n","        mem = onchain.get(\"mempool\",{}); fees = onchain.get(\"fees_recommended\",{})\n","        congest = (int(mem.get(\"count\",0))>HIGH_CONGESTION_TXS) or (float(fees.get(\"fastestFee\",0.0))>FAST_FEE_HIGH_SATVB)\n","        onchain_sig = -1 if congest else 1\n","        whale_bull = float(whale_score)>=0.55; sent_bull = float(sent_score)>=0.55\n","        ws_sig = 1 if (whale_bull and sent_bull) else (-1 if (float(whale_score)<=0.45 and float(sent_score)<=0.45) else 0)\n","        votes = [micro_sig, onchain_sig, ws_sig]; bull = votes.count(1); bear = votes.count(-1)\n","        action = \"BUY_SIGNAL\" if bull>=2 else (\"SELL_SIGNAL\" if bear>=2 else \"NEUTRAL\")\n","        decision = {\n","            \"ts_utc\": datetime.now(timezone.utc).isoformat(),\n","            \"micro_sig\": micro_sig, \"onchain_sig\": onchain_sig, \"whale_sent_sig\": ws_sig,\n","            \"votes\": votes, \"action\": action,\n","            \"explain\": {\n","                \"spread_bps\": micro.get(\"spread_bps\"),\n","                \"imbalance_bid_share\": micro.get(\"imbalance_bid_share\"),\n","                \"flow_buy_share\": micro.get(\"flow_buy_share\"),\n","                \"mempool_count\": mem.get(\"count\"),\n","                \"fastestFee_satvB\": fees.get(\"fastestFee\"),\n","            }\n","        }\n","        self.last_decision = decision; return decision\n","\n","class AdaptiveRisk:\n","    def __init__(self):\n","        self.garch_var: Optional[float] = None\n","    def position_size(self, price_series: List[float], base_risk: float = BASE_RISK) -> float:\n","        if not price_series or len(price_series)<20: return float(base_risk)\n","        arr = np.array(price_series,dtype=float); rets = np.diff(np.log(arr))\n","        vol = float(np.std(rets[-20:]) * math.sqrt(60.0))\n","        if vol<=0.0: return float(base_risk)\n","        size = float(base_risk) * (0.01 / vol)\n","        return float(max(0.25, min(size, 2.0)))\n","    def update_garch(self, price_series: List[float]) -> float:\n","        if len(price_series)<3:\n","            self.garch_var = 0.0; return 0.0\n","        r = np.diff(np.log(np.array(price_series[-120:],dtype=float)))\n","        eps2 = (r[-1]**2) if len(r)>0 else 0.0\n","        prev = float(self.garch_var) if self.garch_var is not None else float(np.var(r[-20:]) if len(r)>=20 else 0.0)\n","        self.garch_var = (1-GARCH_ALPHA-GARCH_BETA)*np.var(r[-60:]) + GARCH_ALPHA*eps2 + GARCH_BETA*prev\n","        return float(self.garch_var)\n","    def dynamic_stop(self, entry_price: float, price_series: List[float]) -> float:\n","        if not price_series or len(price_series)<max(ATR_WINDOW, 5):\n","            return float(entry_price * (1 - 0.005))  # 0.5% fallback\n","        arr = np.array(price_series[-ATR_WINDOW:], dtype=float)\n","        atr = float(np.mean(np.abs(np.diff(arr)) / np.maximum(arr[:-1], 1e-9)))\n","        self.update_garch(price_series)\n","        garch_adj = 1.0 + min(0.5, max(0.0, math.sqrt(max(self.garch_var or 0.0, 0.0))*10))\n","        sl = entry_price * (1 - ATR_MULTIPLIER * atr * garch_adj)\n","        return float(max(0.0, sl))\n","\n","# =========================== Metodologías 2025 (operativas) ===========================\n","class Methods2025:\n","    def __init__(self, feeds: RealFeedsKrakenFirst):\n","        self.feeds = feeds\n","    async def TRC3(self) -> Dict[str, Any]:\n","        utxo = await self.feeds.utxo_age_distribution()\n","        cdd  = await self.feeds.coin_days_destroyed()\n","        vpvr = await self.feeds.vpvr_divergence()\n","        wf   = await self.feeds.williams_fractal_3m()\n","        oi   = await self.feeds.futures_oi_delta()\n","        dsi  = await self.feeds.dark_social_index()\n","        onchain_rev = (utxo.get(\"old_pct\",0.33) > 0.38) or (cdd > 0)\n","        tecnico_rev = (vpvr > 0.0) or (wf == 1)\n","        sent_rev    = (oi > 0.15) and (dsi >= 0.60)\n","        score = (1.0 if onchain_rev else 0.0) + (1.0 if tecnico_rev else 0.0) + (1.0 if sent_rev else 0.0)\n","        signal = \"REVERSAL_UP\" if score>=2.0 else (\"REVERSAL_DOWN\" if (not tecnico_rev and oi<-0.15 and dsi<=0.4) else \"NEUTRAL\")\n","        return {\"method\":\"TRC-3\",\"signal\":signal,\"components\":{\"onchain\":onchain_rev,\"tecnico\":tecnico_rev,\"sentiment\":sent_rev}}\n","    async def LiquidityHunter(self, orderbook: Dict[str,Any], whale_btc_1m: float,\n","                              hidden_gt_10: bool, tbs_ratio: float, funding_rate: float,\n","                              dark_prints: bool) -> Dict[str,Any]:\n","        bids, asks = orderbook.get(\"bids\",[]), orderbook.get(\"asks\",[])\n","        def wall(side):\n","            if not side: return (0.0, 0.0)\n","            caps = side[:min(20, len(side))]; levels = [(float(p), float(q)) for p,q in caps]\n","            return max(levels, key=lambda x: x[1]) if levels else (0.0,0.0)\n","        best_bid_sz = float(bids[0][1]) if bids else 0.0\n","        best_ask_sz = float(asks[0][1]) if asks else 0.0\n","        wall_bid = wall(bids)[1]; wall_ask = wall(asks)[1]\n","        imbalance_sz = (best_bid_sz - best_ask_sz) / max(best_bid_sz + best_ask_sz, 1e-9)\n","        cond_entry = (imbalance_sz > 0.15) and (whale_btc_1m >= 50.0)\n","        cond_sqs   = (dark_prints and funding_rate < -0.0002)\n","        cond_hidden= hidden_gt_10 and (tbs_ratio > 1.05)\n","        action = \"AGGRESSIVE_ENTRY\" if cond_entry else (\"SHORT_SQUEEZE_ALERT\" if cond_sqs else (\"ICEBERG_FOLLOW\" if cond_hidden else \"IDLE\"))\n","        return {\"method\":\"LiquidityHunter\",\"action\":action,\"metrics\":{\n","            \"imbalance_sz\":imbalance_sz,\"wall_bid\":wall_bid,\"wall_ask\":wall_ask,\"whale_btc_1m\":whale_btc_1m,\n","            \"hidden_gt_10\":hidden_gt_10,\"taker_buy_sell_ratio\":tbs_ratio,\"funding_rate\":funding_rate,\"dark_prints\":dark_prints\n","        }}\n","    async def QuantumEntanglement(self, macro_prices: Dict[str,float], price_series: List[float]) -> Dict[str,Any]:\n","        if len(price_series)<120:\n","            return {\"method\":\"QuantumEntanglement\",\"signal\":\"NEUTRAL\",\"corr\":{}}\n","        arr = np.array(price_series[-120:], dtype=float)\n","        ret_btc = np.diff(np.log(arr))\n","        dxy = float(macro_prices.get(\"DXY\", 100.0)); gold = float(macro_prices.get(\"GOLD\",2000.0))\n","        ret_dxy = np.full_like(ret_btc, (np.log(dxy+1)-np.log(dxy)))\n","        ret_gold= np.full_like(ret_btc, (np.log(gold+1)-np.log(gold)))\n","        def corr(a,b):\n","            if a.std()==0 or b.std()==0: return 0.0\n","            return float(np.corrcoef(a,b)[0,1])\n","        c_dxy = corr(ret_btc, ret_dxy); c_gold = corr(ret_btc, ret_gold)\n","        signal = \"LONG_SWING\" if (c_dxy < -0.2 and c_gold > 0.2) else (\"SHORT_SWING\" if (c_dxy > 0.2 and c_gold < -0.2) else \"NEUTRAL\")\n","        return {\"method\":\"QuantumEntanglement\",\"signal\":signal,\"corr\":{\"BTC-DXY\":c_dxy,\"BTC-GOLD\":c_gold}}\n","    async def ByzantineShield(self, orderbook: Dict[str,Any], miner_flow_btc_h: float) -> Dict[str,Any]:\n","        bids, asks = orderbook.get(\"bids\",[]), orderbook.get(\"asks\",[])\n","        def spoof_score(side: List[List[float]]) -> float:\n","            if not side: return 0.0\n","            caps = side[:min(20, len(side))]; sizes = [float(q) for _,q in caps]\n","            if not sizes: return 0.0\n","            top = sorted(sizes, reverse=True)[:3]; base = (np.mean(sizes)+1e-9)\n","            return float(min(1.0, (np.mean(top)/base - 1.0)))\n","        spoof_bid = spoof_score(bids); spoof_ask = spoof_score(asks)\n","        miner_push = float(min(1.0, max(-1.0, miner_flow_btc_h / 200.0)))\n","        defense = \"DEFENSE_ON\" if (spoof_ask>0.5 and miner_push < -0.1) else (\"DEFENSE_ON\" if (spoof_bid>0.5 and miner_push > 0.1) else \"DEFENSE_OFF\")\n","        return {\"method\":\"ByzantineShield\",\"defense\":defense,\"metrics\":{\"spoof_bid\":spoof_bid,\"spoof_ask\":spoof_ask,\"miner_flow_btc_h\":miner_push}}\n","\n","# ======================= Máquina de estados de tendencia (histeresis) =======================\n","class TrendStateMachine:\n","    \"\"\"\n","    Tendencia robusta (evita perturbaciones) con histéresis y persistencia mínima.\n","    Estados: BEAR, BULL, NEUTRAL.\n","    Entrada: prob_up (ML 0..1) + acción fusión (BUY/SELL/NEUTRAL).\n","    \"\"\"\n","    def __init__(self,\n","                 up_enter: float = 0.62, up_exit: float = 0.55,\n","                 down_enter: float = 0.38, down_exit: float = 0.45,\n","                 min_persist_s: float = 10.0):\n","        self.state = \"NEUTRAL\"\n","        self.last_change_ts = datetime.now(timezone.utc).timestamp()\n","        self.up_enter = up_enter; self.up_exit = up_exit\n","        self.down_enter = down_enter; self.down_exit = down_exit\n","        self.min_persist_s = min_persist_s\n","\n","    def _can_switch(self) -> bool:\n","        return (datetime.now(timezone.utc).timestamp() - self.last_change_ts) >= self.min_persist_s\n","\n","    def update(self, prob_up: float, fused_action: str) -> str:\n","        # Refuerza con acción de fusión (buy/sell) moviendo levemente los umbrales\n","        adj = 0.02 if fused_action==\"BUY_SIGNAL\" else (-0.02 if fused_action==\"SELL_SIGNAL\" else 0.0)\n","        ue = min(0.99, max(0.5, self.up_enter + adj))\n","        ux = min(0.99, max(0.5, self.up_exit  + adj))\n","        de = max(0.01, min(0.5, self.down_enter + adj))\n","        dx = max(0.01, min(0.5, self.down_exit  + adj))\n","        new_state = self.state\n","        if self.state in (\"NEUTRAL\",\"BEAR\"):\n","            if prob_up >= ue and self._can_switch(): new_state = \"BULL\"\n","        if self.state in (\"NEUTRAL\",\"BULL\"):\n","            if prob_up <= de and self._can_switch(): new_state = \"BEAR\"\n","        # salidas (histéresis)\n","        if self.state==\"BULL\" and prob_up<ux and self._can_switch(): new_state = \"NEUTRAL\"\n","        if self.state==\"BEAR\" and prob_up>dx and self._can_switch(): new_state = \"NEUTRAL\"\n","        if new_state != self.state:\n","            self.state = new_state\n","            self.last_change_ts = datetime.now(timezone.utc).timestamp()\n","        return self.state\n","\n","# ==================== IMPORTACIÓN DE INTELIGENCIA BTC (silenciosa y 100% real) ====================\n","# Mantiene tu código local como fuente de verdad; sólo pisa si USE_EXTERNAL_BTC_INTEL=1 y el módulo existe.\n","\n","import importlib\n","\n","def _wire_external_intel_if_available() -> None:\n","    use_external = os.getenv(\"USE_EXTERNAL_BTC_INTEL\", \"\").strip().lower() in {\"1\", \"true\", \"yes\"}\n","    if not use_external:\n","        return\n","    try:\n","        ext = importlib.import_module(\"btc_ultra_realtime_intel_v3\")\n","        if hasattr(ext, \"KrakenPublicFeed\"):\n","            globals()[\"KrakenPublicFeed\"] = getattr(ext, \"KrakenPublicFeed\")  # type: ignore[misc]\n","        if hasattr(ext, \"BTCRealtimeIntelligence\"):\n","            globals()[\"BTCRealtimeIntelligence\"] = getattr(ext, \"BTCRealtimeIntelligence\")  # type: ignore[misc]\n","    except Exception:\n","        # Silencioso: si falla, el sistema sigue con tus clases locales sin imprimir nada.\n","        pass\n","\n","_wire_external_intel_if_available()\n","\n","# ==================== DECISION_FROM_SIGNAL COMPAT ====================\n","def decision_from_signal(sig: dict, trend_state: str = None) -> tuple:\n","    if not sig:\n","        return \"ESPERAR\", {\"razon\": \"sin_senal\"}\n","\n","    raw = sig.get(\"ml_override\") or sig.get(\"action\")\n","    mapping = {\n","        \"BUY_SIGNAL\": \"BUY\",\n","        \"SELL_SIGNAL\": \"SELL\",\n","        \"BUY\": \"BUY\",\n","        \"SELL\": \"SELL\",\n","        \"NEUTRAL\": \"NEUTRAL\",\n","        None: \"NEUTRAL\"\n","    }\n","    accion = mapping.get(str(raw).upper() if raw else None, \"NEUTRAL\")\n","\n","    tendencia = (trend_state or \"NEUTRAL\").upper()\n","    sl = sig.get(\"suggested_stop\")\n","    size = sig.get(\"position_size_factor\") or 1.0\n","    if size <= 0:\n","        size = 1.0\n","\n","    require_confirm = True\n","    allow_neutral = True\n","    ok = False\n","\n","    if accion == \"BUY\":\n","        ok = (tendencia == \"BULL\") or (allow_neutral and tendencia == \"NEUTRAL\")\n","    elif accion == \"SELL\":\n","        ok = (tendencia == \"BEAR\") or (allow_neutral and tendencia == \"NEUTRAL\")\n","    else:\n","        return \"ESPERAR\", {\"tendencia\": tendencia, \"sl\": sl, \"size\": size, \"accion\": accion}\n","\n","    if require_confirm and not ok:\n","        return \"ESPERAR\", {\"tendencia\": tendencia, \"sl\": sl, \"size\": size, \"accion\": accion, \"razon\": \"tendencia_no_confirma\"}\n","\n","    decision = \"COMPRAR\" if accion == \"BUY\" else \"VENDER\"\n","    return decision, {\"tendencia\": tendencia, \"sl\": sl, \"size\": size, \"accion\": accion}\n","\n","# ======================= Helper para tareas en background =======================\n","def ensure_task(coro, *, name: Optional[str] = None, logger: Optional[logging.Logger] = None) -> asyncio.Task:\n","    \"\"\"\n","    Crea una task con callback que registra cualquier excepción no esperada.\n","    Úsalo en vez de asyncio.create_task(coro, ...).\n","    \"\"\"\n","    t = asyncio.create_task(coro, name=name)\n","    def _done(task: asyncio.Task):\n","        try:\n","            _ = task.result()\n","        except asyncio.CancelledError:\n","            pass\n","        except Exception as e:\n","            if logger:\n","                try:\n","                    logger.exception(f\"Task {task.get_name()} crashed\", exc_info=e)\n","                except Exception:\n","                    print(f\"⚠️ Task '{task.get_name()}' crashed: {e!r}\")\n","            else:\n","                print(f\"⚠️ Task '{task.get_name()}' crashed: {e!r}\")\n","    t.add_done_callback(_done)\n","    return t\n","\n","# ==================== INIT BTC INTELLIGENCE (orden fijo) ====================\n","async def init_btc_intelligence():\n","    if aiohttp is None:\n","        print(\"⚠️ aiohttp no disponible; no se puede iniciar inteligencia BTC.\")\n","        return None, None, None\n","\n","    try:\n","        shared = aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=8))\n","        market = KrakenPublicFeed(session=shared)\n","        inteligencia = BTCRealtimeIntelligence(api_manager=market, pair=\"XBT/USD\", shared_session=shared)\n","        # En lugar de asyncio.create_task(...), usamos ensure_task para capturar excepciones\n","        ensure_task(inteligencia.start(period_s=LOOP_PERIOD_S), name=\"BTC-RT\")\n","        # ORDEN CANÓNICO: (inteligencia, market, shared_session)\n","        return inteligencia, market, shared\n","    except Exception as e:\n","        print(f\"❌ Error iniciando inteligencia BTC: {e}\")\n","        return None, None, None\n","\n","# ============================== Motor principal + Reportería ==============================\n","class BTCRealtimeIntelligence:\n","    def __init__(self, api_manager: Any, pair: str = PAIR_DEFAULT, shared_session: Optional[aiohttp.ClientSession]=None):\n","        self.api = api_manager\n","        self.pair: str = str(pair)\n","        self._stop: bool = False\n","        self.iter: int = 0\n","        self.price_history: List[float] = []\n","        self.price_history_ts: List[float] = []  # epoch seconds UTC\n","\n","        # Kraken-first feeds externos\n","        self._shared_session = shared_session or aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=8))\n","        self.feeds = RealFeedsKrakenFirst(session=self._shared_session)\n","        self.methods = Methods2025(self.feeds)\n","        self.fusion = SignalFusion()\n","        self.risk = AdaptiveRisk()\n","        self.trend = TrendStateMachine()\n","\n","        # ML online\n","        self._feature_names: List[str] = [\n","            \"spread_bps\",\"imbalance_bid_share\",\"flow_buy_share\",\"flow_sell_share\",\"flow_n_trades_3s\",\n","            \"mempool_count\",\"fastestFee_satvB\",\"difficulty_progress_pct\"\n","        ]\n","        self._n_features: int = len(self._feature_names)\n","        self.model = OnlineLogistic(n_features=self._n_features, lr=LEARNING_RATE, l2=L2_REG)\n","        try: self.model.load(MODEL_PATH)\n","        except Exception: pass\n","\n","        # Buffers de entrenamiento retardado y eventos para timeline\n","        self._label_buffer: List[Dict[str, Any]] = []\n","        self.events: List[Dict[str, Any]] = []  # eventos de cambio de estado/señal\n","        self._last_emitted_state: Optional[str] = None\n","\n","        # Última señal expuesta\n","        self.last_signal: Optional[Dict[str, Any]] = None\n","\n","    # ----- utilidades internas -----\n","    @staticmethod\n","    def _safe_float(x: Any, default: float = 0.0) -> float:\n","        try:\n","            v = float(x);\n","            if np.isnan(v) or np.isinf(v): return float(default)\n","            return float(v)\n","        except Exception:\n","            return float(default)\n","\n","    def _features_vector(self, micro: Dict[str, Any], onchain: Dict[str, Any]) -> np.ndarray:\n","        mem_count = int(onchain.get(\"mempool\",{}).get(\"count\",0))\n","        fast_fee  = float(onchain.get(\"fees_recommended\",{}).get(\"fastestFee\",0.0))\n","        diff_prog = float(onchain.get(\"difficulty\",{}).get(\"progressPercent\",0.0))\n","        return np.array([\n","            self._safe_float(micro.get(\"spread_bps\"),0.0),\n","            self._safe_float(micro.get(\"imbalance_bid_share\"),0.5),\n","            self._safe_float(micro.get(\"flow_buy_share\"),0.5),\n","            self._safe_float(micro.get(\"flow_sell_share\"),0.5),\n","            self._safe_float(micro.get(\"flow_n_trades_3s\"),0.0),\n","            float(mem_count), float(fast_fee), float(diff_prog)\n","        ], dtype=float)\n","\n","    def _log_micro(self, micro: Dict[str, Any]) -> None:\n","        path = \"logs/btc_microstructure.csv\"; write_header = not os.path.exists(path)\n","        with open(path,\"a\",newline=\"\") as f:\n","            w = csv.writer(f);\n","            if write_header: w.writerow(list(micro.keys()))\n","            w.writerow([micro.get(k,\"\") for k in micro.keys()])\n","\n","    def _log_signal(self, sig: Dict[str, Any], ml_prob_up: float, extras: Dict[str,Any]) -> None:\n","        path = \"logs/btc_signals.csv\"; write_header = not os.path.exists(path)\n","        flat = {\n","            \"ts_utc\": sig.get(\"ts_utc\"), \"action\": sig.get(\"action\"),\n","            \"micro_sig\": sig.get(\"micro_sig\"), \"onchain_sig\": sig.get(\"onchain_sig\"),\n","            \"whale_sent_sig\": sig.get(\"whale_sent_sig\"), \"ml_prob_up\": ml_prob_up,\n","            \"price\": sig.get(\"price\"), \"position_size_factor\": sig.get(\"position_size_factor\"),\n","            \"spread_bps\": sig.get(\"explain\",{}).get(\"spread_bps\"),\n","            \"imbalance_bid_share\": sig.get(\"explain\",{}).get(\"imbalance_bid_share\"),\n","            \"flow_buy_share\": sig.get(\"explain\",{}).get(\"flow_buy_share\"),\n","            \"mempool_count\": sig.get(\"explain\",{}).get(\"mempool_count\"),\n","            \"fastestFee_satvB\": sig.get(\"explain\",{}).get(\"fastestFee_satvB\"),\n","            \"TRC3_signal\": extras.get(\"TRC3_signal\"),\n","            \"LH_action\": extras.get(\"LH_action\"),\n","            \"QE_signal\": extras.get(\"QE_signal\"),\n","            \"BZ_defense\": extras.get(\"BZ_defense\")\n","        }\n","        with open(path,\"a\",newline=\"\") as f:\n","            w = csv.writer(f);\n","            if write_header: w.writerow(list(flat.keys()))\n","            w.writerow([flat.get(k,\"\") for k in flat.keys()])\n","\n","    def _push_sample_for_future_label(self, x_vec: np.ndarray, price_now: Optional[float]) -> None:\n","        if price_now is None: return\n","        entry = {\"t\": datetime.now(timezone.utc).timestamp(), \"x\": x_vec.copy(), \"price\": float(price_now)}\n","        self._label_buffer.append(entry)\n","        max_len = int(max(600, 2*60 / max(LOOP_PERIOD_S,0.1)))\n","        if len(self._label_buffer)>max_len: self._label_buffer = self._label_buffer[-max_len:]\n","\n","    def _train_from_delayed_labels(self, price_now: Optional[float]) -> None:\n","        if price_now is None or not self._label_buffer: return\n","        now = datetime.now(timezone.utc).timestamp()\n","        X_batch: List[np.ndarray] = []; y_batch: List[int] = []; remaining: List[Dict[str,Any]] = []\n","        for s in self._label_buffer:\n","            if (now - float(s[\"t\"])) >= LABEL_HORIZON_S:\n","                y = 1 if float(price_now) > float(s[\"price\"]) else 0\n","                X_batch.append(np.array(s[\"x\"],dtype=float)); y_batch.append(int(y))\n","            else: remaining.append(s)\n","        self._label_buffer = remaining\n","        if len(X_batch)>=1:\n","            self.model.partial_fit(X_batch,y_batch)\n","            try: self.model.save(MODEL_PATH)\n","            except Exception: pass\n","\n","    def _emit_event(self, kind: str, price: Optional[float], meta: Dict[str, Any]) -> None:\n","        evt = {\n","            \"ts_utc\": datetime.now(timezone.utc).isoformat(),\n","            \"ts_ny\":  datetime.now(TZ_NY).isoformat(),\n","            \"kind\": kind, \"price\": price\n","        }\n","        evt.update(meta or {})\n","        self.events.append(evt)\n","        # Mantener solo 1h\n","        cutoff = datetime.now(timezone.utc) - timedelta(hours=1, minutes=2)\n","        self.events = [e for e in self.events\n","                       if datetime.fromisoformat(e[\"ts_utc\"].replace(\"Z\",\"+00:00\")).replace(tzinfo=None)\n","                          > cutoff.replace(tzinfo=None)]\n","\n","    # --------------------------- Reporte última hora ---------------------------\n","    def generate_last_hour_report(self) -> Dict[str, Any]:\n","        \"\"\"Genera reporte JSON + CSV de la última hora con línea de tiempo y resumen.\"\"\"\n","        if not self.price_history or not self.price_history_ts:\n","            return {}\n","        now = datetime.now(timezone.utc).timestamp()\n","        # Filtro 1h\n","        filtered = [(p,t) for p,t in zip(self.price_history, self.price_history_ts) if (now - t) <= 3600.0]\n","        if not filtered: return {}\n","        prices = [p for p,_ in filtered]\n","        p0, p1 = prices[0], prices[-1]\n","        r = (p1-p0)/p0 if p0>0 else 0.0\n","        pmin, pmax = float(np.min(prices)), float(np.max(prices))\n","        # Eventos 1h\n","        ev_1h = [e for e in self.events if (now - datetime.fromisoformat(e[\"ts_utc\"].replace(\"Z\",\"+00:00\")).timestamp())<=3600.0]\n","        # Contadores\n","        buy = sum(1 for e in ev_1h if e.get(\"kind\")==\"BUY_SIGNAL\")\n","        sell= sum(1 for e in ev_1h if e.get(\"kind\")==\"SELL_SIGNAL\")\n","        bull= sum(1 for e in ev_1h if e.get(\"kind\")==\"STATE_CHANGE\" and e.get(\"to\")==\"BULL\")\n","        bear= sum(1 for e in ev_1h if e.get(\"kind\")==\"STATE_CHANGE\" and e.get(\"to\")==\"BEAR\")\n","        # Ruta compacta\n","        timeline = ev_1h\n","\n","        summary = {\n","            \"generated_utc\": datetime.now(timezone.utc).isoformat(),\n","            \"generated_ny\":  datetime.now(TZ_NY).isoformat(),\n","            \"pair\": self.pair,\n","            \"price_start\": p0, \"price_end\": p1, \"ret_1h\": r,\n","            \"price_min\": pmin, \"price_max\": pmax,\n","            \"events_counts\": {\"BUY_SIGNAL\":buy, \"SELL_SIGNAL\":sell, \"BULL\":bull, \"BEAR\":bear},\n","            \"last_trend_state\": self.trend.state if hasattr(self,\"trend\") else None\n","        }\n","\n","        report = {\"summary\": summary, \"timeline\": timeline}\n","\n","        # Persistencia\n","        with open(\"reports/btc_timeline_last_hour.json\",\"w\") as f:\n","            json.dump(report, f, ensure_ascii=False, indent=2)\n","\n","        # CSV simple\n","        with open(\"reports/btc_timeline_last_hour.csv\",\"w\",newline=\"\") as f:\n","            w = csv.writer(f)\n","            w.writerow([\"ts_ny\",\"kind\",\"price\",\"details\"])\n","            for e in timeline:\n","                det = {k:v for k,v in e.items() if k not in {\"ts_utc\",\"ts_ny\",\"kind\",\"price\"}}\n","                w.writerow([e.get(\"ts_ny\"), e.get(\"kind\"), e.get(\"price\"), json.dumps(det, ensure_ascii=False)])\n","\n","        return report\n","\n","    # ----------------------------------- LOOP -----------------------------------\n","    async def start(self, period_s: float = LOOP_PERIOD_S) -> None:\n","        async with aiohttp.ClientSession() as s:\n","            onchain = BTCOnChain(session=s)\n","            try:\n","                while not self._stop:\n","                    # On-chain\n","                    snap_on: Dict[str,Any] = await onchain.snapshot()\n","\n","                    # Mercado: precio / L2 / trades\n","                    try:\n","                        price = float(await self.api.get_ticker_price(pair=self.pair))\n","                    except Exception:\n","                        price = None\n","                    if price is not None:\n","                        self.price_history.append(price)\n","                        self.price_history_ts.append(datetime.now(timezone.utc).timestamp())\n","                        # Mantener 2h de datos\n","                        self.price_history = self.price_history[-7200:]\n","                        self.price_history_ts = self.price_history_ts[-7200:]\n","\n","                    try: ob = await self.api.get_order_book(pair=self.pair, depth=ORDERBOOK_DEPTH)\n","                    except Exception: ob = {\"bids\":[], \"asks\":[]}\n","                    try: trades = await self.api.get_recent_trades(pair=self.pair, limit=200)\n","                    except Exception: trades = []\n","\n","                    micro: Dict[str,Any] = Microstructure.features(ob, trades)\n","\n","                    # Externos\n","                    whale_btc_1m = float(await self.feeds.whale_transactions_btc())\n","                    hidden_gt_10 = bool(await self.feeds.hidden_orders_gt_10btc())\n","                    tbs_ratio    = float(await self.feeds.taker_buy_sell_ratio())\n","                    funding      = float(await self.feeds.funding_rate())\n","                    dark_prints  = bool(await self.feeds.dark_pool_prints())\n","                    dsi          = float(await self.feeds.dark_social_index())\n","                    whale_score  = float(min(1.0, whale_btc_1m / 200.0))\n","                    sent_score   = float(dsi)\n","\n","                    # Fusión 2/3\n","                    decision = self.fusion.decide(micro, snap_on, whale_score, sent_score)\n","                    decision[\"price\"] = price\n","\n","                    # ML online\n","                    x_vec = self._features_vector(micro, snap_on)\n","                    self._push_sample_for_future_label(x_vec, price)\n","                    self._train_from_delayed_labels(price)\n","                    ml_prob_up = float(self.model.predict_proba_up(x_vec))\n","                    decision[\"ml_prob_up\"] = ml_prob_up\n","                    decision[\"ml_confidence\"] = abs(ml_prob_up - 0.5) * 2.0\n","                    decision[\"ml_override\"] = None\n","                    if decision[\"action\"]==\"NEUTRAL\":\n","                        if ml_prob_up>=0.60: decision[\"ml_override\"]=\"BUY_SIGNAL\"\n","                        elif ml_prob_up<=0.40: decision[\"ml_override\"]=\"SELL_SIGNAL\"\n","\n","                    # Metodologías\n","                    trc3 = await self.methods.TRC3()\n","                    lh = await self.methods.LiquidityHunter(\n","                        orderbook=ob, whale_btc_1m=whale_btc_1m,\n","                        hidden_gt_10=hidden_gt_10, tbs_ratio=tbs_ratio,\n","                        funding_rate=funding, dark_prints=dark_prints\n","                    )\n","                    macro = await self.feeds.macro_prices()\n","                    qe = await self.methods.QuantumEntanglement(macro, self.price_history)\n","                    bz = await self.methods.ByzantineShield(ob, await self.feeds.miner_flows_btc())\n","\n","                    decision[\"methods\"] = {\"TRC3\": trc3, \"LiquidityHunter\": lh, \"QuantumEntanglement\": qe, \"ByzantineShield\": bz}\n","\n","                    # Riesgo y SL\n","                    ps = self.risk.position_size(self.price_history, base_risk=BASE_RISK)\n","                    decision[\"position_size_factor\"] = float(ps)\n","                    decision[\"suggested_stop\"] = float(self.risk.dynamic_stop(price if price else 0.0, self.price_history)) if price else None\n","\n","                    # Máquina de estados (tendencia robusta)\n","                    fused = decision[\"ml_override\"] or decision[\"action\"]\n","                    new_state = self.trend.update(ml_prob_up, fused)\n","                    if new_state != self._last_emitted_state:\n","                        self._emit_event(\"STATE_CHANGE\", price, {\"to\": new_state, \"from\": self._last_emitted_state})\n","                        self._last_emitted_state = new_state\n","\n","                    # Eventos de BUY/SELL\n","                    if fused==\"BUY_SIGNAL\":\n","                        self._emit_event(\"BUY_SIGNAL\", price, {\"reason\":\"fusion/ML\"})\n","                    elif fused==\"SELL_SIGNAL\":\n","                        self._emit_event(\"SELL_SIGNAL\", price, {\"reason\":\"fusion/ML\"})\n","\n","                    # Enriquecer + exponer última señal\n","                    decision[\"trend_state\"] = new_state\n","                    self.last_signal = decision\n","\n","                    # Persistencia\n","                    snapshot: Dict[str,Any] = {\n","                        \"ts_utc\": decision[\"ts_utc\"], \"pair\": self.pair, \"price\": price,\n","                        \"onchain\": snap_on, \"micro\": micro, \"decision\": decision\n","                    }\n","                    with open(\"onchain_cache/btc_intel_snapshot.json\",\"w\") as f:\n","                        json.dump(snapshot, f, ensure_ascii=False, indent=2)\n","\n","                    # Logs CSV\n","                    extras = {\n","                        \"TRC3_signal\": trc3.get(\"signal\"),\n","                        \"LH_action\": lh.get(\"action\"),\n","                        \"QE_signal\": qe.get(\"signal\"),\n","                        \"BZ_defense\": bz.get(\"defense\")\n","                    }\n","                    self._log_micro(micro)\n","                    self._log_signal(decision, ml_prob_up, extras)\n","\n","                    # Console resumen (compacto)\n","                    def r3(x):\n","                        try: return round(float(x),3)\n","                        except Exception: return x\n","                    mem_count = int(snap_on.get(\"mempool\",{}).get(\"count\",0))\n","                    fast_fee  = float(snap_on.get(\"fees_recommended\",{}).get(\"fastestFee\",0.0))\n","                    print(\n","                        f\"🧠 BTC INTEL | px={price} | trend={new_state} | fusion={decision['action']} \"\n","                        f\"| ml={r3(ml_prob_up)} | TRC3={trc3.get('signal')} | LH={lh.get('action')} | QE={qe.get('signal')} | BZ={bz.get('defense')} \"\n","                        f\"| spread={r3(micro.get('spread_bps'))}bps | imb={r3(micro.get('imbalance_bid_share'))} \"\n","                        f\"| mempool={mem_count} | fastFee={fast_fee} sat/vB | ps={r3(ps)}\"\n","                    )\n","\n","                      # Informe de la última hora ~cada minuto\n","                    if self.iter % 60 == 0 and self.iter>0:\n","                        self.generate_last_hour_report()\n","\n","                    self.iter += 1\n","                    await asyncio.sleep(max(0.05, float(period_s)))\n","            finally:\n","                await onchain.close()\n","                try: await self.feeds.close()\n","                except Exception: pass\n","                try:\n","                    if self._shared_session and not self._shared_session.closed:\n","                        await self._shared_session.close()\n","                except Exception: pass\n","\n","    def stop(self) -> None:\n","        self._stop = True\n","\n","# ================================================================\n","# ================ PARÁMETROS DE FUSIÓN CORE + ML ================\n","# ================================================================\n","FUSION_REQUIRE_TREND_CONFIRM = True\n","FUSION_ALLOW_NEUTRAL_TREND   = True\n","FUSION_MIN_SIZE              = 0.05\n","FUSION_DEFAULT_SIZE          = 0.20\n","FUSION_MAX_SL_PCT            = 3.5\n","FUSION_CORE_OVERRIDE_NEUTRAL = True\n","\n","# ================================================================\n","# ================ UTILIDADES Y LOGS UNIFICADOS ==================\n","# ================================================================\n","def cfg(name: str, default):\n","    \"\"\"Lee de Config si existe; si no, devuelve default.\"\"\"\n","    try:\n","        # type: ignore[name-defined]\n","        return getattr(Config, name, default)\n","    except Exception:\n","        return default\n","\n","import datetime as dt\n","from pytz import timezone as _tz\n","def now_ny_str() -> str:\n","    try:\n","        return dt.datetime.now(_tz(\"America/New_York\")).strftime(\"%Y-%m-%d %H:%M:%S\")\n","    except Exception:\n","        return dt.datetime.utcnow().strftime(\"%Y-%m-%d %H:%M:%S\")\n","\n","def ensure_dirs():\n","    os.makedirs(\"resultados\", exist_ok=True)\n","    os.makedirs(\"reports\", exist_ok=True)\n","    os.makedirs(\"logs\", exist_ok=True)\n","    os.makedirs(\"./cache_ohlc\", exist_ok=True)\n","\n","async def maybe_exec(executor, decision: str, price: float, extras: Dict[str, Any]):\n","    \"\"\"Invoca el ejecutor con seguridad y límites de SL%.\"\"\"\n","    if decision == \"ESPERAR\":\n","        return\n","    max_sl_pct = cfg(\"FUSION_MAX_SL_PCT\", FUSION_MAX_SL_PCT)\n","    if isinstance(extras.get(\"sl\"), dict) and \"%\" in extras[\"sl\"]:\n","        try:\n","            pct = float(str(extras[\"sl\"][\"%\"]))\n","            if pct > max_sl_pct:\n","                extras[\"sl\"][\"%\"] = max_sl_pct\n","        except Exception:\n","            pass\n","\n","    target = None\n","    if hasattr(executor, \"ejecutar_decision\") and callable(getattr(executor, \"ejecutar_decision\")):\n","        target = executor.ejecutar_decision\n","    elif hasattr(executor, \"execute_order\") and callable(getattr(executor, \"execute_order\")):\n","        target = executor.execute_order\n","\n","    if not target:\n","        print(\"⚠️ Ejecutor no expone 'ejecutar_decision/execute_order'; omitiendo trade.\")\n","        return\n","\n","    try:\n","        await target(decision, price, **extras)\n","    except TypeError:\n","        await target(decision, price)\n","\n","# ================================================================\n","# ============== BLOQUE OHLC ROBUSTO (Kraken, PERMANENTE) ========\n","# ================================================================\n","import os, json, time, asyncio, logging, random\n","from typing import Any, Dict, Optional, List\n","from pathlib import Path\n","from tenacity import retry, stop_after_attempt, wait_random_exponential, retry_if_exception, before_sleep_log\n","\n","# ----------------------- Logger limpio y silencioso -----------------------\n","logger = logging.getLogger(\"ohlc_robusto\")\n","if not logger.handlers:\n","    handler = logging.StreamHandler()\n","    logger.addHandler(handler)\n","logger.setLevel(logging.INFO)\n","logger.propagate = False\n","\n","# Sub-logger solo para reintentos (silenciado por defecto)\n","OHLC_RETRY_LOG_LEVEL_NAME = os.getenv(\"OHLC_RETRY_LOG_LEVEL\", \"CRITICAL\").upper()\n","OHLC_RETRY_LOG_LEVEL = getattr(logging, OHLC_RETRY_LOG_LEVEL_NAME, logging.CRITICAL)\n","_retry_logger = logging.getLogger(\"ohlc_robusto.retry\")\n","if not _retry_logger.handlers:\n","    _retry_logger.addHandler(logging.StreamHandler())\n","_retry_logger.setLevel(OHLC_RETRY_LOG_LEVEL)\n","_retry_logger.propagate = False\n","\n","# Silenciar también tenacity global\n","try:\n","    logging.getLogger(\"tenacity\").setLevel(logging.CRITICAL)\n","    logging.getLogger(\"tenacity.retry\").setLevel(logging.CRITICAL)\n","except Exception:\n","    pass\n","# --------------------------------------------------------------------------\n","\n","# ------------------------------ Configurable ------------------------------\n","KRAKEN_PUBLIC_RPS            = float(os.getenv(\"KRAKEN_PUBLIC_RPS\", \"0.8\"))   # ~1 req/1.25s\n","KRAKEN_MAX_REINTENTOS        = int(os.getenv(\"KRAKEN_MAX_REINTENTOS\", \"7\"))\n","KRAKEN_BACKOFF_MIN_SECONDS   = float(os.getenv(\"KRAKEN_BACKOFF_MIN_SECONDS\", \"1.0\"))\n","KRAKEN_BACKOFF_MAX_SECONDS   = float(os.getenv(\"KRAKEN_BACKOFF_MAX_SECONDS\", \"60.0\"))\n","KRAKEN_OHLC_CACHE_DIR        = os.getenv(\"KRAKEN_OHLC_CACHE_DIR\", \"./cache_ohlc\")\n","KRAKEN_STALE_MAX_AGE_S       = int(os.getenv(\"KRAKEN_STALE_MAX_AGE_S\", \"180\"))  # cache reciente\n","KRAKEN_PENALTY_SECONDS       = float(os.getenv(\"KRAKEN_PENALTY_SECONDS\", \"30\")) # ventana tras 429\n","KRAKEN_JITTER_MAX_S          = float(os.getenv(\"KRAKEN_JITTER_MAX_S\", \"0.08\"))  # jitter para desincronizar\n","# --------------------------------------------------------------------------\n","\n","# Asegura carpeta de caché\n","try:\n","    Path(KRAKEN_OHLC_CACHE_DIR).mkdir(parents=True, exist_ok=True)\n","except Exception:\n","    pass\n","\n","# ----------------------- Rate limiter dinamico con penalizacion -----------\n","class _RateLimiterDyn:\n","    \"\"\"\n","    Rate limiter con:\n","      - base_interval = 1 / rps\n","      - factor dinamico (sube con penalizaciones, baja con cool_down)\n","      - ventana de penalizacion temporal (penalty_until)\n","      - jitter aleatorio para evitar thundering herd\n","    \"\"\"\n","    def __init__(self, rps: float):\n","        self.base_interval = 1.0 / max(rps, 1e-6)\n","        self.factor = 1.0\n","        self.max_factor = 8.0\n","        self._next = time.monotonic()\n","        self._lock = asyncio.Lock()\n","        self._penalty_until = 0.0\n","\n","    async def wait(self):\n","        async with self._lock:\n","            now = time.monotonic()\n","            delay = self._next - now\n","            if delay > 0:\n","                await asyncio.sleep(delay)\n","\n","            # durante la ventana de penalizacion, usamos al menos factor 2.0\n","            eff_factor = self.factor\n","            if now < self._penalty_until:\n","                eff_factor = max(eff_factor, 2.0)\n","\n","            # jitter aleatorio (0..KRAKEN_JITTER_MAX_S)\n","            jitter = random.random() * max(KRAKEN_JITTER_MAX_S, 0.0)\n","            interval = self.base_interval * eff_factor + jitter\n","\n","            now = time.monotonic()\n","            self._next = max(self._next, now) + interval\n","\n","    def penalize(self, sev: float = 1.0, seconds: Optional[float] = None):\n","        \"\"\"Aumenta factor y abre ventana de penalizacion temporal.\"\"\"\n","        old = self.factor\n","        self.factor = min(self.factor * (1.0 + 0.5 * max(sev, 0.1)), self.max_factor)\n","        if seconds is None:\n","            seconds = KRAKEN_PENALTY_SECONDS\n","        self._penalty_until = max(self._penalty_until, time.monotonic() + max(0.0, seconds))\n","        logger.info(f\"[OHLC] Penalizacion por 429: factor {old:.2f} -> {self.factor:.2f}, ventana {int(seconds)}s\")\n","\n","    def cool_down(self):\n","        \"\"\"Reduce suavemente el factor cuando no hay errores y salio la ventana.\"\"\"\n","        if time.monotonic() >= self._penalty_until and self.factor > 1.0:\n","            self.factor = max(1.0, self.factor * 0.9)\n","\n","_ohlc_rate_limiter = _RateLimiterDyn(KRAKEN_PUBLIC_RPS)\n","_ohlc_serial_lock  = asyncio.Lock()  # serializa OHLC para reducir 429\n","\n","# -------------------------- Coalescer de llamadas -------------------------\n","class _Coalescer:\n","    def __init__(self):\n","        self._inflight: Dict[str, asyncio.Task] = {}\n","        self._lock = asyncio.Lock()\n","\n","    async def get(self, key: str, coro_factory):\n","        async with self._lock:\n","            t = self._inflight.get(key)\n","            if t:\n","                return await t\n","            t = asyncio.create_task(coro_factory())\n","            self._inflight[key] = t\n","        try:\n","            return await t\n","        finally:\n","            async with self._lock:\n","                self._inflight.pop(key, None)\n","\n","_COALESCER = _Coalescer()\n","\n","# ------------------------------ Utilidades --------------------------------\n","def _cache_path(pair: str, interval: int) -> Path:\n","    safe = pair.replace(\"/\", \"_\").replace(\":\", \"_\")\n","    return Path(KRAKEN_OHLC_CACHE_DIR) / f\"ohlc_{safe}_{interval}.json\"\n","\n","def _leer_cache(pair: str, interval: int) -> Optional[Dict[str, Any]]:\n","    p = _cache_path(pair, interval)\n","    if not p.exists():\n","        return None\n","    try:\n","        with p.open(\"r\", encoding=\"utf-8\") as f:\n","            return json.load(f)\n","    except Exception as e:\n","        logger.debug(f\"[CACHE] Error leyendo cache {pair}-{interval}: {e}\")\n","        return None\n","\n","def _guardar_cache(pair: str, interval: int, data: Dict[str, Any]) -> None:\n","    p = _cache_path(pair, interval)\n","    data = dict(data)\n","    data[\"updated_at\"] = time.time()\n","    tmp = p.with_suffix(\".tmp\")\n","    try:\n","        with tmp.open(\"w\", encoding=\"utf-8\") as f:\n","            json.dump(data, f)\n","        tmp.replace(p)\n","    except Exception as e:\n","        logger.debug(f\"[CACHE] Error guardando cache {pair}-{interval}: {e}\")\n","\n","def _merge_velas(existing: List[List[float]], new: List[List[float]]) -> List[List[float]]:\n","    if not existing:\n","        return sorted(new or [], key=lambda x: int(x[0]))\n","    if not new:\n","        return sorted(existing, key=lambda x: int(x[0]))\n","    by_ts = {int(v[0]): v for v in existing}\n","    for v in new:\n","        by_ts[int(v[0])] = v\n","    merged = sorted(by_ts.values(), key=lambda x: int(x[0]))\n","    return merged\n","\n","def _ultimo_since(velas: List[List[float]]) -> int:\n","    return int(velas[-1][0]) if velas else 0\n","\n","class TooManyRequestsError(Exception): ...\n","class KrakenTemporaryError(Exception): ...\n","\n","def _es_too_many_requests(e: Exception) -> bool:\n","    m = str(e).lower()\n","    return (\"too many requests\" in m) or (\"egeneral:too many requests\" in m) or (\"429\" in m)\n","\n","def _es_temporal(e: Exception) -> bool:\n","    m = str(e).lower()\n","    return any(s in m for s in [\"timeout\", \"tempor\", \"5xx\", \"service\", \"unavailable\", \"connection\", \"timed out\"])\n","\n","def _normalize_mapping_resp(resp: Any) -> Dict[str, Any]:\n","    if isinstance(resp, tuple) and len(resp) >= 1:\n","        resp = resp[0]\n","    if not isinstance(resp, dict):\n","        raise TypeError(f\"Respuesta Kraken inesperada (tipo {type(resp).__name__})\")\n","    return resp\n","\n","# ------------------- Núcleo con retry (sin warnings) -----------------------\n","@retry(\n","    reraise=True,\n","    stop=stop_after_attempt(KRAKEN_MAX_REINTENTOS),\n","    wait=wait_random_exponential(multiplier=KRAKEN_BACKOFF_MIN_SECONDS, max=KRAKEN_BACKOFF_MAX_SECONDS),\n","    retry=retry_if_exception(lambda e: _es_too_many_requests(e) or _es_temporal(e) or isinstance(e, (TooManyRequestsError, KrakenTemporaryError))),\n","    before_sleep=before_sleep_log(_retry_logger, logging.DEBUG)  # DEBUG a logger silenciado\n",")\n","async def __llamar_kraken_ohlc_impl(api, params: Dict[str, Any]) -> Dict[str, Any]:\n","    await _ohlc_rate_limiter.wait()\n","    async with _ohlc_serial_lock:\n","        try:\n","            raw = await api.query_public(\"OHLC\", params)\n","        except Exception as ex:\n","            # cualquier fallo de transporte se trata como temporal\n","            raise KrakenTemporaryError(str(ex))\n","        resp = _normalize_mapping_resp(raw)\n","        if resp.get(\"error\"):\n","            msg = \" \".join(map(str, resp[\"error\"])) if isinstance(resp[\"error\"], list) else str(resp[\"error\"])\n","            if _es_too_many_requests(Exception(msg)):\n","                # penalizacion fuerte + ventana temporal\n","                _ohlc_rate_limiter.penalize(sev=1.5, seconds=KRAKEN_PENALTY_SECONDS)\n","                raise TooManyRequestsError(msg)\n","            # otros errores del servicio los tratamos como temporales para retry\n","            raise KrakenTemporaryError(msg)\n","        # exito: reducimos factor si procede\n","        _ohlc_rate_limiter.cool_down()\n","        return resp\n","\n","# Wrapper publico con coalescing (mantiene tu nombre original)\n","async def _llamar_kraken_ohlc(api, params: Dict[str, Any]) -> Dict[str, Any]:\n","    key = f\"OHLC:{params.get('pair')}:{params.get('interval')}:{params.get('since', 0)}\"\n","    return await _COALESCER.get(key, lambda: __llamar_kraken_ohlc_impl(api, params))\n","\n","# ----------------------- API de alto nivel con cache -----------------------\n","async def obtener_ohlc_valido(\n","    api,\n","    pair: str = \"XBTUSD\",\n","    interval: int = 5,\n","    min_candles: int = 200,\n","    usar_cache_fallback: bool = True\n",") -> Dict[str, Any]:\n","    \"\"\"\n","    Devuelve: {\"pair\": str, \"interval\": int, \"candles\": List[List[float]], \"from_cache\": bool}\n","    - Usa cache reciente cuando hay 429/errores temporales (stale-while-revalidate).\n","    - Deduplica y limita llamadas para evitar throttling.\n","    \"\"\"\n","    cache = _leer_cache(pair, interval) or {\"candles\": [], \"pair\": pair, \"interval\": interval, \"updated_at\": 0}\n","    candles = cache.get(\"candles\", [])\n","    since = _ultimo_since(candles)\n","    params = {\"pair\": pair, \"interval\": int(interval)}\n","    if since > 0:\n","        params[\"since\"] = since\n","\n","    try:\n","        resp = await _llamar_kraken_ohlc(api, params)\n","        result = resp.get(\"result\", {})\n","        par_keys = [k for k in result.keys() if k != \"last\"]\n","        if not par_keys:\n","            raise KrakenTemporaryError(\"Respuesta OHLC sin datos de par\")\n","        par_key = par_keys[0]\n","        nuevas = result.get(par_key, [])\n","        merged = _merge_velas(candles, nuevas)\n","        merged = [v for v in merged if isinstance(v, list) and len(v) >= 8]\n","        _guardar_cache(pair, interval, {\"pair\": pair, \"interval\": interval, \"candles\": merged, \"last_ts\": int(time.time())})\n","        if len(merged) < min_candles and usar_cache_fallback and candles:\n","            # si por throttling entraron pocas velas, usa lo mejor disponible\n","            merged = candles if len(candles) > len(merged) else merged\n","        return {\"pair\": pair, \"interval\": interval, \"candles\": merged, \"from_cache\": False}\n","\n","    except Exception:\n","        # Fallback a cache reciente si esta fresca\n","        updated_at = float(cache.get(\"updated_at\") or 0)\n","        age = time.time() - updated_at\n","        if usar_cache_fallback and cache.get(\"candles\") and age <= KRAKEN_STALE_MAX_AGE_S:\n","            logger.info(f\"[OHLC] Fallback a cache reciente para {pair}-{interval} (edad {int(age)}s).\")\n","            return {\"pair\": pair, \"interval\": interval, \"candles\": cache[\"candles\"], \"from_cache\": True}\n","        # Si no hay cache utilizable, propaga\n","        raise\n","\n","# —— Adaptador del router para mantener tu interfaz con robustez Kraken —— #\n","class RouterWrapper:\n","    \"\"\"\n","    Envuelve tu MarketDataRouter para:\n","      - get_ohlc(n): OHLC robusto Kraken (ultimas n velas)\n","      - get_price(): ultimo close del OHLC robusto (fallback al router original)\n","    \"\"\"\n","    def __init__(self, router, api, pair_alias: str = 'XXBTZUSD', interval: int = 1):\n","        self._router = router\n","        self._api = api\n","        self._pair_rest = \"XBTUSD\" if \"XBT\" in pair_alias else pair_alias.replace(\"ZUSD\", \"USD\").replace(\"ZEUR\", \"EUR\")\n","        self._interval = int(interval)\n","\n","    async def get_ohlc(self, n: Optional[int] = None) -> List[List[float]]:\n","        datos = await obtener_ohlc_valido(self._api, pair=self._pair_rest, interval=self._interval, min_candles=max(200, n or 200))\n","        velas = datos[\"candles\"]\n","        return velas[-n:] if n else velas\n","\n","    async def get_price(self) -> float:\n","        try:\n","            datos = await obtener_ohlc_valido(self._api, pair=self._pair_rest, interval=self._interval, min_candles=5)\n","            if datos[\"candles\"]:\n","                return float(datos[\"candles\"][-1][4])\n","        except Exception as e:\n","            try:\n","                if hasattr(self._router, \"get_price\"):\n","                    return float(await self._router.get_price())\n","            except Exception:\n","                logger.debug(f\"Fallback de precio también fallo: {e}\")\n","        return 0.0\n","\n","# ========================= FIN BLOQUE OHLC ROBUSTO =========================\n","\n","\n","# ================================================================\n","# ============= HELPERS ROBUSTOS PARA BTC INTEL ==================\n","# ================================================================\n","def _ensure_last_signal_attr(obj):\n","    \"\"\"Asegura que la instancia tenga atributo last_signal para evitar AttributeError.\"\"\"\n","    if obj is not None and not hasattr(obj, \"last_signal\"):\n","        try:\n","            setattr(obj, \"last_signal\", None)\n","        except Exception:\n","            pass\n","    return obj\n","\n","async def _safe_init_btc_intelligence():\n","    \"\"\"\n","    Envuelve init_btc_intelligence() de forma segura.\n","    Devuelve lo que retorne el init 'tal cual'.\n","    \"\"\"\n","    try:\n","        return await init_btc_intelligence()\n","    except Exception as e:\n","        print(f\"⚠️ init_btc_intelligence falló: {e}\")\n","        return None\n","\n","def _is_session(o):\n","    try:\n","        return isinstance(o, aiohttp.ClientSession)\n","    except Exception:\n","        return False\n","\n","def _is_market(o):\n","    return hasattr(o, \"get_ticker_price\") and hasattr(o, \"get_order_book\") and hasattr(o, \"get_recent_trades\")\n","\n","def _is_intel(o):\n","    return hasattr(o, \"start\") and (hasattr(o, \"trend\") or hasattr(o, \"fusion\") or hasattr(o, \"methods\"))\n","\n","def _unpack_intel_ctx(ctx):\n","    \"\"\"\n","    Acepta (intel, market, session) o (session, market, intel) u otras variantes\n","    y normaliza a: (inteligencia, shared_session). Asegura .last_signal.\n","    \"\"\"\n","    inteligencia = None\n","    shared_session = None\n","\n","    if isinstance(ctx, tuple) and len(ctx) == 3:\n","        a, b, c = ctx\n","        # Orden nuevo correcto\n","        if _is_intel(a) and _is_session(c):\n","            inteligencia, shared_session = a, c\n","        # Orden heredado\n","        elif _is_session(a) and _is_intel(c):\n","            inteligencia, shared_session = c, a\n","        else:\n","            for o in (a, b, c):\n","                if _is_intel(o):\n","                    inteligencia = o; break\n","            for o in (a, b, c):\n","                if _is_session(o):\n","                    shared_session = o; break\n","    elif _is_intel(ctx):\n","        inteligencia = ctx\n","\n","    inteligencia = _ensure_last_signal_attr(inteligencia)\n","    return inteligencia, shared_session\n","\n","# -*- coding: utf-8 -*-\n","# ================================================================================================\n","# ===================== TIMEZONE FIX (permanente, idempotente y seguro) ==========================\n","# - Evita:  AttributeError: 'function' object has no attribute 'utc'\n","# - Evita:  TypeError: timezone() argument 1 must be datetime.timedelta, not str\n","# - Deja de usar:   from pytz import timezone\n","# - Usa SIEMPRE:    UTC, tz(\"Area/City\"), utc_now(), utc_now_iso()\n","# - Incluye:        ruta de logs definida/validada y escritura sin utcnow() legacy\n","# ================================================================================================\n","\n","import os\n","import sys\n","import asyncio\n","import warnings as _warnings\n","import datetime as dt\n","from datetime import datetime, timedelta  # compat\n","from types import ModuleType\n","from typing import Any, Optional, Awaitable, Callable\n","\n","# ---------- Preferencia de raíz de ejecución / logs (ruta definida y válida) ----------\n","# Puedes cambiarla por ENV sin romper nada.\n","RUN_ROOT = os.getenv(\"TTDVI_RUN_ROOT\", \"./run_ttdvi156\").strip() or \"./run_ttdvi156\"\n","DEFAULT_LOG_DIR = os.path.join(RUN_ROOT, \"logs\")\n","DEFAULT_LOG_FILE = os.path.join(DEFAULT_LOG_DIR, \"eventos.log\")\n","\n","def _ensure_dir(path: str) -> str:\n","    try:\n","        os.makedirs(path, exist_ok=True)\n","    except Exception:\n","        # Fallback mínimo garantizado\n","        alt = \"./logs\"\n","        try:\n","            os.makedirs(alt, exist_ok=True)\n","            return alt\n","        except Exception:\n","            return \".\"\n","    return path\n","\n","# Normaliza cualquier ruta de archivo solicitada (expande ~ y variables)\n","def _resolve_file_path(ruta: Optional[str]) -> str:\n","    base_dir = _ensure_dir(DEFAULT_LOG_DIR)\n","    if not ruta:\n","        return os.path.join(base_dir, \"eventos.log\")\n","    ruta = os.path.expanduser(os.path.expandvars(ruta))\n","    # Si es carpeta, escribe en eventos.log dentro de ella\n","    if ruta.endswith(os.sep) or ruta.lower().endswith(\"/\"):\n","        _ensure_dir(ruta)\n","        return os.path.join(ruta, \"eventos.log\")\n","    # Si es relativo, cuélgalo de RUN_ROOT para mantener todo contenido\n","    if not os.path.isabs(ruta):\n","        return os.path.join(RUN_ROOT, ruta)\n","    # Absoluto: créale carpeta\n","    _ensure_dir(os.path.dirname(ruta) or \".\")\n","    return ruta\n","\n","# ---------- NUNCA vuelvas a hacer: `from pytz import timezone` ----------\n","try:\n","    import pytz  # type: ignore\n","except Exception:\n","    pytz = None  # fallback si no está instalado\n","\n","# ---------- ZoneInfo preferido (Py3.9+) ----------\n","try:\n","    from zoneinfo import ZoneInfo  # type: ignore\n","except Exception:\n","    ZoneInfo = None  # fallback a pytz si no existe\n","\n","# ---------- Silencio/estricto para warnings de utcnow() legacy ----------\n","if os.getenv(\"STRICT_UTCNOW\", \"0\") == \"1\":\n","    _warnings.filterwarnings(\n","        \"error\",\n","        category=DeprecationWarning,\n","        message=r\".*datetime\\.datetime\\.utcnow\\(\\) is deprecated.*\",\n","    )\n","else:\n","    _warnings.filterwarnings(\n","        \"ignore\",\n","        category=DeprecationWarning,\n","        message=r\".*datetime\\.datetime\\.utcnow\\(\\) is deprecated.*\",\n","    )\n","\n","# ================================== API PÚBLICA SIMPLE ==================================\n","UTC = getattr(dt, \"UTC\", dt.timezone.utc)  # UTC estándar (py311+ o py<311)\n","\n","def tz(name: str):\n","    \"\"\"\n","    Devuelve un tzinfo estable:\n","    - Preferente ZoneInfo (correcto para Py3.9+)\n","    - Fallback a pytz si ZoneInfo no está disponible\n","    - Último recurso: UTC si falla todo\n","    \"\"\"\n","    if not name or str(name).upper() in (\"UTC\", \"Z\"):\n","        return UTC\n","    if ZoneInfo is not None:\n","        try:\n","            return ZoneInfo(name)\n","        except Exception:\n","            pass\n","    if pytz is not None:\n","        try:\n","            return pytz.timezone(name)  # type: ignore\n","        except Exception:\n","            pass\n","    return UTC\n","\n","def utc_now() -> datetime:\n","    \"\"\"Datetime consciente de zona (aware) en UTC, sin ambigüedades.\"\"\"\n","    return datetime.now(UTC)\n","\n","def utc_now_iso() -> str:\n","    \"\"\"ISO 8601 en UTC, sin microsegundos (estable).\"\"\"\n","    return utc_now().replace(microsecond=0).isoformat()\n","\n","# ================================== SHIM DEFENSIVO ==================================\n","# Parchea `datetime.timezone` para aceptar cadenas tipo \"Area/City\" sin reventar\n","# y mantener .utc. Es idempotente y respeta timedelta/None como el original.\n","_ORIG_TIMEZONE = dt.timezone  # Guarda referencia original\n","\n","def _safe_tz_from_string(name: str):\n","    if not name or str(name).upper() in (\"UTC\", \"Z\"):\n","        return UTC\n","    if ZoneInfo is not None:\n","        try:\n","            return ZoneInfo(name)\n","        except Exception:\n","            pass\n","    if pytz is not None:\n","        try:\n","            return pytz.timezone(name)  # type: ignore\n","        except Exception:\n","            pass\n","    return UTC\n","\n","class _TimezoneShim:\n","    \"\"\"Proxy de datetime.timezone que acepta str, tzinfo, timedelta o None.\"\"\"\n","    def __init__(self, original_timezone):\n","        self._orig = original_timezone\n","        try:\n","            self.utc = original_timezone.utc  # type: ignore[attr-defined]\n","        except Exception:\n","            self.utc = UTC\n","\n","    def __call__(self, arg=None, *args, **kwargs):\n","        if isinstance(arg, str):\n","            return _safe_tz_from_string(arg)\n","        if isinstance(arg, dt.tzinfo):\n","            return arg\n","        if isinstance(arg, dt.timedelta) or arg is None:\n","            return self._orig(arg, *args, **kwargs)\n","        return self.utc\n","\n","    # Delegación segura de atributos hacia el original\n","    def __getattr__(self, name):\n","        return getattr(self._orig, name)\n","\n","# Instala el shim de forma segura e idempotente\n","if not getattr(dt.timezone, \"_tz_guard_installed\", False):\n","    try:\n","        dt.timezone = _TimezoneShim(_ORIG_TIMEZONE)  # type: ignore[assignment]\n","        setattr(dt.timezone, \"_tz_guard_installed\", True)  # type: ignore[attr-defined]\n","    except Exception:\n","        pass\n","\n","def _auto_patch_loaded_modules():\n","    \"\"\"Reemplaza símbolos 'timezone' ya importados en módulos por nuestro shim.\"\"\"\n","    tz_guard = dt.timezone\n","    for m in list(sys.modules.values()):\n","        try:\n","            if isinstance(m, ModuleType) and hasattr(m, \"timezone\"):\n","                att = getattr(m, \"timezone\")\n","                if att is _ORIG_TIMEZONE or att is tz_guard:\n","                    setattr(m, \"timezone\", tz_guard)\n","        except Exception:\n","            pass\n","\n","_auto_patch_loaded_modules()\n","timezone = getattr(dt, \"timezone\", _ORIG_TIMEZONE)\n","\n","# -*- coding: utf-8 -*-\n","# ================================================================================================\n","# ===================== TIMEZONE FIX (permanente, idempotente y seguro) ==========================\n","# - Evita:  AttributeError: 'function' object has no attribute 'utc'\n","# - Evita:  TypeError: timezone() argument 1 must be datetime.timedelta, not str\n","# - Deja de usar:   from pytz import timezone\n","# - Usa SIEMPRE:    UTC, tz(\"Area/City\"), utc_now(), utc_now_iso()\n","# ================================================================================================\n","\n","import os\n","import sys\n","import asyncio\n","import warnings as _warnings\n","import datetime as dt\n","from datetime import datetime, timedelta  # compat\n","from types import ModuleType\n","from typing import Any, Optional, Awaitable, Callable\n","\n","# ---------- NUNCA vuelvas a hacer: `from pytz import timezone` ----------\n","# Usaremos pytz solo como fallback (sin ensombrecer símbolos)\n","try:\n","    import pytz  # type: ignore\n","except Exception:\n","    pytz = None  # fallback si no está instalado\n","\n","# ---------- ZoneInfo preferido (Py3.9+) ----------\n","try:\n","    from zoneinfo import ZoneInfo  # type: ignore\n","except Exception:\n","    ZoneInfo = None  # type: ignore\n","\n","# ========================== Núcleo seguro de zonas y utilidades ==========================\n","_ORIG_TIMEZONE = dt.timezone  # preservamos referencia original\n","_TZ_MISUSE_MSG = \"timezone() argument 1 must be datetime.timedelta, not str\"\n","\n","def utc_now() -> datetime:\n","    \"\"\"Ahora en UTC, siempre tz-aware.\"\"\"\n","    return datetime.now(dt.timezone.utc)\n","\n","def utc_now_iso() -> str:\n","    \"\"\"Ahora en UTC en ISO8601 sin microsegundos.\"\"\"\n","    return utc_now().replace(microsecond=0).isoformat()\n","\n","def tz(name: str) -> dt.tzinfo:\n","    \"\"\"\n","    Devuelve un tzinfo para 'Area/City'.\n","    - Usa ZoneInfo si está disponible\n","    - Fallback a pytz si es necesario\n","    - Fallback fijo sin DST como último recurso (evita romper ejecución)\n","    \"\"\"\n","    if ZoneInfo is not None:\n","        try:\n","            return ZoneInfo(name)\n","        except Exception:\n","            pass\n","    if pytz is not None:\n","        try:\n","            return pytz.timezone(name)  # type: ignore\n","        except Exception:\n","            pass\n","\n","    class _FixedTZ(dt.tzinfo):\n","        def __init__(self, name: str, offset_hours: int):\n","            self._name = name\n","            self._offset = timedelta(hours=offset_hours)\n","        def utcoffset(self, _d): return self._offset\n","        def tzname(self, _d): return self._name\n","        def dst(self, _d): return timedelta(0)\n","\n","    # offsets aproximados para no romper (sin DST)\n","    fixed_offsets = {\n","        \"America/Vancouver\": -7, \"America/Toronto\": -4, \"America/New_York\": -4,\n","        \"America/Bogota\": -5,   \"America/Mexico_City\": -6,\n","        \"Europe/Madrid\": +2,    \"Europe/London\": +1,   \"UTC\": 0,\n","    }\n","    return _FixedTZ(name, fixed_offsets.get(name, 0))\n","\n","# ========================== Shim opcional de guardia ==========================\n","class _TimezoneShim:\n","    \"\"\"\n","    Envoltorio que preserva la API de datetime.timezone pero protege del mal uso:\n","    - Acepta solo timedelta para offset (igual que el original)\n","    - Mantiene acceso a 'utc'\n","    \"\"\"\n","    def __init__(self, orig: Any):\n","        self._orig = orig\n","        self.utc = orig.utc  # propiedad estándar\n","        # bandera de instalación para auto-chequeos\n","        setattr(self, \"_tz_guard_installed\", True)\n","\n","    def __call__(self, offset: timedelta, name: Optional[str] = None):\n","        if not isinstance(offset, timedelta):\n","            raise TypeError(_TZ_MISUSE_MSG)\n","        return self._orig(offset, name) if name is not None else self._orig(offset)\n","\n","    def __getattr__(self, item):\n","        return getattr(self._orig, item)\n","\n","# Auto-parcheo de módulos ya cargados que hayan ensombrecido 'timezone'\n","def _auto_patch_loaded_modules():\n","    try:\n","        for m in list(sys.modules.values()):\n","            try:\n","                if isinstance(m, ModuleType) and hasattr(m, \"timezone\"):\n","                    # Les apuntamos al símbolo correcto actual\n","                    setattr(m, \"timezone\", dt.timezone)\n","            except Exception:\n","                continue\n","    except Exception:\n","        pass\n","\n","def _patch_module_timezone_symbol(mod: ModuleType):\n","    try:\n","        setattr(mod, \"timezone\", dt.timezone)\n","    except Exception:\n","        pass\n","\n","def _is_tz_misuse_error(exc: BaseException) -> bool:\n","    return isinstance(exc, TypeError) and _TZ_MISUSE_MSG in str(exc)\n","\n","def _repair_timezone_on_error(obj: Any):\n","    \"\"\"\n","    Si detectamos mal uso (timezone('America/...')), reparamos el símbolo en el módulo\n","    y garantizamos que dt.timezone sea un shim con guardia instalada solo una vez.\n","    \"\"\"\n","    try:\n","        import inspect\n","        mod = inspect.getmodule(obj)\n","        if mod is not None:\n","            _patch_module_timezone_symbol(mod)\n","    except Exception:\n","        pass\n","    try:\n","        # ✅ LÍNEA CORREGIDA (sin corte de cadena y nombre exacto de la bandera):\n","        if not getattr(dt.timezone, \"_tz_guard_installed\", False):  # puede venir de un objeto reconstruido\n","            dt.timezone = _TimezoneShim(_ORIG_TIMEZONE)  # type: ignore[assignment]\n","            setattr(dt.timezone, \"_tz_guard_installed\", True)  # type: ignore[attr-defined]\n","    except Exception:\n","        pass\n","    _auto_patch_loaded_modules()\n","\n","def run_with_tz_auto_repair(func: Callable, *args, **kwargs):\n","    \"\"\"Ejecuta función sync; si detecta misuse de timezone, repara y reintenta una vez.\"\"\"\n","    try:\n","        return func(*args, **kwargs)\n","    except Exception as e:\n","        if _is_tz_misuse_error(e):\n","            _repair_timezone_on_error(func)\n","            return func(*args, **kwargs)\n","        raise\n","\n","async def run_with_tz_auto_repair_async(func_or_coro: Callable, *args, **kwargs):\n","    \"\"\"Ejecuta función/corutina; si detecta misuse de timezone, repara y reintenta una vez.\"\"\"\n","    try:\n","        res = func_or_coro(*args, **kwargs)\n","        if asyncio.iscoroutine(res) or isinstance(res, Awaitable):\n","            return await res\n","        return res\n","    except Exception as e:\n","        if _is_tz_misuse_error(e):\n","            _repair_timezone_on_error(func_or_coro)\n","            res2 = func_or_coro(*args, **kwargs)\n","            if asyncio.iscoroutine(res2) or isinstance(res2, Awaitable):\n","                return await res2\n","            return res2\n","        raise\n","\n","def tz_guard_instalado() -> bool:\n","    return bool(getattr(dt.timezone, \"_tz_guard_installed\", False))\n","\n","# ============================= HELPERS MULTIZONA (CA, NY, CO, MX, EU, UTC) =============================\n","# Orden exigido SIEMPRE: Canadá → Nueva York → Colombia → México → Europa → UTC\n","def _tz_from_env(env_var: str, default_name: str):\n","    env_val = os.getenv(env_var, default_name)\n","    if ZoneInfo is not None:\n","        try:\n","            return ZoneInfo(env_val)\n","        except Exception:\n","            pass\n","    if pytz is not None:\n","        try:\n","            return pytz.timezone(env_val)  # type: ignore\n","        except Exception:\n","            pass\n","    # Fallback fijo simple (sin DST) para mantener ejecución\n","    class _FixedTZ(dt.tzinfo):\n","        def __init__(self, name: str, offset_hours: int):\n","            self._name = name\n","            self._offset = timedelta(hours=offset_hours)\n","        def utcoffset(self, _d): return self._offset\n","        def tzname(self, _d): return self._name\n","        def dst(self, _d): return timedelta(0)\n","\n","    fixed_offsets = {\n","        \"America/Vancouver\": -7, \"America/Toronto\": -4, \"America/New_York\": -4,\n","        \"America/Bogota\": -5, \"America/Mexico_City\": -6,\n","        \"Europe/Madrid\": +2, \"Europe/London\": +1\n","    }\n","    return _FixedTZ(default_name, fixed_offsets.get(default_name, 0))\n","\n","# ENV configurables (con defaults)\n","CA_TZ = _tz_from_env(\"CANADA_TZ\", \"America/Vancouver\")\n","NY_TZ = _tz_from_env(\"NY_TZ\",     \"America/New_York\")\n","CO_TZ = _tz_from_env(\"CO_TZ\",     \"America/Bogota\")\n","MX_TZ = _tz_from_env(\"MX_TZ\",     \"America/Mexico_City\")\n","EU_TZ = _tz_from_env(\"EU_TZ\",     \"Europe/Madrid\")\n","\n","def ca_now_iso() -> str: return datetime.now(CA_TZ).replace(microsecond=0).isoformat()\n","def ny_now_iso() -> str: return datetime.now(NY_TZ).replace(microsecond=0).isoformat()\n","def co_now_iso() -> str: return datetime.now(CO_TZ).replace(microsecond=0).isoformat()\n","def mx_now_iso() -> str: return datetime.now(MX_TZ).replace(microsecond=0).isoformat()\n","def eu_now_iso() -> str: return datetime.now(EU_TZ).replace(microsecond=0).isoformat()\n","def _now_str_ny(fmt: str = \"%Y-%m-%d %H:%M:%S %Z\") -> str:\n","    try:\n","        return datetime.now(NY_TZ).strftime(fmt)\n","    except Exception:\n","        return utc_now().strftime(\"%Y-%m-%d %H:%M:%S UTC\")\n","\n","def time_banner(prefix: str = \"\") -> str:\n","    \"\"\"\n","    Banner horario sincronizado para logs.\n","    Orden fijo: CA → NY → CO → MX → EU → UTC\n","    \"\"\"\n","    p = (prefix + \" \" if prefix else \"\")\n","    return (f\"{p}[CA {ca_now_iso()}] [NY {ny_now_iso()}] [CO {co_now_iso()}] \"\n","            f\"[MX {mx_now_iso()}] [EU {eu_now_iso()}] [UTC {utc_now_iso()}]\")\n","\n","\n","# ========================== LOGGING UTC AWARE (ruta válida + sin utcnow) ==========================\n","def _utc_now_iso() -> str:\n","    \"\"\"Timestamp ISO-8601 en UTC, sin microsegundos.\"\"\"\n","    return utc_now_iso()\n","\n","def escribir_log(mensaje: str, ruta: Optional[str] = None) -> None:\n","    \"\"\"\n","    Escribe línea de log con timestamp UTC aware en una ruta definida/validada.\n","    - Expande ~ y variables de entorno\n","    - Cuelga rutas relativas de RUN_ROOT para mantener todo ordenado\n","    - Evita por completo datetime.utcnow() (deprecated)\n","    \"\"\"\n","    try:\n","        file_path = _resolve_file_path(ruta)  # None -> default eventos.log\n","        with open(file_path, \"a\", encoding=\"utf-8\") as f:\n","            f.write(f\"[{_utc_now_iso()}] {mensaje}\\n\")\n","    except Exception as e:\n","        # Fallback de emergencia en el directorio actual (no rompe el sistema)\n","        try:\n","            with open(\"./eventos.log\", \"a\", encoding=\"utf-8\") as f:\n","                f.write(f\"[{_utc_now_iso()}] {mensaje}  (fallback: {e})\\n\")\n","        except Exception:\n","            pass\n","\n","# ============================== SELF-TEST (opcional) ==============================\n","if __name__ == \"__main__\" and os.getenv(\"TZFIX_SELFTEST\", \"0\") == \"1\":\n","    print(\"Guard TZ instalado:\", tz_guard_instalado())\n","    print(\"RUN_ROOT:\", RUN_ROOT)\n","    print(time_banner(\"HORAS\"))\n","    escribir_log(\"Prueba de logging UTC aware\")                         # default\n","    escribir_log(\"Prueba ruta relativa\", ruta=\"logs/custom.log\")        # relativo cuelga de RUN_ROOT\n","    escribir_log(\"Prueba ruta absoluta\", ruta=\"/tmp/ttdvi156/test.log\") # absoluto\n","    print(\"OK: logging escrito.\")\n","# ================================================================================================\n","\n","\n","# ========================= Clase principal =========================\n","class InterpretadorInteligenteCuantico:\n","    \"\"\"\n","    Interpreta el contexto general del mercado usando tus dos predictores\n","    (alcista/bajista) y, opcionalmente, señales auxiliares del API.\n","    \"\"\"\n","    def __init__(self, predictor_alcista: Any, predictor_bajista: Any, api: Optional[Any] = None):\n","        self.pa = predictor_alcista\n","        self.pb = predictor_bajista\n","        self.api = api\n","        self.last_summary: Optional[dict] = None\n","\n","    async def _safe_current_price(self) -> Optional[float]:\n","        try:\n","            if self.api is None:\n","                return None\n","            if hasattr(self.api, \"get_price\") and callable(getattr(self.api, \"get_price\")):\n","                px = await _maybe_await(self.api.get_price)\n","                return float(px) if px is not None else None\n","            if hasattr(self.api, \"ticker\") and callable(getattr(self.api, \"ticker\")):\n","                tk = await _maybe_await(self.api.ticker)\n","                if isinstance(tk, dict):\n","                    for key in (\"price\", \"last\", \"c\", \"close\"):\n","                        v = tk.get(key)\n","                        if v is None:\n","                            continue\n","                        try:\n","                            return float(v if not isinstance(v, (list, tuple)) else v[0])\n","                        except Exception:\n","                            pass\n","        except Exception:\n","            pass\n","        return None\n","\n","    async def _call_predictor(self, obj: Any, method: str, *args):\n","        \"\"\"\n","        Llama un método del predictor con auto-reparación si aparece el error\n","        'timezone() argument 1 must be datetime.timedelta, not str'.\n","        \"\"\"\n","        fn = getattr(obj, method, None)\n","        if not callable(fn):\n","            return None\n","        try:\n","            return await _maybe_await(fn, *args)\n","        except TypeError as e:\n","            if \"timezone() argument 1 must be datetime.timedelta, not str\" in str(e):\n","                _repair_timezone_on_error(obj)\n","                return await _maybe_await(fn, *args)\n","            raise\n","        except Exception:\n","            return None\n","\n","    async def interpretar_contexto_general(self) -> dict:\n","        \"\"\"\n","        Calcula un resumen claro, con timestamps sincronizados y sin timezone(str) legacy.\n","        \"\"\"\n","        ts_ny = _now_str_ny()\n","        ts_utc = _utc_now_iso().replace(\"T\", \" \")\n","\n","        price_now = await self._safe_current_price()\n","\n","        try:\n","            base_px = price_now if (price_now is not None and price_now > 0) else (\n","                self.pa.history[-1] if getattr(self.pa, \"history\", []) else None\n","            )\n","        except Exception:\n","            base_px = None\n","\n","        pred_a = pred_b = 0.0\n","        futuro_a = futuro_b = None\n","        if base_px is not None:\n","            try:\n","                val = await self._call_predictor(self.pa, \"predecir_ajustada\", base_px)\n","                pred_a = float(val) if val is not None else 0.0\n","            except Exception:\n","                pred_a = 0.0\n","            try:\n","                val = await self._call_predictor(self.pb, \"predecir_ajustada\", base_px)\n","                pred_b = float(val) if val is not None else 0.0\n","            except Exception:\n","                pred_b = 0.0\n","            try:\n","                val = await self._call_predictor(self.pa, \"predecir_precio_futuro\")\n","                futuro_a = float(val) if val is not None else None\n","            except Exception:\n","                futuro_a = None\n","            try:\n","                val = await self._call_predictor(self.pb, \"predecir_precio_futuro\")\n","                futuro_b = float(val) if val is not None else None\n","            except Exception:\n","                futuro_b = None\n","\n","        a_abs = abs(pred_a)\n","        b_abs = abs(pred_b)\n","\n","        if a_abs < 1e-9 and b_abs < 1e-9:\n","            regime = \"LATERAL\"\n","            comentario = \"Sin señal clara; mercado lateral/indeterminado.\"\n","        elif pred_a > b_abs:\n","            regime = \"ALCISTA\"\n","            comentario = \"📈 Tendencia alcista dominante\"\n","        elif b_abs > pred_a:\n","            regime = \"BAJISTA\"\n","            comentario = \"📉 Tendencia bajista dominante\"\n","        else:\n","            regime = \"LATERAL\"\n","            comentario = \"↔️ Mercado lateral\"\n","\n","        resumen = {\n","            \"ts_ny\": ts_ny,\n","            \"ts_utc\": ts_utc,\n","            \"precio_actual\": price_now,\n","            \"pred_alcista\": pred_a,\n","            \"pred_bajista\": pred_b,\n","            \"futuro_alcista\": futuro_a,\n","            \"futuro_bajista\": futuro_b,\n","            \"regimen\": regime,\n","            \"comentario\": comentario\n","        }\n","\n","        self.last_summary = resumen\n","\n","        try:\n","            if price_now is not None:\n","                print(f\"🧭 [{ts_ny}] Ctx gral | px={price_now:.2f} | A={_pct(pred_a)} / B={_pct(pred_b)} -> {regime}\")\n","            else:\n","                print(f\"🧭 [{ts_ny}] Ctx gral | px=N/A | A={_pct(pred_a)} / B={_pct(pred_b)} -> {regime}\")\n","        except Exception:\n","            pass\n","\n","        return resumen\n","\n","# -------- Helpers usados arriba --------\n","def _pct(x: float) -> str:\n","    try:\n","        return f\"{x*100:.2f}%\"\n","    except Exception:\n","        return \"0.00%\"\n","\n","async def _maybe_await(fn: Callable, *args, **kwargs):\n","    res = fn(*args, **kwargs)\n","    if asyncio.iscoroutine(res) or isinstance(res, Awaitable):\n","        return await res\n","    return res\n","\n","# -------- Runner periódico --------\n","async def run_interpretador_periodico(interpretador: InterpretadorInteligenteCuantico, comparador_btc: Optional[Any] = None,\n","                                      cada_segundos: int = 60) -> None:\n","    periodo = int(max(5, cada_segundos))\n","    while True:\n","        try:\n","            await interpretador.interpretar_contexto_general()\n","        except Exception as e:\n","            print(f\"⚠️ Error en interpretar_contexto_general(): {e}\")\n","        await asyncio.sleep(periodo)\n","\n","# ======================= IMPORTS GLOBALES / PLACEHOLDERS SEGUROS =======================\n","import csv\n","import logging\n","\n","def _placeholder(name):\n","    def _f(*a, **k):\n","        print(f\"ℹ️ Placeholder '{name}' llamado. Define la implementación real para habilitarlo.\")\n","    return _f\n","\n","try:\n","    ensure_dirs  # type: ignore[name-defined]\n","except NameError:\n","    def ensure_dirs():\n","        os.makedirs(\"resultados\", exist_ok=True)\n","\n","try:\n","    cfg  # type: ignore[name-defined]\n","except NameError:\n","    def cfg(k, default=None):\n","        return type(default)(os.getenv(k, default)) if default is not None else os.getenv(k)\n","\n","try:\n","    maybe_exec  # type: ignore[name-defined]\n","except NameError:\n","    maybe_exec = _placeholder(\"maybe_exec\")\n","\n","try:\n","    _safe_init_btc_intelligence  # type: ignore[name-defined]\n","except NameError:\n","    async def _safe_init_btc_intelligence():\n","        return None\n","try:\n","    _unpack_intel_ctx  # type: ignore[name-defined]\n","except NameError:\n","    def _unpack_intel_ctx(ctx):\n","        return (None, None)\n","\n","try:\n","    decision_from_signal  # type: ignore[name-defined]\n","except NameError:\n","    def decision_from_signal(sig: dict, trend_state: str = None):\n","        return \"ESPERAR\", {\"accion\":\"HOLD\",\"tendencia\":\"NEUTRAL\",\"size\":None,\"sl\":None}\n","\n","# ===================== PARCHE PERMANENTE: MODO EN EnvironmentManager =====================\n","logger = logging.getLogger(\"envmode\")\n","if not logger.handlers:\n","    logger.addHandler(logging.StreamHandler())\n","logger.setLevel(logging.INFO)\n","\n","try:\n","    EnvironmentManager  # type: ignore[name-defined]\n","except NameError:\n","    class EnvironmentManager:  # type: ignore[no-redef]\n","        def __init__(self):\n","            self._mode = os.getenv(\"TRADING_MODE\", \"test\").lower()\n","\n","def _install_mode_api_on_envmanager():\n","    if not hasattr(EnvironmentManager, \"set_mode\"):\n","        def set_mode(self, mode: str):\n","            mode = (mode or \"\").strip().lower()\n","            if mode not in (\"test\", \"real\"):\n","                return False, f\"modo inválido '{mode}'\"\n","            if mode == \"real\":\n","                missing = []\n","                if not os.getenv(\"KRAKEN_API_KEY\"):    missing.append(\"KRAKEN_API_KEY\")\n","                if not os.getenv(\"KRAKEN_API_SECRET\"): missing.append(\"KRAKEN_API_SECRET\")\n","                if missing:\n","                    return False, \"Faltan variables: \" + \", \".join(missing)\n","            self._mode = mode\n","            os.environ[\"TRADING_MODE\"] = mode\n","            os.environ[\"KRAKEN_LIVE\"]  = \"1\" if mode == \"real\" else \"0\"\n","            logger.info(f\"EnvironmentManager: modo establecido a '{mode}'\")\n","            cb = getattr(self, \"on_mode_change\", None)\n","            if callable(cb):\n","                try: cb(mode)\n","                except Exception as e: logger.warning(f\"on_mode_change falló: {e}\")\n","            return True, \"ok\"\n","        setattr(EnvironmentManager, \"set_mode\", set_mode)\n","\n","    if not hasattr(EnvironmentManager, \"get_mode\"):\n","        setattr(EnvironmentManager, \"get_mode\",\n","                lambda self: getattr(self, \"_mode\", os.getenv(\"TRADING_MODE\", \"test\")).lower())\n","\n","    if not hasattr(EnvironmentManager, \"is_real_mode\"):\n","        setattr(EnvironmentManager, \"is_real_mode\",\n","                lambda self: getattr(self, \"_mode\", os.getenv(\"TRADING_MODE\", \"test\")).lower() == \"real\")\n","\n","    if not hasattr(EnvironmentManager, \"is_production_mode\"):\n","        setattr(EnvironmentManager, \"is_production_mode\",\n","                lambda self: getattr(self, \"_mode\", os.getenv(\"TRADING_MODE\", \"test\")).lower() == \"real\")\n","\n","_install_mode_api_on_envmanager()\n","\n","# ================== Bootstrap FIX TZ + Integración con APIManager ==================\n","# Si tienes el módulo con APIManager en el mismo proceso, este main opcional demostrará:\n","#  - Banner multizona\n","#  - Llamadas modernas y legacy de OHLC\n","#  - Ticker sincronizado\n","USO_DOC = \"\"\"\n","Cómo usar (OHLC Kraken):\n","  Moderna (recomendada):\n","    ohlc = await api.obtener_ohlc(pair=\"XBT/USD\", interval=\"1m\")  # o interval=1\n","\n","  Legacy (compat, corrige 'unexpected keyword interval'):\n","    ohlc = await api._api_get_ohlc(pair=\"XBT/USD\", interval=1)\n","    # o\n","    ohlc = await api._api_get_ohlc(pair=\"XBT/USD\", timeframe=\"1m\")\n","\n","Zonas por entorno (opcional):\n","  export CANADA_TZ=America/Toronto\n","  export NY_TZ=America/New_York\n","  export CO_TZ=America/Bogota\n","  export MX_TZ=America/Mexico_City\n","  export EU_TZ=Europe/Madrid\n","\"\"\".strip()\n","\n","async def _demo_integracion_con_api():\n","    api_cls = globals().get(\"APIManager\", None)\n","    if api_cls is None:\n","        print(\"ℹ️ APIManager no está cargado en este runtime. Solo mostrando horarios:\")\n","        print(time_banner(\"HORAS\"))\n","        print(USO_DOC)\n","        return\n","\n","    print(time_banner(\"INICIO\"))\n","    api = api_cls(require_keys=False, allow_public_mode=True)\n","    try:\n","        await api.initialize()\n","\n","        print(time_banner(\"OHLC moderna\"))\n","        ohlc = await api.obtener_ohlc(pair=\"XBT/USD\", interval=\"1m\")\n","        print(\"✅ OHLC moderna OK — keys:\", list((ohlc or {}).keys())[:3])\n","\n","        print(time_banner(\"OHLC legacy\"))\n","        ohlc_legacy = await api._api_get_ohlc(pair=\"XBT/USD\", timeframe=\"1m\")\n","        print(\"✅ OHLC legacy OK — keys:\", list((ohlc_legacy or {}).keys())[:3])\n","\n","        print(time_banner(\"Ticker\"))\n","        precio = await api.obtener_precio_real_actual()\n","        par = getattr(globals().get('Config', object), 'PAR_TRADING', 'XBT/USD')\n","        print(f\"📈 Precio {par}: {precio}\")\n","    finally:\n","        try:\n","            await api.shutdown()\n","        except Exception:\n","            pass\n","        print(time_banner(\"FIN\"))\n","\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# FIX PERMANENTE: '_OpNamespace' object is not callable (choque IPython)\n","# - Siempre resuelve una clase válida para APIManager\n","# - Evita instanciar objetos que no son clase (módulos, _OpNamespace, etc.)\n","# - Si no se encuentra, usa DummyAPI con métodos async compatibles\n","# ─────────────────────────────────────────────────────────────────────────────\n","import sys, inspect, types, time as _time\n","\n","# Stubs suaves si faltan\n","if \"time_banner\" not in globals():\n","    from datetime import datetime as _dt\n","    def time_banner(tag: str = \"INFO\") -> str:\n","        return f\"[{tag}] {_dt.utcnow().strftime('%Y-%m-%d %H:%M:%S')}Z\"\n","\n","if \"escribir_log\" not in globals():\n","    def escribir_log(msg: str) -> None:\n","        try:\n","            print(f\"{time_banner('LOG')} {msg}\")\n","        except Exception:\n","            print(f\"[LOG] {msg}\")\n","\n","def _is_opnamespace(obj) -> bool:\n","    try:\n","        # Evita depender de import IPython; chequeo por nombre / repr\n","        return obj.__class__.__name__ == \"_OpNamespace\" or \"inputtransformer2\" in repr(obj)\n","    except Exception:\n","        return False\n","\n","def _extract_class_from_obj(obj):\n","    \"\"\"\n","    Si obj es un módulo/namespace con atributo APIManager (o similares),\n","    devuelve la clase; si no, None.\n","    \"\"\"\n","    try_attrs = (\"APIManager\", \"ApiManager\", \"API\", \"Client\", \"PublicAPI\", \"PrivateAPI\")\n","    for a in try_attrs:\n","        try:\n","            val = getattr(obj, a, None)\n","            if isinstance(val, type):\n","                return val\n","        except Exception:\n","            pass\n","    return None\n","\n","def _resolve_APIManager_class():\n","    \"\"\"\n","    Intenta obtener una clase instanciable para APIManager.\n","    - Prioriza APIManager en globals() si es realmente una clase\n","    - Si es un módulo/_OpNamespace, intenta extraer la clase interna\n","    - Busca en sys.modules\n","    - Fallback: DummyAPI con initialize/close/get_ticker\n","    \"\"\"\n","    # 1) Revisa globals()\n","    g = globals().get(\"APIManager\", None)\n","    if isinstance(g, type):\n","        return g\n","    if g is not None:\n","        if _is_opnamespace(g) or isinstance(g, types.ModuleType):\n","            cls = _extract_class_from_obj(g)\n","            if isinstance(cls, type):\n","                return cls\n","\n","    # 2) Busca por alias comunes en globals()\n","    for alias in (\"ApiManager\", \"API\", \"Client\", \"PublicAPI\", \"PrivateAPI\"):\n","        g2 = globals().get(alias, None)\n","        if isinstance(g2, type):\n","            return g2\n","        if g2 is not None and (isinstance(g2, types.ModuleType) or _is_opnamespace(g2)):\n","            cls = _extract_class_from_obj(g2)\n","            if isinstance(cls, type):\n","                return cls\n","\n","    # 3) Escanea módulos cargados\n","    for mod in list(sys.modules.values()):\n","        try:\n","            if not mod or not hasattr(mod, \"__dict__\"):\n","                continue\n","            for name in (\"APIManager\", \"ApiManager\"):\n","                cand = getattr(mod, name, None)\n","                if isinstance(cand, type):\n","                    return cand\n","        except Exception:\n","            pass\n","\n","    # 4) Fallback: DummyAPI seguro\n","    class DummyAPI:\n","        def __init__(self, require_keys: bool = False, allow_public_mode: bool = True, *a, **k):\n","            self.require_keys = require_keys\n","            self.allow_public_mode = allow_public_mode\n","\n","        async def initialize(self):\n","            # simulación breve de init\n","            await _maybe_sleep_async(0.01)\n","            return True\n","\n","        async def close(self):\n","            await _maybe_sleep_async(0.001)\n","            return True\n","\n","        async def get_ticker(self, pair: str = \"XXBTZUSD\"):\n","            # Devuelve estructura tipo ticker; integra bien con tu demo\n","            return {\"pair\": pair, \"price\": 0.0, \"ts\": _time.time(), \"source\": \"DummyAPI\"}\n","\n","    return DummyAPI\n","\n","async def _maybe_sleep_async(seconds: float):\n","    try:\n","        import asyncio as _asyncio\n","        await _asyncio.sleep(seconds)\n","    except Exception:\n","        pass\n","\n","# ── REEMPLAZO COMPATIBLE de _demo_integracion_con_api (forzado, para curar el bug) ──\n","async def _demo_integracion_con_api():\n","    \"\"\"\n","    Demo robusta que NUNCA intenta llamar un _OpNamespace o módulo.\n","    Resuelve una clase instanciable sí o sí, e invoca initialize/close si existen.\n","    \"\"\"\n","    escribir_log(\"Resolviendo APIManager de forma segura…\")\n","    APICls = _resolve_APIManager_class()\n","\n","    # Instanciación tolerante a firmas distintas\n","    try:\n","        api = APICls(require_keys=False, allow_public_mode=True)\n","    except TypeError:\n","        try:\n","            api = APICls()\n","        except Exception as e:\n","            escribir_log(f\"Fallo instanciando APICls: {e!r}. Usando DummyAPI.\")\n","            APICls = _resolve_APIManager_class()  # volvería a DummyAPI\n","            api = APICls()\n","\n","    # Inicializa si está disponible\n","    if hasattr(api, \"initialize\") and callable(getattr(api, \"initialize\")):\n","        try:\n","            await api.initialize()\n","            escribir_log(\"API inicializada correctamente.\")\n","        except Exception as e:\n","            escribir_log(f\"initialize() falló: {e!r}\")\n","\n","    # Operación de prueba (no invasiva)\n","    pair = globals().get(\"PAR_TRADING\", \"XXBTZUSD\")\n","    if hasattr(api, \"get_ticker\") and callable(getattr(api, \"get_ticker\")):\n","        try:\n","            ticker = await api.get_ticker(pair)\n","            print(time_banner(\"TICKER\"), f\"{pair}: {ticker}\")\n","        except Exception as e:\n","            escribir_log(f\"get_ticker() falló: {e!r}\")\n","    else:\n","        escribir_log(\"API sin get_ticker(); demo mínima completada.\")\n","\n","    # Cierre limpio si existe\n","    if hasattr(api, \"close\") and callable(getattr(api, \"close\")):\n","        try:\n","            await api.close()\n","        except Exception as e:\n","            escribir_log(f\"close() falló: {e!r}\")\n","\n","\n","# ========================== TRADE LOGGING MULTIZONA (plug-and-play) ==========================\n","import json\n","from functools import wraps\n","\n","# Config por ENV\n","TRADE_LOG_FILE  = os.getenv(\"TRADE_LOG_FILE\",  \"logs/trades.log\")\n","TRADE_LOG_JSONL = os.getenv(\"TRADE_LOG_JSONL\", \"logs/trades.jsonl\")\n","TRADE_LOG_PRINT = (os.getenv(\"TRADE_LOG_PRINT\", \"1\") in (\"1\",\"true\",\"TRUE\",\"yes\",\"y\"))\n","\n","def _ensure_log_dirs():\n","    os.makedirs(os.path.dirname(TRADE_LOG_FILE) or \".\", exist_ok=True)\n","    os.makedirs(os.path.dirname(TRADE_LOG_JSONL) or \".\", exist_ok=True)\n","\n","def _safe_float(x):\n","    try:\n","        return float(x)\n","    except Exception:\n","        return None\n","\n","def _compact(obj):\n","    \"\"\"Convierte objetos no serializables a representaciones seguras.\"\"\"\n","    try:\n","        json.dumps(obj)\n","        return obj\n","    except Exception:\n","        try:\n","            return dict(obj)\n","        except Exception:\n","            try:\n","                return vars(obj)\n","            except Exception:\n","                return str(obj)\n","\n","def _normalize_order_payload(event: str, payload: dict | None) -> dict:\n","    p = payload or {}\n","    # Campos comunes (best effort)\n","    side   = p.get(\"side\") or p.get(\"direction\") or p.get(\"orderSide\")\n","    typ    = p.get(\"type\") or p.get(\"orderType\")\n","    qty    = p.get(\"qty\") or p.get(\"quantity\") or p.get(\"size\") or p.get(\"amount\")\n","    price  = p.get(\"price\") or p.get(\"limit_price\") or p.get(\"avg_price\") or p.get(\"fill_price\")\n","    symbol = p.get(\"symbol\") or p.get(\"pair\") or p.get(\"market\") or p.get(\"instrument\")\n","    orderId= p.get(\"order_id\") or p.get(\"id\") or p.get(\"orderId\")\n","    # Limpieza\n","    return {\n","        \"event\": event,\n","        \"symbol\": symbol,\n","        \"side\": side,\n","        \"type\": typ,\n","        \"qty\": _safe_float(qty),\n","        \"price\": _safe_float(price),\n","        \"order_id\": orderId,\n","        \"raw\": _compact(p)\n","    }\n","\n","def log_trade_event(event: str, payload: dict | None = None, extra: dict | None = None):\n","    \"\"\"\n","    Log de evento de trading con banner multizona + JSONL.\n","    - event: \"order_submitted\", \"order_filled\", \"order_canceled\", \"order_error\", etc.\n","    - payload: dict con info de orden (side, qty, price, symbol, order_id, ...)\n","    - extra:    dict adicional (latencia, estrategia, tags, ...)\n","    \"\"\"\n","    _ensure_log_dirs()\n","    meta = _normalize_order_payload(event, payload)\n","    meta[\"ts_banner\"] = time_banner(\"TRADE\")\n","    meta[\"ts_utc\"]    = _utc_now_iso()\n","    if extra:\n","        try:\n","            meta[\"extra\"] = _compact(extra)\n","        except Exception:\n","            pass\n","\n","    # Log humano\n","    human_line = (f\"{meta['ts_banner']} \"\n","                  f\"{event.upper()} | {meta.get('symbol') or '-'} \"\n","                  f\"{(meta.get('side') or '').upper()} \"\n","                  f\"qty={meta.get('qty')} price={meta.get('price')} id={meta.get('order_id')}\")\n","    try:\n","        with open(TRADE_LOG_FILE, \"a\", encoding=\"utf-8\") as f:\n","            f.write(human_line + \"\\n\")\n","    except Exception:\n","        pass\n","    if TRADE_LOG_PRINT:\n","        print(human_line)\n","\n","    # JSONL para análisis\n","    try:\n","        with open(TRADE_LOG_JSONL, \"a\", encoding=\"utf-8\") as jf:\n","            jf.write(json.dumps(meta, ensure_ascii=False) + \"\\n\")\n","    except Exception:\n","        pass\n","\n","# ------------------------ Decoradores para envolver funciones ------------------------\n","def with_trade_logging(label: str):\n","    \"\"\"\n","    Envuelve una función sync/async de tu sistema para loguear antes/después con banner y JSONL.\n","    Uso:\n","        @with_trade_logging(\"signal_eval\")\n","        async def evaluar_senal(...): ...\n","    \"\"\"\n","    def _decor(fn):\n","        if asyncio.iscoroutinefunction(fn):\n","            @wraps(fn)\n","            async def _aw(*a, **k):\n","                log_trade_event(f\"{label}_start\", {\"args\": str(a), \"kwargs\": k})\n","                try:\n","                    res = await fn(*a, **k)\n","                    log_trade_event(f\"{label}_end\", {\"result\": _compact(res)})\n","                    return res\n","                except Exception as e:\n","                    log_trade_event(f\"{label}_error\", {\"error\": repr(e)})\n","                    raise\n","            return _aw\n","        else:\n","            @wraps(fn)\n","            def _sw(*a, **k):\n","                log_trade_event(f\"{label}_start\", {\"args\": str(a), \"kwargs\": k})\n","                try:\n","                    res = fn(*a, **k)\n","                    log_trade_event(f\"{label}_end\", {\"result\": _compact(res)})\n","                    return res\n","                except Exception as e:\n","                    log_trade_event(f\"{label}_error\", {\"error\": repr(e)})\n","                    raise\n","            return _sw\n","    return _decor\n","\n","# ------------------------ Auto-inyección en Executors comunes ------------------------\n","# Métodos típicos que deseamos interceptar.\n","_EXEC_METHODS = [\n","    # Colocación/creación\n","    \"place_order\", \"submit_order\", \"create_order\",\n","    \"market_buy\", \"market_sell\", \"limit_buy\", \"limit_sell\",\n","    # Callbacks lifecycle\n","    \"on_order_submitted\", \"on_order_filled\", \"on_order_partially_filled\",\n","    \"on_order_canceled\", \"on_order_rejected\", \"on_order_error\"\n","]\n","\n","def _wrap_method(obj, name: str):\n","    \"\"\"Envuélvelo si existe; soporta sync/async; no duplica si ya está envuelto.\"\"\"\n","    if not hasattr(obj, name):\n","        return False\n","    orig = getattr(obj, name)\n","    # Evitar doble wrap\n","    if getattr(orig, \"_trade_logging_wrapped\", False):\n","        return False\n","\n","    if asyncio.iscoroutinefunction(orig):\n","        @wraps(orig)\n","        async def _wrapped(*a, **k):\n","            try:\n","                # Armar payload base (mejor esfuerzo)\n","                payload = {}\n","                # Si el primer arg es un dict u objeto de orden, capturarlo\n","                if len(a) > 0 and isinstance(a[0], (dict,)):\n","                    payload = a[0]\n","                elif \"order\" in k:\n","                    payload = k.get(\"order\") or {}\n","                log_trade_event(f\"{name}_start\", payload)\n","                res = await orig(*a, **k)\n","                # Post\n","                post = {}\n","                if isinstance(res, dict):\n","                    post = res\n","                log_trade_event(f\"{name}_end\", post)\n","                return res\n","            except Exception as e:\n","                log_trade_event(f\"{name}_error\", {\"error\": repr(e)})\n","                raise\n","    else:\n","        @wraps(orig)\n","        def _wrapped(*a, **k):\n","            try:\n","                payload = {}\n","                if len(a) > 0 and isinstance(a[0], (dict,)):\n","                    payload = a[0]\n","                elif \"order\" in k:\n","                    payload = k.get(\"order\") or {}\n","                log_trade_event(f\"{name}_start\", payload)\n","                res = orig(*a, **k)\n","                post = {}\n","                if isinstance(res, dict):\n","                    post = res\n","                log_trade_event(f\"{name}_end\", post)\n","                return res\n","            except Exception as e:\n","                log_trade_event(f\"{name}_error\", {\"error\": repr(e)})\n","                raise\n","\n","    setattr(_wrapped, \"_trade_logging_wrapped\", True)\n","    setattr(obj, name, _wrapped)\n","    return True\n","\n","def attach_trade_logging(executor) -> dict:\n","    \"\"\"\n","    Conecta el banner/JSONL a los métodos del executor pasado.\n","    Devuelve un dict con {metodo: True/False} indicando cuáles fueron envueltos.\n","    \"\"\"\n","    results = {}\n","    for m in _EXEC_METHODS:\n","        results[m] = _wrap_method(executor, m)\n","    # Si el executor define 'api' (por ejemplo para OHLC / Ticker), lo aprovechamos para un ping inicial\n","    try:\n","        if hasattr(executor, \"api\") and executor.api:\n","            log_trade_event(\"executor_attached\", {\"class\": executor.__class__.__name__})\n","    except Exception:\n","        pass\n","    return results\n","\n","# ------------------------ Auto-attach si detectamos executors globales ------------------------\n","def _auto_attach_if_present():\n","    candidates = []\n","    for name, obj in list(globals().items()):\n","        try:\n","            # heurística: clases comunes\n","            if name in (\"EnhancedOrderExecutor\", \"OrderExecutor\", \"Executor\", \"Trader\", \"TradeEngine\"):\n","                candidates.append(obj)\n","        except Exception:\n","            pass\n","\n","    attached = 0\n","    for cls in candidates:\n","        try:\n","            # Si hay una instancia viva común\n","            for inst_name, inst in list(globals().items()):\n","                if isinstance(inst, cls):\n","                    attach_trade_logging(inst)\n","                    attached += 1\n","        except Exception:\n","            pass\n","    if attached > 0 and TRADE_LOG_PRINT:\n","        print(time_banner(f\"AUTO-ATTACH executors={attached}\"))\n","\n","# Intentar auto-attach al importar este módulo (no rompe si no hay executors)\n","try:\n","    _auto_attach_if_present()\n","except Exception:\n","    pass\n","\n","# ============================== MINI DEMO (opcional) ==============================\n","if __name__ == \"__main__\" and os.getenv(\"TRADE_LOG_DEMO\", \"0\") == \"1\":\n","    class _FakeExec:\n","        def submit_order(self, order):\n","            # Simular retorno de broker\n","            return {\"order_id\": \"demo-1\", \"status\": \"submitted\", \"price\": order.get(\"price\")}\n","        async def on_order_filled(self, order):\n","            await asyncio.sleep(0.05)\n","            return {\"order_id\": order.get(\"order_id\",\"demo-1\"), \"status\": \"filled\", \"fill_price\": order.get(\"price\")}\n","\n","    ex = _FakeExec()\n","    attach_trade_logging(ex)\n","    print(time_banner(\"DEMO\"))\n","    # Sync\n","    r = ex.submit_order({\"symbol\":\"XBT/USD\",\"side\":\"buy\",\"qty\":0.01,\"price\":65000})\n","    # Async\n","    asyncio.run(ex.on_order_filled({\"order_id\": r[\"order_id\"], \"price\": r.get(\"price\")}))\n","    print(time_banner(\"FIN\"))\n","\n","\n","\n","# ============== Fallbacks suaves para helpers si faltan en tu entorno ==============\n","# ensure_dirs\n","try:\n","    ensure_dirs  # type: ignore[name-defined]\n","except NameError:\n","    def ensure_dirs():\n","        os.makedirs(\"resultados\", exist_ok=True)\n","\n","# cfg (lee Config si existe, si no ENV, si no default)\n","try:\n","    Config  # type: ignore[name-defined]\n","except NameError:\n","    class Config:  # mínimo, no interfiere si ya tienes uno real en otro módulo\n","        pass\n","\n","def cfg(name: str, default: Any = None):\n","    val = getattr(Config, name, None)\n","    if val is not None:\n","        return val\n","    return os.getenv(name, default)\n","\n","# decision_from_signal (forma básica si no existe)\n","try:\n","    decision_from_signal  # type: ignore[name-defined]\n","except NameError:\n","    def decision_from_signal(sig: dict, trend_state: str) -> Tuple[str, dict]:\n","        extras = {\n","            \"accion\": sig.get(\"accion\", \"HOLD\"),\n","            \"tendencia\": trend_state,\n","            \"size\": sig.get(\"size\", 0),\n","            \"sl\": sig.get(\"sl\"),\n","        }\n","        return (\"ESPERAR\", extras)\n","\n","# maybe_exec (puentea a tu ejecutor si expone ejecutar_decision/execute_order)\n","try:\n","    maybe_exec  # type: ignore[name-defined]\n","except NameError:\n","    async def maybe_exec(executor: Any, decision: str, price: float, extras: Optional[dict] = None):\n","        if executor is None:\n","            return\n","        try:\n","            if hasattr(executor, \"ejecutar_decision\"):\n","                return await executor.ejecutar_decision(decision, price, extras or {})\n","            if hasattr(executor, \"execute_order\"):\n","                return await executor.execute_order(decision, price, extras or {})\n","        except Exception as e:\n","            print(f\"⚠️ maybe_exec fallback: {e}\")\n","\n","# Inteligencia BTC (desempaquetado seguro si no lo tienes aún)\n","try:\n","    _safe_init_btc_intelligence  # type: ignore[name-defined]\n","except NameError:\n","    async def _safe_init_btc_intelligence():\n","        return (None, None)\n","\n","try:\n","    _unpack_intel_ctx  # type: ignore[name-defined]\n","except NameError:\n","    def _unpack_intel_ctx(ctx: Any):\n","        if isinstance(ctx, tuple) and len(ctx) == 2:\n","            return ctx\n","        return (None, None)\n","\n","\n","# ===================== WIRING + HELPERS (no invasivos) =====================\n","import os, sys, asyncio, logging, pathlib\n","\n","# ---- cfg fallback solo si no existe ----\n","if \"cfg\" not in globals():\n","    def cfg(nombre: str, por_defecto=None):\n","        # Prioridad: Config.attr > ENV > por_defecto\n","        try:\n","            if \"Config\" in globals() and hasattr(Config, nombre):\n","                return getattr(Config, nombre)\n","        except Exception:\n","            pass\n","        return type(por_defecto)(os.getenv(nombre, por_defecto)) if por_defecto is not None else os.getenv(nombre)\n","\n","# ---- ensure_dirs fallback solo si no existe ----\n","if \"ensure_dirs\" not in globals():\n","    def ensure_dirs():\n","        try:\n","            for d in (\"resultados\", \"logs\", \"artefactos\"):\n","                pathlib.Path(d).mkdir(parents=True, exist_ok=True)\n","        except Exception:\n","            pass\n","\n","# ---- Wire del rate limiter público (no-op seguro si ya está activo) ----\n","def wire_kraken_public_rate_limiter(api) -> None:\n","    \"\"\"\n","    Garantiza que el objeto API tenga:\n","      - _public_lock (asyncio.Lock)\n","      - _min_public_interval (según KRAKEN_PUBLIC_RPS)\n","      - últimas marcas de tiempo para rate-limit\n","    Si ya existen (como en tu APIManager), no toca nada.\n","    \"\"\"\n","    try:\n","        if not hasattr(api, \"_public_lock\") or api._public_lock is None:\n","            api._public_lock = asyncio.Lock()\n","        # Resuelve el intervalo mínimo desde ENV o atributo existente\n","        if not hasattr(api, \"_min_public_interval\") or api._min_public_interval is None:\n","            rps = float(os.getenv(\"KRAKEN_PUBLIC_RPS\", \"0.8\"))\n","            api._min_public_interval = max(1.0 / rps, 0.5)\n","        # Timestamps\n","        if not hasattr(api, \"_last_public_call\"):\n","            api._last_public_call = 0.0\n","        if not hasattr(api, \"_last_public_call_sync\"):\n","            api._last_public_call_sync = 0.0\n","        # Señal de que ya está cableado\n","        setattr(api, \"_kraken_rate_wired\", True)\n","        logging.getLogger(\"kraken_api\").info(\"✔️ Rate-limiter público verificado/activado.\")\n","    except Exception as e:\n","        logging.getLogger(\"kraken_api\").warning(f\"wire_kraken_public_rate_limiter: {e}\")\n","\n","# ---- Helpers modo REAL (solo si no existen) ----\n","if \"modo_real_activo\" not in globals():\n","    def modo_real_activo(api) -> bool:\n","        try:\n","            flag = bool(getattr(api, \"_private_enabled\", False))\n","            k = (getattr(getattr(api, \"api\", None), \"key\", \"\") or \"\")\n","            s = (getattr(getattr(api, \"api\", None), \"secret\", \"\") or \"\")\n","            return flag and len(k) >= 20 and len(s) >= 20\n","        except Exception:\n","            return False\n","\n","if \"desactivar_modo_real\" not in globals():\n","    def desactivar_modo_real(api, motivo: str | None = None) -> None:\n","        try:\n","            if motivo:\n","                print(f\"ℹ️  Desactivando MODO REAL: {motivo}. Pasando a PÚBLICO.\")\n","            if hasattr(api, \"_private_enabled\"):\n","                setattr(api, \"_private_enabled\", False)\n","        except Exception:\n","            pass\n","\n","if \"activar_modo_real_si_listo\" not in globals():\n","    async def activar_modo_real_si_listo(\n","        api,\n","        key: str | None = None,\n","        secret: str | None = None,\n","        intentar_env: bool = True,\n","        solicitar_en_tty: bool = False,\n","        validar: bool = True,\n","        silencioso: bool = True,\n","    ) -> bool:\n","        # Objeto válido\n","        if api is None or not hasattr(api, \"api\"):\n","            if not silencioso:\n","                print(\"⚠️  API inválida; no se puede activar MODO REAL.\")\n","            return False\n","\n","        # Resolver claves\n","        k = (key or \"\").strip()\n","        s = (secret or \"\").strip()\n","        if intentar_env and (not k or not s):\n","            k = (os.getenv(\"KRAKEN_API_KEY\", \"\") or \"\").strip()\n","            s = (os.getenv(\"KRAKEN_API_SECRET\", \"\") or \"\").strip()\n","        if (not k or not s) and solicitar_en_tty and sys.stdin and sys.stdin.isatty():\n","            try:\n","                from getpass import getpass\n","                if not k: k = getpass(\"Ingrese API Key: \").strip()\n","                if not s: s = getpass(\"Ingrese API Secret: \").strip()\n","            except Exception:\n","                pass\n","\n","        if not k or not s:\n","            if not silencioso:\n","                print(\"ℹ️  No hay claves Kraken. Continuando en PÚBLICO.\")\n","            desactivar_modo_real(api, \"faltan claves\")\n","            return False\n","        if len(k) < 20 or len(s) < 20:\n","            if not silencioso:\n","                print(\"⚠️  Claves con longitud insuficiente. Modo PÚBLICO.\")\n","            desactivar_modo_real(api, \"formato de claves inválido\")\n","            return False\n","\n","        # Inyectar y marcar\n","        try:\n","            api.api.key = k\n","            api.api.secret = s\n","            setattr(api, \"_private_enabled\", True)\n","        except Exception as e:\n","            if not silencioso:\n","                print(f\"⚠️  No se pudieron aplicar claves al cliente Kraken: {e}\")\n","            desactivar_modo_real(api, \"no se pudieron asignar claves\")\n","            return False\n","\n","        # Validación (Balance) usando la propia API robusta\n","        if validar:\n","            try:\n","                if not hasattr(api, \"query_private\"):\n","                    raise AttributeError(\"query_private no disponible en APIManager.\")\n","                resp = await api.query_private(\"Balance\")\n","                if not isinstance(resp, dict):\n","                    raise RuntimeError(\"Respuesta privada no es dict.\")\n","                errs = resp.get(\"error\") or []\n","                if errs:\n","                    raise PermissionError(str(errs))\n","            except Exception as e:\n","                desactivar_modo_real(api, f\"validación fallida: {e}\")\n","                if not silencioso:\n","                    print(f\"⚠️  No se pudo activar MODO REAL: {e}\")\n","                return False\n","\n","        if not silencioso:\n","            print(\"🟪 Transición → MODO REAL ACTIVADO (claves válidas).\")\n","        return True\n","\n","# ===================== HELPERS & FALLBACKS (no invasivos) =====================\n","import os, sys, asyncio, csv, time as _time\n","from datetime import datetime as dt\n","try:\n","    from zoneinfo import ZoneInfo\n","except Exception:\n","    ZoneInfo = None\n","\n","# ---- cfg fallback (usa Config > ENV > default) ----\n","if \"cfg\" not in globals():\n","    def cfg(nombre: str, por_defecto=None):\n","        try:\n","            if \"Config\" in globals() and hasattr(Config, nombre):\n","                return getattr(Config, nombre)\n","        except Exception:\n","            pass\n","        val = os.getenv(nombre)\n","        if val is None:\n","            return por_defecto\n","        # convierte por_defecto para mantener tipo si aplica\n","        if por_defecto is None:\n","            return val\n","        try:\n","            return type(por_defecto)(val)\n","        except Exception:\n","            return val\n","\n","# ---- ensure_dirs fallback ----\n","if \"ensure_dirs\" not in globals():\n","    import pathlib\n","    def ensure_dirs():\n","        for d in (\"resultados\", \"logs\", \"artefactos\"):\n","            pathlib.Path(d).mkdir(parents=True, exist_ok=True)\n","\n","# ---- Time helpers ----\n","def now_ny_str():\n","    try:\n","        tz = ZoneInfo(\"America/New_York\") if ZoneInfo else None\n","    except Exception:\n","        tz = None\n","    now = dt.now(tz) if tz else dt.utcnow()\n","    sfx = \"\" if tz else \" UTC\"\n","    return now.strftime(\"%Y-%m-%d %H:%M:%S\") + (\"\" if tz and now.tzname() else sfx)\n","\n","# ---- tzfix wrapper: intenta reintento si hay errores de TZ/naive datetime ----\n","class tzfix:\n","    @staticmethod\n","    async def run_with_tz_auto_repair_async(coro_func, *args, **kwargs):\n","        try:\n","            return await coro_func(*args, **kwargs)\n","        except Exception as e:\n","            em = str(e).lower()\n","            if \"timezone\" in em or \"naive\" in em or \"offset-aware\" in em:\n","                # Intenta una re-ejecución simple\n","                try:\n","                    return await coro_func(*args, **kwargs)\n","                except Exception:\n","                    raise\n","            raise\n","\n","# ---- Inteligencia BTC fallbacks ----\n","if \"_safe_init_btc_intelligence\" not in globals():\n","    async def _safe_init_btc_intelligence():\n","        try:\n","            # si existe una función real en tu proyecto\n","            return await init_btc_intelligence()  # type: ignore[name-defined]\n","        except NameError:\n","            return (None, None)\n","\n","if \"_unpack_intel_ctx\" not in globals():\n","    def _unpack_intel_ctx(ctx):\n","        if isinstance(ctx, tuple) and len(ctx) == 2:\n","            return ctx[0], ctx[1]\n","        return None, None\n","\n","# ---- Señales ML fallback ----\n","if \"decision_from_signal\" not in globals():\n","    def decision_from_signal(sig: dict, trend_state: str):\n","        # Neutral por defecto\n","        return (\"ESPERAR\", {\"accion\":\"HOLD\",\"tendencia\":trend_state,\"size\":0,\"sl\":None})\n","\n","# ---- Ejecutor fallback ----\n","if \"maybe_exec\" not in globals():\n","    async def maybe_exec(executor, decision_final, price, extras):\n","        try:\n","            if hasattr(executor, \"ejecutar_decision\"):\n","                return await executor.ejecutar_decision(decision_final, price, extras)  # type: ignore\n","            if hasattr(executor, \"execute_order\"):\n","                return await executor.execute_order(decision_final, price, extras)  # type: ignore\n","            print(f\"ℹ️ Executor no expone ejecutar_decision/execute_order. Decisión: {decision_final}\")\n","        except Exception as e:\n","            print(f\"⚠️ maybe_exec error: {e}\")\n","\n","# ---- Smoke test fallback ----\n","if \"run_smoke_test\" not in globals():\n","    async def run_smoke_test(api, executor):\n","        try:\n","            price = 0.0\n","            if hasattr(api, \"get_price\"):\n","                price = await api.get_price(cfg('PAR_TRADING', 'XXBTZUSD'))  # type: ignore\n","            print(f\"🧪 Smoke test: precio={price:.2f}\")\n","        except Exception as e:\n","            print(f\"⚠️ Smoke test fallback: {e}\")\n","\n","# ---- Helpers de modo REAL (compat con tu APIManager) ----\n","def modo_real_activo(api) -> bool:\n","    try:\n","        flag = bool(getattr(api, \"_private_enabled\", False))\n","        k = (getattr(getattr(api, \"api\", None), \"key\", \"\") or \"\")\n","        s = (getattr(getattr(api, \"api\", None), \"secret\", \"\") or \"\")\n","        return flag and len(k) >= 20 and len(s) >= 20\n","    except Exception:\n","        return False\n","\n","def desactivar_modo_real(api, motivo: str | None = None) -> None:\n","    try:\n","        if motivo:\n","            print(f\"ℹ️  Desactivando MODO REAL: {motivo}. Pasando a PÚBLICO.\")\n","        if hasattr(api, \"_private_enabled\"):\n","            setattr(api, \"_private_enabled\", False)\n","    except Exception:\n","        pass\n","\n","# Versión asíncrona (validada con llamada privada)\n","async def _activar_modo_real_core(api, *, intentar_env=True, solicitar_en_tty=False, validar=True, silencioso=True) -> bool:\n","    if api is None or not hasattr(api, \"api\"):\n","        if not silencioso: print(\"⚠️  API inválida; no se puede activar MODO REAL.\")\n","        return False\n","    k = (os.getenv(\"KRAKEN_API_KEY\", \"\") or \"\").strip() if intentar_env else \"\"\n","    s = (os.getenv(\"KRAKEN_API_SECRET\", \"\") or \"\").strip() if intentar_env else \"\"\n","    if (not k or not s) and solicitar_en_tty and sys.stdin and sys.stdin.isatty():\n","        try:\n","            from getpass import getpass\n","            if not k: k = getpass(\"Ingrese API Key: \").strip()\n","            if not s: s = getpass(\"Ingrese API Secret: \").strip()\n","        except Exception:\n","            pass\n","    if not k or not s:\n","        if not silencioso: print(\"ℹ️  No hay claves Kraken. Continuando en PÚBLICO.\")\n","        desactivar_modo_real(api, \"faltan claves\")\n","        return False\n","    if len(k) < 20 or len(s) < 20:\n","        if not silencioso: print(\"⚠️  Claves con longitud insuficiente. Modo PÚBLICO.\")\n","        desactivar_modo_real(api, \"formato inválido\")\n","        return False\n","    try:\n","        api.api.key = k\n","        api.api.secret = s\n","        setattr(api, \"_private_enabled\", True)\n","    except Exception as e:\n","        if not silencioso: print(f\"⚠️  No se pudieron aplicar claves: {e}\")\n","        desactivar_modo_real(api, \"asignación de claves fallida\")\n","        return False\n","    if validar:\n","        try:\n","            if not hasattr(api, \"query_private\"):\n","                raise AttributeError(\"query_private no disponible.\")\n","            resp = await api.query_private(\"Balance\")\n","            if not isinstance(resp, dict): raise RuntimeError(\"Respuesta privada no dict.\")\n","            errs = resp.get(\"error\") or []\n","            if errs: raise PermissionError(str(errs))\n","        except Exception as e:\n","            desactivar_modo_real(api, f\"validación fallida: {e}\")\n","            if not silencioso: print(f\"⚠️  No se pudo activar MODO REAL: {e}\")\n","            return False\n","    if not silencioso: print(\"🟪 Transición → MODO REAL ACTIVADO (claves válidas).\")\n","    return True\n","\n","# Wrapper sincrónico solicitado por tu main (firma: env, api)\n","def activar_modo_real_si_listo(env, api):  # noqa: used by main()\n","    \"\"\"\n","    No bloquea el flujo: agenda la activación validada en segundo plano.\n","    Tu main sigue igual (no necesita 'await').\n","    \"\"\"\n","    try:\n","        loop = asyncio.get_running_loop()\n","        loop.create_task(_activar_modo_real_core(api, intentar_env=True, validar=True, silencioso=False))\n","        print(\"🔐 Intentando activar MODO REAL (validado) en segundo plano…\")\n","    except RuntimeError:\n","        # fuera de un loop (poco probable en tu main), ejecuta sincrónicamente\n","        asyncio.run(_activar_modo_real_core(api, intentar_env=True, validar=True, silencioso=False))\n","\n","# ---- Reporte de estado legible ----\n","def show_status_report(current_price, pred_a, pred_b, core_decision, extras: dict, decision_final: str, header: str = \"RESUMEN\"):\n","    print(\"\\n\" + \"—\"*78)\n","    print(f\"🧾 {header} @ {now_ny_str()}\")\n","    print(f\"💵 Precio: {current_price:.2f}\")\n","    print(f\"Core → 📈 {pred_a:.2f}%  |  📉 {pred_b:.2f}%   ⇒  🎯 {core_decision}\")\n","    print(f\"ML   → acción={extras.get('accion')}  trend={extras.get('tendencia')}  size={extras.get('size')}  SL={extras.get('sl')}\")\n","    print(f\"➡️  Decisión Final: {decision_final}\")\n","    print(\"—\"*78)\n","\n","# ---- EnvironmentManager fallback mínimo ----\n","if \"EnvironmentManager\" not in globals():\n","    class EnvironmentManager:\n","        def __init__(self):\n","            self._mode = os.getenv(\"APP_MODE\", \"test\").lower()\n","        def is_test_mode(self): return self._mode == \"test\"\n","        def is_production_mode(self): return self._mode in (\"prod\",\"real\",\"production\")\n","        def set_mode(self, mode: str):\n","            prev = self._mode\n","            self._mode = mode.lower()\n","            return (True, f\"{prev}→{self._mode}\")\n","\n","# ===================== FIX PERMANENTE datetime/time =====================\n","# Evita AttributeError por mezclas de import de datetime (módulo vs clase).\n","import datetime as _dt_mod\n","\n","class _DtShim:\n","    \"\"\"\n","    Shim compatible con ambos estilos:\n","      - dt.utcnow()\n","      - dt.datetime.utcnow()\n","    y expone timezone si lo necesitas en utilidades externas.\n","    \"\"\"\n","    datetime = _dt_mod.datetime\n","    timezone = getattr(_dt_mod, \"timezone\", None)\n","\n","    @staticmethod\n","    def utcnow():\n","        return _dt_mod.datetime.utcnow()\n","\n","# Forzamos 'dt' a nuestro shim robusto, sin tocar tu código original.\n","dt = _DtShim()\n","\n","# También asegúrate de tener disponible '_time' porque lo usas en main():\n","import time as _time\n","# =======================================================================\n","\n","# ===================== SHIM PERMANENTE PARA datetime (dt.utcnow / dt.now) =====================\n","# - Evita: \"_DtShim object has no attribute 'now'\"\n","# - Mantiene compatibilidad con llamadas existentes: dt.utcnow(), dt.now(tz=\"America/New_York\")\n","# - Si 'dt' apunta al módulo datetime o a un shim con __slots__, hace fallback a un proxy seguro.\n","\n","import types\n","import datetime as _dt_mod\n","\n","def _tz_from_any(tz=None):\n","    if tz is None:\n","        return None\n","    if isinstance(tz, str):\n","        # ZoneInfo preferido\n","        try:\n","            from zoneinfo import ZoneInfo\n","            return ZoneInfo(tz)\n","        except Exception:\n","            pass\n","        # pytz alternativo\n","        try:\n","            import pytz  # type: ignore\n","            return pytz.timezone(tz)\n","        except Exception:\n","            pass\n","        # fallback UTC\n","        return _dt_mod.timezone.utc\n","    return tz\n","\n","# Asegura que exista 'dt'\n","try:\n","    dt  # type: ignore[name-defined]\n","except NameError:\n","    import datetime as dt  # type: ignore[no-redef]\n","\n","def _compat_utcnow():\n","    # Devuelve naive-UTC para conservar el comportamiento clásico de utcnow()\n","    return _dt_mod.datetime.utcnow()\n","\n","def _compat_now(tz=None):\n","    tz_obj = _tz_from_any(tz)\n","    if tz_obj is None:\n","        # Por estabilidad, devolvemos naive-UTC cuando no se pasa tz\n","        return _dt_mod.datetime.utcnow()\n","    return _dt_mod.datetime.now(tz_obj)\n","\n","def _ensure_attr(obj, name, func):\n","    try:\n","        setattr(obj, name, func)  # módulos permiten setattr; algunos shims con __slots__ no\n","        return obj\n","    except Exception:\n","        # Si no permite setattr (p.ej. __slots__), creamos un proxy delegador\n","        class _DtProxy:\n","            __slots__ = (\"_base\",)\n","            def __init__(self, base):\n","                self._base = base\n","            def __getattr__(self, n):\n","                return getattr(self._base, n)\n","            # Atributos/funciones que garantizamos\n","            def utcnow(self):  # type: ignore[override]\n","                return _compat_utcnow()\n","            def now(self, tz=None):  # type: ignore[override]\n","                return _compat_now(tz)\n","        return _DtProxy(obj)\n","\n","# Instala/asegura utcnow y now\n","if not hasattr(dt, \"utcnow\"):\n","    dt = _ensure_attr(dt, \"utcnow\", _compat_utcnow)  # type: ignore[assignment]\n","if not hasattr(dt, \"now\"):\n","    dt = _ensure_attr(dt, \"now\", _compat_now)  # type: ignore[assignment]\n","\n","# Asegura alias útiles si el shim no los expone\n","if not hasattr(dt, \"timezone\"):\n","    try:\n","        setattr(dt, \"timezone\", _dt_mod.timezone)  # type: ignore[arg-type]\n","    except Exception:\n","        pass\n","if not hasattr(dt, \"timedelta\"):\n","    try:\n","        setattr(dt, \"timedelta\", _dt_mod.timedelta)  # type: ignore[arg-type]\n","    except Exception:\n","        pass\n","# ===================== FIN SHIM PERMANENTE =====================\n","\n","\n","# ===================== Helper: activar_modo_real_si_listo (permanente) =====================\n","def activar_modo_real_si_listo(env, api) -> tuple[bool, str]:\n","    \"\"\"\n","    Intenta activar MODO REAL si hay credenciales Kraken disponibles.\n","    - No rompe el flujo si faltan variables o si la API no expone setters.\n","    - Idempotente: si ya estás en producción, no hace nada.\n","    - Robusto: soporta distintos nombres de variables y distintas formas de inyectar claves.\n","    Retorna (ok, reason).\n","    \"\"\"\n","    import os\n","\n","    # 1) Intentar cargar .env si está disponible (no falla si no existe)\n","    try:\n","        from dotenv import load_dotenv  # type: ignore\n","        load_dotenv()\n","    except Exception:\n","        pass\n","\n","    # 2) Leer credenciales posibles (variantes de nombres comunes)\n","    api_key = (\n","        os.getenv(\"KRAKEN_API_KEY\")\n","        or os.getenv(\"KRAKEN_KEY\")\n","        or os.getenv(\"API_KEY\")\n","    )\n","    api_secret = (\n","        os.getenv(\"KRAKEN_API_SECRET\")\n","        or os.getenv(\"KRAKEN_SECRET\")\n","        or os.getenv(\"API_SECRET\")\n","    )\n","    api_otp = (\n","        os.getenv(\"KRAKEN_2FA\")\n","        or os.getenv(\"KRAKEN_OTP\")\n","        or os.getenv(\"API_OTP\")\n","        or None\n","    )\n","\n","    # 3) Si falta algo, no forzamos nada: seguimos en modo actual\n","    if not api_key or not api_secret:\n","        print(\"🟡 MODO REAL no habilitado: faltan variables KRAKEN_API_KEY y/o KRAKEN_API_SECRET.\")\n","        return (False, \"missing-env\")\n","\n","    # 4) Inyectar credenciales en APIManager, probando rutas conocidas sin romper nada\n","    injected = False\n","    try:\n","        # a) Método directo\n","        if hasattr(api, \"set_keys\") and callable(getattr(api, \"set_keys\")):\n","            try:\n","                api.set_keys(api_key, api_secret, otp=api_otp)  # algunos exponen otp\n","            except TypeError:\n","                api.set_keys(api_key, api_secret)\n","            injected = True\n","        # b) Método alterno\n","        elif hasattr(api, \"configure_auth\") and callable(getattr(api, \"configure_auth\")):\n","            try:\n","                api.configure_auth(api_key=api_key, api_secret=api_secret, otp=api_otp)\n","            except TypeError:\n","                api.configure_auth(api_key=api_key, api_secret=api_secret)\n","            injected = True\n","        # c) Cliente Kraken interno típico (krakenex.API)\n","        elif hasattr(api, \"kraken\"):\n","            k = getattr(api, \"kraken\")\n","            try:\n","                setattr(k, \"key\", api_key)\n","                setattr(k, \"secret\", api_secret)\n","                injected = True\n","            except Exception:\n","                pass\n","        # d) Cliente anidado genérico\n","        elif hasattr(api, \"client\"):\n","            c = getattr(api, \"client\")\n","            try:\n","                setattr(c, \"key\", api_key)\n","                setattr(c, \"secret\", api_secret)\n","                injected = True\n","            except Exception:\n","                pass\n","    except Exception as e:\n","        print(f\"⚠️ No se pudieron inyectar credenciales en APIManager: {e}\")\n","\n","    # 5) Activar modo real en el gestor de entorno (si corresponde)\n","    flipped = False\n","    try:\n","        if hasattr(env, \"is_production_mode\") and env.is_production_mode():\n","            flipped = True\n","        elif hasattr(env, \"set_mode\") and callable(getattr(env, \"set_mode\")):\n","            try:\n","                ok, reason = env.set_mode(\"real\")  # tu EnvironmentManager suele devolver (ok, reason)\n","                flipped = bool(ok)\n","                if not ok:\n","                    print(f\"⚠️ No se pudo activar MODO REAL desde EnvironmentManager: {reason}\")\n","            except Exception as e:\n","                print(f\"⚠️ set_mode('real') lanzó excepción: {e}\")\n","        elif hasattr(env, \"activate_real_mode\") and callable(getattr(env, \"activate_real_mode\")):\n","            env.activate_real_mode()\n","            flipped = True\n","    except Exception as e:\n","        print(f\"⚠️ No se pudo establecer modo real: {e}\")\n","\n","    # 6) Mensajería final coherente (sin detener ejecución)\n","    if injected and flipped:\n","        print(\"🟢 MODO REAL listo: credenciales cargadas y entorno en producción.\")\n","        return (True, \"ok\")\n","    if injected and not flipped:\n","        print(\"🟡 Credenciales Kraken cargadas, pero el entorno sigue en modo prueba.\")\n","        return (False, \"env-not-flipped\")\n","    if not injected and flipped:\n","        print(\"🟢 Entorno en producción, pero no pude inyectar credenciales en APIManager.\")\n","        return (True, \"env-only\")\n","    print(\"🟡 No se aplicaron cambios. Manteniendo modo actual.\")\n","    return (False, \"no-op\")\n","# =================== /Helper: activar_modo_real_si_listo ===================\n","\n","# ===================== PARCHE PERMANENTE ANTI-429 (3 pasos) =====================\n","# Paso 1/3: envoltorio con rate-limit, backoff exponencial con jitter y microcache\n","import asyncio, logging, random, time as _time\n","from typing import Any, Dict, Tuple\n","\n","def wire_kraken_public_rate_limiter(api,\n","                                    rps: float = None,\n","                                    max_reintentos: int = None,\n","                                    backoff_max_s: float = None,\n","                                    logger_name: str = \"kraken_rl\") -> None:\n","    \"\"\"\n","    Envoltorio no invasivo para api.query_public:\n","      - Limita RPS global (Semaphore + intervalo mínimo).\n","      - Respeta Retry-After si está disponible.\n","      - Backoff exponencial con jitter en 429/TooManyRequests.\n","      - Microcache corta para Ticker/OHLC (reduce picos).\n","    \"\"\"\n","    log = logging.getLogger(logger_name)\n","    if not log.handlers:\n","        log.addHandler(logging.StreamHandler())\n","    log.setLevel(logging.INFO)\n","\n","    # Lee desde ENV si existen, con defaults sensatos\n","    try:\n","        import os\n","        rps = rps if rps is not None else float(os.getenv(\"KRAKEN_PUBLIC_RPS\", \"0.8\"))\n","        max_reintentos = max_reintentos if max_reintentos is not None else int(os.getenv(\"KRAKEN_MAX_REINTENTOS\", \"7\"))\n","        backoff_max_s = backoff_max_s if backoff_max_s is not None else float(os.getenv(\"KRAKEN_BACKOFF_MAX_SECONDS\", \"60\"))\n","    except Exception:\n","        rps = rps or 0.8\n","        max_reintentos = max_reintentos or 7\n","        backoff_max_s = backoff_max_s or 60.0\n","\n","    # No envolver dos veces\n","    if getattr(api, \"_rl_wrapped\", False):\n","        return\n","\n","    orig = api.query_public\n","    sem = asyncio.Semaphore(1)  # serializa para evitar ráfagas\n","    min_interval = 1.0 / max(rps, 0.0001)\n","    last_call_ts = 0.0\n","\n","    # microcache: clave = (method, frozenset(params.items() sin 'nonce'))\n","    cache: Dict[Tuple[str, Tuple[Tuple[str, Any], ...]], Tuple[float, Any, float]] = {}\n","    # TTL heurísticos\n","    TTL = {\n","        \"Ticker\": 0.9,   # ~1 segundo para suavizar\n","        \"OHLC\":  2.5,    # leve amortiguación; OHLC igual se solicita por since\n","    }\n","\n","    def _freeze(method: str, params: Dict[str, Any]) -> Tuple[str, Tuple[Tuple[str, Any], ...]]:\n","        p = tuple(sorted([(k, v) for k, v in (params or {}).items() if k.lower() != \"nonce\"]))\n","        return (method, p)\n","\n","    def _get_retry_after(e) -> float:\n","        # Intenta extraer Retry-After si existe\n","        try:\n","            h = getattr(e, \"headers\", None) or {}\n","            ra = h.get(\"Retry-After\")\n","            if ra:\n","                try:\n","                    return float(ra)\n","                except Exception:\n","                    return 0.0\n","        except Exception:\n","            pass\n","        return 0.0\n","\n","    async def wrapped(method: str, params: Dict[str, Any] | None = None):\n","        nonlocal last_call_ts\n","        m = method or \"\"\n","        params = params or {}\n","\n","        # Microcache\n","        key = _freeze(m, params)\n","        ttl = TTL.get(m, 0.0)\n","        if ttl > 0.0:\n","            item = cache.get(key)\n","            if item:\n","                ts, value, item_ttl = item\n","                if (_time.time() - ts) <= item_ttl:\n","                    return value\n","\n","        # Entra al rate limiter\n","        async with sem:\n","            # Cumple intervalo mínimo\n","            to_wait = min_interval - (_time.time() - last_call_ts)\n","            if to_wait > 0:\n","                await asyncio.sleep(to_wait)\n","            # Pequeño jitter para desincronizar\n","            await asyncio.sleep(random.uniform(0.05, 0.20))\n","\n","            intento = 0\n","            delay = 0.8  # base de backoff\n","            while True:\n","                intento += 1\n","                try:\n","                    resp = await orig(method, params)\n","\n","                    # Si Kraken devolvió error 429 en payload (no excepción)\n","                    try:\n","                        if isinstance(resp, dict) and resp.get(\"error\"):\n","                            errs = [str(e) for e in resp.get(\"error\", [])]\n","                            if any(\"Too many requests\" in e or \"EGeneral:Too many requests\" in e for e in errs):\n","                                raise RuntimeError(\"TooManyRequestsError (payload)\")\n","                    except Exception:\n","                        pass\n","\n","                    last_call_ts = _time.time()\n","\n","                    # Guarda en microcache\n","                    if ttl > 0.0:\n","                        cache[key] = (last_call_ts, resp, ttl)\n","                    return resp\n","\n","                except Exception as e:\n","                    em = str(e)\n","                    is_429 = (\"Too many requests\" in em) or (\"EGeneral:Too many requests\" in em) or (\"429\" in em)\n","                    if not is_429 and intento == 1:\n","                        # Primer error no 429: pequeño respiro y un reintento\n","                        await asyncio.sleep(0.6 + random.uniform(0.05, 0.25))\n","                        if intento <= max_reintentos:\n","                            continue\n","                    if not is_429:\n","                        # Error distinto a 429 → propaga\n","                        raise\n","\n","                    # 429: respeta Retry-After si viene\n","                    ra = _get_retry_after(e)\n","                    if ra > 0:\n","                        await asyncio.sleep(min(ra, backoff_max_s))\n","                    else:\n","                        # backoff exponencial con jitter\n","                        await asyncio.sleep(min(delay, backoff_max_s) + random.uniform(0.05, 0.35))\n","                        delay *= 1.7\n","\n","                    if intento >= max_reintentos:\n","                        log.warning(f\"429 persistente en {method}. Reintentado {intento} veces, abortando.\")\n","                        raise\n","\n","    setattr(api, \"query_public\", wrapped)\n","    setattr(api, \"_rl_wrapped\", True)\n","    logging.getLogger(logger_name).info(\"Rate-limiter Kraken activo (RPS≈%.2f, max_reintentos=%d).\", rps, max_reintentos)\n","\n","# Paso 2/3: silenciar mensajes de reintentos ruidosos (tenacity/otros)\n","def silence_retry_logs():\n","    import logging\n","    patterns = (\n","        \"Retrying __main__.APIManager._query_public_inner\",\n","        \"TooManyRequestsError\",\n","        \"EGeneral:Too many requests\",\n","    )\n","\n","    class _RetrySilencer(logging.Filter):\n","        def filter(self, record: logging.LogRecord) -> bool:\n","            try:\n","                msg = record.getMessage()\n","            except Exception:\n","                msg = str(record.msg)\n","            return not any(p in msg for p in patterns)\n","\n","    # Sube el nivel de tenacity y agrega filtro\n","    tenacity_logger = logging.getLogger(\"tenacity\")\n","    tenacity_logger.setLevel(logging.ERROR)\n","    tenacity_logger.addFilter(_RetrySilencer())\n","\n","    # Algunos módulos donde suelen colarse\n","    for name in (\"ohlc_robusto\", \"kraken_api\", \"__main__\", \"asyncio\"):\n","        logging.getLogger(name).addFilter(_RetrySilencer())\n","\n","# Paso 3/3: (opcional) expón helpers para apagar/encender logs a voluntad\n","def set_retry_logs_enabled(enabled: bool):\n","    lvl = logging.ERROR if not enabled else logging.INFO\n","    logging.getLogger(\"tenacity\").setLevel(lvl)\n","# =================== FIN PARCHE PERMANENTE ANTI-429 (3 pasos) ===================\n","\n","\n","# ---- Helpers de hora local (sin romper nada existente) ----\n","# (Añadir inmediatamente después de tus definiciones TZ_NY y TZ_BOG; si este archivo\n","#  no ve esas variables, el helper funciona igual porque resuelve el timezone localmente.)\n","try:\n","    timezone  # si existe en el módulo de TZ-guard\n","except NameError:  # fallback limpio\n","    from datetime import timezone as timezone\n","\n","from datetime import datetime\n","\n","def _safe_zoneinfo(name: str):\n","    try:\n","        from zoneinfo import ZoneInfo  # type: ignore\n","        return ZoneInfo(name)\n","    except Exception:\n","        try:\n","            import pytz  # type: ignore\n","            return pytz.timezone(name)  # type: ignore\n","        except Exception:\n","            return timezone.utc\n","\n","def now_in_tz(tz_name: str) -> datetime:\n","    \"\"\"Devuelve datetime timezone-aware de la zona pedida, con fallback robusto.\"\"\"\n","    tz = _safe_zoneinfo(tz_name)\n","    try:\n","        return datetime.now(tz)\n","    except Exception:\n","        # Fallback: desde UTC → zona\n","        return datetime.now(timezone.utc).astimezone(tz)\n","\n","def _fmt_dt(d: datetime, fmt: str = \"%Y-%m-%d %H:%M:%S %Z\") -> str:\n","    try:\n","        return d.strftime(fmt)\n","    except Exception:\n","        # Fallback simple en UTC si el formato falla\n","        return datetime.now(timezone.utc).strftime(\"%Y-%m-%d %H:%M:%S UTC\")\n","\n","def local_times_block(locations: dict | None = None, fmt: str = \"%Y-%m-%d %H:%M:%S %Z\") -> str:\n","    \"\"\"\n","    Devuelve un bloque de texto con las horas locales sincronizadas de varios lugares.\n","    locations: {\"Etiqueta\": \"Area/City\", ...}\n","    \"\"\"\n","    if locations is None:\n","        locations = {\n","            \"UTC\": \"UTC\",\n","            \"New York\": \"America/New_York\",\n","            \"Bogotá\": \"America/Bogota\",\n","        }\n","    lines = []\n","    # Ancla de sincronización en UTC → todas se derivan del mismo 'ahora'\n","    anchor_utc = datetime.now(timezone.utc)\n","    for label, tzname in locations.items():\n","        tz = _safe_zoneinfo(tzname)\n","        try:\n","            local_dt = anchor_utc.astimezone(tz)\n","        except Exception:\n","            local_dt = now_in_tz(tzname)\n","        lines.append(f\" - {label:10s}: {_fmt_dt(local_dt, fmt)}\")\n","    return \"\\n\".join(lines)\n","\n","def print_local_times(locations: dict | None = None, fmt: str = \"%Y-%m-%d %H:%M:%S %Z\") -> None:\n","    \"\"\"Imprime el bloque formateado (útil para puntos de control).\"\"\"\n","    try:\n","        print(\"🕒 Relojes locales sincronizados:\\n\" + local_times_block(locations, fmt))\n","    except Exception as e:\n","        print(f\"⚠️ No se pudieron imprimir relojes locales: {e}\")\n","\n","\n","\n","# ==================== UTILIDAD DE HISTORIAL CON REINTENTOS ====================\n","import asyncio, time, os, json, csv, re, importlib, subprocess, sys, builtins\n","from datetime import datetime, timedelta, timezone as _dt_utc\n","from decimal import Decimal\n","from typing import Dict\n","from collections import deque\n","\n","# Utilidades de tiempo (parche definitivo anti-utcnow)\n","def utc_now_dt() -> datetime:\n","    return datetime.now(_dt_utc.utc).replace(microsecond=0)\n","\n","def utc_now_iso() -> str:\n","    return utc_now_dt().isoformat()\n","\n","async def completar_historial_predictores(trading_core, api):\n","    for predictor in [trading_core.predictor_alcista, trading_core.predictor_bajista]:\n","        intentos = 0\n","        print(f\"\\n⏳ Completando historial inicial para {type(predictor).__name__}...\")\n","        while len(predictor.history) < Config.MODEL_INPUT_WINDOW and intentos < 100:  # type: ignore[name-defined]\n","            try:\n","                ohlc = await api.query_public('OHLC', {\n","                    'pair': Config.PAR_TRADING,          # type: ignore[name-defined]\n","                    'interval': Config.INTERVAL,          # type: ignore[name-defined]\n","                    'count': 1\n","                })\n","                if 'error' in ohlc and any(\"Too many requests\" in str(err) or \"EGeneral:Too many requests\" in str(err) for err in ohlc.get('error', [])):\n","                    espera = min(60, 2 ** intentos)\n","                    print(f\"⚠️ Kraken: demasiadas solicitudes. Intento {intentos+1}. Esperando {espera}s...\")\n","                    await asyncio.sleep(espera)\n","                    intentos += 1\n","                    continue\n","                if 'result' in ohlc:\n","                    # admitimos claves como 'XXBTZUSD' o alias del par\n","                    k = next(iter(ohlc['result']))\n","                    if isinstance(ohlc['result'][k], list) and ohlc['result'][k]:\n","                        precio = float(ohlc['result'][k][0][4])\n","                        predictor.history.append(precio)\n","                        print(f\"📅 Historial {len(predictor.history)}/{Config.MODEL_INPUT_WINDOW} actualizado\")  # type: ignore[name-defined]\n","                    else:\n","                        print(\"⚠️ OHLC sin datos válidos\")\n","                else:\n","                    print(\"⚠️ OHLC sin campo 'result'\")\n","            except Exception as e:\n","                print(f\"❌ Error obteniendo historial: {e}\")\n","            await asyncio.sleep(1)\n","            intentos += 1\n","\n","\n","# ======= AÑADE ESTO ARRIBA, junto a los helpers del bloque de sentimiento =======\n","def _sklearn_tiene_xpx() -> bool:\n","    \"\"\"\n","    Devuelve True si sklearn.utils._array_api expone 'xpx' (sklearn >= 1.5),\n","    que algunas rutas de Transformers esperan. Si no está, evitamos usar Transformers.\n","    \"\"\"\n","    try:\n","        import sklearn  # noqa: F401\n","        from sklearn.utils import _array_api as _ax  # type: ignore\n","        return hasattr(_ax, \"xpx\")\n","    except Exception:\n","        return False\n","# ================================================================================\n","\n","# ==================== MODULO: HISTORIAL MANAGER (PERMANENTE) ====================\n","# - Completa historial real para predictores (alcista y bajista) desde Kraken OHLC.\n","# - Idempotente, con caché, backoff y control de rate limit.\n","# ================================================================================\n","import os, json, time, math, asyncio, logging, random\n","from dataclasses import dataclass\n","from typing import Any, Dict, List, Optional, Tuple\n","from datetime import datetime, timezone as _tz\n","from pathlib import Path\n","\n","# ---------- Utilidades de tiempo ----------\n","def _utc_now_dt() -> datetime:\n","    return datetime.now(_tz.utc).replace(microsecond=0)\n","\n","def _utc_ts() -> int:\n","    return int(_utc_now_dt().timestamp())\n","\n","# ---------- Config genérica con defaults si no existe Config ----------\n","def _get_cfg():\n","    class _Cfg:\n","        PAR_TRADING = os.getenv(\"PAR_TRADING\", \"XXBTZUSD\")\n","        INTERVAL = int(os.getenv(\"ICT_INTERVAL_MINUTES\", os.getenv(\"INTERVAL_MINUTES\", \"5\")))\n","        MODEL_INPUT_WINDOW = int(os.getenv(\"MODEL_INPUT_WINDOW\", \"60\"))\n","        RUN_ROOT = os.getenv(\"TTDVI_RUN_ROOT\", \"./run_ttdvi156\")\n","        KRAKEN_PUBLIC_RPS = float(os.getenv(\"KRAKEN_PUBLIC_RPS\", \"10\"))\n","        MAX_RETRIES = int(os.getenv(\"HIST_MAX_RETRIES\", \"12\"))\n","        BACKOFF_BASE = float(os.getenv(\"HIST_BACKOFF_BASE\", \"1.8\"))\n","        CACHE_HORIZON_MULT = float(os.getenv(\"HIST_CACHE_HORIZON_MULT\", \"1.6\"))  # cuántas velas extra cachear\n","    try:\n","        # Si ya tienes una clase Config real en tu código, úsala\n","        from types import SimpleNamespace\n","        C = globals().get(\"Config\", None)\n","        if C:\n","            # convertimos a objeto plano con atributos\n","            return SimpleNamespace(\n","                PAR_TRADING = getattr(C, \"PAR_TRADING\", _Cfg.PAR_TRADING),\n","                INTERVAL = int(getattr(C, \"INTERVAL\", _Cfg.INTERVAL)),\n","                MODEL_INPUT_WINDOW = int(getattr(C, \"MODEL_INPUT_WINDOW\", _Cfg.MODEL_INPUT_WINDOW)),\n","                RUN_ROOT = getattr(C, \"RUN_ROOT\", _Cfg.RUN_ROOT),\n","                KRAKEN_PUBLIC_RPS = float(getattr(C, \"KRAKEN_PUBLIC_RPS\", _Cfg.KRAKEN_PUBLIC_RPS)),\n","                MAX_RETRIES = int(getattr(C, \"HIST_MAX_RETRIES\", _Cfg.MAX_RETRIES)),\n","                BACKOFF_BASE = float(getattr(C, \"HIST_BACKOFF_BASE\", _Cfg.BACKOFF_BASE)),\n","                CACHE_HORIZON_MULT = float(getattr(C, \"HIST_CACHE_HORIZON_MULT\", _Cfg.CACHE_HORIZON_MULT)),\n","            )\n","    except Exception:\n","        pass\n","    return _Cfg()\n","\n","_CFG = _get_cfg()\n","Path(_CFG.RUN_ROOT).mkdir(parents=True, exist_ok=True)\n","\n","# ---------- Token bucket simple para limitar RPS ----------\n","class _TokenBucket:\n","    def __init__(self, rate: float, cap: float = 10.0):\n","        self.rate = max(0.5, rate)\n","        self.cap = cap\n","        self.tokens = cap\n","        self.last = time.time()\n","\n","    async def take(self, need: float = 1.0):\n","        now = time.time()\n","        self.tokens = min(self.cap, self.tokens + (now - self.last) * self.rate)\n","        self.last = now\n","        while self.tokens < need:\n","            await asyncio.sleep(max(0.01, (need - self.tokens) / self.rate))\n","            now = time.time()\n","            self.tokens = min(self.cap, self.tokens + (now - self.last) * self.rate)\n","            self.last = now\n","        self.tokens -= need\n","\n","_TOKEN_BUCKET = _TokenBucket(rate=_CFG.KRAKEN_PUBLIC_RPS, cap=10.0)\n","\n","# ---------- Utilidades Kraken ----------\n","def _pair_key_from_result(result: Dict[str, Any]) -> Optional[str]:\n","    if not isinstance(result, dict):\n","        return None\n","    # Kraken devuelve algo como {'XXBTZUSD': [[ts, o,h,l,c,v,...], ...], 'last': 123456}\n","    keys = [k for k in result.keys() if k != \"last\"]\n","    return keys[0] if keys else None\n","\n","def _kraken_url() -> str:\n","    return \"https://api.kraken.com/0/public/OHLC\"\n","\n","async def _http_get_json(url: str, params: Dict[str, Any]) -> Dict[str, Any]:\n","    \"\"\"\n","    GET JSON con aiohttp si está, y fallback a urllib si no.\n","    \"\"\"\n","    try:\n","        import aiohttp  # type: ignore\n","    except Exception:\n","        aiohttp = None\n","\n","    qs = \"&\".join([f\"{k}={params[k]}\" for k in params])\n","    full_url = f\"{url}?{qs}\"\n","\n","    if aiohttp is not None:\n","        async with aiohttp.ClientSession() as sess:\n","            async with sess.get(full_url, timeout=30) as r:\n","                r.raise_for_status()\n","                return await r.json()\n","    else:\n","        import urllib.request, json as _json\n","        with urllib.request.urlopen(full_url, timeout=30) as resp:\n","            data = resp.read()\n","            return _json.loads(data.decode(\"utf-8\"))\n","\n","async def _fetch_ohlc_chunk(pair: str, interval: int, since: Optional[int]) -> Tuple[List[List[Any]], Optional[int], Optional[str]]:\n","    \"\"\"\n","    Pide a Kraken un bloque OHLC. Devuelve (velas, last, error_str)\n","    \"\"\"\n","    await _TOKEN_BUCKET.take(1.0)\n","    params = {\"pair\": pair, \"interval\": interval}\n","    if since is not None:\n","        params[\"since\"] = since\n","    try:\n","        data = await _http_get_json(_kraken_url(), params)\n","        if \"error\" in data and data[\"error\"]:\n","            # errores tipo \"EGeneral:Too many requests\"\n","            return [], None, \"; \".join(map(str, data[\"error\"]))\n","        res = data.get(\"result\", {})\n","        k = _pair_key_from_result(res)\n","        if not k:\n","            return [], None, \"Respuesta OHLC sin clave de par\"\n","        candles = res.get(k, [])\n","        last = res.get(\"last\", None)\n","        return candles, last, None\n","    except Exception as e:\n","        return [], None, str(e)\n","\n","# ---------- Caché en disco ----------\n","def _cache_path(pair: str, interval: int) -> Path:\n","    safe_pair = pair.replace(\"/\", \"_\")\n","    return Path(_CFG.RUN_ROOT) / f\"ohlc_cache_{safe_pair}_{interval}.json\"\n","\n","def _load_cache(pair: str, interval: int) -> List[List[Any]]:\n","    p = _cache_path(pair, interval)\n","    if p.exists():\n","        try:\n","            return json.loads(p.read_text())\n","        except Exception:\n","            return []\n","    return []\n","\n","def _save_cache(pair: str, interval: int, rows: List[List[Any]]):\n","    p = _cache_path(pair, interval)\n","    try:\n","        p.write_text(json.dumps(rows))\n","    except Exception:\n","        pass\n","\n","def _merge_dedup_sort(existing: List[List[Any]], incoming: List[List[Any]]) -> List[List[Any]]:\n","    by_ts: Dict[int, List[Any]] = {}\n","    for row in existing:\n","        if not row:\n","            continue\n","        by_ts[int(row[0])] = row\n","    for row in incoming:\n","        if not row:\n","            continue\n","        by_ts[int(row[0])] = row  # incoming pisa\n","    merged = list(by_ts.values())\n","    merged.sort(key=lambda r: int(r[0]))\n","    return merged\n","\n","# ---------- Normalización y extracción de precios ----------\n","def _extract_close(candle: List[Any]) -> Optional[float]:\n","    # Kraken: [time, open, high, low, close, vwap, volume, count]\n","    try:\n","        return float(candle[4])\n","    except Exception:\n","        return None\n","\n","def _interval_seconds(interval_min: int) -> int:\n","    return max(60, int(interval_min) * 60)\n","\n","# ---------- Gestor principal ----------\n","@dataclass\n","class HistorialManager:\n","    pair: str\n","    interval_min: int\n","    min_window: int\n","\n","    @classmethod\n","    def from_config(cls):\n","        return cls(pair=_CFG.PAR_TRADING, interval_min=_CFG.INTERVAL, min_window=_CFG.MODEL_INPUT_WINDOW)\n","\n","    async def _ensure_cache(self) -> List[List[Any]]:\n","        \"\"\"\n","        Carga caché y la extiende si está vieja o insuficiente.\n","        \"\"\"\n","        needed = int(math.ceil(self.min_window * _CFG.CACHE_HORIZON_MULT))\n","        cache = _load_cache(self.pair, self.interval_min)\n","        # ¿caché suficiente y reciente?\n","        if cache:\n","            last_ts = int(cache[-1][0])\n","            # si la última vela es vieja más de un intervalo, intenta actualizar\n","            if _utc_ts() - last_ts < _interval_seconds(self.interval_min) * 2 and len(cache) >= needed:\n","                return cache\n","\n","        # Extender caché desde el timestamp adecuado\n","        since = None\n","        if cache:\n","            since = int(cache[-1][0])\n","        retries = 0\n","        new_rows: List[List[Any]] = []\n","        while len(cache) + len(new_rows) < needed and retries <= _CFG.MAX_RETRIES:\n","            candles, last, err = await _fetch_ohlc_chunk(self.pair, self.interval_min, since)\n","            if err:\n","                # Manejo de rate limit\n","                if \"Too many requests\" in err or \"EGeneral:Too many requests\" in err:\n","                    wait_s = min(60, (_CFG.BACKOFF_BASE ** retries))\n","                    print(f\"⚠️ Kraken rate limit. Reintentando en {wait_s:.1f}s (intento {retries+1}/{_CFG.MAX_RETRIES})...\")\n","                    await asyncio.sleep(wait_s)\n","                    retries += 1\n","                    continue\n","                else:\n","                    print(f\"❌ Error OHLC: {err}. Reintentando corto...\")\n","                    await asyncio.sleep(min(5, 0.5 * (_CFG.BACKOFF_BASE ** retries)))\n","                    retries += 1\n","                    continue\n","\n","            if candles:\n","                cache = _merge_dedup_sort(cache, candles)\n","                new_rows = []  # ya las fusionamos\n","                since = int(cache[-1][0])\n","            else:\n","                # Sin velas nuevas: espera 1/2 intervalo y reintenta\n","                await asyncio.sleep(max(1.0, _interval_seconds(self.interval_min) / 2))\n","                retries += 1\n","\n","        _save_cache(self.pair, self.interval_min, cache)\n","        return cache\n","\n","    async def obtener_historial_cierres(self) -> List[float]:\n","        \"\"\"\n","        Devuelve al menos min_window cierres más recientes.\n","        \"\"\"\n","        cache = await self._ensure_cache()\n","        closes = [c for c in (_extract_close(r) for r in cache) if c is not None]\n","        if len(closes) >= self.min_window:\n","            return closes[-self.min_window:]\n","        # Último intento: pedir directamente más atrás con since “antiguo”\n","        faltan = self.min_window - len(closes)\n","        intervalo = _interval_seconds(self.interval_min)\n","        oldest_needed_ts = _utc_ts() - (self.min_window + int(self.min_window*0.3)) * intervalo\n","        since = max(0, oldest_needed_ts)\n","        retries = 0\n","        while len(closes) < self.min_window and retries <= _CFG.MAX_RETRIES:\n","            candles, last, err = await _fetch_ohlc_chunk(self.pair, self.interval_min, since)\n","            if err:\n","                wait_s = min(60, (_CFG.BACKOFF_BASE ** retries))\n","                print(f\"⚠️ Reintento histórico ({retries+1}/{_CFG.MAX_RETRIES}) en {wait_s:.1f}s: {err}\")\n","                await asyncio.sleep(wait_s)\n","                retries += 1\n","                continue\n","            if candles:\n","                cache = _merge_dedup_sort(cache, candles)\n","                _save_cache(self.pair, self.interval_min, cache)\n","                closes = [c for c in (_extract_close(r) for r in cache) if c is not None]\n","                since = int(cache[0][0])  # extendemos por si falta aún más atrás\n","            else:\n","                break\n","        return closes[-self.min_window:] if len(closes) >= self.min_window else closes\n","\n","    # ---------- API pública para enchufar ----------\n","    @staticmethod\n","    async def ensure_historial(trading_core, api) -> None:\n","        \"\"\"\n","        Completa history para trading_core.predictor_alcista y predictor_bajista.\n","        \"\"\"\n","        cfg = HistorialManager.from_config()\n","        print(f\"\\n🧠 HistorialManager → par={cfg.pair} | intervalo={cfg.interval_min}min | ventana={cfg.min_window}\")\n","        closes = await cfg.obtener_historial_cierres()\n","        if not closes or len(closes) < cfg.min_window:\n","            print(f\"⛔️ Historial REAL insuficiente: {len(closes)}/{cfg.min_window}\")\n","        else:\n","            print(f\"✅ Historial listo: {len(closes)}/{cfg.min_window} cierres\")\n","\n","        # Helper para inyectar a cada predictor\n","        def _ensure_pred(predictor, nombre: str):\n","            if predictor is None:\n","                print(f\"⚠️ {nombre} no está instanciado, saltando…\")\n","                return\n","            # soporta list o deque\n","            try:\n","                hist = getattr(predictor, \"history\", None)\n","                if hist is None:\n","                    setattr(predictor, \"history\", [])\n","                    hist = predictor.history\n","                # normalizamos a lista\n","                seq = list(hist)\n","                need = cfg.min_window - len(seq)\n","                if need > 0 and closes:\n","                    # tomamos las últimas 'need' del batch\n","                    seq = (seq + list(closes)[-need:])[-cfg.min_window:]\n","                else:\n","                    # recorta a ventana exacta\n","                    seq = seq[-cfg.min_window:]\n","                # escribimos de vuelta respetando tipo\n","                if hasattr(hist, \"clear\") and hasattr(hist, \"extend\"):\n","                    hist.clear()\n","                    hist.extend(seq)\n","                else:\n","                    setattr(predictor, \"history\", seq)\n","                print(f\"📅 {nombre}: {len(getattr(predictor, 'history', []))}/{cfg.min_window} velas OK\")\n","            except Exception as e:\n","                print(f\"❌ No se pudo inyectar historial en {nombre}: {e}\")\n","\n","        _ensure_pred(trading_core.predictor_alcista, \"Predictor Alcista\")\n","        _ensure_pred(trading_core.predictor_bajista, \"Predictor Bajista\")\n","\n","        # Señal final\n","        if (getattr(trading_core.predictor_alcista, \"history\", None) and\n","            len(trading_core.predictor_alcista.history) >= cfg.min_window and\n","            getattr(trading_core.predictor_bajista, \"history\", None) and\n","            len(trading_core.predictor_bajista.history) >= cfg.min_window):\n","            print(\"🎯 Historial REAL COMPLETO para ambos predictores.\")\n","        else:\n","            print(\"⚠️ Aún falta historial en algún predictor (revisar logs).\")\n","\n","# ==================== EJEMPLO DE USO (llámalo en tu arranque) ====================\n","# await HistorialManager.ensure_historial(trading_core, api)\n","\n","\n","# ==================== ANÁLISIS DE SENTIMIENTO ROBUSTO (transformers + VADER + stub) ====================\n","import os, sys, re, json, csv, asyncio, importlib, subprocess, builtins\n","from decimal import Decimal\n","from datetime import datetime, timedelta\n","from collections import deque\n","\n","import pandas as pd\n","import numpy as np\n","\n","# ---- Heurísticas para incertidumbre/idioma/emoji ----\n","_SP_TOKENS = {\n","    \"el\",\"la\",\"los\",\"las\",\"de\",\"que\",\"y\",\"en\",\"con\",\"por\",\"para\",\"me\",\"muy\",\"hoy\",\"caída\",\"terrible\",\n","    \"señales\",\"claras\",\"sin\",\"amor\",\"compra\",\"venta\",\"alcista\",\"bajista\",\"sube\",\"baja\",\"comprar\",\"vender\"\n","}\n","_STRONG_EMOJIS = set(\"🚀😡😭😂👍👎🔥💥📉📈😢😃😁😠😤😍❤️💔😞😎\")\n","\n","def _has_spanish(txt: str) -> bool:\n","    t = (txt or \"\").lower()\n","    if re.search(r\"[áéíóúñ]\", t):\n","        return True\n","    return any(w in t for w in _SP_TOKENS)\n","\n","def _has_strong_emoji(txt: str) -> bool:\n","    return any(ch in _STRONG_EMOJIS for ch in (txt or \"\"))\n","\n","# -------------------- utilidades fecha --------------------\n","def _fallback_utc_tz():\n","    try:\n","        from datetime import UTC\n","        return UTC\n","    except Exception:\n","        class _UTC(datetime.tzinfo):\n","            def utcoffset(self, dt): return timedelta(0)\n","            def tzname(self, dt): return \"UTC\"\n","            def dst(self, dt): return timedelta(0)\n","        return _UTC()\n","\n","def utc_now_dt():\n","    try:\n","        return datetime.now(_fallback_utc_tz()).replace(microsecond=0)\n","    except Exception:\n","        return datetime.utcnow().replace(microsecond=0)\n","\n","def utc_now_iso():\n","    return utc_now_dt().isoformat()\n","\n","# Estado global del backend elegido\n","_SENTI_BACKEND = {\"name\": None, \"analyzer\": None}\n","\n","def _ensure_pkg(pkg: str, spec: str | None = None) -> bool:\n","    \"\"\"Importa un paquete, o lo instala silenciosamente y reintenta.\"\"\"\n","    try:\n","        importlib.import_module(pkg)\n","        return True\n","    except Exception:\n","        try:\n","            subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"--upgrade\", \"--prefer-binary\", spec or pkg])\n","            importlib.invalidate_caches()\n","            importlib.import_module(pkg)\n","            return True\n","        except Exception as e:\n","            print(f\"⚠️ No se pudo instalar {spec or pkg}: {e}\")\n","            return False\n","\n","def _parse_version_tuple(v: str):\n","    try:\n","        parts = re.split(r\"[^\\d]+\", v)\n","        nums = [int(x) for x in parts if x.isdigit()]\n","        while len(nums) < 3:\n","            nums.append(0)\n","        return tuple(nums[:3])\n","    except Exception:\n","        return (0, 0, 0)\n","\n","def _sklearn_tiene_xpx() -> bool:\n","    \"\"\"\n","    Devuelve True si scikit-learn es >= 1.5 (evita incompatibilidades con transformers modernos).\n","    \"\"\"\n","    try:\n","        import sklearn\n","        ver = getattr(sklearn, \"__version__\", \"0.0.0\")\n","        return _parse_version_tuple(ver) >= (1, 5, 0)\n","    except Exception:\n","        return False\n","\n","# Parche opcional para evitar el warning de HF “No model was supplied…”\n","def _patch_transformers_pipeline_default():\n","    try:\n","        import transformers as _tfm\n","        _orig = _tfm.pipeline\n","        def _wrapped(task, model=None, revision=None, **kwargs):\n","            model = model or os.getenv(\"HF_MODEL\", \"distilbert/distilbert-base-uncased-finetuned-sst-2-english\")\n","            revision = revision or os.getenv(\"HF_REV\", \"714eb0f\")\n","            token = kwargs.pop(\"token\", None) or os.getenv(\"HF_TOKEN\") or None\n","            kwargs.pop(\"use_auth_token\", None)  # compat\n","            return _orig(task, model=model, revision=revision, token=token, **kwargs)\n","        if getattr(_tfm.pipeline, \"__name__\", \"\") != \"_wrapped\":\n","            _tfm.pipeline = _wrapped\n","    except Exception:\n","        pass\n","_patch_transformers_pipeline_default()\n","\n","def habilitar_analisis_sentimiento(verbose: bool = True):\n","    \"\"\"\n","    1) transformers (TF) -> modelo fijado por env (evita warning de HF)\n","    2) VADER (vaderSentiment)\n","    3) Stub neutro\n","    \"\"\"\n","    global _SENTI_BACKEND\n","    if _SENTI_BACKEND[\"analyzer\"] is not None:\n","        return _SENTI_BACKEND[\"analyzer\"]\n","\n","    os.environ.setdefault(\"TRANSFORMERS_NO_TF_WARNING\", \"1\")\n","    os.environ.setdefault(\"TRANSFORMERS_VERBOSITY\", \"error\")\n","    os.environ.setdefault(\"HF_HUB_DISABLE_TELEMETRY\", \"1\")\n","\n","    # 1) Intentar transformers usando TensorFlow (evita Torch)\n","    try:\n","        if _ensure_pkg(\"transformers\", \"transformers==4.44.2\"):\n","            if not _sklearn_tiene_xpx():\n","                if verbose:\n","                    print(\"ℹ️ Omitiendo Transformers: scikit-learn < 1.5; activando VADER automáticamente.\")\n","            else:\n","                from transformers import pipeline\n","                def _wrap_tf_pipeline(nlp):\n","                    def _fn(x):\n","                        seq = list(x) if isinstance(x, (list, tuple, np.ndarray, pd.Series)) else [str(x)]\n","                        out = nlp(seq)\n","                        norm = []\n","                        for txt, r in zip(seq, out):\n","                            prob = float(r.get(\"score\", 0.0))\n","                            imp = 1.0 - prob\n","                            if _has_spanish(txt):\n","                                imp = min(1.0, imp + 0.10)\n","                            conf = 1.0 - imp\n","                            norm.append({\n","                                \"label\": r.get(\"label\", \"NEUTRAL\"),\n","                                \"score\": prob,\n","                                \"confidence\": conf,\n","                                \"imprecision\": imp,\n","                                \"source\": \"transformers(tf)\"\n","                            })\n","                        return norm\n","                    return _fn\n","                try:\n","                    nlp = pipeline(\n","                        task=\"sentiment-analysis\",\n","                        model=os.getenv(\"HF_MODEL\", \"distilbert-base-uncased-finetuned-sst-2-english\"),\n","                        revision=os.getenv(\"HF_REV\", \"714eb0f\"),\n","                        framework=\"tf\",\n","                        token=(os.getenv(\"HF_TOKEN\") or None)\n","                    )\n","                    analyzer = _wrap_tf_pipeline(nlp)\n","                    _SENTI_BACKEND = {\"name\": \"transformers(tf)\", \"analyzer\": analyzer}\n","                    if verbose: print(\"✅ Análisis de sentimiento habilitado con Transformers (TF).\")\n","                    return analyzer\n","                except Exception as e:\n","                    if verbose:\n","                        print(f\"ℹ️ Transformers presente pero el modelo no se cargó: {e}\")\n","    except Exception:\n","        if verbose:\n","            print(\"ℹ️ Omitiendo Transformers por conflicto con scikit-learn; continuo con VADER.\")\n","\n","    # 2) Fallback: VADER\n","    try:\n","        if _ensure_pkg(\"vaderSentiment\", \"vaderSentiment==3.3.2\"):\n","            from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer\n","            _vader = SentimentIntensityAnalyzer()\n","\n","            def _vader_wrap(x):\n","                def _one(txt: str):\n","                    s = _vader.polarity_scores(str(txt or \"\"))\n","                    c = float(s.get(\"compound\", 0.0))  # [-1,1]\n","                    if c >= 0.05:\n","                        label = \"POSITIVE\"\n","                    elif c <= -0.05:\n","                        label = \"NEGATIVE\"\n","                    else:\n","                        label = \"NEUTRAL\"\n","                    base_conf = max(0.0, (abs(c) - 0.05) / 0.95)  # [0,1]\n","                    imp = 1.0 - base_conf\n","                    if _has_spanish(txt):\n","                        imp = min(1.0, imp + 0.25)\n","                    if _has_strong_emoji(txt):\n","                        imp = max(0.0, imp - 0.10)\n","                    conf = 1.0 - imp\n","                    return {\n","                        \"label\": label,\n","                        \"score\": abs(c),\n","                        \"confidence\": conf,\n","                        \"imprecision\": imp,\n","                        \"source\": \"vader\"\n","                    }\n","                if isinstance(x, (list, tuple, np.ndarray, pd.Series)):\n","                    return [_one(t) for t in x]\n","                return [_one(x)]\n","\n","            _SENTI_BACKEND = {\"name\": \"vader\", \"analyzer\": _vader_wrap}\n","            if verbose: print(\"✅ Análisis de sentimiento habilitado con VADER (fallback).\")\n","            return _vader_wrap\n","    except Exception as e:\n","        if verbose: print(f\"ℹ️ VADER no disponible: {e}\")\n","\n","    # 3) Stub\n","    def _stub(x):\n","        def _one(_): return {\n","            \"label\": \"NEUTRAL\",\n","            \"score\": 0.0,\n","            \"confidence\": 0.0,\n","            \"imprecision\": 1.0,\n","            \"source\": \"stub\"\n","        }\n","        if isinstance(x, (list, tuple, np.ndarray, pd.Series)):\n","            return [_one(t) for t in x]\n","        return [_one(x)]\n","\n","    _SENTI_BACKEND = {\"name\": \"stub\", \"analyzer\": _stub}\n","    if verbose: print(\"⚠️ Análisis de sentimiento no disponible. Usando stub neutro (sin bloqueo).\")\n","    return _stub\n","\n","def analizar_sentimiento(texto_o_lista):\n","    analyzer = habilitar_analisis_sentimiento(verbose=False)\n","    return analyzer(texto_o_lista)\n","\n","def estado_analisis_sentimiento() -> dict:\n","    return {\"backend\": _SENTI_BACKEND[\"name\"] or \"desconocido\"}\n","\n","# ---------- Filtro anti-mensaje legado ----------\n","_MENSAJE_OBSOLETO = \"No se pudo habilitar el análisis de sentimiento (falta transformers)\"\n","if not getattr(builtins, \"_print_patched_sentimiento\", False):\n","    _orig_print = getattr(builtins, \"_original_print\", builtins.print)\n","    def _print_filter(*args, **kwargs):\n","        try:\n","            txt = \" \".join(str(a) for a in args)\n","            if _MENSAJE_OBSOLETO in txt:\n","                return\n","        except Exception:\n","            pass\n","        return _orig_print(*args, **kwargs)\n","    builtins.print = _print_filter\n","    builtins._print_patched_sentimiento = True\n","\n","# Inicializa e informa 1 vez\n","habilitar_analisis_sentimiento(verbose=True)\n","print(\"🧠 Estado análisis de sentimiento:\", estado_analisis_sentimiento())\n","# ==================== FIN BLOQUE SENTIMIENTO ====================\n","\n","\n","# ==================== CONFIGURADOR FILOSÓFICO DE BOT TOTALMENTE DEFINIDO ====================\n","\n","# ====== Hotfix permanente: suprimir avisos legacy de empirismo/conexionismo ======\n","import logging\n","_FILO_WARN_PATTERNS = (\n","    \"Sin predictor para empirismo\",\n","    \"Sin modelo para conexionismo\",\n",")\n","\n","def _texto_contiene_aviso_filo(msg: str) -> bool:\n","    try:\n","        m = str(msg).strip()\n","    except Exception:\n","        m = f\"{msg}\"\n","    return any(pat in m for pat in _FILO_WARN_PATTERNS)\n","\n","class _FiltroFilosofia(logging.Filter):\n","    def filter(self, record: logging.LogRecord) -> bool:\n","        try:\n","            msg = record.getMessage()\n","        except Exception:\n","            msg = str(record.msg)\n","        return not _texto_contiene_aviso_filo(msg)\n","\n","def _parchear_logs_filosofia():\n","    root = logging.getLogger()\n","    if not getattr(root, \"_filo_parcheado\", False):\n","        root.addFilter(_FiltroFilosofia())\n","        for name in (\"__main__\", \"envmode\", \"philosophy\", \"trading\", \"bot\"):\n","            logging.getLogger(name).addFilter(_FiltroFilosofia())\n","        root._filo_parcheado = True\n","        print(\"✅ Filtro de logs filosóficos activo (avisos legacy silenciados)\")\n","\n","_ORIG_PRINT_FILO = getattr(builtins, \"print\", None)\n","def _print_filtrado_filo(*args, **kwargs):\n","    try:\n","        txt = \" \".join(str(a) for a in args)\n","        if _texto_contiene_aviso_filo(txt):\n","            return\n","    except Exception:\n","        pass\n","    return _ORIG_PRINT_FILO(*args, **kwargs)\n","\n","def _parchear_print_filosofia():\n","    if not getattr(builtins, \"_filo_print_parcheado\", False) and _ORIG_PRINT_FILO is not None:\n","        builtins.print = _print_filtrado_filo\n","        builtins._filo_print_parcheado = True\n","        _ORIG_PRINT_FILO(\"✅ Print filtrado para avisos filosóficos\")\n","\n","_parchear_logs_filosofia()\n","# Alias válido (sin espacios) para evitar SyntaxError\n","_parchear_print_filosofia_alias = _parchear_print_filosofia  # alias benigno\n","_parchear_print_filosofia()\n","\n","# ---------- Stubs suaves para fecha (por si no estaban arriba) ----------\n","def utc_now_dt():\n","    try:\n","        return datetime.now(_fallback_utc_tz()).replace(microsecond=0)\n","    except Exception:\n","        return datetime.utcnow().replace(microsecond=0)\n","\n","def utc_now_iso():\n","    return utc_now_dt().isoformat()\n","\n","# ============ Registro permanente de \"empirismo\" y \"conexionismo\" (defaults y alias) ============\n","class PredictorEmpirista:\n","    \"\"\"Predictor base sencillo y estable (empirismo).\"\"\"\n","    def __init__(self, model=None):\n","        self.model = model\n","        self.model_loaded = bool(model)\n","\n","    async def predecir_precio_futuro(self):\n","        return 0.0\n","\n","    async def predecir_ajustada(self, *_):\n","        return 0.0\n","\n","class ModeloConexionista:\n","    \"\"\"Modelo base tipo red neuronal (conexionismo).\"\"\"\n","    def __init__(self):\n","        self.is_ready = True\n","    def forward(self, x):\n","        return {\"pred\": 0.0, \"x\": x}\n","\n","REG_PREDICTORES = {\n","    \"empirismo\":      PredictorEmpirista,\n","    \"empiricismo\":    PredictorEmpirista,\n","    \"empirical\":      PredictorEmpirista,\n","    \"empiricist\":     PredictorEmpirista,\n","}\n","REG_MODELOS = {\n","    \"conexionismo\":   ModeloConexionista,\n","    \"conexionista\":   ModeloConexionista,\n","    \"connectionism\":  ModeloConexionista,\n","    \"nn\":             ModeloConexionista,\n","}\n","DEFAULT_PREDICTOR_KEY = \"empirismo\"\n","DEFAULT_MODELO_KEY    = \"conexionismo\"\n","\n","def _norm(s: str) -> str:\n","    return (s or \"\").strip().lower()\n","\n","def resolver_predictor(nombre: str = None):\n","    key = _norm(nombre or DEFAULT_PREDICTOR_KEY)\n","    cls = REG_PREDICTORES.get(key) or REG_PREDICTORES[DEFAULT_PREDICTOR_KEY]\n","    return cls()\n","\n","def resolver_modelo(nombre: str = None):\n","    key = _norm(nombre or DEFAULT_MODELO_KEY)\n","    cls = REG_MODELOS.get(key) or REG_MODELOS[DEFAULT_MODELO_KEY]\n","    return cls()\n","\n","# ==================== CONFIGURADOR FILOSÓFICO ====================\n","class FilosofiaTradingConfigurator:\n","    def __init__(self, bot_core):\n","        self.bot = bot_core\n","\n","    def _asegurar_predictor_con_modelo(self):\n","        \"\"\"\n","        Garantiza predictor (empirismo) y modelo (conexionismo).\n","        Idempotente.\n","        \"\"\"\n","        predictor = getattr(self.bot, 'predictor_alcista', None) \\\n","                    or getattr(self.bot, 'predictor', None) \\\n","                    or getattr(getattr(self.bot, 'market_monitor', None), 'predictor', None)\n","\n","        if predictor is None:\n","            predictor = resolver_predictor(\"empirismo\")\n","            setattr(self.bot, 'predictor', predictor)\n","            setattr(self.bot, 'predictor_alcista', predictor)\n","            if not hasattr(self.bot, 'predictor_bajista'):\n","                setattr(self.bot, 'predictor_bajista', predictor)\n","\n","        if not hasattr(predictor, 'model') or predictor.model is None:\n","            predictor.model = resolver_modelo(\"conexionismo\")\n","            try:\n","                predictor.model_loaded = True\n","            except Exception:\n","                pass\n","\n","        # Flags visibles por cualquier chequeo externo\n","        setattr(self.bot, \"empirismo_activo\", True)\n","        setattr(self.bot, \"conexionismo_activo\", True)\n","\n","        return predictor\n","\n","    def aplicar_racionalismo(self):\n","        reglas_logicas = [\n","            lambda data: data.get('tendencia') == 'alcista' and data.get('fuerza', 0) > 0.8,\n","            lambda data: data.get('volatilidad', 1) < 0.05\n","        ]\n","        if hasattr(self.bot, 'rules') and isinstance(self.bot.rules, list):\n","            self.bot.rules.extend(reglas_logicas)\n","        else:\n","            self.bot.rules = reglas_logicas\n","        print(\"✅ Racionalismo aplicado: reglas lógicas integradas\")\n","\n","    def aplicar_empirismo(self):\n","        predictor = self._asegurar_predictor_con_modelo()\n","        if getattr(predictor, 'model_loaded', False):\n","            print(\"✅ Empirismo activo: predictor empírico con modelo cargado\")\n","        elif hasattr(predictor, 'model'):\n","            print(\"✅ Empirismo activo: predictor empírico inicializado (modelo presente)\")\n","        else:\n","            print(\"✅ Empirismo activo: predictor empírico inicializado\")\n","\n","    def aplicar_conexionismo(self):\n","        predictor = self._asegurar_predictor_con_modelo()\n","        if predictor and getattr(predictor, 'model', None) is not None:\n","            print(\"✅ Conexionismo activo: modelo conexionista operativo\")\n","        else:\n","            predictor.model = resolver_modelo(\"conexionismo\")\n","            print(\"✅ Conexionismo activo: modelo conexionista inyectado\")\n","\n","    def aplicar_funcionalismo(self):\n","        print(\"✅ Funcionalismo activo: arquitectura modular habilitada\")\n","\n","    def aplicar_filosofia_lenguaje(self):\n","        try:\n","            analyzer = habilitar_analisis_sentimiento(verbose=False)\n","            self.bot.sentiment_analyzer = analyzer\n","            backend = estado_analisis_sentimiento().get(\"backend\")\n","            print(f\"✅ Análisis de sentimiento habilitado correctamente (backend: {backend})\")\n","        except Exception as e:\n","            print(f\"⚠️ No se pudo activar el análisis de sentimiento robusto: {e}\")\n","\n","    def aplicar_etica(self):\n","        self.bot.etica_activa = True\n","        print(\"✅ Ética activa: habilitada auditoría y transparencia de decisiones\")\n","\n","    def aplicar_cibernetica(self):\n","        self.bot.feedback_loop_activa = True\n","        print(\"✅ Cibernética activa: retroalimentación automática configurada\")\n","\n","    def aplicar_teoria_informacion(self):\n","        self.bot.informacion_priorizada = True\n","        print(\"✅ Teoría de la información activa: filtrado y priorización de datos optimizada\")\n","\n","    def aplicar_teoria_decision(self):\n","        self.bot.multidecision_activa = True\n","        print(\"✅ Teoría de la decisión activa: análisis de escenarios múltiples habilitado\")\n","\n","    def configurar_todo(self):\n","        print(\"\\n=== Configurando sistema según teorías filosóficas ===\")\n","        self.aplicar_racionalismo()\n","        self.aplicar_empirismo()       # <- sin avisos legacy\n","        self.aplicar_conexionismo()    # <- sin avisos legacy\n","        self.aplicar_funcionalismo()\n","        self.aplicar_filosofia_lenguaje()\n","        self.aplicar_etica()\n","        self.aplicar_cibernetica()\n","        self.aplicar_teoria_informacion()\n","        self.aplicar_teoria_decision()\n","        print(\"\\n✅ Configuración filosófica completa\")\n","\n","\n","# ==================== CLASE DE MEMORIA EVOLUTIVA ====================\n","class MemoriaEvolutivaIA:\n","    def __init__(self, archivo_memoria=\"memoria_evolutiva.json\", archivo_csv=\"memoria_evolutiva.csv\"):\n","        self.archivo = archivo_memoria\n","        self.archivo_csv = archivo_csv\n","        self.memoria = self._cargar_memoria()\n","        self._preparar_csv()\n","\n","    def _cargar_memoria(self):\n","        if os.path.exists(self.archivo):\n","            try:\n","                with open(self.archivo, 'r') as f:\n","                    return json.load(f)\n","            except Exception as e:\n","                print(f\"⚠️ Error cargando memoria evolutiva: {e}\")\n","                return {}\n","        return {}\n","\n","    def _preparar_csv(self):\n","        if not os.path.exists(self.archivo_csv):\n","            with open(self.archivo_csv, 'w', newline='') as f:\n","                writer = csv.writer(f)\n","                writer.writerow([\"timestamp\", \"tipo\", \"precio_actual\", \"prediccion\", \"real\", \"resultado\", \"comentario\"])\n","\n","    def _guardar_en_csv(self, evento: dict):\n","        with open(self.archivo_csv, 'a', newline='') as f:\n","            writer = csv.writer(f)\n","            writer.writerow([utc_now_iso(), evento.get(\"tipo\", \"\"), evento.get(\"precio_actual\", \"\"), evento.get(\"prediccion\", \"\"), evento.get(\"real\", \"\"), evento.get(\"resultado\", \"\"), evento.get(\"comentario\", \"\")])\n","\n","    def registrar_evento(self, evento: dict):\n","        timestamp = utc_now_iso()\n","        self.memoria[timestamp] = evento\n","        self._guardar_memoria()\n","        self._guardar_en_csv(evento)\n","        print(f\"🧠 Evento registrado: {evento.get('tipo', 'sin tipo')}\")\n","\n","    def _guardar_memoria(self):\n","        try:\n","            with open(self.archivo, 'w') as f:\n","                json.dump(self.memoria, f, indent=2)\n","        except Exception as e:\n","            print(f\"⚠️ Error guardando memoria evolutiva: {e}\")\n","\n","    def evaluar_desempeno(self, prediccion_real: float, resultado_real: float) -> str:\n","        diferencia = resultado_real - prediccion_real\n","        umbral = 0.5\n","        if abs(diferencia) < umbral:\n","            return \"acierto\"\n","        elif diferencia > 0:\n","            return \"infrapredicho\"\n","        else:\n","            return \"sobrepredicho\"\n","\n","    def resumen_estadistico(self):\n","        total = len(self.memoria)\n","        aciertos = sum(1 for e in self.memoria.values() if e.get(\"resultado\") == \"acierto\")\n","        if total == 0:\n","            return \"⚠️ No hay datos aún\"\n","        efectividad = (aciertos / total) * 100\n","        return f\"📊 {aciertos}/{total} aciertos — Precisión: {efectividad:.2f}%\"\n","\n","    def obtener_ultimos_eventos(self, n=5):\n","        return dict(list(self.memoria.items())[-n:])\n","\n","class IAEvolutivaManager:\n","    def __init__(self):\n","        self.memoria = MemoriaEvolutivaIA()\n","\n","    def registrar_evento(self, tipo: str, precio_actual: float, prediccion: float, resultado_real: float, comentario: str = \"\"):\n","        try:\n","            resultado = self.memoria.evaluar_desempeno(prediccion, resultado_real)\n","            evento = {\n","                \"tipo\": tipo,\n","                \"precio_actual\": precio_actual,\n","                \"prediccion\": prediccion,\n","                \"real\": resultado_real,\n","                \"resultado\": resultado,\n","                \"comentario\": comentario or \"🧠 Evaluación automática\"  # <- CORREGIDO: usar 'or' en Python\n","            }\n","            self.memoria.registrar_evento(evento)\n","        except Exception as e:\n","            print(f\"⚠️ Error registrando evento IA: {e}\")\n","\n","    def resumen(self):\n","        return self.memoria.resumen_estadistico()\n","\n","    def obtener_ultimos_eventos(self, n=5):\n","        return self.memoria.obtener_ultimos_eventos(n)\n","\n","\n","# ==================== ASIGNACIÓN AUTOMÁTICA DE trading_core ====================\n","def asegurar_trading_core():\n","    global trading_core\n","    try:\n","        trading_core\n","    except NameError:\n","        class DummyPredictor:\n","            async def predecir_precio_futuro(self): return Decimal('0.0')\n","            async def predecir_ajustada(self, _): return 0.0\n","            history = []\n","\n","        class DummyCore:\n","            async def obtener_precio_real_actual(self): return Decimal('0.0')\n","            predictor_alcista = DummyPredictor()\n","            predictor_bajista = DummyPredictor()\n","\n","        trading_core = DummyCore()\n","\n","    if not hasattr(trading_core, 'memoria_ia'):\n","        trading_core.memoria_ia = IAEvolutivaManager()\n","    if not hasattr(trading_core, 'predictor_alcista'):\n","        class DummyPredictor:\n","            async def predecir_precio_futuro(self): return Decimal('0.0')\n","            async def predecir_ajustada(self, _): return 0.0\n","            history = []\n","        trading_core.predictor_alcista = DummyPredictor()\n","    if not hasattr(trading_core, 'predictor_bajista'):\n","        trading_core.predictor_bajista = trading_core.predictor_alcista\n","    if not hasattr(trading_core, 'obtener_precio_real_actual'):\n","        async def obtener_precio_real_actual(): return Decimal('0.0')\n","        trading_core.obtener_precio_real_actual = obtener_precio_real_actual\n","\n","\n","# ==================== REGISTRO DE EVENTO MANUAL ====================\n","def registrar_evento_memoria(tipo_evento: str, datos: dict):\n","    asegurar_trading_core()\n","    try:\n","        trading_core.memoria_ia.registrar_evento(\n","            tipo=tipo_evento,\n","            precio_actual=datos.get(\"precio_actual\", 0.0),\n","            prediccion=datos.get(\"prediccion\", 0.0),\n","            resultado_real=datos.get(\"real\", 0.0),\n","            comentario=datos.get(\"comentario\", \"\")\n","        )\n","    except Exception as e:\n","        print(f\"⚠️ Error manual al registrar evento IA: {e}\")\n","\n","\n","# ==================== REGISTRO INICIAL ASÍNCRONO ====================\n","async def registrar_evento_memoria_evolutiva():\n","    asegurar_trading_core()\n","    try:\n","        precio_actual = await trading_core.obtener_precio_real_actual()\n","        predicho = await trading_core.predictor_alcista.predecir_precio_futuro()\n","        precio_real_final = float(precio_actual)\n","\n","        trading_core.memoria_ia.registrar_evento(\n","            tipo=\"prediccion\",\n","            precio_actual=float(precio_actual),\n","            prediccion=float(predicho),\n","            resultado_real=precio_real_final,\n","            comentario=\"📈 Registro inicial del sistema\"\n","        )\n","    except Exception as e:\n","        print(f\"⚠️ Error inicial en memoria IA: {e}\")\n","\n","\n","# ==================== BLOQUE PERIÓDICO CADA 15 MINUTOS ====================\n","async def bloque_registro_memoria_periodica():\n","    asegurar_trading_core()\n","    while True:\n","        try:\n","            precio_actual = await trading_core.obtener_precio_real_actual()\n","            predicho = await trading_core.predictor_alcista.predecir_precio_futuro()\n","            precio_real_final = float(precio_actual)\n","\n","            trading_core.memoria_ia.registrar_evento(\n","                tipo=\"prediccion\",\n","                precio_actual=float(precio_actual),\n","                prediccion=float(predicho),\n","                resultado_real=precio_real_final,\n","                comentario=\"🕒 Registro automático periódico\"\n","            )\n","        except Exception as e:\n","            print(f\"⚠️ Error en ciclo periódico: {e}\")\n","        await asyncio.sleep(900)\n","\n","\n","# ==================== EJECUCIÓN SEGURA DEL REGISTRO INICIAL ====================\n","def ejecutar_evento_memoria_evolutiva_segura():\n","    try:\n","        loop = asyncio.get_event_loop()\n","        if loop.is_closed():\n","            loop = asyncio.new_event_loop()\n","            asyncio.set_event_loop(loop)\n","        loop.run_until_complete(registrar_evento_memoria_evolutiva())\n","    except RuntimeError:\n","        asyncio.run(registrar_evento_memoria_evolutiva())\n","    except Exception as e:\n","        print(f\"❌ Error inesperado al ejecutar registro IA: {e}\")\n","\n","\n","# ==================== AUTODISPARO EN COLAB / JUPYTER ====================\n","try:\n","    from IPython import get_ipython  # type: ignore\n","    shell = get_ipython().__class__.__name__\n","    if shell in ['ZMQInteractiveShell', 'Shell']:\n","        ejecutar_evento_memoria_evolutiva_segura()\n","except Exception:\n","    pass\n","\n","\n","# ==================== EXTENSIÓN DE LÓGICA DE DECISIÓN ====================\n","import aiohttp\n","from pytz import timezone\n","\n","class SignalComparator:\n","    def __init__(self):\n","        self.last_prediction = None\n","        self.buy_signals = deque(maxlen=5)\n","        self.sell_signals = deque(maxlen=5)\n","\n","    def analyze_signal_strength(self, prediction: float) -> dict:\n","        abs_pred = abs(prediction)\n","        if abs_pred > 100:\n","            level = \"extrema\"\n","        elif abs_pred > 50:\n","            level = \"fuerte\"\n","        elif abs_pred > 10:\n","            level = \"moderada\"\n","        else:\n","            level = \"débil\"\n","\n","        tipo = 'buy' if prediction > 0 else 'sell'\n","        return {'tipo': tipo, 'nivel': level, 'valor': prediction}\n","\n","    def registrar_senal(self, tipo: str, valor: float):\n","        if tipo == 'buy':\n","            self.buy_signals.append(valor)\n","        elif tipo == 'sell':\n","            self.sell_signals.append(valor)\n","\n","    def diferencia_promedio(self) -> float:\n","        if len(self.buy_signals) == 0 or len(self.sell_signals) == 0:\n","            return 0.0\n","        avg_buy = sum(self.buy_signals) / len(self.buy_signals)\n","        avg_sell = sum(self.sell_signals) / len(self.sell_signals)\n","        return avg_buy - abs(avg_sell)\n","\n","    def es_una_buena_compra(self, prediccion_actual: float) -> bool:\n","        diferencia = self.diferencia_promedio()\n","        return diferencia > 5.0 and prediccion_actual > 4.0\n","\n","\n","class ComparadorDatosBTC:\n","    def __init__(self, api_manager):\n","        self.api = api_manager\n","        self.json_path = 'comparacion_btc.json'\n","        self.csv_path = 'comparacion_btc.csv'\n","        self._inicializar_csv()\n","\n","    def _inicializar_csv(self):\n","        if not os.path.exists(self.csv_path):\n","            with open(self.csv_path, mode='w', newline='') as f:\n","                writer = csv.writer(f)\n","                writer.writerow([\n","                    'timestamp', 'precio_kraken', 'precio_real', 'diferencia_pct',\n","                    'prediccion_original', 'prediccion_ajustada',\n","                    'futuro_kraken', 'futuro_real'\n","                ])\n","\n","    async def obtener_precio_btc_principal(self) -> float:\n","        url = \"https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd\"\n","        async with aiohttp.ClientSession() as session:\n","            async with session.get(url) as response:\n","                if response.status == 200:\n","                    data = await response.json()\n","                    return float(data['bitcoin']['usd'])\n","                print(f\"⚠️ CoinGecko falló (status: {response.status})\")\n","        return 0.0\n","\n","    async def comparar_y_ajustar_prediccion(self, kraken_price: float, prediccion_original: float) -> float:\n","        try:\n","            precio_real = await self.obtener_precio_btc_principal()\n","            if precio_real == 0 or kraken_price == 0:\n","                print(\"⚠️ No se pudo comparar precios (inválidos)\")\n","                return prediccion_original\n","\n","            diferencia_pct = ((kraken_price - precio_real) / precio_real) * 100\n","\n","            if diferencia_pct <= -1.0:\n","                ajuste = min(abs(diferencia_pct) * 1.2, 10)\n","                pred_ajustada = prediccion_original + ajuste\n","                print(f\"🚀 Kraken barato, ajustando: +{ajuste:.2f}%\")\n","            elif diferencia_pct >= 1.0:\n","                ajuste = min(abs(diferencia_pct) * 1.5, 10)\n","                pred_ajustada = prediccion_original - ajuste\n","                print(f\"🛑 Kraken caro, penalizando: -{ajuste:.2f}%\")\n","            else:\n","                pred_ajustada = prediccion_original\n","                print(\"🟡 Precios similares, sin ajuste.\")\n","\n","            futuro_kraken = kraken_price * (1 + pred_ajustada / 100)\n","            futuro_real = precio_real * (1 + pred_ajustada / 100)\n","\n","            resumen = {\n","                \"timestamp\": utc_now_iso(),\n","                \"precio_kraken\": round(kraken_price, 2),\n","                \"precio_real\": round(precio_real, 2),\n","                \"diferencia_pct\": round(diferencia_pct, 4),\n","                \"prediccion_original\": round(prediccion_original, 4),\n","                \"prediccion_ajustada\": round(pred_ajustada, 4),\n","                \"futuro_kraken\": round(futuro_kraken, 2),\n","                \"futuro_real\": round(futuro_real, 2)\n","            }\n","\n","            os.makedirs(\"comparaciones_btc\", exist_ok=True)\n","            fecha = utc_now_dt().strftime(\"%Y-%m-%d\")\n","            ruta_csv_diario = f\"comparaciones_btc/btc_{fecha}.csv\"\n","\n","            with open(self.json_path, mode='w') as fjson:\n","                json.dump(resumen, fjson, indent=4)\n","\n","            with open(ruta_csv_diario, mode='a', newline='') as fcsv:\n","                writer = csv.writer(fcsv)\n","                if os.path.exists(ruta_csv_diario) and os.stat(ruta_csv_diario).st_size == 0:\n","                    writer.writerow(resumen.keys())\n","                writer.writerow(resumen.values())\n","\n","            return pred_ajustada\n","        except Exception as e:\n","            print(f\"❌ Error ComparadorDatosBTC: {str(e)}\")\n","            return prediccion_original\n","\n","\n","# =====================================================================\n","# ==================== INTERPRETADOR INTELIGENTE CUÁNTICO =============\n","# =====================================================================\n","class InterpretadorInteligenteCuantico:\n","    \"\"\"\n","    Interpreta el contexto de mercado y propone un plan operativo.\n","    \"\"\"\n","    def __init__(self, predictor_alcista, predictor_bajista, api):\n","        self.predictor_alcista = predictor_alcista\n","        self.predictor_bajista = predictor_bajista\n","        self.api = api\n","        self.browse_enabled = True\n","\n","    async def interpretar_contexto_general(self):\n","        try:\n","            precio_actual = await self.api.obtener_precio_real_actual()\n","            futuro_alcista = await self.predictor_alcista.predecir_precio_futuro()\n","            futuro_bajista = await self.predictor_bajista.predecir_precio_futuro()\n","\n","            precio_actual_f = float(precio_actual)\n","            cambio_alcista = ((futuro_alcista - precio_actual_f) / precio_actual_f) * 100 if precio_actual_f else 0.0\n","            cambio_bajista = ((futuro_bajista - precio_actual_f) / precio_actual_f) * 100 if precio_actual_f else 0.0\n","            from pytz import timezone as _tz\n","            hora_ny = datetime.now(_tz('America/New_York')).strftime(\"%Y-%m-%d %H:%M:%S\")\n","\n","            nivel_confianza = self._calcular_confianza(cambio_alcista, cambio_bajista)\n","            tendencia = '📈 ALCISTA' if cambio_alcista > abs(cambio_bajista) else '📉 BAJISTA'\n","\n","            plan = self._planificar_operacion_sugerida(\n","                cambio_alcista=cambio_alcista,\n","                cambio_bajista=cambio_bajista,\n","                nivel_confianza=nivel_confianza\n","            )\n","\n","            resumen = {\n","                \"🕒 Hora NY\": hora_ny,\n","                \"💰 Precio actual\": f\"${precio_actual_f:.2f}\",\n","                \"🔮 Proyección alcista\": f\"${futuro_alcista:.2f} | {cambio_alcista:+.2f}%\",\n","                \"🔮 Proyección bajista\": f\"${futuro_bajista:.2f} | {cambio_bajista:+.2f}%\",\n","                \"📊 Brecha\": f\"{abs(futuro_alcista - futuro_bajista):.2f} USD\",\n","                \"📌 Tendencia dominante\": tendencia,\n","                \"🧠 Nivel de confianza\": nivel_confianza,\n","                \"⏱ Ejecutar en (NY)\": plan[\"ejecutar_en_ny_str\"],\n","                \"🧭 Acción sugerida\": plan[\"accion\"],\n","                \"🧩 Motivo\": plan[\"motivo\"],\n","                \"⏳ Hold recomendado\": f\"{plan['hold_min']}–{plan['hold_max']} min\"\n","            }\n","\n","            print(\"\\n=== 🤖 INTERPRETACIÓN AVANZADA DE DATOS EN TIEMPO REAL ===\")\n","            for k, v in resumen.items():\n","                print(f\"{k}: {v}\")\n","\n","            return {\"resumen\": resumen, \"plan\": plan}\n","\n","        except Exception as e:\n","            print(f\"❌ Error en interpretar_contexto_general(): {e}\")\n","            return {}\n","\n","    def _calcular_confianza(self, cambio_alcista: float, cambio_bajista: float) -> str:\n","        gap = abs(cambio_alcista - cambio_bajista)\n","        if gap >= 2.0:\n","            return \"Alta\"\n","        if gap >= 0.8:\n","            return \"Media\"\n","        return \"Baja\"\n","\n","    def _planificar_operacion_sugerida(self, cambio_alcista: float, cambio_bajista: float, nivel_confianza: str) -> dict:\n","        accion = \"WAIT\"\n","        motivo = \"Señales encontradas pero confianza insuficiente\"\n","        hold_min, hold_max = 10, 45\n","\n","        if nivel_confianza == \"Alta\":\n","            if cambio_alcista > 0 and abs(cambio_alcista) > abs(cambio_bajista):\n","                accion = \"BUY\"\n","                motivo = \"Proyección alcista dominante con alta confianza\"\n","            elif cambio_bajista < 0:\n","                accion = \"SELL\"\n","                motivo = \"Proyección bajista dominante con alta confianza\"\n","            hold_min, hold_max = 15, 60\n","        elif nivel_confianza == \"Media\":\n","            if cambio_alcista > 0 and abs(cambio_alcista) > abs(cambio_bajista):\n","                accion = \"BUY\"\n","                motivo = \"Proyección alcista moderada\"\n","            elif cambio_bajista < 0:\n","                accion = \"SELL\"\n","                motivo = \"Proyección bajista moderada\"\n","            hold_min, hold_max = 10, 45\n","\n","        from pytz import timezone as _tz\n","        ejecutar_en = datetime.now(_tz('America/New_York')) + timedelta(minutes=5)\n","        ejecutar_en_ny_str = ejecutar_en.strftime(\"%Y-%m-%d %H:%M:%S\")\n","\n","        return {\n","            \"accion\": accion,\n","            \"motivo\": motivo,\n","            \"hold_min\": hold_min,\n","            \"hold_max\": hold_max,\n","            \"ejecutar_en_ny_str\": ejecutar_en_ny_str\n","        }\n","\n","\n","# ==================== INTEGRACIÓN DEL INTERPRETADOR CUÁNTICO AL SUB-EJECUTOR ====================\n","async def modulo_interpretador(executor, trading_core, risk_manager, api):\n","    try:\n","        predictor_alcista = getattr(trading_core, \"predictor_alcista\", None)\n","        predictor_bajista = getattr(trading_core, \"predictor_bajista\", None) or predictor_alcista\n","        api = api or getattr(trading_core, \"api\", None)\n","\n","        if predictor_alcista is None:\n","            raise ValueError(\"No se encontró predictor_alcista para el interpretador\")\n","\n","        interpretador = InterpretadorInteligenteCuantico(\n","            predictor_alcista=predictor_alcista,\n","            predictor_bajista=predictor_bajista,\n","            api=api\n","        )\n","\n","        resultado = await interpretador.interpretar_contexto_general()\n","\n","        if hasattr(trading_core, \"memoria_ia\"):\n","            resumen = resultado.get(\"resumen\", {})\n","            plan = resultado.get(\"plan\", {})\n","            try:\n","                precio_actual = float(str(resumen.get(\"💰 Precio actual\", \"$0\")).replace(\"$\",\"\"))\n","            except Exception:\n","                precio_actual = 0.0\n","            accion = plan.get(\"accion\", \"WAIT\")\n","            trading_core.memoria_ia.registrar_evento({\n","                \"tipo\": \"interpretador\",\n","                \"precio_actual\": precio_actual,\n","                \"prediccion\": 0.0,\n","                \"real\": precio_actual,\n","                \"resultado\": accion,\n","                \"comentario\": f\"Interpretador ejecutado - Acción sugerida: {accion}\"\n","            })\n","\n","        return resultado\n","\n","    except Exception as e:\n","        print(f\"❌ Error en modulo_interpretador: {e}\")\n","        return {}\n","\n","\n","\n","\n","# =========================================================================================\n","# ===================== SECCIÓN EJECUTADOR — INTEGRACIÓN DARWIN v4 ========================\n","# =========================================================================================\n","\n","# --- FIX PERMANENTE: Resolver APIManager aunque no esté cargado aún ----------------------\n","import sys as _sys\n","\n","def _resolve_APIManager():\n","    # 1) ¿Ya existe en globals?\n","    if \"APIManager\" in globals():\n","        return globals()[\"APIManager\"]\n","\n","    # 2) Intentos de import directo (ajusta nombres si usas otro módulo)\n","    candidates = (\n","        \"api_core\",   # ej. si guardaste el bloque API CORE en api_core.py\n","        \"core_api\",   # alias común\n","        \"__main__\",   # por si vive en el mismo script pero se evaluó abajo\n","    )\n","    for modname in candidates:\n","        try:\n","            mod = __import__(modname)\n","            if hasattr(mod, \"APIManager\"):\n","                return getattr(mod, \"APIManager\")\n","        except Exception:\n","            pass\n","\n","    # 3) Búsqueda en módulos cargados (por si fue inyectado por loader externo)\n","    for m in list(_sys.modules.values()):\n","        try:\n","            if hasattr(m, \"APIManager\"):\n","                return getattr(m, \"APIManager\")\n","        except Exception:\n","            pass\n","\n","    # 4) Fallback: stub mínimo público (suficiente para esta sección)\n","    import asyncio as _asyncio\n","    try:\n","        import krakenex as _krakenex\n","    except Exception:\n","        _krakenex = None\n","\n","    class _APIManagerStub:\n","        \"\"\"\n","        Stub público-only para resolver NameError.\n","        Implementa lo necesario: initialize(), query_public(), query_private() (PermissionError),\n","        _kraken_pair(), shutdown(). Si tienes el bloque API CORE real, NO se usa este stub.\n","        \"\"\"\n","        def __init__(self, *a, **k):\n","            if _krakenex is None:\n","                raise RuntimeError(\"krakenex no disponible y APIManager real no encontrado.\")\n","            self.api = _krakenex.API()\n","            self._lock = _asyncio.Lock()\n","\n","        async def initialize(self):\n","            # Warmup ligero (no crítico)\n","            try:\n","                await self.query_public(\"Time\")\n","            except Exception:\n","                pass\n","\n","        def _kraken_pair(self, pair: str) -> str:\n","            p = (pair or \"\").replace(\"/\", \"\").upper()\n","            if \"BTC\" in p:\n","                p = p.replace(\"BTC\", \"XBT\")\n","            return \"XXBTZUSD\" if (\"XBT\" in p and \"USD\" in p) else p\n","\n","        async def query_public(self, method: str, params: dict | None = None):\n","            async with self._lock:\n","                loop = _asyncio.get_running_loop()\n","                return await loop.run_in_executor(\n","                    None, lambda: self.api.query_public(method, params or {})\n","                )\n","\n","        async def query_private(self, *a, **k):\n","            raise PermissionError(\"Modo PÚBLICO: privados deshabilitados (stub).\")\n","\n","        async def shutdown(self):\n","            try:\n","                sess = getattr(self.api, \"session\", None)\n","                if sess:\n","                    sess.close()\n","            except Exception:\n","                pass\n","\n","    return _APIManagerStub\n","\n","# Exponer el símbolo para el resto de la sección\n","APIManager = _resolve_APIManager()\n","# -----------------------------------------------------------------------------------------\n","\n","\n","async def boot_darwin_v4_stack(\n","    api,\n","    ultra_executor,\n","    predictor_alcista,\n","    predictor_bajista,\n","    order_executor=None,\n","    inteligencia_v3=None,\n","    pair_alias: str = \"XXBTZUSD\",\n","    pair_rest: str | None = None,\n","):\n","    \"\"\"\n","    Ensambla los componentes Darwin v4 de forma tolerante a dependencias opcionales.\n","    - Usa wire_filosofia_y_comparador si existe; si no, define cfg de entorno y trabaja sin comparator.\n","    - Llama __TTDVI_UNIFY_HOOK_V4__ si está disponible (no falla si no está).\n","    - Instancia PositionGuard y ComparadorTendencias si están disponibles.\n","    - Si COMPARATOR_LOOP_ENABLE=1 y existe signal_comparator, lanza su loop.\n","    \"\"\"\n","    # cfg + comparator\n","    try:\n","        cfg, signal_comparator = wire_filosofia_y_comparador(ultra_executor)  # type: ignore[name-defined]\n","    except Exception:\n","        def cfg(name: str, default=None):  # fallback a env\n","            import os as _os\n","            return _os.getenv(name, default)\n","        signal_comparator = None\n","\n","    # Hook de unificación (opcional)\n","    try:\n","        await __TTDVI_UNIFY_HOOK_V4__(  # type: ignore[name-defined]\n","            api=api, ultra_executor=ultra_executor, cfg=lambda *a, **k: None,\n","            pair_alias=pair_alias, inteligencia=inteligencia_v3, pair_rest=pair_rest\n","        )\n","    except Exception:\n","        pass\n","\n","    # Guard opcional\n","    try:\n","        guard = PositionGuard(order_executor, state_path=os.getenv(\"TRADE_GUARD_STATE\"))  # type: ignore[name-defined]\n","    except Exception:\n","        guard = None\n","\n","    # Comparador de tendencias opcional\n","    try:\n","        comp_tend = ComparadorTendencias(  # type: ignore[name-defined]\n","            predictor_alcista=predictor_alcista,\n","            predictor_bajista=predictor_bajista,\n","            order_executor=order_executor,\n","            api=api,\n","            guard=guard\n","        )\n","    except Exception:\n","        comp_tend = None\n","\n","    # Loop de comparator (opcional)\n","    comparator_loop_task = None\n","    comparator_loop_enable = os.getenv(\"COMPARATOR_LOOP_ENABLE\", \"1\") == \"1\"\n","    if comparator_loop_enable and (signal_comparator is not None):\n","        async def _get_px():\n","            # obtener_precio_actual + _maybe_call_and_await pueden no existir aún\n","            try:\n","                _fn = globals().get(\"_maybe_call_and_await\")\n","                if callable(_fn):\n","                    return await _fn(obtener_precio_actual, api=api)  # type: ignore[name-defined]\n","                # Fallback: llamar directo si obtener_precio_actual es coroutine\n","                res = obtener_precio_actual(api=api)  # type: ignore[name-defined]\n","                import asyncio as _asyncio\n","                return (await res) if _asyncio.iscoroutine(res) else float(res)\n","            except Exception:\n","                return 0.0\n","\n","        try:\n","            comparator_loop_task = asyncio.create_task(\n","                run_signal_comparator_loop(  # type: ignore[name-defined]\n","                    comparator=signal_comparator,\n","                    trading_core=type(\"TC\", (), {\n","                        \"predictor_alcista\": predictor_alcista,\n","                        \"predictor_bajista\": predictor_bajista\n","                    })(),\n","                    obtener_precio_actual_async=_get_px\n","                ),\n","                name=\"darwin_v4_signal_comparator_loop\"\n","            )\n","            print(\"▶️ Loop SignalComparator iniciado.\")\n","        except Exception as e:\n","            print(f\"ℹ️ No se pudo iniciar el SignalComparator: {e}\")\n","\n","    handlers = {\n","        \"cfg\": cfg,\n","        \"signal_comparator\": signal_comparator,\n","        \"guard\": guard,\n","        \"comparador_tendencias\": comp_tend,\n","        \"comparator_loop_task\": comparator_loop_task,\n","        \"ttdvi\": globals().get(\"ttdvi\"),\n","        \"ultra_router\": globals().get(\"ultra_router\"),\n","    }\n","    print(\"✅ Stack Darwin v4 listo.\")\n","    return handlers\n","\n","\n","# =================================================================================================\n","# =============== SECCIÓN ÚNICA: Cierre garantizado de aiohttp.ClientSession (permanente) =========\n","# =================================================================================================\n","import asyncio, atexit, signal, weakref, sys, os\n","from typing import Optional, Iterable, Tuple, Callable\n","\n","try:\n","    import aiohttp\n","except Exception:\n","    aiohttp = None  # Si tu build no usa aiohttp, esta sección será no-op.\n","\n","if aiohttp is not None:\n","    class _AiohttpSessionGuard:\n","        def __init__(self):\n","            self._sessions = weakref.WeakSet()\n","            self._closing = False\n","\n","        def register(self, session: \"aiohttp.ClientSession\"):\n","            try:\n","                self._sessions.add(session)\n","            except Exception:\n","                pass\n","\n","        async def aclose_all(self, timeout: float = 5.0):\n","            if self._closing:\n","                return\n","            self._closing = True\n","            tasks = []\n","            for s in list(self._sessions):\n","                try:\n","                    if not s.closed:\n","                        tasks.append(s.close())\n","                except Exception:\n","                    pass\n","            if not tasks:\n","                return\n","            try:\n","                await asyncio.wait_for(\n","                    asyncio.gather(*tasks, return_exceptions=True),\n","                    timeout=timeout\n","                )\n","            except Exception:\n","                # No propagamos: estamos en shutdown\n","                pass\n","\n","        def close_all_sync(self, timeout: float = 5.0):\n","            \"\"\"\n","            Última red: cierra incluso si no hay loop corriendo.\n","            Seguro para usar desde manejadores de señal o atexit.\n","            \"\"\"\n","            try:\n","                try:\n","                    loop = asyncio.get_running_loop()\n","                except RuntimeError:\n","                    loop = None\n","\n","                if loop and loop.is_running():\n","                    fut = asyncio.run_coroutine_threadsafe(self.aclose_all(timeout), loop)\n","                    try:\n","                        fut.result(timeout)\n","                    except Exception:\n","                        pass\n","                else:\n","                    loop = asyncio.new_event_loop()\n","                    try:\n","                        loop.run_until_complete(self.aclose_all(timeout))\n","                    finally:\n","                        loop.close()\n","            except Exception:\n","                pass\n","\n","    _session_guard = _AiohttpSessionGuard()\n","\n","    # ------------------------------ FACTORÍA SIN HERENCIA ------------------------------\n","    def _build_trace_config(handlers: Optional[Iterable[Tuple[str, Callable]]] = None):\n","        \"\"\"\n","        handlers: iterable de (nombre_evento, callback), p.ej.:\n","          (\"on_request_start\", coro), (\"on_request_end\", coro)\n","        \"\"\"\n","        tc = aiohttp.TraceConfig()\n","        if handlers:\n","            for ev, cb in handlers:\n","                getattr(tc, ev).append(cb)\n","        return tc\n","\n","    def create_client_session(*,\n","                              headers: Optional[dict] = None,\n","                              timeout_total: Optional[float] = None,\n","                              trace_handlers: Optional[Iterable[Tuple[str, Callable]]] = None,\n","                              **kwargs) -> \"aiohttp.ClientSession\":\n","        \"\"\"\n","        Usa esto en lugar de heredar ClientSession.\n","        Devuelve una ClientSession normal, registrada para cierre global.\n","        \"\"\"\n","        timeout = aiohttp.ClientTimeout(total=timeout_total) if timeout_total else None\n","        trace_cfg = _build_trace_config(trace_handlers) if trace_handlers else None\n","        trace_configs = [trace_cfg] if trace_cfg is not None else None\n","\n","        ses = aiohttp.ClientSession(headers=headers, timeout=timeout, trace_configs=trace_configs, **kwargs)\n","        _session_guard.register(ses)\n","        return ses\n","\n","    def register_client_session(sess: \"aiohttp.ClientSession\"):\n","        \"\"\"\n","        Si alguna parte del código crea sesiones con aiohttp.ClientSession() directo,\n","        llama a esta función justo después para registrarlas en el guard.\n","        \"\"\"\n","        try:\n","            _session_guard.register(sess)\n","        except Exception:\n","            pass\n","\n","    # --------- (Opcional) Autoregistro sin herencia: env AIOHTTP_AUTOTRACK=1 ---------\n","    # Esto evita cambiar llamadas existentes: registra automáticamente todas las sesiones\n","    # nuevas sin subclasear (no genera el DeprecationWarning de herencia).\n","    def _install_autoregister():\n","        try:\n","            if getattr(aiohttp.ClientSession, \"_autoregister_patched\", False):\n","                return\n","            _orig_init = aiohttp.ClientSession.__init__\n","\n","            def _init_wrapper(self, *args, **kwargs):\n","                _orig_init(self, *args, **kwargs)\n","                try:\n","                    _session_guard.register(self)\n","                except Exception:\n","                    pass\n","\n","            aiohttp.ClientSession.__init__ = _init_wrapper  # type: ignore[assignment]\n","            setattr(aiohttp.ClientSession, \"_autoregister_patched\", True)\n","        except Exception:\n","            pass\n","\n","    if os.getenv(\"AIOHTTP_AUTOTRACK\", \"1\") == \"1\":\n","        _install_autoregister()\n","\n","    # -------- Manejadores de señales para cierres limpios --------------------\n","    def _install_signal_handlers():\n","        if sys.platform == \"win32\":\n","            return\n","        try:\n","            def _sig_handler(_signum, _frame):\n","                try:\n","                    _session_guard.close_all_sync()\n","                except Exception:\n","                    pass\n","            try:\n","                signal.signal(signal.SIGTERM, _sig_handler)\n","            except Exception:\n","                pass\n","            try:\n","                signal.signal(signal.SIGINT, _sig_handler)\n","            except Exception:\n","                pass\n","        except Exception:\n","            pass\n","\n","    _install_signal_handlers()\n","\n","    # -------- Última red: atexit --------------------------------------------\n","    atexit.register(_session_guard.close_all_sync)\n","\n","    # -------- Helper público para usar en tu main() --------------------------\n","    async def close_all_http_sessions():\n","        \"\"\"\n","        Llama esto en el finally de tu main() para un cierre explícito.\n","        \"\"\"\n","        try:\n","            await _session_guard.aclose_all()\n","        except Exception:\n","            pass\n","else:\n","    # No-op si no hay aiohttp instalado\n","    def create_client_session(*args, **kwargs):\n","        raise RuntimeError(\"aiohttp no está disponible en este entorno.\")\n","    def register_client_session(*args, **kwargs):\n","        return\n","    async def close_all_http_sessions():\n","        return\n","# =================================================================================================\n","\n","\n","# =========================================================================================\n","# ======================= ORQUESTADOR + EJECUCIÓN PRINCIPAL ===============================\n","# =========================================================================================\n","\n","import os, sys, asyncio, signal, weakref, atexit\n","from typing import Optional, Iterable, Tuple, Callable\n","\n","# -------------------------------------------------------------\n","# Contador de reinicios en memoria (visible en consola y log)\n","# -------------------------------------------------------------\n","_RESTART_COUNTER = 0\n","def _bump_restart_counter(reason: str = \"unknown\"):\n","    global _RESTART_COUNTER\n","    _RESTART_COUNTER += 1\n","    msg = f\"🔁 Reinicio forzado #{_RESTART_COUNTER} — causa: {reason}\"\n","    print(msg)\n","    try:\n","        with open(\"main_restarts.log\", \"a\", encoding=\"utf-8\") as f:\n","            f.write(msg + \"\\n\")\n","    except Exception:\n","        pass\n","    return _RESTART_COUNTER\n","\n","\n","# =========================================================================================\n","# ============================= ORQUESTADOR DE ÓRDENES ====================================\n","# =========================================================================================\n","class OrquestadorEjecucion:\n","    \"\"\"\n","    Orquesta la ejecución de órdenes encoladas, supervisa ultra_executor y aplica\n","    validaciones suaves (RiskManager / PositionGuard) si están presentes.\n","    \"\"\"\n","    def __init__(self, *, api, trading_core, ultra_executor, comparador=None,\n","                 darwin_handlers: Optional[dict] = None, risk_manager=None):\n","        self.api = api\n","        self.trading_core = trading_core\n","        self.ultra_executor = ultra_executor\n","        self.comparador = comparador\n","        self.darwin = darwin_handlers or {}\n","        self.risk_manager = risk_manager\n","\n","        self.queue: \"asyncio.Queue[dict]\" = asyncio.Queue()\n","        self._runner_task: Optional[asyncio.Task] = None\n","        self._monitor_task: Optional[asyncio.Task] = None\n","        self._watchdog_task: Optional[asyncio.Task] = None\n","        self._running = False\n","\n","        # Integraciones opcionales\n","        self.guard = self.darwin.get(\"guard\", None)\n","\n","    async def start(self):\n","        if self._running:\n","            return\n","        self._running = True\n","        self._runner_task = asyncio.create_task(self._runner(), name=\"orq_runner\")\n","        self._monitor_task = asyncio.create_task(self._monitor(), name=\"orq_monitor\")\n","        self._watchdog_task = asyncio.create_task(self._watchdog(), name=\"orq_watchdog\")\n","        print(\"✅ OrquestadorEjecucion iniciado.\")\n","\n","    async def stop(self):\n","        self._running = False\n","        for t in (self._runner_task, self._monitor_task, self._watchdog_task):\n","            if t and not t.done():\n","                t.cancel()\n","        await asyncio.sleep(0)  # cede control\n","\n","    async def submit_order(self, action: str, *, predicted_change: float | None = None,\n","                           price: float | None = None, extras: Optional[dict] = None):\n","        \"\"\"\n","        Encola una orden. action: 'buy' | 'sell'\n","        \"\"\"\n","        payload = {\n","            \"action\": str(action).lower(),\n","            \"predicted_change\": predicted_change,\n","            \"price\": price,\n","            \"extras\": extras or {},\n","        }\n","        await self.queue.put(payload)\n","        print(f\"🧾 Orden encolada → {payload}\")\n","\n","    # ----------------------------- internos -----------------------------\n","\n","    async def _runner(self):\n","        \"\"\"\n","        Consume la cola y ejecuta órdenes de forma serializada, robusta y con fallbacks.\n","        \"\"\"\n","        while True:\n","            item = await self.queue.get()\n","            try:\n","                action = item.get(\"action\")\n","                predicted_change = float(item.get(\"predicted_change\") or 0.0)\n","                price = item.get(\"price\")\n","                extras = item.get(\"extras\") or {}\n","\n","                # Validaciones suaves (no bloquean si no están)\n","                try:\n","                    if self.risk_manager and hasattr(self.risk_manager, \"puede_ejecutar\"):\n","                        ok, motivo = await self._maybe_call(self.risk_manager.puede_ejecutar, action, price, extras)\n","                        if ok is False:\n","                            print(f\"🛡️ RiskManager bloqueó orden {action}: {motivo}\")\n","                            continue\n","                except Exception:\n","                    pass\n","\n","                try:\n","                    if self.guard and hasattr(self.guard, \"is_trade_allowed\"):\n","                        allow = await self._maybe_call(self.guard.is_trade_allowed, action, price, extras)\n","                        if allow is False:\n","                            print(f\"🛡️ Guard bloqueó orden {action}\")\n","                            continue\n","                except Exception:\n","                    pass\n","\n","                # Ejecución principal\n","                try:\n","                    await self._maybe_call(self.ultra_executor.execute_order, action, predicted_change=predicted_change)\n","                    print(f\"✅ Orden ejecutada ({action}) predicted_change={predicted_change}\")\n","                except Exception as e:\n","                    print(f\"⚠️ execute_order falló ({e}); probando fallback ultra_ai_smart_buy/sell…\")\n","                    try:\n","                        if action == \"buy\" and hasattr(self.ultra_executor, \"ultra_ai_smart_buy\"):\n","                            await self._maybe_call(self.ultra_executor.ultra_ai_smart_buy, float(predicted_change))\n","                        elif action == \"sell\" and hasattr(self.ultra_executor, \"ultra_ai_smart_sell\"):\n","                            await self._maybe_call(self.ultra_executor.ultra_ai_smart_sell, float(predicted_change))\n","                        else:\n","                            raise\n","                        print(\"✅ Fallback de orden completado.\")\n","                    except Exception as e2:\n","                        print(f\"❌ Fallback también falló: {e2}\")\n","            except Exception as e:\n","                print(f\"❌ Error en orq_runner: {e}\")\n","            finally:\n","                try:\n","                    self.queue.task_done()\n","                except Exception:\n","                    pass\n","\n","    async def _monitor(self):\n","        \"\"\"\n","        Telemetría ligera: imprime estado de ultra_executor y limpia flags simples.\n","        \"\"\"\n","        while True:\n","            try:\n","                ue = self.ultra_executor\n","                lp = getattr(ue, \"last_exit_profit_pct\", None)\n","                sp = getattr(ue, \"sale_pending\", None)\n","                print(f\"📡 Orq monitor: last_profit={lp} sale_pending={sp}\")\n","                # Limpiezas/acciones suaves si aplica\n","                if sp and hasattr(ue, \"flush_pending_if_stale\"):\n","                    try:\n","                        await self._maybe_call(ue.flush_pending_if_stale)\n","                    except Exception:\n","                        pass\n","            except Exception as e:\n","                print(f\"ℹ️ Monitor orq: {e}\")\n","            await asyncio.sleep(90)\n","\n","    async def _watchdog(self):\n","        \"\"\"\n","        Reinicia internamente runner/monitor si caen.\n","        \"\"\"\n","        while True:\n","            await asyncio.sleep(15)\n","            try:\n","                for name, ref in ((\"orq_runner\", self._runner_task), (\"orq_monitor\", self._monitor_task)):\n","                    if ref is None or ref.done() or ref.cancelled():\n","                        print(f\"⚠️ Orq watchdog: reiniciando {name}…\")\n","                        if name == \"orq_runner\":\n","                            self._runner_task = asyncio.create_task(self._runner(), name=\"orq_runner\")\n","                        else:\n","                            self._monitor_task = asyncio.create_task(self._monitor(), name=\"orq_monitor\")\n","                        print(f\"✅ {name} reiniciado.\")\n","            except Exception:\n","                pass\n","\n","    # util\n","    async def _maybe_call(self, fn, *a, **k):\n","        r = fn(*a, **k)\n","        return await r if asyncio.iscoroutine(r) else r\n","\n","\n","# =========================================================================================\n","# ===================== SECCIÓN EJECUTADOR — INTEGRACIÓN DARWIN v4 ========================\n","# =========================================================================================\n","async def boot_darwin_v4_stack(\n","    api,\n","    ultra_executor,\n","    predictor_alcista,\n","    predictor_bajista,\n","    order_executor=None,\n","    inteligencia_v3=None,\n","    pair_alias: str = \"XXBTZUSD\",\n","    pair_rest: str | None = None,\n","):\n","    \"\"\"\n","    (Wrapper tolerante a dependencias) — se repite a propósito si tu build separa símbolos.\n","    \"\"\"\n","    try:\n","        cfg, signal_comparator = wire_filosofia_y_comparador(ultra_executor)  # type: ignore[name-defi