.modules[\"pandas_ta\"] = mod\n","    _pta_ensure_accessor_bindings(mod)\n","\n","def _pta_pip_install(spec: str, intentos: int = 2):\n","    ultimo = None\n","    for i in range(1, intentos+1):\n","        try:\n","            print(f\"📦 Instalando: {spec}  (intento {i}/{intentos})\")\n","            subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"--upgrade\", \"--prefer-binary\", spec])\n","            return True\n","        except Exception as e:\n","            ultimo = e\n","            espera = min(8, 2**i)\n","            print(f\"⚠️  Falló '{spec}' (intento {i}). Reintentando en {espera}s…\")\n","            time.sleep(espera)\n","    if ultimo: print(f\"⚠️ Falló '{spec}': {ultimo}\")\n","    return False\n","\n","def _pta_install_with_fallbacks():\n","    candidates = [\n","        \"pandas_ta==0.3.14b0\",\n","        \"pandas-ta==0.3.14b0\",\n","        \"pandas_ta>=0.3.14b0\",\n","        \"pandas-ta>=0.3.14b0\",\n","        \"git+https://github.com/twopirllc/pandas-ta.git@development\",\n","        \"git+https://github.com/twopirllc/pandas-ta.git\",\n","    ]\n","    for spec in candidates:\n","        if _pta_pip_install(spec, intentos=2):\n","            try:\n","                import pandas_ta as _ta  # noqa: F401\n","                print(f\"✅ pandas_ta instalado ({spec})\")\n","                return True\n","            except Exception:\n","                pass\n","    return False\n","\n","def ensure_pandas_ta_available():\n","    mode = os.getenv(\"PANDAS_TA_MODE\", \"auto\").strip().lower()\n","    try:\n","        import pandas_ta as _ta  # noqa: F401\n","        _pta_ensure_accessor_bindings(_ta)\n","        print(f\"✅ pandas_ta disponible (versión: {getattr(_ta, '__version__', 'desconocida')}) [nativo]\")\n","        return \"native\"\n","    except Exception as e:\n","        print(f\"ℹ️ pandas_ta no disponible al importar: {e}\")\n","    if mode in (\"pip_only\", \"pip_first\"):\n","        if _pta_install_with_fal