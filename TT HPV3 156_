       time.sleep(espera)\n","    if ultimo_error:\n","        raise ultimo_error\n","\n","def _elegir_candidatos_tf():\n","    py = sys.version_info\n","    if (py.major, py.minor) >= (3, 12):\n","        return [\n","            \"tensorflow==2.17.1\",\"tensorflow==2.17.0\",\"tensorflow==2.16.2\",\n","            \"tensorflow-cpu==2.17.1\",\"tensorflow-cpu==2.17.0\",\"tensorflow-cpu==2.16.2\",\n","        ], \">=2.16\"\n","    else:\n","        return [\"tensorflow==2.15.0\",\"tensorflow-cpu==2.15.0\"], \"==2.15\"\n","\n","def _instalar_tensorflow_compatible():\n","    candidatos, nota = _elegir_candidatos_tf()\n","    ultimo_error = None\n","    for spec in candidatos:\n","        try:\n","            _pip_install_general(spec, intentos=2)\n","            tf_mod = importlib.import_module(\"tensorflow\")\n","            v = getattr(tf_mod, \"__version__\", \"\")\n","            print(f\"✅ TensorFlow instalado: {v} (spec {spec})\")\n","            return v\n","        except Exception as e:\n","            ultimo_error = e\n","            print(f\"❌ No se pudo instalar {spec}: {e}\")\n","    raise RuntimeError(f\"No se pudo instalar TensorFlow {nota}. Si necesitas TF 2.15, usa Python 3.11 en un venv.\")\n","\n","def _instalar_qiskit_compatible():\n","    py = sys.version_info\n","    if (py.major, py.minor) <= (3, 11):\n","        try:\n","            print(\"🔎 Intentando tus pines Qiskit (compat Py<=3.11)...\")\n","            _pip_install_general(\"qiskit==0.45.0\", intentos=2)\n","            _pip_install_general(\"qiskit-aer==0.12.2\", intentos=2)\n","            return \"0.45.x\"\n","        except Exception as e:\n","            print(f\"⚠️ Pines Qiskit 0.45.x fallaron: {e}. Probando rama moderna...\")\n","    try:\n","        print(\"🆙 Instalando Qiskit moderno (Terra 1.x + Aer >=0.14)...\")\n","        _pip_install_general(\"qiskit>=1.0,<2\", intentos=2)\n","        _pip_install_general(\"qiskit-aer>=0.14,<1\", intentos=2)\n","        try:\n","            _pip_install_general(\"qiskit-machine-learning>=0.7,<1\", intentos=1)\n","        except Exception as e:\n","            print(f\"ℹ️ qiskit-machine-learning opcional no instalado: {e}\")\n","        return \"1.x\"\n","    except Exception as e:\n","        print(f\"🚨 No se pudo instalar Qiskit moderno: {e}\")\n","        print(\"↪️ Activando shims para continuar sin bloqueo...\")\n","        _inject_qiskit_shims()\n","        return \"shim\"\n","\n","def instalar_dependencias():\n","    print(\"🔧 Instalando dependencias controladas...\")\n","    tf_version = _instalar_tensorflow_compatible()\n","    saltar = {\"tensorflow\",\"tensorflow-cpu\",\"keras\",\"ml-dtypes\",\"qiskit\",\"qiskit-aer\",\"qiskit-machine-learning\",\"pandas_ta\"}\n","    restantes = []\n","    for nombre, version in (DEPENDENCIAS or {}).items():\n","        key = nombre.lower().strip()\n","        if key in saltar: continue\n","        spec = f\"{nombre}=={version}\" if version else nombre\n","        restantes.append(spec)\n","    try:\n","        subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"--upgrade\", \"pip\", \"setuptools\", \"wheel\"])\n","    except Exception as e:\n","        print(f\"⚠️ No se pudo actualizar pip/setuptools/wheel: {e}\")\n","    for spec in restantes:\n","        try:\n","            _pip_install_general(spec, intentos=2)\n","            print(f\"✅ {spec} instalado\")\n","        except Exception as e:\n","            print(f\"⚠️ No se pudo instalar {spec}: {e}\")\n","    if tf_version.startswith(\"2.15.\"):\n","        try: _pip_install_general(\"keras==2.15.0\", intentos=2)\n","        except Exception as e: print(f\"⚠️ Aviso: keras==2.15.0 no se instaló: {e}\")\n","        try: _pip_install_general(\"ml-dtypes==0.3.2\", intentos=1)\n","        except Exception as e: print(f\"ℹ️ ml-dtypes opcional no instalado: {e}\")\n","    else:\n","        print(\"ℹ️ TF>=2.16 detectado: Keras 3 va incluido; no se instala aparte.\")\n","    qiskit_branch = _instalar_qiskit_compatible()\n","    pta_status = ensure_pandas_ta_available()  # <— YA ESTÁ DEFINIDA ARRIBA\n","    if sys.platform.startswith(\"linux\"):\n","        try:\n","            subprocess.check_call(['sudo', 'apt-get', 'install', '-y', 'python3-dev', 'build-essential'])\n","        except Exception:\n","            pass\n","    import tensorflow as tf_check\n","    print(f\"🎉 Dependencias listas. TensorFlow: {tf_check.__version__} | Qiskit: {qiskit_branch} | pandas_ta: {pta_status}\")\n","\n","# ---------- Ejecuta instalador ----------\n","instalar_dependencias()\n","\n","# ---------- Instalar/validar Transformers sin recursión ----------\n","try:\n","    v_tfm = instalar_transformers_robusto()\n","    print(f\"🔗 Transformers listo: {v_tfm}\")\n","except Exception as e:\n","    print(f\"🚨 Transformers no disponible: {e}\")\n","\n","# ==================== NORMALIZACIÓN DE QISKIT (execute/marginal_counts) ====================\n","def _inject_qiskit_shims():\n","    print(\"🛡️ Inyectando shims mínimos de Qiskit (modo offline/compat) ...\")\n","    qiskit_mod = _types.ModuleType(\"qiskit\")\n","    result_mod = _types.ModuleType(\"qiskit.result\")\n","\n","    def marginal_counts(counts, indices):\n","        out = {}\n","        if hasattr(counts, \"get_counts\"):\n","            counts = counts.get_counts()\n","        for b, n in (counts or {}).items():\n","            s = b if isinstance(b, str) else \"\".join(map(str, b))\n","            kept = \"\".join(s[i] for i in indices)\n","            out[kept] = out.get(kept, 0) + int(n)\n","        return out\n","    result_mod.marginal_counts = marginal_counts  # type: ignore\n","\n","    class _QC:\n","        def __init__(self, n_qubits, name=None):\n","            self.num_qubits = int(n_qubits)\n","            self.name = name or \"qc\"\n","            self.ops = []\n","            self._measures = []\n","        def rx(self, theta, q): self.ops.append((\"rx\", float(theta), q))\n","        def ry(self, theta, q): self.ops.append((\"ry\", float(theta), q))\n","        def rz(self, theta, q): self.ops.append((\"rz\", float(theta), q))\n","        def cx(self, c, t): self.ops.append((\"cx\", c, t))\n","        def measure_all(self): self._measures = list(range(self.num_qubits))\n","        def bind_parameters(self, p): return self\n","        assign_parameters = bind_parameters\n","\n","    class _SimResult:\n","        def __init__(self, counts): self._counts = counts\n","        def get_counts(self): return self._counts\n","\n","    class _SimJob:\n","        def __init__(self, result): self._res = result\n","        def result(self): return self._res\n","\n","    class _AerBackend:\n","        def __init__(self, name=\"aer_simulator\"): self.name = name\n","        def run(self, circ, shots=1024, **kwargs):\n","            import random as _rnd\n","            _rnd.seed((len(getattr(circ, \"ops\", [])), getattr(circ, \"num_qubits\", 1), shots))\n","            counts = {}\n","            for _ in range(int(shots) if shots else 1024):\n","                bitstr = \"\".join(\"1\" if _rnd.random() < 0.5 else \"0\" for _ in range(getattr(circ, \"num_qubits\", 1)))\n","                counts[bitstr] = counts.get(bitstr, 0) + 1\n","            return _SimJob(_SimResult(counts))\n","\n","    class _AerCls:\n","        @staticmethod\n","        def get_backend(name):\n","            return _AerBackend(name)\n","\n","    def _execute(circuits, backend=None, shots=1024, **run_kwargs):\n","        backend = backend or _AerCls.get_backend(\"aer_simulator\")\n","        return backend.run(circuits, shots=shots, **run_kwargs)\n","\n","    qiskit_mod.QuantumCircuit = _QC  # type: ignore\n","    qiskit_mod.execute = _execute  # type: ignore\n","    qiskit_mod.result = result_mod  # type: ignore\n","\n","    aer_mod = _types.ModuleType(\"qiskit_aer\")\n","    aer_mod.Aer = _AerCls  # type: ignore\n","\n","    sys.modules[\"qiskit\"] = qiskit_mod\n","    sys.modules[\"qiskit.result\"] = result_mod\n","    sys.modules[\"qiskit_aer\"] = aer_mod\n","\n","def _ensure_qiskit_execute_and_marginal():\n","    try:\n","        import qiskit as _q\n","        try:\n","            from qiskit.result import marginal_counts as _mc\n","        except Exception:\n","            try:\n","                from qiskit.result.utils import marginal_counts as _mc\n","                if not hasattr(_q, \"result\"):\n","                    _q.result = _types.ModuleType(\"qiskit.result\")  # type: ignore\n","                setattr(_q.result, \"marginal_counts\", _mc)\n","            except Exception:\n","                pass\n","        if not hasattr(_q, \"execute\"):\n","            try:\n","                from qiskit.execute_function import execute as _exe  # Terra >=1.0\n","                setattr(_q, \"execute\", _exe)\n","            except Exception:\n","                def _compat_execute(circuits, backend=None, **run_kwargs):\n","                    try:\n","                        from qiskit_aer import Aer as _Aer\n","                        backend = backend or _Aer.get_backend(\"aer_simulator\")\n","                    except Exception:\n","                        raise RuntimeError(\"No hay backend para ejecutar el circuito.\")\n","                    try:\n","                        from qiskit import transpile\n","                        circ_t = transpile(circuits, backend)\n","                        return backend.run(circ_t, **run_kwargs)\n","                    except Exception:\n","                        return backend.run(circuits, **run_kwargs)\n","                setattr(_q, \"execute\", _compat_execute)\n","    except Exception:\n","        _inject_qiskit_shims()\n","_ensure_qiskit_execute_and_marginal()\n","\n","from qiskit import QuantumCircuit, execute\n","from qiskit_aer import Aer\n","try:\n","    from qiskit.result import marginal_counts\n","except Exception:\n","    from qiskit.result.utils import marginal_counts\n","\n","def _ensure_qiskit_compat():\n","    try:\n","        import qiskit as _q\n","    except Exception:\n","        qiskit_mod = _types.ModuleType(\"qiskit\")\n","        result_mod = _types.ModuleType(\"qiskit.result\")\n","        def _marginal_counts(counts, indices):\n","            out = {}\n","            for bitstr, n in (counts or {}).items():\n","                s = bitstr if isinstance(bitstr, str) else \"\".join(map(str, bitstr))\n","                kept = \"\".join(s[i] for i in indices)\n","                out[kept] = out.get(kept, 0) + int(n)\n","            return out\n","        result_mod.marginal_counts = _marginal_counts\n","        def _execute(circuits, backend=None, shots=1024, **run_kwargs):\n","            return backend.run(circuits, shots=shots, **run_kwargs)\n","        qiskit_mod.execute = _execute\n","        qiskit_mod.result = result_mod\n","        sys.modules[\"qiskit\"] = qiskit_mod\n","        sys.modules[\"qiskit.result\"] = result_mod\n","    try:\n","        import qiskit as _q\n","        try:\n","            from qiskit.result import marginal_counts as _mc\n","        except Exception:\n","            try:\n","                from qiskit.result.utils import marginal_counts as _mc\n","                if not hasattr(_q, \"result\"):\n","                    _q.result = _types.ModuleType(\"qiskit.result\")\n","                setattr(_q.result, \"marginal_counts\", _mc)\n","            except Exception:\n","                result_mod = getattr(_q, \"result\", _types.ModuleType(\"qiskit.result\"))\n","                def _marginal_counts(counts, indices):\n","                    out = {}\n","                    for bitstr, n in (counts or {}).items():\n","                        s = bitstr if isinstance(bitstr, str) else \"\".join(map(str, bitstr))\n","                        kept = \"\".join(s[i] for i in indices)\n","                        out[kept] = out.get(kept, 0) + int(n)\n","                    return out\n","                result_mod.marginal_counts = _marginal_counts\n","                _q.result = result_mod\n","        if not hasattr(_q, \"execute\"):\n","            try:\n","                from qiskit.execute_function import execute as _exe\n","                setattr(_q, \"execute\", _exe)\n","            except Exception:\n","                def _compat_execute(circuits, backend=None, **run_kwargs):\n","                    try:\n","                        from qiskit_aer import Aer as _Aer\n","                        backend = backend or _Aer.get_backend(\"aer_simulator\")\n","                    except Exception:\n","                        raise RuntimeError(\"No hay backend disponible para ejecutar el circuito.\")\n","                    try:\n","                        from qiskit import transpile\n","                        circ_t = transpile(circuits, backend)\n","                        return backend.run(circ_t, **run_kwargs)\n","                    except Exception:\n","                        return backend.run(circuits, **run_kwargs)\n","                setattr(_q, \"execute\", _compat_execute)\n","    except Exception:\n","        pass\n","_ensure_qiskit_compat()\n","\n","def _get_backend(backend_name: str = \"aer_simulator\"):\n","    try:\n","        from qiskit_aer import Aer as _Aer\n","        return _Aer.get_backend(backend_name)\n","    except Exception:\n","        class _LocalDummyBackend:\n","            name = \"local_dummy_backend\"\n","            def run(self, circuit, shots=1024, **_):\n","                import numpy as _np\n","                n = getattr(circuit, \"num_qubits\", 1)\n","                counts = {}\n","                for _ in range(int(shots) if shots else 1024):\n","                    bitstr = \"\".join(\"1\" if _np.random.rand() < 0.5 else \"0\" for _ in range(n))\n","                    counts[bitstr] = counts.get(bitstr, 0) + 1\n","                class _Res:\n","                    def __init__(self, c): self._c = c\n","                    def result(self): return self\n","                    def get_counts(self): return self._c\n","                return _Res(counts)\n","        return _LocalDummyBackend()\n","\n","def _marginal_prob_one(counts, qubit_index: int, n_qubits: int, shots: int) -> float:\n","    try:\n","        from qiskit.result import marginal_counts\n","        mc = marginal_counts(counts, [qubit_index])\n","        return float(mc.get(\"1\", 0)) / float(shots)\n","    except Exception:\n","        total_ones = 0; pos = qubit_index\n","        for bitstr, n in (counts or {}).items():\n","            s = bitstr if isinstance(bitstr, str) else \"\".join(map(str, bitstr))\n","            if len(s) < n_qubits: s = s.zfill(n_qubits)\n","            if s[pos] == \"1\": total_ones += int(n)\n","        return float(total_ones) / float(shots)\n","\n","class QuantumLayer(tf.keras.layers.Layer):\n","    def __init__(self, n_qubits: int, n_layers: int = 1, backend_name: str = \"aer_simulator\", shots: int = 1024, **kwargs):\n","        super().__init__(**kwargs)\n","        self.n_qubits = int(n_qubits)\n","        self.n_layers = int(n_layers)\n","        self.backend_name = backend_name\n","        self.shots = int(shots)\n","        self.backend = _get_backend(self.backend_name)\n","        self.theta = tf.Variable(\n","            initial_value=tf.random.uniform(shape=[self.n_layers, self.n_qubits, 3], minval=-0.1, maxval=0.1),\n","            trainable=True, dtype=tf.float32, name=\"theta\"\n","        )\n","        self.input_params = None\n","        self.theta_params = None\n","        self.circuit = self._build_circuit()\n","\n","    def get_config(self):\n","        cfg = super().get_config()\n","        cfg.update({\"n_qubits\": self.n_qubits, \"n_layers\": self.n_layers, \"backend_name\": self.backend_name, \"shots\": self.shots})\n","        return cfg\n","\n","    def _build_circuit(self):\n","        from qiskit import QuantumCircuit\n","        try:\n","            from qiskit.circuit import ParameterVector\n","        except Exception:\n","            class _Param:\n","                def __init__(self, name): self.name = name\n","            class _ParameterVector(list):\n","                def __init__(self, prefix, size): super().__init__([_Param(f\"{prefix}[{i}]\") for i in range(size)])\n","            ParameterVector = _ParameterVector  # type: ignore\n","        self.input_params = ParameterVector('input', self.n_qubits)\n","        total_theta = self.n_layers * self.n_qubits * 3\n","        self.theta_params = ParameterVector('theta', total_theta)\n","        qc = QuantumCircuit(self.n_qubits)\n","        for q in range(self.n_qubits):\n","            qc.rx(self.input_params[q], q)\n","        idx = 0\n","        for _ in range(self.n_layers):\n","            for q in range(self.n_qubits):\n","                qc.ry(self.theta_params[idx], q); idx += 1\n","                qc.rz(self.theta_params[idx], q); idx += 1\n","                qc.rx(self.theta_params[idx], q); idx += 1\n","            for q in range(self.n_qubits - 1):\n","                qc.cx(q, q + 1)\n","        qc.measure_all()\n","        return qc\n","\n","    @tf.custom_gradient\n","    def _forward(self, inputs: tf.Tensor):\n","        shots = self.shots\n","        n_qubits = self.n_qubits\n","        theta_var = self.theta\n","        input_params = self.input_params\n","        theta_params = self.theta_params\n","        circuit = self.circuit\n","        backend = self.backend\n","\n","        def quantum_processing(input_batch):\n","            import numpy as _np\n","            from qiskit import execute\n","            if hasattr(input_batch, \"numpy\"):\n","                input_batch = input_batch.numpy()\n","            batch = _np.asarray(input_batch, dtype=_np.float32).reshape(-1, n_qubits)\n","            current_theta = tf.reshape(theta_var, [-1]).numpy()\n","            out = _np.zeros((batch.shape[0], n_qubits), dtype=_np.float32)\n","            for i, row in enumerate(batch):\n","                param_dict = {}\n","                for p, v in zip(input_params, row): param_dict[p] = float(v)\n","                for p, v in zip(theta_params, current_theta): param_dict[p] = float(v)\n","                try:\n","                    bound = circuit.bind_parameters(param_dict)\n","                except Exception:\n","                    bound = circuit.assign_parameters(param_dict)\n","                job = execute(bound, backend, shots=shots)\n","                res = job.result()\n","                counts = res.get_counts()\n","                for q in range(n_qubits):\n","                    out[i, q] = _marginal_prob_one(counts, q, n_qubits, shots)\n","            return out\n","\n","        y = tf.py_function(func=quantum_processing, inp=[inputs], Tout=tf.float32)\n","        y = tf.reshape(y, [-1, n_qubits])\n","        y.set_shape([None, n_qubits])\n","\n","        def grad(dy, variables=None):\n","            dy = tf.convert_to_tensor(dy, dtype=tf.float32)\n","            d_inputs = dy\n","            if variables is not None:\n","                d_vars = [tf.zeros_like(v) for v in variables]\n","                return d_inputs, d_vars\n","            return d_inputs\n","\n","        return y, grad\n","\n","    def call(self, inputs: tf.Tensor):\n","        x = tf.convert_to_tensor(inputs, dtype=tf.float32)\n","        x = tf.reshape(x, [-1, self.n_qubits])\n","        return self._forward(x)\n","\n","    def compute_output_shape(self, input_shape):\n","        return (input_shape[0], self.n_qubits)\n","\n","# ======================= FIXES ESPECÍFICOS =======================\n","# (Incluye silenciador limpio de INFO de transformers cuando hay conversión PyTorch→TF)\n","\n","import os as __os\n","import logging as __logging\n","from contextlib import contextmanager as __contextmanager\n","\n","# ---- Switches (puedes cambiarlos por ENV) ----\n","__SUPPRESS_HF_INFO = str(__os.getenv(\"TTDVI_SUPPRESS_HF_INFO\", \"1\")).lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","__ALWAYS_QUIET_TF  = str(__os.getenv(\"TTDVI_ALWAYS_QUIET_TRANSFORMERS\", \"0\")).lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","\n","@__contextmanager\n","def _quiet_transformers():\n","    \"\"\"\n","    Baja a ERROR el logger de 'transformers' dentro del bloque.\n","    Idempotente y seguro aunque transformers no esté instalado aún.\n","    \"\"\"\n","    _old = None\n","    try:\n","        import transformers.utils.logging as _hf_logging\n","        _old = _hf_logging.get_verbosity()\n","        _hf_logging.set_verbosity_error()\n","        __logging.getLogger(\"transformers\").setLevel(__logging.ERROR)\n","        __logging.getLogger(\"transformers.modeling_tf_utils\").setLevel(__logging.ERROR)\n","        __logging.getLogger(\"transformers.modeling_utils\").setLevel(__logging.ERROR)\n","    except Exception:\n","        pass\n","    try:\n","        yield\n","    finally:\n","        try:\n","            import transformers.utils.logging as _hf_logging2\n","            if _old is not None:\n","                _hf_logging2.set_verbosity(_old)\n","        except Exception:\n","            pass\n","\n","def _hf_kwarg_name_quiet():\n","    try:\n","        import transformers  # noqa\n","        return \"token\"\n","    except Exception:\n","        return \"use_auth_token\"\n","\n","def hf_from_pretrained_quiet(Cls, repo_id: str, **kwargs):\n","    \"\"\"\n","    Carga universal: inyecta token (token/use_auth_token) y silencia INFO de conversión PyTorch→TF\n","    cuando 'from_pt=True' o si fuerzas silencio global por ENV.\n","    \"\"\"\n","    # -- inyección de token, compatible con firmas antiguas --\n","    k = _hf_kwarg_name_quiet()\n","    tok = (__os.getenv(\"HF_TOKEN\")\n","           or __os.getenv(\"HUGGINGFACEHUB_API_TOKEN\")\n","           or __os.getenv(\"HUGGING_FACE_HUB_TOKEN\"))\n","    if tok and k not in kwargs:\n","        kwargs[k] = tok\n","\n","    # ¿Habrá conversión PyTorch→TF?\n","    _will_convert = bool(kwargs.get(\"from_pt\", False))\n","    _quiet = __ALWAYS_QUIET_TF or (__SUPPRESS_HF_INFO and _will_convert)\n","\n","    def _call(**kw):\n","        try:\n","            return Cls.from_pretrained(repo_id, **kw)\n","        except TypeError:\n","            # compat: token vs use_auth_token\n","            if \"token\" in kw:\n","                t = kw.pop(\"token\"); kw[\"use_auth_token\"] = t\n","            elif \"use_auth_token\" in kw:\n","                t = kw.pop(\"use_auth_token\"); kw[\"token\"] = t\n","            return Cls.from_pretrained(repo_id, **kw)\n","\n","    if _quiet:\n","        with _quiet_transformers():\n","            return _call(**kwargs)\n","    else:\n","        return _call(**kwargs)\n","\n","# ---------- 1) Transformers pipeline SIN defaults implícitos + silencio opcional ----------\n","def safe_pipeline(task: str, model: str | None = None, revision: str | None = None, **kwargs):\n","    \"\"\"\n","    Pipeline con modelo/revisión explícitos y token auto-inyectado.\n","    Silencio de INFO si TTDVI_ALWAYS_QUIET_TRANSFORMERS=1.\n","    \"\"\"\n","    try:\n","        from transformers import pipeline as _hf_pipeline\n","    except Exception as e:\n","        raise RuntimeError(f\"Transformers no disponible: {e}\")\n","\n","    _default_model = \"distilbert/distilbert-base-uncased-finetuned-sst-2-english\"\n","    _default_rev   = \"714eb0f6c2e4d3c1a552ad69a5f7a9b6e0c2f6ef\"  # ejemplo pin\n","    model = model or _default_model\n","    revision = revision or _default_rev\n","\n","    token = kwargs.pop(\"token\", None) or __os.getenv(\"HF_TOKEN\") or None\n","    kwargs.pop(\"use_auth_token\", None)\n","    if token is not None:\n","        kwargs[\"token\"] = token\n","\n","    if __ALWAYS_QUIET_TF:\n","        with _quiet_transformers():\n","            return _hf_pipeline(task, model=model, revision=revision, **kwargs)\n","    else:\n","        return _hf_pipeline(task, model=model, revision=revision, **kwargs)\n","\n","# ---------- (Opcional) Cargador TF DistilBERT con conversión PyTorch→TF silenciada ----------\n","def load_tfdistilbert_sequence_classifier(repo_id: str, revision: str | None = None, from_pt: bool = True, **kwargs):\n","    \"\"\"\n","    Carga TFDistilBertForSequenceClassification.\n","    Por defecto from_pt=True (si el checkpoint es PyTorch-only) y silencia el INFO.\n","    \"\"\"\n","    try:\n","        from transformers import TFDistilBertForSequenceClassification as _TFCls\n","    except Exception as e:\n","        raise RuntimeError(f\"Transformers (TF) no disponible: {e}\")\n","\n","    if revision is None:\n","        revision = __os.getenv(\"HF_REV\") or None\n","\n","    kwargs = dict(kwargs)\n","    kwargs[\"from_pt\"] = bool(from_pt)\n","    return hf_from_pretrained_quiet(_TFCls, repo_id, revision=revision, **kwargs)\n","\n","# ---------- 2) Normalización Kraken + get_price robusto ----------\n","def _kraken_pair_fix(s: str) -> str:\n","    s = str(s).replace(\"/\", \"\").upper()\n","    if s in (\"XBTUSD\", \"BTCUSD\", \"XXBTZUSD\"): return \"XXBTZUSD\"\n","    if s in (\"XBTUSDT\",\"BTCUSDT\",\"XXBTZUSDT\"): return \"XBTUSDT\"\n","    if s in (\"XBTEUR\",\"BTCEUR\",\"XXBTZEUR\"): return \"XXBTZEUR\"\n","    return s\n","\n","def safe_get_price(api, pair) -> float:\n","    try:\n","        sym = pair\n","        if hasattr(pair, \"_kraken_pair\"):\n","            sym = getattr(pair, \"_kraken_pair\")\n","        elif isinstance(pair, (tuple, list)) and pair:\n","            sym = pair[0]\n","        sym = _kraken_pair_fix(sym)\n","    except Exception:\n","        sym = _kraken_pair_fix(str(pair))\n","    try:\n","        if hasattr(api, \"obtener_precio_actual\") and callable(api.obtener_precio_actual):\n","            px = api.obtener_precio_actual(sym)\n","            if px is not None: return float(px)\n","    except Exception:\n","        pass\n","    try:\n","        if hasattr(api, \"public_ticker\") and callable(api.public_ticker):\n","            t = api.public_ticker(sym)\n","            if isinstance(t, dict):\n","                if \"c\" in t and t[\"c\"]:\n","                    return float(t[\"c\"][0])\n","                for k in (\"last\",\"price\",\"p\",\"close\"):\n","                    if k in t:\n","                        try: return float(t[k])\n","                        except Exception: pass\n","    except Exception:\n","        pass\n","    try:\n","        if hasattr(api, \"get_price\") and callable(api.get_price):\n","            return float(api.get_price(sym))\n","        if hasattr(api, \"price\"):\n","            return float(api.price)\n","    except Exception:\n","        pass\n","    raise RuntimeError(f\"No se pudo obtener precio para {sym}\")\n","\n","# ---------- 3) Stubs silenciosos para predictors/modelos ausentes ----------\n","if \"QuantumPredictorBase\" not in globals():\n","    class QuantumPredictorBase:\n","        def __init__(self, **_): ...\n","        def predict(self, *_a, **_k): return 0.0\n","\n","if \"ModeloConexionista\" not in globals():\n","    class ModeloConexionista:\n","        def __init__(self, **_): ...\n","        def infer(self, *_a, **_k): return 0.0\n","\n","def _ensure_predictors_registered():\n","    g = globals()\n","    g.setdefault(\"QuantumPredictorAlcista\", QuantumPredictorBase)\n","    g.setdefault(\"QuantumPredictorBajista\", QuantumPredictorBase)\n","    g.setdefault(\"PredictorEmpirico\",       QuantumPredictorBase)\n","    g.setdefault(\"ConexionismoModel\",       ModeloConexionista)\n","    return True\n","_ensure_predictors_registered()\n","\n","# ---------- 4) Verificación rápida sklearn/NumPy (nativo o shim) ----------\n","def verificar_numpy_sklearn():\n","    import numpy as _np\n","    try:\n","        from sklearn.preprocessing import StandardScaler as _SS\n","        from sklearn.linear_model import LinearRegression as _LR\n","        X = _np.arange(20, dtype=_np.float64).reshape(-1, 1)\n","        y = _np.arange(20, dtype=_np.float64)\n","        _ = _SS().fit_transform(X)\n","        _ = _LR().fit(X, y).predict(X[:2])\n","        print(\"✅ sklearn OK (nativo o shim).\")\n","    except Exception as e:\n","        print(f\"⚠️ Posible incompatibilidad sklearn/NumPy: {e}\")\n","verificar_numpy_sklearn()\n","# ======================= FIN DE SECCIÓN =======================\n","\n","\n","# -*- coding: utf-8 -*-\n","\"\"\"\n","config.py — Configuración general del sistema de trading cuántico.\n","Valida al importarse y aplica un ENFORCER de +156% mínimo (hasta 500%).\n","Incluye auto-config de entorno y tu EnvironmentManager.\n","\"\"\"\n","\n","# === ANTI-WARNING TEMPRANO (Colab HF_TOKEN) — debe ir ANTES de cualquier import de huggingface_hub/transformers ===\n","import os as _os0, warnings as _warnings0\n","_os0.environ.setdefault(\"HF_HOME\", \"./run_ttdvi156/hf_cache\")\n","_os0.environ.setdefault(\"HF_HUB_DISABLE_TELEMETRY\", \"1\")\n","_os0.environ.setdefault(\"HF_HUB_ENABLE_HF_TRANSFER\", \"1\")\n","_os0.environ.setdefault(\"HF_HUB_DISABLE_EXPERIMENTAL_WARNING\", \"1\")\n","# Silenciar SOLO el warning de Colab cuando NO hay secreto HF_TOKEN\n","_warnings0.filterwarnings(\n","    \"ignore\",\n","    message=r\".*The secret `HF_TOKEN` does not exist in your Colab secrets.*\",\n","    category=UserWarning,\n","    module=r\"huggingface_hub\\.utils\\._auth\",\n",")\n","# Parche de respaldo: si ese warning llegara por otra vía, lo anulamos sin tocar los demás\n","_orig_warn0 = _warnings0.warn\n","def _hf_warn_patch0(msg, *a, **k):\n","    if isinstance(msg, str) and \"The secret `HF_TOKEN` does not exist in your Colab secrets.\" in msg:\n","        return\n","    return _orig_warn0(msg, *a, **k)\n","_warnings0.warn = _hf_warn_patch0\n","del _orig_warn0, _hf_warn_patch0, _warnings0, _os0\n","print(\"✅ Anti-warning HF_TOKEN de Colab activo.\")\n","\n","# ==================== IMPORTS & CONFIG GLOBAL ====================\n","import sys, os, re, stat, asyncio, time, hashlib, json, logging, random, threading as _threading, atexit, weakref, gc\n","from pathlib import Path\n","from typing import Optional, Dict, Iterable, Tuple, Any  # <- añadidos Tuple, Any\n","from decimal import Decimal\n","from dotenv import load_dotenv\n","from getpass import getpass\n","\n","from tenacity import (\n","    retry, stop_after_attempt, wait_random_exponential,\n","    retry_if_exception, before_sleep_log\n",")\n","import krakenex\n","from datetime import datetime, timedelta\n","\n","# ===================== HUGGING FACE — FIX PERMANENTE (Colab/Local) =====================\n","# - Sin monkey-patch de warnings.warn (causaba 'NoneType is not callable')\n","# - Restaura warnings si viene corrupto y suprime el warning de Colab vía filterwarnings\n","# - Cache dedicada en RUN_ROOT/hf_cache y descarga reanudable\n","\n","import os, sys, json, pathlib, platform, importlib\n","\n","# 0) Restaurar 'warnings' si fue parcheado incorrectamente\n","import warnings as _warnings\n","try:\n","    if not callable(getattr(_warnings, \"warn\", None)) or getattr(_warnings.warn, \"__name__\", \"\") != \"warn\":\n","        importlib.reload(_warnings)\n","except Exception:\n","    # Si algo falla, reimportar de nuevo como último recurso\n","    importlib.reload(_warnings)\n","\n","warnings = _warnings  # alias seguro\n","\n","# 1) Directorios base\n","RUN_ROOT = os.getenv(\"TTDVI_RUN_ROOT\", \"./run_ttdvi156\")\n","os.makedirs(RUN_ROOT, exist_ok=True)\n","\n","_HF_HOME = os.path.join(RUN_ROOT, \"hf_cache\")\n","_TRANSFORMERS_CACHE = os.path.join(_HF_HOME, \"transformers\")\n","os.makedirs(_TRANSFORMERS_CACHE, exist_ok=True)\n","\n","# 2) Variables recomendadas\n","os.environ.setdefault(\"HF_HOME\", _HF_HOME)\n","os.environ.setdefault(\"TRANSFORMERS_CACHE\", _TRANSFORMERS_CACHE)\n","os.environ.setdefault(\"HF_HUB_DISABLE_TELEMETRY\", \"1\")\n","os.environ.setdefault(\"HF_HUB_ENABLE_HF_TRANSFER\", \"1\")\n","os.environ.setdefault(\"HF_HUB_DISABLE_EXPERIMENTAL_WARNING\", \"1\")\n","os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"1\")\n","\n","# 3) Silenciar el warning de Colab *sin* tocar warnings.warn\n","warnings.filterwarnings(\n","    \"ignore\",\n","    message=r\".*The secret `HF_TOKEN` does not exist in your Colab secrets.*\",\n","    category=UserWarning,\n","    module=r\"huggingface_hub\\.utils\\._auth\",\n",")\n","\n","# 4) Import seguro de huggingface_hub\n","try:\n","    from huggingface_hub import login as _hf_login, snapshot_download as _snapshot_download, HfFolder\n","except Exception:\n","    _hf_login = None\n","    _snapshot_download = None\n","    class HfFolder:\n","        @staticmethod\n","        def get_token(): return None\n","\n","def hf_is_auth() -> bool:\n","    tok_env = (os.getenv(\"HF_TOKEN\")\n","               or os.getenv(\"HUGGINGFACEHUB_API_TOKEN\")\n","               or os.getenv(\"HUGGING_FACE_HUB_TOKEN\"))\n","    tok_file = None\n","    try:\n","        tok_file = HfFolder.get_token() if HfFolder else None\n","    except Exception:\n","        tok_file = None\n","    return bool((tok_env and tok_env.strip()) or (tok_file and str(tok_file).strip()))\n","\n","def hf_login_env() -> bool:\n","    \"\"\"Login silencioso si hay token en el entorno.\"\"\"\n","    if not _hf_login:\n","        return False\n","    token = (os.getenv(\"HF_TOKEN\")\n","             or os.getenv(\"HUGGINGFACEHUB_API_TOKEN\")\n","             or os.getenv(\"HUGGING_FACE_HUB_TOKEN\"))\n","    if token and token.strip():\n","        try:\n","            _hf_login(token=token.strip(), add_to_git_credential=False)\n","            return True\n","        except Exception:\n","            return False\n","    return False\n","\n","def hf_setup(auth_required: bool = False) -> None:\n","    \"\"\"Inicializa HF (anónimo si no hay token).\"\"\"\n","    logged = hf_login_env()\n","    if auth_required and not (logged or hf_is_auth()):\n","        raise RuntimeError(\n","            \"HF_TOKEN/HUGGINGFACEHUB_API_TOKEN no configurado y auth_required=True. \"\n","            \"Configura tu token en .env o variables de entorno.\"\n","        )\n","\n","def hf_snapshot(repo_id: str,\n","                local_dir: str | None = None,\n","                allow_patterns=None,\n","                revision: str | None = None) -> str:\n","    \"\"\"Descarga reanudable, sin symlinks, al cache local estable.\"\"\"\n","    if _snapshot_download is None:\n","        raise RuntimeError(\"huggingface_hub no está instalado en este entorno.\")\n","    if local_dir is None:\n","        safe_repo = repo_id.replace(\"/\", \"__\")\n","        local_dir = os.path.join(RUN_ROOT, \"models\", safe_repo)\n","    pathlib.Path(local_dir).mkdir(parents=True, exist_ok=True)\n","    path = _snapshot_download(\n","        repo_id=repo_id,\n","        local_dir=local_dir,\n","        local_dir_use_symlinks=False,\n","        allow_patterns=allow_patterns,\n","        resume_download=True,\n","        revision=revision\n","    )\n","    return path\n","\n","# 5) Inicialización temprana (no exige token)\n","try:\n","    hf_setup(auth_required=False)\n","except Exception as e:\n","    print(f\"[HF Setup] Advertencia: {e}\", file=sys.stderr)\n","\n","\n","# ==================== FIX PERMANENTE _ensure_dirs (siempre retorna 3-tuple) ====================\n","import os, sys, platform\n","\n","def _ensure_dirs():\n","    \"\"\"\n","    Retorna (run_root, log_dir, viz_dir) SIEMPRE.\n","    Crea los directorios necesarios y nunca devuelve None.\n","    \"\"\"\n","    try:\n","        # Detectar entorno\n","        in_colab = \"google.colab\" in sys.modules\n","        os_name  = platform.system().lower()\n","\n","        if in_colab:\n","            base = \"/content/run_ttdvi156\"\n","        elif os_name == \"windows\":\n","            base = os.path.join(os.environ.get(\"USERPROFILE\", \".\"), \"run_ttdvi156\")\n","        else:\n","            # Usa TTDI_RUN_ROOT si está definido, si no un default local\n","            base = os.environ.get(\"TTDVI_RUN_ROOT\", \"./run_ttdvi156\")\n","\n","        run_root = os.getenv(\"TTDVI_RUN_ROOT\", base)\n","        os.makedirs(run_root, exist_ok=True)\n","\n","        log_dir = os.getenv(\"LOG_DIR\", os.path.join(run_root, \"logs\"))\n","        viz_dir = os.getenv(\"VIZ_OUT_DIR\", os.path.join(run_root, \"resultados_graficos\"))\n","\n","        # Asegurar carpetas\n","        for d in (log_dir, viz_dir):\n","            try:\n","                os.makedirs(d, exist_ok=True)\n","            except Exception:\n","                pass\n","\n","        return run_root, log_dir, viz_dir\n","\n","    except Exception:\n","        # Último recurso: rutas locales seguras\n","        run_root = \"./run_ttdvi156\"\n","        log_dir  = os.path.join(run_root, \"logs\")\n","        viz_dir  = os.path.join(run_root, \"resultados_graficos\")\n","        try:\n","            os.makedirs(log_dir, exist_ok=True)\n","            os.makedirs(viz_dir, exist_ok=True)\n","        except Exception:\n","            pass\n","        return run_root, log_dir, viz_dir\n","# ==================== / FIX PERMANENTE _ensure_dirs ====================\n","# Añadir estas importaciones al inicio del archivo (si no están ya)\n","from typing import Union, Any, Tuple, Dict\n","from decimal import Decimal\n","import os\n","\n","# ==================== HELPERS DE RUTA ====================\n","\n","def _ensure_dirs(run_root_env: str = \"TTDVI_RUN_ROOT\") -> Tuple[str, str, str]:\n","    \"\"\"Crea y devuelve (RUN_ROOT, LOG_DIR, VIZ_OUT_DIR). Idempotente y tolerante a errores.\"\"\"\n","    run_root = os.getenv(run_root_env, \"./run_ttdvi156\")\n","    try:\n","        os.makedirs(run_root, exist_ok=True)\n","        log_dir = os.path.join(run_root, \"logs\")\n","        viz_dir = os.path.join(run_root, \"viz\")\n","        os.makedirs(log_dir, exist_ok=True)\n","        os.makedirs(viz_dir, exist_ok=True)\n","    except Exception:\n","        # Fallback mínimo en caso de permisos\n","        log_dir = \"./logs\"; viz_dir = \"./viz\"\n","        try:\n","            os.makedirs(log_dir, exist_ok=True)\n","            os.makedirs(viz_dir, exist_ok=True)\n","        except Exception:\n","            pass\n","    return run_root, log_dir, viz_dir\n","\n","# ==================== CONFIG BASE ====================\n","\n","class Config:\n","    # -------- MERCADO --------\n","    PAR_TRADING = 'XXBTZUSD'\n","    PARES_ACTIVOS = ['XBT/USD', 'ETH/USD']\n","\n","    # -------- INTERVALOS --------\n","    INTERVAL = 5\n","    INTERVALO_ANALISIS = {'rapido': 5, 'lento': 15}\n","\n","    # -------- MODELO --------\n","    MODEL_INPUT_WINDOW = 100\n","    MODELO_ENTRENA = 500\n","\n","    # -------- RIESGO --------\n","    MAX_LEVERAGE = 5\n","    RISK_FACTOR = 0.02\n","    NIVEL_RIESGO_DINAMICO = True\n","\n","    # -------- ESTRATEGIAS --------\n","    ESTRATEGIAS = {\n","        'quantum_trend': True,\n","        'volatility_arbitrage': True,\n","        'liquidity_mining': True\n","    }\n","    STRATEGIES = ESTRATEGIAS\n","    try:\n","        ESTRATEGIAS_ACTIVAS = [k for k, v in ESTRATEGIAS.items() if v]\n","    except Exception:\n","        ESTRATEGIAS_ACTIVAS = []\n","\n","    # -------- ÓRDENES / SPREAD --------\n","    MIN_ORDER = Decimal('0.0001')\n","    SPREAD_TARGET = Decimal('0.02')\n","\n","    # -------- OBJETIVOS (fraccional legado 4–10%) --------\n","    # Nota: se mantiene por compat, pero el enforcer +156% manda sobre PROFIT_TARGET_PCT*.\n","    OBJETIVO_GANANCIA_MIN  = Decimal('0.04')\n","    OBJETIVO_GANANCIA_MAX  = Decimal('0.10')\n","    OBJETIVO_GANANCIA_BASE = Decimal('0.05')\n","    OBJETIVO_GANANCIA_ADAPTATIVO = True\n","    VOLATILIDAD_BAJA = Decimal('0.015')\n","    VOLATILIDAD_ALTA = Decimal('0.050')\n","    ESCALA_OBJETIVO_POR_VOLATILIDAD = {'baja':Decimal('0.04'),'media':Decimal('0.06'),'alta':Decimal('0.10')}\n","\n","    # -------- SALIDAS --------\n","    ACTIVAR_TRAILING_STOP = True\n","    TRAILING_STOP_INICIAL = Decimal('0.020')\n","    TRAILING_STOP_MAX     = Decimal('0.060')\n","    TRAILING_STEP         = Decimal('0.005')\n","    ACTIVAR_BREAKEVEN = True\n","    BREAKEVEN_OFFSET = Decimal('0.001')\n","    FORZAR_SALIDA_MAYOR_QUE_ENTRADA = True\n","    TAKE_PROFIT_ESCALONADO = [\n","        {'pct': Decimal('0.04'), 'ratio': Decimal('0.30')},\n","        {'pct': Decimal('0.06'), 'ratio': Decimal('0.30')},\n","        {'pct': Decimal('0.08'), 'ratio': Decimal('0.20')},\n","        {'pct': Decimal('0.10'), 'ratio': Decimal('0.20')},\n","    ]\n","\n","    # -------- TIEMPOS --------\n","    TIEMPO_ADAPTATIVO = True\n","    REEVAL_CADA_MIN = 1\n","    HOLD_BASE_MIN = 30\n","    HOLD_MAX_MIN  = 240\n","    AJUSTE_HOLD_POR_VOLATILIDAD = {'baja':60,'media':120,'alta':240}\n","    COOLDOWN_MINUTOS_POST_VENTA = 15\n","    MAX_REEVAL_INTENTOS = 20\n","\n","    # -------- SERVICIOS --------\n","    MAX_INTENTOS_HISTORIAL = 30\n","    TIEMPO_MONITOREO_SEGUNDOS = 1800\n","\n","    # -------- LEGACY (en % ABSOLUTO) — ENFORCER +156% aplicará aquí --------\n","    PROFIT_TARGET_PCT       = 156.0     # objetivo base en %\n","    MIN_PROFIT_TARGET_PCT   = 156.0     # piso duro\n","    MAX_PROFIT_TARGET_PCT   = 500.0     # techo lógico\n","    STOP_LOSS_PCT           = 1.2\n","    MAX_HOLD_TIME_SECONDS   = 3 * 60 * 60\n","\n","    # -------- COMPAT LEGACY (GOAL_* usados por schedulers antiguos) --------\n","    # Evita: \"type object 'Config' has no attribute 'GOAL_MIN_PROFIT'\"\n","    GOAL_MIN_PROFIT = float(MIN_PROFIT_TARGET_PCT)\n","    GOAL_MAX_PROFIT = float(MAX_PROFIT_TARGET_PCT)\n","\n","    # -------- RUTAS --------\n","    RUN_ROOT, LOG_DIR, VIZ_OUT_DIR = _ensure_dirs()\n","\n","    # -------- HELPERS --------\n","    @staticmethod\n","    def objetivo_ganancia_por_volatilidad(volatilidad_pct: Union[float, Decimal]) -> Decimal:\n","        v = Decimal(str(volatilidad_pct))\n","        if v <= Config.VOLATILIDAD_BAJA:\n","            tgt = Config.ESCALA_OBJETIVO_POR_VOLATILIDAD['baja']\n","        elif v >= Config.VOLATILIDAD_ALTA:\n","            tgt = Config.ESCALA_OBJETIVO_POR_VOLATILIDAD['alta']\n","        else:\n","            lo_v = Config.VOLATILIDAD_BAJA; hi_v = Config.VOLATILIDAD_ALTA\n","            lo_t = Config.ESCALA_OBJETIVO_POR_VOLATILIDAD['baja']; hi_t = Config.ESCALA_OBJETIVO_POR_VOLATILIDAD['alta']\n","            w = (v - lo_v) / (hi_v - lo_v)\n","            tgt = lo_t + (hi_t - lo_t) * w\n","        if tgt < Config.OBJETIVO_GANANCIA_MIN:\n","            tgt = Config.OBJETIVO_GANANCIA_MIN\n","        if tgt > Config.OBJETIVO_GANANCIA_MAX:\n","            tgt = Config.OBJETIVO_GANANCIA_MAX\n","        return tgt.quantize(Decimal('0.0001'))\n","\n","    @staticmethod\n","    def validar() -> None:\n","        # objetivos coherentes\n","        assert Config.OBJETIVO_GANANCIA_MIN <= Config.OBJETIVO_GANANCIA_BASE <= Config.OBJETIVO_GANANCIA_MAX\n","        # tamaños y riesgo\n","        assert Decimal('0') < Config.MIN_ORDER\n","        assert 0 < Config.RISK_FACTOR <= 1\n","        # tiempos\n","        assert Config.HOLD_BASE_MIN <= Config.HOLD_MAX_MIN\n","        # take profits suma 1.00\n","        total_ratio = sum((tp['ratio'] for tp in Config.TAKE_PROFIT_ESCALONADO), Decimal('0'))\n","        assert total_ratio == Decimal('1.00'), f\"TAKE_PROFIT_ESCALONADO debe sumar 1.00, suma={total_ratio}\"\n","        # estrategias definidas correctamente\n","        assert hasattr(Config, \"ESTRATEGIAS\") and isinstance(Config.ESTRATEGIAS, dict)\n","\n","# ==================== PATCH COMPAT (incluye GOAL_*) ====================\n","\n","def _compatibility_patch() -> None:\n","    def _setdefault(name: str, value):\n","        if not hasattr(Config, name):\n","            setattr(Config, name, value)\n","\n","    _setdefault(\"INTERVAL\", 5)\n","    _setdefault(\"INTERVALO_ANALISIS\", {\"rapido\": getattr(Config, \"INTERVAL\", 5), \"lento\": 15})\n","    _setdefault(\"INTERVALO_ANALISIS_RAPIDO\", Config.INTERVALO_ANA