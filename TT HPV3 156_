message=_MSG1, category=DeprecationWarning, module=r\"^qiskit(\\.|$)\")\n","    _warnings.filterwarnings(\"ignore\", message=_MSG2, category=DeprecationWarning, module=r\"^qiskit(\\.|$)\")\n","    if not getattr(_warnings, \"_qiskit_depr_silencer_installed\", False):\n","        _orig_warn0 = _warnings.warn\n","        def _warn_patched(msg, *a, **k):\n","            s = \"\"\n","            try: s = str(msg)\n","            except Exception: pass\n","            if (\"qiskit.transpiler.target.target_to_backend_properties()\" in s and \"deprecated as of qiskit 1.2\" in s) \\\n","               or (\"qiskit.qobj.common.QobjDictField\" in s and \"deprecated as of qiskit 1.2\" in s):\n","                return None\n","            return _orig_warn0(msg, *a, **k)\n","        _warnings.warn = _warn_patched\n","        _warnings._qiskit_depr_silencer_installed = True\n","\n","# --- KERAS: MSE que recorta dinámicamente y_true / y_pred al mismo largo (idempotente) ---\n","try:\n","    import tensorflow as _tf, keras as _keras\n","    def _mse_same_len(y_true, y_pred):\n","        t = _tf.convert_to_tensor(y_true); p = _tf.convert_to_tensor(y_pred)\n","        t = _tf.reshape(t, (-1, 1)); p = _tf.reshape(p, (-1, 1))\n","        n = _tf.minimum(_tf.shape(t)[0], _tf.shape(p)[0])\n","        t = t[:n]; p = p[:n]\n","        return _tf.reduce_mean(_tf.math.squared_difference(t, p))\n","    if not getattr(_keras.losses, \"_mse_same_len_patched\", False):\n","        _keras.losses.mean_squared_error = _mse_same_len\n","        _keras.losses.mse = _mse_same_len\n","        _keras.losses.MSE = _mse_same_len\n","        _keras.losses._mse_same_len_patched = True\n","except Exception:\n","    pass\n","\n","# --- MARKET MONITOR SHIM: acepta interval_sec y/o interval (idempotente) ---\n","def _install_marketmonitor_start_shim():\n","    cls = globals().get(\"MarketMonitor\")\n","    if cls is None:\n","        return\n","    if not hasattr(cls, \"_start_monitoring_compat_patched\"):\n"