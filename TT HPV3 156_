 return mod\n","\n","# Instalar el shim ANTES del import\n","_ttdvi156_install_shim()\n","# ==============================================================================\n","\n","# A partir de aquí, tu import funciona igual:\n","import ttdvi156 as T\n","\n","# ============================== FIN REFUERZO ==================================\n","\n","# ---------- BLOQUES DEMO/ARRANQUE SOLO BAJO __main__ (no al importar) ----------\n","if __name__ == \"__main__\":\n","    print(\"🎯 TTDVI156 HP v3 - SISTEMA COMPLETAMENTE IMPLEMENTADO Y LISTO\")\n","\n","    # Modo demo 1: diagnóstico y un render forzado (sintético por defecto)\n","    os.environ[\"ALLOW_SYNTHETIC\"] = os.getenv(\"ALLOW_SYNTHETIC\", \"1\")\n","    os.environ[\"TTDVI_LIVE_CANVAS\"] = os.getenv(\"TTDVI_LIVE_CANVAS\", \"0\")\n","\n","    T.install_blindaje_ttdvi156()   # watchdog + breaker + guardados atómicos\n","    diag = T.prueba_diagnostico()   # chequea entorno y genera diag_result.json\n","    ok = T.render_once_force()      # genera la infografía unificada\n","    print(\"Diagnóstico:\", diag)\n","    print(\"Render OK:\", ok)\n","    T.mostrar_rutas_y_existencia()  # muestra rutas y existencia de archivos\n","\n","    # (Opcional) Modo demo 2: arrancar todo con dashboard si está habilitado por ENV\n","    if os.getenv(\"TTDVI_AUTOSTART_RENDER\", \"1\").strip().lower() in (\"1\", \"true\", \"yes\", \"on\", \"si\", \"sí\"):\n","        os.environ[\"ALLOW_SYNTHETIC\"] = os.getenv(\"ALLOW_SYNTHETIC\", \"1\")  # o quítalo si quieres datos reales\n","        os.environ[\"TTDVI_LIVE_CANVAS\"] = os.getenv(\"TTDVI_LIVE_CANVAS\", \"1\")\n","        T.install_blindaje_ttdvi156()\n","        T.arrancar_todo_hpv3(modo=\"auto\", with_dashboard=True)\n","        # Para detener manualmente:\n","        # T.detener_ttdvi_renderer()\n","\n","\n","\n","# =========================================================================================\n","# ================== ⚙️ OBJETIVO UNIVERSAL (configurable) =================================\n","# =========================================================================================\n","import os\n","from dataclasses import dataclass\n","\n","# -- Helpers idempotentes (solo se crean si no existen) --\n","if \"_TTDVI_HELPER_parse_ratio_env\" not in globals():\n","    def _parse_ratio_env(name: str, default: float) -> float:\n","        \"\"\"\n","        Convierte variables de entorno a 'ratio' (1.56 = +156%):\n","          - '1.56'  -> 1.56\n","          - '156%'  -> 1.56\n","          - '15,6%' -> 0.156 (coma a punto + %)\n","          - '0.03'  -> 0.03 (== 3%)\n","          - '3%'    -> 0.03\n","        Si falta o es inválido, devuelve default.\n","        \"\"\"\n","        raw = (os.getenv(name, \"\") or \"\").strip()\n","        if not raw:\n","            return float(default)\n","        raw = raw.replace(\",\", \".\")\n","        try:\n","            if raw.endswith(\"%\"):\n","                return float(raw[:-1].strip()) / 100.0\n","            return float(raw)\n","        except Exception:\n","            return float(default)\n","    globals()[\"_TTDVI_HELPER_parse_ratio_env\"] = True\n","\n","if \"_TTDVI_HELPER_parse_pct_env\" not in globals():\n","    def _parse_pct_env(name: str, default_pct: float) -> float:\n","        \"\"\"\n","        Devuelve un número en 'porcentaje' (no ratio):\n","          - '4'   -> 4.0   (%)\n","          - '4%'  -> 4.0   (%)\n","          - '4,5' -> 4.5   (%)\n","        \"\"\"\n","        raw = (os.getenv(name, \"\") or \"\").strip()\n","        if not raw:\n","            return float(default_pct)\n","        raw = raw.replace(\",\", \".\")\n","        try:\n","            if raw.endswith(\"%\"):\n","                return float(raw[:-1].strip())\n","            return float(raw)\n","        except Exception:\n","            return float(default_pct)\n","    globals()[\"_TTDVI_HELPER_parse_pct_env\"] = True\n","\n","@dataclass\n","class ObjetivoUniversal:\n","    # ⚠️ Clarísimo: 1.56 == +156% (positivo SIEMPRE)\n","    take_profit: float   = _parse_ratio_env(\"OBJ_TP\", 1.56)     # objetivo global (ratio)\n","    stop_loss: float     = _parse_ratio_env(\"OBJ_SL\", 0.03)     # stop por trade (ratio)\n","    min_pred_buy: float  = _parse_pct_env(\"OBJ_MIN_PRED_BUY\", 4.0)  # umbral de predicción en %\n","    reactividad: float   = _parse_ratio_env(\"OBJ_REACT\", 0.8)   # ratio genérico (si lo usas)\n","\n","    def __post_init__(self):\n","        # Saneos mínimos: TP debe ser >0, SL entre (0,1)\n","        if not (self.take_profit > 0):\n","            self.take_profit = 1.56\n","        if not (0 < self.stop_loss < 1.0):\n","            self.stop_loss = 0.03\n","        # min_pred_buy siempre en % no negativo\n","        if self.min_pred_buy < 0:\n","            self.min_pred_buy = 4.0\n","\n","# Alias de compatibilidad (si en otras partes usas ObjetivoUniversal156)\n","if \"ObjetivoUniversal156\" not in globals():\n","    ObjetivoUniversal156 = ObjetivoUniversal\n","\n","OBJ = ObjetivoUniversal()\n","\n","# =========================================================================================\n","# ================== 🛡️ GUARDIA DE POSICIONES (Ultra AI SMART) ============================\n","# =========================================================================================\n","class PositionGuard:\n","    \"\"\"\n","    - No abre nueva compra mientras haya una operación abierta sin cumplir TP/SL.\n","    - Si no existe backend de posiciones, usa estado local en memoria (y opcional JSON).\n","    \"\"\"\n","    def __init__(self, order_executor=None, state_path: Optional[str] = None):\n","        self.order_executor = order_executor\n","        self.state_path = state_path  # e.g., \"state/trade_guard.json\"\n","        self.state = {\"open\": False, \"side\": None, \"entry\": None, \"tp\": None, \"sl\": None}\n","\n","        # Carga estado previo si existe\n","        if self.state_path and os.path.exists(self.state_path):\n","            try:\n","                with open(self.state_path, \"r\", encoding=\"utf-8\") as f:\n","                    self.state = json.load(f)\n","            except Exception:\n","                pass\n","\n","    def _persist(self):\n","        if not self.state_path:\n","            return\n","        try:\n","            os.makedirs(os.path.dirname(self.state_path), exist_ok=True)\n","            with open(self.state_path, \"w\", encoding=\"utf-8\") as f:\n","                json.dump(self.state, f, ensure_ascii=False, indent=2)\n","        except Exception:\n","            pass\n","\n","    async def _backend_has_open_long(self) -> Optional[dict]:\n","        \"\"\"\n","        Intenta consultar al order_executor si tiene una posición abierta.\n","        Debe devolver dict con al menos {'side','entry'} si existe; None si no.\n","        \"\"\"\n","        if not self.order_executor:\n","            return None\n","        for nombre in [\"get_open_position\", \"get_position\", \"estado_posicion\", \"position_status\"]:\n","            fn = getattr(self.order_executor, nombre, None)\n","            if callable(fn):\n","                try:\n","                    res = await _maybe_await(fn)\n","                    pos = res\n","                    if isinstance(pos, dict) and pos.get(\"side\") in (\"buy\", \"long\"):\n","                        return pos\n","                except Exception:\n","                    pass\n","        return None\n","\n","    async def refresh_from_backend(self):\n","        pos = await self._backend_has_open_long()\n","        if pos:\n","            # Mapea a nuestro estado\n","            entry = float(pos.get(\"entry\") or pos.get(\"avg_entry\") or 0.0)\n","            if entry > 0:\n","                self.state.update({\n","                    \"open\": True, \"side\": \"buy\",\n","                    \"entry\": entry,\n","                    \"tp\": entry * (1.0 + OBJ.take_profit),  # 1.56 => +156%\n","                    \"sl\": entry * (1.0 - OBJ.stop_loss),\n","                })\n","                self._persist()\n","                return\n","\n","        # Si backend no reporta posición, cerrar estado local si estaba abierto\n","        if self.state.get(\"open\"):\n","            self.state = {\"open\": False, \"side\": None, \"entry\": None, \"tp\": None, \"sl\": None}\n","            self._persist()\n","\n","    def _update_outcome(self, last_price: float):\n","        if not self.state.get(\"open\"):\n","            return\n","        entry = float(self.state[\"entry\"])\n","        tp = float(self.state[\"tp\"])\n","        sl = float(self.state[\"sl\"])\n","        if last_price >= tp or last_price <= sl:\n","            # Consideramos cerrada por cumplimiento de TP o SL\n","            self.state = {\"open\": False, \"side\": None, \"entry\": None, \"tp\": None, \"sl\": None}\n","            self._persist()\n","\n","    async def can_open_new_buy(self, last_price: float, predicted_change_pct: float) -> bool:\n","        \"\"\"\n","        Regla:\n","        - Si hay long abierto y no ha cumplido TP/SL -> NO abre nueva compra.\n","        - Si no hay posición abierta -> verifica umbral mínimo de predicción (en %).\n","        \"\"\"\n","        # 1) Intenta sincronizar con backend\n","        await self.refresh_from_backend()\n","\n","        # 2) Si hay estado local abierto, evalúa objetivo\n","        self._update_outcome(last_price)\n","\n","        if self.state.get(\"open\"):\n","            print(\"🛑 Guardia: ya hay una compra abierta sin cumplir objetivo. No se abre otra.\")\n","            return False\n","\n","        # 3) Si no hay posición abierta: valida umbral de predicción\n","        if float(predicted_change_pct) < OBJ.min_pred_buy:\n","            print(f\"🧯 Guardia: predicción ({predicted_change_pct:.2f}%) < umbral ({OBJ.min_pred_buy:.2f}%).\")\n","            return False\n","\n","        return True\n","\n","    def notify_new_buy(self, entry_price: float):\n","        \"\"\"\n","        Llamar después de disparar una compra real para fijar el estado y objetivos.\n","        \"\"\"\n","        entry = float(entry_price)\n","        self.state.update({\n","            \"open\": True, \"side\": \"buy\", \"entry\": entry,\n","            \"tp\": entry * (1.0 + OBJ.take_profit),  # 1.56 => +156%\n","            \"sl\": entry * (1.0 - OBJ.stop_loss),\n","        })\n","        self._persist()\n","\n","\n","\n","# ==================== SECCIÓN #1 — FUTUROS con APALANCAMIENTO ADAPTIVO (READY) ====================\n","import os, time, math, asyncio\n","from decimal import Decimal\n","\n","# ---------- Utils mínimos ----------\n","def _as_float_env(name: str, default: float) -> float:\n","    try: return float(os.getenv(name, str(default)))\n","    except Exception: return default\n","\n","def _as_int_env(name: str, default: int) -> int:\n","    try: return int(float(os.getenv(name, str(default))))\n","    except Exception: return default\n","\n","def _as_bool_env(name: str, default: bool) -> bool:\n","    raw = str(os.getenv(name, str(int(default)))).strip().lower()\n","    return raw in (\"1\",\"true\",\"yes\",\"on\",\"y\",\"t\")\n","\n","def normalizar_simbolo(s: str) -> str:\n","    s = (s or \"XBTUSD\").upper().replace(\"/\", \"\")\n","    s = s.replace(\"BTC\", \"XBT\")\n","    if \"XBT\" in s and \"USD\" in s:\n","        return \"XXBTZUSD\"  # forma Kraken spot; para Futuros tu API puede mapear internamente\n","    return s\n","\n","# ---------- Gestor de Apalancamiento ----------\n","class AdaptiveLeverageManager:\n","    \"\"\"\n","    Calcula apalancamiento dinámico en rango [1.0, Lmax], donde:\n","        Lmax = 1.56x (156%) en Futuros (por solicitud)\n","    Basado en:\n","        - predicción (0.5–1.0 → 50%–100% convicción)\n","        - volatilidad anualizada del GestorRiesgo (más vol → menos L)\n","    \"\"\"\n","    def __init__(self, gestor_riesgo):\n","        self.gestor_riesgo = gestor_riesgo\n","        self.futuros_mode = _as_bool_env(\"FUTUROS_MODE\", True)\n","        # Tope de apalancamiento efectivo (1.56x = 156%)\n","        self.leverage_max = _as_float_env(\"MAX_LEVERAGE_XX\", 1.56) if self.futuros_mode else 1.0\n","        self.leverage_min = 1.0\n","        self._nivel_actual = 1.0\n","\n","    def _vol_penalizer(self, vol_annualized: float) -> float:\n","        \"\"\"\n","        Penaliza apalancamiento por volatilidad:\n","            - vol <= 40% → factor 1.0 (sin castigo)\n","            - vol 40–100% → factor lineal 0.85–0.65\n","            - vol > 100% → factor 0.5\n","        \"\"\"\n","        v = max(0.0, float(vol_annualized))\n","        if v <= 0.40: return 1.0\n","        if v >= 1.00: return 0.5\n","        # interpola entre 0.85 (0.40) y 0.65 (1.00)\n","        lo, hi = 0.40, 1.00\n","        return 0.85 - (0.20 * ((v - lo) / (hi - lo)))\n","\n","    def calcular(self, prediction_strength: float) -> float:\n","        \"\"\"\n","        prediction_strength se espera en [0.5, 1.0] (como en tu predictor).\n","        \"\"\"\n","        base = max(0.5, min(1.0, float(prediction_strength)))\n","        # Mapea convicción a 1.0–Lmax\n","        # base=0.5 → 1.0x ; base=1.0 → Lmax\n","        span = self.leverage_max - self.leverage_min\n","        lev_raw = self.leverage_min + span * ((base - 0.5) / 0.5)\n","        # Penalización por volatilidad\n","        vol = getattr(self.gestor_riesgo, \"volatilidad\", 0.0)\n","        lev_raw *= self._vol_penalizer(vol)\n","        # Limita\n","        self._nivel_actual = max(self.leverage_min, min(self.leverage_max, lev_raw))\n","        return round(self._nivel_actual, 2)\n","\n","    @property\n","    def nivel_actual(self) -> float:\n","        return float(self._nivel_actual)\n","\n","# ---------- Ejecutor con Futuros + UTO 1.56% y límites operativos ----------\n","class FuturesOrderExecutor:\n","    \"\"\"\n","    - Opera en modo prueba → 1 pasada y activa modo real\n","    - FUTUROS con leverage adaptivo (tope 156%)\n","    - Objetivo (TP) mínimo efectivo: OBJETIVO_MIN_PCT (default 1.56%)\n","    - Máximo 3 operaciones por sesión (MAX_TRADES_PER_SESSION)\n","    - Respeta precio mínimo de compra (MIN_BUY_PRICE_USD)\n","    - Acepta API Kraken-like:\n","        * preferente: api.query_private(\"AddOrder\", params)\n","        * si existen api.buy/api.sell, se usan (y se les pasa leverage cuando aplique)\n","    \"\"\"\n","    def __init__(self, api, risk_manager, gestor_riesgo):\n","        self.api = api\n","        self.risk_manager = risk_manager        # puede ser tu AIRiskEngine/RiskManager\n","        self.gestor_riesgo = gestor_riesgo      # GestorRiesgo (balances/volatilidad)\n","        self.al = AdaptiveLeverageManager(gestor_riesgo)\n","        self.active_position = None\n","        self.test_mode = True\n","        self.trades_done = 0\n","        self.max_trades = _as_int_env(\"MAX_TRADES_PER_SESSION\", 3)\n","        self.futuros_mode = _as_bool_env(\"FUTUROS_MODE\", True)\n","        self.min_buy_price = Decimal(str(_as_float_env(\"MIN_BUY_PRICE_USD\", 0.0)))\n","        self.obj_min_pct = Decimal(str(_as_float_env(\"OBJETIVO_MIN_PCT\", 1.56)))\n","        self.max_wait_seconds = _as_int_env(\"MAX_WAIT_SECONDS\", 900)\n","        self.min_pred_pct = _as_float_env(\"MIN_PREDICTED_PCT\", 2.0)\n","        self.max_pred_pct = _as_float_env(\"MAX_PREDICTED_PCT\", 10.0)\n","        self.size_multiplier = Decimal(str(_as_float_env(\"SIZE_MULTIPLIER\", 1.0)))\n","\n","    # ----------------- Adapters -----------------\n","    async def _api_place(self, side: str, price: Decimal, amount: Decimal, leverage: float):\n","        \"\"\"\n","        Intenta api.buy/api.sell; si no existen, usa AddOrder.\n","        Pasa leverage si FUTUROS_MODE.\n","        \"\"\"\n","        lv_str = f\"{leverage:.2f}\"\n","        # Prefer api.buy / api.sell si vienen en tu wrapper\n","        if side == \"buy\" and hasattr(self.api, \"buy\") and callable(getattr(self.api, \"buy\")):\n","            try:\n","                return await self.api.buy(price, amount, leverage=lv_str if self.futuros_mode else None, futures=self.futuros_mode)\n","            except TypeError:\n","                return await self.api.buy(price, amount)\n","        if side == \"sell\" and hasattr(self.api, \"sell\") and callable(getattr(self.api, \"sell\")):\n","            try:\n","                return await self.api.sell(price, amount, leverage=lv_str if self.futuros_mode else None, futures=self.futuros_mode)\n","            except TypeError:\n","                return await self.api.sell(price, amount)\n","        # Kraken-like AddOrder\n","        params = {\n","            \"pair\": normalizar_simbolo(os.getenv(\"PAR_TRADING\", \"XBTUSD\")),\n","            \"type\": side,\n","            \"ordertype\": \"market\",\n","            \"volume\": str(float(amount)),\n","            \"validate\": False,\n","        }\n","        if self.futuros_mode:\n","            # Para tu conector de Futuros, añade el campo que tu backend soporte:\n","            # Algunos wrappers usan \"leverage\" y/o \"oflags\": \"fciq\"\n","            params[\"leverage\"] = lv_str\n","            params[\"oflags\"] = \"fciq\"  # ejemplo (post-only/iceberg/etc. según tu backend)\n","        return await self.api.query_private(\"AddOrder\", params)\n","\n","    async def _api_close(self, price: Decimal, amount: Decimal):\n","        # Cierra en market (lado contrario)\n","        side = \"sell\" if self.active_position and self.active_position[\"side\"] == \"buy\" else \"buy\"\n","        if hasattr(self.api, \"sell\") and side == \"sell\":\n","            try:\n","                return await self.api.sell(price, amount, futures=self.futuros_mode)\n","            except TypeError:\n","                return await self.api.sell(price, amount)\n","        if hasattr(self.api, \"buy\") and side == \"buy\":\n","            try:\n","                return await self.api.buy(price, amount, futures=self.futuros_mode)\n","            except TypeError:\n","                return await self.api.buy(price, amount)\n","        params = {\n","            \"pair\": normalizar_simbolo(os.getenv(\"PAR_TRADING\", \"XBTUSD\")),\n","            \"type\": side,\n","            \"ordertype\": \"market\",\n","            \"volume\": str(float(amount)),\n","            \"validate\": False,\n","        }\n","        return await self.api.query_private(\"AddOrder\", params)\n","\n","    # ----------------- Lógica pública -----------------\n","    async def start_test_and_live_trading(self, predictor):\n","        \"\"\"\n","        Realiza 1 operación de prueba para validar flujo y activa modo real.\n","        \"\"\"\n","        print(\"🧪 Iniciando prueba controlada con predictor (Futuros/Leverage)…\")\n","        current_price = Decimal(str(_as_float_env(\"DUMMY_PRICE\", 30000.0)))\n","        try:\n","            prediction = float(await predictor.predecir_cambio_precio())\n","        except Exception:\n","            prediction = 3.0\n","        await self.execute_order(\n","            price=current_price,\n","            signal_strength=1.0,\n","            predicted_change_pct=prediction\n","        )\n","        print(\"✅ Prueba completada. Modo real activado.\")\n","        self.test_mode = False\n","\n","    async def execute_order(self, price: Decimal, signal_strength: float, predicted_change_pct: float):\n","        \"\"\"\n","        Ejecuta BUY con:\n","          - validación de predicción [MIN_PREDICTED_PCT, MAX_PREDICTED_PCT]\n","          - apalancamiento adaptivo tope 156%\n","          - tamaño basado en GestorRiesgo (risk_budget / stop) * leverage * SIZE_MULTIPLIER\n","          - respeta MIN_BUY_PRICE_USD\n","          - máximo 3 operaciones por sesión\n","        \"\"\"\n","        if self.active_position:\n","            print(\"🛑 Venta pendiente/posición activa; omite nueva compra\")\n","            return\n","        if self.trades_done >= self.max_trades:\n","            print(f\"🛑 Límite de operaciones alcanzado ({self.max_trades}).\")\n","            return\n","\n","        # Validación predicción\n","        if predicted_change_pct < self.min_pred_pct:\n","            print(f\"🔒 Compra ignorada: predicción ({predicted_change_pct:.2f}%) insuficiente (<{self.min_pred_pct}%).\")\n","            return\n","        if predicted_change_pct > self.max_pred_pct:\n","            print(f\"🔒 Compra ignorada: predicción ({predicted_change_pct:.2f}%) excede umbral realista (>{self.max_pred_pct}%).\")\n","            return\n","\n","        # Precio mínimo de compra (si se especifica)\n","        if self.min_buy_price and price < self.min_buy_price:\n","            print(f\"🔒 Compra bloqueada: precio {price} < MIN_BUY_PRICE_USD {self.min_buy_price}.\")\n","            return\n","\n","        # Apalancamiento adaptivo\n","        lev = self.al.calcular(prediction_strength=min(1.0, max(0.5, signal_strength)))\n","        print(f\"⚙️ Apalancamiento adaptivo aplicado: {lev:.2f}x (Futuros={self.futuros_mode})\")\n","\n","        # Tamaño usando GestorRiesgo\n","        try:\n","            size_usd = self.gestor_riesgo.sugerir_tamano_usd(price)\n","        except Exception:\n","            size_usd = Decimal('0')\n","        size_usd = (size_usd * self.size_multiplier * Decimal(str(lev))).quantize(Decimal('0.01'))\n","        amount = self.gestor_riesgo.calcular_size_btc(size_usd, price)\n","\n","        if amount <= 0:\n","            print(\"❌ Orden fallida: tamaño calculado es 0\")\n","            return\n","\n","        # Place order\n","        resp = await self._api_place(\"buy\", price, amount, lev)\n","        if not resp:\n","            print(\"❌ Error en colocación de orden (sin respuesta)\")\n","            return\n","\n","        self.active_position = {\n","            \"side\": \"buy\",\n","            \"entry\": price,\n","            \"amount\": amount,\n","            \"ts\": time.time(),\n","            \"lev\": lev,\n","            \"signal_strength\": float(signal_strength),\n","            \"objective_min\": self.obj_min_pct,  # objetivo mínimo efectivo (TP)\n","        }\n","        self.trades_done += 1\n","        print(f\"✅ BUY ejecutado: {amount} BTC @ ${price} | Leverage: {lev:.2f}x | #{self.trades_done}/{self.max_trades}\")\n","\n","    async def secure_profit_sale(self, current_price: Decimal):\n","        \"\"\"\n","        Cierra buscando objetivo mínimo efectivo OBJETIVO_MIN_PCT.\n","        Si no alcanza el objetivo dentro de MAX_WAIT_SECONDS, cierra al mejor precio.\n","        \"\"\"\n","        if not self.active_position:\n","            return False\n","\n","        entry = self.active_position[\"entry\"]\n","        amount = self.active_position[\"amount\"]\n","        waited = time.time() - self.active_position[\"ts\"]\n","        min_obj = self.active_position.get(\"objective_min\", Decimal('1.56'))\n","        profit_pct = ((current_price - entry) / (entry if entry > 0 else Decimal('1'))) * Decimal('100')\n","\n","        # Ventana de espera dinámica (acorta con apalancamiento alto)\n","        lev = Decimal(str(self.active_position.get(\"lev\", 1.0)))\n","        # Espera base → MAX_WAIT_SECONDS; con más L, se reduce (máx 40% menos)\n","        effective_wait = int(self.max_wait_seconds * float(max(Decimal('0.60'), Decimal('1.0') - (lev - Decimal('1.0')) * Decimal('0.5'))))\n","\n","        if profit_pct < min_obj and waited < effective_wait:\n","            remain = int((effective_wait - waited) // 1)\n","            print(f\"🛑 TP aún no alcanzado ({float(profit_pct):.2f}% < {float(min_obj):.2f}%). Esperando {remain}s…\")\n","            return False\n","\n","        # Ejecuta cierre\n","        resp = await self._api_close(current_price, amount)\n","        if resp:\n","            print(f\"✅ VENTA ejecutada: {amount} BTC @ ${current_price} | PnL: {float(profit_pct):.2f}%\")\n","            self.active_position = None\n","            return True\n","        print(\"❌ Error al ejecutar venta\")\n","        return False\n","\n","    async def compra_por_liquidacion_improbable(self):\n","        \"\"\"\n","        Compra ante caída rápida >= 4% (potencial rebote) usando el mismo flujo adaptivo.\n","        \"\"\"\n","        try:\n","            print(\"🔍 Evaluando liquidación improbable…\")\n","            par = normalizar_simbolo(os.getenv(\"PAR_TRADING\", \"XBTUSD\"))\n","            ohlc = await self.api.query_public('OHLC', {'pair': par, 'interval': 1, 'count': 5})\n","            if 'result' not in ohlc or par not in ohlc['result']:\n","                print(\"⚠️ OHLC no disponible.\")\n","                return\n","            velas = ohlc['result'][par][-3:]\n","            precios_cierre = [Decimal(v[4]) for v in velas]\n","            precio_actual = precios_cierre[-1]\n","            maximo = max(precios_cierre)\n","            # caída >= 4%\n","            if (maximo - precio_actual) / maximo >= Decimal('0.04'):\n","                print(f\"📉 Caída rápida detectada: {((maximo - precio_actual)/maximo)*100:.2f}%\")\n","                await self.execute_order(\n","                    price=precio_actual,\n","                    signal_strength=1.0,\n","                    predicted_change_pct=float(_as_float_env(\"LIQ_IMPROBABLE_PCT\", 6.0))\n","                )\n","            else:\n","                print(\"🟡 No hay caída suficiente.\")\n","        except Exception as e:\n","            print(f\"🚨 Error en liquidación improbable: {e}\")\n","\n","# ====================================== QuantumTradingCore (FIXED) ======================================\n","class QuantumTradingCore:\n","    \"\"\"\n","    Trading Core robusto con:\n","      - Parche MSE \"same-len\" (evita shape mismatch en Keras/TF).\n","      - Compatibilidad update_market_data → garantiza tuple si el patch global existe.\n","      - Monitoreo con start_monitoring(interval_sec=2).\n","      - Lectura robusta de precio Kraken.\n","    \"\"\"\n","    def __init__(self, api):\n","        self.api = api\n","        self.predictor_alcista = QuantumPredictorAlcista(api)\n","        self.predictor_bajista = QuantumPredictorBajista(api)\n","        self.risk_manager = GestorRiesgo(api)\n","        self.order_executor = EnhancedOrderExecutor(api, self.risk_manager)\n","\n","        # MarketMonitor (firma variable) – pasa objetos y timeout como tenías\n","        self.market_monitor = MarketMonitor(\n","            api, self.predictor_alcista, self.predictor_bajista, self.order_executor,\n","            tiempo_limite_segundos=1800\n","        )\n","\n","        self.signal_comparator = SignalComparator()\n","        self.active_trades = []\n","        self.comparador_btc = ComparadorDatosBTC(api)\n","\n","        # Default de volatilidad si no viene inicializada\n","        if not hasattr(self.risk_manager, 'volatilidad') or self.risk_manager.volatilidad is None:\n","            self.risk_manager.volatilidad = 0.05\n","\n","    # ---------------------------- PARCHE MSE same-len (idempotente) ----------------------------\n","    @staticmethod\n","    def _install_mse_patch():\n","        \"\"\"\n","        Parchea Keras/TF para que 'mean_squared_error' recorte y_true/y_pred al mínimo común.\n","        Safe-idempotente.\n","        \"\"\"\n","        try:\n","            import tensorflow as _tf\n","            try:\n","                import keras as _keras\n","            except Exception:\n","                _keras = None\n","\n","            def _mse_same_len(y_true, y_pred):\n","                yt = _tf.convert_to_tensor(y_true)\n","                yp = _tf.convert_to_tensor(y_pred)\n","                yt = _tf.reshape(yt, (-1, 1))\n","                yp = _tf.reshape(yp, (-1, 1))\n","                n = _tf.minimum(_tf.shape(yt)[0], _tf.shape(yp)[0])\n","                yt = yt[:n]\n","                yp = yp[:n]\n","                return _tf.reduce_mean(_tf.math.squared_difference(yt, yp))\n","\n","            # tf.keras\n","            _tf.keras.losses.mean_squared_error = _mse_same_len\n","            _tf.keras.losses.mse = _mse_same_len\n","            _tf.keras.losses.MSE = _mse_same_len\n","            try:\n","                _tf.keras.utils.get_custom_objects()[\"mean_squared_error\"] = _mse_same_len\n","                _tf.keras.utils.get_custom_objects()[\"mse\"] = _mse_same_len\n","            except Exception:\n","                pass\n","\n","            # keras (si está separado)\n","            if _keras is not None:\n","                _keras.losses.mean_squared_error = _mse_same_len\n","                _keras.losses.mse = _mse_same_len\n","                _keras.losses.MSE = _mse_same_len\n","\n","            # Clase MeanSquaredError\n","            try:\n","                _orig_call = _tf.keras.losses.MeanSquaredError.__call__\n","                def _call_wrapper(self, y_true, y_pred, *a, **k):\n","                    return _mse_same_len(y_true, y_pred)\n","                _tf.keras.losses.MeanSquaredError.__call__ = _call_wrapper\n","            except Exception:\n","                pass\n","        except Exception:\n","            # No fallar si no hay TF/Keras en el entorno\n","            pass\n","\n","    async def initialize(self):\n","        # 1) Parche MSE antes de entrenar\n","        self._install_mse_patch()\n","\n","        # 2) Si existe el parche global para update_market_data → tuple, aplícalo\n","        try:\n","            if 'patch_update_market_data_return_tuple' in globals():\n","                patch_update_market_data_return_tuple(\n","                    core_like=self,\n","                    api=getattr(self, \"api\", None),\n","                    predictor=getattr(self, \"predictor_alcista\", None)  # usamos el alcista como referencia\n","                )\n","        except Exception:\n","            pass\n","\n","        # 3) Inicializaciones como tenías\n","        await self.risk_manager.initialize()\n","        await self.predictor_alcista.entrenar_modelo_inicial()\n","        await self.predictor_bajista.entrenar_modelo_inicial()\n","        await self.reanudar_entrenamiento_desde_json()\n","\n","        # 4) Monitoreo continuo (firma compatible con interval_sec)\n","        asyncio.create_task(self.market_monitor.start_monitoring(interval_sec=2))\n","\n","    # --------------------------------- Precio real Kraken (robusto) ---------------------------------\n","    async def obtener_precio_real_actual(self) -> Decimal:\n","        try:\n","            pair = _kraken_pair_fix(getattr(Config, \"PAR_TRADING\", \"XBT/USD\"))\n","            respuesta = await self.api.query_public('Ticker', {'pair': pair})\n","            return _extract_ticker_last(respuesta)\n","        except Exception as e:\n","            print(f\"❌ Error al obtener el precio real desde Kraken: {e}\")\n","            return Decimal('0')\n","\n","    # ------------------------------------ Estrategia principal -------------------------------------\n","    async def run_strategy(self):\n","        print(\"🚀 Iniciando estrategia de trading cuántico...\")\n","\n","        while True:\n","            try:\n","                # update_market_data puede devolver bool o tupla según implementación;\n","                # no dependemos del retorno para continuar.\n","                _ = await self.market_monitor.update_market_data()\n","\n","                if not getattr(self.market_monitor, \"price_history\", None):\n","                    print(\"⚠️ Sin historial de precios disponible\")\n","                    await asyncio.sleep(int(getattr(Config, \"INTERVAL\", 5)) * 60)\n","                    continue\n","\n","                current_price = await self.obtener_precio_real_actual()\n","                if current_price <= 0:\n","                    await asyncio.sleep(5)\n","                    continue\n","\n","                historial = list(self.market_monitor.price_history)\n","\n","                # Predicción principal (asumida en %)\n","                prediction = self.predictor_alcista.predecir(historial)\n","                if self.comparador_btc:\n","                    prediction = await self.comparador_btc.comparar_y_ajustar_prediccion(float(current_price), prediction)\n","\n","                signal_data = self.signal_comparator.analyze_signal_strength(prediction)\n","                self.signal_comparator.registrar_senal(signal_data['tipo'], prediction)\n","                diferencia = self.signal_comparator.diferencia_promedio()\n","                diferencia_pct = max(abs(diferencia), 0.01)\n","\n","                if signal_data['tipo'] == 'buy':\n","                    print(f\"\\n📈 Señal BUY detectada (Predicción: {prediction:.2f}%)\")\n","                    print(f\"🧮 Diferencia promedio vs SELL: {diferencia_pct:.2f}%\")\n","                elif signal_data['tipo'] == 'sell':\n","                    print(f\"\\n📉 Señal SELL detectada (Predicción: {prediction:.2f}%)\")\n","                    print(f\"🧮 Diferencia promedio vs BUY: {diferencia_pct:.2f}%\")\n","\n","                historia_a = list(getattr(self.predictor_alcista, \"history\", []))\n","                historia_b = list(getattr(self.predictor_bajista, \"history\", []))\n","                futuro_alcista = await self.predictor_alcista.predecir_precio_futuro()\n","                futuro_bajista = await self.predictor_bajista.predecir_precio_futuro()\n","\n","                cambio_alcista = ((futuro_alcista - float(current_price)) / float(current_price)) * 100.0\n","                cambio_bajista = ((futuro_bajista - float(current_price)) / float(current_price)) * 100.0\n","\n","                duracion_tendencia = int(getattr(Config, \"INTERVAL\", 5)) * int(getattr(Config, \"MODEL_INPUT_WINDOW\", 60))\n","                comentario = \"📈 Tendencia alcista dominante\" if cambio_alcista > abs(cambio_bajista) else \"📉 Tendencia bajista dominante\"\n","                alerta_ganancia = \"🔔 ALERTA: Posible ganancia superior al 10%\" if cambio_alcista >= 10 else \"\"\n","\n","                now_ny = datetime.now(timezone('America/New_York'))\n","                print(\"\\n=== 📊 RESUMEN DE ANÁLISIS CUÁNTICO COMPLETO ===\")\n","                print(f\"🕒 Timestamp (NY)           : {now_ny.strftime('%Y-%m-%d %H:%M:%S')}\")\n","                print(f\"💵 Precio actual Kraken     : ${float(current_price):.2f}\")\n","                print(f\"🔮 Proyección ALCISTA       : ${futuro_alcista:.2f} ({cambio_alcista:+.2f}%)\")\n","                print(f\"🔮 Proyección BAJISTA       : ${futuro_bajista:.2f} ({cambio_bajista:+.2f}%)\")\n","                print(f\"📉 Brecha predicciones      : {abs(futuro_alcista - futuro_bajista):.2f} USD\")\n","                print(f\"📈 Tendencia dominante      : {'ALCISTA' if cambio_alcista > abs(cambio_bajista) else 'BAJISTA'}\")\n","                print(f\"📐 Intensidad ALCISTA       : {'Fuerte' if abs(cambio_alcista) > 10 else 'Moderada' if abs(cambio_alcista) > 5 else 'Débil'}\")\n","                print(f\"📐 Intensidad BAJISTA       : {'Fuerte' if abs(cambio_bajista) > 10 else 'Moderada' if abs(cambio_bajista) > 5 else 'Débil'}\")\n","                print(f\"⏱️ Duración estimada        : {duracion_tendencia} minutos\")\n","                print(f\"🧠 Comentario del sistema   : {comentario}\")\n","                if alerta_ganancia:\n","                    print(alerta_ganancia)\n","                if historia_a:\n","                    print(f\"📊 Promedio histórico ALCISTA: {np.mean(historia_a):.2f}\")\n","                if historia_b:\n","                    print(f\"📊 Promedio histórico BAJISTA: {np.mean(historia_b):.2f}\")\n","\n","                decision = self.make_decision(prediction, float(current_price))\n","                if decision == 'buy' and not self.signal_comparator.es_una_buena_compra(prediction):\n","                    print(\"🔒 Compra ignorada por comparación de señales\")\n","                    await asyncio.sleep(int(getattr(Config, \"INTERVAL\", 5)) * 60)\n","                    continue\n","\n","                await self.execute_strategy(decision, prediction, current_price)\n","                await asyncio.sleep(int(getattr(Config, \"INTERVAL\", 5)) * 60)\n","\n","            except Exception as e:\n","                print(f\"🚨 Error en estrategia principal: {e}\")\n","                await asyncio.sleep(60)\n","\n","    # ------------------------------ Reentrenamiento desde JSON --------------------------------\n","    async def reanudar_entrenamiento_desde_json(self):\n","        json_path = 'comparacion_btc.json'\n","        if not os.path.exists(json_path):\n","            print(\"📂 No hay historial previo para reentrenar.\")\n","            return\n","        try:\n","            with open(json_path, 'r') as f:\n","                datos = json.load(f)\n","\n","            precios_x, precios_y = [], []\n","            for entrada in datos:\n","                if 'precio_kraken' in entrada and 'precio_local' in entrada:\n","                    kraken = entrada['precio_kraken']; local = entrada['precio_local']\n","                    if kraken and local:\n","                        precios_x.append(float(kraken)); precios_y.append(float(local))\n","\n","            if len(precios_x) >= int(getattr(Config, \"MODEL_INPUT_WINDOW\", 60)):\n","                print(f\"🔁 Reentrenando con {len(precios_x)} ejemplos desde JSON...\")\n","                await self.predictor_alcista.entrenar_desde_valores(precios_x, precios_y)\n","            else:\n","                print(\"⚠️ Datos insuficientes para reentrenamiento desde JSON.\")\n","        except Exception as e:\n","            print(f\"❌ Error leyendo JSON para reentrenar: {e}\")\n","\n","    # -------------------------------------- Decisión -----------------------------------------\n","    def make_decision(self, prediction: float, current_price: float) -> str:\n","        volatilidad = float(getattr(self.risk_manager, 'volatilidad', 0.05))\n","        buy_threshold = 0.5 + (volatilidad * 10)   # prediction asumido en %\n","        sell_threshold = 0.5 - (volatilidad * 10)\n","        if prediction > buy_threshold: return 'buy'\n","        elif prediction < sell_threshold: return 'sell'\n","        return 'hold'\n","\n","    # -------------------------------- Tamaño de posición -------------------------------------\n","    def calculate_position_size(self, balance: Decimal, price: Decimal, prediction: float) -> Decimal:\n","        risk_adjusted = abs(prediction / 100.0) * float(getattr(Config, \"RISK_FACTOR\", 0.02))\n","        position_value = float(balance) * risk_adjusted\n","        return Decimal(position_value / float(price)).quantize(Decimal('0.00000001'))\n","\n","    # --------------------------------- Ejecución estrategia -----------------------------------\n","    async def execute_strategy(self, decision: str, prediction: float, current_price: Decimal):\n","        if decision == 'hold': return\n","        print(f\"📈 Señal de {decision.upper()} detectada (Predicción: {prediction:.2f}%)\")\n","        await self.order_executor.execute_order(decision, prediction)\n","        if getattr(Config, \"ESTRATEGIAS\", {}).get('volatility_arbitrage', False):\n","            await self.execute_volatility_arbitrage(current_price)\n","\n","    async def execute_volatility_arbitrage(self, current_price: Decimal):\n","        pass  # Mantengo placeholder como tenías\n","\n","    # ----------------------------- Utilidades / Helpers de trading ----------------------------\n","    async def validate_pair_format(self, pair: str) -> str:\n","        validated_pair = pair.replace(\"/\", \"\").upper()\n","        return \"XXBTZUSD\" if \"BTC\" in validated_pair or \"XBTUSD\" in validated_pair else validated_pair\n","\n","    async def check_available_balance(self) -> bool:\n","        balance = await self.api.query_private('Balance')\n","        return 'error' not in balance\n","\n","    async def is_pair_active(self, pair: str) -> bool:\n","        try:\n","            asset_info = await self.api.query_public('AssetPairs', {'pair': pair})\n","            return bool(asset_info.get('result'))\n","        except:\n","            return False\n","\n","    async def place_order_with_retry(self, params: dict, retries: int = 3):\n","        for attempt in range(retries):\n","            try:\n","                order = await self.api.query_private('AddOrder', params)\n","                if 'error' in order and order['error']:\n","                    print(f\"⚠️ Error en AddOrder intento {attempt + 1}: {order['error']}\")\n","                    await asyncio.sleep(2); continue\n","                return order\n","            except Exception as e:\n","                print(f\"⚠️ Excepción en intento {attempt + 1}: {str(e)}\")\n","                await asyncio.sleep(2)\n","        return None\n","\n","# ==================== CONFIGURADOR FILOSÓFICO DE BOT ====================\n","from collections import deque\n","from typing import Any, Optional\n","\n","class FilosofiaTradingConfigurator:\n","    \"\"\"\n","    Conecta principios filosóficos a un núcleo de bot (bot_core).\n","    No asume clases específicas; usa atributos comunes si existen.\n","    \"\"\"\n","    def __init__(self, bot_core: Any):\n","        self.bot = bot_core\n","        # Garantiza contenedores esperados\n","        if not hasattr(self.bot, 'rules') or not isinstance(getattr(self.bot, 'rules'), list):\n","            self.bot.rules = []\n","        # Flags por defecto\n","        self.bot.etica_activa = getattr(self.bot, 'etica_activa', False)\n","        self.bot.feedback_loop_activa = getattr(self.bot, 'feedback_loop_activa', False)\n","        self.bot.informacion_priorizada = getattr(self.bot, 'informacion_priorizada', False)\n","        self.bot.multidecision_activa = getattr(self.bot, 'multidecision_activa', False)\n","\n","    def aplicar_racionalismo(self):\n","        reglas_logicas = [\n","            lambda data: data.get('tendencia') == 'alcista' and float(data.get('fuerza', 0.0)) > 0.8,\n","            lambda data: float(data.get('volatilidad', 1.0)) < 0.05\n","        ]\n","        self.bot.rules.extend(reglas_logicas)\n","        print(\"✅ Racionalismo aplicado: reglas lógicas integradas\")\n","\n","    def aplicar_empirismo(self):\n","        if hasattr(self.bot, 'predictor'):\n","            print(\"✅ Empirismo activo: modelo cuántico-empírico entrenado\")\n","        else:\n","            print(\"⚠️ No se encontró el predictor para aplicar empirismo\")\n","\n","    def aplicar_conexionismo(self):\n","        if hasattr(self.bot, 'predictor') and hasattr(self.bot.predictor, 'model'):\n","            print(\"✅ Conexionismo activo: red neuronal profunda en uso\")\n","        else:\n","            print(\"⚠️ No se encontró el modelo para aplicar conexionismo\")\n","\n","    def aplicar_funcionalismo(self):\n","        print(\"✅ Funcionalismo activo: arquitectura modular habilitada\")\n","\n","    def aplicar_filosofia_lenguaje(self):\n","        try:\n","            from transformers import pipeline  # opcional\n","            self.bot.sentiment_analyzer = pipeline(\"sentiment-analysis\")\n","            print(\"✅ Análisis de sentimiento habilitado\")\n","        except Exception:\n","            # No bloquea la ejecución si no hay transformers\n","            print(\"⚠️ No se pudo habilitar el análisis de sentimiento (transformers no disponible)\")\n","\n","    def aplicar_etica(self):\n","        self.bot.etica_activa = True\n","        print(\"✅ Ética activa: habilitada auditoría y transparencia de decisiones\")\n","\n","    def aplicar_cibernetica(self):\n","        self.bot.feedback_loop_activa = True\n","        print(\"✅ Cibernética activa: retroalimentación automática configurada\")\n","\n","    def aplicar_teoria_informacion(self):\n","        self.bot.informacion_priorizada = True\n","        print(\"✅ Teoría de la información activa: filtrado y priorización de datos optimizada\")\n","\n","    def aplicar_teoria_decision(self):\n","        self.bot.multidecision_activa = True\n","        print(\"✅ Teoría de la decisión activa: análisis de escenarios múltiples habilitado\")\n","\n","    def configurar_todo(self):\n","        print(\"\\n=== Configurando sistema según teorías filosóficas ===\")\n","        self.aplicar_racionalismo()\n","        self.aplicar_empirismo()\n","        self.aplicar_conexionismo()\n","        self.aplicar_funcionalismo()\n","        self.aplicar_filosofia_lenguaje()\n","        self.aplicar_etica()\n","        self.aplicar_cibernetica()\n","        self.aplicar_teoria_informacion()\n","        self.aplicar_teoria_decision()\n","        print(\"\\n✅ Configuración filosófica completa\")\n","\n","\n","# ==================== EXTENSIÓN DE LÓGICA DE DECISIÓN - ANÁLISIS COMPARATIVO ====================\n","class SignalComparator:\n","    \"\"\"\n","    Compara señales BUY/SELL recientes, calcula diferencia promedio\n","    y sugiere si la compra actual es atractiva.\n","    \"\"\"\n","    def __init__(self):\n","        self.last_prediction: Optional[float] = None\n","        self.buy_signals = deque(maxlen=5)\n","        self.sell_signals = deque(maxlen=5)\n","\n","    def analyze_signal_strength(self, prediction: float) -> dict:\n","        abs_pred = abs(float(prediction))\n","        if abs_pred > 100:\n","            level = \"extrema\"\n","        elif abs_pred > 50:\n","            level = \"fuerte\"\n","        elif abs_pred > 10:\n","            level = \"moderada\"\n","        else:\n","            level = \"débil\"\n","\n","        tipo = 'buy' if prediction > 0 else 'sell'\n","        return {\n","            'tipo': tipo,\n","            'nivel': level,\n","            'valor': float(prediction)\n","        }\n","\n","    def registrar_senal(self, tipo: str, valor: float):\n","        try:\n","            v = float(valor)\n","        except Exception:\n","            v = 0.0\n","        if tipo == 'buy':\n","            self.buy_signals.append(v)\n","        elif tipo == 'sell':\n","            self.sell_signals.append(v)\n","\n","    def diferencia_promedio(self) -> float:\n","        if len(self.buy_signals) == 0 or len(self.sell_signals) == 0:\n","            return 0.0\n","        avg_buy = sum(self.buy_signals) / len(self.buy_signals)\n","        avg_sell = sum(self.sell_signals) / len(self.sell_signals)\n","        return avg_buy - abs(avg_sell)\n","\n","    def es_una_buena_compra(self, prediccion_actual: float) -> bool:\n","        diferencia = self.diferencia_promedio()\n","        try:\n","            pa = float(prediccion_actual)\n","        except Exception:\n","            pa = 0.0\n","        return diferencia > 5.0 and pa > 4.0\n","\n","    # ----------- Utilidades de impresión/uso inmediato -----------\n","    def imprimir_resumen(self, prediccion_actual: float):\n","        info = self.analyze_signal_strength(prediccion_actual)\n","        self.registrar_senal(info['tipo'], info['valor'])\n","        dif = self.diferencia_promedio()\n","        ok = self.es_una_buena_compra(prediccion_actual)\n","        print(\n","            \"🧮 Comparador de Señales | \"\n","            f\"tipo={info['tipo']} nivel={info['nivel']} valor={info['valor']:.4f} | \"\n","            f\"Δprom={dif:.4f} | ¿Buena compra? {'✅ Sí' if ok else '❌ No'}\"\n","        )\n","        self.last_prediction = float(prediccion_actual)\n","\n","\n","# ==================== INTEGRACIÓN RÁPIDA CON EL SISTEMA (hooks listos) ====================\n","def wire_filosofia_y_comparador(bot_core: Any) -> tuple[FilosofiaTradingConfigurator, SignalComparator]:\n","    \"\"\"\n","    Conecta el configurador filosófico y el comparador al bot_core (p.ej. ultra_executor).\n","    Devuelve (configurador, comparador). Imprime estado de conexión.\n","    \"\"\"\n","    cfg = FilosofiaTradingConfigurator(bot_core)\n","    cfg.configurar_todo()\n","    comp = SignalComparator()\n","    setattr(bot_core, \"signal_comparator\", comp)\n","    print(\"✅ Filosofía y SignalComparator conectados al bot_core\")\n","    return cfg, comp\n","\n","\n","async def run_signal_comparator_loop(\n","    comparator: SignalComparator,\n","    trading_core: Any,\n","    obtener_precio_actual_async\n","):\n","    \"\"\"\n","    Loop asíncrono para mantener el comparador sincronizado con tus predictores.\n","    - Lee el precio actual con obtener_precio_actual_async()\n","    - Obtiene predicciones alcista/bajista desde trading_core\n","    - Combina una predicción neta y la imprime con el comparador\n","    \"\"\"\n","    import asyncio\n","    interval_s = 60  # 1 minuto entre evaluaciones\n","    while True:\n","        try:\n","            px = await obtener_precio_actual_async()\n","            # Predicciones base (tolerantes a errores)\n","            try:\n","                pa = await trading_core.predictor_alcista.predecir_ajustada(px)\n","            except Exception:\n","                pa = 0.0\n","            try:\n","                pb = await trading_core.predictor_bajista.predecir_ajustada(px)\n","            except Exception:\n","                pb = 0.0\n","\n","            # Predicción neta simple (ajústalo si tu semántica difiere)\n","            try:\n","                pred_neta = float(pa) - float(pb)\n","            except Exception:\n","                pred_neta = 0.0\n","\n","            print(\n","                \"📟 Señales base | \"\n","                f\"px={px:.2f} | alcista={float(pa):.4f} bajista={float(pb):.4f} | neta={pred_neta:.4f}\"\n","            )\n","            comparator.imprimir_resumen(pred_neta)\n","        except Exception as e:\n","            print(f\"⚠️ Loop comparador: {e}\")\n","        await asyncio.sleep(interval_s)\n","\n","\n","\n","# ==================== comparador_datos_btc.py ====================\n","import os\n","import json\n","import time\n","import math\n","import random\n","import requests\n","from typing import Optional, Dict, Any, Tuple, Callable, List\n","from datetime import datetime, timezone as dt_timezone\n","from urllib.parse import urlparse\n","\n","from tenacity import retry, wait_exponential, stop_after_attempt, retry_if_exception_type\n","\n","# ---------------------- Config por ENV ----------------------\n","USER_AGENT = os.getenv(\"PRICE_UA\", \"BTC-Intel/3.0 (+https://local) Python-Requests\")\n","DEFAULT_TIMEOUT = int(os.getenv(\"HTTP_TIMEOUT_SECONDS\", \"10\"))\n","\n","# Evita 429 en CoinGecko con cadencia local\n","COINGECKO_MIN_INTERVAL_S = float(os.getenv(\"COINGECKO_MIN_INTERVAL_S\", \"12.0\"))  # ~5 req/min\n","# Caché “fresca” si CoinGecko falla\n","COINGECKO_TTL_SECONDS = int(os.getenv(\"COINGECKO_TTL_SECONDS\", \"90\"))\n","# Backoff si no viene Retry-After\n","DEFAULT_RETRY_AFTER_S = float(os.getenv(\"DEFAULT_RETRY_AFTER_S\", \"60\"))\n","\n","# Rotación de claves\n","API_KEY_MIN_INTERVAL_S = float(os.getenv(\"API_KEY_MIN_INTERVAL_S\", \"12.0\"))\n","API_KEY_COOLDOWN_S     = float(os.getenv(\"API_KEY_COOLDOWN_S\", \"180\"))\n","\n","# Proxies\n","PROXY_POOL          = [p.strip() for p in os.getenv(\"PROXY_POOL\", \"\").split(\",\") if p.strip()]\n","PROXY_MIN_INTERVAL  = float(os.getenv(\"PROXY_MIN_INTERVAL_S\", \"10\"))\n","PROXY_COOLDOWN_S    = float(os.getenv(\"PROXY_COOLDOWN_S\", \"180\"))\n","PROXY_TEST_URL      = os.getenv(\"PROXY_TEST_URL\", \"https://api.kraken.com/0/public/Time\")\n","PROXY_TEST_TIMEOUT  = float(os.getenv(\"PROXY_TEST_TIMEOUT\", \"4\"))\n","PROXY_MAX_TRIES     = int(os.getenv(\"PROXY_MAX_TRIES\", \"3\"))\n","PROXY_VERIFY_SSL    = os.getenv(\"PROXY_VERIFY_SSL\", \"1\") == \"1\"\n","\n","# Métricas\n","METRICS_ENABLE   = os.getenv(\"METRICS_ENABLE\", \"1\") == \"1\"\n","PRICE_METRICS_CSV = os.getenv(\"PRICE_METRICS_CSV\", \"price_metrics_log.csv\")\n","\n","# Fuentes habilitables\n","ENABLE_BINANCE   = os.getenv(\"ENABLE_BINANCE\", \"1\") == \"1\"\n","ENABLE_YAHOO     = os.getenv(\"ENABLE_YAHOO\", \"1\") == \"1\"\n","ENABLE_BITSTAMP  = os.getenv(\"ENABLE_BITSTAMP\", \"1\") == \"1\"\n","ENABLE_PAPRIKA   = os.getenv(\"ENABLE_PAPRIKA\", \"1\") == \"1\"\n","ENABLE_COINBASE  = os.getenv(\"ENABLE_COINBASE\", \"1\") == \"1\"\n","ENABLE_BITFINEX  = os.getenv(\"ENABLE_BITFINEX\", \"1\") == \"1\"\n","ENABLE_OKX       = os.getenv(\"ENABLE_OKX\", \"1\") == \"1\"\n","ENABLE_CMC       = os.getenv(\"ENABLE_CMC\", \"1\") == \"1\"  # CoinMarketCap (si tienes keys)\n","\n","def _now_utc_iso():\n","    return datetime.now(dt_timezone.utc).isoformat(timespec=\"seconds\")\n","\n","def _now_ts() -> float:\n","    return time.time()\n","\n","# --------- TZ robusta (ZoneInfo -> pytz -> UTC) ---------\n","def _tz_newyork():\n","    try:\n","        from zoneinfo import ZoneInfo\n","        return ZoneInfo(\"America/New_York\")\n","    except Exception:\n","        try:\n","            import pytz\n","            return pytz.timezone(\"America/New_York\")\n","        except Exception:\n","            return dt_timezone.utc\n","\n","# ===================== utilidades internas =====================\n","class _SoftRateLimit(Exception):\n","    \"\"\"Control local de cadencia para evitar 429 sin bloquear.\"\"\"\n","    pass\n","\n","def _mask_tail(s: Optional[str]) -> str:\n","    if not s: return \"\"\n","    s = str(s)\n","    tail = s[-4:] if len(s) >= 4 else s\n","    return f\"***{tail}\"\n","\n","class MetricsLogger:\n","    FIELDS = [\"ts_utc\",\"provider\",\"url_host\",\"status\",\"duration_ms\",\"used_key\",\"proxy\",\"outcome\",\"error\"]\n","    def __init__(self, csv_path: str):\n","        self.csv_path = csv_path\n","        try:\n","            if METRICS_ENABLE and not os.path.exists(csv_path):\n","                with open(csv_path, \"w\", encoding=\"utf-8\", newline=\"\") as f:\n","                    f.write(\",\".join(self.FIELDS) + \"\\n\")\n","        except Exception:\n","            pass\n","    def log(self, provider: str, url: str, status: Optional[int], duration_ms: float,\n","            used_key: Optional[str], proxy_label: Optional[str], outcome: str, error: Optional[str] = None):\n","        if not METRICS_ENABLE:\n","            return\n","        try:\n","            row = [\n","                _now_utc_iso(),\n","                provider or \"\",\n","                urlparse(url).hostname or \"\",\n","                str(status if status is not None else \"\"),\n","                f\"{duration_ms:.1f}\",\n","                _mask_tail(used_key),\n","                proxy_label or \"\",\n","                outcome,\n","                (error or \"\").replace(\",\", \";\")[:500],\n","            ]\n","            with open(self.csv_path, \"a\", encoding=\"utf-8\", newline=\"\") as f:\n","                f.write(\",\".join(row) + \"\\n\")\n","        except Exception:\n","            pass\n","\n","class ApiKeyRotator:\n","    \"\"\"\n","    Rotador de claves por proveedor. Respeta intervalo mínimo por clave\n","    y aplica cooldown por Retry-After o por códigos 401/403/429.\n","    \"\"\"\n","    def __init__(self, provider: str, header_name: str, keys: List[str],\n","                 per_key_min_interval_s: float = API_KEY_MIN_INTERVAL_S,\n","                 default_cooldown_s: float = API_KEY_COOLDOWN_S):\n","        self.provider = provider\n","        self.header_name = header_name\n","        self.keys = [k.strip() for k in keys if k and k.strip()]\n","        self.per_key_min_interval_s = per_key_min_interval_s\n","        self.default_cooldown_s = default_cooldown_s\n","        self._last_used: Dict[str, float] = {}\n","        self._cooldown_until: Dict[str, float] = {}\n","        self._active_key: Optional[str] = None\n","        self._cursor = 0\n","\n","    def has_keys(self) -> bool:\n","        return len(self.keys) > 0\n","\n","    def _is_ready(self, key: str) -> bool:\n","        now = _now_ts()\n","        if now < self._cooldown_until.get(key, 0.0):\n","            return False\n","        last = self._last_used.get(key, 0.0)\n","        return (now - last) >= self.per_key_min_interval_s\n","\n","    def _pick_key(self) -> Optional[str]:\n","        if not self.has_keys():\n","            return None\n","        n = len(self.keys)\n","        for i in range(n):\n","            k = self.keys[(self._cursor + i) % n]\n","            if self._is_ready(k):\n","                self._cursor = (self._cursor + i + 1) % n\n","                return k\n","        # en última instancia, toma la más cercana a salir de cooldown\n","        candidates = sorted(self.keys, key=lambda k: self._cooldown_until.get(k, 0.0))\n","        for k in candidates:\n","            if _now_ts() >= self._cooldown_until.get(k, 0.0):\n","                return k\n","        return None\n","\n","    def next_headers(self) -> Tuple[Dict[str, str], Optional[str]]:\n","        key = self._pick_key()\n","        self._active_key = key\n","        if key is None:\n","            return {}, None\n","        return {self.header_name: key}, key\n","\n","    def record_success(self):\n","        if self._active_key:\n","            self._last_used[self._active_key] = _now_ts()\n","\n","    def record_throttle_or_auth(self, retry_after: Optional[float] = None):\n","        if self._active_key:\n","            wait_s = retry_after if (retry_after and retry_after > 0) else self.default_cooldown_s\n","            self._cooldown_until[self._active_key] = _now_ts() + wait_s\n","\n","class ProxyRotator:\n","    \"\"\"\n","    Rotación de proxies con health-check, cooldown y min-interval.\n","    Cada proxy se provee como URL (http/https). Ej: http://user:pass@host:port\n","    \"\"\"\n","    def __init__(self, proxies: List[str],\n","                 per_proxy_min_interval_s: float = PROXY_MIN_INTERVAL,\n","                 default_cooldown_s: float = PROXY_COOLDOWN_S):\n","        self.proxies = [p for p in proxies if p]\n","        self.per_proxy_min_interval_s = per_proxy_min_interval_s\n","        self.default_cooldown_s = default_cooldown_s\n","        self._last_used: Dict[str, float] = {}\n","        self._cooldown_until: Dict[str, float] = {}\n","        self._latency_ms: Dict[str, float] = {}  # medido en health-check\n","        self._cursor = 0\n","        self._session = requests.Session()\n","        self._session.headers.update({\"User-Agent\": USER_AGENT})\n","\n","    def has_proxies(self) -> bool:\n","        return len(self.proxies) > 0\n","\n","    def _label(self, proxy_url: str) -> str:\n","        try:\n","            up = urlparse(proxy_url)\n","            host = up.hostname or \"\"\n","            port = up.port or \"\"\n","            return f\"{host}:{port}\"\n","        except Exception:\n","            return proxy_url\n","\n","    def _is_ready(self, proxy_url: str) -> bool:\n","        now = _now_ts()\n","        if now < self._cooldown_until.get(proxy_url, 0.0):\n","            return False\n","        last = self._last_used.get(proxy_url, 0.0)\n","        return (now - last) >= self.per_proxy_min_interval_s\n","\n","    def _pick(self) -> Optional[str]:\n","        if not self.has_proxies():\n","            return None\n","        n = len(self.proxies)\n","        # prioriza menor latencia conocida\n","        ordered = sorted(range(n), key=lambda i: self._latency_ms.get(self.proxies[i], float(\"inf\")))\n","        for idx in ordered:\n","            purl = self.proxies[idx]\n","            if self._is_ready(purl):\n","                return purl\n","        # si ninguna “lista”, usa round-robin simple\n","        for i in range(n):\n","            purl = self.proxies[(self._cursor + i) % n]\n","            if _now_ts() >= self._cooldown_until.get(purl, 0.0):\n","                self._cursor = (self._cursor + i + 1) % n\n","                return purl\n","        return None\n","\n","    def _health_check(self, proxy_url: str) -> bool:\n","        try:\n","            t0 = time.perf_counter()\n","            r = self._session.get(PROXY_TEST_URL, timeout=PROXY_TEST_TIMEOUT,\n","                                  proxies={\"http\": proxy_url, \"https\": proxy_url}, verify=PROXY_VERIFY_SSL)\n","            dt_ms = (time.perf_counter() - t0) * 1000.0\n","            if 200 <= r.status_code < 500:  # consideramos OK para endpoint público simple\n","                self._latency_ms[proxy_url] = dt_ms\n","                return True\n","        except Exception:\n","            pass\n","        return False\n","\n","    def next_proxies(self) -> Tuple[Optional[Dict[str, str]], Optional[str]]:\n","        purl = self._pick()\n","        if not purl:\n","            return None, None\n","        # health-check perezoso\n","        if purl not in self._latency_ms and not self._health_check(purl):\n","            # proxy no sano → cooldown y no usarlo ahora\n","            self.record_failure(self._label(purl))\n","            return None, None\n","        self._last_used[purl] = _now_ts()\n","        label = self._label(purl)\n","        return {\"http\": purl, \"https\": purl}, label\n","\n","    def record_success(self, label: Optional[str]):\n","        # nada especial; el min-interval ya se respeta con _last_used\n","        pass\n","\n","    def record_failure(self, label: Optional[str], cooldown_s: Optional[float] = None):\n","        if not label:\n","            return\n","        # mapear label -> url exacto\n","        for purl in self.proxies:\n","            if self._label(purl) == label:\n","                self._cooldown_until[purl] = _now_ts() + (cooldown_s or self.default_cooldown_s)\n","                break\n","\n","# ======================= COMPARADOR DE PRECIOS =======================\n","class ComparadorDatosBTC:\n","    \"\"\"\n","    Agregador de precios con caché, backoff, rutas múltiples, rotación de claves y proxies.\n","    Mantiene firmas públicas originales.\n","    \"\"\"\n","    def __init__(self, api, coinmarketcap_api_key: Optional[str] = None):\n","        self.api = api\n","        self.kraken_precio: Optional[float] = None\n","        self.cache_path = \"coingecko_cache.json\"\n","        # Compat con firma original; no imprescindible si usas COINGECKO/CMC desde ENV\n","        self.coinmarketcap_api_key = coinmarketcap_api_key or os.getenv(\"COINMARKETCAP_API_KEY\")\n","\n","        # Sesión HTTP\n","        self._session = requests.Session()\n","        self._session.headers.update({\n","            \"User-Agent\": USER_AGENT,\n","            \"Accept\": \"application/json, text/plain, */*\",\n","            \"Accept-Language\": \"en-US,en;q=0.9\",\n","            \"Cache-Control\": \"no-cache\",\n","            \"Pragma\": \"no-cache\",\n","        })\n","        self._verify_ssl = PROXY_VERIFY_SSL\n","        self._metrics = MetricsLogger(PRICE_METRICS_CSV)\n","\n","        self._fail_counts: Dict[str, int] = {}\n","        self._last_hit_ts: Dict[str, float] = {}     # cadencia por dominio\n","        self._next_allowed_ts: Dict[str, float] = {} # bloqueos Retry-After\n","\n","        # --- Rotadores de clave por proveedor ---\n","        cg_keys = os.getenv(\"COINGECKO_API_KEYS\", \"\").split(\",\")\n","        cmc_keys = os.getenv(\"CMC_API_KEYS\", \"\").split(\",\")\n","        # CoinGecko (Pro): header x-cg-pro-api-key\n","        self._rot_cg  = ApiKeyRotator(\"coingecko\", \"x-cg-pro-api-key\", cg_keys)\n","        # CoinMarketCap Pro: header X-CMC_PRO_API_KEY\n","        if self.coinmarketcap_api_key and self.coinmarketcap_api_key.strip():\n","            cmc_keys = [self.coinmarketcap_api_key] + [k for k in cmc_keys if k.strip()]\n","        self._rot_cmc = ApiKeyRotator(\"coinmarketcap\", \"X-CMC_PRO_API_KEY\", cmc_keys)\n","\n","        # --- Rotador de proxies ---\n","        self._rot_proxy = ProxyRotator(PROXY_POOL)\n","\n","    # -------------------- Aux --------------------\n","    def _inc(self, key: str):\n","        self._fail_counts[key] = self._fail_counts.get(key, 0) + 1\n","\n","    def _ok(self, key: str):\n","        self._fail_counts[key] = 0\n","\n","    def _respect_rate(self, key: str, min_interval: float):\n","        now = _now_ts()\n","        block = self._next_allowed_ts.get(key, 0.0)\n","        if now < block:\n","            raise _SoftRateLimit(f\"{key} bloqueado hasta {block:.0f} (Retry-After)\")\n","        last = self._last_hit_ts.get(key, 0.0)\n","        delta = now - last\n","        if delta < min_interval:\n","            raise _SoftRateLimit(f\"{key} respeta intervalo {min_interval}s (delta={delta:.2f}s)\")\n","        self._last_hit_ts[key] = now\n","\n","    def _set_retry_after(self, key: str, seconds: float):\n","        self._next_allowed_ts[key] = _now_ts() + max(0.0, seconds)\n","\n","    @retry(\n","        wait=wait_exponential(multiplier=1, min=0.5, max=8),\n","        stop=stop_after_attempt(3),\n","        retry=retry_if_exception_type(requests.RequestException),\n","        reraise=True\n","    )\n","    def _get_json(self, url: str, timeout: int = DEFAULT_TIMEOUT,\n","                  headers: Optional[Dict[str, str]] = None,\n","                  meta_provider: Optional[str] = None,\n","                  meta_used_key: Optional[str] = None) -> Dict[str, Any]:\n","        \"\"\"\n","        Obtiene JSON con soporte de:\n","          - Rotación de proxies (varios intentos) y fallback directo\n","          - Métricas a CSV por intento\n","        \"\"\"\n","        provider = meta_provider or (urlparse(url).hostname or \"\")\n","        used_key = meta_used_key\n","        err_last: Optional[str] = None\n","\n","        # 1) Intentos con proxies si hay pool\n","        tries = 0\n","        while self._rot_proxy.has_proxies() and tries < max(1, PROXY_MAX_TRIES):\n","            tries += 1\n","            proxies, label = self._rot_proxy.next_proxies()\n","            if not proxies:\n","                break\n","            t0 = time.perf_counter()\n","            status = None\n","            try:\n","                r = self._session.get(url, timeout=timeout, headers=(headers or {}),\n","                                      proxies=proxies, verify=self._verify_ssl)\n","                status = r.status_code\n","                r.raise_for_status()\n","                data = r.json()\n","                dt_ms = (time.perf_counter() - t0) * 1000.0\n","                self._rot_proxy.record_success(label)\n","                self._metrics.log(provider, url, status, dt_ms, used_key, label, \"success\", None)\n","                return data\n","            except requests.HTTPError as e:\n","                status = e.response.status_code if e.response is not None else None\n","                err_last = f\"HTTP {status}\"\n","                self._rot_proxy.record_failure(label, cooldown_s=(DEFAULT_RETRY_AFTER_S if status in (401,403,429,451,503) else None))\n","                dt_ms = (time.perf_counter() - t0) * 1000.0\n","                self._metrics.log(provider, url, status, dt_ms, used_key, label, \"error\", err_last)\n","                # probar siguiente proxy\n","            except Exception as e:\n","                err_last = type(e).__name__\n","                self._rot_proxy.record_failure(label)\n","                dt_ms = (time.perf_counter() - t0) * 1000.0\n","                self._metrics.log(provider, url, None, dt_ms, used_key, label, \"error\", err_last)\n","                # probar siguiente proxy\n","\n","        # 2) Fallback directo (sin proxy)\n","        t0 = time.perf_counter()\n","        status = None\n","        r = self._session.get(url, timeout=timeout, headers=(headers or {}), verify=self._verify_ssl)\n","        status = r.status_code\n","        r.raise_for_status()\n","        data = r.json()\n","        dt_ms = (time.perf_counter() - t0) * 1000.0\n","        self._metrics.log(provider, url, status, dt_ms, used_key, None, \"success\", None)\n","        return data\n","\n","    # -------------------- Fuentes --------------------\n","    def obtener_precio_coingecko(self) -> Optional[float]:\n","        \"\"\"\n","        Soporta público y Pro. Si hay keys en COINGECKO_API_KEYS, rota y añade header x-cg-pro-api-key.\n","        \"\"\"\n","        key = \"coingecko\"\n","        url = \"https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd\"\n","        try:\n","            self._respect_rate(key, COINGECKO_MIN_INTERVAL_S)\n","            extra_headers, used_key = self._rot_cg.next_headers() if self._rot_cg.has_keys() else ({}, None)\n","\n","            data = self._get_json(url, headers=extra_headers, meta_provider=key, meta_used_key=used_key)\n","            px = float(data[\"bitcoin\"][\"usd\"])\n","            self._guardar_cache(px)\n","            self._ok(key)\n","            if used_key: self._rot_cg.record_success()\n","            print(f\"✅ CoinGecko OK: {px}{' (Pro)' if used_key else ''}\")\n","            return px\n","\n","        except _SoftRateLimit as sl:\n","            px = self._cargar_cache(valid_within=COINGECKO_TTL_SECONDS)\n","            if px is not None:\n","                print(f\"⏳ CoinGecko diferido ({sl}). Caché: {px}\")\n","                return px\n","            print(f\"⏳ CoinGecko diferido ({sl}). Sin caché fresca.\")\n","            return None\n","\n","        except requests.HTTPError as e:\n","            status = e.response.status_code if e.response is not None else None\n","            retry_after = None\n","            if e.response is not None:\n","                ra = e.response.headers.get(\"Retry-After\")\n","                retry_after = float(ra) if (ra and ra.strip().isdigit()) else None\n","\n","            if status in (401, 403, 429):\n","                if self._rot_cg.has_keys():\n","                    self._rot_cg.record_throttle_or_auth(retry_after or DEFAULT_RETRY_AFTER_S)\n","                self._set_retry_after(key, (retry_after or DEFAULT_RETRY_AFTER_S))\n","                px = self._cargar_cache(valid_within=COINGECKO_TTL_SECONDS)\n","                if px is not None:\n","                    print(f\"⚠️ CoinGecko {status}. Retry-After={retry_after or DEFAULT_RETRY_AFTER_S:.0f}s. Caché: {px}\")\n","                    return px\n","                print(f\"⚠️ CoinGecko {status}. Retry-After={retry_after or DEFAULT_RETRY_AFTER_S:.0f}s. Sin caché fresca.\")\n","                return None\n","\n","            self._inc(key)\n","            print(f\"⚠️ CoinGecko HTTP: {e}\")\n","            return self._cargar_cache(valid_within=COINGECKO_TTL_SECONDS)\n","\n","        except Exception as e:\n","            self._inc(key)\n","            print(f\"⚠️ CoinGecko falló: {e}\")\n","            return self._cargar_cache(valid_within=COINGECKO_TTL_SECONDS)\n","\n","    def obtener_precio_coinmarketcap(self) -> Optional[float]:\n","        \"\"\"\n","        Requiere API key en CMC_API_KEYS o parámetro coinmarketcap_api_key. Rota automáticamente.\n","        \"\"\"\n","        if not ENABLE_CMC or (not self._rot_cmc.has_keys()):\n","            return None\n","        url = \"https://pro-api.coinmarketcap.com/v2/cryptocurrency/quotes/latest?symbol=BTC&convert=USD\"\n","        try:\n","            extra_headers, used_key = self._rot_cmc.next_headers()\n","            data = self._get_json(url, headers=extra_headers, meta_provider=\"coinmarketcap\", meta_used_key=used_key)\n","            # v2: data['data']['BTC'][0]['quote']['USD']['price']\n","            ddata = data.get(\"data\", {})\n","            price = None\n","            if \"BTC\" in ddata:\n","                entry = ddata[\"BTC\"]\n","                if isinstance(entry, list) and entry:\n","                    quote = (entry[0].get(\"quote\") or {}).get(\"USD\") or {}\n","                    price = quote.get(\"price\")\n","                elif isinstance(entry, dict):\n","                    quote = (entry.get(\"quote\") or {}).get(\"USD\") or {}\n","                    price = quote.get(\"price\")\n","            if price is None:\n","                raise ValueError(\"Formato inesperado en CMC\")\n","            px = float(price)\n","            self._ok(\"coinmarketcap\")\n","            self._rot_cmc.record_success()\n","            print(f\"✅ CoinMarketCap OK: {px}\")\n","            return px\n","        except requests.HTTPError as e:\n","            status = e.response.status_code if e.response is not None else None\n","            retry_after = None\n","            if e.response is not None:\n","                ra = e.response.headers.get(\"Retry-After\")\n","                retry_after = float(ra) if (ra and ra.strip().isdigit()) else None\n","            if status in (401, 403, 429):\n","                self._rot_cmc.record_throttle_or_auth(retry_after or API_KEY_COOLDOWN_S)\n","                print(f\"⚠️ CMC {status}. Cooldown clave aplicado ({retry_after or API_KEY_COOLDOWN_S:.0f}s).\")\n","                return None\n","            print(f\"⚠️ CMC HTTP: {e}\")\n","            return None\n","        except Exception as e:\n","            print(f\"⚠️ CMC falló: {e}\")\n","            return None\n","\n","    def obtener_precio_binance(self) -> Optional[float]:\n","        if not ENABLE_BINANCE:\n","            return None\n","        try:\n","            data = self._get_json(\"https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT\", meta_provider=\"binance\")\n","            px = float(data[\"price\"])\n","            self._ok(\"binance\")\n","            print(f\"✅ Binance OK: {px}\")\n","            return px\n","        except requests.HTTPError as e:\n","            if e.response is not None and e.response.status_code == 451:\n","                print(\"⛔️ Binance bloqueado por región (HTTP 451). Saltando...\")\n","                return None\n","            print(f\"⚠️ Binance HTTP: {e}\")\n","            return None\n","        except Exception as e:\n","            self._inc(\"binance\")\n","            print(f\"⚠️ Binance falló: {e}\")\n","            return None\n","\n","    def obtener_precio_yahoo(self) -> Optional[float]:\n","        if not ENABLE_YAHOO:\n","            return None\n","        try:\n","            data = self._get_json(\"https://query1.finance.yahoo.com/v8/finance/chart/BTC-USD\", meta_provider=\"yahoo\")\n","            result = (data.get(\"chart\", {}).get(\"result\") or [None])[0] or {}\n","            meta = result.get(\"meta\", {})\n","            px = float(meta.get(\"regularMarketPrice\"))\n","            self._ok(\"yahoo\")\n","            print(f\"✅ Yahoo OK: {px}\")\n","            return px\n","        except requests.HTTPError as e:\n","            if e.response is not None and e.response.status_code == 429:\n","                print(\"⚠️ Yahoo 429 rate-limit.\")\n","                return None\n","            print(f\"⚠️ Yahoo HTTP: {e}\")\n","            return None\n","        except Exception as e:\n","            self._inc(\"yahoo\")\n","            print(f\"⚠️ Yahoo falló: {e}\")\n","            return None\n","\n","    def obtener_precio_bitstamp(self) -> Optional[float]:\n","        if not ENABLE_BITSTAMP:\n","            return None\n","        try:\n","            data = self._get_json(\"https://www.bitstamp.net/api/v2/ticker/btcusd/\", meta_provider=\"bitstamp\")\n","            px = float(data[\"last\"])\n","            self._ok(\"bitstamp\")\n","            print(f\"✅ Bitstamp OK: {px}\")\n","            return px\n","        except Exception as e:\n","            self._inc(\"bitstamp\")\n","            print(f\"⚠️ Bitstamp falló: {e}\")\n","            return None\n","\n","    def obtener_precio_coinpaprika(self) -> Optional[float]:\n","        if not ENABLE_PAPRIKA:\n","            return None\n","        try:\n","            data = self._get_json(\"https://api.coinpaprika.com/v1/tickers/btc-bitcoin?quotes=USD\", meta_provider=\"coinpaprika\")\n","            px = float(data[\"quotes\"][\"USD\"][\"price\"])\n","            self._ok(\"paprika\")\n","            print(f\"✅ CoinPaprika OK: {px}\")\n","            return px\n","        except Exception as e:\n","            self._inc(\"paprika\")\n","            print(f\"⚠️ CoinPaprika falló: {e}\")\n","            return None\n","\n","    def obtener_precio_coinbase(self) -> Optional[float]:\n","        if not ENABLE_COINBASE:\n","            return None\n","        try:\n","            data = self._get_json(\"https://api.coinbase.com/v2/prices/spot?currency=USD\", meta_provider=\"coinbase\")\n","            px = float(data[\"data\"][\"amount\"])\n","            self._ok(\"coinbase\")\n","            print(f\"✅ Coinbase OK: {px}\")\n","            return px\n","        except Exception as e:\n","            self._inc(\"coinbase\")\n","            print(f\"⚠️ Coinbase falló: {e}\")\n","            return None\n","\n","    def obtener_precio_bitfinex(self) -> Optional[float]:\n","        if not ENABLE_BITFINEX:\n","            return None\n","        try:\n","            data = self._get_json(\"https://api-pub.bitfinex.com/v2/ticker/tBTCUSD\", meta_provider=\"bitfinex\")\n","            px = float(data[6])  # lastPrice\n","            self._ok(\"bitfinex\")\n","            print(f\"✅ Bitfinex OK: {px}\")\n","            return px\n","        except Exception as e:\n","            self._inc(\"bitfinex\")\n","            print(f\"⚠️ Bitfinex falló: {e}\")\n","            return None\n","\n","    def obtener_precio_okx(self) -> Optional[float]:\n","        if not ENABLE_OKX:\n","            return None\n","        try:\n","            data = self._get_json(\"https://www.okx.com/api/v5/market/ticker?instId=BTC-USDT\", meta_provider=\"okx\")\n","            px = float(data[\"data\"][0][\"last\"])\n","            self._ok(\"okx\")\n","            print(f\"✅ OKX OK: {px}\")\n","            return px\n","        except Exception as e:\n","            self._inc(\"okx\")\n","            print(f\"⚠️ OKX falló: {e}\")\n","            return None\n","\n","    # -------------------- Kraken (vía tu APIManager) --------------------\n","    @retry(\n","        wait=wait_exponential(min=1, max=5),\n","        stop=stop_after_attempt(5),\n","        retry=retry_if_exception_type(Exception),\n","        reraise=False\n","    )\n","    async def obtener_precio_kraken(self) -> Optional[float]:\n","        \"\"\"\n","        Vía APIManager.query_public('Ticker', {'pair': 'XBTUSD'})\n","        Soporta claves 'XXBTZUSD' u otras variantes devueltas por Kraken.\n","        \"\"\"\n","        try:\n","            ticker = await self.api.query_public('Ticker', {'pair': 'XBTUSD'})\n","            res = ticker.get(\"result\", {})\n","            if not res:\n","                raise ValueError(\"Respuesta Kraken sin 'result'\")\n","            key = next((k for k in res.keys() if \"XBT\" in k and \"USD\" in k), None)\n","            if key is None:\n","                key = \"XXBTZUSD\" if \"XXBTZUSD\" in res else next(iter(res.keys()))\n","            c = res[key].get(\"c\", [])\n","            px = float(c[0]) if c else float(\"nan\")\n","            if math.isnan(px):\n","                raise ValueError(\"Kraken retornó NaN\")\n","            self.kraken_precio = px\n","            print(f\"✅ Kraken OK: {px}\")\n","            return px\n","        except Exception as e:\n","            print(f\"❌ Kraken falló: {e}\")\n","            return None\n","\n","    # -------------------- Precio “seguro” con escalera --------------------\n","    def obtener_precio_seguro(self) -> Optional[float]:\n","        \"\"\"\n","        CoinGecko primero (con TTL/cadencia y rotación Pro), CMC si hay claves,\n","        luego exchanges/aggregators alternos. Totalmente autónomo con proxies/keys.\n","        \"\"\"\n","        fuentes: List[Callable[[], Optional[float]]] = [\n","            self.obtener_precio_coingecko,\n","            self.obtener_precio_coinmarketcap,  # usa rotación de CMC si disponible\n","            self.obtener_precio_binance,\n","            self.obtener_precio_coinpaprika,\n","            self.obtener_precio_coinbase,\n","            self.obtener_precio_bitfinex,\n","            self.obtener_precio_okx,\n","            self.obtener_precio_yahoo,\n","            self.obtener_precio_bitstamp,\n","        ]\n","        for getter in fuentes:\n","            try:\n","                px = getter()\n","            except Exception:\n","                px = None\n","            if px:\n","                return px\n","\n","        print(\"⚠️ Todas las fuentes fallaron. Probando caché local...\")\n","        px = self._cargar_cache(valid_within=COINGECKO_TTL_SECONDS * 3)\n","        if px is not None:\n","            print(f\"📦 Precio en caché: {px}\")\n","        else:\n","            print(\"❌ Sin precio disponible.\")\n","        return px\n","\n","    # -------------------- Ajuste de predicción --------------------\n","    async def comparar_y_ajustar_prediccion(self, precio_actual: float, prediccion_original: float) -> float:\n","        \"\"\"\n","        Si Kraken y fuente externa difieren > 10 USD, aplica ajuste suave (sesgo relativo).\n","        \"\"\"\n","        try:\n","            precio_kraken = await self.obtener_precio_kraken()\n","            precio_externo = self.obtener_precio_seguro()\n","\n","            if not precio_kraken or not precio_externo or precio_kraken <= 0:\n","                print(\"⚠️ Predicción sin ajuste (fuentes insuficientes)\")\n","                return float(prediccion_original)\n","\n","            diferencia = abs(precio_kraken - precio_externo)\n","            if diferencia > 10:\n","                ajuste = (precio_externo - precio_kraken) / precio_kraken\n","                nueva = float(prediccion_original) * (1 + ajuste)\n","                print(f\"🔧 Ajuste aplicado por diferencia {diferencia:.2f} → {nueva:.2f}\")\n","                return round(nueva, 2)\n","            return float(prediccion_original)\n","        except Exception as e:\n","            print(f\"❌ Error ajustando predicción: {e}\")\n","            return float(prediccion_original)\n","\n","    # -------------------- Caché local --------------------\n","    def _guardar_cache(self, precio: float):\n","        try:\n","            with open(self.cache_path, \"w\") as f:\n","                json.dump({\"precio\": float(precio), \"timestamp_utc\": _now_utc_iso()}, f)\n","        except Exception as e:\n","            print(f\"⚠️ Error guardando caché: {e}\")\n","\n","    def _cargar_cache(self, valid_within: int = COINGECKO_TTL_SECONDS) -> Optional[float]:\n","        \"\"\"\n","        Devuelve el precio en caché si existe y no es más viejo que 'valid_within' segundos.\n","        \"\"\"\n","        try:\n","            if os.path.exists(self.cache_path):\n","                with open(self.cache_path, \"r\") as f:\n","                    data = json.load(f)\n","                ts = data.get(\"timestamp_utc\")\n","                px = data.get(\"precio\")\n","                if px is None:\n","                    return None\n","                if not ts:\n","                    return float(px)\n","                try:\n","                    cached_at = datetime.fromisoformat(ts.replace(\"Z\", \"+00:00\")).timestamp()\n","                except Exception:\n","                    return float(px)\n","                if (_now_ts() - cached_at) <= valid_within:\n","                    return float(px)\n","        except Exception as e:\n","            print(f\"⚠️ Error cargando caché: {e}\")\n","        return None\n","\n","    # -------------------- Resumen en tiempo real --------------------\n","    async def resumen_tareas_rt(self, inteligencia) -> Dict[str, Any]:\n","        \"\"\"\n","        Devuelve:\n","          - Precios (Kraken + “seguro”)\n","          - Estado/acción del motor BTCRealtimeIntelligence (si disponible)\n","        \"\"\"\n","        try:\n","            px_k = await self.obtener_precio_kraken()\n","            px_s = self.obtener_precio_seguro()\n","        except Exception:\n","            px_k, px_s = None, None\n","\n","        resumen: Dict[str, Any] = {\n","            \"ts_utc\": _now_utc_iso(),\n","            \"precio_kraken\": px_k,\n","            \"precio_seguro\": px_s,\n","            \"diferencia_usd\": (abs(px_k - px_s) if (px_k and px_s) else None),\n","            \"inteligencia\": {}\n","        }\n","\n","        if inteligencia:\n","            try:\n","                sig = getattr(inteligencia, \"last_signal\", None) or {}\n","                trend = getattr(inteligencia, \"trend\", None)\n","                trend_state = getattr(trend, \"state\", None)\n","                prob_up = sig.get(\"ml_prob_up\")\n","                fused = sig.get(\"ml_override\") or sig.get(\"action\")\n","                methods = sig.get(\"methods\", {}) if isinstance(sig.get(\"methods\"), dict) else {}\n","                resumen[\"inteligencia\"] = {\n","                    \"trend_state\": trend_state,\n","                    \"ml_prob_up\": prob_up,\n","                    \"fusion_action\": fused,\n","                    \"TRC3\": (methods.get(\"TRC3\", {}) or {}).get(\"signal\"),\n","                    \"LiquidityHunter\": (methods.get(\"LiquidityHunter\", {}) or {}).get(\"action\"),\n","                    \"QuantumEntanglement\": (methods.get(\"QuantumEntanglement\", {}) or {}).get(\"signal\"),\n","                    \"ByzantineShield\": (methods.get(\"ByzantineShield\", {}) or {}).get(\"defense\"),\n","                }\n","            except Exception as e:\n","                resumen[\"inteligencia\"] = {\"error\": f\"{e}\"}\n","\n","        return resumen\n","\n","\n","\n","# ====================== SEÑALES PERMANENTES (NO-MÁS-CEROS) ======================\n","# Coloca esta sección donde calculas/ imprimes:\n","# \"base | px=... | alcista=... bajista=... | neta=...\"\n","# y \"🧮 Comparador | tipo=... nivel=... valor=... | Δprom=... | ¿Buena compra? ...\"\n","\n","import math\n","from typing import List, Dict, Tuple, Optional\n","\n","# ---------- Utilidades seguras ----------\n","def _nz(x, rep=0.0):\n","    try:\n","        if x is None or (isinstance(x, float) and (math.isnan(x) or math.isinf(x))):\n","            return rep\n","        return float(x)\n","    except Exception:\n","        return rep\n","\n","def _safe_norm(x, lo, hi):\n","    # Normaliza x a [0,1] en el rango [lo,hi] sin NaN/Inf\n","    x = _nz(x, rep=lo)\n","    if hi == lo:   # evita /0\n","        return 0.5\n","    v = (x - lo) / (hi - lo)\n","    if v < 0: v = 0.0\n","    if v > 1: v = 1.0\n","    return v\n","\n","def _ema(values: List[float], period: int) -> List[float]:\n","    values = [ _nz(v) for v in values ]\n","    if not values or period <= 1:\n","        return values[:]\n","    k = 2.0 / (period + 1.0)\n","    out = []\n","    ema_val = values[0]\n","    for v in values:\n","        ema_val = v * k + ema_val * (1.0 - k)\n","        out.append(ema_val)\n","    return out\n","\n","def _rsi(prices: List[float], period: int = 14) -> float:\n","    # RSI clásico (cierre-cierre), retornando 50 si no hay datos suficientes\n","    if len(prices) < period + 1:\n","        return 50.0\n","    gains, losses = 0.0, 0.0\n","    for i in range(-period, 0):\n","        diff = prices[i] - prices[i-1]\n","        if diff >= 0: gains += diff\n","        else: losses -= diff\n","    if losses == 0:\n","        return 70.0  # sesgo alcista cuando no hay pérdidas recientes\n","    rs = gains / losses\n","    rsi = 100.0 - (100.0 / (1.0 + rs))\n","    if math.isnan(rsi) or math.isinf(rsi):\n","        return 50.0\n","    return rsi\n","\n","def _macd_lite(prices: List[float], fast=12, slow=26, sig=9) -> Tuple[float, float, float]:\n","    if len(prices) < slow + sig + 1:\n","        # fallback: slope simple sobre últimos N\n","        y = prices[-min(len(prices), 10):]\n","        if len(y) < 2:\n","            return (0.0, 0.0, 0.0)\n","        slope = (y[-1] - y[0]) / max(_nz(y[0], 1.0), 1e-9)\n","        return (slope, slope, 0.0)\n","    ema_fast = _ema(prices, fast)\n","    ema_slow = _ema(prices, slow)\n","    macd_line_all = [f - s for f, s in zip(ema_fast[-len(ema_slow):], ema_slow)]\n","    macd_line = macd_line_all[-1]\n","    signal_all = _ema(macd_line_all, sig)\n","    signal = signal_all[-1]\n","    hist = macd_line - signal\n","    return (macd_line, signal, hist)\n","\n","# ---------- Núcleo de señales ----------\n","def compute_signals_from_prices(\n","    closes: List[float],\n","    px_actual: Optional[float] = None\n",") -> Dict[str, float]:\n","    \"\"\"\n","    Devuelve: {\n","      'px': float, 'alcista': [0..1], 'bajista': [0..1], 'neta': [-1..1],\n","      'rsi': float, 'macd_hist': float, 'ema_slope': float,\n","      'reason': str (si no hay datos suficientes)\n","    }\n","    \"\"\"\n","    reason = \"\"\n","    closes = [ _nz(c) for c in closes if c is not None ]\n","    if px_actual is None and closes:\n","        px = _nz(closes[-1], 0.0)\n","    else:\n","        px = _nz(px_actual, 0.0)\n","\n","    if px <= 0.0:\n","        # Intento de fallback con último close válido\n","        if closes:\n","            px = _nz(closes[-1], 0.0)\n","        if px <= 0.0:\n","            return {\n","                \"px\": 0.0, \"alcista\": 0.0, \"bajista\": 0.0, \"neta\": 0.0,\n","                \"rsi\": 50.0, \"macd_hist\": 0.0, \"ema_slope\": 0.0,\n","                \"reason\": \"px inválido (<=0) y sin historial usable\"\n","            }\n","\n","    if len(closes) < 5:\n","        # No fabricamos señal “bonita”: informamos motivo\n","        return {\n","            \"px\": px, \"alcista\": 0.0, \"bajista\": 0.0, \"neta\": 0.0,\n","            \"rsi\": 50.0, \"macd_hist\": 0.0, \"ema_slope\": 0.0,\n","            \"reason\": f\"historial insuficiente ({len(closes)}/5)\"\n","        }\n","\n","    # Indicadores base\n","    rsi = _rsi(closes, period=14)\n","    macd_line, macd_signal, macd_hist = _macd_lite(closes)\n","    # Pendiente relativa de EMA 20\n","    ema20 = _ema(closes, 20)\n","    if len(ema20) >= 2 and ema20[-2] != 0:\n","        ema_slope = (ema20[-1] - ema20[-2]) / max(abs(ema20[-2]), 1e-9)\n","    else:\n","        ema_slope = 0.0\n","\n","    # Normalizaciones a [0,1]\n","    rsi_bull = _safe_norm(rsi, 50, 80)    # >50 hacia 1 (alcista)\n","    rsi_bear = _safe_norm(50 - (rsi - 50), 50-30, 50)  # <50 hacia 1 (bajista)\n","    macd_bull = _safe_norm(macd_hist, 0.0, 0.01)  # ajusta 0.01 según volatilidad\n","    macd_bear = _safe_norm(-macd_hist, 0.0, 0.01)\n","    slope_bull = _safe_norm(ema_slope, 0.0, 0.01)\n","    slope_bear = _safe_norm(-ema_slope, 0.0, 0.01)\n","\n","    # Fusión (ponderaciones simples y robustas)\n","    alcista = 0.5 * rsi_bull + 0.3 * macd_bull + 0.2 * slope_bull\n","    bajista = 0.5 * rsi_bear + 0.3 * macd_bear + 0.2 * slope_bear\n","\n","    # Sanidad (no dejar todo en cero si hay señal contradictoria mínima)\n","    eps = 1e-6\n","    if abs(alcista - bajista) < eps and (abs(macd_hist) > 0 or abs(ema_slope) > 0):\n","        # empujoncito para romper empate\n","        if macd_hist >= 0 or ema_slope >= 0:\n","            alcista += 0.01\n","        else:\n","            bajista += 0.01\n","\n","    # Clamp final\n","    alcista = max(0.0, min(1.0, alcista))\n","    bajista = max(0.0, min(1.0, bajista))\n","    neta = max(-1.0, min(1.0, alcista - bajista))\n","\n","    return {\n","        \"px\": px, \"alcista\": alcista, \"bajista\": bajista, \"neta\": neta,\n","        \"rsi\": rsi, \"macd_hist\": macd_hist, \"ema_slope\": ema_slope,\n","        \"reason\": reason\n","    }\n","\n","# ---------- Comparador (buy/sell + nivel) ----------\n","def comparador_desde_neta(neta: float, delta_prom: float = 0.0) -> Dict[str, str]:\n","    # neta en [-1,1]; umbrales configurables\n","    th_buy = 0.10\n","    th_strong = 0.35\n","    if neta >= th_buy:\n","        tipo = \"buy\"\n","        fuerza = \"fuerte\" if neta >= th_strong else (\"moderado\" if neta >= (th_buy+0.12) else \"débil\")\n","        valor = neta\n","        buena_compra = \"✅ Sí\" if neta >= (th_buy+0.05) else \"⚠️ Dudosa\"\n","    elif neta <= -th_buy:\n","        tipo = \"sell\"\n","        fuerza = \"fuerte\" if neta <= -th_strong else (\"moderado\" if neta <= -(th_buy+0.12) else \"débil\")\n","        valor = -neta\n","        buena_compra = \"❌ No\"\n","    else:\n","        tipo = \"neutral\"\n","        fuerza = \"débil\"\n","        valor = abs(neta)\n","        buena_compra = \"⚠️ Esperar\"\n","    return {\n","        \"tipo\": tipo,\n","        \"nivel\": fuerza,\n","        \"valor\": f\"{valor:.4f}\",\n","        \"delta_prom\": f\"{_nz(delta_prom):.4f}\",\n","        \"buena\": buena_compra\n","    }\n","\n","# ---------- Impresor de panel (formato igual al tuyo) ----------\n","def imprimir_panel_signales(\n","    closes: List[float],\n","    px_actual: Optional[float] = None,\n","    delta_prom: float = 0.0,\n","    titulo_base: str = \"base\"\n","):\n","    sig = compute_signals_from_prices(closes, px_actual)\n","    px = sig[\"px\"]\n","    alc = sig[\"alcista\"]\n","    baj = sig[\"bajista\"]\n","    net = sig[\"neta\"]\n","    razon = sig.get(\"reason\", \"\")\n","\n","    # Base\n","    print(f\"{titulo_base} | px={px:.2f} | alcista={alc:.4f} bajista={baj:.4f} | neta={net:.4f}\")\n","    # Si no hay datos suficientes o px inválido, no fingimos 0.0000: mostramos la razón.\n","    if razon:\n","        print(f\"⚠️ Sin señal operable: {razon}\")\n","        return\n","\n","    comp = comparador_desde_neta(net, delta_prom=delta_prom)\n","    print(f\"🧮 Comparador | tipo={comp['tipo']} nivel={comp['nivel']} valor={comp['valor']} | \"\n","          f\"Δprom={comp['delta_prom']} | ¿Buena compra? {comp['buena']}\")\n","\n","\n","\n","\n","# ===================== SEÑALES PERMANENTES + INTEGRACIÓN (TTDVI156) =====================\n","# Objetivo:\n","# 1) Calcular señales robustas sin ceros falsos (px/historial/NaN protegidos).\n","# 2) Imprimir panel en tu formato y retornar un dict para el Render-en-Vivo.\n","# 3) Integrarse con tus clases si existen: SentimientoMercadoBTC, ComparadorTendencias.\n","# 4) Enviar resumen al render (si hay \"print_results_panel\" o \"render_update_signals\").\n","\n","import math\n","from typing import List, Dict, Tuple, Optional\n","\n","# ---------- Utilidades seguras ----------\n","def _nz(x, rep=0.0):\n","    try:\n","        if x is None or (isinstance(x, float) and (math.isnan(x) or math.isinf(x))):\n","            return rep\n","        return float(x)\n","    except Exception:\n","        return rep\n","\n","def _safe_norm(x, lo, hi):\n","    # Normaliza x a [0,1] en el rango [lo,hi] sin NaN/Inf ni /0\n","    x = _nz(x, rep=lo)\n","    if hi == lo:\n","        return 0.5\n","    v = (x - lo) / (hi - lo)\n","    if v < 0: v = 0.0\n","    if v > 1: v = 1.0\n","    return v\n","\n","def _ema(values: List[float], period: int) -> List[float]:\n","    values = [_nz(v) for v in values]\n","    if not values or period <= 1:\n","        return values[:]\n","    k = 2.0 / (period + 1.0)\n","    out = []\n","    ema_val = values[0]\n","    for v in values:\n","        ema_val = v * k + ema_val * (1.0 - k)\n","        out.append(ema_val)\n","    return out\n","\n","def _rsi(prices: List[float], period: int = 14) -> float:\n","    if len(prices) < period + 1:\n","        return 50.0\n","    gains, losses = 0.0, 0.0\n","    for i in range(-period, 0):\n","        diff = prices[i] - prices[i-1]\n","        if diff >= 0: gains += diff\n","        else: losses -= diff\n","    if losses == 0:\n","        return 70.0\n","    rs = gains / losses\n","    rsi = 100.0 - (100.0 / (1.0 + rs))\n","    if math.isnan(rsi) or math.isinf(rsi):\n","        return 50.0\n","    return rsi\n","\n","def _macd_lite(prices: List[float], fast=12, slow=26, sig=9) -> Tuple[float, float, float]:\n","    if len(prices) < slow + sig + 1:\n","        y = prices[-min(len(prices), 10):]\n","        if len(y) < 2:\n","            return (0.0, 0.0, 0.0)\n","        slope = (y[-1] - y[0]) / max(abs(_nz(y[0], 1.0)), 1e-9)\n","        return (slope, slope, 0.0)\n","    ema_fast = _ema(prices, fast)\n","    ema_slow = _ema(prices, slow)\n","    macd_line_all = [f - s for f, s in zip(ema_fast[-len(ema_slow):], ema_slow)]\n","    macd_line = macd_line_all[-1]\n","    signal_all = _ema(macd_line_all, sig)\n","    signal = signal_all[-1]\n","    hist = macd_line - signal\n","    return (macd_line, signal, hist)\n","\n","# ---------- Núcleo de señales ----------\n","def compute_signals_from_prices(\n","    closes: List[float],\n","    px_actual: Optional[float] = None\n",") -> Dict[str, float]:\n","    \"\"\"\n","    Salida:\n","      {\n","        'px': float,\n","        'alcista': [0..1],\n","        'bajista': [0..1],\n","        'neta': [-1..1],\n","        'rsi': float,\n","        'macd_hist': float,\n","        'ema_slope': float,\n","        'reason': str  # si no hay señal operable, explica por qué\n","      }\n","    \"\"\"\n","    reason = \"\"\n","    closes = [_nz(c) for c in closes if c is not None]\n","    if px_actual is None and closes:\n","        px = _nz(closes[-1], 0.0)\n","    else:\n","        px = _nz(px_actual, 0.0)\n","\n","    if px <= 0.0:\n","        if closes:\n","            px = _nz(closes[-1], 0.0)\n","        if px <= 0.0:\n","            return {\n","                \"px\": 0.0, \"alcista\": 0.0, \"bajista\": 0.0, \"neta\": 0.0,\n","                \"rsi\": 50.0, \"macd_hist\": 0.0, \"ema_slope\": 0.0,\n","                \"reason\": \"px inválido (<=0) y sin historial usable\"\n","            }\n","\n","    if len(closes) < 5:\n","        return {\n","            \"px\": px, \"alcista\": 0.0, \"bajista\": 0.0, \"neta\": 0.0,\n","            \"rsi\": 50.0, \"macd_hist\": 0.0, \"ema_slope\": 0.0,\n","            \"reason\": f\"historial insuficiente ({len(closes)}/5)\"\n","        }\n","\n","    rsi = _rsi(closes, period=14)\n","    macd_line, macd_signal, macd_hist = _macd_lite(closes)\n","\n","    ema20 = _ema(closes, 20)\n","    if len(ema20) >= 2 and ema20[-2] != 0:\n","        ema_slope = (ema20[-1] - ema20[-2]) / max(abs(ema20[-2]), 1e-9)\n","    else:\n","        ema_slope = 0.0\n","\n","    # Normalizaciones a [0,1] robustas\n","    rsi_bull = _safe_norm(rsi, 50, 80)\n","    rsi_bear = _safe_norm(50 - (rsi - 50), 50-30, 50)\n","    macd_bull = _safe_norm(macd_hist, 0.0, 0.01)\n","    macd_bear = _safe_norm(-macd_hist, 0.0, 0.01)\n","    slope_bull = _safe_norm(ema_slope, 0.0, 0.01)\n","    slope_bear = _safe_norm(-ema_slope, 0.0, 0.01)\n","\n","    alcista = 0.5*rsi_bull + 0.3*macd_bull + 0.2*slope_bull\n","    bajista = 0.5*rsi_bear + 0.3*macd_bear + 0.2*slope_bear\n","\n","    eps = 1e-6\n","    if abs(alcista - bajista) < eps and (abs(macd_hist) > 0 or abs(ema_slope) > 0):\n","        if macd_hist >= 0 or ema_slope >= 0:\n","            alcista += 0.01\n","        else:\n","            bajista += 0.01\n","\n","    alcista = max(0.0, min(1.0, alcista))\n","    bajista = max(0.0, min(1.0, bajista))\n","    neta = max(-1.0, min(1.0, alcista - bajista))\n","\n","    return {\n","        \"px\": px, \"alcista\": alcista, \"bajista\": bajista, \"neta\": neta,\n","        \"rsi\": rsi, \"macd_hist\": macd_hist, \"ema_slope\": ema_slope,\n","        \"reason\": reason\n","    }\n","\n","# ---------- Comparador ----------\n","def comparador_desde_neta(neta: float, delta_prom: float = 0.0) -> Dict[str, str]:\n","    th_buy = 0.10\n","    th_strong = 0.35\n","    if neta >= th_buy:\n","        tipo = \"buy\"\n","        fuerza = \"fuerte\" if neta >= th_strong else (\"moderado\" if neta >= (th_buy+0.12) else \"débil\")\n","        valor = neta\n","        buena_compra = \"✅ Sí\" if neta >= (th_buy+0.05) else \"⚠️ Dudosa\"\n","    elif neta <= -th_buy:\n","        tipo = \"sell\"\n","        fuerza = \"fuerte\" if neta <= -th_strong else (\"moderado\" if neta <= -(th_buy+0.12) else \"débil\")\n","        valor = -neta\n","        buena_compra = \"❌ No\"\n","    else:\n","        tipo = \"neutral\"\n","        fuerza = \"débil\"\n","        valor = abs(neta)\n","        buena_compra = \"⚠️ Esperar\"\n","    return {\n","        \"tipo\": tipo,\n","        \"nivel\": fuerza,\n","        \"valor\": f\"{_nz(valor):.4f}\",\n","        \"delta_prom\": f\"{_nz(delta_prom):.4f}\",\n","        \"buena\": buena_compra\n","    }\n","\n","# ---------- Impresor + resumen integrado ----------\n","def imprimir_panel_signales(\n","    closes: List[float],\n","    px_actual: Optional[float] = None,\n","    delta_prom: float = 0.0,\n","    titulo_base: str = \"base\"\n",") -> Dict[str, float]:\n","    sig = compute_signals_from_prices(closes, px_actual)\n","    px = sig[\"px\"]; alc = sig[\"alcista\"]; baj = sig[\"bajista\"]; net = sig[\"neta\"]\n","    razon = sig.get(\"reason\", \"\")\n","\n","    print(f\"{titulo_base} | px={px:.2f} | alcista={alc:.4f} bajista={baj:.4f} | neta={net:.4f}\")\n","    if razon:\n","        print(f\"⚠️ Sin señal operable: {razon}\")\n","        # Retorna resumen mínimo para render, explicitando motivo\n","        return {\n","            \"px\": px, \"alcista\": alc, \"bajista\": baj, \"neta\": net,\n","            \"rsi\": sig[\"rsi\"], \"macd_hist\": sig[\"macd_hist\"], \"ema_slope\": sig[\"ema_slope\"],\n","            \"tipo\": \"neutral\", \"nivel\": \"débil\", \"valor\": 0.0, \"buena\": \"⚠️ Esperar\",\n","            \"reason\": razon\n","        }\n","\n","    comp = comparador_desde_neta(net, delta_prom=delta_prom)\n","    print(f\"🧮 Comparador | tipo={comp['tipo']} nivel={comp['nivel']} valor={comp['valor']} | \"\n","          f\"Δprom={comp['delta_prom']} | ¿Buena compra? {comp['buena']}\")\n","\n","    # Paquete resumen para Render-en-Vivo / dashboard\n","    resumen = {\n","        \"px\": px, \"alcista\": alc, \"bajista\": baj, \"neta\": net,\n","        \"rsi\": sig[\"rsi\"], \"macd_hist\": sig[\"macd_hist\"], \"ema_slope\": sig[\"ema_slope\"],\n","        \"tipo\": comp[\"tipo\"], \"nivel\": comp[\"nivel\"],\n","        \"valor\": float(comp[\"valor\"]), \"buena\": comp[\"buena\"],\n","        \"reason\": \"\"\n","    }\n","    return resumen\n","\n","# ---------- Adaptadores a tus clases (si existen) ----------\n","def _hook_sentimiento(resumen: Dict[str, float]):\n","    # Si tienes SentimientoMercadoBTC con set_score()/update(), úsalo.\n","    SM = globals().get(\"SentimientoMercadoBTC\")\n","    try:\n","        if SM and hasattr(SM, \"set_score\"):\n","            # Score en [-1..1] usa neta\n","            SM.set_score(resumen.get(\"neta\", 0.0))\n","        elif SM and hasattr(SM, \"update\"):\n","            SM.update(score=resumen.get(\"neta\", 0.0), px=resumen.get(\"px\", 0.0))\n","    except Exception as e:\n","        print(\"⚠️ SentimientoMercadoBTC hook error:\", e)\n","\n","def _hook_comparador(resumen: Dict[str, float]):\n","    # Si tienes ComparadorTendencias con update()/push(), pásale tipo/nivel/valor.\n","    CT = globals().get(\"ComparadorTendencias\")\n","    try:\n","        if CT and hasattr(CT, \"update\"):\n","            CT.update(tipo=resumen.get(\"tipo\",\"neutral\"),\n","                      nivel=resumen.get(\"nivel\",\"débil\"),\n","                      valor=resumen.get(\"valor\",0.0),\n","                      neta=resumen.get(\"neta\",0.0))\n","        elif CT and hasattr(CT, \"push\"):\n","            CT.push(resumen)\n","    except Exception as e:\n","        print(\"⚠️ ComparadorTendencias hook error:\", e)\n","\n","def _hook_render(resumen: Dict[str, float], titulo: str = \"Resumen señales\"):\n","    # Intenta enviar al Render-en-Vivo si existe; si no, usa print_results_panel\n","    try:\n","        render_update = globals().get(\"render_update_signals\")\n","        if callable(render_update):\n","            render_update(resumen)\n","            return\n","        prp = globals().get(\"print_results_panel\")\n","        if callable(prp):\n","            prp(resumen, title=titulo)\n","            return\n","    except Exception as e:\n","        print(\"⚠️ Render hook error:\", e)\n","\n","# ---------- Función única de orquestación (llámala desde tu loop) ----------\n","def generar_senales_y_panel(\n","    closes: List[float],\n","    ultimo_precio: Optional[float] = None,\n","    delta_prom: float = 0.0,\n","    titulo_base: str = \"base\"\n",") -> Dict[str, float]:\n","    \"\"\"\n","    Úsala en tu loop:\n","        resumen = generar_senales_y_panel(cierres_1m, ultimo_ticker, delta_prom, \"base\")\n","    Devuelve 'resumen' para grabar/plotear y también empuja a tus hooks si existen.\n","    \"\"\"\n","    resumen = imprimir_panel_signales(closes=closes, px_actual=ultimo_precio,\n","                                      delta_prom=delta_prom, titulo_base=titulo_base)\n","    _hook_sentimiento(resumen)\n","    _hook_comparador(resumen)\n","    _hook_render(resumen, titulo=\"Resumen señales\")\n","    return resumen\n","\n","# ===================== FIN SECCIÓN SEÑALES + INTEGRACIÓN =====================\n","\n","# ── Cómo usarla en tu loop (ejemplo directo) ─────────────────────────────────\n","# Suponiendo que ya tienes:\n","# - cierres_1m: lista de cierres recientes (>=5)\n","# - ultimo_ticker: float > 0 con el último precio\n","# - delta_prom: float con tu Δprom medio (opcional)\n","\n","# Nota: Este bloque es idempotente y seguro. Solo define un stub de\n","# generar_senales_y_panel si NO existe. El demo solo corre si exportas\n","# DEMO_SENALES=1 (para no interferir con tu ejecución normal).\n","\n","import os\n","from typing import List, Optional, Dict, Any\n","\n","# ---- Stub NO invasivo (solo si no existe tu implementación real) ----\n","if not callable(globals().get(\"generar_senales_y_panel\", None)):\n","    def generar_senales_y_panel(\n","        closes: List[float],\n","        ultimo_precio: float,\n","        delta_prom: Optional[float] = None,\n","        titulo_base: str = \"base\"\n","    ) -> Dict[str, Any]:\n","        \"\"\"\n","        Stub mínimo: arma un resumen compatible.\n","        Si ya tienes una versión real, este stub NO se usará.\n","        \"\"\"\n","        try:\n","            n = len(closes)\n","            prom = sum(closes[-5:]) / min(5, n) if n else 0.0\n","        except Exception:\n","            prom = 0.0\n","        return {\n","            \"titulo\": f\"Señales {titulo_base}\",\n","            \"ultimo_precio\": float(ultimo_precio or 0.0),\n","            \"delta_prom\": float(delta_prom or 0.0),\n","            \"promedio_5\": float(prom),\n","            \"closes\": list(closes[-10:]) if closes else [],\n","            \"ok\": True,\n","            \"msg\": \"Stub activo (usa tu implementación real si existe)\"\n","        }\n","\n","# ---- Demo de uso (solo si lo habilitas con ENV) ---------------------\n","def _demo_uso_senales():\n","    # Usa tus variables si ya existen; si no, crea ejemplos válidos.\n","    cierres_1m = globals().get(\"cierres_1m\") or [100.0, 100.5, 101.2, 100.9, 101.0, 101.4, 101.1]\n","    ultimo_ticker = globals().get(\"ultimo_ticker\") or float(cierres_1m[-1])\n","    delta_prom = globals().get(\"delta_prom\") or 0.0\n","\n","    resumen = generar_senales_y_panel(\n","        closes=cierres_1m,\n","        ultimo_precio=ultimo_ticker,\n","        delta_prom=delta_prom,\n","        titulo_base=\"base\"\n","    )\n","    # 'resumen' queda listo para tu Render-en-Vivo / guardado / logs\n","    try:\n","        print(\"\\n── Resumen Señales (demo) ──\")\n","        for k in sorted(resumen):\n","            if k == \"closes\":\n","                print(f\"{k}: {resumen[k][-5:]}\")\n","            else:\n","                print(f\"{k}: {resumen[k]}\")\n","        print(\"────────────────────────────\\n\")\n","    except Exception as e:\n","        print(f\"[WARN] No se pudo imprimir el resumen: {e}\")\n","\n","# Ejecuta el demo solo si defines DEMO_SENALES=1 en el entorno\n","if os.environ.get(\"DEMO_SENALES\", \"0\") == \"1\":\n","    _demo_uso_senales()\n","\n","# ── FIN: bloque de uso de señales ────────────────────────────────────────────\n","\n","\n","# ============ INTERPRETADOR INTELIGENTE CUÁNTICO (compatible) ============\n","import numpy as np\n","\n","class InterpretadorInteligenteCuantico:\n","    \"\"\"\n","    Igual a tu versión, con soporte opcional de comparador_btc para fallback\n","    y fix de zona horaria (ZoneInfo -> pytz -> UTC).\n","    \"\"\"\n","    def __init__(self, predictor_alcista, predictor_bajista, api, comparador_btc: Optional[ComparadorDatosBTC]=None):\n","        self.predictor_alcista = predictor_alcista\n","        self.predictor_bajista = predictor_bajista\n","        self.api = api\n","        self.comparador_btc = comparador_btc\n","        self.browse_enabled = True  # Placeholder para módulos futuros\n","\n","    async def _precio_actual_seguro(self) -> float:\n","        # 1) APIManager oficial si existe\n","        if hasattr(self.api, \"obtener_precio_real_actual\") and callable(getattr(self.api, \"obtener_precio_real_actual\")):\n","            try:\n","                p = await self.api.obtener_precio_real_actual()\n","                return float(p)\n","            except Exception:\n","                pass\n","        # 2) Fallback: comparador (Kraken primero)\n","        if self.comparador_btc:\n","            try:\n","                p = await self.comparador_btc.obtener_precio_kraken()\n","                if p: return float(p)\n","                p2 = self.comparador_btc.obtener_precio_seguro()\n","                if p2: return float(p2)\n","            except Exception:\n","                pass\n","        # 3) Último recurso\n","        return 0.0\n","\n","    async def interpretar_contexto_general(self):\n","        try:\n","            precio_actual_f = float(await self._precio_actual_seguro())\n","            futuro_alcista = float(await self.predictor_alcista.predecir_precio_futuro())\n","            futuro_bajista = float(await self.predictor_bajista.predecir_precio_futuro())\n","\n","            if precio_actual_f <= 0:\n","                raise ValueError(\"Precio actual no disponible para interpretación.\")\n","\n","            cambio_alcista = ((futuro_alcista - precio_actual_f) / precio_actual_f) * 100\n","            cambio_bajista = ((futuro_bajista - precio_actual_f) / precio_actual_f) * 100\n","            hora_ny = datetime.now(_tz_newyork()).strftime(\"%Y-%m-%d %H:%M:%S\")\n","\n","            nivel_confianza = self._calcular_confianza(cambio_alcista, cambio_bajista)\n","            tendencia = '📈 ALCISTA' if cambio_alcista > abs(cambio_bajista) else '📉 BAJISTA'\n","\n","            resumen = {\n","                \"🕒 Hora NY\": hora_ny,\n","                \"💰 Precio actual\": f\"${precio_actual_f:.2f}\",\n","                \"🔮 Proyección alcista\": f\"${futuro_alcista:.2f} | {cambio_alcista:+.2f}%\",\n","                \"🔮 Proyección bajista\": f\"${futuro_bajista:.2f} | {cambio_bajista:+.2f}%\",\n","                \"📊 Brecha\": f\"{abs(futuro_alcista - futuro_bajista):.2f} USD\",\n","                \"📌 Tendencia dominante\": tendencia,\n","                \"🧠 Nivel de confianza\": nivel_confianza,\n","                \"🧪 Decisión autónoma (AGI-like)\": self._decidir(cambio_alcista, cambio_bajista)\n","            }\n","\n","            print(\"\\n=== 🤖 INTERPRETACIÓN AVANZADA DE DATOS EN TIEMPO REAL ===\")\n","            for k, v in resumen.items():\n","                print(f\"{k}: {v}\")\n","\n","            return resumen\n","\n","        except Exception as e:\n","            print(f\"❌ Error en interpretar_contexto_general(): {e}\")\n","            return {}\n","\n","    def _calcular_confianza(self, alcista: float, bajista: float) -> str:\n","        intensidad = max(abs(alcista), abs(bajista))\n","        if intensidad >= 15: return \"🔴 EXTREMA\"\n","        if intensidad >= 10: return \"🟠 ALTA\"\n","        if intensidad >= 5:  return \"🟡 MEDIA\"\n","        if intensidad > 2:   return \"🟢 BAJA\"\n","        return \"⚪️ NEUTRA\"\n","\n","    def _decidir(self, alcista: float, bajista: float) -> str:\n","        if alcista > 10:      return \"✅ Comprar inmediatamente (estrategia agresiva AlphaZero)\"\n","        if bajista < -10:     return \"🛑 Vender o proteger (defensiva)\"\n","        if abs(alcista) < 3 and abs(bajista) < 3:\n","                               return \"🤔 Esperar consolidación (neutral)\"\n","        return \"📊 Monitoreo activo (estratégico)\"\n","\n","\n","# ===================== FIX PACK PERMANENTE =====================\n","# - Corrige KeyError 'XBTUSD' en lecturas OHLC (normalización + extracción robusta)\n","# - Hace opcional el parámetro 'predictor' del Ultra/Enhanced executor (compatibilidad hacia atrás)\n","# - No toca tu lógica existente; sólo añade compatibilidad.\n","\n","from decimal import Decimal\n","import asyncio, os\n","\n","# --- Normalizador de pares Kraken (XBTUSD -> XXBTZUSD) ---\n","def _kraken_pair_fix(pair: str) -> str:\n","    p = (pair or \"\").replace(\"/\", \"\").upper()\n","    if p in (\"XBTUSD\", \"BTCUSD\") or (\"XBT\" in p and \"USD\" in p):\n","        return \"XXBTZUSD\"\n","    return p\n","\n","# --- Extrae la primera serie OHLC válida sin depender de la clave exacta del par ---\n","def _safe_extract_ohlc_series(ohlc_resp) -> list:\n","    try:\n","        if isinstance(ohlc_resp, dict):\n","            res = ohlc_resp.get(\"result\", {})\n","            for _, v in res.items():\n","                if isinstance(v, list) and v and isinstance(v[0], (list, tuple)) and len(v[0]) >= 5:\n","                    return v\n","    except Exception:\n","        pass\n","    return []\n","\n","# --- Wrapper robusto para obtener OHLC desde cualquier parte del código ---\n","async def safe_get_ohlc_any(api, pair: str, interval: int, count: int | None = None) -> list:\n","    try:\n","        pr = _kraken_pair_fix(pair)\n","        params = {\"pair\": pr, \"interval\": int(interval)}\n","        if count and count > 0:\n","            import time as _time\n","            params[\"since\"] = int(_time.time()) - int(interval) * 60 * (count * 2)\n","        resp = await api.query_public(\"OHLC\", params)\n","        serie = _safe_extract_ohlc_series(resp)\n","        return serie[-count:] if (count and count > 0) else serie\n","    except Exception:\n","        return []\n","\n","# --- Si el API no expone normalizador, lo inyectamos (sin romper nada) ---\n","def _inject_api_kraken_pair(api):\n","    try:\n","        if not hasattr(api, \"_kraken_pair\") or not callable(getattr(api, \"_kraken_pair\")):\n","            setattr(api, \"_kraken_pair\", _kraken_pair_fix)\n","    except Exception:\n","        pass\n","\n","# ==================== FIX PERMANENTE QISKIT: DeprecationWarning & Shim ====================\n","# Objetivo:\n","#  - Silenciar el DeprecationWarning de:\n","#    qiskit.transpiler.target.target_to_backend_properties()\n","#  - Proveer un shim compatible si esa función desaparece en Qiskit >= 2.0\n","#  - No alterar tu flujo: solo quitamos ruido y prevenimos roturas futuras.\n","\n","import warnings as _qwarn\n","\n","# 1) Filtro fino de warnings (NO global)\n","_qwarn.filterwarnings(\n","    \"ignore\",\n","    category=DeprecationWarning,\n","    message=r\".*qiskit\\.transpiler\\.target\\.target_to_backend_properties\\(\\).*\",\n","    module=r\"qiskit\\.transpiler\\.target\"\n",")\n","\n","# 2) Parche defensivo (wrapper o shim) para la función deprecada\n","try:\n","    import qiskit  # noqa\n","    try:\n","        from qiskit.transpiler import target as _qt_target\n","    except Exception:\n","        _qt_target = None\n","\n","    if _qt_target is not None:\n","        if hasattr(_qt_target, \"target_to_backend_properties\"):\n","            # Qiskit < 2.0: existe; la envolvemos para silenciar localmente el DeprecationWarning\n","            _orig_t2bp = _qt_target.target_to_backend_properties\n","\n","            def _t2bp_patched(*args, **kwargs):\n","                # Silencio puntual SOLO en esta llamada\n","                with _qwarn.catch_warnings():\n","                    _qwarn.simplefilter(\"ignore\", DeprecationWarning)\n","                    return _orig_t2bp(*args, **kwargs)\n","\n","            _qt_target.target_to_backend_properties = _t2bp_patched  # type: ignore[attr-defined]\n","            print(\"✅ Qiskit: DeprecationWarning de target_to_backend_properties() silenciado (wrapper activo).\")\n","        else:\n","            # Qiskit >= 2.0: la función ya no existe → proporcionamos un shim inofensivo\n","            def target_to_backend_properties(*args, **kwargs):  # noqa\n","                \"\"\"\n","                Shim para compatibilidad hacia atrás. Qiskit 2.0 elimina esta función.\n","                Intentamos extraer 'backend.properties()' si nos pasan un backend moderno;\n","                de lo contrario, devolvemos None (comportamiento neutro).\n","                \"\"\"\n","                try:\n","                    # Si algún código antiguo pasa un backend V2 directamente:\n","                    backend = kwargs.get(\"backend\", None)\n","                    if backend is None and args:\n","                        # A veces el primer arg es un Target (V2) o algo similar;\n","                        # si llega un backend, probamos properties()\n","                        if hasattr(args[0], \"properties\"):\n","                            return args[0].properties()\n","                    if backend is not None and hasattr(backend, \"properties\"):\n","                        return backend.properties()\n","                except Exception:\n","                    pass\n","                return None\n","\n","            # Inyectamos el shim en el módulo para que los imports antiguos no revienten\n","            import types as _types\n","            if not isinstance(_qt_t