{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMH8e8Jog1//byx6BKPyH5K"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"z7TI1ZAjS1rM"},"outputs":[],"source":["# ================= FIX PERMANENTE: LECTOR ROBUSTO DE ACCOUNT_METRICS_JSON ================\n","# Cubre casos: múltiples objetos JSON concatenados, formato NDJSON (1 obj por línea),\n","# basura/trozos al final, archivos vacíos o parcialmente escritos. Repara y reescribe atómicamente.\n","\n","import io, json, os, time, tempfile\n","from typing import Any, Iterable, Optional\n","\n","# Si tu código ya define ACCOUNT_METRICS_JSON, lo respetamos; si no, path por defecto:\n","ACCOUNT_METRICS_JSON = globals().get(\n","    \"ACCOUNT_METRICS_JSON\",\n","    os.path.join(os.getenv(\"TTDVI_RUN_ROOT\", \"./run_ttdvi156\"), \"state\", \"account_metrics.json\")\n",")\n","\n","def _log_metrics_fix(msg: str):\n","    try:\n","        print(f\"[METRICS-FIX] {msg}\", flush=True)\n","    except Exception:\n","        pass\n","\n","def _ensure_dir(p: str):\n","    try:\n","        os.makedirs(os.path.dirname(p), exist_ok=True)\n","    except Exception:\n","        pass\n","\n","def _atomic_write_json(path: str, obj: Any):\n","    \"\"\"Escritura atómica (tmp + replace) para evitar archivos truncados.\"\"\"\n","    _ensure_dir(path)\n","    d = os.path.dirname(path) or \".\"\n","    fd, tmp = tempfile.mkstemp(prefix=\".tmp_metrics_\", dir=d)\n","    try:\n","        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(obj, f, ensure_ascii=False, indent=2)\n","            f.flush()\n","            os.fsync(f.fileno())\n","        os.replace(tmp, path)\n","    except Exception:\n","        try:\n","            os.unlink(tmp)\n","        except Exception:\n","            pass\n","        raise\n","\n","def _json_iter_concat_objects(src: str) -> Iterable[Any]:\n","    \"\"\"\n","    Parsea 0..N objetos JSON consecutivos en una misma cadena (caso \"Extra data\").\n","    Avanza con raw_decode y rinde cada objeto válido.\n","    \"\"\"\n","    dec = json.JSONDecoder()\n","    i, n = 0, len(src)\n","    while i < n:\n","        # saltar espacios\n","        while i < n and src[i].isspace():\n","            i += 1\n","        if i >= n:\n","            break\n","        try:\n","            obj, j = dec.raw_decode(src, i)\n","            yield obj\n","            i = j\n","        except json.JSONDecodeError:\n","            # avanzar 1 char (basura) y seguir buscando siguiente raíz\n","            i += 1\n","\n","def _json_iter_ndjson_lines(src: str) -> Iterable[Any]:\n","    \"\"\"Parsea línea a línea (NDJSON). Ignora líneas vacías/basura.\"\"\"\n","    for ln in src.splitlines():\n","        ln = ln.strip()\n","        if not ln:\n","            continue\n","        try:\n","            yield json.loads(ln)\n","        except Exception:\n","            continue\n","\n","def _repair_account_metrics_content(txt: str) -> Optional[Any]:\n","    \"\"\"\n","    Devuelve el ÚLTIMO objeto JSON válido hallado (preferencia: concatenados; fallback: NDJSON).\n","    Si no encuentra nada, None.\n","    \"\"\"\n","    last = None\n","    found = False\n","\n","    # 1) Intento directo (un solo objeto)\n","    try:\n","        return json.loads(txt)\n","    except json.JSONDecodeError as e:\n","        # Caso típico: \"Extra data\" u otro → seguimos con los modos robustos\n","        _log_metrics_fix(f\"json.loads falló ({e.msg}) → aplicando reparaciones…\")\n","    except Exception as e:\n","        _log_metrics_fix(f\"json.loads falló (genérico: {e}) → reparaciones…\")\n","\n","    # 2) Múltiples objetos concatenados\n","    for obj in _json_iter_concat_objects(txt):\n","        last = obj\n","        found = True\n","\n","    if found:\n","        return last\n","\n","    # 3) NDJSON (1 por línea)\n","    last = None\n","    for obj in _json_iter_ndjson_lines(txt):\n","        last = obj\n","        found = True\n","\n","    if found:\n","        return last\n","\n","    # 4) Sin suerte\n","    return None\n","\n","def _read_account_metrics_safe(path: str = None, default: Any = None, rewrite_ok: bool = True) -> Any:\n","    \"\"\"\n","    Lee account_metrics de forma segura. Si hay corrupción, extrae el último objeto válido\n","    y opcionalmente reescribe el archivo saneado. Si no hay nada válido, devuelve default o {}.\n","    \"\"\"\n","    path = path or ACCOUNT_METRICS_JSON\n","    if default is None:\n","        default = {}\n","\n","    try:\n","        with open(path, \"r\", encoding=\"utf-8\") as f:\n","            txt = f.read()\n","    except FileNotFoundError:\n","        _log_metrics_fix(\"archivo no existe → devolviendo default y creando uno nuevo.\")\n","        try:\n","            if rewrite_ok:\n","                _atomic_write_json(path, default)\n","        except Exception as e:\n","            _log_metrics_fix(f\"no se pudo crear archivo: {e}\")\n","        return default\n","    except Exception as e:\n","        _log_metrics_fix(f\"error leyendo archivo: {e} → default\")\n","        return default\n","\n","    if not txt.strip():\n","        _log_metrics_fix(\"archivo vacío → default\")\n","        if rewrite_ok:\n","            try: _atomic_write_json(path, default)\n","            except Exception: pass\n","        return default\n","\n","    # Intentar reparar\n","    obj = _repair_account_metrics_content(txt)\n","    if obj is None:\n","        _log_metrics_fix(\"no se encontró ningún objeto JSON válido → default\")\n","        if rewrite_ok:\n","            try: _atomic_write_json(path, default)\n","            except Exception: pass\n","        return default\n","\n","    # Reescribir saneado si el texto original no era un JSON limpio bonito\n","    try:\n","        # Si json.dumps(obj) no coincide (ignorando espacios), reescribimos.\n","        normalized_new = json.dumps(obj, ensure_ascii=False, separators=(\",\", \":\"))\n","        normalized_old = \"\".join(txt.split())\n","        if normalized_new != normalized_old:\n","            _log_metrics_fix(\"contenido reparado → reescritura atómica del archivo.\")\n","            if rewrite_ok:\n","                _atomic_write_json(path, obj)\n","    except Exception as e:\n","        _log_metrics_fix(f\"no se pudo normalizar/escribir: {e}\")\n","\n","    return obj\n","\n","def _write_account_metrics_safe(data: Any, path: str = None):\n","    \"\"\"Escritura segura/atómica del JSON de métricas.\"\"\"\n","    path = path or ACCOUNT_METRICS_JSON\n","    try:\n","        _atomic_write_json(path, data)\n","    except Exception as e:\n","        _log_metrics_fix(f\"error al escribir métricas: {e}\")\n","\n","# ----------------- DROP-IN REPLACEMENT (sustituye la línea problemática) -----------------\n","# Sustituye donde tengas:\n","#    d = json.load(open(ACCOUNT_METRICS_JSON, \"r\", encoding=\"utf-8\"))\n","# por:\n","#    d = _read_account_metrics_safe(ACCOUNT_METRICS_JSON, default={})\n","# De esta forma, aunque el archivo esté corrupto/concatenado, te devuelve el último objeto válido\n","# y, si corresponde, lo repara en disco.\n","# =========================================================================================\n","\n","# ================= PANDAFIX PERMANENTE (idempotente) =================\n","# Reemplaza:  import pandas as pd\n","import os, sys, subprocess, importlib, types, traceback\n","\n","def _pip_quiet(spec: str) -> bool:\n","    try:\n","        r = subprocess.run(\n","            [sys.executable, \"-m\", \"pip\", \"install\", \"--upgrade\", \"--quiet\", \"--no-warn-script-location\", spec],\n","            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False\n","        )\n","        return r.returncode == 0\n","    except Exception:\n","        return False\n","\n","def _cwd_shadowing_pandas() -> bool:\n","    \"\"\"¿Hay pandas.py o carpeta pandas/ en el cwd? (causa circular import)\"\"\"\n","    try:\n","        if os.path.isfile(\"pandas.py\") or os.path.isdir(\"pandas\"):\n","            return True\n","    except Exception:\n","        pass\n","    return False\n","\n","def _drop_partial_pandas_from_sysmodules():\n","    \"\"\"Elimina imports parciales que dejan roto pandas.* en sys.modules.\"\"\"\n","    for k in list(sys.modules.keys()):\n","        if k == \"pandas\" or k.startswith(\"pandas.\"):\n","            sys.modules.pop(k, None)\n","\n","def _safe_import_pandas():\n","    # 0) Detecta shadowing en el cwd (no rompas el resto del sys.path)\n","    removed_cwd = False\n","    if _cwd_shadowing_pandas():\n","        # Saca '' (cwd) temporalmente del path para importar el paquete real\n","        try:\n","            if \"\" in sys.path:\n","                sys.path.remove(\"\")\n","                removed_cwd = True\n","        except Exception:\n","            pass\n","\n","    # 1) Primer intento limpio\n","    try:\n","        import pandas as pd  # noqa\n","        return pd\n","    except Exception:\n","        pass\n","\n","    # 2) Si hay import parcial, limpialo y reintenta\n","    _drop_partial_pandas_from_sysmodules()\n","    try:\n","        import pandas as pd  # noqa\n","        return pd\n","    except Exception:\n","        err1 = traceback.format_exc()\n","\n","    # 3) Alinear versiones con NumPy actual (rueda precompilada)\n","    try:\n","        import numpy as _np\n","        np_ver = _np.__version__\n","    except Exception:\n","        np_ver = \"\"\n","\n","    # Pinned seguro y binario para Py3.12: pandas 2.2.x (>=2.2.2). Usamos 2.2.3.\n","    # (suele ser compatible con NumPy 2.0/2.1 en Colab/3.12)\n","    spec = \"pandas==2.2.3\"\n","    _pip_quiet(spec)\n","\n","    # Limpia e intenta nuevamente\n","    _drop_partial_pandas_from_sysmodules()\n","    try:\n","        import pandas as pd  # noqa\n","        return pd\n","    except Exception:\n","        err2 = traceback.format_exc()\n","\n","    # 4) Último recurso: SHIM mínimo para no bloquear (soporta lo que usa tu código)\n","    #    Implementa: DataFrame/Series con .copy(), .columns, __getitem__ por\n","    #    columna o lista de columnas, .astype(), .values, y read_csv básico.\n","    import csv\n","    import numpy as _np\n","\n","    class _SeriesShim:\n","        def __init__(self, arr, name=None):\n","            self._a = _np.asarray(arr)\n","            self.name = name\n","        def astype(self, dtype):\n","            return _SeriesShim(self._a.astype(dtype), self.name)\n","        @property\n","        def values(self):\n","            return _np.asarray(self._a)\n","        def __array__(self, *args, **kwargs):\n","            return _np.asarray(self._a)\n","\n","    class _DataFrameShim:\n","        def __init__(self, data: dict):\n","            # data: dict[str, sequence]\n","            self._data = {k: _np.asarray(v) for k, v in data.items()}\n","            self.columns = list(self._data.keys())\n","        def copy(self):\n","            return _DataFrameShim({k: v.copy() for k, v in self._data.items()})\n","        def __getitem__(self, key):\n","            if isinstance(key, list):\n","                return _DataFrameShim({k: self._data[k] for k in key})\n","            return _SeriesShim(self._data[key], name=key)\n","        def astype(self, dtype):\n","            return _DataFrameShim({k: _np.asarray(v).astype(dtype) for k, v in self._data.items()})\n","        @property\n","        def values(self):\n","            if not self.columns:\n","                return _np.empty((0, 0))\n","            cols = [self._data[c] for c in self.columns]\n","            return _np.column_stack(cols)\n","        def __len__(self):\n","            if not self.columns: return 0\n","            return len(self._data[self.columns[0]])\n","\n","    def _read_csv_shim(path, **kwargs):\n","        with open(path, \"r\", encoding=kwargs.get(\"encoding\", \"utf-8\")) as f:\n","            reader = csv.DictReader(f)\n","            cols = reader.fieldnames or []\n","            buckets = {c: [] for c in cols}\n","            for row in reader:\n","                for c in cols:\n","                    buckets[c].append(row.get(c))\n","        # intenta convertir a float donde sea posible\n","        for c, vec in buckets.items():\n","            try:\n","                buckets[c] = [float(x) if x not in (None, \"\", \"NaN\", \"nan\") else _np.nan for x in vec]\n","            except Exception:\n","                pass\n","        return _DataFrameShim(buckets)\n","\n","    shim = types.ModuleType(\"pandas\")\n","    shim.DataFrame = _DataFrameShim\n","    shim.Series = _SeriesShim\n","    shim.read_csv = _read_csv_shim\n","    shim.__dict__[\"__panda_fix_error__\"] = {\"first\": err1, \"second\": err2, \"numpy\": np_ver}\n","    sys.modules[\"pandas\"] = shim\n","    return shim\n","\n","pd = _safe_import_pandas()\n","# ================= FIN PANDAFIX PERMANENTE =================\n","\n","# ===================== [PARCHE PERMA] _safe_float retro-compatible ======================\n","# Arregla: \"_safe_float() takes 1 positional argument but 2 were given\"\n","# - Si ya tienes _safe_float(val, default=...), lo respeta.\n","# - Si tu _safe_float viejo aceptaba 1 solo parámetro, lo sustituye por una versión 2-args.\n","# - Parsing robusto: str con comas/espacios, tuplas/listas (toma el primero), dicts (price/last/c/close),\n","#   NaN/inf → default, clamp opcional.\n","\n","import inspect, math, re\n","\n","def _install_safe_float_patch():\n","    old = globals().get(\"_safe_float\")\n","    need_patch = True\n","    if callable(old):\n","        try:\n","            sig = inspect.signature(old)\n","            # ¿Tiene al menos 2 parámetros posicionales/por defecto?\n","            pos = [p for p in sig.parameters.values()\n","                   if p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)]\n","            if len(pos) >= 2:\n","                need_patch = False  # ya compatible\n","        except Exception:\n","            pass\n","\n","    if not need_patch:\n","        return \"ok_existing\"\n","\n","    def _safe_float(val=None, default=None, *, nan_policy=\"default\", clamp=None):\n","        \"\"\"\n","        Convierte a float o retorna 'default' en fallo.\n","        - nan_policy='default' → NaN/inf devuelven default (por compatibilidad).\n","        - clamp=(lo, hi) → recorta al rango si se pasa.\n","        \"\"\"\n","        try:\n","            # None / vacío\n","            if val is None:\n","                return default\n","            if isinstance(val, str):\n","                s = val.strip()\n","                if not s:\n","                    return default\n","                # quitar separadores comunes y símbolos ajenos\n","                s = s.replace(\",\", \"\")\n","                s = re.sub(r\"[^\\d\\.\\-eE+]+\", \"\", s) or \"\"\n","                if s in (\"\", \"-\", \"+\", \".\", \"+.\", \"-.\"):\n","                    return default\n","                x = float(s)\n","            else:\n","                # lista/tupla → primer elemento útil\n","                if isinstance(val, (list, tuple)) and val:\n","                    val = val[0]\n","                # dict con campos típicos\n","                if isinstance(val, dict):\n","                    for k in (\"price\", \"p\", \"last\", \"c\", \"close\", \"value\", \"v\"):\n","                        if k in val:\n","                            val = val[k]\n","                            break\n","                # bool → 0.0/1.0\n","                if isinstance(val, bool):\n","                    x = 1.0 if val else 0.0\n","                else:\n","                    x = float(val)\n","\n","            # clamp opcional\n","            if clamp is not None and isinstance(clamp, (tuple, list)) and len(clamp) == 2:\n","                lo, hi = clamp\n","                if lo is not None and x < lo:\n","                    x = lo\n","                if hi is not None and x > hi:\n","                    x = hi\n","\n","            # NaN/inf → default (policy por compat)\n","            if (isinstance(x, float) and (math.isnan(x) or math.isinf(x))):\n","                return default if nan_policy == \"default\" else x\n","\n","            return x\n","        except Exception:\n","            return default\n","\n","    globals()[\"_safe_float\"] = _safe_float\n","    return \"patched\"\n","\n","try:\n","    _SF_STATUS = _install_safe_float_patch()\n","    if os.getenv(\"TTDVI_VERBOSE\", \"0\") in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\"):\n","        print(f\"[SAFE_FLOAT] estado: {_SF_STATUS}\", flush=True)\n","except Exception as _e_sf:\n","    # Falla suave: no bloquea el resto del sistema\n","    try:\n","        print(f\"[SAFE_FLOAT] parche falló suavemente: {_e_sf}\", flush=True)\n","    except Exception:\n","        pass\n","# =================== FIN [PARCHE PERMA] _safe_float retro-compatible =====================\n","\n","# ================== FIX PERMA: _safe_int + logs seguros ==================\n","\n","# Si aún no instalaste el parche retrocompatible de _safe_float (2 args),\n","# pégalo más arriba. Aquí asumimos que _safe_float(val, default) ya existe.\n","\n","def _safe_int(val=None, default=None):\n","    \"\"\"Convierte a int de forma segura usando _safe_float como base.\"\"\"\n","    try:\n","        f = _safe_float(val, None)  # devuelve None si no puede parsear\n","        return int(f) if f is not None else default\n","    except Exception:\n","        return default\n","\n","# ---- NO PEGAR LÍNEAS DE LOG FUERA DE COMENTARIOS ----\n","# Guarda cualquier log anterior SOLO como comentario o string, jamás como código:\n","\"\"\"\n","[HISTÓRICO DE LOGS — SOLO REFERENCIA]\n","ERROR:trade:on_message: _safe_float() takes 1 positional argument but 2 were given\n","ERROR:ticker:on_message: _safe_float() takes 1 positional argument but 2 were given\n","ERROR:ohlc:on_message: _safe_float() takes 1 positional argument but 2 were given\n","\"\"\"\n","\n","# Helper para emitir logs en runtime (opcional)\n","def _log_ws_error(channel: str, exc: Exception | str):\n","    try:\n","        msg = str(exc)\n","    except Exception:\n","        msg = \"unknown\"\n","    try:\n","        print(f\"ERROR:{channel}:on_message: {msg}\", flush=True)\n","    except Exception:\n","        pass\n","# ========================================================================\n","\n","\n","# -*- coding: utf-8 -*-\n","\"\"\"\n","TTDVI156 — RESILIENCIA + INTEGRACIÓN SUAVE\n","- Supervisor con backoff + jitter (nunca se detiene si TTDVI_NEVER_STOP=1)\n","- Watchdogs: heartbeat (vida) + frescura de datos (reinicio si hay congelamiento)\n","- Autorun: autodetecta tu main (run_loop_principal / boot_darwin_v4_stack / main_async / main)\n","- Instrumentación SUAVE en API/Monitor/Core/Executor/Render/Cache:\n","    * Marca heartbeat y llegada de datos automáticamente\n","    * Registra sesiones HTTP (ej. aiohttp) para cierre limpio\n","- Hooks: get_runtime_state / restore_runtime_state / close_all_http_sessions / get_last_data_ts\n","- Parche PERMANENTE: run_loop como función + diccionario (admite item-assignment)\n","- Idempotente: puedes pegarlo 1 vez; no rompe si ya existe\n","\"\"\"\n","\n","import os\n","import sys\n","import json\n","import time\n","import asyncio\n","import signal\n","import atexit\n","import traceback\n","import inspect\n","import random\n","from typing import Any, Callable, Awaitable, Optional, Dict, List, Tuple\n","from datetime import datetime, timezone\n","\n","# ---------------------------- ENTORNO Y FLAGS --------------------------------\n","\n","os.environ.setdefault(\"TRANSFORMERS_NO_TF_WARNING\", \"1\")\n","os.environ.setdefault(\"DISABLE_MLFLOW_INTEGRATION\", \"1\")\n","os.environ.setdefault(\"TOKENIZERS_PARALLELISM\", \"false\")\n","\n","_TTDVI_VERBOSE = os.getenv(\"TTDVI_VERBOSE\", \"0\").strip().lower() in (\"1\", \"true\", \"yes\", \"on\", \"si\", \"sí\")\n","_TTDVI_NEVER_STOP = os.getenv(\"TTDVI_NEVER_STOP\", \"1\").strip().lower() in (\"1\", \"true\", \"yes\", \"on\", \"si\", \"sí\")\n","_TTDVI_HB_SECS = int(os.getenv(\"TTDVI_HEARTBEAT_SECS\", \"20\"))\n","_TTDVI_STALL_SECS = int(os.getenv(\"TTDVI_STALL_DETECT_SECS\", \"180\"))\n","_TTDVI_DATA_STALE_SECS = int(os.getenv(\"TTDVI_DATA_STALE_SECS\", \"300\"))\n","_TTDVI_CHECKPOINT = os.getenv(\"TTDVI_CHECKPOINT\", \"state/ttdvi_runtime_state.json\")\n","\n","# Registro global reutilizable\n","_REG = globals().setdefault(\"_TTDVI_REG\", {})\n","_REG.setdefault(\"last_hb\", 0.0)\n","_REG.setdefault(\"last_data_ts\", 0.0)\n","_REG.setdefault(\"boot_ts\", time.time())\n","_REG.setdefault(\"restart_count\", 0)\n","_REG.setdefault(\"crash_history\", [])\n","_REG.setdefault(\"tasks\", {})\n","_REG.setdefault(\"printing_prefix\", \"TTDVI\")\n","_REG.setdefault(\"shutting_down\", False)\n","_REG.setdefault(\"get_last_data_providers\", [])  # callables que devuelven ts de datos\n","_REG.setdefault(\"aiohttp_sessions\", set())      # sesiones a cerrar\n","_REG.setdefault(\"monkeypatch_done\", False)\n","\n","# ---------------------------- LOG / UTILS ------------------------------------\n","\n","def _log(msg: str):\n","    if _TTDVI_VERBOSE:\n","        try:\n","            print(f\"[{_REG.get('printing_prefix', 'TTDVI')}] {msg}\", flush=True)\n","        except Exception:\n","            pass\n","\n","def _now_ts() -> float:\n","    return time.time()\n","\n","def _ensure_parent_dir(path: str):\n","    try:\n","        from pathlib import Path\n","        Path(path).parent.mkdir(parents=True, exist_ok=True)\n","    except Exception:\n","        pass\n","\n","# ------------- PARCHE PERMANENTE RUN_LOOP: FUNCIÓN + DICCIONARIO --------------\n","\n","# Nota: este proxy permite usar notación dict sobre la función run_loop\n","#       (p. ej., run_loop[\"armed\"]=True) y sigue siendo invocable normal: run_loop(...)\n","\n","class _CallableMapProxy:\n","    __slots__ = (\"_func\", \"_store\")\n","\n","    def __init__(self, func: Callable):\n","        object.__setattr__(self, \"_func\", func)\n","        object.__setattr__(self, \"_store\", {})\n","        try:\n","            self.__name__ = getattr(func, \"__name__\", \"run_loop\")\n","        except Exception:\n","            pass\n","\n","    # Modo función\n","    def __call__(self, *args, **kwargs):\n","        return self._func(*args, **kwargs)\n","\n","    # Modo \"dict\"\n","    def __getitem__(self, key: Any) -> Any:\n","        return self._store[key]\n","\n","    def __setitem__(self, key: Any, value: Any) -> None:\n","        self._store[key] = value\n","        # espejo como atributo (best-effort, no obligatorio)\n","        try:\n","            setattr(self._func, str(key), value)\n","        except Exception:\n","            pass\n","\n","    def __contains__(self, key: Any) -> bool:\n","        return key in self._store\n","\n","    def get(self, key: Any, default: Any = None) -> Any:\n","        return self._store.get(key, default)\n","\n","    def setdefault(self, key: Any, default: Any = None) -> Any:\n","        return self._store.setdefault(key, default)\n","\n","    def update(self, other: dict) -> None:\n","        for k, v in dict(other).items():\n","            self[k] = v\n","\n","    def keys(self):\n","        return self._store.keys()\n","\n","    def items(self):\n","        return self._store.items()\n","\n","    def __repr__(self) -> str:\n","        try:\n","            fn = getattr(self._func, \"__name__\", \"run_loop\")\n","        except Exception:\n","            fn = \"run_loop\"\n","        return f\"<CallableMapProxy func={fn} store_keys={list(self._store.keys())}>\"\n","\n","    # Delegación de atributos a la función original\n","    def __getattr__(self, name: str):\n","        return getattr(self._func, name)\n","\n","    def __setattr__(self, name: str, value: Any) -> None:\n","        try:\n","            setattr(self._func, name, value)\n","        except Exception:\n","            pass\n","        self._store[name] = value\n","\n","# Normalizador genérico por si dentro de tu run_loop mutas cfg/state/flags con []=\n","from collections.abc import MutableMapping\n","_WRAPPED_WARN = set()\n","\n","def _ensure_mapping(obj, name=\"obj\"):\n","    \"\"\"Devuelve un mapping seguro:\n","       - mapping → tal cual\n","       - None → {}\n","       - callable → _CallableMapProxy(obj)\n","       - otro → {\"value\": obj}  (para no romper asignaciones por índice)\n","    \"\"\"\n","    if isinstance(obj, MutableMapping):\n","        return obj\n","    if obj is None:\n","        return {}\n","    if callable(obj):\n","        if id(obj) not in _WRAPPED_WARN:\n","            _WRAPPED_WARN.add(id(obj))\n","            try:\n","                import warnings\n","                warnings.warn(f\"[run_loop] {name} era callable y se envolvió con _CallableMapProxy.\", RuntimeWarning)\n","            except Exception:\n","                pass\n","        return _CallableMapProxy(obj)\n","    if id(obj) not in _WRAPPED_WARN:\n","        _WRAPPED_WARN.add(id(obj))\n","        try:\n","            import warnings\n","            warnings.warn(f\"[run_loop] {name} no era mapping; se boxeó en dict con clave 'value'.\", RuntimeWarning)\n","        except Exception:\n","            pass\n","    return {\"value\": obj}\n","\n","def parchear_run_loop_en_globals(g: dict = None) -> str:\n","    \"\"\"\n","    Si existe 'run_loop' como callable sin __setitem__, lo proxifica para permitir\n","    run_loop[\"x\"]=... sin romper la invocación run_loop(...). Idempotente.\n","    \"\"\"\n","    g = g or globals()\n","    rl = g.get(\"run_loop\", None)\n","    if rl is None:\n","        return \"sin_run_loop\"\n","    if isinstance(rl, _CallableMapProxy):\n","        return \"ya_proxificado\"\n","    if callable(rl) and not hasattr(rl, \"__setitem__\"):\n","        g[\"run_loop\"] = _CallableMapProxy(rl)\n","        return \"proxificado\"\n","    return \"sin_cambios\"\n","\n","def _garantizar_parche_run_loop():\n","    try:\n","        estado = parchear_run_loop_en_globals()\n","        if _TTDVI_VERBOSE and estado in (\"proxificado\", \"ya_proxificado\"):\n","            _log(f\"🧩 run_loop proxy: {estado}\")\n","    except Exception as e:\n","        _log(f\"⚠️ run_loop proxy fallo suave: {e}\")\n","\n","# ---------------------------- CHECKPOINT -------------------------------------\n","\n","def save_runtime_state(state: Dict[str, Any]):\n","    try:\n","        _ensure_parent_dir(_TTDVI_CHECKPOINT)\n","        with open(_TTDVI_CHECKPOINT, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(state, f, ensure_ascii=False, indent=2)\n","        _log(f\"💾 Checkpoint → {_TTDVI_CHECKPOINT}\")\n","    except Exception as e:\n","        _log(f\"⚠️ No se pudo guardar checkpoint: {e}\")\n","\n","def load_runtime_state() -> Dict[str, Any]:\n","    try:\n","        with open(_TTDVI_CHECKPOINT, \"r\", encoding=\"utf-8\") as f:\n","            return json.load(f)\n","    except Exception:\n","        return {}\n","\n","# ---------------------------- HEARTBEAT / DATA --------------------------------\n","\n","def touch_heartbeat():\n","    _REG[\"last_hb\"] = _now_ts()\n","\n","def notify_new_data(ts: Optional[float] = None):\n","    \"\"\"Llama esto siempre que lleguen datos reales (ticker/ohlc/ws).\"\"\"\n","    _REG[\"last_data_ts\"] = float(ts or _now_ts())\n","\n","# ---------------------------- DISCOVERY UTILS --------------------------------\n","\n","def _first_callable(names: List[str]) -> Optional[Callable]:\n","    g = globals()\n","    for nm in names:\n","        fn = g.get(nm)\n","        if callable(fn):\n","            return fn\n","    return None\n","\n","def _discover_main_factory() -> Optional[Callable[[], Awaitable]]:\n","    \"\"\"\n","    Devuelve una factory que, al invocarse y esperarse (await), ejecuta tu main real:\n","      - run_loop_principal() (async)\n","      - boot_darwin_v4_stack() (sync -> puede devolver objeto con .run()/.start() o un coro)\n","      - main_async() (async)\n","      - main() (sync o async)\n","    Si el target es sync y devuelve un objeto con .run()/.start(), se invoca y se espera si es coroutine.\n","    \"\"\"\n","    g = globals()\n","    candidates = [\"run_loop_principal\", \"boot_darwin_v4_stack\", \"main_async\", \"main\"]\n","    target = _first_callable(candidates)\n","    if target is None:\n","        return None\n","\n","    async def _factory():\n","        res = target()\n","        # Si es coroutine -> ejecutar\n","        if inspect.iscoroutine(res):\n","            return await res\n","        # Si devuelve objeto con .run()/.start()\n","        for attr in (\"run\", \"start\"):\n","            fn = getattr(res, attr, None)\n","            if callable(fn):\n","                out = fn()\n","                if inspect.iscoroutine(out):\n","                    return await out\n","                return out\n","        # Si es sync que retorna inmediatamente, mantener latido\n","        await asyncio.sleep(0.01)\n","        return res\n","\n","    return _factory\n","\n","# ---------------------------- INSTRUMENTACIÓN SUAVE ---------------------------\n","\n","def _safe_getattr(obj: Any, name: str):\n","    try:\n","        return getattr(obj, name)\n","    except Exception:\n","        return None\n","\n","def _wrap_once(func: Callable, marker: str, builder: Callable[[Callable], Callable]) -> Callable:\n","    if not callable(func):\n","        return func\n","    if getattr(func, \"_ttdvi_wrapped\", None) == marker:\n","        return func\n","    wrapped = builder(func)\n","    try:\n","        setattr(wrapped, \"_ttdvi_wrapped\", marker)\n","    except Exception:\n","        pass\n","    return wrapped\n","\n","def _maybe_signal_data_from_result(r: Any):\n","    \"\"\"Marca datos si se detecta precio/close o velas con close > 0.\"\"\"\n","    ts = None\n","    px = None\n","\n","    if isinstance(r, dict):\n","        res = r.get(\"result\", r)\n","        if isinstance(res, dict):\n","            for k in (\"price\", \"last\", \"c\", \"close\", \"p\", \"px\"):\n","                v = res.get(k)\n","                if isinstance(v, (int, float)) and v > 0:\n","                    px = float(v)\n","                    break\n","                if isinstance(v, list) and v:\n","                    try:\n","                        px = float(v[0]); break\n","                    except Exception:\n","                        pass\n","            for k in (\"time\", \"ts\", \"timestamp\", \"t\"):\n","                v = res.get(k)\n","                if isinstance(v, (int, float)) and v > 0:\n","                    ts = float(v); break\n","\n","    elif isinstance(r, (list, tuple)) and r:\n","        try:\n","            if len(r) >= 5:\n","                ts = float(r[0]); px = float(r[4])  # [t,o,h,l,c,...]\n","            elif len(r) >= 2:\n","                ts = float(r[0]); px = float(r[1])  # (ts, px)\n","        except Exception:\n","            pass\n","\n","    if px is not None and px > 0:\n","        notify_new_data(ts)\n","\n","def _builder_io(tag: str):\n","    def _mk(fn: Callable):\n","        if inspect.iscoroutinefunction(fn):\n","            async def _aw(*a, **k):\n","                r = await fn(*a, **k)\n","                try: _maybe_signal_data_from_result(r)\n","                except Exception: pass\n","                touch_heartbeat(); return r\n","            return _aw\n","        else:\n","            def _w(*a, **k):\n","                r = fn(*a, **k)\n","                try: _maybe_signal_data_from_result(r)\n","                except Exception: pass\n","                touch_heartbeat(); return r\n","            return _w\n","    return _mk\n","\n","def _builder_cpu(tag: str):\n","    def _mk(fn: Callable):\n","        if inspect.iscoroutinefunction(fn):\n","            async def _aw(*a, **k):\n","                r = await fn(*a, **k)\n","                touch_heartbeat(); return r\n","            return _aw\n","        else:\n","            def _w(*a, **k):\n","                r = fn(*a, **k)\n","                touch_heartbeat(); return r\n","            return _w\n","    return _mk\n","\n","def _patch_api_like(api):\n","    if not api: return\n","    io_names = [\n","        \"get_ticker\",\"fetch_ticker\",\"ticker\",\n","        \"get_ohlc\",\"fetch_ohlc\",\"ohlc\",\n","        \"get_ticker_kraken\",\"get_ohlc_kraken\",\n","        \"stream_prices\",\"ws_prices\",\"subscribe\",\"on_message\",\"handle_message\",\n","    ]\n","    for nm in io_names:\n","        fn = _safe_getattr(api, nm)\n","        if callable(fn):\n","            wrapped = _wrap_once(fn, f\"io{nm}\", _builder_io(nm))\n","            try: setattr(api, nm, wrapped)\n","            except Exception: pass\n","\n","    for cand in (\"session\", \"_session\", \"http\", \"_http\"):\n","        sess = _safe_getattr(api, cand)\n","        if sess is not None:\n","            try: _REG.setdefault(\"aiohttp_sessions\", set()).add(sess)\n","            except Exception: pass\n","\n","def _patch_market_monitor(mm):\n","    if not mm: return\n","    for nm in (\"loop_vivo\",\"run\",\"start\",\"iterate\",\"_loop\",\"_run\"):\n","        fn = _safe_getattr(mm, nm)\n","        if callable(fn):\n","            wrapped = _wrap_once(fn, f\"cpu{nm}\", _builder_cpu(nm))\n","            try: setattr(mm, nm, wrapped)\n","            except Exception: pass\n","    for cb in (\"on_tick\",\"on_ohlc\",\"on_data\",\"emit\"):\n","        fn = _safe_getattr(mm, cb)\n","        if callable(fn):\n","            def builder(fn_local):\n","                if inspect.iscoroutinefunction(fn_local):\n","                    async def _aw(*a, **k):\n","                        r = await fn_local(*a, **k)\n","                        notify_new_data(); touch_heartbeat(); return r\n","                    return _aw\n","                else:\n","                    def _w(*a, **k):\n","                        r = fn_local(*a, **k)\n","                        notify_new_data(); touch_heartbeat(); return r\n","                    return _w\n","            wrapped = _wrap_once(fn, f\"cb{cb}\", builder)\n","            try: setattr(mm, cb, wrapped)\n","            except Exception: pass\n","\n","def _patch_core(core):\n","    if not core: return\n","    for nm in (\"step\",\"run_cycle\",\"update\",\"tick\",\"process\"):\n","        fn = _safe_getattr(core, nm)\n","        if callable(fn):\n","            wrapped = _wrap_once(fn, f\"cpu{nm}\", _builder_cpu(nm))\n","            try: setattr(core, nm, wrapped)\n","            except Exception: pass\n","\n","def _patch_executor(exe):\n","    if not exe: return\n","    for nm in (\"run\",\"run_cycle\",\"execute\",\"loop\",\"iterate\"):\n","        fn = _safe_getattr(exe, nm)\n","        if callable(fn):\n","            wrapped = _wrap_once(fn, f\"cpu{nm}\", _builder_cpu(nm))\n","            try: setattr(exe, nm, wrapped)\n","            except Exception: pass\n","\n","def _patch_render(rnd):\n","    if not rnd: return\n","    for nm in (\"render\",\"render_dashboard\",\"render_en_vivo\",\"save_png\",\"plot\"):\n","        fn = _safe_getattr(rnd, nm)\n","        if callable(fn):\n","            wrapped = _wrap_once(fn, f\"cpu{nm}\", _builder_cpu(nm))\n","            try: setattr(rnd, nm, wrapped)\n","            except Exception: pass\n","\n","def _patch_cache(cache):\n","    if not cache: return\n","    ts = _safe_getattr(cache, \"last_ts\")\n","    if isinstance(ts, (int, float)):\n","        try:\n","            register_last_data_provider  # noqa\n","        except NameError:\n","            def register_last_data_provider(fn):\n","                _REG.setdefault(\"get_last_data_providers\", []).append(fn)\n","        try:\n","            register_last_data_provider(lambda: float(_safe_getattr(cache, \"last_ts\") or 0.0))\n","        except Exception:\n","            pass\n","\n","def apply_resilience_instrumentation():\n","    \"\"\"Busca e instrumenta objetos conocidos si existen en globals().\"\"\"\n","    if _REG.get(\"monkeypatch_done\", False):\n","        return\n","\n","    g = globals()\n","\n","    # APIs\n","    for name in (\"api\",\"API\",\"APIManager\",\"kraken\",\"kraken_api\",\"client\",\"DataProvider\",\"ExchangeClient\"):\n","        obj = g.get(name)\n","        if obj: _patch_api_like(obj)\n","\n","    # MarketMonitor\n","    for name in (\"market_monitor\",\"MarketMonitor\",\"monitor\"):\n","        obj = g.get(name)\n","        if obj: _patch_market_monitor(obj)\n","\n","    # Core\n","    core = g.get(\"core\") or g.get(\"QuantumTradingCore\")\n","    if core: _patch_core(core)\n","\n","    # Executor\n","    exe = g.get(\"executor\") or g.get(\"UltraOrderExecutor\") or g.get(\"EnhancedOrderExecutor\")\n","    if exe: _patch_executor(exe)\n","\n","    # Render\n","    rnd = g.get(\"render\") or g.get(\"RenderEnVivo\") or g.get(\"renderer\")\n","    if rnd: _patch_render(rnd)\n","\n","    # Cache\n","    cache = g.get(\"cache\") or g.get(\"CachePrecios\")\n","    if cache: _patch_cache(cache)\n","\n","    # Último toque: proveedores explícitos de ts\n","    for name in (\"SentimientoMercadoBTC\",\"ComparadorTendencias\",\"MarketMonitor\",\"CachePrecios\"):\n","        obj = g.get(name)\n","        if obj and hasattr(obj, \"get_last_data_ts\") and callable(obj.get_last_data_ts):\n","            try: register_last_data_provider(obj.get_last_data_ts)\n","            except Exception: pass\n","\n","    _REG[\"monkeypatch_done\"] = True\n","    _log(\"🧩 Instrumentación aplicada (datos/heartbeat).\")\n","\n","# ---------------------------- HOOKS / PROVEEDORES -----------------------------\n","\n","def get_last_data_ts() -> float:\n","    for prov in list(_REG.get(\"get_last_data_providers\", [])):\n","        try:\n","            ts = prov()\n","            if ts and ts > 0: return float(ts)\n","        except Exception:\n","            continue\n","    ts = float(_REG.get(\"last_data_ts\", 0.0))\n","    if ts > 0: return ts\n","    for obj_name in (\"cache\",\"CachePrecios\",\"market_monitor\",\"MarketMonitor\"):\n","        obj = globals().get(obj_name)\n","        if obj:\n","            for attr in (\"last_ts\",\"last_update\",\"last_data_ts\"):\n","                v = _safe_getattr(obj, attr)\n","                if isinstance(v, (int, float)) and v > 0:\n","                    return float(v)\n","    return 0.0\n","\n","def register_last_data_provider(fn: Callable[[], float]):\n","    _REG.setdefault(\"get_last_data_providers\", []).append(fn)\n","\n","async def close_all_http_sessions():\n","    errs = 0\n","    for sess in list(_REG.get(\"aiohttp_sessions\", set())):\n","        try:\n","            if hasattr(sess, \"close\") and callable(sess.close):\n","                res = sess.close()\n","                if inspect.iscoroutine(res): await res\n","            elif hasattr(sess, \"aclosed\"):\n","                res = sess.aclosed()\n","                if inspect.iscoroutine(res): await res\n","        except Exception:\n","            errs += 1\n","    if errs and _TTDVI_VERBOSE:\n","        _log(f\"⚠️ {errs} sesiones no pudieron cerrarse limpiamente.\")\n","\n","def get_runtime_state() -> dict:\n","    state: Dict[str, Any] = {\n","        \"restart_count\": int(_REG.get(\"restart_count\", 0)),\n","        \"last_data_ts\": float(_REG.get(\"last_data_ts\", 0.0)),\n","    }\n","    core = globals().get(\"core\") or globals().get(\"QuantumTradingCore\")\n","    if core is not None:\n","        for k in (\"equity\",\"ultima_senal\",\"posiciones_abiertas\"):\n","            v = _safe_getattr(core, k)\n","            if v is not None:\n","                state.setdefault(\"core\", {})[k] = v\n","    return state\n","\n","def restore_runtime_state(state: dict) -> None:\n","    try:\n","        _REG[\"restart_count\"] = int(state.get(\"restart_count\", 0))\n","        last_ts = float(state.get(\"last_data_ts\", 0.0))\n","        if last_ts > 0:\n","            _REG[\"last_data_ts\"] = last_ts\n","\n","        core = globals().get(\"core\") or globals().get(\"QuantumTradingCore\")\n","        core_state = state.get(\"core\") if isinstance(state, dict) else None\n","        if core is not None and isinstance(core_state, dict):\n","            for k, v in core_state.items():\n","                try: setattr(core, k, v)\n","                except Exception: pass\n","    except Exception as e:\n","        _log(f\"⚠️ restore_runtime_state fallo: {e}\")\n","\n","# ---------------------------- WATCHDOG TASKS ----------------------------------\n","\n","async def _heartbeat_task():\n","    while not _REG.get(\"shutting_down\", False):\n","        touch_heartbeat()\n","        await asyncio.sleep(_TTDVI_HB_SECS)\n","\n","async def _stall_guard_task():\n","    while not _REG.get(\"shutting_down\", False):\n","        await asyncio.sleep(max(5, _TTDVI_HB_SECS // 2))\n","        now = _now_ts()\n","        last = float(_REG.get(\"last_hb\", 0.0))\n","        if last and (now - last) > _TTDVI_STALL_SECS:\n","            _log(f\"⛔ Stall: {(now - last):.0f}s sin HB (> {_TTDVI_STALL_SECS}s) → reinicio\")\n","            raise RuntimeError(\"Stall detected (no heartbeat)\")\n","\n","async def _data_freshness_guard_task():\n","    while not _REG.get(\"shutting_down\", False):\n","        await asyncio.sleep(10)\n","        last_data_ts = get_last_data_ts()\n","        if not last_data_ts:\n","            continue\n","        delta = _now_ts() - float(last_data_ts)\n","        if delta > _TTDVI_DATA_STALE_SECS:\n","            _log(f\"⚠️ Datos estancados: {delta:.0f}s (> {_TTDVI_DATA_STALE_SECS}s) → reinicio suave\")\n","            raise RuntimeError(\"Data stale detected\")\n","\n","# ---------------------------- SUPERVISOR PRINCIPAL ----------------------------\n","\n","async def run_with_resilience(main_coro_factory: Optional[Callable[[], Awaitable]] = None):\n","    if main_coro_factory is None:\n","        main_coro_factory = _discover_main_factory()\n","    if main_coro_factory is None:\n","        async def _fallback_main():\n","            _log(\"🛟 (resilience) No hay main visible. Usando FallbackMain (latido).\")\n","            while not _REG.get(\"shutting_down\", False):\n","                await asyncio.sleep(1.0)\n","        main_coro_factory = _fallback_main\n","\n","    try:\n","        st = load_runtime_state()\n","        if st:\n","            _log(\"♻️ Restaurando estado previo…\")\n","            restore_runtime_state(st)\n","    except Exception as e:\n","        _log(f\"⚠️ No se pudo restaurar estado: {e}\")\n","\n","    backoff = 1.5\n","    backoff_max = 60.0\n","    attempt = 0\n","\n","    while True:\n","        attempt += 1\n","        _log(f\"🚀 Lanzando main (intento #{attempt})…\")\n","\n","        # Parche de run_loop ANTES de instrumentar\n","        _garantizar_parche_run_loop()\n","\n","        apply_resilience_instrumentation()\n","\n","        loop = asyncio.get_running_loop()\n","        hb = loop.create_task(_heartbeat_task(), name=\"ttdvi_heartbeat\")\n","        stall_guard = loop.create_task(_stall_guard_task(), name=\"ttdvi_stall_guard\")\n","        fresh_guard = loop.create_task(_data_freshness_guard_task(), name=\"ttdvi_data_guard\")\n","        _REG[\"tasks\"].update({\"hb\": hb, \"stall_guard\": stall_guard, \"fresh_guard\": fresh_guard})\n","\n","        main_exc: Optional[BaseException] = None\n","        try:\n","            if callable(main_coro_factory):\n","                await main_coro_factory()\n","            else:\n","                await main_coro_factory\n","        except asyncio.CancelledError:\n","            main_exc = None\n","            _log(\"🛑 Main cancelado explícitamente.\")\n","        except BaseException as e:\n","            main_exc = e\n","            _log(f\"💥 Excepción en main: {type(e).__name__}: {e}\\n\" + traceback.format_exc())\n","\n","        for t in (hb, stall_guard, fresh_guard):\n","            if not t.done():\n","                t.cancel()\n","\n","        try:\n","            await close_all_http_sessions()\n","        except Exception as e:\n","            _log(f\"⚠️ Error cerrando sesiones HTTP: {e}\")\n","\n","        try:\n","            state = get_runtime_state()\n","            if isinstance(state, dict):\n","                save_runtime_state(state)\n","        except Exception as e:\n","            _log(f\"⚠️ get_runtime_state falló: {e}\")\n","\n","        if _REG.get(\"shutting_down\", False):\n","            _log(\"✅ Cierre limpio solicitado. Saliendo del supervisor.\")\n","            break\n","\n","        crash_ts = _now_ts()\n","        _REG[\"crash_history\"].append(crash_ts)\n","        _REG[\"crash_history\"] = [t for t in _REG[\"crash_history\"] if crash_ts - t < 600]  # 10 min\n","\n","        if len(_REG[\"crash_history\"]) >= 5:\n","            _log(\"♨️ Muchos fallos en 10min → reset tibio de entorno asyncio.\")\n","            await asyncio.sleep(1.0)\n","\n","        if not _TTDVI_NEVER_STOP and main_exc is None:\n","            _log(\"⚠️ Main terminó sin error y NEVER_STOP=0 → fin.\")\n","            break\n","\n","        delay = min(backoff, backoff_max) * (1 + random.random() * 0.2)\n","        _log(f\"🔁 Reiniciando en {delay:.1f}s (backoff)…\")\n","        await asyncio.sleep(delay)\n","        backoff = min(backoff * 1.7, backoff_max)\n","        _REG[\"restart_count\"] += 1\n","\n","# ---------------------------- SIGNALS / SHUTDOWN ------------------------------\n","\n","def _request_shutdown(*_args):\n","    if not _REG.get(\"shutting_down\", False):\n","        _REG[\"shutting_down\"] = True\n","        _log(\"🧹 Señal de cierre recibida. Intentando parada limpia…\")\n","\n","for sig in (getattr(signal, \"SIGINT\", None), getattr(signal, \"SIGTERM\", None)):\n","    if sig:\n","        try:\n","            signal.signal(sig, _request_shutdown)\n","        except Exception:\n","            pass\n","atexit.register(lambda: _request_shutdown())\n","\n","# ---------------------------- AUTORUN / ENCHUFE -------------------------------\n","# Bloque blindado: descubre main, crea fallback si no existe, y evita \"Task exception was never retrieved\"\n","\n","import asyncio as _asyncio_again, inspect as _inspect_again, time as _time_again, sys as _sys_again, types as _types_again, contextlib\n","\n","def _garantizar_parche_run_loop_autorun():\n","    \"\"\"Crea un proxy de run_loop si algunas piezas lo esperan.\"\"\"\n","    g = globals()\n","    if \"run_loop\" in g and callable(g[\"run_loop\"]):\n","        return\n","    target = None\n","    for name in (\"run_loop_principal\",\"main_async\",\"main\"):\n","        if name in g and callable(g[name]):\n","            target = g[name]; break\n","    if target is None:\n","        async def _stub_run_loop():\n","            _log(\"⏳ run_loop (stub): a la espera de que definas tu main real…\")\n","            while not _REG.get(\"shutting_down\", False):\n","                await asyncio.sleep(0.5)\n","        g[\"run_loop\"] = _stub_run_loop\n","    else:\n","        async def _proxy_run_loop():\n","            res = target()\n","            if inspect.iscoroutine(res):\n","                await res\n","        g[\"run_loop\"] = _proxy_run_loop\n","\n","def _fallback_main_factory():\n","    async def _fallback_main():\n","        _log(\"🛟 No se encontró ningún main definido. Ejecutando FallbackMain (latido seguro).\")\n","        try:\n","            while not _REG.get(\"shutting_down\", False):\n","                await asyncio.sleep(1.0)\n","        except asyncio.CancelledError:\n","            _log(\"🛟 FallbackMain cancelado: salida limpia.\"); raise\n","    return _fallback_main\n","\n","def _attach_task_logging(task: asyncio.Task, label: str = \"ttdvi_task\"):\n","    def _done(t: asyncio.Tas