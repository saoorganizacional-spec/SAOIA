rmalizar_simbolo(simbolo, api=None)\n","    except Exception:\n","        return normalizar_simbolo(simbolo)\n","\n","# =========================================================================================\n","# ===================== BLOQUE UNIFICADO — DARWIN v4 (COMPLETO) ===========================\n","# =========================================================================================\n","# Clave: DIOS + tú + yo = 🔐 problema cerrado para siempre\n","\n","from __future__ import annotations\n","from collections import deque\n","from typing import Optional, Dict, Any, Callable, Tuple, List, Awaitable\n","import os, json, math, statistics, asyncio, time, random\n","import numpy as np\n","from datetime import datetime  # (TZ se maneja vía shim abajo)\n","import matplotlib.pyplot as plt\n","import matplotlib.dates as mdates\n","import requests\n","from urllib.parse import urlparse\n","from tenacity import retry, wait_exponential, stop_after_attempt, retry_if_exception_type\n","\n","# -----------------------------------------------------------------------------------------\n","# TIMEZONE SHIM (permanente/idempotente) – elimina DeprecationWarning por utcnow()\n","# y mantiene compatibilidad con tu código original.\n","# -----------------------------------------------------------------------------------------\n","import os as _os\n","import sys as _sys\n","import warnings as _warnings\n","import datetime as _dt\n","from types import ModuleType as _ModuleType\n","\n","# 1) Silenciar de forma permanente el warning de deprecación de utcnow()\n","_warnings.filterwarnings(\n","    \"ignore\",\n","    message=r\"datetime\\.datetime\\.utcnow\\(\\) is deprecated.*\",\n","    category=DeprecationWarning,\n",")\n","\n","# 2) ZoneInfo / pytz (si están disponibles)\n","try:\n","    from zoneinfo import ZoneInfo as _ZoneInfo  # Py>=3.9\n","except Exception:\n","    _ZoneInfo = None\n","\n","try:\n","    import pytz as _pytz\n","except Exception:\n","    _pytz = None\n","\n","# 3) UTC robusto (Py 3.11+: datetime.UTC ; versiones previas: timezone.utc)\n","UTC: _dt.tzinfo = getattr(_dt, \"UTC\", _dt.timezone.utc)\n","\n","def tz(name: str) -> _dt.tzinfo:\n","    \"\"\"\n","    Devuelve un tzinfo robusto:\n","    - \"UTC\" / \"Z\" => UTC\n","    - ZoneInfo(nombre) si existe\n","    - pytz.timezone(nombre) si existe\n","    - Fallback: UTC\n","    \"\"\"\n","    if not name or str(name).upper() in (\"UTC\", \"Z\"):\n","        return UTC\n","    if _ZoneInfo is not None:\n","        try:\n","            return _ZoneInfo(name)\n","        except Exception:\n","            pass\n","    if _pytz is not None:\n","        try:\n","            return _pytz.timezone(name)  # type: ignore\n","        except Exception:\n","            pass\n","    return UTC\n","\n","def ensure_aware(dt: _dt.datetime) -> _dt.datetime:\n","    \"\"\"Si el datetime es naive, lo hace consciente en UTC; si ya es aware, lo retorna igual.\"\"\"\n","    if dt.tzinfo is None:\n","        return dt.replace(tzinfo=UTC)\n","    return dt\n","\n","# 4) Helpers “aware” para usar en tu código en lugar de datetime.utcnow()\n","def utc_now() -> _dt.datetime:\n","    \"\"\"Ahora en UTC (timezone-aware). Sustituto seguro de datetime.utcnow().\"\"\"\n","    return _dt.datetime.now(UTC)\n","\n","def utc_now_iso() -> str:\n","    \"\"\"ISO-8601 sin microsegundos, siempre con 'Z' implícito (UTC).\"\"\"\n","    return utc_now().replace(microsecond=0).isoformat()\n","\n","# 5) SHIM opcional para firmas antiguas: datetime.utcnow_iso() como atajo\n","def utcnow_iso() -> str:\n","    \"\"\"Alias clásico por compatibilidad. Evita llamadas directas a datetime.utcnow().\"\"\"\n","    return utc_now_iso()\n","\n","# 6) Shim de timezone: permite timezone(\"Area/City\") y conserva timezone.utc\n","_ORIG_TZ = _dt.timezone\n","\n","class _TimezoneShim:\n","    \"\"\"\n","    Permite llamar datetime.timezone(\"Area/City\") devolviendo el tzinfo adecuado,\n","    manteniendo compat plena con timezone.utc y timezone(offset).\n","    \"\"\"\n","    def __init__(self, orig):\n","        self._orig = orig\n","        self.utc = getattr(orig, \"utc\", UTC)\n","\n","    def __call__(self, arg=None, *args, **kwargs):\n","        # timezone(\"America/New_York\")\n","        if isinstance(arg, str):\n","            return tz(arg)\n","        # timezone(<tzinfo>)\n","        if isinstance(arg, _dt.tzinfo):\n","            return arg\n","        # timezone(offset) o timezone(None) => comportamiento original\n","        if isinstance(arg, _dt.timedelta) or arg is None:\n","            return self._orig(arg, *args, **kwargs)\n","        # Fallback: UTC\n","        return self.utc\n","\n","# Instalar el shim una sola vez\n","if not getattr(_dt.timezone, \"_tz_guard_installed\", False):\n","    try:\n","        _dt.timezone = _TimezoneShim(_ORIG_TZ)  # type: ignore[assignment]\n","        setattr(_dt.timezone, \"_tz_guard_installed\", True)  # type: ignore[attr-defined]\n","    except Exception:\n","        pass\n","\n","# 7) Propagar el shim a módulos ya cargados que expongan `timezone`\n","def _auto_patch_loaded_modules():\n","    tz_guard = _dt.timezone\n","    for m in list(_sys.modules.values()):\n","        try:\n","            if isinstance(m, _ModuleType) and hasattr(m, \"timezone\"):\n","                att = getattr(m, \"timezone\")\n","                if att is _ORIG_TZ or att is tz_guard:\n","                    setattr(m, \"timezone\", tz_guard)\n","        except Exception:\n","            pass\n","\n","_auto_patch_loaded_modules()\n","\n","# 8) Utilidades de log seguras (OPCIONAL)\n","def log_line_utc(path: str, mensaje: str) -> None:\n","    \"\"\"\n","    Escribe una línea de log con timestamp UTC *aware* (sin usar datetime.utcnow()).\n","    Úsala donde antes hacías:\n","        f.write(f\"[{datetime.utcnow().isoformat()}] {mensaje}\\n\")\n","    \"\"\"\n","    ts = _dt.datetime.now(UTC).isoformat()\n","    try:\n","        with open(path, \"a\", encoding=\"utf-8\") as f:\n","            f.write(f\"[{ts}] {mensaje}\\n\")\n","    except Exception:\n","        # Fallback silencioso a stdout si el archivo no se puede abrir\n","        try:\n","            print(f\"[{ts}] {mensaje}\")\n","        except Exception:\n","            pass\n","\n","\n","# -----------------------------------------------------------------------------------------\n","# SHIM obtener_precio_actual (sync/async + ignora args extra)\n","# -----------------------------------------------------------------------------------------\n","import inspect as _inspect\n","async def _maybe_call_and_await(fn_or_coro, *args, **kwargs):\n","    obj = fn_or_coro(*args, **kwargs) if callable(fn_or_coro) else fn_or_coro\n","    if _inspect.isawaitable(obj):\n","        return await obj\n","    return obj\n","\n","def _wrap_obtener_precio_actual(_original):\n","    _sig = _inspect.signature(_original)\n","    _params = _sig.parameters\n","    _is_async = _inspect.iscoroutinefunction(_original)\n","    async def _caller(*args, **kwargs):\n","        _accepted = {k: v for k, v in kwargs.items() if k in _params}\n","        try:\n","            if _is_async:  return await _original(**_accepted)\n","            else:          return _original(**_accepted)\n","        except TypeError:\n","            if _is_async:  return await _original()\n","            else:          return _original()\n","    return _caller\n","\n","try:\n","    obtener_precio_actual  # type: ignore[name-defined]\n","    obtener_precio_actual = _wrap_obtener_precio_actual(obtener_precio_actual)  # type: ignore[assignment]\n","except NameError:\n","    async def obtener_precio_actual(*_args, **_kwargs) -> float:\n","        api = _kwargs.get(\"api\")\n","        if api is None and _args:\n","            if hasattr(_args[0], \"query_public\"): api = _args[0]\n","            elif hasattr(_args[0], \"api\"):        api = getattr(_args[0], \"api\", None)\n","        if not api: return 0.0\n","        try:\n","            if hasattr(api, \"obtener_precio_real_actual\"):\n","                p = await _maybe_call_and_await(api.obtener_precio_real_actual)\n","                return float(p)\n","        except Exception: pass\n","        try:\n","            if hasattr(api, \"get_price\"):\n","                return float(await _maybe_call_and_await(api.get_price, \"XXBTZUSD\"))\n","        except Exception: pass\n","        try:\n","            resp = await _maybe_call_and_await(api.query_public, \"Ticker\", {\"pair\": \"XXBTZUSD\"})\n","            k = next(iter(resp[\"result\"])); return float(resp[\"result\"][k][\"c\"][0])\n","        except Exception: pass\n","        return 0.0\n","\n","# --------------------------------- Filosofía (consolidada y sincronizada) ---------------------------------\n","from typing import Any\n","\n","class FilosofiaTradingConfigurator:\n","    \"\"\"\n","    Configurador filosófico sincronizado con el bloque de Sentimiento Robusto.\n","    - Garantiza predictor (empirismo) y modelo (conexionismo) si faltan.\n","    - Integra análisis de sentimiento usando habilitar_analisis_sentimiento().\n","    - Evita avisos legacy y es idempotente.\n","    Requiere que existan: resolver_predictor, resolver_modelo,\n","    habilitar_analisis_sentimiento, estado_analisis_sentimiento.\n","    \"\"\"\n","    def __init__(self, bot_core: Any):\n","        self.bot = bot_core\n","        # Lista de reglas\n","        if not hasattr(self.bot, 'rules') or not isinstance(getattr(self.bot, 'rules'), list):\n","            self.bot.rules = []\n","        # Flags visibles (idempotentes)\n","        self.bot.etica_activa = getattr(self.bot, 'etica_activa', False)\n","        self.bot.feedback_loop_activa = getattr(self.bot, 'feedback_loop_activa', False)\n","        self.bot.informacion_priorizada = getattr(self.bot, 'informacion_priorizada', False)\n","        self.bot.multidecision_activa = getattr(self.bot, 'multidecision_activa', False)\n","\n","    # ---------- Soporte interno ----------\n","    def _asegurar_predictor_con_modelo(self):\n","        \"\"\"\n","        Garantiza predictor (empirismo) y modelo (conexionismo) en el bot.\n","        Usa resolver_predictor / resolver_modelo definidos en tu código.\n","        \"\"\"\n","        predictor = getattr(self.bot, 'predictor_alcista', None) \\\n","                    or getattr(self.bot, 'predictor', None) \\\n","                    or getattr(getattr(self.bot, 'market_monitor', None), 'predictor', None)\n","\n","        if predictor is None:\n","            predictor = resolver_predictor(\"empirismo\")  # <- definido en tu bloque anterior\n","            setattr(self.bot, 'predictor', predictor)\n","            setattr(self.bot, 'predictor_alcista', predictor)\n","            if not hasattr(self.bot, 'predictor_bajista'):\n","                setattr(self.bot, 'predictor_bajista', predictor)\n","\n","        if not hasattr(predictor, 'model') or predictor.model is None:\n","            predictor.model = resolver_modelo(\"conexionismo\")  # <- definido en tu bloque anterior\n","            try:\n","                predictor.model_loaded = True\n","            except Exception:\n","                pass\n","\n","        # Flags globales útiles para chequeos externos\n","        setattr(self.bot, \"empirismo_activo\", True)\n","        setattr(self.bot, \"conexionismo_activo\", True)\n","\n","        return predictor\n","\n","    # ---------- Corrientes / escuelas ----------\n","    def aplicar_racionalismo(self):\n","        reglas_logicas = [\n","            lambda data: data.get('tendencia') == 'alcista' and float(data.get('fuerza', 0.0)) > 0.8,\n","            lambda data: float(data.get('volatilidad', 1.0)) < 0.05\n","        ]\n","        self.bot.rules.extend(reglas_logicas)\n","        print(\"✅ Racionalismo aplicado: reglas lógicas integradas\")\n","\n","    def aplicar_empirismo(self):\n","        predictor = self._asegurar_predictor_con_modelo()\n","        if getattr(predictor, 'model_loaded', False):\n","            print(\"✅ Empirismo activo: predictor empírico con modelo cargado\")\n","        elif hasattr(predictor, 'model'):\n","            print(\"✅ Empirismo activo: predictor empírico inicializado (modelo presente)\")\n","        else:\n","            print(\"✅ Empirismo activo: predictor empírico inicializado\")\n","\n","    def aplicar_conexionismo(self):\n","        predictor = self._asegurar_predictor_con_modelo()\n","        if predictor and getattr(predictor, 'model', None) is not None:\n","            print(\"✅ Conexionismo activo: modelo conexionista operativo\")\n","        else:\n","            predictor.model = resolver_modelo(\"conexionismo\")\n","            print(\"✅ Conexionismo activo: modelo conexionista inyectado\")\n","\n","    def aplicar_funcionalismo(self):\n","        print(\"✅ Funcionalismo activo: arquitectura modular habilitada\")\n","\n","    def aplicar_filosofia_lenguaje(self):\n","        # Usa la capa robusta ya incluida (transformers o VADER o stub)\n","        try:\n","            analyzer = habilitar_analisis_sentimiento(verbose=False)\n","            self.bot.sentiment_analyzer = analyzer\n","            backend = estado_analisis_sentimiento().get(\"backend\")\n","            print(f\"✅ Análisis de sentimiento habilitado correctamente (backend: {backend})\")\n","        except Exception as e:\n","            print(f\"⚠️ No se pudo activar el análisis de sentimiento robusto: {e}\")\n","\n","    def aplicar_etica(self):\n","        self.bot.etica_activa = True\n","        print(\"✅ Ética activa: habilitada auditoría y transparencia de decisiones\")\n","\n","    def aplicar_cibernetica(self):\n","        self.bot.feedback_loop_activa = True\n","        print(\"✅ Cibernética activa: retroalimentación automática configurada\")\n","\n","    def aplicar_teoria_informacion(self):\n","        self.bot.informacion_priorizada = True\n","        print(\"✅ Teoría de la información activa: filtrado y priorización de datos optimizada\")\n","\n","    def aplicar_teoria_decision(self):\n","        self.bot.multidecision_activa = True\n","        print(\"✅ Teoría de la decisión activa: análisis de escenarios múltiples habilitado\")\n","\n","    # ---------- Orquestador ----------\n","    def configurar_todo(self):\n","        print(\"\\n=== Configurando sistema según teorías filosóficas ===\")\n","        self.aplicar_racionalismo()\n","        self.aplicar_empirismo()       # sin avisos legacy\n","        self.aplicar_conexionismo()    # sin avisos legacy\n","        self.aplicar_funcionalismo()\n","        self.aplicar_filosofia_lenguaje()\n","        self.aplicar_etica()\n","        self.aplicar_cibernetica()\n","        self.aplicar_teoria_informacion()\n","        self.aplicar_teoria_decision()\n","        print(\"\\n✅ Configuración filosófica completa\")\n","# --------------------------------- /Filosofía ---------------------------------\n","\n","# =========================================================================================\n","# ================== PARCHE PERMANENTE: CERO-NUNCA (precio y señales) =====================\n","# =========================================================================================\n","# Qué hace:\n","# 1) Fortalece obtener_precio_actual: intenta Kraken/api, luego agregador ComparadorDatosBTC,\n","#    luego caché local; si todo falla, mantiene el último precio válido global.\n","# 2) Wrapper predictor seguro: si los predictores devuelven None/NaN/0.0, genera señal\n","#    heurística basada en momentum (EWMA vs precio) para evitar 0 crónico.\n","# 3) Loop comparador endurecido: si px <= 0, usa fallback seguro; si sigue sin px, salta\n","#    iteración sin imprimir 0.0000.\n","# 4) Todo es idempotente: si ya tenías implementaciones reales, no se sobrescriben.\n","\n","# --------------------------- Estado global mínimo (idempotente) ---------------------------\n","try:\n","    _ULTIMO_PRECIO_VALIDO  # ya existe\n","except NameError:\n","    _ULTIMO_PRECIO_VALIDO: float = 0.0\n","\n","def _is_num(x) -> bool:\n","    try:\n","        xx = float(x)\n","        return math.isfinite(xx)\n","    except Exception:\n","        return False\n","\n","def _nonzero_or(prev: float, alt: float) -> float:\n","    try:\n","        a = float(alt)\n","        return a if (a > 0 and math.isfinite(a)) else float(prev or 0.0)\n","    except Exception:\n","        return float(prev or 0.0)\n","\n","# ------------------------ Fortalecer obtener_precio_actual (async) ------------------------\n","# Nota: Respetamos/integrarnos con tu shim ya creado; solo ampliamos fallbacks.\n","import inspect as _inspect\n","\n","async def _fetch_precio_via_api(api) -> float:\n","    # Kraken estilo query_public\n","    try:\n","        if hasattr(api, \"query_public\"):\n","            resp = await _maybe_call_and_await(api.query_public, \"Ticker\", {\"pair\": \"XXBTZUSD\"})\n","            k = next(iter(resp[\"result\"]))\n","            return float(resp[\"result\"][k][\"c\"][0])\n","    except Exception:\n","        pass\n","    # Método get_price si existe\n","    try:\n","        if hasattr(api, \"get_price\"):\n","            return float(await _maybe_call_and_await(api.get_price, \"XXBTZUSD\"))\n","    except Exception:\n","        pass\n","    return 0.0\n","\n","async def _fetch_precio_seguro_sin_api() -> float:\n","    # Usar tu ComparadorDatosBTC agregador (sin api)\n","    try:\n","        comp = globals().get(\"_COMPARADOR_GLOBAL\", None)\n","        if comp is None:\n","            comp = ComparadorDatosBTC(api=None)\n","            globals()[\"_COMPARADOR_GLOBAL\"] = comp\n","        px = comp.obtener_precio_seguro()\n","        return float(px) if _is_num(px) and float(px) > 0 else 0.0\n","    except Exception:\n","        return 0.0\n","\n","# Si YA existía obtener_precio_actual, lo envolvemos; si no, definimos uno robusto.\n","def _wrap_obtener_precio_actual_hard(_original=None):\n","    async def _robusto(*args, **kwargs) -> float:\n","        global _ULTIMO_PRECIO_VALIDO\n","        api = kwargs.get(\"api\")\n","        if api is None and args:\n","            # permitir pasar api como primer arg suelto\n","            a0 = args[0]\n","            api = a0 if (hasattr(a0, \"query_public\") or hasattr(a0, \"get_price\")) else getattr(a0, \"api\", None)\n","\n","        # 1) Intentar función original, pero SOLO con kwargs válidos\n","        if callable(_original):\n","            try:\n","                sig = _inspect.signature(_original)\n","                accepted = {k: v for k, v in kwargs.items() if k in sig.parameters}\n","                val = await _maybe_call_and_await(_original, **accepted)\n","                if _is_num(val) and float(val) > 0:\n","                    _ULTIMO_PRECIO_VALIDO = float(val); return float(val)\n","            except Exception:\n","                pass\n","\n","        # 2) Intentar API directa (Kraken/get_price)\n","        try:\n","            val = await _fetch_precio_via_api(api) if api else 0.0\n","            if _is_num(val) and float(val) > 0:\n","                _ULTIMO_PRECIO_VALIDO = float(val); return float(val)\n","        except Exception:\n","            pass\n","\n","        # 3) Agregador externo (CoinGecko/CMC/Binance/etc.)\n","        try:\n","            val = await _fetch_precio_seguro_sin_api()\n","            if _is_num(val) and float(val) > 0:\n","                _ULTIMO_PRECIO_VALIDO = float(val); return float(val)\n","        except Exception:\n","            pass\n","\n","        # 4) Último válido en memoria (no imprimir 0)\n","        if _ULTIMO_PRECIO_VALIDO > 0:\n","            return float(_ULTIMO_PRECIO_VALIDO)\n","\n","        # 5) Si no hay nada, retornar 0.0 (pero el loop saltará la iteración)\n","        return 0.0\n","    return _robusto\n","\n","try:\n","    _original_obtener_precio_actual = obtener_precio_actual  # type: ignore[name-defined]\n","    obtener_precio_actual = _wrap_obtener_precio_actual_hard(_original_obtener_precio_actual)\n","except NameError:\n","    obtener_precio_actual = _wrap_obtener_precio_actual_hard(None)\n","\n","# ---------------------- Heurística de señal si el predictor falla -------------------------\n","# Cuando un predictor devuelve 0 / None / NaN o lanza excepción, usamos momentum EWMA vs precio.\n","def _heuristica_senal_pct(px_actual: float, serie: List[float]) -> float:\n","    try:\n","        if not _is_num(px_actual) or px_actual <= 0:\n","            return 0.0\n","        if not serie or len(serie) < 8:\n","            # con serie corta, usar micro-variación pseudoaleatoria limitada (±0.15%)\n","            base = 0.0015 * (1 if random.random() > 0.5 else -1)\n","            return round(base * 100, 4)\n","        # EWMA rápida vs lenta\n","        def _ewma(seq, span):\n","            a = 2.0 / (span + 1.0)\n","            m = float(seq[0])\n","            for v in seq[1:]:\n","                m = a * float(v) + (1 - a) * m\n","            return m\n","        s = serie[-120:] if len(serie) > 120 else serie[:]\n","        ema_fast = _ewma(s, span=12)\n","        ema_slow = _ewma(s, span=36)\n","        slope = (ema_fast - ema_slow) / max(ema_slow, 1e-9)\n","        # Convertir slope en % esperado de corto plazo, acotar ±3%\n","        pct = max(-0.03, min(0.03, slope * 0.85)) * 100.0\n","        return round(pct, 4)\n","    except Exception:\n","        return 0.0\n","\n","async def _call_predictor_seguro(predictor, precio_actual: float, serie_ref: List[float]) -> float:\n","    # Intentar varias firmas; si todas fallan, usar heurística\n","    cand = [\n","        (\"predecir_ajustada\", (precio_actual,)),\n","        (\"predecir\",          (precio_actual,)),\n","        (\"predecir_ajustada\", (serie_ref, precio_actual)),\n","        (\"predecir\",          (serie_ref, precio_actual)),\n","        (\"predecir_ajustada\", (serie_ref,)),\n","        (\"predecir\",          (serie_ref,)),\n","        (\"predecir_precio_futuro\", ()),\n","    ]\n","    for nombre, args in cand:\n","        try:\n","            if hasattr(predictor, nombre):\n","                fn = getattr(predictor, nombre)\n","                res = await _maybe_call_and_await(fn, *args)\n","                try:\n","                    val = float(res)\n","                    if _is_num(val):\n","                        return val\n","                except Exception:\n","                    if isinstance(res, dict):\n","                        for k in (\"cambio_pct\", \"delta\", \"prediccion\", \"valor\"):\n","                            if k in res and _is_num(res[k]):\n","                                return float(res[k])\n","        except Exception:\n","            continue\n","    # Fallback heurístico\n","    try:\n","        ttdvi = globals().get(\"ttdvi\", None)\n","        serie = list(getattr(ttdvi, \"_ticks\", [])) if (ttdvi and getattr(ttdvi, \"_ticks\", None)) else serie_ref\n","    except Exception:\n","        serie = serie_ref\n","    return _heuristica_senal_pct(precio_actual, serie)\n","\n","# --------------- Loop comparador endurecido (única definición, sin imprimir 0.0000) -------\n","async def run_signal_comparator_loop(comparator: \"SignalComparator\", trading_core: Any, obtener_precio_actual_async):\n","    interval_s = int(os.getenv(\"SIGNAL_COMPARATOR_INTERVAL_S\", \"60\"))\n","    global _ULTIMO_PRECIO_VALIDO\n","    while True:\n","        try:\n","            # 1) Precio robusto\n","            px = await obtener_precio_actual_async()\n","            if not _is_num(px) or float(px) <= 0:\n","                px = await _fetch_precio_seguro_sin_api()\n","            if not _is_num(px) or float(px) <= 0:\n","                print(\"⚠️ Comparador: sin precio válido en esta pasada. Saltando para evitar 0.0000.\")\n","                await asyncio.sleep(interval_s)\n","                continue\n","            px = float(px); _ULTIMO_PRECIO_VALIDO = px\n","\n","            # 2) Predicciones seguras (nunca 0 crónico)\n","            hist_alcista = list(getattr(trading_core.predictor_alcista, \"history\", []))\n","            hist_bajista = list(getattr(trading_core.predictor_bajista,  \"history\", []))\n","            pa = await _call_predictor_seguro(trading_core.predictor_alcista, px, hist_alcista)\n","            pb = await _call_predictor_seguro(trading_core.predictor_bajista,  px, hist_bajista)\n","\n","            # 3) Señal neta\n","            pred_neta = float(pa) - float(pb)\n","\n","            # 4) Impresión limpia\n","            print(\"📟 Señales base | \"\n","                  f\"px={px:.2f} | alcista={float(pa):.4f} bajista={float(pb):.4f} | neta={pred_neta:.4f}\")\n","\n","            comparator.imprimir_resumen(pred_neta)\n","        except Exception as e:\n","            print(f\"⚠️ Loop comparador (seguro): {e}\")\n","        await asyncio.sleep(interval_s)\n","# =========================================================================================\n","# ============================ /FIN PARCHE CERO-NUNCA =====================================\n","# =========================================================================================\n","\n","\n","# ------------------------------- Núcleo Darwin v4 --------------------------------\n","class TTDVI156DarwinV4:\n","    def __init__(self, api, pair_alias: str = \"XXBTZUSD\", window=360, hz=1.0,\n","                 inteligencia_v3: Any = None, pair_rest: str = \"XBTUSD\"):\n","        self.api = api\n","        self.pair_alias = pair_alias\n","        self.pair_rest  = pair_rest\n","        self.window = int(window)\n","        self.hz = float(hz)\n","        self._ticks = deque(maxlen=self.window)\n","        self._last_ultra = None\n","        self._last_projection = None\n","        self._ok_sources = {\"ticker\": False, \"ohlc\": False, \"orderflow\": False, \"onchain\": False, \"macro\": False}\n","        self._intel = inteligencia_v3\n","        self._last_v3_prob_up: Optional[float] = None\n","        self._last_v3_fused: Optional[str] = None\n","        self._last_v3_trend: str = \"NEUTRAL\"\n","\n","    async def _get_price_fast(self) -> float:\n","        try:\n","            if hasattr(self.api, \"get_price\"):\n","                p = await self.api.get_price(self.pair_alias)\n","                if p and p > 0:\n","                    self._ok_sources[\"ticker\"] = True\n","                    return float(p)\n","        except Exception:\n","            pass\n","        try:\n","            if hasattr(self.api, \"query_public\"):\n","                resp = await self.api.query_public(\"Ticker\", {\"pair\": self.pair_alias})\n","                k = next(iter(resp[\"result\"])); p = float(resp[\"result\"][k][\"c\"][0])\n","                self._ok_sources[\"ticker\"] = True\n","                return p\n","        except Exception:\n","            self._ok_sources[\"ticker\"] = False\n","            return 0.0\n","\n","    async def _get_last_ohlc_close(self, interval_min: int = 1) -> Optional[float]:\n","        try:\n","            if \"obtener_ohlc_valido\" in globals():\n","                datos = await obtener_ohlc_valido(self.api, pair=self.pair_rest, interval=interval_min, min_candles=10)\n","                velas = datos.get(\"candles\", [])\n","                if velas:\n","                    self._ok_sources[\"ohlc\"] = True\n","                    return float(velas[-1][4])\n","        except Exception:\n","            pass\n","        try:\n","            if hasattr(self.api, \"get_ohlc\"):\n","                ohlc = await self.api.get_ohlc(self.pair_alias, interval_min, count=3)\n","                if isinstance(ohlc, list) and ohlc:\n","                    self._ok_sources[\"ohlc\"] = True\n","                    return float(ohlc[-1][4])\n","        except Exception:\n","            pass\n","        self._ok_sources[\"ohlc\"] = False\n","        return None\n","\n","    def _ewma(self, values, span=21):\n","        if not values: return 0.0\n","        alpha = 2/(span+1); m = values[0]\n","        for v in values[1:]: m = alpha*v + (1-alpha)*m\n","        return m\n","\n","    def _realized_vol(self, values) -> float:\n","        if len(values) < 10: return 0.0\n","        rets = []\n","        for i in range(1, len(values)):\n","            if values[i-1] > 0:\n","                rets.append(math.log(values[i]/values[i-1]))\n","        if not rets: return 0.0\n","        return statistics.pstdev(rets) * math.sqrt(60)\n","\n","    def _spike_neuron(self, x: float, thr: float = 0.0, slope: float = 11.0) -> float:\n","        return 1.0 / (1.0 + math.exp(-slope*(x - thr)))\n","\n","    def _pull_v3_snapshot(self) -> None:\n","        intel = self._intel\n","        if not intel or not getattr(intel, \"last_signal\", None): return\n","        sig = intel.last_signal or {}\n","        self._last_v3_prob_up = float(sig.get(\"ml_prob_up\", 0.5))\n","        fused = str(sig.get(\"ml_override\") or sig.get(\"action\") or \"NEUTRAL\").upper()\n","        self._last_v3_fused = \"BUY_SIGNAL\" if fused == \"BUY_SIGNAL\" else (\"SELL_SIGNAL\" if fused == \"SELL_SIGNAL\" else \"NEUTRAL\")\n","        self._last_v3_trend = str(sig.get(\"trend_state\") or getattr(getattr(intel, \"trend\", None), \"state\", \"NEUTRAL\") or \"NEUTRAL\").upper()\n","\n","    def _v3_directional_boost(self) -> float:\n","        base = 0.0\n","        if self._last_v3_fused == \"BUY_SIGNAL\": base = +0.12\n","        elif self._last_v3_fused == \"SELL_SIGNAL\": base = -0.12\n","        prob = self._last_v3_prob_up if self._last_v3_prob_up is not None else 0.5\n","        amp = (prob - 0.5) * 0.4  # ±0.2\n","        return base + amp\n","\n","    async def update_tick(self) -> float:\n","        px = await self._get_price_fast()\n","        if px > 0: self._ticks.append(px)\n","        series = list(self._ticks)\n","        px_now = series[-1] if series else px\n","        ma_fast = self._ewma(series[-90:], span=24) if len(series) >= 2 else px_now\n","        vol_r   = self._realized_vol(series)\n","        drift   = (px_now - ma_fast) / (ma_fast or 1.0)\n","        s_micro = self._spike_neuron(drift, thr=0.0) * 2 - 1\n","        s_vol   = 1.0 - min(vol_r, 0.02)/0.02\n","        conf    = max(0.15, min(0.95, s_vol))\n","        self._pull_v3_snapshot()\n","        v3_boost = self._v3_directional_boost()\n","        raw = (0.72*s_micro + 0.28*max(-1.0, min(1.0, v3_boost)))\n","        ultra_signal_pct = float(max(-0.8, min(0.8, raw))) * conf * 0.40\n","        self._last_ultra = ultra_signal_pct\n","        return ultra_signal_pct\n","\n","    async def predict_next_hour_pct(self) -> float:\n","        close = await self._get_last_ohlc_close(interval_min=1)\n","        series = list(self._ticks)\n","        if (close is None) and series: close = float(series[-1])\n","        if close is None or len(series) < 30:\n","            s = self._last_ultra if self._last_ultra is not None else 0.0\n","            self._last_projection = float(max(-0.03, min(0.03, s * 1.7)))\n","            return self._last_projection\n","        long_ma  = self._ewma(series[-720:] if len(series) >= 720 else series, span=180)\n","        short_ma = self._ewma(series[-180:] if len(series) >= 180 else series, span=45)\n","        vol_r    = self._realized_vol(series[-720:] if len(series) >= 720 else series)\n","        slope = (short_ma - long_ma) / (long_ma or 1.0)\n","        base  = max(-0.016, min(0.016, slope))\n","        freq  = self._last_ultra if self._last_ultra is not None else 0.0\n","        trend = self._last_v3_trend\n","        trend_k = 1.18 if trend == \"BULL\" else (0.82 if trend == \"BEAR\" else 1.0)\n","        risk = max(0.4, min(1.0, 1.0 - min(vol_r, 0.05)/0.05))\n","        proj = (0.58*base + 0.42*freq) * trend_k * (0.78 + 0.22*risk)\n","        proj = float(max(-0.04, min(0.04, proj)))\n","        self._last_projection = proj\n","        return proj\n","\n","class UltraSignalRouterV4:\n","    def __init__(self, ultra_executor, ttdvi: TTDVI156DarwinV4):\n","        self.ultra = ultra_executor\n","        self.ttdvi = ttdvi\n","    async def get_ultra_signal_pct(self, current_price: float) -> Optional[float]:\n","        try:\n","            if hasattr(self.ultra, \"unified_prediction_signal\"):\n","                s = await self.ultra.unified_prediction_signal(float(current_price))\n","                if s is not None:\n","                    return float(s)\n","        except Exception:\n","            pass\n","        try:\n","            return await self.ttdvi.update_tick()\n","        except Exception:\n","            return None\n","    async def get_next_hour_projection_pct(self) -> float:\n","        try:\n","            return await self.ttdvi.predict_next_hour_pct()\n","        except Exception:\n","            return 0.0\n","\n","async def __TTDVI_UNIFY_HOOK_V4__(api, ultra_executor, cfg: Callable[[str, Any], Any],\n","                                  pair_alias: str = \"XXBTZUSD\", inteligencia: Any = None,\n","                                  pair_rest: Optional[str] = None) -> None:\n","    try:\n","        if not pair_rest:\n","            pair_rest = \"XBTUSD\" if \"XBT\" in pair_alias else pair_alias.replace(\"ZUSD\",\"USD\").replace(\"ZEUR\",\"EUR\")\n","        ttdvi = TTDVI156DarwinV4(api=api, pair_alias=pair_alias, window=360, hz=1.0,\n","                                 inteligencia_v3=inteligencia, pair_rest=pair_rest)\n","        ultra_router = UltraSignalRouterV4(ultra_executor, ttdvi)\n","        globals()['ttdvi'] = ttdvi\n","        globals()['ultra_router'] = ultra_router\n","\n","        predictor_ref = getattr(ultra_executor, \"predictor\", None)\n","\n","        _orig_unified = getattr(ultra_executor, \"unified_prediction_signal\", None)\n","        async def _unified_with_fallback(current_price: float):\n","            if callable(_orig_unified):\n","                try:\n","                    s = await _orig_unified(float(current_price))\n","                    if s is not None: return s\n","                except Exception:\n","                    pass\n","            try:\n","                return await ttdvi.update_tick()\n","            except Exception:\n","                return None\n","        setattr(ultra_executor, \"unified_prediction_signal\", _unified_with_fallback)\n","\n","        if 'print_results_panel' in globals() and callable(globals()['print_results_panel']):\n","            _orig_panel = globals()['print_results_panel']\n","            def _panel_wrapper(*args, **kwargs):\n","                try:\n","                    extra = kwargs.get(\"extra\", {})\n","                    if not isinstance(extra, dict): extra = {}\n","                    proj = getattr(ttdvi, \"_last_projection\", None)\n","                    if proj is not None: extra[\"proj_1h_pct\"] = round(float(proj)*100, 3)\n","                    if predictor_ref is not None:\n","                        eta = getattr(predictor_ref, \"hora_fin_tendencia_actual\", None)\n","                        if isinstance(eta, str) and eta: extra[\"trend_eta_ny\"] = eta\n","                    kwargs[\"extra\"] = extra\n","                except Exception:\n","                    pass\n","                return _orig_panel(*args, **kwargs)\n","            globals()['print_results_panel'] = _panel_wrapper\n","\n","        async def _feeder():\n","            await asyncio.sleep(0.6)\n","            while True:\n","                try:\n","                    await ttdvi.update_tick()\n","                    _ = await ttdvi.predict_next_hour_pct()\n","                except Exception:\n","                    await asyncio.sleep(0.8)\n","                await asyncio.sleep(1.0)\n","        try:\n","            asyncio.create_task(_feeder(), name=\"ttdvi_v4_feeder\")\n","        except Exception:\n","            pass\n","\n","        print(\"✅ TTDVI156 Darwin v4 unificado con INTEL v3, Guard y Comparador. Operativo.\")\n","    except Exception as e:\n","        print(f\"⚠️ __TTDVI_UNIFY_HOOK_V4__ no pudo inicializarse: {e}\")\n","\n","# --------------------------------- Guardia -----------------------------------\n","class PositionGuard:\n","    def __init__(self, order_executor=None, state_path: Optional[str] = None):\n","        self.order_executor = order_executor\n","        self.state_path = state_path\n","        self.state = {\"open\": False, \"side\": None, \"entry\": None, \"tp\": None, \"sl\": None}\n","        if self.state_path and os.path.exists(self.state_path):\n","            try:\n","                with open(self.state_path, \"r\", encoding=\"utf-8\") as f:\n","                    self.state = json.load(f)\n","            except Exception:\n","                pass\n","\n","    def _persist(self):\n","        if not self.state_path: return\n","        try:\n","            os.makedirs(os.path.dirname(self.state_path) or \".\", exist_ok=True)\n","            with open(self.state_path, \"w\", encoding=\"utf-8\") as f:\n","                json.dump(self.state, f, ensure_ascii=False, indent=2)\n","        except Exception:\n","            pass\n","\n","    async def _backend_has_open_long(self) -> Optional[dict]:\n","        if not self.order_executor: return None\n","        for nombre in [\"get_open_position\", \"get_position\", \"estado_posicion\", \"position_status\"]:\n","            fn = getattr(self.order_executor, nombre, None)\n","            if callable(fn):\n","                try:\n","                    pos = await (fn() if asyncio.iscoroutinefunction(fn) else fn())\n","                    if isinstance(pos, dict) and pos.get(\"side\") in (\"buy\", \"long\"):\n","                        return pos\n","                except Exception:\n","                    pass\n","        return None\n","\n","    async def refresh_from_backend(self):\n","        pos = await self._backend_has_open_long()\n","        if pos:\n","            entry = float(pos.get(\"entry\") or pos.get(\"avg_entry\") or 0.0)\n","            if entry > 0:\n","                take_profit = getattr(globals().get(\"OBJ\", object()), \"take_profit\", 0.01)\n","                stop_loss = getattr(globals().get(\"OBJ\", object()), \"stop_loss\", 0.01)\n","                self.state.update({\n","                    \"open\": True, \"side\": \"buy\",\n","                    \"entry\": entry, \"tp\": entry * (1.0 + take_profit),\n","                    \"sl\": entry * (1.0 - stop_loss),\n","                })\n","                self._persist(); return\n","        if self.state.get(\"open\"):\n","            self.state = {\"open\": False, \"side\": None, \"entry\": None, \"tp\": None, \"sl\": None}\n","            self._persist()\n","\n","    def _update_outcome(self, last_price: float):\n","        if not self.state.get(\"open\"): return\n","        entry = float(self.state[\"entry\"]); tp = float(self.state[\"tp\"]); sl = float(self.state[\"sl\"])\n","        if last_price >= tp or last_price <= sl:\n","            self.state = {\"open\": False, \"side\": None, \"entry\": None, \"tp\": None, \"sl\": None}\n","            self._persist()\n","\n","    async def can_open_new_buy(self, last_price: float, predicted_change_pct: float) -> bool:\n","        await self.refresh_from_backend()\n","        self._update_outcome(last_price)\n","        if self.state.get(\"open\"):\n","            print(\"🛑 Guardia: ya hay una compra abierta sin cumplir objetivo.\"); return False\n","        min_pred_buy = getattr(globals().get(\"OBJ\", object()), \"min_pred_buy\", 0.0)\n","        if float(predicted_change_pct) < min_pred_buy:\n","            print(f\"🧯 Guardia: predicción ({predicted_change_pct:.2f}%) < umbral ({min_pred_buy:.2f}%).\"); return False\n","        return True\n","\n","    def notify_new_buy(self, entry_price: float):\n","        take_profit = getattr(globals().get(\"OBJ\", object()), \"take_profit\", 0.01)\n","        stop_loss = getattr(globals().get(\"OBJ\", object()), \"stop_loss\", 0.01)\n","        entry = float(entry_price)\n","        self.state.update({\n","            \"open\": True, \"side\": \"buy\", \"entry\": entry,\n","            \"tp\": entry * (1.0 + take_profit),\n","            \"sl\": entry * (1.0 - stop_loss),\n","        })\n","        self._persist()\n","\n","# ---------------------------- Comparadores ------------------------------------\n","class ComparadorTendencias:\n","    def __init__(self, predictor_alcista, predictor_bajista, order_executor=None, api=None,\n","                 guard: PositionGuard = None):\n","        self.predictor_alcista = predictor_alcista\n","        self.predictor_bajista = predictor_bajista\n","        self.order_executor = order_executor\n","        self.api = api or getattr(predictor_alcista, 'api', None)\n","        self.comparador_btc = None\n","        self.guard = guard or PositionGuard(order_executor, state_path=os.getenv(\"TRADE_GUARD_STATE\", \"\"))\n","\n","    async def analizar_y_decidir(self, pred_alcista: float, pred_bajista: float, precio_actual: float) -> str:\n","        try:\n","            if pred_alcista > 4.0 and pred_alcista > abs(pred_bajista) + 2.0: return \"BUY\"\n","            elif pred_bajista < -4.0 and abs(pred_bajista) > pred_alcista + 2.0: return \"SELL\"\n","            else: return \"ESPERAR\"\n","        except Exception as e:\n","            print(f\"❌ Error en analizar_y_decidir(): {e}\"); return \"ESPERAR\"\n","\n","    async def comparar_y_graficar(self):\n","        try:\n","            # Precio actual (tolerante)\n","            precio_actual = await _maybe_call_and_await(obtener_precio_actual, api=self.api)\n","\n","            ahora_ny = datetime.now(tz(\"America/New_York\"))\n","            hora_formateada = ahora_ny.strftime('%Y-%m-%d %H:%M:%S %Z')\n","\n","            hist_alcista = list(getattr(self.predictor_alcista, \"history\", []))\n","            hist_bajista = list(getattr(self.predictor_bajista, \"history\", []))\n","\n","            pred_alcista = await self._call_predecir_ajustada(self.predictor_alcista, hist_alcista, precio_actual)\n","            pred_bajista = await self._call_predecir_ajustada(self.predictor_bajista,  hist_bajista,  precio_actual)\n","\n","            # Gráfico 1: barras comparativas\n","            plt.figure(figsize=(10, 5))\n","            plt.title(f\"📊 Comparativa Estratégica BTC/USD\\n🕒 {hora_formateada} | 💰 Precio: ${precio_actual:.2f}\")\n","            colores = ['green' if pred_alcista > pred_bajista else 'lightgray',\n","                       'red' if pred_bajista > pred_alcista else 'lightgray']\n","            plt.bar(['Alcista', 'Bajista'], [pred_alcista, pred_bajista], color=colores)\n","            plt.axhline(0, color='black', linestyle='--'); plt.ylabel(\"Cambio proyectado (%)\"); plt.grid(True)\n","            carpeta = \"resultados_graficos\"; os.makedirs(carpeta, exist_ok=True)\n","            nombre1 = f\"grafico_comparativo_{ahora_ny.strftime('%Y%m%d_%H%M%S')}.png\"\n","            path1 = os.path.join(carpeta, nombre1); plt.tight_layout(); plt.savefig(path1); plt.close()\n","            print(f\"🖼️ Gráfico comparativo guardado: {path1}\")\n","\n","            # Gráfico 2: línea con proyección 15m (si hay OHLC)\n","            try:\n","                if hasattr(self.api, \"get_ohlc\"): ohlc = await self.api.get_ohlc(\"XBT/USD\", interval=1)\n","                else: ohlc = []\n","                times = [datetime.fromtimestamp(c[0], tz=tz(\"America/New_York\")) for c in ohlc]\n","                prices = [float(c[4]) for c in ohlc]\n","            except Exception as e:\n","                print(f\"⚠️ No se pudo obtener OHLC 1m: {e}\"); times, prices = [], []\n","\n","            try:\n","                fut = await _maybe_call_and_await(getattr(self.predictor_alcista, \"predecir_precio_futuro\", lambda: float(precio_actual)))\n","                pred_futuro = float(fut)\n","            except Exception:\n","                pred_futuro = float(precio_actual)\n","\n","            if times and prices:\n","                plt.figure(figsize=(10, 4))\n","                plt.plot(times, prices, label=\"📉 Velas 1m\")\n","                plt.axhline(y=float(precio_actual), linestyle='--', label=f\"💵 Actual: ${float(precio_actual):.2f}\")\n","                plt.axhline(y=pred_futuro, linestyle=':', label=f\"🎯 Proyección 15min: ${pred_futuro:.2f}\")\n","                plt.title(f\"📉 Proyección Estratégica 15min\\n🕒 {hora_formateada}\")\n","                plt.gcf().autofmt_xdate(); plt.gca().xaxis.set_major_formatter(mdates.DateFormatter('%H:%M'))\n","                plt.grid(True); plt.legend()\n","                nombre2 = f\"proyeccion_15min_{ahora_ny.strftime('%Y%m%d_%H%M%S')}.png\"\n","                path2 = os.path.join(carpeta, nombre2); plt.tight_layout(); plt.savefig(path2); plt.close()\n","                print(f\"🖼️ Segundo gráfico guardado: {path2}\")\n","            else:\n","                print(\"ℹ️ Saltando gráfico de proyección por falta de OHLC.\")\n","\n","            decision = await self.analizar_y_decidir(pred_alcista, pred_bajista, precio_actual)\n","            print(f\"🤖 Decisión base: {decision}\")\n","\n","            if decision == \"BUY\" and self.order_executor:\n","                puede_abrir = await self.guard.can_open_new_buy(precio_actual, pred_alcista)\n","                if puede_abrir:\n","                    print(f\"🚀 Ejecutando compra real (predicción: {pred_alcista:.2f}%)\")\n","                    try:\n","                        exec_fn = getattr(self.order_executor, \"execute_order\", None)\n","                        res = await (exec_fn(direction='buy', predicted_change=pred_alcista)\n","                                     if asyncio.iscoroutinefunction(exec_fn)\n","                                     else _maybe_call_and_await(exec_fn, direction='buy', predicted_change=pred_alcista))\n","                        entry = float(res.get(\"price\", precio_actual)) if isinstance(res, dict) else float(precio_actual)\n","                        self.guard.notify_new_buy(entry)\n","                    except Exception as e:\n","                        print(f\"⚠️ Error ejecutando orden real: {e}\")\n","                else:\n","                    print(\"⏸️ Compra cancelada por guardia.\")\n","            else:\n","                print(\"⏸️ No se ejecuta compra automática.\")\n","\n","        except Exception as e:\n","            print(f\"⚠️ Error en comparar_y_graficar(): {e}\")\n","\n","    async def _call_predecir_ajustada(self, predictor, historial, precio_actual):\n","        \"\"\"\n","        Firma tolerante:\n","          - predecir_ajustada(hist, precio) / predecir(hist, precio)\n","          - predecir_ajustada(hist) / predecir(hist)\n","          - predecir_ajustada(precio) / predecir(precio)\n","          - predecir_precio_futuro()\n","        \"\"\"\n","        cand = [\n","            (\"predecir_ajustada\", (historial, precio_actual)),\n","            (\"predecir\",          (historial, precio_actual)),\n","            (\"predecir_ajustada\", (historial,)),\n","            (\"predecir\",          (historial,)),\n","            (\"predecir_ajustada\", (precio_actual,)),\n","            (\"predecir\",          (precio_actual,)),\n","            (\"predecir_precio_futuro\", ()),\n","        ]\n","        for nombre, args in cand:\n","            try:\n","                if hasattr(predictor, nombre):\n","                    fn = getattr(predictor, nombre)\n","                    res = await _maybe_call_and_await(fn, *args)\n","                    try:    return float(res)\n","                    except Exception:\n","                        if isinstance(res, dict):\n","                            for k in (\"cambio_pct\",\"delta\",\"prediccion\",\"valor\"):\n","                                if k in res: return float(res[k])\n","            except Exception:\n","                continue\n","        return 0.0\n","\n","    async def comparar_y_ajustar_prediccion(self, precio_actual: float, prediccion_original: float) -> float:\n","        try:\n","            if not self.comparador_btc:\n","                self.comparador_btc = ComparadorDatosBTC(self.api)\n","                print(\"🔄 Comparador BTC asignado dinámicamente\")\n","            return await self.comparador_btc.comparar_y_ajustar_prediccion(precio_actual, prediccion_original)\n","        except Exception as e:\n","            print(f\"❌ Error en comparar_y_ajustar_prediccion(): {e}\")\n","            return prediccion_original\n","\n","class SignalComparator:\n","    def __init__(self):\n","        self.last_prediction: Optional[float] = None\n","        self.buy_signals = deque(maxlen=5)\n","        self.sell_signals = deque(maxlen=5)\n","\n","    def analyze_signal_strength(self, prediction: float) -> dict:\n","        abs_pred = abs(float(prediction))\n","        level = \"extrema\" if abs_pred > 100 else (\"fuerte\" if abs_pred > 50 else (\"moderada\" if abs_pred > 10 else \"débil\"))\n","        tipo = 'buy' if prediction > 0 else 'sell'\n","        return {'tipo': tipo, 'nivel': level, 'valor': float(prediction)}\n","\n","    def registrar_senal(self, tipo: str, valor: float):\n","        v = float(valor)\n","        if tipo == 'buy': self.buy_signals.append(v)\n","        elif tipo == 'sell': self.sell_signals.append(v)\n","\n","    def diferencia_promedio(self) -> float:\n","        if len(self.buy_signals) == 0 or len(self.sell_signals) == 0: return 0.0\n","        avg_buy = sum(self.buy_signals) / len(self.buy_signals)\n","        avg_sell = sum(self.sell_signals) / len(self.sell_signals)\n","        return avg_buy - abs(avg_sell)\n","\n","    def es_una_buena_compra(self, prediccion_actual: float) -> bool:\n","        diferencia = self.diferencia_promedio()\n","        pa = float(prediccion_actual)\n","        return diferencia > 5.0 and pa > 4.0\n","\n","    def imprimir_resumen(self, prediccion_actual: float):\n","        info = self.analyze_signal_strength(prediccion_actual)\n","        self.registrar_senal(info['tipo'], info['valor'])\n","        dif = self.diferencia_promedio()\n","        ok = self.es_una_buena_compra(prediccion_actual)\n","        print(\"🧮 Comparador | \"\n","              f\"tipo={info['tipo']} nivel={info['nivel']} valor={info['valor']:.4f} | \"\n","              f\"Δprom={dif:.4f} | ¿Buena compra? {'✅ Sí' if ok else '❌ No'}\")\n","        self.last_prediction = float(prediccion_actual)\n","\n","def wire_filosofia_y_comparador(bot_core: Any) -> tuple[FilosofiaTradingConfigurator, SignalComparator]:\n","    cfg = FilosofiaTradingConfigurator(bot_core); cfg.configurar_todo()\n","    comp = SignalComparator(); setattr(bot_core, \"signal_comparator\", comp)\n","    print(\"✅ Filosofía y SignalComparator conectados al bot_core\")\n","    return cfg, comp\n","\n","# ------------------------ comparador_datos_btc: helpers ------------------------\n","USER_AGENT = os.getenv(\"PRICE_UA\", \"BTC-Intel/3.0 (+https://local) Python-Requests\")\n","DEFAULT_TIMEOUT = int(os.getenv(\"HTTP_TIMEOUT_SECONDS\", \"10\"))\n","COINGECKO_MIN_INTERVAL_S = float(os.getenv(\"COINGECKO_MIN_INTERVAL_S\", \"12.0\"))\n","COINGECKO_TTL_SECONDS = int(os.getenv(\"COINGECKO_TTL_SECONDS\", \"90\"))\n","DEFAULT_RETRY_AFTER_S = float(os.getenv(\"DEFAULT_RETRY_AFTER_S\", \"60\"))\n","API_KEY_MIN_INTERVAL_S = float(os.getenv(\"API_KEY_MIN_INTERVAL_S\", \"12.0\"))\n","API_KEY_COOLDOWN_S     = float(os.getenv(\"API_KEY_COOLDOWN_S\", \"180\"))\n","PROXY_POOL          = [p.strip() for p in os.getenv(\"PROXY_POOL\", \"\").split(\",\") if p.strip()]\n","PROXY_MIN_INTERVAL  = float(os.getenv(\"PROXY_MIN_INTERVAL_S\", \"10\"))\n","PROXY_COOLDOWN_S    = float(os.getenv(\"PROXY_COOLDOWN_S\", \"180\"))\n","PROXY_TEST_URL      = os.getenv(\"PROXY_TEST_URL\", \"https://api.kraken.com/0/public/Time\")\n","PROXY_TEST_TIMEOUT  = float(os.getenv(\"PROXY_TEST_TIMEOUT\", \"4\"))\n","PROXY_MAX_TRIES     = int(os.getenv(\"PROXY_MAX_TRIES\", \"3\"))\n","PROXY_VERIFY_SSL    = os.getenv(\"PROXY_VERIFY_SSL\", \"1\") == \"1\"\n","METRICS_ENABLE   = os.getenv(\"METRICS_ENABLE\", \"1\") == \"1\"\n","PRICE_METRICS_CSV = os.getenv(\"PRICE_METRICS_CSV\", \"price_metrics_log.csv\")\n","ENABLE_BINANCE   = os.getenv(\"ENABLE_BINANCE\", \"1\") == \"1\"\n","ENABLE_YAHOO     = os.getenv(\"ENABLE_YAHOO\", \"1\") == \"1\"\n","ENABLE_BITSTAMP  = os.getenv(\"ENABLE_BITSTAMP\", \"1\") == \"1\"\n","ENABLE_PAPRIKA   = os.getenv(\"ENABLE_PAPRIKA\", \"1\") == \"1\"\n","ENABLE_COINBASE  = os.getenv(\"ENABLE_COINBASE\", \"1\") == \"1\"\n","ENABLE_BITFINEX  = os.getenv(\"ENABLE_BITFINEX\", \"1\") == \"1\"\n","ENABLE_OKX       = os.getenv(\"ENABLE_OKX\", \"1\") == \"1\"\n","ENABLE_CMC       = os.getenv(\"ENABLE_CMC\", \"1\") == \"1\"\n","\n","def _now_utc_iso(): return utc_now_iso()\n","def _now_ts() -> float: return time.time()\n","\n","class _SoftRateLimit(Exception): ...\n","def _mask_tail(s: Optional[str]) -> str:\n","    if not s: return \"\"\n","    s = str(s); tail = s[-4:] if len(s) >= 4 else s\n","    return f\"***{tail}\"\n","\n","class MetricsLogger:\n","    FIELDS = [\"ts_utc\",\"provider\",\"url_host\",\"status\",\"duration_ms\",\"used_key\",\"proxy\",\"outcome\",\"error\"]\n","    def __init__(self, csv_path: str):\n","        self.csv_path = csv_path\n","        try:\n","            if METRICS_ENABLE and not os.path.exists(csv_path):\n","                with open(csv_path, \"w\", encoding=\"utf-8\", newline=\"\") as f:\n","                    f.write(\",\".join(self.FIELDS) + \"\\n\")\n","        except Exception:\n","            pass\n","    def log(self, provider: str, url: str, status: Optional[int], duration_ms: float,\n","            used_key: Optional[str], proxy_label: Optional[str], outcome: str, error: Optional[str] = None):\n","        if not METRICS_ENABLE: return\n","        try:\n","            row = [\n","                _now_utc_iso(),\n","                provider or \"\",\n","                urlparse(url).hostname or \"\",\n","                str(status if status is not None else \"\"),\n","                f\"{duration_ms:.1f}\",\n","                _mask_tail(used_key),\n","                proxy_label or \"\",\n","                outcome,\n","                (error or \"\").replace(\",\", \";\")[:500],\n","            ]\n","            with open(self.csv_path, \"a\", encoding=\"utf-8\", newline=\"\") as f:\n","                f.write(\",\".join(row) + \"\\n\")\n","        except Exception:\n","            pass\n","\n","class ApiKeyRotator:\n","    def __init__(self, provider: str, header_name: str, keys: List[str],\n","                 per_key_min_interval_s: float = API_KEY_MIN_INTERVAL_S,\n","                 default_cooldown_s: float = API_KEY_COOLDOWN_S):\n","        self.provider = provider; self.header_name = header_name\n","        self.keys = [k.strip() for k in keys if k and k.strip()]\n","        self.per_key_min_interval_s = per_key_min_interval_s\n","        self.default_cooldown_s = default_cooldown_s\n","        self._last_used: Dict[str, float] = {}\n","        self._cooldown_until: Dict[str, float] = {}\n","        self._active_key: Optional[str] = None\n","        self._cursor = 0\n","    def has_keys(self) -> bool: return len(self.keys) > 0\n","    def _is_ready(self, key: str) -> bool:\n","        now = _now_ts()\n","        if now < self._cooldown_until.get(key, 0.0): return False\n","        last = self._last_used.get(key, 0.0)\n","        return (now - last) >= self.per_key_min_interval_s\n","    def _pick_key(self) -> Optional[str]:\n","        if not self.has_keys(): return None\n","        n = len(self.keys)\n","        for i in range(n):\n","            k = self.keys[(self._cursor + i) % n]\n","            if self._is_ready(k):\n","                self._cursor = (self._cursor + i + 1) % n\n","                return k\n","        candidates = sorted(self.keys, key=lambda k: self._cooldown_until.get(k, 0.0))\n","        for k in candidates:\n","            if _now_ts() >= self._cooldown_until.get(k, 0.0): return k\n","        return None\n","    def next_headers(self) -> Tuple[Dict[str, str], Optional[str]]:\n","        key = self._pick_key(); self._active_key = key\n","        if key is None: return {}, None\n","        return {self.header_name: key}, key\n","    def record_success(self):\n","        if self._active_key: self._last_used[self._active_key] = _now_ts()\n","    def record_throttle_or_auth(self, retry_after: Optional[float] = None):\n","        if self._active_key:\n","            wait_s = retry_after if (retry_after and retry_after > 0) else self.default_cooldown_s\n","            self._cooldown_until[self._active_key] = _now_ts() + wait_s\n","\n","class ProxyRotator:\n","    def __init__(self, proxies: List[str],\n","                 per_proxy_min_interval_s: float = PROXY_MIN_INTERVAL,\n","                 default_cooldown_s: float = PROXY_COOLDOWN_S):\n","        self.proxies = [p for p in proxies if p]\n","        self.per_proxy_min_interval_s = per_proxy_min_interval_s\n","        self.default_cooldown_s = default_cooldown_s\n","        self._last_used: Dict[str, float] = {}\n","        self._cooldown_until: Dict[str, float] = {}\n","        self._latency_ms: Dict[str, float] = {}\n","        self._cursor = 0\n","        self._session = requests.Session()\n","        self._session.headers.update({\"User-Agent\": USER_AGENT})\n","    def has_proxies(self) -> bool: return len(self.proxies) > 0\n","    def _label(self, proxy_url: str) -> str:\n","        try:\n","            up = urlparse(proxy_url); host = up.hostname or \"\"; port = up.port or \"\"\n","            return f\"{host}:{port}\"\n","        except Exception:\n","            return proxy_url\n","    def _is_ready(self, proxy_url: str) -> bool:\n","        now = _now_ts()\n","        if now < self._cooldown_until.get(proxy_url, 0.0): return False\n","        last = self._last_used.get(proxy_url, 0.0)\n","        return (now - last) >= self.per_proxy_min_interval_s\n","    def _pick(self) -> Optional[str]:\n","        if not self.has_proxies(): return None\n","        n = len(self.proxies)\n","        ordered = sorted(range(n), key=lambda i: self._latency_ms.get(self.proxies[i], float(\"inf\")))\n","        for idx in ordered:\n","            purl = self.proxies[idx]\n","            if self._is_ready(purl): return purl\n","        for i in range(n):\n","            purl = self.proxies[(self._cursor + i) % n]\n","            if _now_ts() >= self._cooldown_until.get(purl, 0.0):\n","                self._cursor = (self._cursor + i + 1) % n; return purl\n","        return None\n","    def _health_check(self, purl: str) -> bool:\n","        try:\n","            t0 = time.perf_counter()\n","            r = self._session.get(os.getenv(\"PROXY_TEST_URL\", \"https://api.kraken.com/0/public/Time\"),\n","                                  timeout=float(os.getenv(\"PROXY_TEST_TIMEOUT\", \"4\")),\n","                                  proxies={\"http\": purl, \"https\": purl},\n","                                  verify=os.getenv(\"PROXY_VERIFY_SSL\", \"1\") == \"1\")\n","            dt_ms = (time.perf_counter() - t0) * 1000.0\n","            if 200 <= r.status_code < 500:\n","                self._latency_ms[purl] = dt_ms; return True\n","        except Exception:\n","            pass\n","        return False\n","    def next_proxies(self) -> Tuple[Optional[Dict[str, str]], Optional[str]]:\n","        purl = self._pick()\n","        if not purl: return None, None\n","        if purl not in self._latency_ms and not self._health_check(purl):\n","            self.record_failure(self._label(purl)); return None, None\n","        self._last_used[purl] = _now_ts(); label = self._label(purl)\n","        return {\"http\": purl, \"https\": purl}, label\n","    def record_success(self, label: Optional[str]): ...\n","    def record_failure(self, label: Optional[str], cooldown_s: Optional[float] = None):\n","        if not label: return\n","        for purl in self.proxies:\n","            if self._label(purl) == label:\n","                self._cooldown_until[purl] = _now_ts() + (cooldown_s or self.default_cooldown_s); break\n","\n","class MetricsAwareSession:\n","    def __init__(self):\n","        self.session = requests.Session()\n","        self.session.headers.update({\n","            \"User-Agent\": USER_AGENT,\n","            \"Accept\": \"application/json, text/plain, */*\",\n","            \"Accept-Language\": \"en-US,en;q=0.9\",\n","            \"Cache-Control\": \"no-cache\",\n","            \"Pragma\": \"no-cache\",\n","        })\n","        self.verify_ssl = os.getenv(\"PROXY_VERIFY_SSL\", \"1\") == \"1\"\n","        self.metrics = MetricsLogger(PRICE_METRICS_CSV)\n","    def get_json(self, url: str, timeout: int, headers: Optional[Dict[str, str]] = None,\n","                 proxies: Optional[Dict[str, str]] = None, provider: str = \"\", used_key: Optional[str] = None) -> Dict[str, Any]:\n","        t0 = time.perf_counter(); r = self.session.get(url, timeout=timeout, headers=(headers or {}), proxies=proxies, verify=self.verify_ssl)\n","        status = r.status_code; r.raise_for_status(); data = r.json()\n","        dt_ms = (time.perf_counter() - t0) * 1000.0\n","        self.metrics.log(provider or (urlparse(url).hostname or \"\"), url, status, dt_ms, used_key, (proxies and 'set') and 'proxy' or None, \"success\", None)\n","        return data\n","\n","# --------------------- Comparador de Datos BTC (agregador) ---------------------\n","class ComparadorDatosBTC:\n","    def __init__(self, api, coinmarketcap_api_key: Optional[str] = None):\n","        self.api = api\n","        self.kraken_precio: Optional[float] = None\n","        self.cache_path = \"coingecko_cache.json\"\n","        self.coinmarketcap_api_key = coinmarketcap_api_key or os.getenv(\"COINMARKETCAP_API_KEY\")\n","        self._sess = MetricsAwareSession()\n","        cg_keys = os.getenv(\"COINGECKO_API_KEYS\", \"\").split(\",\")\n","        cmc_keys = os.getenv(\"CMC_API_KEYS\", \"\").split(\",\")\n","        self._rot_cg  = ApiKeyRotator(\"coingecko\", \"x-cg-pro-api-key\", [k for k in cg_keys if k.strip()])\n","        if self.coinmarketcap_api_key and self.coinmarketcap_api_key.strip():\n","            cmc_keys = [self.coinmarketcap_api_key] + [k for k in cmc_keys if k.strip()]\n","        self._rot_cmc = ApiKeyRotator(\"coinmarketcap\", \"X-CMC_PRO_API_KEY\", [k for k in cmc_keys if k.strip()])\n","        self._rot_proxy = ProxyRotator(PROXY_POOL)\n","\n","    @retry(wait=wait_exponential(multiplier=1, min=0.5, max=8),\n","           stop=stop_after_attempt(3),\n","           retry=retry_if_exception_type(requests.RequestException),\n","           reraise=True)\n","    def _get_json(self, url: str, timeout: int = DEFAULT_TIMEOUT,\n","                  headers: Optional[Dict[str, str]] = None,\n","                  meta_provider: Optional[str] = None,\n","                  meta_used_key: Optional[str] = None) -> Dict[str, Any]:\n","        provider = meta_provider or (urlparse(url).hostname or \"\")\n","        used_key = meta_used_key\n","        tries = 0\n","        while self._rot_proxy.has_proxies() and tries < max(1, PROXY_MAX_TRIES):\n","            tries += 1\n","            proxies, label = self._rot_proxy.next_proxies()\n","            if not proxies: break\n","            try:\n","                return self._sess.get_json(url, timeout, headers, proxies, provider, used_key)\n","            except requests.HTTPError as e:\n","                status = e.response.status_code if e.response is not None else None\n","                self._rot_proxy.record_failure(label, cooldown_s=(DEFAULT_RETRY_AFTER_S if status in (401,403,429,451,503) else None))\n","            except Exception:\n","                self._rot_proxy.record_failure(label)\n","        return self._sess.get_json(url, timeout, headers, None, provider, used_key)\n","\n","    def _guardar_cache(self, precio: float):\n","        try:\n","            with open(self.cache_path, \"w\") as f:\n","                json.dump({\"precio\": float(precio), \"timestamp_utc\": _now_utc_iso()}, f)\n","        except Exception:\n","            pass\n","\n","    def _cargar_cache(self, valid_within: int = COINGECKO_TTL_SECONDS) -> Optional[float]:\n","        try:\n","            if os.path.exists(self.cache_path):\n","                with open(self.cache_path, \"r\") as f:\n","                    data = json.load(f)\n","                ts = data.get(\"timestamp_utc\"); px = data.get(\"precio\")\n","                if px is None: return None\n","                if not ts: return float(px)\n","                try:\n","                    cached_at = datetime.fromisoformat(ts.replace(\"Z\", \"+00:00\")).timestamp()\n","                except Exception:\n","                    return float(px)\n","                if (_now_ts() - cached_at) <= valid_within:\n","                    return float(px)\n","        except Exception:\n","            pass\n","        return None\n","\n","    # ---- fuentes\n","    def obtener_precio_coingecko(self) -> Optional[float]:\n","        key = \"coingecko\"; url = \"https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd\"\n","        try:\n","            extra_headers, used_key = self._rot_cg.next_headers() if self._rot_cg.has_keys() else ({}, None)\n","            data = self._get_json(url, headers=extra_headers, meta_provider=key, meta_used_key=used_key)\n","            px = float(data[\"bitcoin\"][\"usd\"]); self._guardar_cache(px)\n","            if used_key: self._rot_cg.record_success()\n","            print(f\"✅ CoinGecko: {px}{' (Pro)' if used_key else ''}\"); return px\n","        except Exception as e:\n","            print(f\"⚠️ CoinGecko falló: {e}\")\n","            return self._cargar_cache(valid_within=COINGECKO_TTL_SECONDS)\n","\n","    def obtener_precio_coinmarketcap(self) -> Optional[float]:\n","        if not (os.getenv(\"ENABLE_CMC\", \"1\") == \"1\") or (not self._rot_cmc.has_keys()): return None\n","        url = \"https://pro-api.coinmarketcap.com/v2/cryptocurrency/quotes/latest?symbol=BTC&convert=USD\"\n","        try:\n","            extra_headers, used_key = self._rot_cmc.next_headers()\n","            data = self._get_json(url, headers=extra_headers, meta_provider=\"coinmarketcap\", meta_used_key=used_key)\n","            ddata = data.get(\"data\", {})\n","            price = None\n","            if \"BTC\" in ddata:\n","                entry = ddata[\"BTC\"]\n","                if isinstance(entry, list) and entry:\n","                    quote = (entry[0].get(\"quote\") or {}).get(\"USD\") or {}\n","                    price = quote.get(\"price\")\n","                elif isinstance(entry, dict):\n","                    quote = (entry.get(\"quote\") or {}).get(\"USD\") or {}\n","                    price = quote.get(\"price\")\n","            if price is None: raise ValueError(\"Formato inesperado en CMC\")\n","            px = float(price); self._rot_cmc.record_success()\n","            print(f\"✅ CoinMarketCap: {px}\"); return px\n","        except Exception as e:\n","            print(f\"⚠️ CMC falló: {e}\"); return None\n","\n","    def obtener_precio_binance(self) -> Optional[float]:\n","        if not (os.getenv(\"ENABLE_BINANCE\", \"1\") == \"1\"): return None\n","        try:\n","            data = self._get_json(\"https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT\", meta_provider=\"binance\")\n","            px = float(data[\"price\"]); print(f\"✅ Binance: {px}\"); return px\n","        except Exception as e:\n","            print(f\"⚠️ Binance falló: {e}\"); return None\n","\n","    def obtener_precio_yahoo(self) -> Optional[float]:\n","        if not (os.getenv(\"ENABLE_YAHOO\", \"1\") == \"1\"): return None\n","        try:\n","            data = self._get_json(\"https://query1.finance.yahoo.com/v8/finance/chart/BTC-USD\", meta_provider=\"yahoo\")\n","            result = (data.get(\"chart\", {}).get(\"result\") or [None])[0] or {}\n","            meta = result.get(\"meta\", {}); px = float(meta.get(\"regularMarketPrice\"))\n","            print(f\"✅ Yahoo: {px}\"); return px\n","        except Exception as e:\n","            print(f\"⚠️ Yahoo falló: {e}\"); return None\n","\n","    def obtener_precio_bitstamp(self) -> Optional[float]:\n","        if not (os.getenv(\"ENABLE_BITSTAMP\", \"1\") == \"1\"): return None\n","        try:\n","            data = self._get_json(\"https://www.bitstamp.net/api/v2/ticker/btcusd/\", meta_provider=\"bitstamp\")\n","            px = float(data[\"last\"]); print(f\"✅ Bitstamp: {px}\"); return px\n","        except Exception as e:\n","            print(f\"⚠️ Bitstamp falló: {e}\"); return None\n","\n","    def obtener_precio_coinpaprika(self) -> Optional[float]:\n","        if not (os.getenv(\"ENABLE_PAPRIKA\", \"1\") == \"1\"): return None\n","        try:\n","            data = self._get_json(\"https://api.coinpaprika.com/v1/tickers/btc-bitcoin?quotes=USD\", meta_provider=\"coinpaprika\")\n","            px = float(data[\"quotes\"][\"USD\"][\"price\"]); print(f\"✅ CoinPaprika: {px}\"); return px\n","        except Exception as e:\n","            print(f\"⚠️ CoinPaprika falló: {e}\"); return None\n","\n","    def obtener_precio_coinbase(self) -> Optional[float]:\n","        if not (os.getenv(\"ENABLE_COINBASE\", \"1\") == \"1\"): return None\n","        try:\n","            data = self._get_json(\"https://api.coinbase.com/v2/prices/spot?currency=USD\", meta_provider=\"coinbase\")\n","            px = float(data[\"data\"][\"amount\"]); print(f\"✅ Coinbase: {px}\"); return px\n","        except Exception as e:\n","            print(f\"⚠️ Coinbase falló: {e}\"); return None\n","\n","    def obtener_precio_bitfinex(self) -> Optional[float]:\n","        if not (os.getenv(\"ENABLE_BITFINEX\", \"1\") == \"1\"): return None\n","        try:\n","            data = self._get_json(\"https://api-pub.bitfinex.com/v2/ticker/tBTCUSD\", meta_provider=\"bitfinex\")\n","            px = float(data[6]); print(f\"✅ Bitfinex: {px}\"); return px\n","        except Exception as e:\n","            print(f\"⚠️ Bitfinex falló: {e}\"); return None\n","\n","    def obtener_precio_okx(self) -> Optional[float]:\n","        if not (os.getenv(\"ENABLE_OKX\", \"1\") == \"1\"): return None\n","        try:\n","            data = self._get_json(\"https://www.okx.com/api/v5/market/ticker?instId=BTC-USDT\", meta_provider=\"okx\")\n","            px = float(data[\"data\"][0][\"last\"]); print(f\"✅ OKX: {px}\"); return px\n","        except Exception as e:\n","            print(f\"⚠️ OKX falló: {e}\"); return None\n","\n","    @retry(wait=wait_exponential(min=1, max=5),\n","           stop=stop_after_attempt(5),\n","           retry=retry_if_exception_type(Exception),\n","           reraise=False)\n","    async def obtener_precio_kraken(self) -> Optional[float]:\n","        try:\n","            ticker = await self.api.query_public('Ticker', {'pair': 'XBTUSD'})\n","            res = ticker.get(\"result\", {})\n","            if not res: raise ValueError(\"Respuesta Kraken sin 'result'\")\n","            key = next((k for k in res.keys() if \"XBT\" in k and \"USD\" in k), None)\n","            if key is None: key = \"XXBTZUSD\" if \"XXBTZUSD\" in res else next(iter(res.keys()))\n","            c = res[key].get(\"c\", []); px = float(c[0]) if c else float(\"nan\")\n","            if math.isnan(px): raise ValueError(\"Kraken retornó NaN\")\n","            self.kraken_precio = px; print(f\"✅ Kraken: {px}\"); return px\n","        except Exception as e:\n","            print(f\"❌ Kraken falló: {e}\"); return None\n","\n","    def obtener_precio_seguro(self) -> Optional[float]:\n","        fuentes: List[Callable[[], Optional[float]]] = [\n","            self.obtener_precio_coingecko,\n","            self.obtener_precio_coinmarketcap,\n","            self.obtener_precio_binance,\n","            self.obtener_precio_coinpaprika,\n","            self.obtener_precio_coinbase,\n","            self.obtener_precio_bitfinex,\n","            self.obtener_precio_okx,\n","            self.obtener_precio_yahoo,\n","            self.obtener_precio_bitstamp,\n","        ]\n","        for getter in fuentes:\n","            try: px = getter()\n","            except Exception: px = None\n","            if px: return px\n","        print(\"⚠️ Todas las fuentes fallaron. Probando caché local...\")\n","        px = self._cargar_cache(valid_within=COINGECKO_TTL_SECONDS * 3)\n","        if px is not None: print(f\"📦 Precio en caché: {px}\")\n","        else: print(\"❌ Sin precio disponible.\")\n","        return px\n","\n","    async def comparar_y_ajustar_prediccion(self, precio_actual: float, prediccion_original: float) -> float:\n","        try:\n","            precio_kraken = await self.obtener_precio_kraken()\n","            precio_externo = self.obtener_precio_seguro()\n","            if not precio_kraken or not precio_externo or precio_kraken <= 0:\n","                print(\"⚠️ Predicción sin ajuste (fuentes insuficientes)\")\n","                return float(prediccion_original)\n","            diferencia = abs(precio_kraken - precio_externo)\n","            if diferencia > 10:\n","                ajuste = (precio_externo - precio_kraken) / precio_kraken\n","                nueva = float(prediccion_original) * (1 + ajuste)\n","                print(f\"🔧 Ajuste aplicado por diferencia {diferencia:.2f} → {nueva:.2f}\")\n","                return round(nueva, 2)\n","            return float(prediccion_original)\n","        except Exception as e:\n","            print(f\"❌ Error ajustando predicción: {e}\")\n","            return float(prediccion_original)\n","\n","    async def resumen_tareas_rt(self, inteligencia) -> Dict[str, Any]:\n","        try:\n","            px_k = await self.obtener_precio_kraken()\n","            px_s = self.obtener_precio_seguro()\n","        except Exception:\n","            px_k, px_s = None, None\n","        resumen: Dict[str, Any] = {\n","            \"ts_utc\": _now_utc_iso(),\n","            \"precio_kraken\": px_k,\n","            \"precio_seguro\": px_s,\n","            \"diferencia_usd\": (abs(px_k - px_s) if (px_k and px_s) else None),\n","            \"inteligencia\": {}\n","        }\n","        if inteligencia:\n","            try:\n","                sig = getattr(inteligencia, \"last_signal\", None) or {}\n","                trend = getattr(inteligencia, \"trend\", None)\n","                trend_state = getattr(trend, \"state\", None)\n","                prob_up = sig.get(\"ml_prob_up\")\n","                fused = sig.get(\"ml_override\") or sig.get(\"action\")\n","                methods = sig.get(\"methods\", {}) if isinstance(sig.get(\"methods\"), dict) else {}\n","                resumen[\"inteligencia\"] = {\n","                    \"trend_state\": trend_state,\n","                    \"ml_prob_up\": prob_up,\n","                    \"fusion_action\": fused,\n","                    \"TRC3\": (methods.get(\"TRC3\", {}) or {}).get(\"signal\"),\n","                    \"LiquidityHunter\": (methods.get(\"LiquidityHunter\", {}) or {}).get(\"action\"),\n","                    \"QuantumEntanglement\": (methods.get(\"QuantumEntanglement\", {}) or {}).get(\"signal\"),\n","                    \"ByzantineShield\": (methods.get(\"ByzantineShield\", {}) or {}).get(\"defense\"),\n","                }\n","            except Exception as e:\n","                resumen[\"inteligencia\"] = {\"error\": f\"{e}\"}\n","        return resumen\n","\n","\n","# ==============================================================================================\n","# ==================== INDICADORES TÉCNICOS AVANZADOS =========================================\n","# ==============================================================================================\n","\n","import pandas as pd\n","from scipy import stats\n","\n","# ===================== TALIB: real si existe, shim si no =====================================\n","try:\n","    import talib as talib  # usa TA-Lib real si está disponible\n","    _TA_LIB_OK = True\n","except Exception:\n","    _TA_LIB_OK = False\n","\n","    def _ema(arr, period):\n","        arr = np.asarray(arr, dtype=float)\n","        if period <= 1:\n","            return arr.copy()\n","        out = np.empty_like(arr, dtype=float); out[:] = np.nan\n","        alpha = 2.0 / (period + 1.0)\n","        s = np.nan\n","        for i, v in enumerate(arr):\n","            if np.isnan(v):\n","                out[i] = s; continue\n","            if np.isnan(s):\n","                if i + 1 >= period:\n","                    s = np.nanmean(arr[i+1-period:i+1])\n","                else:\n","                    s = v\n","            else:\n","                s = alpha * v + (1 - alpha) * s\n","            out[i] = s\n","        return out\n","\n","    class _TA_Shim:\n","        @staticmethod\n","        def SMA(close, timeperiod=14):\n","            x = np.asarray(close, dtype=float)\n","            if timeperiod <= 1: return x.copy()\n","            out = np.full_like(x, np.nan, dtype=float)\n","            cs = np.cumsum(np.insert(x, 0, 0.0))\n","            for i in range(timeperiod-1, len(x)):\n","                out[i] = (cs[i+1]-cs[i+1-timeperiod]) / timeperiod\n","            return out\n","\n","        @staticmethod\n","        def EMA(close, timeperiod=14):\n","            return _ema(close, timeperiod)\n","\n","        @staticmethod\n","        def WMA(close, timeperiod=14):\n","            x = np.asarray(close, dtype=float)\n","            out = np.full_like(x, np.nan, dtype=float)\n","            w = np.arange(1, timeperiod+1, dtype=float); ws = w.sum()\n","            for i in range(timeperiod-1, len(x)):\n","                seg = x[i+1-timeperiod:i+1]\n","                out[i] = np.dot(seg, w)/ws\n","            return out\n","\n","        @staticmethod\n","        def RSI(close, timeperiod=14):\n","            x = np.asarray(close, dtype=float)\n","            if len(x) < timeperiod+1: return np.full_like(x, np.nan, dtype=float)\n","            d = np.diff(x)\n","            up = np.where(d > 0, d, 0.0); dn = np.where(d < 0, -d, 0.0)\n","            ru = _ema(np.concatenate([[np.nan], up]), timeperiod)\n","            rd = _ema(np.concatenate([[np.nan], dn]), timeperiod)\n","            rs = ru / (rd + 1e-12)\n","            rsi = 100.0 - (100.0 / (1.0 + rs))\n","            rsi[:timeperiod] = np.nan\n","            return rsi\n","\n","        @staticmethod\n","        def BBANDS(close, timeperiod=20, nbdevup=2.0, nbdevdn=2.0, matype=0):\n","            x = np.asarray(close, dtype=float)\n","            ma = _TA_Shim.SMA(x, timeperiod) if matype == 0 else _TA_Shim.EMA(x, timeperiod)\n","            up = np.full_like(x, np.nan, dtype=float)\n","            lo = np.full_like(x, np.nan, dtype=float)\n","            for i in range(timeperiod-1, len(x)):\n","                seg = x[i+1-timeperiod:i+1]\n","                sd = np.nanstd(seg, ddof=0)\n","                up[i] = ma[i] + nbdevup * sd\n","                lo[i] = ma[i] - nbdevdn * sd\n","            return up, ma, lo\n","\n","        @staticmethod\n","        def MACD(close, fastperiod=12, slowperiod=26, signalperiod=9):\n","            x = np.asarray(close, dtype=float)\n","            ef = _ema(x, fastperiod); es = _ema(x, slowperiod)\n","            macd = ef - es\n","            signal = _ema(macd, signalperiod)\n","            hist = macd - signal\n","            return macd, signal, hist\n","\n","        @staticmethod\n","        def ATR(high, low, close, timeperiod=14):\n","            h = np.asarray(high, dtype=float)\n","            l = np.asarray(low, dtype=float)\n","            c = np.asarray(close, dtype=float)\n","            n = len(c)\n","            tr = np.full(n, np.nan, dtype=float)\n","            for i in range(n):\n","                if i == 0: tr[i] = h[i] - l[i]\n","                else: tr[i] = max(h[i]-l[i], abs(h[i]-c[i-1]), abs(l[i]-c[i-1]))\n","            return _ema(tr, timeperiod)\n","\n","        @staticmethod\n","        def ADX(high, low, close, timeperiod=14):\n","            atr = _TA_Shim.ATR(high, low, close, timeperiod=timeperiod)\n","            h = np.asarray(high, dtype=float); l = np.asarray(low, dtype=float)\n","            n = len(h)\n","            plus_dm = np.full(n, np.nan, dtype=float)\n","            minus_dm = np.full(n, np.nan, dtype=float)\n","            for i in range(1, n):\n","                up = h[i]-h[i-1]; dn = l[i-1]-l[i]\n","                plus_dm[i] = up if (up > dn and up > 0) else 0.0\n","                minus_dm[i] = dn if (dn > up and dn > 0) else 0.0\n","            plus_di = 100.0 * _ema(plus_dm, timeperiod) / (atr + 1e-12)\n","            minus_di = 100.0 * _ema(minus_dm, timeperiod) / (atr + 1e-12)\n","            dx = 100.0 * np.abs(plus_di - minus_di) / (plus_di + minus_di + 1e-12)\n","            return _ema(dx, timeperiod)\n","\n","        @staticmethod\n","        def CCI(high, low, close, timeperiod=20):\n","            h = np.asarray(high, dtype=float); l = np.asarray(low, dtype=float); c = np.asarray(close, dtype=float)\n","            tp = (h + l + c) / 3.0\n","            sma = _TA_Shim.SMA(tp, timeperiod)\n","            out = np.full_like(tp, np.nan, dtype=float)\n","            for i in range(timeperiod-1, len(tp)):\n","                seg = tp[i+1-timeperiod:i+1]\n","                md = np.nanmean(np.abs(seg - np.nanmean(seg)))\n","                out[i] = (tp[i] - sma[i]) / (0.015 * (md + 1e-12))\n","            return out\n","\n","        @staticmethod\n","        def STOCH(high, low, close, fastk_period=14, slowk_period=3, slowd_period=3):\n","            h = np.asarray(high, dtype=float); l = np.asarray(low, dtype=float); c = np.asarray(close, dtype=float)\n","            n = len(c); k = np.full(n, np.nan, dtype=float)\n","            for i in range(fastk_period-1, n):\n","                hh = np.nanmax(h[i+1-fastk_period:i+1]); ll = np.nanmin(l[i+1-fastk_period:i+1])\n","                k[i] = 100.0 * (c[i] - ll) / (hh - ll + 1e-12)\n","            def _sma(arr, p):\n","                out = np.full_like(arr, np.nan, dtype=float)\n","                if p <= 1: return arr.copy()\n","                cs = np.cumsum(np.insert(np.nan_to_num(arr, nan=0.0), 0, 0.0))\n","                cnt = np.cumsum(~np.isnan(arr)).astype(float)\n","                for i in range(p-1, len(arr)):\n","                    num = cs[i+1] - cs[i+1-p]\n","                    den = cnt[i] - (cnt[i-p] if i-p >= 0 else 0.0)\n","                    out[i] = num / max(den, 1.0)\n","                return out\n","            slowk = _sma(k, slowk_period); slowd = _sma(slowk, slowd_period)\n","            return slowk, slowd\n","\n","    talib = _TA_Shim()  # expone interfaz compatible\n","\n","\n","\n","\n","\n","\n","\n","\n","\n","# ===================== SKLEARN: real si existe, shim si no =====================\n","# Mantiene tu API: LinearRegression y StandardScaler siempre disponibles.\n","# Si sklearn falla (ImportError xpx/array_api), activamos fallbacks puros NumPy.\n","try:\n","    from sklearn.linear_model import LinearRegression as _SKLR_LinearRegression\n","    from sklearn.preprocessing import StandardScaler as _SKLR_StandardScaler\n","    LinearRegression = _SKLR_LinearRegression\n","    StandardScaler  = _SKLR_StandardScaler\n","    _SKLR_BACKEND = \"sklearn\"\n","except Exception as _e_sklean:\n","    _SKLR_BACKEND = \"shim\"\n","    _SKLR_IMPORT_ERROR = str(_e_sklean)\n","\n","    class StandardScaler:\n","        def __init__(self, with_mean: bool = True, with_std: bool = True):\n","            self.with_mean = with_mean\n","            self.with_std = with_std\n","            self.mean_: np.ndarray | None = None\n","            self.scale_: np.ndarray | None = None\n","\n","        def fit(self, X):\n","            X = np.asarray(X, dtype=float)\n","            if X.ndim == 1:\n","                X = X.reshape(-1, 1)\n","            if self.with_mean:\n","                self.mean_ = np.nanmean(X, axis=0)\n","            else:\n","                self.mean_ = np.zeros(X.shape[1], dtype=float)\n","            if self.with_std:\n","                std = np.nanstd(X, axis=0, ddof=0)\n","                std[std == 0.0] = 1.0\n","                self.scale_ = std\n","            else:\n","                self.scale_ = np.ones(X.shape[1], dtype=float)\n","            return self\n","\n","        def transform(self, X):\n","            X = np.asarray(X, dtype=float)\n","            if X.ndim == 1:\n","                X = X.reshape(-1, 1)\n","            return (X - self.mean_) / self.scale_\n","\n","        def fit_transform(self, X):\n","            return self.fit(X).transform(X)\n","\n","        def inverse_transform(self, X):\n","            X = np.asarray(X, dtype=float)\n","            if X.ndim == 1:\n","                X = X.reshape(-1, 1)\n","            return X * self.scale_ + self.mean_\n","\n","    class LinearRegression:\n","        def __init__(self, fit_intercept: bool = True, copy_X: bool = True,\n","                     n_jobs=None, positive: bool = False):\n","            self.fit_intercept = fit_intercept\n","            self.copy_X = copy_X\n","            self.n_jobs = n_jobs\n","            self.positive = positive\n","            self.coef_: np.ndarray | None = None\n","            self.intercept_: float = 0.0\n","\n","        def fit(self, X, y):\n","            X = np.asarray(X, dtype=float)\n","            y = np.asarray(y, dtype=float)\n","            if X.ndim == 1:\n","                X = X.reshape(-1, 1)\n","\n","            # Intercepto como columna de unos\n","            if self.fit_intercept:\n","                X_aug = np.column_stack([X, np.ones(X.shape[0], dtype=float)])\n","            else:\n","                X_aug = X\n","\n","            # Coeficientes no-negativos si se pide\n","            if self.positive:\n","                try:\n","                    from scipy.optimize import nnls\n","                    beta, _ = nnls(X_aug, y)\n","                except Exception:\n","                    beta, *_ = np.linalg.lstsq(X_aug, y, rcond=None)\n","                    beta = np.maximum(beta, 0.0)\n","            else:\n","                beta, *_ = np.linalg.lstsq(X_aug, y, rcond=None)\n","\n","            if self.fit_intercept:\n","                self.coef_ = beta[:-1]\n","                self.intercept_ = float(beta[-1])\n","            else:\n","                self.coef_ = beta\n","                self.intercept_ = 0.0\n","            return self\n","\n","        def predict(self, X):\n","            X = np.asarray(X, dtype=float)\n","            if X.ndim == 1:\n","                X = X.reshape(-1, 1)\n","            return X.dot(self.coef_) + self.intercept_\n","\n","    try:\n","        print(f\"⚠️  sklearn no disponible. Activado backend shim (razón: {_SKLR_IMPORT_ERROR})\")\n","    except Exception:\n","        pass\n","# ============================================================================\n","\n","# ===================== STUBS NO INVASIVOS si tu runtime aún no los tiene ======================\n","if \"auto_api\" not in globals():\n","    def auto_api():\n","        class _PublicKraken:\n","            async def get_ohlcv_data(self, symbol: str, interval: str = \"1\", since: float | None = None):\n","                # Fallback simulado; reemplazado automáticamente si tienes tu API real cargada\n","                base = 30000.0; now = time.time()\n","                pts = 60 if interval == \"1\" else (300 if interval == \"5\" else 24)\n","                out = []\n","                for i in range(pts):\n","                    v = np.random.uniform(-0.002, 0.002)\n","                    price = base * (1.0 + v)\n","                    out.append([int(now - (pts - i) * 60), price, price*1.001, price*0.999, price, np.random.uniform(10,100)])\n","                return out\n","        return _PublicKraken()\n","\n","if \"AnalizadorRetrospectivoBTC\" not in globals():\n","    class AnalizadorRetrospectivoBTC:\n","        def __init__(self, api, ventana_horas=24, resolucion=\"1m\"):\n","            self.api = api; self.ventana_horas = ventana_horas; self.resolucion = resolucion\n","        async def obtener_historial_precios_detallado(self):\n","            o1 = await self.api.get_ohlcv_data(\"BTC/USD\", \"1\", since=time.time()-3600)\n","            o5 = await self.api.get_ohlcv_data(\"BTC/USD\", \"5\", since=time.time()-5*3600)\n","            o60 = await self.api.get_ohlcv_data(\"BTC/USD\", \"60\", since=time.time()-24*3600)\n","            def proc(ohlc):\n","                r=[]\n","                for p in ohlc:\n","                    r.append({'timestamp':p[0],'open':float(p[1]),'high':float(p[2]),'low':float(p[3]),'close':float(p[4]),'volume':float(p[5])})\n","                return r\n","            return {\"1m\":proc(o1),\"5m\":proc(o5),\"1h\":proc(o60)}\n","\n","if \"run_once\" not in globals():\n","    async def run_once(*, api=None, order_executor=None, guard=None):\n","        return {\"status\":\"ok\",\"note\":\"stub run_once (se usará tu real si ya está cargado en globals())\"}\n","\n","# ========================== TU SECCIÓN ORIGINAL (conservada) ==================================\n","\n","class IndicadoresAvanzadosBTC:\n","    \"\"\"Suite completa de indicadores técnicos avanzados para análisis BTC\"\"\"\n","\n","    def __init__(self, ventana_rapida=12, ventana_lenta=26, ventana_señal=9):\n","        self.ventana_rapida = ventana_rapida\n","        self.ventana_lenta = ventana_lenta\n","        self.ventana_señal = ventana_señal\n","        self.historial_indicadores = deque(maxlen=1000)\n","\n","    # ==================== INDICADORES DE TENDENCIA AVANZADOS ====================\n","\n","    def ichimoku_cloud(self, high, low, close, conversion_period=9, base_period=26, lagging_span=52):\n","        \"\"\"Nube Ichimoku - Sistema completo de trading\"\"\"\n","        if len(high) < lagging_span:\n","            return {}\n","\n","        # Líneas principales\n","        conversion_line = (np.max(high[-conversion_period:]) + np.min(low[-conversion_period:])) / 2\n","        base_line = (np.max(high[-base_period:]) + np.min(low[-base_period:])) / 2\n","        leading_span_a = (conversion_line + base_line) / 2\n","        leading_span_b = (np.max(high[-lagging_span:]) + np.min(low[-lagging_span:])) / 2\n","        lagging_span = close[-base_period] if len(close) > base_period else close[0]\n","\n","        # Señales\n","        precio_sobre_nube = close[-1] > max(leading_span_a, leading_span_b)\n","        tendencia_alcista = conversion_line > base_line and leading_span_a > leading_span_b\n","\n","        return {\n","            'conversion_line': conversion_line,\n","            'base_line': base_line,\n","            'leading_span_a': leading_span_a,\n","            'leading_span_b': leading_span_b,\n","            'lagging_span': lagging_span,\n","            'precio_sobre_nube': precio_sobre_nube,\n","            'tendencia_alcista': tendencia_alcista,\n","            'senkou_span_a': leading_span_a,\n","            'senkou_span_b': leading_span_b\n","        }\n","\n","    def super_trend(self, high, low, close, period=10, multiplier=3):\n","        \"\"\"SuperTrend - Indicador de tendencia y stop loss dinámico\"\"\"\n","        if len(high) < period:\n","            return {}\n","        tr = np.maximum(high[-1] - low[-1],\n","                        np.maximum(abs(high[-1] - close[-2]),\n","                                   abs(low[-1] - close[-2])))\n","        atr = np.mean([high[i] - low[i] for i in range(-period, 0)])\n","        upper_band = (high[-1] + low[-1]) / 2 + multiplier * atr\n","        lower_band = (high[-1] + low[-1]) / 2 - multiplier * atr\n","        tendencia_alcista = close[-1] > upper_band\n","        tendencia_bajista = close[-1] < lower_band\n","        return {\n","            'upper_band': upper_band,\n","            'lower_band': lower_band,\n","            'atr_current': tr,\n","            'atr_period': atr,\n","            'tendencia_alcista': tendencia_alcista,\n","            'tendencia_bajista': tendencia_bajista,\n","            'super_trend': upper_band if tendencia_alcista else lower_band\n","        }\n","\n","    def hull_moving_average(self, prices, period=20):\n","        \"\"\"HMA - Media móvil de Hull (sin lag)\"\"\"\n","        if len(prices) < period:\n","            return np.nan\n","        wma_half = self.wma(prices, period//2)\n","        wma_full = self.wma(prices, period)\n","        wma_diff = 2 * wma_half - wma_full\n","        hma = self.wma([wma_diff], int(np.sqrt(period)))\n","        return hma\n","\n","    def wma(self, prices, period):\n","        \"\"\"Weighted Moving Average\"\"\"\n","        if len(prices) < period:\n","            return np.nan\n","        weights = np.arange(1, period + 1)\n","        return np.average(prices[-period:], weights=weights)\n","\n","    # ==================== INDICADORES DE MOMENTUM AVANZADOS ====================\n","\n","    def vortex_indicator(self, high, low, close, period=14):\n","        \"\"\"Indicador Vortex - Dirección del movimiento tendencial\"\"\"\n","        if len(high) < period + 1:\n","            return {}\n","        vm_plus = [abs(high[i] - low[i-1]) for i in range(-period, 0)]\n","        vm_minus = [abs(low[i] - high[i-1]) for i in range(-period, 0)]\n","        tr = [max(high[i] - low[i], abs(high[i] - close[i-1]), abs(low[i] - close[i-1]))\n","              for i in range(-period, 0)]\n","        vi_plus = np.sum(vm_plus) / np.sum(tr)\n","        vi_minus = np.sum(vm_minus) / np.sum(tr)\n","        return {\n","            'vi_plus': vi_plus,\n","            'vi_minus': vi_minus,\n","            'cruce_alcista': vi_plus > vi_minus,\n","            'fuerza_tendencia': abs(vi_plus - vi_minus)\n","        }\n","\n","    def awesome_oscillator(self, high, low, fast_period=5, slow_period=34):\n","        \"\"\"AO - Oscilador Awesome de Bill Williams\"\"\"\n","        if len(high) < slow_period:\n","            return {}\n","        median_price = [(h + l) / 2 for h, l in zip(high, low)]\n","        ao_fast = np.mean(median_price[-fast_period:])\n","        ao_slow = np.mean(median_price[-slow_period:])\n","        ao = ao_fast - ao_slow\n","        saucer_bullish = (ao > 0 and ao > np.mean(median_price[-fast_period:-1]))\n","        saucer_bearish = (ao < 0 and ao < np.mean(median_price[-fast_period:-1]))\n","        return {\n","            'ao_value': ao,\n","            'ao_fast': ao_fast,\n","            'ao_slow': ao_slow,\n","            'saucer_bullish': saucer_bullish,\n","            'saucer_bearish': saucer_bearish,\n","            'signal': 'BULLISH' if ao > 0 else 'BEARISH'\n","        }\n","\n","    def stochastic_rsi(self, prices, rsi_period=14, stoch_period=14):\n","        \"\"\"Stochastic RSI - Doble momentum\"\"\"\n","        if len(prices) < rsi_period + stoch_period:\n","            return {}\n","        rsi = self.calculate_rsi(prices, rsi_period)\n","        if len(rsi) < stoch_period:\n","            return {}\n","        rsi_min = np.min(rsi[-stoch_period:])\n","        rsi_max = np.max(rsi[-stoch_period:])\n","        stoch_rsi = (rsi[-1] - rsi_min) / (rsi_max - rsi_min) if rsi_max != rsi_min else 0.5\n","        return {\n","            'stoch_rsi': stoch_rsi,\n","            'rsi_value': rsi[-1],\n","            'sobrecompra': stoch_rsi > 0.8,\n","            'sobreventa': stoch_rsi < 0.2\n","        }\n","\n","    def calculate_rsi(self, prices, period=14):\n","        \"\"\"Calcula RSI estándar\"\"\"\n","        if len(prices) < period + 1:\n","            return []\n","        deltas = np.diff(prices)\n","        gains = np.where(deltas > 0, deltas, 0)\n","        losses = np.where(deltas < 0, -deltas, 0)\n","        avg_gains = np.convolve(gains, np.ones(period)/period, mode='valid')\n","        avg_losses = np.convolve(losses, np.ones(period)/period, mode='valid')\n","        rs = avg_gains / (avg_losses + 1e-10)\n","        rsi = 100 - (100 / (1 + rs))\n","        return rsi\n","\n","    # ==================== INDICADORES DE VOLATILIDAD AVANZADOS ====================\n","\n","    def keltner_channels(self, high, low, close, ema_period=20, atr_period=10, multiplier=2):\n","        \"\"\"Canales de Keltner - Bandas basadas en ATR\"\"\"\n","        if len(close) < max(ema_period, atr_period):\n","            return {}\n","        ema = talib.EMA(np.array(close), timeperiod=ema_period)[-1]\n","        atr = talib.ATR(np.array(high), np.array(low), np.array(close), timeperiod=atr_period)[-1]\n","        upper_band = ema + multiplier * atr\n","        lower_band = ema - multiplier * atr\n","        return {\n","            'ema_center': ema,\n","            'upper_band': upper_band,\n","            'lower_band': lower_band,\n","            'atr_width': atr,\n","            'precio_sobre_ema': close[-1] > ema,\n","            'band_width_percent': (upper_band - lower_band) / ema * 100\n","        }\n","\n","    def donchian_channels(self, high, low, period=20):\n","        \"\"\"Canales de Donchian - Breakout system\"\"\"\n","        if len(high) < period:\n","            return {}\n","        upper = np.max(high[-period:])\n","        lower = np.min(low[-period:])\n","        middle = (upper + lower) / 2\n","        return {\n","            'upper_channel': upper,\n","            'lower_channel': lower,\n","            'middle_channel': middle,\n","            'breakout_up': high[-1] > upper,\n","            'breakout_down': low[-1] < lower,\n","            'channel_width': upper - lower\n","        }\n","\n","    def volatility_ratio(self, high, low, close, period=14):\n","        \"\"\"Ratio de Volatilidad - Medida de expansión/contracción\"\"\"\n","        if len(high) < period:\n","            return 0\n","        true_ranges = []\n","        for i in range(-period, 0):\n","            tr = max(high[i] - low[i],\n","                     abs(high[i] - close[i-1]),\n","                     abs(low[i] - close[i-1]))\n","            true_ranges.append(tr)\n","        current_vol = np.mean(true_ranges[-5:]) if len(true_ranges) >= 5 else true_ranges[-1]\n","        historical_vol = np.mean(true_ranges)\n","        return current_vol / historical_vol if historical_vol != 0 else 1\n","\n","    # ==================== INDICADORES DE VOLUMEN AVANZADOS ====================\n","\n","    def volume_profile_analysis(self, prices, volumes, num_bins=20):\n","        \"\"\"Análisis de Perfil de Volumen - Puntos de control\"\"\"\n","        if len(prices) < 10:\n","            return {}\n","        min_price, max_price = min(prices), max(prices)\n","        bin_width = (max_price - min_price) / num_bins if num_bins > 0 else (max_price-min_price)\n","        if bin_width == 0: bin_width = 1e-9\n","        bins = [min_price + i * bin_width for i in range(num_bins + 1)]\n","        volume_per_bin = [0] * num_bins\n","        for price, volume in zip(prices, volumes):\n","            if min_price <= price <= max_price:\n","                idx = min(int((price - min_price) / bin_width), num_bins - 1)\n","                volume_per_bin[idx] += volume\n","        poc_index = int(np.argmax(volume_per_bin)) if num_bins > 0 else 0\n","        poc_price = bins[poc_index] + bin_width / 2 if num_bins > 0 else min_price\n","        total_volume = sum(volume_per_bin)\n","        sorted_bins = sorted(zip(volume_per_bin, bins), reverse=True)\n","        cumulative_volume = 0; value_area_bins = []\n","        for vol, bin_start in sorted_bins:\n","            cumulative_volume += vol\n","            value_area_bins.append(bin_start)\n","            if total_volume > 0 and cumulative_volume >= total_volume * 0.7:\n","                break\n","        return {\n","            'poc_price': poc_price,\n","            'value_area': value_area_bins,\n","            'total_volume': total_volume,\n","            'volume_distribution': volume_per_bin,\n","            'high_volume_nodes': [bins[i] for i in np.argsort(volume_per_bin)[-3:][::-1]] if num_bins >= 3 else []\n","        }\n","\n","    def accumulation_distribution(self, high, low, close, volume):\n","        \"\"\"ADL - Acumulación/Distribución\"\"\"\n","        if len(high) < 2:\n","            return 0\n","        mf_mult = ((close[-1] - low[-1]) - (high[-1] - close[-1])) / (high[-1] - low[-1]) if high[-1] != low[-1] else 0\n","        mf_vol = mf_mult * volume[-1]\n","        return mf_vol\n","\n","    # ==================== INDICADORES DE CICLOS Y PATRONES ====================\n","\n","    def fibonacci_retracement(self, high, low):\n","        \"\"\"Niveles de Retroceso Fibonacci\"\"\"\n","        swing_high = max(high); swing_low = min(low); diff = swing_high - swing_low\n","        levels = {\n","            '0.0': swing_high,\n","            '0.236': swing_high - diff * 0.236,\n","            '0.382': swing_high - diff * 0.382,\n","            '0.5': swing_high - diff * 0.5,\n","            '0.618': swing_high - diff * 0.618,\n","            '0.786': swing_high - diff * 0.786,\n","            '1.0': swing_low\n","        }\n","        current_price = (high[-1] + low[-1]) / 2\n","        nearest_level = min(levels.items(), key=lambda x: abs(x[1] - current_price))\n","        return {\n","            'levels': levels,\n","            'current_nearest_level': nearest_level[0],\n","            'distance_to_level': (current_price - nearest_level[1]) / (diff if diff != 0 else 1) * 100,\n","            'swing_high': swing_high,\n","            'swing_low': swing_low\n","        }\n","\n","    def harmonic_patterns_detection(self, high, low):\n","        \"\"\"Detección básica de patrones armónicos\"\"\"\n","        patterns_detected = []\n","        if len(high) >= 4:\n","            ab_move = abs(high[-4] - low[-3])\n","            bc_move = abs(high[-3] - low[-2])\n","            cd_move = abs(high[-2] - low[-1])\n","            if ab_move > 0 and 0.618 <= (bc_move / ab_move) <= 0.786 and bc_move > 0 and 1.272 <= (cd_move / bc_move) <= 1.618:\n","                patterns_detected.append('BULLISH_ABCD')\n","        return patterns_detected\n","\n","    # ==================== INDICADORES DE MARKET PROFILE ====================\n","\n","    def market_profile_indicators(self, prices, volumes, time_periods):\n","        \"\"\"Indicadores de Market Profile avanzados\"\"\"\n","        if len(prices) < 10:\n","            return {}\n","        vwap = np.average(prices, weights=volumes) if sum(volumes) != 0 else np.mean(prices)\n","        poc = self.volume_profile_analysis(prices, volumes).get('poc_price', prices[-1])\n","        deviation_from_vwap = (prices[-1] - vwap) / (vwap if vwap != 0 else 1) * 100\n","        return {\n","            'vwap': vwap,\n","            'poc': poc,\n","            'deviation_vwap': deviation_from_vwap,\n","            'fair_value_gap': abs(prices[-1] - vwap),\n","            'market_inefficiency': deviation_from_vwap\n","        }\n","\n","class AnalisisMultiTimeframeIntegrado:\n","    \"\"\"Análisis integrado de indicadores en múltiples timeframes\"\"\"\n","\n","    def __init__(self):\n","        self.indicadores = IndicadoresAvanzadosBTC()\n","        self.timeframes = ['1m', '5m', '15m', '1h', '4h']\n","\n","    async def analisis_completo(self, datos_multi_tf):\n","        \"\"\"Ejecuta análisis completo en todos los timeframes\"\"\"\n","        resultados = {}\n","        for tf, datos in datos_multi_tf.items():\n","            if len(datos) < 20:\n","                continue\n","            resultados[tf] = self._analizar_timeframe(datos, tf)\n","        return self._sintetizar_resultados_multi_tf(resultados)\n","\n","    def _analizar_timeframe(self, datos, timeframe):\n","        \"\"\"Análisis individual por timeframe\"\"\"\n","        high = [d['high'] for d in datos]\n","        low = [d['low'] for d in datos]\n","        close = [d['close'] for d in datos]\n","        volume = [d.get('volume', 0) for d in datos]\n","        analisis = {\n","            'ichimoku': self.indicadores.ichimoku_cloud(high, low, close),\n","            'super_trend': self.indicadores.super_trend(high, low, close),\n","            'vortex': self.indicadores.vortex_indicator(high, low, close),\n","            'awesome_oscillator': self.indicadores.awesome_oscillator(high, low),\n","            'keltner': self.indicadores.keltner_channels(high, low, close),\n","            'stochastic_rsi': self.indicadores.stochastic_rsi(close),\n","            'volume_profile': self.indicadores.volume_profile_analysis(close, volume),\n","            'fibonacci': self.indicadores.fibonacci_retracement(high, low),\n","            'market_profile': self.indicadores.market_profile_indicators(close, volume, [1] * len(close))\n","        }\n","        return self._calcular_consenso_señales(analisis)\n","\n","    def _calcular_consenso_señales(self, analisis):\n","        \"\"\"Calcula consenso de señales entre indicadores\"\"\"\n","        señales_alcistas = 0; señales_bajistas = 0; total_indicadores = 0\n","        for nombre, resultado in analisis.items():\n","            if resultado:\n","                if 'tendencia_alcista' in resultado and resultado['tendencia_alcista']:\n","                    señales_alcistas += 1\n","                if 'tendencia_bajista' in resultado and resultado['tendencia_bajista']:\n","                    señales_bajistas += 1\n","                total_indicadores += 1\n","        consenso = (señales_alcistas - señales_bajistas) / total_indicadores if total_indicadores > 0 else 0\n","        analisis['consenso'] = {\n","            'score': consenso,\n","            'señales_alcistas': señales_alcistas,\n","            'señales_bajistas': señales_bajistas,\n","            'total_indicadores': total_indicadores,\n","            'confianza': abs(consenso) * 100\n","        }\n","        return analisis\n","\n","    def _sintetizar_resultados_multi_tf(self, resultados):\n","        \"\"\"Sintetiza resultados de múltiples timeframes\"\"\"\n","        sintesis = {\n","            'timestamp': time.time(),\n","            'resumen_global': '',\n","            'convergencia_tf': 0,\n","            'recomendaciones': [],\n","            'alertas_criticas': []\n","        }\n","        scores_por_tf = []\n","        for tf, analisis in resultados.items():\n","            if 'consenso' in analisis:\n","                scores_por_tf.append(analisis['consenso']['score'])\n","                # además, copiamos análisis por tf para posibles impresiones posteriores\n","                sintesis[tf] = analisis\n","        if scores_por_tf:\n","            convergencia = np.std(scores_por_tf)\n","            sintesis['convergencia_tf'] = 1 - min(convergencia, 1)\n","            señal_global = np.mean(scores_por_tf)\n","            if señal_global > 0.3:\n","                sintesis['resumen_global'] = \"FUERTE TENDENCIA ALCISTA MULTI-TIMEFRAME\"\n","            elif señal_global < -0.3:\n","                sintesis['resumen_global'] = \"FUERTE TENDENCIA BAJISTA MULTI-TIMEFRAME\"\n","            else:\n","                sintesis['resumen_global'] = \"MERCADO LATERAL/CONTRADICTORIO\"\n","        return sintesis\n","\n","# ==============================================================================================\n","# ==================== VISUALIZACIÓN AVANZADA DE INDICADORES ===================================\n","# ==============================================================================================\n","\n","async def generar_reporte_indicadores_avanzados(datos_historicos):\n","    \"\"\"Genera reporte completo de indicadores avanzados\"\"\"\n","    analizador = AnalisisMultiTimeframeIntegrado()\n","    resultados = await analizador.analisis_completo(datos_historicos)\n","    print(\"\\n🎯 REPORTE DE INDICADORES AVANZADOS BTC\")\n","    print(\"═\" * 80)\n","    print(f\"📊 {resultados.get('resumen_global', 'ANÁLISIS EN PROCESO')}\")\n","    print(f\"🔄 CONVERGENCIA TIMEFRAMES: {resultados.get('convergencia_tf', 0):.1%}\")\n","    print(\"─\" * 80)\n","    for tf in ['1m', '5m', '15m', '1h']:\n","        if tf in resultados:\n","            consenso = resultados[tf].get('consenso', {})\n","            print(f\"⏰ {tf.upper():<4} | Score: {consenso.get('score', 0):+6.2f} | \"\n","                  f\"Alcistas: {consenso.get('señales_alcistas', 0):2d} | \"\n","                  f\"Bajistas: {consenso.get('señales_bajistas', 0):2d} | \"\n","                  f\"Confianza: {consenso.get('confianza', 0):5.1f}%\")\n","    print(\"─\" * 80)\n","    if '1h' in resultados:\n","        analisis_1h = resultados['1h']\n","        await _mostrar_indicadores_clave(analisis_1h)\n","    return resultados\n","\n","async def _mostrar_indicadores_clave(analisis):\n","    \"\"\"Muestra indicadores clave de forma organizada\"\"\"\n","    print(\"🔍 INDICADORES CLAVE (1H):\")\n","    ichimoku = analisis.get('ichimoku', {})\n","    if ichimoku:\n","        print(f\"   ☁️  Ichimoku: {'ALCISTA' if ichimoku.get('tendencia_alcista') else 'BAJISTA'} | \"\n","              f\"Precio sobre nube: {'✅' if ichimoku.get('precio_sobre_nube') else '❌'}\")\n","    super_trend = analisis.get('super_trend', {})\n","    if super_trend:\n","        print(f\"   📈 SuperTrend: {'ALCISTA' if super_trend.get('tendencia_alcista') else 'BAJISTA'} | \"\n","              f\"ATR: {super_trend.get('atr_period', 0):.2f}\")\n","    vortex = analisis.get('vortex', {})\n","    if vortex:\n","        print(f\"   🌪️  Vortex: VI+ {vortex.get('vi_plus', 0):.3f} | \"\n","              f\"VI- {vortex.get('vi_minus', 0):.3f} | \"\n","              f\"{'ALCISTA' if vortex.get('cruce_alcista') else 'BAJISTA'}\")\n","    ao = analisis.get('awesome_oscillator', {})\n","    if ao:\n","        print(f\"   ⚡ Awesome Oscillator: {ao.get('ao_value', 0):+.4f} | \"\n","              f\"Señal: {ao.get('signal', 'NEUTRAL')}\")\n","    keltner = analisis.get('keltner', {})\n","    if keltner:\n","        # Nota: aquí no tenemos 'close' dentro de analisis; mostramos info disponible\n","        print(f\"   📊 Keltner: EMA: {keltner.get('ema_center', 0):.2f} | \"\n","              f\"Ancho bandas: {keltner.get('band_width_percent', 0):.2f}%\")\n","\n","\n","# =============================================================================\n","# ================== SECCIÓN ÚNICA — RESILIENCIA COLAB (TTDVI156) =============\n","# =============================================================================\n","# Funciones clave:\n","#  - run_with_resilience(main_coro_factory): supervisor con checkpoints + backoff\n","#  - TTDVI_resilience_autorun(): arranque automático (script o Colab/Jupyter)\n","# Enchufe automático:\n","#  - Autodescubre tu \"main\": run_loop_principal / boot_darwin_v4_stack / main_async / main\n","#  - Usa hooks opcionales: get_runtime_state, restore_runtime_state, close_all_http_sessions\n","# =============================================================================\n","\n","import os, sys, json, time, asyncio, signal, atexit, traceback, inspect\n","from typing import Any, Callable, Awaitable, Optional, Dict\n","from datetime import datetime, timezone\n","\n","# ---------- Parche permanente: entorno PyTorch-only para Transformers ----------\n","# Evita que Transformers intente TensorFlow/JAX y reduzca warnings deprecados.\n","os.environ.setdefault(\"TRANSFORMERS_NO_TF_WARNING\", \"1\")\n","os.environ.setdefault(\"DISABLE_MLFLOW_INTEGRATION\", \"1\")\n","os.environ.setdefault(\"HF_HUB_DISABLE_TELEMETRY\", \"1\")\n","os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"0\")\n","# Fuerza PyTorch si existe; no instalamos nada aquí, solo orientamos el runtime.\n","os.environ.setdefault(\"USE_TORCH\", \"1\")\n","os.environ.setdefault(\"USE_TF\", \"0\")\n","os.environ.setdefault(\"USE_JAX\", \"0\")\n","\n","def _silence_tf_jax_and_safe_open_noise():\n","    try:\n","        import warnings, re\n","        # Deprecaciones TF/JAX en Transformers v5\n","        warnings.filterwarnings(\n","            \"ignore\",\n","            message=re.compile(r\".*TensorFlow and JAX classes are deprecated.*\"),\n","            category=UserWarning\n","        )\n","        # Ruido de 'safe_open' no iterable (mensajes de demos o loaders terceras)\n","        warnings.filterwarnings(\n","            \"ignore\",\n","            message=re.compile(r\".*safe_open.*not is iterable|not iterable.*\", re.I),\n","            category=UserWarning\n","        )\n","    except Exception:\n","        pass\n","\n","_silence_tf_jax_and_safe_open_noise()\n","\n","# ---------- Utilidad de verbosidad (idempotente) ----------\n","def _in_notebook() -> bool:\n","    try:\n","        from IPython import get_ipython\n","        sh = get_ipython()\n","        return bool(sh) and sh.__class__.__name__ in (\"ZMQInteractiveShell\",\"TerminalInteractiveShell\",\"Shell\")\n","    except Exception:\n","        return False\n","\n","def _is_verbose() -> bool:\n","    # Por defecto silencioso; activa paneles con TTDVI_VERBOSE=1\n","    v = os.getenv(\"TTDVI_VERBOSE\", None)\n","    if v is None:\n","        # Si quieres que en notebook sea detallado por defecto, cambia False -> _in_notebook()\n","        return False\n","    return str(v).strip().lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","\n","# ---------- ⚙️ Compat: si ya lanzaste el ejecutor principal, evita doble autorun ----------\n","if globals().get(\"_TTDVI156_LAUNCHED\", False):\n","    os.environ.setdefault(\"TTDVI_AUTORUN\", \"0\")\n","else:\n","    os.environ.setdefault(\"TTDVI_AUTORUN\", \"1\")\n","\n","# ---------- *** CAMBIO PERMANENTE: nunca parar + reintentos infinitos ----------\n","# 0 => infinitos reintentos; 1 => relanza incluso tras DONE/CANCEL\n","os.environ.setdefault(\"TTDVI_MAX_RETRIES_PER_SESSION\", \"0\")\n","os.environ.setdefault(\"TTDVI_NEVER_STOP\", \"1\")\n","\n","# ---------- 🔒 Fallback global para print_results_panel (silencioso por defecto) ----------\n","try:\n","    _prp0 = globals().get(\"print_results_panel\")\n","    if not callable(_prp0):\n","        raise NameError(\"print_results_panel no callable o no existe\")\n","except Exception:\n","    def print_results_panel(data=None, title=\"Resultados\", **meta):\n","        \"\"\"Renderer por defecto. Respeta TTDVI_VERBOSE.\"\"\"\n","        if not _is_verbose():\n","            return  # silencio total en modo no-verboso\n","        try:\n","            from pprint import pformat\n","            cuerpo = pformat(data, compact=True, width=100)\n","        except Exception:\n","            cuerpo = str(data)\n","        try:\n","            print(f\"\\n── {title} ──\")\n","            if meta:\n","                print(\"meta:\", {k: meta[k] for k in sorted(meta)})\n","            print(cuerpo)\n","            print(\"──────────────\\n\")\n","        except Exception:\n","            try:\n","                sys.stdout.write(f\"[{title}] {cuerpo}\\n\")\n","            except Exception:\n","                pass\n","\n","def set_results_panel_printer(fn: Callable):\n","    \"\"\"Setter global seguro: evita reasignaciones locales peligrosas.\"\"\"\n","    global print_results_panel\n","    if callable(fn):\n","        print_results_panel = fn\n","\n","# ---------- Utilidades de persistencia ----------\n","def _default_resume_dir() -> str:\n","    drive = \"/content/drive\"\n","    if os.path.isdir(drive):\n","        base = os.path.join(drive, \"MyDrive\", \"ttdvi156_state\")\n","    else:\n","        base = os.path.join(os.getenv(\"TTDVI_RUN_ROOT\", \"./run_ttdvi156\"), \"state\")\n","    os.makedirs(base, exist_ok=True)\n","    return base\n","\n","RESUME_DIR = os.getenv(\"TTDVI_RESUME_DIR\", _default_resume_dir())\n","CHECKPOINT_JSON = os.path.join(RESUME_DIR, \"checkpoint.json\")\n","EVENTLOG_NDJSON = os.path.join(RESUME_DIR, \"eventlog.ndjson\")\n","\n","# ---------- Log seguro ----------\n","def _now_iso() -> str:\n","    # ISO8601 UTC (con Z) y ms\n","    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n","\n","def _log_event(kind: str, msg: str, **extra):\n","    rec = {\"ts\": _now_iso(), \"kind\": kind, \"msg\": msg}\n","    if extra: rec.update(extra)\n","    try:\n","        os.makedirs(RESUME_DIR, exist_ok=True)\n","        with open(EVENTLOG_NDJSON, \"a\", encoding=\"utf-8\") as f:\n","            f.write(json.dumps(rec, ensure_ascii=False) + \"\\n\")\n","    except Exception:\n","        pass\n","    # Una sola línea concisa en consola (siempre)\n","    print(f\"[{kind}] {rec['ts']} — {msg}\")\n","\n","# ====================== Parche HF (silencioso y opcional) =====================\n","def _patch_hf_colab_warning_and_auth():\n","    try:\n","        import warnings\n","        warnings.filterwarnings(\n","            \"ignore\",\n","            message=r\"The secret `HF_TOKEN` does not exist in your Colab secrets\\.\",\n","            category=UserWarning,\n","            module=r\"huggingface_hub\\.utils\\._auth\"\n","        )\n","        os.environ.setdefault(\"HF_HUB_DISABLE_TELEMETRY\", \"1\")\n","        os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"0\")\n","        HF_HOME = os.getenv(\"HF_HOME\") or os.path.join(RESUME_DIR, \".hf\")\n","        os.environ[\"HF_HOME\"] = HF_HOME\n","        os.makedirs(HF_HOME, exist_ok=True)\n","\n","        token = (\n","            os.getenv(\"HF_TOKEN\")\n","            or os.getenv(\"HUGGINGFACEHUB_API_TOKEN\")\n","            or os.getenv(\"HUGGING_FACE_HUB_TOKEN\")\n","        )\n","        if token:\n","            try:\n","                from huggingface_hub import login\n","                login(token=token, add_to_git_credential=True)\n","                _log_event(\"HF\", \"Autenticado con HF_TOKEN (login ok)\")\n","            except Exception as e:\n","                _log_event(\"HF\", f\"login() no disponible: {e}\")\n","                try:\n","                    from huggingface_hub.hf_api import HfFolder\n","                    HfFolder.save_token(token)\n","                    _log_event(\"HF\", \"Token guardado con HfFolder.save_token()\")\n","                except Exception as e2:\n","                    _log_event(\"ERROR\", f\"No se pudo guardar token HF: {e2}\")\n","        else:\n","            os.environ.setdefault(\"HF_HUB_DISABLE_IMPLICIT_TOKEN\", \"1\")\n","            _log_event(\"HF\", \"Modo público sin token (implícito desactivado)\")\n","    except Exception as e:\n","        _log_event(\"ERROR\", f\"Parche HF falló: {e}\")\n","\n","_patch_hf_colab_warning_and_auth()\n","# ==================== Fin Parche HF (silencioso y opcional) ====================\n","\n","# ---------- Hooks opcionales (fallbacks suaves) ----------\n","if \"get_runtime_state\" not in globals():\n","    def get_runtime_state() -> Dict[str, Any]:\n","        return {\"heartbeat\": _now_iso(), \"note\": \"fallback_state\"}\n","if \"restore_runtime_state\" not in globals():\n","    def restore_runtime_state(state: Dict[str, Any]) -> None:\n","        _log_event(\"RESTORE\", \"restore_runtime_state(default): sin-op (personaliza si quieres)\")\n","if \"close_all_http_sessions\" not in globals():\n","    async def close_all_http_sessions():\n","        return\n","\n","# ---------- Checkpointer ----------\n","class _Checkpointer:\n","    def __init__(self, path: str = CHECKPOINT_JSON):\n","        self.path = path\n","    def load(self) -> Optional[Dict[str, Any]]:\n","        try:\n","            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n","                ck = json.load(f)\n","            _log_event(\"LOAD\", f\"Checkpoint cargado: {self.path}\")\n","            return ck\n","        except FileNotFoundError:\n","            _log_event(\"LOAD\", \"Sin checkpoint previo\")\n","            return None\n","        except Exception as e:\n","            _log_event(\"ERROR\", f\"Error cargando checkpoint: {e}\")\n","            return None\n","    def save(self, state: Dict[str, Any]) -> None:\n","        tmp = self.path + \".tmp\"\n","        try:\n","            with open(tmp, \"w\", encoding=\"utf-8\") as f:\n","                json.dump(state, f, ensure_ascii=False, indent=2)\n","            os.replace(tmp, self.path)\n","            _log_event(\"SAVE\", f\"Checkpoint actualizado: {self.path}\")\n","        except Exception as e:\n","            _log_event(\"ERROR\", f\"Error guardando checkpoint: {e}\")\n","\n","CHECKPOINTER = _Checkpointer()\n","\n","# ---------- Guardado periódico ----------\n","class _PeriodicSaver:\n","    def __init__(self, every: int = int(os.getenv(\"TTDVI_CHECKPOINT_EVERY_SEC\", \"180\"))):\n","        self.interval = max(30, every)\n","        self._task: Optional[asyncio.Task] = None\n","        self._stop = asyncio.Event()\n","    async def _loop(self):\n","        _log_event(\"INFO\", f\"PeriodicSaver cada {self.interval}s\")\n","        while not self._stop.is_set():\n","            try:\n","                await asyncio.wait_for(self._stop.wait(), timeout=self.interval)\n","            except asyncio.TimeoutError:\n","                try:\n","                    CHECKPOINTER.save({\"state\": get_runtime_state(), \"ts\": _now_iso()})\n","                except Exception as e:\n","                    _log_event(\"ERROR\", f\"PeriodicSaver save: {e}\")\n","        _log_event(\"INFO\", \"PeriodicSaver detenido\")\n","    def start(self):\n","        if self._task is None or self._task.done():\n","            self._stop.clear()\n","            self._task = asyncio.create_task(self._loop())\n","    async def stop(self):\n","        self._stop.set()\n","        if self._task:\n","            try:\n","                await asyncio.wait_for(self._task, timeout=5)\n","            except Exception:\n","                pass\n","\n","PERIODIC_SAVER = _PeriodicSaver()\n","\n","# ---------- Señales / atexit ----------\n","_shutdown_called = False\n","def _handle_signal(sig, frame):\n","    global _shutdown_called\n","    if _shutdown_called: return\n","    _shutdown_called = True\n","    _log_event(\"SIGNAL\", f\"Señal {sig}: guardando estado...\")\n","    try:\n","        CHECKPOINTER.save({\"state\": get_runtime_state(), \"ts\": _now_iso(), \"signal\": str(sig)})\n","    except Exception as e:\n","        _log_event(\"ERROR\", f\"Signal save error: {e}\")\n","\n","for _sig in (getattr(signal, \"SIGTERM\", None), getattr(signal, \"SIGINT\", None)):\n","    if _sig:\n","        try:\n","            signal.signal(_sig, _handle_signal)\n","        except Exception:\n","            pass\n","\n","@atexit.register\n","def _on_exit():\n","    try:\n","        CHECKPOINTER.save({\"state\": get_runtime_state(), \"ts\": _now_iso(), \"at_exit\": True})\n","        _log_event(\"EXIT\", \"Estado guardado en atexit\")\n","    except Exception as e:\n","        _log_event(\"ERROR\", f\"atexit save error: {e}\")\n","\n","# ---------- Supervisor principal ----------\n","async def run_with_resilience(main_coro_factory: Callable[[], Awaitable[Any]]):\n","    _pp = print_results_panel\n","    # 0 => infinitos reintentos (cambio permanente)\n","    try:\n","        mr_env = os.getenv(\"TTDVI_MAX_RETRIES_PER_SESSION\", \"0\")\n","        max_retries = int(mr_env)\n","    except Exception:\n","        max_retries = 0\n","    base = int(os.getenv(\"TTDVI_BACKOFF_BASE_SEC\", \"5\"))\n","    backoff_max = int(os.getenv(\"TTDVI_BACKOFF_MAX_SEC\", \"300\"))\n","    never_stop = str(os.getenv(\"TTDVI_NEVER_STOP\", \"1\")).strip().lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","\n","    ck = CHECKPOINTER.load()\n","    if ck and isinstance(ck, dict) and \"state\" in ck:\n","        try:\n","            restore_runtime_state(ck[\"state\"])\n","            _log_event(\"RESTORE\", \"Estado restaurado desde checkpoint\")\n","            if _is_verbose(): _pp({\"restored\": True}, title=\"Checkpoint\", etapa=\"restore\")\n","        except Exception as e:\n","            _log_event(\"ERROR\", f\"Restore falló: {e}\")\n","\n","    attempt = 0\n","    PERIODIC_SAVER.start()\n","\n","    while True:\n","        attempt += 1\n","        try:\n","            _log_event(\"START\", f\"Arrancando ciclo (attempt #{attempt})\")\n","            if _is_verbose(): _pp({\"attempt\": attempt}, title=\"Resilience\", etapa=\"start\")\n","            await main_coro_factory()\n","            _log_event(\"DONE\", \"Tarea principal finalizó sin error\")\n","            if _is_verbose(): _pp({\"attempt\": attempt, \"status\": \"done\"}, title=\"Resilience\", etapa=\"done\")\n","            # relanzar incluso tras éxito si NEVER_STOP\n","            if not never_stop:\n","                break\n","            else:\n","                delay = min(backoff_max, base)\n","                _log_event(\"SLEEP\", f\"Relanzando en {delay}s (NEVER_STOP)\")\n","                await asyncio.sleep(delay)\n","                continue\n","        except asyncio.CancelledError:\n","            _log_event(\"CANCEL\", \"Tarea cancelada\")\n","            if _is_verbose(): _pp({\"attempt\": attempt}, title=\"Resilience\", etapa=\"cancel\")\n","            if not never_stop:\n","                break\n","            else:\n","                delay = min(backoff_max, base)\n","                _log_event(\"SLEEP\", f\"Relanzando tras cancelación en {delay}s (NEVER_STOP)\")\n","                try:\n","                    await asyncio.sleep(delay)\n","                except Exception:\n","                    pass\n","                continue\n","        except Exception as e:\n","            _log_event(\"ERROR\", f\"Fallo ciclo: {e}\", traceback=traceback.format_exc())\n","            if _is_verbose(): _pp({\"attempt\": attempt, \"error\": str(e)}, title=\"Resilience\", etapa=\"error\")\n","            # solo se corta por límite si max_retries>0\n","            if max_retries > 0 and attempt >= max_retries:\n","                _log_event(\"FATAL\", \"Máximo de reintentos alcanzado\")\n","                if _is_verbose(): _pp({\"attempt\": attempt}, title=\"Resilience\", etapa=\"fatal\")\n","                if not never_stop:\n","                    break\n","                else:\n","                    attempt = 0  # reinicia contador y continúa infinitamente\n","            delay = min(backoff_max, base * (2 ** (attempt - 1)))\n","            _log_event(\"SLEEP\", f\"Reintentando en {delay}s\")\n","            try:\n","                await asyncio.sleep(delay)\n","            except Exception:\n","                pass\n","        finally:\n","            try:\n","                CHECKPOINTER.save({\"state\": get_runtime_state(), \"ts\": _now_iso(), \"attempt\": attempt})\n","                await close_all_http_sessions()\n","            except Exception as e:\n","                _log_event(\"ERROR\", f\"Cierre/save post-ciclo: {e}\")\n","\n","    try:\n","        await PERIODIC_SAVER.stop()\n","    except Exception:\n","        pass\n","    _log_event(\"END\", \"Supervisor finalizado\")\n","\n","# ---------- Lanzador seguro (script vs notebook) ----------\n","def _run_async_safely(coro: Awaitable[Any]):\n","    _pp = print_results_panel\n","    try:\n","        return asyncio.run(coro)\n","    except RuntimeError:\n","        try:\n","            loop = asyncio.get_event_loop()\n","        except Exception:\n","            loop = asyncio.new_event_loop(); asyncio.set_event_loop(loop)\n","        if loop.is_running():\n","            fut = asyncio.ensure_future(coro)\n","            _log_event(\"INFO\", \"Loop activo (notebook). Tarea agendada.\")\n","            if _is_verbose(): _pp({\"nota\": \"loop ya activo\"}, title=\"Autorun\", etapa=\"notebook\")\n","            return fut\n","        else:\n","            return loop.run_until_complete(coro)\n","\n","# ---------- Autodescubridor de tu 'main' ----------\n","def _find_main_coro_factory() -> Callable[[], Awaitable[Any]]:\n","    _pp = print_results_panel\n","    g = globals()\n","\n","    if \"run_loop_principal\" in g and inspect.iscoroutinefunction(g[\"run_loop_principal\"]):\n","        async def _factory(_pp=_pp):\n","            return await g[\"run_loop_principal\"]()\n","        _log_event(\"INFO\", \"Main detectado: run_loop_principal\")\n","        if _is_verbose(): _pp({\"main\": \"run_loop_principal\"}, title=\"MainDetectado\")\n","        return _factory\n","\n","    if \"boot_darwin_v4_stack\" in g and inspect.iscoroutinefunction(g[\"boot_darwin_v4_stack\"]):\n","        def _maybe(name, default=None): return g[name] if name in g else default\n","        api = _maybe(\"api\") or _maybe(\"API\") or _maybe(\"APIManager\", None)\n","        ultra_executor = _maybe(\"ultra_executor\") or _maybe(\"UltraOrderExecutor\", None)\n","        predictor_alcista = _maybe(\"predictor_alcista\") or _maybe(\"QuantumPredictorAlcista\", None)\n","        predictor_bajista = _maybe(\"predictor_bajista\") or _maybe(\"QuantumPredictorBajista\", None)\n","\n","        class _Dummy: pass\n","        api = api or _Dummy(); ultra_executor = ultra_executor or _Dummy()\n","        predictor_alcista = predictor_alcista or _Dummy(); predictor_bajista = predictor_bajista or _Dummy()\n","\n","        async def _factory(_pp=_pp):\n","            if _is_verbose(): _pp({\"route\": \"boot_darwin_v4_stack\"}, title=\"MainDetectado\")\n","            return await g[\"boot_darwin_v4_stack\"](\n","                api=api, ultra_executor=ultra_executor,\n","                predictor_alcista=predictor_alcista, predictor_bajista=predictor_bajista,\n","                order_executor=_maybe(\"order_executor\"), inteligencia_v3=_maybe(\"inteligencia_v3\"),\n","                pair_alias=os.getenv(\"PAIR_ALIAS\", \"XXBTZUSD\"), pair_rest=os.getenv(\"PAIR_REST\") or None\n","            )\n","        _log_event(\"INFO\", \"Main detectado: boot_darwin_v4_stack\")\n","        return _factory\n","\n","    if \"main_async\" in g and inspect.iscoroutinefunction(g[\"main_async\"]):\n","        async def _factory(_pp=_pp):\n","            if _is_verbose(): _pp({\"main\": \"main_async\"}, title=\"MainDetectado\")\n","            return await g[\"main_async\"]()\n","        _log_event(\"INFO\", \"Main detectado: main_async\")\n","        return _factory\n","\n","    if \"main\" in g and inspect.iscoroutinefunction(g[\"main\"]):\n","        async def _factory(_pp=_pp):\n","            if _is_verbose(): _pp({\"main\": \"main\"}, title=\"MainDetectado\")\n","            return await g[\"main\"]()\n","        _log_event(\"INFO\", \"Main detectado: main\")\n","        return _factory\n","\n","    async def _demo(_pp=_pp):\n","        _log_event(\"DEMO\", \"No se detectó main; corriendo demo 6s (valida resiliencia)\")\n","        if _is_verbose(): _pp({\"demo\": True}, title=\"MainDetectado\")\n","        for i in range(6):\n","            await asyncio.sleep(1)\n","            CHECKPOINTER.save({\"state\": get_runtime_state(), \"ts\": _now_iso(), \"demo_tick\": i+1})\n","        _log_event(\"DEMO\", \"Demo finalizada\")\n","    _log_event(\"WARN\", \"No se encontró ejecutor; usa nombres estándar o crea _main_factory()\")\n","    return _demo\n","\n","# ---------- API de arranque público ----------\n","async def TTDVI_resilience_autorun():\n","    _pp = print_results_panel  # capturado\n","    factory = _find_main_coro_factory()\n","    if _is_verbose(): _pp({\"autorun\": True}, title=\"Autorun\", etapa=\"pre-run\")\n","    await run_with_resilience(factory)\n","\n","# ---------- Auto-run controlable por ENV ----------\n","if os.getenv(\"TTDVI_AUTORUN\", \"1\") == \"1\" and not globals().get(\"_TTDVI156_RESILIENCE_STARTED\", False):\n","    globals()[\"_TTDVI156_RESILIENCE_STARTED\"] = True\n","    try:\n","        _run_async_safely(TTDVI_resilience_autorun())\n","    except Exception as e:\n","        _log_event(\"ERROR\", f\"Autorun falló: {e}\")\n","\n","# =============================================================================\n","# ======================== FIN — RESILIENCIA COLAB ============================\n","# =============================================================================\n","\n","# =================== FIX PERMANENTE: CONFIG BLOQUE SEGURO ===================\n","# Reemplaza la línea con comas por este bloque. Idempotente y con lectura de ENV.\n","\n","import os\n","\n","def _env_bool(name: str, default: bool) -> bool:\n","    v = os.getenv(name, str(int(default))).strip().lower()\n","    return v in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","\n","def _env_int(name: str, default: int) -> int:\n","    try:\n","        return int(os.getenv(name, str(default)).strip())\n","    except Exception:\n","        return default\n","\n","def _env_float(name: str, default: float) -> float:\n","    try:\n","        return float(os.getenv(name, str(default)).strip())\n","    except Exception:\n","        return default\n","\n","def _env_str(name: str, default: str) -> str:\n","    v = os.getenv(name)\n","    return v.strip() if isinstance(v, str) and v.strip() else default\n","\n","# ------- Asignaciones limpias (una por línea, sin comas) -------\n","TTDVI_AUTORUN      = _env_bool (\"TTDVI_AUTORUN\",      True)   # 1/0, true/false\n","TTDVI_NEVER_STOP   = _env_bool (\"TTDVI_NEVER_STOP\",   True)\n","PAR_TRADING        = _env_str  (\"PAR_TRADING\",        \"XXBTZUSD\")  # Kraken canónico\n","INTERVAL_MIN       = _env_int  (\"INTERVAL_MIN\",       1)      # ventana de render/datos en minutos\n","MODEL_INPUT_WINDOW = _env_int  (\"MODEL_INPUT_WINDOW\", 60)     # muestras para el modelo\n","RETRO_HOURS        = _env_int  (\"RETRO_HOURS\",        24)     # histórico para retro\n","SENT_INTERVAL      = _env_int  (\"SENT_INTERVAL\",      15)     # minutos para gauge de sentimiento\n","RENDER_LOOP        = _env_bool (\"RENDER_LOOP\",        False)  # loop de render en vivo\n","RENDER_EVERY       = _env_int  (\"RENDER_EVERY\",       60)     # segundos entre renders\n","REAL               = _env_bool (\"REAL\",               False)  # modo real (True) o demo (False)\n","GOAL_MIN_PROFIT    = _env_float(\"GOAL_MIN_PROFIT\",    1.56)   # objetivo 156% como razón\n","\n","# ------- Compatibilidad (si alguna parte espera ints en vez de bools) -------\n","RENDER_LOOP_INT = 1 if RENDER_LOOP else 0\n","REAL_INT        = 1 if REAL        else 0\n","\n","# ------- Validaciones suaves (no rompen ejecución) -------\n","if not PAR_TRADING:\n","    PAR_TRADING = \"XXBTZUSD\"\n","if MODEL_INPUT_WINDOW <= 0:\n","    MODEL_INPUT_WINDOW = 60\n","if INTERVAL_MIN <= 0:\n","    INTERVAL_MIN = 1\n","if RETRO_HOURS <= 0:\n","    RETRO_HOURS = 24\n","if SENT_INTERVAL <= 0:\n","    SENT_INTERVAL = 15\n","if RENDER_EVERY <= 0:\n","    RENDER_EVERY = 60\n","\n","# ------- Config dict (por si quieres inyectarlo como paquete de settings) -------\n","TTDVI_CONFIG = {\n","    \"TTDVI_AUTORUN\": TTDVI_AUTORUN,\n","    \"TTDVI_NEVER_STOP\": TTDVI_NEVER_STOP,\n","    \"PAR_TRADING\": PAR_TRADING,\n","    \"INTERVAL_MIN\": INTERVAL_MIN,\n","    \"MODEL_INPUT_WINDOW\": MODEL_INPUT_WINDOW,\n","    \"RETRO_HOURS\": RETRO_HOURS,\n","    \"SENT_INTERVAL\": SENT_INTERVAL,\n","    \"RENDER_LOOP\": RENDER_LOOP,\n","    \"RENDER_EVERY\": RENDER_EVERY,\n","    \"REAL\": REAL,\n","    \"GOAL_MIN_PROFIT\": GOAL_MIN_PROFIT,\n","    \"RENDER_LOOP_INT\": RENDER_LOOP_INT,\n","    \"REAL_INT\": REAL_INT,\n","}\n","# ============================================================================\n","\n","# =================== SELF-TEST TTDVI156 (ARRANQUE SEGURO) ===================\n","import os, json, logging\n","from datetime import datetime\n","from pathlib import Path\n","\n","# Logger único (no duplica handlers si reimportas)\n","_logger = logging.getLogger(\"TTDVI_SELFTEST\")\n","if not _logger.handlers:\n","    _level = logging.INFO\n","    try:\n","        # Permite override por ENV: TTDVI_LOGLEVEL=DEBUG|INFO|WARNING|ERROR\n","        _level = getattr(logging, os.getenv(\"TTDVI_LOGLEVEL\",\"INFO\").upper(), logging.INFO)\n","    except Exception:\n","        _level = logging.INFO\n","    _handler = logging.StreamHandler()\n","    _handler.setFormatter(logging.Formatter(\"%(asctime)s | %(levelname)s | %(message)s\"))\n","    _logger.setLevel(_level)\n","    _logger.addHandler(_handler)\n","\n","def _yesno(v: bool) -> str:\n","    return \"ON\" if bool(v) else \"OFF\"\n","\n","def _env_overrides(keys):\n","    \"\"\"Devuelve dict solo con variables de entorno que realmente se usaron para override.\"\"\"\n","    out = {}\n","    for k in keys:\n","        if os.getenv(k) is not None:\n","            out[k] = os.getenv(k)\n","    return out\n","\n","def ttdvi_self_test() -> dict:\n","    \"\"\"Valida config efectiva, muestra overrides y guarda un snapshot de estado.\"\"\"\n","    ts = datetime.utcnow().strftime(\"%Y-%m-%d %H:%M:%S UTC\")\n","    warnings_list = []\n","    notes = []\n","\n","    # --- Config efectiva esperada desde el bloque anterior ---\n","    cfg = dict(TTDVI_CONFIG) if \"TTDVI_CONFIG\" in globals() else {\n","        \"TTDVI_AUTORUN\": globals().get(\"TTDVI_AUTORUN\", True),\n","        \"TTDVI_NEVER_STOP\": globals().get(\"TTDVI_NEVER_STOP\", True),\n","        \"PAR_TRADING\": globals().get(\"PAR_TRADING\", \"XXBTZUSD\"),\n","        \"INTERVAL_MIN\": globals().get(\"INTERVAL_MIN\", 1),\n","        \"MODEL_INPUT_WINDOW\": globals().get(\"MODEL_INPUT_WINDOW\", 60),\n","        \"RETRO_HOURS\": globals().get(\"RETRO_HOURS\", 24),\n","        \"SENT_INTERVAL\": globals().get(\"SENT_INTERVAL\", 15),\n","        \"RENDER_LOOP\": globals().get(\"RENDER_LOOP\", False),\n","        \"RENDER_EVERY\": globals().get(\"RENDER_EVERY\", 60),\n","        \"REAL\": globals().get(\"REAL\", False),\n","        \"GOAL_MIN_PROFIT\": globals().get(\"GOAL_MIN_PROFIT\", 1.56),\n","        \"RENDER_LOOP_INT\": 1 if globals().get(\"RENDER_LOOP\", False) else 0,\n","        \"REAL_INT\": 1 if globals().get(\"REAL\", False) else 0,\n","    }\n","\n","    # --- Validaciones suaves ---\n","    if not isinstance(cfg[\"PAR_TRADING\"], str) or not cfg[\"PAR_TRADING\"].strip():\n","        warnings_list.append(\"PAR_TRADING vacío/incorrecto; usando 'XXBTZUSD'.\")\n","        cfg[\"PAR_TRADING\"] = \"XXBTZUSD\"\n","\n","    if int(cfg[\"INTERVAL_MIN\"]) <= 0:\n","        warnings_list.append(\"INTERVAL_MIN <= 0; reajustado a 1.\")\n","        cfg[\"INTERVAL_MIN\"] = 1\n","\n","    if int(cfg[\"MODEL_INPUT_WINDOW\"]) <= 0:\n","        warnings_list.append(\"MODEL_INPUT_WINDOW <= 0; reajustado a 60.\")\n","        cfg[\"MODEL_INPUT_WINDOW\"] = 60\n","\n","    if int(cfg[\"RETRO_HOURS\"]) <= 0:\n","        warnings_list.append(\"RETRO_HOURS <= 0; reajustado a 24.\")\n","        cfg[\"RETRO_HOURS\"] = 24\n","\n","    if int(cfg[\"SENT_INTERVAL\"]) <= 0:\n","        warnings_list.append(\"SENT_INTERVAL <= 0; reajustado a 15.\")\n","        cfg[\"SENT_INTERVAL\"] = 15\n","\n","    if int(cfg[\"RENDER_EVERY\"]) <= 0:\n","        warnings_list.append(\"RENDER_EVERY <= 0; reajustado a 60.\")\n","        cfg[\"RENDER_EVERY\"] = 60\n","\n","    if float(cfg[\"GOAL_MIN_PROFIT\"]) < 1.0:\n","        warnings_list.append(\"GOAL_MIN_PROFIT < 1.0; recuerda que 1.56 = +56% (target 156% del capital base).\")\n","\n","    # Notas informativas\n","    notes.append(f\"MODO REAL: {_yesno(cfg['REAL'])} | RENDER LOOP: {_yesno(cfg['RENDER_LOOP'])}\")\n","    notes.append(\"Si tu pipeline espera enteros para flags, usa REAL_INT y RENDER_LOOP_INT incluidos en la config.\")\n","\n","    # Overrides detectados (solo lo que de verdad venía de ENV)\n","    env_keys = [\n","        \"TTDVI_AUTORUN\",\"TTDVI_NEVER_STOP\",\"PAR_TRADING\",\"INTERVAL_MIN\",\"MODEL_INPUT_WINDOW\",\n","        \"RETRO_HOURS\",\"SENT_INTERVAL\",\"RENDER_LOOP\",\"RENDER_EVERY\",\"REAL\",\"GOAL_MIN_PROFIT\"\n","    ]\n","    overrides = _env_overrides(env_keys)\n","\n","    # Logging resumen\n","    _logger.info(\"========= TTDVI156 SELF-TEST =========\")\n","    _logger.info(\"Timestamp: %s\", ts)\n","    _logger.info(\"Config efectiva: %s\", json.dumps(cfg, ensure_ascii=False))\n","    if overrides:\n","        _logger.info(\"Overrides por ENV: %s\", json.dumps(overrides, ensure_ascii=False))\n","    else:\n","        _logger.info(\"Overrides por ENV: (ninguno)\")\n","    for w in warnings_list:\n","        _logger.warning(\"WARN: %s\", w)\n","    for n in notes:\n","        _logger.info(\"NOTE: %s\", n)\n","    _logger.info(\"======================================\")\n","\n","    # Persistencia opcional (no falla si no puede escribir)\n","    snapshot = {\n","        \"timestamp\": ts,\n","        \"config\": cfg,\n","        \"env_overrides\": overrides,\n","        \"warnings\": warnings_list,\n","        \"notes\": notes,\n","        \"status\": \"OK\" if not warnings_list else \"OK_WITH_WARNINGS\",\n","    }\n","    try:\n","        run_root = os.getenv(\"TTDVI_RUN_ROOT\", \"./run_ttdvi156\")\n","        state_dir = Path(run_root) / \"state\"\n","        state_dir.mkdir(parents=True, exist_ok=True)\n","        with open(state_dir / \"last_selftest.json\", \"w\", encoding=\"utf-8\") as f:\n","            json.dump(snapshot, f, ensure_ascii=False, indent=2)\n","    except Exception as e:\n","        _logger.debug(\"No se pudo escribir snapshot de self-test: %s\", e)\n","\n","    return snapshot\n","\n","# Ejecuta self-test automáticamente salvo que TTDVI_SELFTEST=0|false|no\n","if os.getenv(\"TTDVI_SELFTEST\", \"1\").strip().lower() not in (\"0\",\"false\",\"no\"):\n","    try:\n","        _ = ttdvi_self_test()\n","    except Exception as e:\n","        _logger.error(\"SELF-TEST falló inesperadamente: %s\", e)\n","# ============================================================================\n","\n","# ============== FIN DEL BLOQUE DE CONFIG + SELF-TEST (LISTO) ===============\n","\n","# ===================== PARCHE DE INTEGRACIÓN ULTRA ↔ DARWIN v4 (LISTO PARA CORRER) =====================\n","# Requisitos previos cargados arriba:\n","#  - APIManager (tu sección API 100% real)\n","#  - UltraOrderExecutor (el ULTRA ORDER EXECUTOR UNIFICADO que te compartí)\n","# Este parche solo cablea nombres/objetos que tu ejecutador Darwin v4 espera y asegura compatibilidad total.\n","\n","import os, asyncio, time\n","from decimal import Decimal\n","from datetime import datetime, timezone\n","\n","# --------- Defaults mínimos para variables críticas si no vienen del entorno ---------\n","os.environ.setdefault(\"ULTRA_PARES\", \"XXBTZUSD,XXBTZEUR\")\n","os.environ.setdefault(\"SPREAD_TARGET\", \"0.02\")       # 2% spread para arbitraje\n","os.environ.setdefault(\"VOL_ARBITRAGE_ON\", \"1\")       # arbitraje activo\n","os.environ.setdefault(\"BASE_VOLUME\", \"0.001\")\n","os.environ.setdefault(\"INTERVAL_MIN\", \"1\")\n","os.environ.setdefault(\"MODEL_INPUT_WINDOW\", \"60\")\n","os.environ.setdefault(\"FUTUROS_MODE\", \"1\")\n","os.environ.setdefault(\"MAX_LEVERAGE_XX\", \"1.56\")\n","os.environ.setdefault(\"ALLOW_PUBLIC_MODE\", \"1\")\n","os.environ.setdefault(\"KRAKEN_REQUIRE_KEYS\", \"0\")\n","\n","# --------- Compatibilidad de nombres y helpers que el ejecutador asume ---------\n","def _env_bool(v, default=False):\n","    if v is None: return default\n","    return str(v).strip().lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","\n","# Exponer cfg() si no existe (tu ejecutador define otra, pero por si alguien importa este parche aparte)\n","if \"cfg\" not in globals():\n","    def cfg(key: str, default=None):\n","        v = os.getenv(key)\n","        if v is None: return default\n","        try:\n","            if isinstance(default, bool):  # coerces\n","                return _env_bool(v, default)\n","            return type(default)(v) if default is not None else v\n","        except Exception:\n","            return v\n","\n","# --------- Predictor base mínimo (el ejecutador luego lo reemplaza por los “enchufados”) ---------\n","class _PredictorMinimo:\n","    async def entrenar_modelo_inicial(self): return True\n","    async def predecir_ajustada(self, current_price: float) -> float:\n","        # Señal neutra (el ejecutador la ajusta con sentimiento/momentum luego)\n","        return 0.0\n","    async def predecir_precio_futuro(self) -> float:\n","        return float(current_price) if (current_price := 0.0) else 0.0\n","\n","# --------- QuantumTradingCore mínimo, seguro y compatible con UltraOrderExecutor ---------\n","class QuantumTradingCore:\n","    def __init__(self, api):\n","        self.api = api\n","        # Dos predictores placeholders (el runner los “cablea” con sentimiento/momentum más adelante)\n","        self.predictor_alcista = _PredictorMinimo()\n","        self.predictor_bajista = _PredictorMinimo()\n","        # Para compat con integraciones que esperan 'predictor' (el UltraOrderExecutor usa 1 predictor)\n","        self.predictor = self.predictor_alcista\n","        # El ejecutor real se inyecta en el runner\n","        self.order_executor = None\n","        # Monitor mínimo (el runner hace prefetch propio)\n","        self.market_monitor = type(\"M\", (), {\"price_history\": []})()\n","        # Parámetros por entorno\n","        self.interval_min = int(os.getenv(\"INTERVAL_MIN\", \"1\"))\n","        self.input_window = int(os.getenv(\"MODEL_INPUT_WINDOW\", \"60\"))\n","\n","    async def initialize(self):\n","        # Si tus predictores reales tienen initialize(), no estorba:\n","        for p in (self.predictor_alcista, self.predictor_bajista):\n","            if hasattr(p, \"initialize\") and asyncio.iscoroutinefunction(p.initialize):\n","