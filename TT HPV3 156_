           X = _np.asarray(X, dtype=_np.float64)\n","            if X.ndim == 1: X = X.reshape(-1, 1)\n","            y = X @ _np.asarray(self.coef_).T\n","            out = y + self.intercept_\n","            _ttdvi_notify_data(); return out\n","\n","    _lin_mod = _types.ModuleType(\"sklearn.linear_model\")\n","    _lin_mod.LinearRegression = _LinearRegressionShim\n","\n","    _ms_mod = _types.ModuleType(\"sklearn.model_selection\")\n","    def train_test_split(*arrays, test_size=None, train_size=None, random_state=None, shuffle=True, stratify=None):\n","        rng = _np.random.RandomState(None if random_state is None else random_state)\n","        if not arrays: return []\n","        n = len(arrays[0])\n","        for a in arrays:\n","            if len(a) != n:\n","                raise ValueError(\"All input arrays must have the same length.\")\n","        if test_size is None and train_size is None:\n","            test_size = 0.25\n","        if test_size is None:\n","            test_size = 1.0 - float(train_size)\n","        ts = int(round(test_size * n)) if isinstance(test_size, float) else int(test_size)\n","        idx = _np.arange(n)\n","        if shuffle: rng.shuffle(idx)\n","        test_idx = idx[:ts]; train_idx = idx[ts:]\n","        out = []\n","        for a in arrays:\n","            a = _np.asarray(a)\n","            out.append(a[train_idx]); out.append(a[test_idx])\n","        return out\n","    _ms_mod.train_test_split = train_test_split\n","\n","    _sk_mod = _types.ModuleType(\"sklearn\")\n","    _sk_mod.__version__ = \"0.0-shim\"\n","    _sk_mod._IS_SHIM = True\n","    _sk_mod._config = {\"assume_finite\": True}\n","    def get_config(): return dict(_sk_mod._config)\n","    def set_config(**kw): _sk_mod._config.update(kw)\n","    class _config_context:\n","        def __init__(self, **kw): self.kw = kw; self._old = None\n","        def __enter__(self): self._old = dict(_sk_mod._config); _sk_mod._config.update(self.kw)\n","        def __exit__(self, *exc): _sk_mod._config = self._old\n","    _sk_mod.get_config = get_config\n","    _sk_mod.set_config = set_config\n","    _sk_mod.config_context = _config_context\n","\n","    _sk_mod.preprocessing = _pre_mod\n","    _sk_mod.linear_model = _lin_mod\n","    _sk_mod.utils = _utils_mod\n","    _sk_mod.model_selection = _ms_mod\n","\n","    _sys.modules.setdefault(\"sklearn\", _sk_mod)\n","    _sys.modules[\"sklearn.preprocessing\"] = _pre_mod\n","    _sys.modules[\"sklearn.linear_model\"] = _lin_mod\n","    _sys.modules[\"sklearn.utils\"] = _utils_mod\n","    _sys.modules[\"sklearn.model_selection\"] = _ms_mod\n","\n","    _SKLEARN_OK = True\n","    _SKLEARN_IS_SHIM = True\n","    if not _SKLEARN_WHY:\n","        _SKLEARN_WHY = \"shim instalado\"\n","\n","def _try_import_sklearn_with_timeout(seconds: int = 6):\n","    import threading\n","    global _SKLEARN_OK, _SKLEARN_IS_SHIM, _SKLEARN_WHY\n","\n","    if \"sklearn\" in _sys.modules and not getattr(_sys.modules[\"sklearn\"], \"_IS_SHIM\", False):\n","        try:\n","            from sklearn.linear_model import LinearRegression as _LR_OK  # noqa\n","            from sklearn.preprocessing import StandardScaler as _SS_OK  # noqa\n","            _SKLEARN_OK = True; _SKLEARN_IS_SHIM = False; _SKLEARN_WHY = \"ok (ya estaba cargado)\"\n","            return\n","        except Exception as e:\n","            _SKLEARN_WHY = f\"módulo ya cargado pero no usable: {e}\"\n","\n","    if _os.getenv(\"SKLEARN_ALLOW_REAL\",\"1\").strip().lower() not in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\"):\n","        _SKLEARN_WHY = \"SKLEARN_ALLOW_REAL=0 → shim forzado\"; _install_sklearn_shims(); return\n","\n","    try:\n","        import signal\n","        class _Timeout(Exception): pass\n","        def _handler(signum, frame): raise _Timeout(\"sklearn import timeout\")\n","        old = signal.signal(signal.SIGALRM, _handler)\n","        signal.alarm(seconds)\n","        try:\n","            import sklearn  # noqa\n","            from sklearn.linear_model import LinearRegression as _LR_OK  # noqa\n","            from sklearn.preprocessing import StandardScaler as _SS_OK  # noqa\n","            _SKLEARN_OK = True; _SKLEARN_IS_SHIM = False; _SKLEARN_WHY = \"ok\"; return\n","        except _Timeout as e: _SKLEARN_WHY = f\"timeout {seconds}s: {e}\"\n","        except KeyboardInterrupt as e: _SKLEARN_WHY = f\"KeyboardInterrupt durante import: {e}\"\n","        except Exception as e: _SKLEARN_WHY = str(e)\n","        finally:\n","            signal.alarm(0); signal.signal(signal.SIGALRM, old)\n","    except Exception:\n","        _done = {\"ok\": False, \"err\": None}\n","        def _worker():\n","            try:\n","                import sklearn  # noqa\n","                from sklearn.linear_model import LinearRegression as _LR_OK  # noqa\n","                from sklearn.preprocessing import StandardScaler as _SS_OK  # noqa\n","                _done[\"ok\"] = True\n","            except Exception as e:\n","                _done[\"err\"] = e\n","        t = threading.Thread(target=_worker, daemon=True); t.start(); t.join(seconds)\n","        if _done[\"ok\"]:\n","            _SKLEARN_OK = True; _SKLEARN_IS_SHIM = False; _SKLEARN_WHY = \"ok\"; return\n","        else:\n","            _SKLEARN_WHY = str(_done[\"err\"]) if _done[\"err\"] is not None else f\"timeout {seconds}s (thread)\"\n","\n","    _install_sklearn_shims()\n","\n","_try_import_sklearn_with_timeout(seconds=int(_os.getenv(\"SKLEARN_IMPORT_TIMEOUT_SEC\", \"6\")))\n","\n","try:\n","    if _SKLEARN_IS_SHIM:\n","        if not _SHIM_QUIET:\n","            print(\"⚠️  sklearn no disponible/colgado. Se activaron SHIMS (LinearRegression/StandardScaler/train_test_split).\")\n","            if _SKLEARN_WHY: print(f\"   Detalle: {_SKLEARN_WHY}\")\n","    else:\n","        if not _SHIM_QUIET:\n","            print(\"✅ sklearn OK (import rápido).\")\n","except Exception:\n","    pass\n","\n","# ==================== FIN SKLEARN RESILIENTE =====================================================\n","\n","# =============================================================================\n","# ================== SECCIÓN ÚNICA — RESILIENCIA COLAB (TTDVI156) =============\n","# =============================================================================\n","# - PT-only para Transformers (monkey-patch): NO TF/JAX jamás → sin errores TF*\n","# - HF_TOKEN silencioso: sin login(), sin WARNING; guardado con HfFolder\n","# - Supervisor resiliente infinito + checkpoints + señales/atexit\n","# - Totalmente ENCHUFADA con las secciones previas (autorun/fallback/heartbeat)\n","# - Blindaje PERMANENTE run_loop: proxy dict + normalización cfg/state/flags\n","# =============================================================================\n","\n","import os, sys, json, time, asyncio, signal, atexit, traceback, inspect, importlib, logging, warnings, re, contextlib\n","from typing import Any, Callable, Awaitable, Optional, Dict\n","from datetime import datetime, timezone\n","\n","# ---------- Parche permanente: entorno PyTorch-only para Transformers ----------\n","os.environ.setdefault(\"TRANSFORMERS_NO_TF_WARNING\", \"1\")\n","os.environ.setdefault(\"DISABLE_MLFLOW_INTEGRATION\", \"1\")\n","os.environ.setdefault(\"HF_HUB_DISABLE_TELEMETRY\", \"1\")\n","os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"0\")\n","os.environ.setdefault(\"TOKENIZERS_PARALLELISM\", \"false\")\n","os.environ.setdefault(\"USE_TORCH\", \"1\")\n","os.environ.setdefault(\"USE_TF\", \"0\")\n","os.environ.setdefault(\"USE_JAX\", \"0\")\n","os.environ.setdefault(\"USE_FLAX\", \"0\")\n","\n","# Silenciar el WARNING del login de HF\n","logging.getLogger(\"huggingface_hub._login\").setLevel(logging.CRITICAL)\n","\n","# Monkey-patch: Transformers cree que NO hay TF/JAX y SÍ Torch\n","try:\n","    _iu = importlib.import_module(\"transformers.utils.import_utils\")\n","    if getattr(_iu, \"_TTDVI_PT_ONLY_PATCH\", None) is None:\n","        _iu.is_tf_available = lambda: False\n","        _iu.is_flax_available = lambda: False\n","        _iu.is_jax_available = lambda: False\n","        _iu.is_torch_available = lambda: True\n","        _iu._TTDVI_PT_ONLY_PATCH = True\n","except Exception:\n","    pass\n","\n","# Silenciar deprecaciones TF/JAX y ruido de safe_open\n","try:\n","    warnings.filterwarnings(\"ignore\", message=re.compile(r\".*TensorFlow and JAX classes are deprecated.*\"), category=UserWarning)\n","    warnings.filterwarnings(\"ignore\", message=re.compile(r\".*safe_open.*not is iterable|not iterable.*\", re.I), category=UserWarning)\n","except Exception:\n","    pass\n","\n","# ---------- Utilidad de verbosidad ----------\n","def _in_notebook() -> bool:\n","    try:\n","        from IPython import get_ipython\n","        sh = get_ipython()\n","        return bool(sh) and sh.__class__.__name__ in (\"ZMQInteractiveShell\",\"TerminalInteractiveShell\",\"Shell\")\n","    except Exception:\n","        return False\n","\n","def _is_verbose() -> bool:\n","    v = os.getenv(\"TTDVI_VERBOSE\", None)\n","    if v is None:\n","        return False\n","    return str(v).strip().lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","\n","# ---------- Compat autorun ----------\n","if globals().get(\"_TTDVI156_LAUNCHED\", False):\n","    os.environ.setdefault(\"TTDVI_AUTORUN\", \"0\")\n","else:\n","    os.environ.setdefault(\"TTDVI_AUTORUN\", \"1\")\n","\n","# ---------- Nunca parar + ∞ reintentos ----------\n","os.environ.setdefault(\"TTDVI_MAX_RETRIES_PER_SESSION\", \"0\")\n","os.environ.setdefault(\"TTDVI_NEVER_STOP\", \"1\")\n","\n","# ---------- Panel de resultados (fallback silencioso) ----------\n","try:\n","    _prp0 = globals().get(\"print_results_panel\")\n","    if not callable(_prp0):\n","        raise NameError(\"print_results_panel no callable o no existe\")\n","except Exception:\n","    def print_results_panel(data=None, title=\"Resultados\", **meta):\n","        if not _is_verbose(): return\n","        try:\n","            from pprint import pformat\n","            cuerpo = pformat(data, compact=True, width=100)\n","        except Exception:\n","            cuerpo = str(data)\n","        try:\n","            print(f\"\\n── {title} ──\")\n","            if meta: print(\"meta:\", {k: meta[k] for k in sorted(meta)})\n","            print(cuerpo); print(\"──────────────\\n\")\n","        except Exception:\n","            try: sys.stdout.write(f\"[{title}] {cuerpo}\\n\")\n","            except Exception: pass\n","\n","def set_results_panel_printer(fn: Callable):\n","    global print_results_panel\n","    if callable(fn): print_results_panel = fn\n","\n","# ---------- Persistencia ----------\n","def _default_resume_dir() -> str:\n","    drive = \"/content/drive\"\n","    if os.path.isdir(drive):\n","        base = os.path.join(drive, \"MyDrive\", \"ttdvi156_state\")\n","    else:\n","        base = os.path.join(os.getenv(\"TTDVI_RUN_ROOT\", \"./run_ttdvi156\"), \"state\")\n","    os.makedirs(base, exist_ok=True)\n","    return base\n","\n","RESUME_DIR = os.getenv(\"TTDVI_RESUME_DIR\", _default_resume_dir())\n","CHECKPOINT_JSON = os.path.join(RESUME_DIR, \"checkpoint.json\")\n","EVENTLOG_NDJSON = os.path.join(RESUME_DIR, \"eventlog.ndjson\")\n","\n","def _now_iso() -> str:\n","    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%S.%fZ\")\n","\n","def _log_event(kind: str, msg: str, **extra):\n","    rec = {\"ts\": _now_iso(), \"kind\": kind, \"msg\": msg}\n","    if extra: rec.update(extra)\n","    try:\n","        os.makedirs(RESUME_DIR, exist_ok=True)\n","        with open(EVENTLOG_NDJSON, \"a\", encoding=\"utf-8\") as f:\n","            f.write(json.dumps(rec, ensure_ascii=False) + \"\\n\")\n","    except Exception:\n","        pass\n","    print(f\"[{kind}] {rec['ts']} — {msg}\")\n","\n","# ====================== Parche HF (silencioso y opcional) =====================\n","def _patch_hf_colab_warning_and_auth():\n","    try:\n","        warnings.filterwarnings(\"ignore\",\n","            message=r\"The secret `HF_TOKEN` does not exist in your Colab secrets\\.\",\n","            category=UserWarning, module=r\"huggingface_hub\\.utils\\._auth\")\n","        logging.getLogger(\"huggingface_hub._login\").setLevel(logging.CRITICAL)\n","\n","        os.environ.setdefault(\"HF_HUB_DISABLE_TELEMETRY\", \"1\")\n","        os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"0\")\n","        HF_HOME = os.getenv(\"HF_HOME\") or os.path.join(RESUME_DIR, \".hf\")\n","        os.environ[\"HF_HOME\"] = HF_HOME\n","        os.makedirs(HF_HOME, exist_ok=True)\n","\n","        token = (\n","            os.getenv(\"HF_TOKEN\")\n","            or os.getenv(\"HUGGINGFACEHUB_API_TOKEN\")\n","            or os.getenv(\"HUGGING_FACE_HUB_TOKEN\")\n","        )\n","        if token:\n","            try:\n","                from huggingface_hub import HfFolder\n","                HfFolder.save_token(token)\n","                _log_event(\"HF\", \"Token guardado con HfFolder.save_token() (sin login)\")\n","            except Exception as e:\n","                _log_event(\"ERROR\", f\"No se pudo guardar token HF: {e}\")\n","        else:\n","            os.environ.setdefault(\"HF_HUB_DISABLE_IMPLICIT_TOKEN\", \"1\")\n","            _log_event(\"HF\", \"Modo público sin token (implícito desactivado)\")\n","    except Exception as e:\n","        _log_event(\"ERROR\", f\"Parche HF falló: {e}\")\n","\n","_patch_hf_colab_warning_and_auth()\n","# ==================== Fin Parche HF (silencioso y opcional) ====================\n","\n","# ---------- Hooks opcionales (se respetan si ya existen en globals) ----------\n","if \"get_runtime_state\" not in globals():\n","    def get_runtime_state() -> Dict[str, Any]:\n","        hb = globals().get(\"_TTDVI_REG\", {}).get(\"last_hb\", 0.0) if \"_TTDVI_REG\" in globals() else None\n","        return {\"heartbeat\": _now_iso(), \"hb_ts\": hb, \"note\": \"fallback_state\"}\n","if \"restore_runtime_state\" not in globals():\n","    def restore_runtime_state(state: Dict[str, Any]) -> None:\n","        _log_event(\"RESTORE\", \"restore_runtime_state(default): sin-op (personaliza si quieres)\")\n","if \"close_all_http_sessions\" not in globals():\n","    async def close_all_http_sessions():\n","        return\n","\n","# ---------- Checkpointer ----------\n","class _Checkpointer:\n","    def __init__(self, path: str = CHECKPOINT_JSON):\n","        self.path = path\n","    def load(self) -> Optional[Dict[str, Any]]:\n","        try:\n","            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n","                ck = json.load(f)\n","            _log_event(\"LOAD\", f\"Checkpoint cargado: {self.path}\")\n","            return ck\n","        except FileNotFoundError:\n","            _log_event(\"LOAD\", \"Sin checkpoint previo\"); return None\n","        except Exception as e:\n","            _log_event(\"ERROR\", f\"Error cargando checkpoint: {e}\"); return None\n","    def save(self, state: Dict[str, Any]) -> None:\n","        tmp = self.path + \".tmp\"\n","        try:\n","            with open(tmp, \"w\", encoding=\"utf-8\") as f:\n","                json.dump(state, f, ensure_ascii=False, indent=2)\n","            os.replace(tmp, self.path)\n","            _log_event(\"SAVE\", f\"Checkpoint actualizado: {self.path}\")\n","        except Exception as e:\n","            _log_event(\"ERROR\", f\"Error guardando checkpoint: {e}\")\n","\n","CHECKPOINTER = _Checkpointer()\n","\n","# ---------- Guardado periódico ----------\n","class _PeriodicSaver:\n","    def __init__(self, every: int = int(os.getenv(\"TTDVI_CHECKPOINT_EVERY_SEC\", \"180\"))):\n","        self.interval = max(30, every)\n","        self._task: Optional[asyncio.Task] = None\n","        self._stop = asyncio.Event()\n","    async def _loop(self):\n","        _log_event(\"INFO\", f\"PeriodicSaver cada {self.interval}s\")\n","        while not self._stop.is_set():\n","            try:\n","                await asyncio.wait_for(self._stop.wait(), timeout=self.interval)\n","            except asyncio.TimeoutError:\n","                try:\n","                    CHECKPOINTER.save({\"state\": get_runtime_state(), \"ts\": _now_iso()})\n","                except Exception as e:\n","                    _log_event(\"ERROR\", f\"PeriodicSaver save: {e}\")\n","        _log_event(\"INFO\", \"PeriodicSaver detenido\")\n","    def start(self):\n","        if self._task is None or self._task.done():\n","            self._stop.clear()\n","            self._task = asyncio.create_task(self._loop(), name=\"ttdvi_periodic_saver\")\n","    async def stop(self):\n","        self._stop.set()\n","        if self._task:\n","            with contextlib.suppress(Exception):\n","                await asyncio.wait_for(self._task, timeout=5)\n","\n","PERIODIC_SAVER = _PeriodicSaver()\n","\n","# ---------- Señales / atexit ----------\n","_shutdown_called = False\n","def _handle_signal(sig, frame):\n","    global _shutdown_called\n","    if _shutdown_called: return\n","    _shutdown_called = True\n","    _log_event(\"SIGNAL\", f\"Señal {sig}: guardando estado...\")\n","    try:\n","        CHECKPOINTER.save({\"state\": get_runtime_state(), \"ts\": _now_iso(), \"signal\": str(sig)})\n","    except Exception as e:\n","        _log_event(\"ERROR\", f\"Signal save error: {e}\")\n","\n","for _sig in (getattr(signal, \"SIGTERM\", None), getattr(signal, \"SIGINT\", None)):\n","    if _sig:\n","        try: signal.signal(_sig, _handle_signal)\n","        except Exception: pass\n","\n","@atexit.register\n","def _on_exit():\n","    try:\n","        CHECKPOINTER.save({\"state\": get_runtime_state(), \"ts\": _now_iso(), \"at_exit\": True})\n","        _log_event(\"EXIT\", \"Estado guardado en atexit\")\n","    except Exception as e:\n","        _log_event(\"ERROR\", f\"atexit save error: {e}\")\n","\n","# ---------- Core resiliencia (reutiliza si ya existe, si no provee uno) ----------\n","_run_with_resilience_prior = globals().get(\"run_with_resilience\", None)\n","\n","async def _run_with_resilience_builtin(main_coro_factory: Callable[[], Awaitable[Any]]):\n","    \"\"\"Implementación local (solo si no existe una previa).\"\"\"\n","    _pp = print_results_panel\n","    try:\n","        mr_env = os.getenv(\"TTDVI_MAX_RETRIES_PER_SESSION\", \"0\")\n","        max_retries = int(mr_env)\n","    except Exception:\n","        max_retries = 0\n","    base = int(os.getenv(\"TTDVI_BACKOFF_BASE_SEC\", \"5\"))\n","    backoff_max = int(os.getenv(\"TTDVI_BACKOFF_MAX_SEC\", \"300\"))\n","    never_stop = str(os.getenv(\"TTDVI_NEVER_STOP\", \"1\")).strip().lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","\n","    ck = CHECKPOINTER.load()\n","    if ck and isinstance(ck, dict) and \"state\" in ck:\n","        with contextlib.suppress(Exception):\n","            restore_runtime_state(ck[\"state\"])\n","            _log_event(\"RESTORE\", \"Estado restaurado desde checkpoint\")\n","            if _is_verbose(): _pp({\"restored\": True}, title=\"Checkpoint\", etapa=\"restore\")\n","\n","    attempt = 0\n","    PERIODIC_SAVER.start()\n","\n","    if not callable(main_coro_factory):\n","        async def _fallback():\n","            _log_event(\"DEMO\", \"FallbackMain (no se detectó main personalizado)\")\n","            while True:\n","                await asyncio.sleep(1.0)\n","        main_coro_factory = _fallback\n","\n","    while True:\n","        attempt += 1\n","        try:\n","            _log_event(\"START\", f\"Arrancando ciclo (attempt #{attempt})\")\n","            if _is_verbose(): _pp({\"attempt\": attempt}, title=\"Resilience\", etapa=\"start\")\n","            await main_coro_factory()\n","            _log_event(\"DONE\", \"Tarea principal finalizó sin error\")\n","            if _is_verbose(): _pp({\"attempt\": attempt, \"status\": \"done\"}, title=\"Resilience\", etapa=\"done\")\n","            if not never_stop:\n","                break\n","            else:\n","                delay = min(backoff_max, base)\n","                _log_event(\"SLEEP\", f\"Relanzando en {delay}s (NEVER_STOP)\")\n","                await asyncio.sleep(delay); continue\n","        except asyncio.CancelledError:\n","            _log_event(\"CANCEL\", \"Tarea cancelada\")\n","            if _is_verbose(): _pp({\"attempt\": attempt}, title=\"Resilience\", etapa=\"cancel\")\n","            if not never_stop:\n","                break\n","            else:\n","                delay = min(backoff_max, base)\n","                _log_event(\"SLEEP\", f\"Relanzando tras cancelación en {delay}s (NEVER_STOP)\")\n","                with contextlib.suppress(Exception): await asyncio.sleep(delay)\n","                continue\n","        except Exception as e:\n","            _log_event(\"ERROR\", f\"Fallo ciclo: {e}\", traceback=traceback.format_exc())\n","            if _is_verbose(): _pp({\"attempt\": attempt, \"error\": str(e)}, title=\"Resilience\", etapa=\"error\")\n","            if max_retries > 0 and attempt >= max_retries:\n","                _log_event(\"FATAL\", \"Máximo de reintentos alcanzado\")\n","                if _is_verbose(): _pp({\"attempt\": attempt}, title=\"Resilience\", etapa=\"fatal\")\n","                if not never_stop:\n","                    break\n","                else:\n","                    attempt = 0\n","            delay = min(backoff_max, base * (2 ** (attempt - 1)))\n","            _log_event(\"SLEEP\", f\"Reintentando en {delay}s\")\n","            with contextlib.suppress(Exception): await asyncio.sleep(delay)\n","        finally:\n","            with contextlib.suppress(Exception):\n","                CHECKPOINTER.save({\"state\": get_runtime_state(), \"ts\": _now_iso(), \"attempt\": attempt})\n","                await close_all_http_sessions()\n","\n","    with contextlib.suppress(Exception):\n","        await PERIODIC_SAVER.stop()\n","    _log_event(\"END\", \"Supervisor finalizado\")\n","\n","async def run_with_resilience(main_coro_factory: Callable[[], Awaitable[Any]]):\n","    if callable(_run_with_resilience_prior) and _run_with_resilience_prior is not run_with_resilience:\n","        return await _run_with_resilience_prior(main_coro_factory)\n","    return await _run_with_resilience_builtin(main_coro_factory)\n","\n","# ---------- Lanzador seguro (script vs notebook) ----------\n","def _run_async_safely(coro: Awaitable[Any]):\n","    _pp = print_results_panel\n","    try:\n","        return asyncio.run(coro)\n","    except RuntimeError:\n","        try:\n","            loop = asyncio.get_event_loop()\n","        except Exception:\n","            loop = asyncio.new_event_loop(); asyncio.set_event_loop(loop)\n","        if loop.is_running():\n","            fut = asyncio.ensure_future(coro)\n","            _attach_task_logging(fut, \"ttdvi_resilience_autorun_task\")\n","            _log_event(\"INFO\", \"Loop activo (notebook). Tarea agendada.\")\n","            if _is_verbose(): _pp({\"nota\": \"loop ya activo\"}, title=\"Autorun\", etapa=\"notebook\")\n","            return fut\n","        else:\n","            return loop.run_until_complete(coro)\n","\n","# ---------- Descubrimiento de main (reusa _discover_main_factory si existe) ----------\n","def _find_main_coro_factory() -> Callable[[], Awaitable[Any]]:\n","    _disc = globals().get(\"_discover_main_factory\")\n","    if callable(_disc):\n","        factory = _disc()\n","        if factory is not None:\n","            _log_event(\"INFO\", \"Main detectado vía _discover_main_factory()\")\n","            async def _factory_wrapper():\n","                res = factory()\n","                if inspect.iscoroutine(res): return await res\n","                for attr in (\"run\", \"start\"):\n","                    fn = getattr(res, attr, None)\n","                    if callable(fn):\n","                        out = fn()\n","                        if inspect.iscoroutine(out): return await out\n","                        return out\n","                await asyncio.sleep(0.01); return res\n","            return _factory_wrapper\n","\n","    _pp = print_results_panel\n","    g = globals()\n","\n","    if \"run_loop_principal\" in g and inspect.iscoroutinefunction(g[\"run_loop_principal\"]):\n","        async def _factory(_pp=_pp): return await g[\"run_loop_principal\"]()\n","        _log_event(\"INFO\", \"Main detectado: run_loop_principal\");\n","        if _is_verbose(): _pp({\"main\": \"run_loop_principal\"}, title=\"MainDetectado\")\n","        return _factory\n","\n","    if \"boot_darwin_v4_stack\" in g:\n","        async def _factory(_pp=_pp):\n","            res = g[\"boot_darwin_v4_stack\"]()\n","            if inspect.iscoroutine(res): return await res\n","            for attr in (\"run\", \"start\"):\n","                fn = getattr(res, attr, None)\n","                if callable(fn):\n","                    out = fn()\n","                    if inspect.iscoroutine(out): return await out\n","                    return out\n","            await asyncio.sleep(0.01); return res\n","        _log_event(\"INFO\", \"Main detectado: boot_darwin_v4_stack\")\n","        return _factory\n","\n","    if \"main_async\" in g and inspect.iscoroutinefunction(g[\"main_async\"]):\n","        async def _factory(_pp=_pp):\n","            if _is_verbose(): _pp({\"main\": \"main_async\"}, title=\"MainDetectado\")\n","            return await g[\"main_async\"]()\n","        _log_event(\"INFO\", \"Main detectado: main_async\"); return _factory\n","\n","    if \"main\" in g:\n","        async def _factory(_pp=_pp):\n","            res = g[\"main\"]()\n","            if inspect.iscoroutine(res): return await res\n","            await asyncio.sleep(0.01); return res\n","        _log_event(\"INFO\", \"Main detectado: main\"); return _factory\n","\n","    async def _demo(_pp=_pp):\n","        _log_event(\"DEMO\", \"No se detectó main; corriendo demo 6s (valida resiliencia)\")\n","        if _is_verbose(): _pp({\"demo\": True}, title=\"MainDetectado\")\n","        for i in range(6):\n","            await asyncio.sleep(1)\n","            CHECKPOINTER.save({\"state\": get_runtime_state(), \"ts\": _now_iso(), \"demo_tick\": i+1})\n","        _log_event(\"DEMO\", \"Demo finalizada\")\n","    _log_event(\"WARN\", \"No se encontró ejecutor; usa nombres estándar o define _discover_main_factory()\")\n","    return _demo\n","\n","# ---------- Consumidor de excepciones en Tasks ----------\n","def _attach_task_logging(task: asyncio.Task, label: str = \"ttdvi_task\"):\n","    def _done(t: asyncio.Task):\n","        with contextlib.suppress(asyncio.CancelledError):\n","            try: t.result()\n","            except Exception as e: _log_event(\"ERROR\", f\"{label} terminó con error capturado: {e}\")\n","    task.add_done_callback(_done)\n","    return task\n","\n","# ---------- API de arranque público ----------\n","async def TTDVI_resilience_autorun():\n","    _pp = print_results_panel\n","    factory = _find_main_coro_factory()\n","    if _is_verbose(): _pp({\"autorun\": True}, title=\"Autorun\", etapa=\"pre-run\")\n","    await run_with_resilience(factory)\n","\n","# ---------- Auto-run controlable por ENV ----------\n","if os.getenv(\"TTDVI_AUTORUN\", \"1\") == \"1\" and not globals().get(\"_TTDVI156_RESILIENCE_STARTED\", False):\n","    globals()[\"_TTDVI156_RESILIENCE_STARTED\"] = True\n","    try:\n","        _res_task = _run_async_safely(TTDVI_resilience_autorun())\n","        if isinstance(_res_task, asyncio.Task):\n","            _attach_task_logging(_res_task, \"ttdvi_resilience_autorun_task\")\n","    except Exception as e:\n","        _log_event(\"ERROR\", f\"Autorun falló: {e}\")\n","\n","# ======================== FIN — RESILIENCIA COLAB ==============================================\n","\n","\n","# ======== KRACKENEX PERMANENTE (AUTO-INSTALL + FALLBACK STUB COMPATIBLE) ========\n","# Colócalo ANTES de:  import krakenex\n","import sys, time, json, logging, types, base64, hashlib, hmac\n","from typing import Optional, Dict\n","from urllib import request as _urlreq, parse as _urlparse, error as _urlerr\n","\n","def _pip_install(pkg: str, attempts: int = 2) -> bool:\n","    try:\n","        import subprocess, sys as _sys\n","        for i in range(attempts):\n","            rc = subprocess.call([_sys.executable, \"-m\", \"pip\", \"install\", \"--quiet\", pkg])\n","            if rc == 0: return True\n","            time.sleep(1 + i)\n","        return False\n","    except Exception:\n","        return False\n","\n","def _ensure_krakenex():\n","    try:\n","        import krakenex  # noqa\n","        return\n","    except Exception:\n","        pass\n","\n","    _installed = _pip_install(\"krakenex>=2.1.0\")\n","    if _installed:\n","        try:\n","            import krakenex  # noqa\n","            return\n","        except Exception:\n","            pass\n","\n","    logging.getLogger(__name__).warning(\n","        \"[krakenex] No disponible. Cargando STUB compatible (query_public/query_private).\"\n","    )\n","\n","    class _KrakenAPIStub:\n","        def __init__(self, key: Optional[str] = None, secret: Optional[str] = None, url: str = \"https://api.kraken.com\"):\n","            self.key = key or \"\"; self.secret = secret or \"\"; self.url_root = url.rstrip(\"/\")\n","            self._last_ts = 0.0; self._min_interval = 0.33\n","        def load_key(self, path: str):\n","            try:\n","                with open(path, \"r\", encoding=\"utf-8\") as fh:\n","                    lines = [ln.strip() for ln in fh if ln.strip()]\n","                if len(lines) >= 2:\n","                    self.key, self.secret = lines[0], lines[1]\n","                elif len(lines) == 1 and \":\" in lines[0]:\n","                    self.key, self.secret = lines[0].split(\":\", 1)\n","                else:\n","                    raise ValueError(\"Formato de keyfile inválido\")\n","                return True\n","            except Exception as e:\n","                logging.warning(f\"[krakenex-stub] load_key fallo: {e}\")\n","                return False\n","        def _throttle(self):\n","            dt = time.time() - self._last_ts\n","            if dt < self._min_interval:\n","                time.sleep(self._min_interval - dt)\n","            self._last_ts = time.time()\n","        def _post(self, path: str, data: Dict[str, str], headers: Dict[str, str]) -> Dict:\n","            self._throttle()\n","            payload = _urlparse.urlencode(data).encode()\n","            req = _urlreq.Request(self.url_root + path, data=payload, headers=headers, method=\"POST\")\n","            try:\n","                with _urlreq.urlopen(req, timeout=20) as resp:\n","                    raw = resp.read().decode(\"utf-8\", errors=\"replace\")\n","                try: return json.loads(raw)\n","                except Exception: return {\"error\": [\"EAPI:Invalid JSON\"], \"raw\": raw}\n","            except _urlerr.URLError as e:\n","                return {\"error\": [f\"ENET:{getattr(e, 'reason', e)}\"]}\n","        def _get(self, path: str, params: Optional[Dict[str, str]] = None) -> Dict:\n","            self._throttle()\n","            q = (\"?\" + _urlparse.urlencode(params)) if params else \"\"\n","            try:\n","                with _urlreq.urlopen(self.url_root + path + q, timeout=20) as resp:\n","                    raw = resp.read().decode(\"utf-8\", errors=\"replace\")\n","                try: return json.loads(raw)\n","                except Exception: return {\"error\": [\"EAPI:Invalid JSON\"], \"raw\": raw}\n","            except _urlerr.URLError as e:\n","                return {\"error\": [f\"ENET:{getattr(e, 'reason', e)}\"]}\n","        def query_public(self, method: str, data: Optional[Dict] = None) -> Dict:\n","            data = data or {}; path = f\"/0/public/{method}\"; return self._get(path, data)\n","        def query_private(self, method: str, data: Optional[Dict] = None) -> Dict:\n","            data = dict(data or {}); nonce = str(int(time.time() * 1000)); data[\"nonce\"] = nonce\n","            path = f\"/0/private/{method}\"; postdata = _urlparse.urlencode(data).encode()\n","            sha = hashlib.sha256(nonce.encode() + postdata).digest()\n","            try: hkey = base64.b64decode(self.secret)\n","            except Exception: hkey = self.secret.encode()\n","            message = path.encode() + sha\n","            signature = hmac.new(hkey, message, hashlib.sha512).digest()\n","            api_sign = base64.b64encode(signature).decode()\n","            headers = {\n","                \"API-Key\": self.key, \"API-Sign\": api_sign,\n","                \"User-Agent\": \"krakenex-stub/1.0\",\n","                \"Content-Type\": \"application/x-www-form-urlencoded; charset=utf-8\",\n","            }\n","            return self._post(path, data, headers)\n","\n","    mod = types.ModuleType(\"krakenex\")\n","    setattr(mod, \"API\", _KrakenAPIStub)\n","    sys.modules[\"krakenex\"] = mod\n","\n","_ensure_krakenex()\n","# ======== FIN BLOQUE PERMANENTE KRACKENEX ========\n","\n","\n","# =============== BLINDAJE PERMANENTE run_loop (proxy + normalización) ===============\n","# Usa las definiciones de la PRIMERA SECCIÓN si existen; si no, crea mínimas aquí.\n","\n","# 1) _ensure_mapping (si no existe)\n","try:\n","    _ensure_mapping  # type: ignore\n","except NameError:\n","    from collections.abc import MutableMapping\n","    _WRAPPED_WARN = set()\n","    class _CallableRunLoopProxy:\n","        __slots__ = (\"_func\", \"_store\")\n","        def __init__(self, func: Callable):\n","            object.__setattr__(self, \"_func\", func)\n","            object.__setattr__(self, \"_store\", {})\n","        def __call__(self, *a, **k): return self._func(*a, **k)\n","        def __getitem__(self, k): return self._store[k]\n","        def __setitem__(self, k, v):\n","            self._store[k] = v\n","            try: setattr(self._func, str(k), v)\n","            except Exception: pass\n","        def __getattr__(self, n): return getattr(self._func, n)\n","    def _ensure_mapping(obj, name=\"obj\"):\n","        if isinstance(obj, MutableMapping): return obj\n","        if obj is None: return {}\n","        if callable(obj):\n","            if id(obj) not in _WRAPPED_WARN:\n","                _WRAPPED_WARN.add(id(obj))\n","                with contextlib.suppress(Exception):\n","                    warnings.warn(f\"[run_loop] {name} era callable y se envolvió con proxy.\", RuntimeWarning)\n","            # Si existe el proxy de la 1ª sección, úsalo; si no, usa el local\n","            _proxy_cls = globals().get(\"_CallableMapProxy\") or _CallableRunLoopProxy\n","            return _proxy_cls(obj)\n","        if id(obj) not in _WRAPPED_WARN:\n","            _WRAPPED_WARN.add(id(obj))\n","            with contextlib.suppress(Exception):\n","                warnings.warn(f\"[run_loop] {name} no era mapping; se boxeó en dict.\", RuntimeWarning)\n","        return {\"value\": obj}\n","\n","# 2) Proxificar run_loop si aún es una función \"pura\"\n","def _proxify_run_loop_if_needed():\n","    g = globals()\n","    rl = g.get(\"run_loop\")\n","    if rl is None: return \"sin_run_loop\"\n","    # si ya soporta __setitem__, no tocar\n","    if hasattr(rl, \"__setitem__\"): return \"ya_proxy\"\n","    # elegir proxy: el de 1ª sección si existe, si no, el local\n","    _proxy_cls = globals().get(\"_CallableMapProxy\") or globals().get(\"_CallableRunLoopProxy\")\n","    if _proxy_cls is None:\n","        # fallback mínimo inline\n","        class _CallableRunLoopProxy2:\n","            __slots__ = (\"_func\",\"_store\")\n","            def __init__(self, f): self._func=f; self._store={}\n","            def __call__(self,*a,**k): return self._func(*a,**k)\n","            def __getitem__(self,k): return self._store[k]\n","            def __setitem__(self,k,v): self._store[k]=