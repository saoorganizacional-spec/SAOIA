     pass\n","\n","# =================== USO DENTRO DE run_loop (opcional si lo editas) ===================\n","# Si en tu archivo original tienes la definición de run_loop, puedes (opcional) dejar:\n","# def run_loop(cfg=None, state=None, flags=None, *args, **kwargs):\n","#     cfg   = _ensure_mapping(cfg,   \"cfg\")\n","#     state = _ensure_mapping(state, \"state\")\n","#     flags = _ensure_mapping(flags, \"flags\")\n","#     ... tu lógica original ...\n","# Con el bloque de arriba, esto ya queda aplicado aunque no edites tu run_loop.\n","\n","# ======================== FIN BLINDAJE PERMANENTE run_loop =====================\n","\n","# =============================================================================\n","# =============== SECCIÓN FINAL — ENCHUFE TOTAL TTDVI156 (APÉNDICE) ===========\n","# =============================================================================\n","# - Auto-parchea run_loop (función + dict) y normaliza cfg/state/flags\n","# - Reusa supervisor e instrumentación si ya existen; si no, crea fallback\n","# - Start/Stop/Status públicos (TTDVI_start / TTDVI_stop / TTDVI_status)\n","# - Idempotente y silencioso salvo TTDVI_VERBOSE=1\n","# =============================================================================\n","\n","import os, asyncio, contextlib, warnings\n","\n","# ---------- Entorno mínimo coherente ----------\n","os.environ.setdefault(\"TRANSFORMERS_NO_TF_WARNING\", \"1\")\n","os.environ.setdefault(\"DISABLE_MLFLOW_INTEGRATION\", \"1\")\n","os.environ.setdefault(\"TOKENIZERS_PARALLELISM\", \"false\")\n","os.environ.setdefault(\"TTDVI_NEVER_STOP\", \"1\")  # no detener main por defecto\n","\n","_TTDVI_VERBOSE = os.getenv(\"TTDVI_VERBOSE\",\"0\").strip().lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","\n","def _vlog(msg: str):\n","    if _TTDVI_VERBOSE:\n","        try: print(f\"[TTDVI-APPENDIX] {msg}\", flush=True)\n","        except Exception: pass\n","\n","# ---------- (_ensure_mapping) + proxy dict<->callable si no existen ----------\n","try:\n","    _ensure_mapping  # type: ignore\n","except NameError:\n","    from collections.abc import MutableMapping\n","    _WRAPPED_WARN = set()\n","    class _CallableMapProxy:\n","        \"\"\"Permite usar [] sobre una función, manteniendo su invocación normal.\"\"\"\n","        __slots__ = (\"_func\",\"_store\")\n","        def __init__(self, func):\n","            object.__setattr__(self, \"_func\", func)\n","            object.__setattr__(self, \"_store\", {})\n","        def __call__(self, *a, **k): return self._func(*a, **k)\n","        def __getitem__(self, k): return self._store[k]\n","        def __setitem__(self, k, v):\n","            self._store[k] = v\n","            with contextlib.suppress(Exception):\n","                setattr(self._func, str(k), v)\n","        def __getattr__(self, n): return getattr(self._func, n)\n","        def __repr__(self): return f\"<CallableMapProxy keys={list(self._store.keys())}>\"\n","    def _ensure_mapping(obj, name=\"obj\"):\n","        if isinstance(obj, MutableMapping): return obj\n","        if obj is None: return {}\n","        if callable(obj):\n","            if id(obj) not in _WRAPPED_WARN:\n","                _WRAPPED_WARN.add(id(obj))\n","                with contextlib.suppress(Exception):\n","                    warnings.warn(f\"[run_loop] {name} era callable y se envolvió con _CallableMapProxy.\", RuntimeWarning)\n","            proxy_cls = globals().get(\"_CallableMapProxy\") or _CallableMapProxy\n","            return proxy_cls(obj)\n","        if id(obj) not in _WRAPPED_WARN:\n","            _WRAPPED_WARN.add(id(obj))\n","            with contextlib.suppress(Exception):\n","                warnings.warn(f\"[run_loop] {name} no era mapping; se boxeó en dict.\", RuntimeWarning)\n","        return {\"value\": obj}\n","\n","# ---------- Proxificar run_loop si hace falta ----------\n","def _proxify_run_loop_if_needed():\n","    g = globals()\n","    rl = g.get(\"run_loop\")\n","    if rl is None:\n","        return \"sin_run_loop\"\n","    # ya proxificado (tiene __setitem__)\n","    if hasattr(rl, \"__setitem__\"):\n","        return \"ya_proxy\"\n","    proxy_cls = g.get(\"_CallableMapProxy\")\n","    if proxy_cls is None:\n","        # proxy mínimo inline\n","        class _CallableRunLoopProxy:\n","            __slots__=(\"__f\",\"__s\")\n","            def __init__(self, f): object.__setattr__(self,\"__f\",f); object.__setattr__(self,\"__s\",{})\n","            def __call__(self,*a,**k): return self.__f(*a,**k)\n","            def __getitem__(self,k): return self.__s[k]\n","            def __setitem__(self,k,v): self.__s[k]=v\n","            def __getattr__(self,n): return getattr(self.__f,n)\n","        proxy_cls = _CallableRunLoopProxy\n","    g[\"run_loop\"] = proxy_cls(rl)\n","    return \"proxificado\"\n","\n","# ---------- Envolver run_loop para normalizar cfg/state/flags (sin cambiar firma) ----------\n","def _wrap_run_loop_normalizer():\n","    g = globals()\n","    rl = g.get(\"run_loop\")\n","    if rl is None or not callable(rl):\n","        return \"sin_run_loop\"\n","    target = getattr(rl, \"_func\", None) or rl\n","    if getattr(target, \"_ttdvi_norm_wrapped\", False):\n","        return \"ya_envuelto\"\n","    def _norm_wrapper(cfg=None, state=None, flags=None, *args, **kwargs):\n","        cfg_   = _ensure_mapping(cfg,   \"cfg\")\n","        state_ = _ensure_mapping(state, \"state\")\n","        flags_ = _ensure_mapping(flags, \"flags\")\n","        return target(cfg_, state_, flags_, *args, **kwargs)\n","    try: setattr(_norm_wrapper, \"_ttdvi_norm_wrapped\", True)\n","    except Exception: pass\n","    if hasattr(rl, \"_func\"):\n","        # mantener el proxy vivo; solo cambiamos el target\n","        with contextlib.suppress(Exception):\n","            setattr(rl, \"_func\", _norm_wrapper)\n","            return \"envuelto\"\n","    # si no hay proxy, sustituimos la referencia\n","    g[\"run_loop\"] = _norm_wrapper\n","    return \"envuelto\"\n","\n","# ---------- Supervisor / autorun (reusar si existe) ----------\n","# Preferimos el 'run_with_resilience' de secciones previas.\n","_run_with_resilience_prior = globals().get(\"run_with_resilience\")\n","\n","async def _fallback_factory_runner():\n","    \"\"\"Main de cortesía si no hay ninguno: deja latido vivo.\"\"\"\n","    _vlog(\"Fallback main activo (no se detectó ejecutor).\")\n","    while True:\n","        await asyncio.sleep(1.0)\n","\n","def _discover_factory():\n","    # Usa discovery avanzado si existe\n","    disc = globals().get(\"_discover_main_factory\")\n","    if callable(disc):\n","        f = disc()\n","        if f is not None:\n","            _vlog(\"Factory detectada vía _discover_main_factory()\")\n","            return f\n","    # Búsqueda simple\n","    g = globals()\n","    for name in (\"run_loop_principal\", \"boot_darwin_v4_stack\", \"main_async\", \"main\"):\n","        fn = g.get(name)\n","        if callable(fn):\n","            _vlog(f\"Factory detectada: {name}\")\n","            async def _factory():\n","                res = fn()\n","                if asyncio.iscoroutine(res):\n","                    return await res\n","                for attr in (\"run\",\"start\"):\n","                    m = getattr(res, attr, None)\n","                    if callable(m):\n","                        out = m()\n","                        if asyncio.iscoroutine(out):\n","                            return await out\n","                        return out\n","                await asyncio.sleep(0.01)\n","                return res\n","            return _factory\n","    _vlog(\"No se detectó main; usando fallback.\")\n","    return _fallback_factory_runner\n","\n","async def _resilience_entry():\n","    factory = _discover_factory()\n","    if callable(_run_with_resilience_prior):\n","        return await _run_with_resilience_prior(factory)\n","    # Fallback supervisor mínimo si no existía\n","    backoff, backoff_max = 1.5, 60.0\n","    attempt = 0\n","    while True:\n","        attempt += 1\n","        try:\n","            await factory()\n","            # Si terminó sin error: respetar NEVER_STOP\n","            if os.getenv(\"TTDVI_NEVER_STOP\",\"1\").strip().lower() not in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\"):\n","                break\n","        except asyncio.CancelledError:\n","            if os.getenv(\"TTDVI_NEVER_STOP\",\"1\").strip().lower() not in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\"):\n","                break\n","        except Exception as e:\n","            _vlog(f\"Main error (attempt {attempt}): {e}\")\n","        delay = min(backoff, backoff_max)\n","        _vlog(f\"Reintentando en {delay:.1f}s…\")\n","        await asyncio.sleep(delay)\n","        backoff = min(backoff * 1.7, backoff_max)\n","\n","# ---------- API pública: start/stop/status ----------\n","_TTDVI_TASK = None\n","\n","def TTDVI_status():\n","    loop_running = False\n","    try:\n","        loop = asyncio.get_event_loop()\n","        loop_running = loop.is_running()\n","    except Exception:\n","        pass\n","    return {\n","        \"task_active\": bool(_TTDVI_TASK and not getattr(_TTDVI_TASK, \"done\", lambda: True)()),\n","        \"loop_running\": loop_running,\n","        \"never_stop\": os.getenv(\"TTDVI_NEVER_STOP\",\"1\"),\n","    }\n","\n","def TTDVI_start():\n","    \"\"\"Arranca el supervisor de resiliencia (idempotente).\"\"\"\n","    global _TTDVI_TASK\n","    # Parchear run_loop antes de arrancar\n","    prox_state = _proxify_run_loop_if_needed()\n","    wrap_state = _wrap_run_loop_normalizer()\n","    _vlog(f\"run_loop patch → proxify={prox_state} wrap={wrap_state}\")\n","\n","    try:\n","        loop = asyncio.get_event_loop()\n","    except Exception:\n","        loop = asyncio.new_event_loop(); asyncio.set_event_loop(loop)\n","\n","    if loop.is_running():\n","        if _TTDVI_TASK and not _TTDVI_TASK.done():\n","            _vlog(\"Supervisor ya activo (notebook).\"); return _TTDVI_TASK\n","        _vlog(\"Programando supervisor en loop activo (notebook)…\")\n","        _TTDVI_TASK = asyncio.create_task(_resilience_entry(), name=\"ttdvi_appendix_supervisor\")\n","        # Evitar \"Task exception was never retrieved\"\n","        def _done(t):\n","            with contextlib.suppress(asyncio.CancelledError):\n","                try: t.result()\n","                except Exception as e: _vlog(f\"Supervisor terminó con error: {e}\")\n","        _TTDVI_TASK.add_done_callback(_done)\n","        return _TTDVI_TASK\n","    else:\n","        _vlog(\"Ejecutando supervisor en este hilo (script)…\")\n","        loop.run_until_complete(_resilience_entry())\n","        return None\n","\n","def TTDVI_stop(timeout: float = 5.0):\n","    \"\"\"Intenta parar el supervisor en modo notebook.\"\"\"\n","    global _TTDVI_TASK\n","    if _TTDVI_TASK and not _TTDVI_TASK.done():\n","        _vlog(\"Solicitando cancelación del supervisor…\")\n","        _TTDVI_TASK.cancel()\n","        try:\n","            loop = asyncio.get_event_loop()\n","            if loop.is_running():\n","                # esperar gentilmente\n","                fut = asyncio.wait_for(_TTDVI_TASK, timeout=timeout)\n","                # en loop activo no podemos await; dejamos que termine con callback\n","            else:\n","                loop.run_until_complete(asyncio.wait_for(_TTDVI_TASK, timeout=timeout))\n","        except Exception:\n","            pass\n","    _TTDVI_TASK = None\n","    _vlog(\"Supervisor detenido (si estaba activo).\")\n","\n","# ---------- Enchufe automático (puedes comentar estas 2 líneas si prefieres manual) ----------\n","# Parchea + arranca automáticamente manteniendo el mismo enfoque\n","if os.getenv(\"TTDVI_AUTORUN\", \"1\") == \"1\":\n","    # No duplicar si otra sección ya inició\n","    if not globals().get(\"_TTDVI156_RESILIENCE_STARTED\", False):\n","        globals()[\"_TTDVI156_RESILIENCE_STARTED\"] = True\n","        TTDVI_start()\n","\n","# =========================== FIN SECCIÓN FINAL (APÉNDICE) ===========================\n","\n","\n","# ==================== SISTEMA COMPLETO PERMANENTE (PT-only SIN TF/JAX + SHIMS) ====================\n","# Objetivo: usar SIEMPRE PyTorch con Transformers y evitar cualquier intento de clases TF*.\n","# Idempotente: puedes ejecutar/pegar múltiples veces sin efectos colaterales.\n","\n","import os, sys, subprocess, warnings, logging, re\n","import numpy as np\n","import pandas as pd\n","\n","# -------------------- Entorno silencioso + preferencia total por PyTorch --------------------\n","os.environ.setdefault(\"TF_CPP_MIN_LOG_LEVEL\", \"3\")\n","os.environ.setdefault(\"TRANSFORMERS_VERBOSITY\", \"error\")\n","os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"1\")\n","os.environ.setdefault(\"HF_HUB_DISABLE_TELEMETRY\", \"1\")\n","os.environ.setdefault(\"TRANSFORMERS_NO_TF_WARNING\", \"1\")\n","os.environ.setdefault(\"TOKENIZERS_PARALLELISM\", \"false\")\n","os.environ.setdefault(\"USE_TF\", \"0\")\n","os.environ.setdefault(\"USE_JAX\", \"0\")\n","os.environ.setdefault(\"USE_FLAX\", \"0\")\n","os.environ.setdefault(\"USE_TORCH\", \"1\")\n","\n","warnings.filterwarnings(\"ignore\")\n","for _n in (\"tensorflow\", \"transformers\", \"huggingface_hub\", \"urllib3\", \"filelock\"):\n","    try:\n","        logging.getLogger(_n).setLevel(logging.ERROR)\n","    except Exception:\n","        pass\n","\n","# 🔇 Silenciar de forma explícita el logger que emite el WARNING del token HF\n","try:\n","    logging.getLogger(\"huggingface_hub._login\").setLevel(logging.CRITICAL)\n","except Exception:\n","    pass\n","\n","# -------------------- Monkey-patch: Transformers cree que NO hay TF ni JAX --------------------\n","# Esto evita que Transformers seleccione rutas TF o clases TF* incluso si TensorFlow está instalado.\n","try:\n","    import importlib\n","    _iu = importlib.import_module(\"transformers.utils.import_utils\")\n","    # Idempotencia: si ya parcheado, no hacer nada\n","    if getattr(_iu, \"_TTDVI_PT_ONLY_PATCH\", None) is None:\n","        _iu.is_tf_available = lambda: False\n","        _iu.is_flax_available = lambda: False\n","        _iu.is_jax_available = lambda: False\n","        _iu.is_torch_available = lambda: True\n","        _iu._TTDVI_PT_ONLY_PATCH = True\n","except Exception:\n","    # Si transformers aún no está instalado, se parcheará automáticamente en el primer import porque\n","    # el pipeline que definimos fuerza framework=\"pt\". No es crítico fallar aquí.\n","    pass\n","\n","# -------------------- Helper pip silencioso (para dependencias en caliente si hace falta) -----\n","def _pip_quiet(spec: str) -> bool:\n","    try:\n","        r = subprocess.run(\n","            [sys.executable, \"-m\", \"pip\", \"install\", \"--upgrade\", \"--quiet\", \"--no-warn-script-location\", spec],\n","            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False\n","        )\n","        return r.returncode == 0\n","    except Exception:\n","        return False\n","\n","# -------------------- SKLEARN RESILIENTE (shims locales si no hay sklearn) --------------------\n","_SKLEARN_OK = True\n","try:\n","    from sklearn.linear_model import LinearRegression as _LR\n","    from sklearn.preprocessing import StandardScaler as _SS\n","    from sklearn.exceptions import NotFittedError as _NFErr\n","except Exception as _e:\n","    _SKLEARN_OK = False\n","    print(\"⚠️ sklearn no disponible. Activando shims:\", _e)\n","\n","    class _NFErr(RuntimeError): pass\n","\n","    class _SS:\n","        def __init__(self, copy=True, with_mean=True, with_std=True):\n","            self.with_mean = with_mean; self.with_std = with_std\n","            self.mean_ = None; self.scale_ = None; self.n_features_in_ = None\n","        def fit(self, X, y=None):\n","            X = np.asarray(X, dtype=np.float64); X = X.reshape(-1,1) if X.ndim==1 else X\n","            self.n_features_in_ = X.shape[1]\n","            self.mean_  = X.mean(axis=0) if self.with_mean else np.zeros(X.shape[1], dtype=np.float64)\n","            if self.with_std:\n","                std = X.std(axis=0, ddof=0); self.scale_ = np.where(std==0.0, 1.0, std)\n","            else:\n","                self.scale_ = np.ones(X.shape[1], dtype=np.float64)\n","            return self\n","        def transform(self, X):\n","            if self.mean_ is None or self.scale_ is None: raise _NFErr(\"Scaler no ajustado\")\n","            X = np.asarray(X, dtype=np.float64); X = X.reshape(-1,1) if X.ndim==1 else X\n","            return (X - self.mean_) / self.scale_\n","        def fit_transform(self, X, y=None): return self.fit(X).transform(X)\n","        def inverse_transform(self, X):\n","            if self.mean_ is None or self.scale_ is None: raise _NFErr(\"Scaler no ajustado\")\n","            X = np.asarray(X, dtype=np.float64); X = X.reshape(-1,1) if X.ndim==1 else X\n","            return X * self.scale_ + self.mean_\n","\n","    class _LR:\n","        def __init__(self, fit_intercept=True, copy_X=True, n_jobs=None, positive=False):\n","            self.fit_intercept = fit_intercept; self.coef_ = None; self.intercept_ = 0.0\n","        def fit(self, X, y, sample_weight=None):\n","            X = np.asarray(X, dtype=np.float64); y = np.asarray(y, dtype=np.float64)\n","            if X.ndim==1: X = X.reshape(-1,1)\n","            if y.ndim==1: y = y.reshape(-1,1)\n","            if self.fit_intercept:\n","                X = np.hstack([np.ones((X.shape[0],1), dtype=np.float64), X])\n","            try:\n","                beta, *_ = np.linalg.lstsq(X, y, rcond=None)\n","            except np.linalg.LinAlgError:\n","                beta = np.linalg.pinv(X) @ y\n","            if self.fit_intercept:\n","                self.intercept_ = beta[0].reshape(-1) if getattr(beta[0], \"ndim\", 0)>0 else np.array([float(beta[0])])\n","                self.coef_ = beta[1:].T\n","            else:\n","                self.coef_ = beta.T\n","                self.intercept_ = np.zeros(y.shape[1], dtype=np.float64)\n","            if getattr(self.coef_, \"shape\", (0,))[0]==1: self.coef_ = self.coef_[0]\n","            if getattr(self.intercept_, \"shape\", ())==(): self.intercept_ = np.array([float(self.intercept_)])\n","            return self\n","        def predict(self, X):\n","            if self.coef_ is None: raise _NFErr(\"Modelo no ajustado\")\n","            X = np.asarray(X, dtype=np.float64)\n","            if X.ndim == 1:\n","                X = X.reshape(-1, self.coef_.shape[-1])\n","            y = X @ np.asarray(self.coef_).T\n","            y = y + self.intercept_\n","            # 🔒 Siempre 2D\n","            y = np.asarray(y)\n","            if y.ndim == 0:\n","                y = y.reshape(1, 1)\n","            elif y.ndim == 1:\n","                y = y.reshape(-1, 1)\n","            return y\n","\n","# -------------------- Helper warnings seguro ---------------------------------------------------\n","def _safe_filterwarnings(action: str, message_regex: str, category):\n","    try:\n","        warnings.filterwarnings(action, message=message_regex, category=category)\n","    except Exception:\n","        try:\n","            warnings.filterwarnings(action, message=str(message_regex), category=category)\n","        except Exception:\n","            pass\n","\n","_safe_filterwarnings(\"ignore\", r\"TensorFlow and JAX classes are deprecated.*\", UserWarning)\n","\n","# -------------------- Normalizador universal de predicciones (siempre 2D) ---------------------\n","def _ensure_2d_pred(y, horizonte: int):\n","    y = np.asarray(y)\n","    if y.ndim == 0:\n","        return y.reshape(1, 1)\n","    if y.ndim == 1:\n","        if horizonte == 1:\n","            return y.reshape(-1, 1)\n","        if y.size == horizonte:\n","            return y.reshape(1, horizonte)\n","        return y.reshape(-1, 1)\n","    if y.ndim > 2:\n","        y = y.reshape(y.shape[0], -1)\n","    if y.shape[1] != horizonte:\n","        try:\n","            y = y.reshape(-1, horizonte)\n","        except Exception:\n","            y = y.reshape(-1, 1)\n","    return y\n","\n","# ==================== SISTEMA DE SERIES TEMPORALES (usa TF solo si QUIERES) ====================\n","def _has_tf():\n","    try:\n","        import tensorflow as tf  # noqa\n","        return True\n","    except Exception:\n","        return False\n","\n","class SistemaTemporal:\n","    \"\"\"\n","    Entrena LSTM (TensorFlow) si está disponible.\n","    Si NO hay TensorFlow, usa una regresión lineal multisalida sobre ventanas (fallback).\n","    \"\"\"\n","    def __init__(self, ventana=30, horizonte=1, batch_size=32, seed=42, permitir_tf=True):\n","        self.ventana = int(ventana)\n","        self.horizonte = int(max(1, horizonte))\n","        self.batch_size = int(batch_size)\n","        self.seed = int(seed)\n","        self.backend = \"tf\" if (permitir_tf and _has_tf()) else \"linear\"\n","        self.tf_model = None\n","        self.lin_model = None\n","        self.n_features = None\n","        np.random.seed(self.seed)\n","        if self.backend == \"tf\":\n","            try:\n","                import tensorflow as tf\n","                tf.random.set_seed(self.seed)\n","            except Exception:\n","                self.backend = \"linear\"\n","\n","    def _prep(self, datos, columna_objetivo=None, features=None):\n","        if isinstance(datos, pd.DataFrame):\n","            df = datos.copy()\n","            if features is None:\n","                features = [c for c in df.columns if np.issubdtype(df[c].dtype, np.number)]\n","                if not features: raise ValueError(\"No hay columnas numéricas en el DataFrame.\")\n","            if columna_objetivo is None:\n","                for k in (\"close\",\"Close\",\"CLOSE\",\"price\",\"Price\",\"value\",\"Value\"):\n","                    if k in df.columns: columna_objetivo = k; break\n","                if columna_objetivo is None: columna_objetivo = features[0]\n","            Xmat = df[features].astype(np.float32).values\n","            yvec = df[columna_objetivo].astype(np.float32).values\n","            n_features = len(features)\n","        else:\n","            s = pd.Series(datos).astype(np.float32)\n","            Xmat = s.values.reshape(-1,1); yvec = s.values; n_features = 1\n","\n","        T = len(yvec)\n","        if T < self.ventana + self.horizonte:\n","            raise ValueError(f\"Datos insuficientes: {T}, necesita {self.ventana + self.horizonte}.\")\n","        Xs, ys = [], []\n","        for i in range(T - self.ventana - self.horizonte + 1):\n","            Xs.append(Xmat[i:i+self.ventana])\n","            ys.append(yvec[i+self.ventana:i+self.ventana+self.horizonte])\n","        X = np.array(Xs, dtype=np.float32)\n","        y = np.array(ys, dtype=np.float32).reshape(-1, self.horizonte)\n","        if np.isnan(X).any() or np.isnan(y).any():\n","            raise ValueError(\"NaNs detectados en datos.\")\n","        return X, y, n_features\n","\n","    def _build_tf(self, n_features, unidades_lstm=64, bidireccional=True):\n","        import tensorflow as tf\n","        from tensorflow.keras import layers, models, optimizers\n","        inp = layers.Input(shape=(self.ventana, n_features))\n","        x = (layers.Bidirectional(layers.LSTM(unidades_lstm, return_sequences=False))(inp)\n","             if bidireccional else layers.LSTM(unidades_lstm, return_sequences=False)(inp))\n","        x = layers.Dense(max(32, self.horizonte*2), activation=\"relu\")(x)\n","        x = layers.Dropout(0.2)(x)\n","        out = layers.Dense(self.horizonte, activation=\"linear\")(x)\n","        model = models.Model(inp, out)\n","        model.compile(optimizer=optimizers.Adam(1e-3), loss=\"mse\", metrics=[\"mae\"])\n","        return model\n","\n","    def entrenar(self, datos, epochs=50, columna_objetivo=None, features=None, verbose=1):\n","        X, y, n_features = self._prep(datos, columna_objetivo, features)\n","        self.n_features = n_features\n","        if self.backend == \"tf\":\n","            self.tf_model = self._build_tf(n_features)\n","            hist = self.tf_model.fit(\n","                X, y, batch_size=self.batch_size, epochs=int(epochs),\n","                validation_split=0.2, shuffle=True, verbose=verbose\n","            )\n","            return hist\n","        else:\n","            X2 = X.reshape(X.shape[0], self.ventana * n_features)\n","            self.lin_model = _LR(fit_intercept=True).fit(X2, y)\n","            class _Hist:\n","                history = {\"loss\": [float(np.mean((self.lin_model.predict(X2)-y)**2))]}\n","            return _Hist()\n","\n","    def predecir(self, datos):\n","        # Entrada → np.array\n","        if isinstance(datos, pd.DataFrame):\n","            A = datos.values.astype(np.float32)\n","        else:\n","            A = np.asarray(datos, dtype=np.float32)\n","        # Formato ventana x features\n","        if A.ndim == 1:\n","            A = A.reshape(-1, 1 if self.n_features is None else self.n_features)\n","        if A.ndim == 2:\n","            if self.n_features is None:\n","                self.n_features = A.shape[1]\n","            A = A.reshape(1, self.ventana, self.n_features)\n","        # Predicción\n","        if self.backend == \"tf\" and self.tf_model is not None:\n","            y = self.tf_model.predict(A, verbose=0)\n","        elif self.lin_model is not None:\n","            A2 = A.reshape(A.shape[0], self.ventana * self.n_features)\n","            y = self.lin_model.predict(A2)\n","        else:\n","            raise RuntimeError(\"El modelo no ha sido entrenado.\")\n","        # 🔒 Normaliza a 2D (n_muestras, horizonte)\n","        return _ensure_2d_pred(y, self.horizonte)\n","\n","# ==================== SISTEMA TRANSFORMERS (PT por defecto; TF/JAX deshabilitados) ==============\n","def _mask(tok: str) -> str:\n","    tok = str(tok)\n","    return tok if len(tok) < 10 else (tok[:6] + \"…\" + tok[-4:])\n","\n","def set_hf_token_silent(tok: str | None, persist: bool = True):\n","    \"\"\"\n","    Configura el token de HF sin WARNING:\n","    - Si ya existe el mismo HF_TOKEN en el entorno → no hace nada (idempotente).\n","    - Exporta HF_TOKEN/HUGGINGFACEHUB_API_TOKEN/HUGGING_FACE_HUB_TOKEN.\n","    - Guarda con HfFolder.save_token() sin llamar a login() (que es quien imprime el aviso).\n","    \"\"\"\n","    if tok is None or not str(tok).strip():\n","        print(\"ℹ️ set_hf_token_silent: token vacío; se omite.\")\n","        return\n","    tok = str(tok).strip()\n","\n","    cur = os.environ.get(\"HF_TOKEN\", \"\")\n","    if cur and cur.strip() == tok:\n","        print(f\"✅ HF_TOKEN ya activo ({_mask(tok)})\")\n","        return\n","\n","    os.environ[\"HF_TOKEN\"] = tok\n","    os.environ[\"HUGGINGFACEHUB_API_TOKEN\"] = tok\n","    os.environ[\"HUGGING_FACE_HUB_TOKEN\"] = tok\n","\n","    if persist:\n","        try:\n","            from huggingface_hub import HfFolder\n","            HfFolder.save_token(tok)\n","        except Exception:\n","            pass\n","    print(f\"✅ HF_TOKEN configurado sin warnings ({_mask(tok)})\")\n","\n","class SistemaTransformers:\n","    \"\"\"\n","    Carga y usa modelos de texto con PyTorch (framework='pt').\n","    Nunca usa clases TF* → evita el error 'TFAutoModel… requires TensorFlow'.\n","    \"\"\"\n","    def __init__(self, modelo_id=\"distilbert/distilbert-base-uncased-finetuned-sst-2-english\"):\n","        self.modelo_id = modelo_id\n","        self.tokenizer = None\n","        self.modelo = None\n","        self.pipe = None\n","\n","    def configurar_token(self, token: str | None = None):\n","        if token and token.strip():\n","            set_hf_token_silent(token.strip(), persist=True)\n","\n","    def _asegurar_dependencias(self):\n","        mods = []\n","        try:\n","            import torch  # noqa\n","        except Exception:\n","            mods.append(\"torch\")\n","        try:\n","            import transformers  # noqa\n","        except Exception:\n","            mods.append(\"transformers>=4.42.0\")\n","        if mods:\n","            _pip_quiet(\" \".join(mods))\n","\n","    def cargar_modelo_texto(self):\n","        self._asegurar_dependencias()\n","        try:\n","            import torch\n","            from transformers import AutoTokenizer, AutoModelForSequenceClassification, pipeline as hf_pipeline\n","            self.tokenizer = AutoTokenizer.from_pretrained(self.modelo_id)\n","            self.modelo = AutoModelForSequenceClassification.from_pretrained(self.modelo_id)\n","            device = 0 if torch.cuda.is_available() else -1\n","            self.pipe = hf_pipeline(\n","                \"text-classification\",\n","                model=self.modelo,\n","                tokenizer=self.tokenizer,\n","                framework=\"pt\",\n","                device=device\n","            )\n","            print(f\"✅ Modelo PT cargado: {self.modelo_id}\")\n","            return True\n","        except Exception as e:\n","            print(\"❌ Error cargando modelo PT:\", e)\n","            return False\n","\n","    def clasificar_texto(self, textos):\n","        if self.pipe is None:\n","            raise ValueError(\"Primero ejecute cargar_modelo_texto().\")\n","        if isinstance(textos, str):\n","            textos = [textos]\n","        return self.pipe(textos, truncation=True)\n","\n","# ==================== INTERFAZ UNIFICADA (tu firma) ============================================\n","def entrenar_modelo_completo(datos, columna_objetivo=None, ventana=30, horizonte=1, epochs=50, features=None, permitir_tf=True):\n","    \"\"\"\n","    Devuelve (sistema, historia) — 'sistema' expone .predecir()\n","    \"\"\"\n","    sys_ts = SistemaTemporal(ventana=ventana, horizonte=horizonte, permitir_tf=permitir_tf)\n","    historia = sys_ts.entrenar(datos=datos, epochs=epochs, columna_objetivo=columna_objetivo, features=features)\n","    print(\"✅ Modelo entrenado\")\n","    try:\n","        loss = historia.history[\"loss\"][-1]\n","        print(f\"   - loss final: {loss:.6f}\")\n","    except Exception:\n","        pass\n","    return sys_ts, historia\n","\n","# ==================== USO INMEDIATO (demo segura) =============================================\n","if __name__ == \"__main__\":\n","    print(\"🚀 SISTEMA COMPLETO (PT-only Transformers) ACTIVADO\")\n","\n","    # 1) Entrenar con DataFrame (si existe CSV_PATH o 'tus_datos.csv')\n","    csv_path = os.getenv(\"CSV_PATH\", \"tus_datos.csv\")\n","    if os.path.isfile(csv_path):\n","        try:\n","            df = pd.read_csv(csv_path)\n","            modelo, historia = entrenar_modelo_completo(\n","                datos=df,\n","                columna_objetivo='precio',  # ajusta si tu columna difiere\n","                ventana=60,\n","                horizonte=7,\n","                epochs=100,\n","                permitir_tf=False  # fuerza fallback lineal si quieres cero TF\n","            )\n","            nuevos_datos = df.tail(60)\n","            predicciones = modelo.predecir(nuevos_datos)\n","            preds_np = np.asarray(predicciones)\n","            print(\"🔮 Predicciones (shape):\", preds_np.shape)\n","            print(\"🔹 Primera predicción:\", float(preds_np.squeeze().item()))\n","        except Exception as e:\n","            print(\"ℹ️ Error leyendo/entrenando con CSV, uso demo sintética:\", e)\n","            # cae a demo sintética más abajo\n","    else:\n","        print(f\"ℹ️ CSV no encontrado en '{csv_path}'. Usando demo sintética.\")\n","\n","    # 2) Demo sintética (si no hubo CSV o falló)\n","    if not os.path.isfile(csv_path):\n","        tiempo = np.arange(1000)\n","        datos_ejemplo = (np.sin(tiempo * 0.1).astype(np.float32)\n","                         + np.random.normal(0, 0.05, 1000).astype(np.float32))\n","        modelo, _ = entrenar_modelo_completo(datos=datos_ejemplo, ventana=30, horizonte=1, epochs=5, permitir_tf=False)\n","        predicciones = modelo.predecir(datos_ejemplo[-30:])\n","        print(\"🔮 Predicción sintética:\", float(np.asarray(predicciones).squeeze().item()))\n","\n","    # 3) Usar transformers (PT, sin TF)\n","    sistema_nlp = SistemaTransformers()\n","    # Opcional: configura el token sin warnings (si lo necesitas)\n","    # sistema_nlp.configurar_token(\"hf_xxx...\")\n","    if sistema_nlp.cargar_modelo_texto():\n","        resultados = sistema_nlp.clasificar_texto([\"Este producto es excelente\", \"Esto fue terrible\"])\n","        print(\"🗣️ Resultado NLP:\", resultados)\n","\n","# =================== TTDVI156 + HF_TOKEN (PERMANENTE, SILENCIOSO, VALIDADO) ===================\n","# Define get_hf_token() y set_hf_token() antes de usarlas. Sin login() y sin warnings de Colab.\n","\n","import os, re, stat, warnings, logging\n","from pathlib import Path\n","\n","_TTDVI_VERBOSE = os.getenv(\"TTDVI_VERBOSE\", \"0\").strip().lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","def _hf_log(msg: str):\n","    if _TTDVI_VERBOSE:\n","        try: print(f\"[HF] {msg}\")\n","        except Exception: pass\n","\n","def _is_colab() -> bool:\n","    try:\n","        import google.colab  # type: ignore\n","        return True\n","    except Exception:\n","        return \"COLAB_GPU\" in os.environ or \"COLAB_RELEASE_TAG\" in os.environ\n","\n","# Silencios selectivos\n","warnings.filterwarnings(\"ignore\", message=r\".*You are not logged in to the Hugging Face Hub.*\")\n","warnings.filterwarnings(\"ignore\", message=r\".*CachedDatasetWarning.*\")\n","warnings.filterwarnings(\n","    \"ignore\",\n","    category=UserWarning,\n","    module=r\"huggingface_hub\\.utils\\._auth\",\n","    message=r\".*The secret `HF_TOKEN` does not exist in your Colab secrets.*\",\n",")\n","for _name in (\"huggingface_hub\", \"huggingface_hub._login\", \"huggingface_hub.utils._auth\", \"transformers\"):\n","    logging.getLogger(_name).setLevel(logging.ERROR)\n","\n","os.environ.setdefault(\"HF_HUB_DISABLE_TELEMETRY\", \"1\")\n","os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"1\")\n","\n","def _mask_token(tok: str) -> str:\n","    if not tok: return \"\"\n","    if len(tok) <= 10: return \"***\"\n","    return tok[:6] + \"...\" + tok[-4:]\n","\n","def get_hf_token(env_key: str = \"HF_TOKEN\") -> str:\n","    \"\"\"Lee el token desde entorno o ~/.huggingface/token (evitando rutas ruidosas en Colab).\"\"\"\n","    tok = os.getenv(env_key, \"\").strip()\n","    if tok:\n","        return tok\n","    # archivo estándar silencioso\n","    home_tok = Path.home() / \".huggingface\" / \"token\"\n","    try:\n","        if home_tok.is_file():\n","            t = home_tok.read_text(encoding=\"utf-8\").strip()\n","            if t:\n","                return t\n","    except Exception:\n","        pass\n","    # fuera de Colab se puede usar HfFolder\n","    if not _is_colab():\n","        try:\n","            from huggingface_hub import HfFolder\n","            tok = (HfFolder.get_token() or \"\").strip()\n","            if tok:\n","                return tok\n","        except Exception:\n","            pass\n","    return \"\"\n","\n","def set_hf_token(\n","    token: str | None = None,\n","    env_key: str = \"HF_TOKEN\",\n","    persist: bool = True,\n","    quiet: bool = True\n",") -> str:\n","    \"\"\"\n","    Configura HF_TOKEN sin login() y sin warnings de Colab. Idempotente.\n","    - Si `token` es None, usa la variable de entorno.\n","    - Si `persist` es True, guarda en ~/.huggingface/token (600).\n","    \"\"\"\n","    tok_env = os.getenv(env_key, \"\").strip()\n","    tok = (token or tok_env).strip()\n","\n","    if not tok:\n","        if not quiet:\n","            print(\"⚠️ HF_TOKEN vacío: modo público.\")\n","        return \"\"\n","\n","    if not re.match(r\"^hf_[A-Za-z0-9]{20,}$\", tok):\n","        if not quiet:\n","            print(\"⚠️ Formato de HF_TOKEN no estándar; se usará igual.\")\n","    _hf_log(f\"Token recibido: {_mask_token(tok)}\")\n","\n","    # Exporta al entorno (evita que HF busque en Colab secrets)\n","    os.environ[env_key] = tok\n","\n","    if persist:\n","        # 1) Persistencia manual silenciosa\n","        try:\n","            tgt_dir = Path.home() / \".huggingface\"\n","            tgt_dir.mkdir(parents=True, exist_ok=True)\n","            tgt = tgt_dir / \"token\"\n","            old = \"\"\n","            try:\n","                if tgt.is_file():\n","                    old = tgt.read_text(encoding=\"utf-8\").strip()\n","            except Exception:\n","                pass\n","            if old != tok:\n","                tgt.write_text(tok, encoding=\"utf-8\")\n","                try:\n","                    tgt.chmod(stat.S_IRUSR | stat.S_IWUSR)  # 0o600\n","                except Exception:\n","                    pass\n","            _hf_log(f\"Token persistido en {tgt}.\")\n","        except Exception as e:\n","            _hf_log(f\"Persistencia manual falló: {e}\")\n","\n","        # 2) Fuera de Colab, opcionalmente HfFolder.save_token (mismo destino)\n","        if not _is_colab():\n","            try:\n","                from huggingface_hub import HfFolder\n","                HfFolder.save_token(tok)\n","                _hf_log(\"Token persistido con HfFolder.save_token().\")\n","            except Exception as e:\n","                _hf_log(f\"HfFolder.save_token() falló (no crítico): {e}\")\n","\n","    if not quiet:\n","        print(f\"✅ HF_TOKEN configurado ({_mask_token(tok)})\")\n","    return tok\n","\n","# ==================== TU LLAMADA (ya no dará NameError) ====================\n","set_hf_token(\"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\")  # o déjalo vacío para leer de entorno\n","# ==========================================================================\n","\n","# (Opcional) prueba silenciosa:\n","# print(_mask_token(get_hf_token()))\n","# =============================================================================\n","\n","# =================== TTDVI156 + HF_TOKEN (PERMANENTE, SILENCIOSO, VALIDADO) ===================\n","# Bloque idempotente: define set_hf_token(), get_hf_token(), y silencia warnings de HF.\n","# Úsalo ANTES de cualquier llamada a set_hf_token(...)\n","\n","import os, re, stat, warnings, logging\n","from pathlib import Path\n","\n","# Verbose opcional (logs internos enmascarados)\n","_TTDVI_VERBOSE = os.getenv(\"TTDVI_VERBOSE\", \"0\").strip().lower() in (\"1\",\"true\",\"yes\",\"on\",\"si\",\"sí\")\n","\n","def _hf_log(msg: str):\n","    if _TTDVI_VERBOSE:\n","        try: print(f\"[HF] {msg}\")\n","        except Exception: pass\n","\n","def _is_colab() -> bool:\n","    try:\n","        import google.colab  # type: ignore\n","        return True\n","    except Exception:\n","        return \"COLAB_GPU\" in os.environ or \"COLAB_RELEASE_TAG\" in os.environ\n","\n","# Silenciar avisos ruidosos (warnings y logging) de Hugging Face/Transformers\n","warnings.filterwarnings(\"ignore\", message=r\".*You are not logged in to the Hugging Face Hub.*\")\n","warnings.filterwarnings(\"ignore\", message=r\".*CachedDatasetWarning.*\")\n","\n","# 👉 Silenciar explícitamente el warning de Colab secrets de huggingface_hub\n","warnings.filterwarnings(\n","    \"ignore\",\n","    category=UserWarning,\n","    module=r\"huggingface_hub\\.utils\\._auth\",\n","    message=r\".*The secret `HF_TOKEN` does not exist in your Colab secrets.*\",\n",")\n","\n","for _name in (\"huggingface_hub\", \"huggingface_hub._login\", \"huggingface_hub.utils._auth\", \"transformers\"):\n","    logging.getLogger(_name).setLevel(logging.ERROR)\n","\n","# (opcional) desactiva telemetría/progress bars del Hub\n","os.environ.setdefault(\"HF_HUB_DISABLE_TELEMETRY\", \"1\")\n","os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"1\")\n","\n","def _mask_token(tok: str) -> str:\n","    if not tok: return \"\"\n","    if len(tok) <= 10: return \"***\"\n","    return tok[:6] + \"...\" + tok[-4:]\n","\n","def get_hf_token(env_key: str = \"HF_TOKEN\") -> str:\n","    \"\"\"Devuelve el token HF desde el entorno o archivo estándar (~/.huggingface/token).\n","       Evita rutas que disparen warnings en Colab.\"\"\"\n","    # 1) Entorno\n","    tok = os.getenv(env_key, \"\").strip()\n","    if tok:\n","        return tok\n","\n","    # 2) Archivo manual estándar (~/.huggingface/token) — seguro y silencioso\n","    home_tok = Path.home() / \".huggingface\" / \"token\"\n","    try:\n","        if home_tok.is_file():\n","            t = home_tok.read_text(encoding=\"utf-8\").strip()\n","            if t:\n","                return t\n","    except Exception:\n","        pass\n","\n","    # 3) Si NO estamos en Colab, se puede intentar HfFolder (no debería emitir el warning en este flujo)\n","    if not _is_colab():\n","        try:\n","            from huggingface_hub import HfFolder  # opcional\n","            tok = (HfFolder.get_token() or \"\").strip()\n","            if tok:\n","                return tok\n","        except Exception:\n","            pass\n","\n","    return \"\"\n","\n","def set_hf_token(\n","    token: str | None = None,\n","    env_key: str = \"HF_TOKEN\",\n","    persist: bool = True,\n","    quiet: bool = True\n",") -> str:\n","    \"\"\"\n","    Configura HF_TOKEN de forma segura e idempotente **sin llamar a login()**,\n","    y evitando el warning de Colab secrets:\n","      \"/huggingface_hub/utils/_auth.py:... UserWarning: The secret `HF_TOKEN` does not exist in your Colab secrets.\"\n","    - Si `token` es None, usa el valor de la variable de entorno.\n","    - Si `persist` es True, guarda en ~/.huggingface/token con permisos 600.\n","    - No imprime el token completo; se enmascara en logs opcionales.\n","    \"\"\"\n","    # Fuente del token (prioridad a argumento, luego entorno)\n","    tok_env = os.getenv(env_key, \"\").strip()\n","    tok = (token or tok_env).strip()\n","\n","    if not tok:\n","        if not quiet:\n","            print(\"⚠️ HF_TOKEN vacío: se continúa en modo público (solo recursos públicos).\")\n","        return \"\"\n","\n","    # Validación básica (formato típico de tokens HF)\n","    if not re.match(r\"^hf_[A-Za-z0-9]{20,}$\", tok):\n","        if not quiet:\n","            print(\"⚠️ HF_TOKEN con formato no estándar; se usará igualmente.\")\n","    _hf_log(f\"Token recibido: {_mask_token(tok)}\")\n","\n","    # Exportar a entorno (para que el ecosistema HF lo detecte y evite buscar en Colab secrets)\n","    os.environ[env_key] = tok\n","\n","    # Persistencia silenciosa SIN login() y evitando get_token() en Colab\n","    if persist:\n","        # 1) Guardar manualmente en ~/.huggingface/token (silencioso y seguro)\n","        try:\n","            tgt_dir = Path.home() / \".huggingface\"\n","            tgt_dir.mkdir(parents=True, exist_ok=True)\n","            tgt = tgt_dir / \"token\"\n","            # Escribe solo si falta o es diferente (evita I/O innecesario)\n","            old = \"\"\n","            try:\n","                if tgt.is_file():\n","                    old = tgt.read_text(encoding=\"utf-8\").strip()\n","            except Exception:\n","                pass\n","            if old != tok:\n","                tgt.write_text(tok, encoding=\"utf-8\")\n","                try:\n","                    tgt.chmod(stat.S_IRUSR | stat.S_IWUSR)  # 0o600\n","                except Exception:\n","                    pass\n","            _hf_log(f\"Token persistido en {tgt}.\")\n","        except Exception as e:\n","            _hf_log(f\"Persistencia manual falló: {e}\")\n","\n","        # 2) Si NO estamos en Colab, además intentamos HfFolder.save_token (no debería emitir warning)\n","        if not _is_colab():\n","            try:\n","                from huggingface_hub import HfFolder\n","                HfFolder.save_token(tok)  # ~/.huggingface/token (mismo destino)\n