ice)) / float(current_price)) * 100.0\n","                cambio_bajista = ((futuro_bajista - float(current_price)) / float(current_price)) * 100.0\n","\n","                duracion_tendencia = int(getattr(Config, \"INTERVAL\", 5)) * int(getattr(Config, \"MODEL_INPUT_WINDOW\", 60))\n","                comentario = \"📈 Tendencia alcista dominante\" if cambio_alcista > abs(cambio_bajista) else \"📉 Tendencia bajista dominante\"\n","                alerta_ganancia = \"🔔 ALERTA: Posible ganancia superior al 10%\" if cambio_alcista >= 10 else \"\"\n","\n","                now_ny = datetime.now(timezone('America/New_York'))\n","                print(\"\\n=== 📊 RESUMEN DE ANÁLISIS CUÁNTICO COMPLETO ===\")\n","                print(f\"🕒 Timestamp (NY)           : {now_ny.strftime('%Y-%m-%d %H:%M:%S')}\")\n","                print(f\"💵 Precio actual Kraken     : ${float(current_price):.2f}\")\n","                print(f\"🔮 Proyección ALCISTA       : ${futuro_alcista:.2f} ({cambio_alcista:+.2f}%)\")\n","                print(f\"🔮 Proyección BAJISTA       : ${futuro_bajista:.2f} ({cambio_bajista:+.2f}%)\")\n","                print(f\"📉 Brecha predicciones      : {abs(futuro_alcista - futuro_bajista):.2f} USD\")\n","                print(f\"📈 Tendencia dominante      : {'ALCISTA' if cambio_alcista > abs(cambio_bajista) else 'BAJISTA'}\")\n","                print(f\"📐 Intensidad ALCISTA       : {'Fuerte' if abs(cambio_alcista) > 10 else 'Moderada' if abs(cambio_alcista) > 5 else 'Débil'}\")\n","                print(f\"📐 Intensidad BAJISTA       : {'Fuerte' if abs(cambio_bajista) > 10 else 'Moderada' if abs(cambio_bajista) > 5 else 'Débil'}\")\n","                print(f\"⏱️ Duración estimada        : {duracion_tendencia} minutos\")\n","                print(f\"🧠 Comentario del sistema   : {comentario}\")\n","                if alerta_ganancia:\n","                    print(alerta_ganancia)\n","                if historia_a:\n","                    print(f\"📊 Promedio histórico